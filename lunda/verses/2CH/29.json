  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "2CH 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hatachikiliyi kuyula, wadiŋi wanyaka makumi ayedi i nayitanu. Wayulili muYerusalema nyaka makumi ayedi nayitanu nayiwana. Mama yindi ijina dindi Abiya mwana kaZekariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilaŋa chaloŋa kumesu aYehova mwelilaŋyi nkakulula yindi Davidi mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wayuliliyi wakusambila, mukakweji kakusambila, wenzulwiliyenzelu yakwitala daYehova, hakuyiloŋesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwiŋijamu jimu atupristuna waLevi, hakuyipompesha mulubanza lwakumusela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Tiyenu, enu aLevi. Dŋilikenu katataka, mujiliki itala daYehova Nzambi yawankakulula jenu, fumishenu mwajila majilu adumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋatatajetu anamotoki dehi nshimbi, aneli dehi chatama kumesu aYehova Nzambi yetu, anamuleki dehi, kwashakamayi Yehova anafumishuku mesu awu, anafutaleluku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anenzeli nawa niyenzelu yakwikeki dakuchisu, nimanoŋu ajima dehi, kumwochelaŋa Nzambi yaIsarela insensi, hela kumushitilaŋanyilambu yakushita mwajila nawa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ndombu yaYehova yinayiwani dehi aYuda naYerusalema, nayihani dehi ayizukumonaŋa, ayihayamaŋa, ayiyiŋilaŋa, neyi chimunamoni dehi namesu enu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenutuhu, atata jetu awa adimboka dehi awa nampoku yakabali, anyanetu amayala nawambanda ni aŋodi jetu awa adi muwukoli awa hansaŋu iyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALevi hiyakunyamuka, mwana kaAmasayi Mahati, namwana kaAzariyaYoweli, akudi anyana kaKohati; akudi anyana kaMerari, mwanakaAbidi Kishi, namwana kaYehaleli Azareya; akudi aGereshoni, mwanakaZima Yowa, namwana kaYowa Edeni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akudi anyana kaElizafwana, Shimiri naYeweli; akudi anyana kaAsafwi, Zekariya naMataniya; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akudi anyana kaHemani, Yehuweli naShimeyi; akudi anyana kaYedutuni, Shemaya naUziyeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakupompesha ana kwawu, hiyakudijilika, hiyakwijila nakutookesha mwitala daYehova, mwomwayilejeliyi mwantanamazu akudi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu hiyakwijila mukachi ketala daYehova kulonda kuditookesha, hiyakwidishamu majilu ejima awenuwu mwitala daYehova, hiyakuyileta kuchipaŋu chakwitala daYehova. ALevi hiyakuyinona hiyakuyi twalakumpata kukakaloŋa Kidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dakusambila dakakweji kakusambila, didu datachikiluwu kujilika, hefuku dakakweji damu chitanuna chisatu hiyakushika kwikeki dakuchisu chaYehova. Hiyakujilika itala daYehova mumafuku atanu nasatu. Hefuku dekumi nakatanu nakamudakakweji kakusambila, hiyakumanisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwipila mwa-mwanta Hezekiya muchipaŋu, hiyakwila nawu, Tunatookeshi dehi itala daYehova dejima, nikameŋa kahimulambu wakushita, niyuma yaku yejima, nimesa yamankendi akutenteka kumesu aYehova, niyuma yayu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyuma yejima yanatiliyi Ahazi hadiŋiyi muwanta, hamotokelaŋayi nshimbi, tunayiloŋeshi dehi, tunayijiliki dehi; yidi kumesu akameŋa kaYehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Hezekiya hakuhinduka budidi, hakupompesha tulambatwa mumukala, hakukanduka kwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuleta aŋombi amayala atanu nayedi, yizamba yanyikoku yitanu nayiyedi, nyana kanyikokuyitanu nayiyedi, yizamba yampembi yitanu nayiyedi, yahimulambu wahanshidi, wakulambwila ituŋa nimalala niaYuda. Hakuleja atupristu anyana kaAroni kuyilambula hakameŋa kaYehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakujaha aŋombi amayala, atupristu hiyakutambula mashi, hiyakuyisampulaha kameŋa. Hiyakujaha anyikoku, hiyakusampula mashi hakameŋa. Hiyakujaha ninyana kanyikoku, hiyakusampula mashi hakameŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yizamba yampembi hiyakuyileta kwakwihi kumesu amwanta nachipompelu, yahimulambu wahanshidi. Hiyakuyinaŋika makasawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu hiyakuyiha, mashi awu hiyakwila nachu himulambu wahanshidiha kameŋa, kulonda kubuta nachu aIsarela ejima; muloŋa mwanta wayilejeli, nindi nihimulambu wakushita nihimulambu wahanshidi akayilambwili aIsarela ejima.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusha aLevi mwitala daYehova namachakayi, nayisanji, natudada, mwomwayilejeliyi Davidi, nimukwakumona wamwanta Gadi, nikaprofwetu Natani; muloŋa Yehova wayilejeli kutunwa twawatuprofwetu twindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ALevi hiyakwimana nayuma yaDavidi yakwimba nachu, atupristuni wena nampùŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya nindi, Shitenu himulambu wakushita bakameŋa. Chakutachikawuhi mulambu wakushita, nikamina kaYehova Irikakutachika nawa, nimpùŋa hamu nayuma yakwimba yaDavidi mwanta wawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chejima hichikudifukula, akwakwimba tumina hiyakwimba, akwakuvumisha mpùŋa hiyakuvumisha; chochu hohu, nichamanishiluwu himulambu wakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamanishiluwu himulambu wakushita, mwantanawantu ejima adiŋiyi nawu hiyakubandama, hiyakudifukula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Hezekiya nawatulamba, hiyakuleja aLevi nawu, Mwimbilenu Yehova tumina twakuhameka twamazu aDavidi, nitwaAsafwi mukwakumona. Hiyakwimba tumina twakuhameka namuzapalu, hiyakubandama nyitu yawu, hiyakudifukula.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakuyila nindi, Ichi chimuna dikunjiki dehi kudi Yehova, twayenu dinu kwakwihi, muleti yimuna yakuketula ninyilambu yakusakilila mwitala daYehova. Chipompelu hichikuletamu yimuna ninyilambuya kusakilila. Ejima adiŋi nanyichima yakutiyamu kuwaha hiyakuletanyilambu yakushita. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyilambu yakushita yaleteli chipompelu, kuyichindaamayala aŋombi makumi atanu nayedi, yizamba yanyikoku nkulakaji, nyana kanyikoku makulakaji ayedi, yejimiyi yahimulambu wakumushitila Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yajilikiluwu, aŋombi makulakaji atanu nadimu, nyikokuma kombakaji asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu akeha nikukeha, kutwesha kúuwanyilambu yakushita yejima nehi, dichi ana kwawu aLevi hiyakuyi kwashakuni chamanini mudimu, nichadijilikiluwu atupristu amakwawu; muloŋa Levi diwu adiŋi abadika atupristu kwoloka munyichima yawu hansaŋu yakudijilika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyilambu yakushita yaswejeli kuvula nawa, hamu namanji anyilambu yakuwunda, ninyilambu yakuhuŋununa yakunyilambu yakushita yejima. Mwenimu dimu mwaloŋesheleluwu muwukalakelu wamudimu wakwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya azaŋalala nikuzapalala, niantu ejima, nanochu chayiloŋesheleluwu antu kudi Nzambi; muloŋa chumochu achilili chaku kasumuka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
