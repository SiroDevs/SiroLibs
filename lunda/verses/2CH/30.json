  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "2CH 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya watemesheli mazukudi aIsarela nawaYuda ejima, wasonekeli nawa nyikanda kudi aEfweremi nawaManase, nindi, Twayenukwitala daYehova kuYerusalema mwakamudiili Yehova Nzambi yawaIsarela paseka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwanta nawatulamba twindi, nadiipompelu chamuYerusalema chejima akwata dehi mpùŋa, nawu, Tudyenu paseka mukakweji kamuchiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kaŋenyi kuyidya hamafuku owu, nanochu chakeheluwu atupristu adijilikili, niantu adiŋi kanda apompi kuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakwenda lufuchi hiyakuya mwahita Isarela naYuda mwejima, nanyikanda yakufuma kudi mwanta nawatulamba twindi, chakuyileja kudi mwanta, nawu, Enu anyana kaIsarela balumukenu cheŋi mutali kudi Yehova Nzambi yaAbarahama, naIsaka, naIsarela, kulonda afunti cheŋi kudenumunashali, munapuluki kudi anyanta akuAshuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi mufwana neyi ankakulula jenu nawana kwenu amumotokeli Yehova Nzambi yawankakulula jawu, mwakenzi ayimweshi kujilumuka, neyi chimunamonuku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakuya lufuchi hiyakuya hamukala hamukala mwituŋa daEfweremi na Manase, ndo nikuZebuluni; hiyakuyiseha nankashi, hiyakuyitaŋula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, antu amakwawu amuAsheri namuManase namuZebuluni adizozeli, hiyakwinza kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "NimuYuda nawa chikasa chaNzambi chadiŋi mwomu, hakuyinka muchima wumu wakwila mwayilejeliyi mwanta nawatulamba namazu akudi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuYerusalema kwapompeli antu amavulu nakudya chawija chamankendi akadi ilupi, mukakweji kamuchiyedi, chipompelu cheneni nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela apompeli kuYerusalema, adiili chawija chamankendi akadi iluŋi mafuku atanu nayedi nakuluŋ kwakweni; aLevi nawatupristu hiyakuhamekaŋa Yehova hefuku hefuku, nakumwimbila Yehova tuminanayuma yakwimba nachu yavuma nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakukundeja aLevi ejima adiŋi nawukalawenu wakwila mudimu waYehova; hiyakudya mwahitili chawija chejima chamafuku atanu nayedi, hiyakulambulaŋa yimuna yanyilambu yakuwunda, hiyakusakililaŋa Yehova Nzambi yawankakulula jawu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chejima hichikukwata mpùŋa yakwila nawu, Tudyenu mafuku amakwawu atanu nayedi. Hiyakudya mafuku amakwawu atanu nayedi nakuluŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwanta wawaYuda Hezekiya wenkelichipompelu aŋombi amayala ikombakaji, ninyikoku makombakaji atanu nayedi yakulambulaŋa; atulamba enkeli chipompelu aŋombi amayala ikombakaji, ninyikoku makombakaji ikumi; atupristu amavulu nankashi adijilikili nawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chaYuda chejima, hamu nawatupristuna waLevi, nichipompelu chejima chafumini muIsarela, nienyi afumini mwituŋa daIsarela, nienyi ashakamini muYuda, azaŋaleli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuYerusalema mwadiŋi kuluŋa kwakweni, muloŋa kufumisha hamafuku adiŋiyi Solomoni mwana kaDavidi mwanta wawaIsarela, hiyamweni chenochu muYerusalemaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu nawaLevi hiyakunyamuka nakukiswila antu nkisu. Atiyili izu dawu, kulomba kwawu kwashi kili mwashakamayi mwajila, mwomwiwulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        }
      ]
    }
  ],
