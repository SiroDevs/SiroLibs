          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwelili munahiti dehi nyaka makumi ayedi yatuŋiliyi Solomoni itala daYehova niitala dindi yomweni, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "oyu nyikala yenkeluwu Solomoni kudi Hurami, Solomoni hakuyituŋa, hakushakamishamu anyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakuya kuHamati Zoba, hakuwimika mushindu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuŋa Tadi mori mwisaŋa, ninyikala yejima yakuswekela yuma yatuŋiliyi kuHamati.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima asheluku akudi aHiti, niakudi aAmori, niakudi aPerizi, niakudi aHivi, niakudi aYebusi, abulili kwikala aIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "niakudi anyanawu ahiŋili mudi wena asheli mwituŋa, abulili kunoŋeshawu kudi anyana kaIsarela, kudi wena kwoku kwakwatiliyi Solomoni chipalu nikulelu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakufumisha mwana kaFwaro wamumbanda mumukala waDavidi, hakumutwala kwitala damutuŋililiyi, muloŋa welili nindi, Iŋoda mibayi ashakama mwitala damwanta wawaIsarela Daviduku, muloŋa kwashika dehi chimbaŋu chaYehova kwajila.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakumushitila Yehova nyilambu yakushita, hakameŋa kaYehova katuŋiliyi kumesu akuwiŋililu wakutembeli, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "washitilaŋa mwomwayilejeluwu kudi Mosi, mwomu mumudimu wefuku, hajisabata, inihaalukilaŋa tukweji, nihayawija yakushiika dehi yahamapampa kasatuhamwaka, chochawija chamankendi akadi iluŋi, nichawija chanyilungu, nichawija chayisolu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakolesheli mazanvu awatupristu mwomwaya ilushimbi lwatata yindi Davidi, kulonda akalakalaŋa, niaLevi atalaŋa nyidimuyawu niyakuhameka niyakukalakalaŋa kumesu awatupristu, mwomumumudimu wefuku; niakwakuhemba kuyisu nawa ahembaŋa yisu yejima mwekalila mazanvu awu; muloŋa dimu mwayilejeli muntu waNzambi Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munsaŋu jejima, nkusweka yuma yalema, jayilejeluwu atupristu nawaLevi kudi mwanta, hiyalekeli mwokuku.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
