  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2CH 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafwati wakamini hamu nawankakulula jindi, amujiikili hamu nawankakulula jindi mumukala waDavidi. Mwanindi Yehorami hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.1",
            "verseOrgIds": [
              "2CH.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wadiŋi nawana kwindi anyana kaYehoshafwati, niAzariya, niYehiyeli, niZekariya, niAzariya, niMikayeli, niShefwatiya, ejimawa adiŋi anyana kamwanta wawaIsarela Yehoshafwati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.2",
            "verseOrgIds": [
              "2CH.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tatayawu wayinkeli yamukunkulu yamaneni, niyasiliva, niyawuru, niyayumayalema, hamu nanyi kala yamuYuda yampwembu. Ilaŋa wanta wawinkeli Yehorami nanochu chadiŋiyi wedi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.3",
            "verseOrgIds": [
              "2CH.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woho, Yehorami chanadinyamuniyi hawanta watata yindi, nadikoleshi dehi, hakujaha ana kwindi ejima nampoku yakabali, niatulamba awaIsarela amakwawu nawa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.4",
            "verseOrgIds": [
              "2CH.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikiliyi Yehorami kuyula, wadiŋi wanyaka makumi asatu nanyaka yiyedi. Wayulili muYerusalema nyaka yitanu nayisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.5",
            "verseOrgIds": [
              "2CH.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wendeli mwendelelaŋa anyanta awaIsarela mwomwelilaŋa akwamutaŋa waAhabi, muloŋa yena wasumbwili mwana kaAhabi, hakwila nichatama kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.6",
            "verseOrgIds": [
              "2CH.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, Yehova hakeŋeli kujilumuna akwamutaŋa waDaviduku, muloŋa wachitiyaŋenu chatiyapeniyi naDavidi, nichamu kaniniyi kumwinka inopu dayena nawanya nindi nyaka yonsu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.7",
            "verseOrgIds": [
              "2CH.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku adiŋiyi, aEdomi adikapili nawaYuda, hiyakushamu mwantawawu awenawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.8",
            "verseOrgIds": [
              "2CH.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehorami nawawakulumpi jindi anjita hiyakuhitaku, nimakálu indi ejima hamu. Hakunyamuka nawufuku, hakutapa aEdomi amunyeŋu mukili, niakulumpi amakálu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.9",
            "verseOrgIds": [
              "2CH.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AEdomi saŋa adikapilawu nawaYuda nikulelu. Henohu dihu hadikaŋiluwu nindi, niaLibina nawa, nanochu chalekeliyi Yehova Nzambi yawankakulula jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.10",
            "verseOrgIds": [
              "2CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili nawaniyinaŋanaŋa hampidi jamuYuda, wayikoŋesheli akwakushakama muYerusalema wuvumbi, hakuluwisha niaYuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.11",
            "verseOrgIds": [
              "2CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi kaprofwetu Elija hikukufuma mukanda, nindi, Yehova Nzambi yankakulula yeyi Davidi, nahoshi nindi, Ochu chiwunabuli kwenda mwendelelaŋatata yeyi Yehoshafwati, hela mwendelelaŋa mwanta wawaYuda Asa, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.12",
            "verseOrgIds": [
              "2CH.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiwukwenda mwendelelaŋa anyanta awaIsarela, hiwukukopesha aYuda nawakwatushakama kuYerusalema wuvumbi, mwomwelilaŋa akwamutaŋa waAhabi; hiwukujaha niana kweyi akumutaŋa watata yeyi akubadikili kuwaha; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.13",
            "verseOrgIds": [
              "2CH.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "tiya dinu, Yehova waketa antu eyi, nianyaneyi, ni aŋodi jeyi, nimaheteyi kweta kwakweni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.14",
            "verseOrgIds": [
              "2CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakakata yikatu yamaneni yamusopuwamu nyijiriwa, ninyijiŋwa yeyi yakaholoka mwivumu nayikatu yahefuku hefuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.15",
            "verseOrgIds": [
              "2CH.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakumusaŋu mwina Yehorami spiritu yawaFwilistinu, niyawaArabiya ekala kwakwihi nawaEtiyopiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.16",
            "verseOrgIds": [
              "2CH.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwinza nakulwa nawa-Yuda, hiyakuyilukuka, hiyakusenda maheta ejima awenuwu mwitala damwanta, ni anyanindi amayala nawa, ni aŋodi jindi: hiyamushiyililuhu mwana weyalaku, chiŋa yowu Ahaziya mwanindi weyala wakansi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.17",
            "verseOrgIds": [
              "2CH.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulondela hayumiyi yejima, Yehova hakumweta munyijiŋwa namusoŋuwa kokewaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.18",
            "verseOrgIds": [
              "2CH.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili mafuku, kukumana kwanyaka yiyedi, nyijiŋwa yindi hiyikuholoka mwivumu nayikatu yindi, afwa ninayikatuyakala nankashi. Antu indi kumwochela neyi chochelelaŋawu ankakululajindi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikiliyi kuyula wadiŋi wanyaka makumi asatu nanyaka yiyedi. Hakuya chakadi niwakumutiyila wushona. Amuŋikili mumukala waDavidi, ilaŋa kumujiika mumajamu awanyanta nehi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
      ]
    }
  ],
