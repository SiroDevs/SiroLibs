    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta watemesheli antu nakupompesha kudi yena awakulumpi waYuda niamuYerusalema ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakukanda makwitala daYehova, hamu namayala akuYuda ejima, hamu nawantu ashakama muYerusalema ejima, niatupristu, niatuprofwetu, niantu ejima, hela alemahela akadi kulema. Hakuyitaŋila mazu ejima amumukanda wachitiyaŋenu wawenuwu mwitala daYehova, wejima wawu achitiyaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakwimana kuchishimi, hakutiyaŋana chitiyaŋenu kumesu aYehova, chakwenda nakulondela Yehova, chakuhemba mwayilejeliyi, niwunsahuwindi, niyidika yindi, namuchima windi wejima, nawumi windi wejima, kulonda kukolesha mazu achitiyaŋenu ochu asonekeluwu mumukandowu. Antu ejima hiyakwimana nakwitŋi nawu, Tukuhemba chitiyaŋenu ichi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuleja kapristu muneni Hilikiya niatupristu akunamutundu wamuchiyedi, niakwakuhemba kuchisu, nindi, Fumishenu mutembeli yaYehova yuma yejima yatuŋililuwu Bayali, niyatuŋililuwu muyombu, niyatuŋililuwu yileŋaleŋa yamwiwulu yejima. Hakuyifumisha muYerusalema, hakuyochela mumaha akuKidironi, hakutwala mawuti ayu kuBeteli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufumisha atupristu ejima munyikala yawaYuda, hakujilola yinaŋanaŋayo chelelaŋawu atupristu insensi, kufumisha kuGeba ndo niku-Berisheba. Wahumwini yinaŋanaŋa yakuyisu yampwembu yadiŋi kuwiŋililu wakuchisu chaYoshuwa mukwakuyula mukala, yadiŋi hachikasacha chimunswa chiwukuya nakwijila kuchisu chamukala. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, atupristu ahayinaŋanaŋa hiyenjili kukamepa kaYehova kamuYerusalemaku, ilaŋa adiili mankendi akadi iluŋi mukachi kawana kwawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakujilola Tofweti yekala muchinekineki chawanyana kaHinomi, kulonda habulikumwekena muntu wukutwesha kwochela Moleki mwanindi weyala helamwanindi wamumbanda mukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufumishaku tuwalu twahenuwu anyanta awaYuda kudi itaŋwa, twadiŋi kuwipililu wakwitala daYehova, kwakwihi netala dakalala Natali Meleki dadiŋi kunsa; hakwocha nimakálu etaŋwa mukesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumeŋa twatuŋiluwu anyanta awaYuda twadiŋihewulu detala daAhazi dakwiwulu, nitumepa twatuŋili Manase twamuyipapuyi yedi yakwitala daYehova, mwanta watuhumwini, hakutufumpola kwenoku, hakunata wuŋa wawu mukakaŋa Kidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakujilola yinaŋanaŋa yadiŋi yatalaŋana naYerusalema, yadiŋi mutamba wachidi iluwampidi yakutoka, yatuŋiliyi mwanta wawaIsarela Solomoni, yakutuŋila Ashitoreti chishimashima chawaZidoni, naKemoshi chishimashima chawaMowabi, naMilikomi chishimashima chawanyana kaAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haku fumpolatuposhi twakupeshela, hakutema ninyiyombu, hakulumbekaku mafwaha awantu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahumoneni nikameŋa kadiŋi kuBeteli, nichinaŋanaŋa chatupiliyi mwana kaNebati Yerobowami wavulumwishili aIsarela, nikameŋa, nichinaŋanaŋa. Hakwocha chinaŋanaŋa, hakuchitwa hichikwikala neyi wuŋa, hakwocha nimuyombu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya cheliliyi nindi abalumuki, hakumona majamu adiŋi kwenoku kumpidi. Hakutemeshaku antu nakunona mafwaha mumajamu owu, hakuyocha hakameŋa, hakukajilola, mwomwizu daYehova dabidikiliyi muntu waNzambi wabidikili yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakwihula nindi, Iyi nsona yinamoni hinsonanyi? Antu ahamukala hiyakumulejanawu, Hiijamu damuntu waNzambi wafumini kuYuda, wabidikili yumiyi yiwuneli kameŋa kakuBeteli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Mulekenu kwindi, bayi mufumisha mafwahinduku. Dichi alekeli mafwahindi hamu namafwaha akaprofwetu wafumini kuSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya wafumishili matala ejima ahayinaŋanaŋa yadiŋi munyikalaya muSamariya, yatupiluwu anyanta awaIsarela yakuvuloka Yehova azuwi, wayilili mwejima neyi cheliliyi muBeteli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atupristu ejima ahayinaŋanaŋa adiŋi kwenoku wayijihilili hatumeŋa, hakwochahu nimafwaha awantu; yofunta nikuYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta walejeli antu ejima, nindi, Mudiilenu Yehova Nzambi yenu paseka, neyi chanasonekuwu mumukandiwu wachitiyaŋenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala, kanda adyaŋahu dehi paseka yidi neyi oyu, kufumisha hamafuku awansompeshi asompeshelaŋawu aIsarela, hela hamafuku ejima awanyanta awaIsarela, hela awanyanta awaYudaku; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "wowena mwaka wamwanta Yosiya wekumi nakatanu nakasatu wowu amudiililuwu Yehova paseka iyi muYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya wafumishili nawa niazakukilaŋa akishi, niatutepa, ninkishijakupanda, niakishi akutuŋi, niyishimashima yejima yamwenuwu mwituŋa daYuda nimuYerusalema, kulonda kukolesha mazu anshimbi asonekeluwu mumukanda waweniyi kapristu Hilikiya mwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kanda kwikalapahu dehi mwanta wacheŋi wakumufwana yena, wabalumukili nakutala kudi Yehova namuchima windi wejima, nawumi windi wejima, naŋovu jindi jejima, mwaya nshimbi jaMosi jejimaku; hikwamulondeliwacheŋi wudi neyi yenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, Yehova habalumukili aleka ndombu yindi yasweja yatata shaniniyi, yazuwiliyi nawaYuda, yansaŋu yejima yamuzuwishiluwu kudi Manaseku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakwila nindi, AYuda nukuyifumisha niwena nawa kumesu ami, neyi chinafumishili aIsarela, niniwu mukala Yerusalema natondeli, niitala dinelili nami, Nukushaku ijina dami, nukuyileka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYosiya jinashaluku, niyuma yejima yeliliyi, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku indi mwanta wakuEjipitu Fwaro Neko wayili nakwasa njita namwanta waku-Ashuri kukaloŋa Yufurati. Mwanta Yosiya hakuya nakudasa nindi. Chamumweniyi kuMegido amujaha nikumujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambupindi hiyakumusenda mwitemba wafwa dehi, amufumishili kuMegido amutweli kuYerusalema, amujiikili mwŋimu dindi yomweni. Antu amwituŋa hiyakukwata mwana kaYosiya Yehowahazi, hiyakumuwayisha manji, hiyakumuswanisha mwadiŋi tata yindi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikili kuyulayi Yehowahazi, wadiŋi wanyaka makumi ayedina yiyedi. Wayulili muYerusalema tukweji tusatu. Mama yindi ijina dindi Hamutali, mwana kaYeremiya wakuLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova, mwomwelilaŋa ankakulula jindi mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumukasa kudi Fwaro Neko kuRibila mwituŋa daHamati, kulonda akabulikuyula muYerusalema. Hakwinka ituŋa muloŋa wakufuta ntalenta jasilivankulakaji, nintalenta yawuru yimu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fwaro Neko hakuswanisha mwana kaYosiya Eliya kimi mwadiŋi tata yindi Yosiya, ijina dindi hakudibalumuna, nindi diyi Yehova kimi. Hakumufumisha kuYehowahazi, hakwinza kuEjipitu, hakufwilaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova kimi hakumwinka Fwaro nisiliva niwuru. Ilaŋa yena wasonkesheli antu amwituŋa kulonda ahani mali ayilejeluwu kudi Fwaro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafutishili antu amwituŋa nisiliva niwuru, mwashikila musonkuwa muntu namuntu, kulonda kumwinka Fwarowe Hatachikili kuyulayi Yehova kimi, wadiŋi wanyaka makumi ayedi nayitanu. Wayulili muYerusalema nyaka ikumi nawumu. Mama yindi ijina dindi Zebida, mwana kaPedaya wakuRuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova, mwomwelilaŋa ankakulula jindi mwejima.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
