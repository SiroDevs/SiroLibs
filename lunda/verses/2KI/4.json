          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.41",
            "verseOrgIds": [
              "2KI.4.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2KI 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "KuBayali Shalisha kwafumini muntu, hakumuletela muntu waNzambi yakudya yambutu yatachi, mankendi abali makumi ayedi, ninyitu yatidikuyituuta mwisaka dindi. Hakwila nindi, Yinki antu, adiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.42",
            "verseOrgIds": [
              "2KI.4.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "2KI 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwaku mukoŋela nindi, Aka! Yeniyi kwaamu niyitulili nkulakaji yamayala? Ilaŋa Elisha nindi, Yinki antu, adiyi; muloŋa Yehova nahoshi nindi, Akadya, akashiyahu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.43",
            "verseOrgIds": [
              "2KI.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2KI 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitulila, hiyakudya, hiyakushiyahu, mwomwahosheliyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.4.44",
            "verseOrgIds": [
              "2KI.4.44"
            ]
          }
        }
      ]
    }
