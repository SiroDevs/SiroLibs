  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamuchiyedi waYehowashi mwana kaYehowahazi mwanta wawaIsarela, Amaziya mwana kaYowashi mwanta wawaYuda watachikili kuyula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikiliyi kuyula wadiŋi wanyaka makumi ayedi nayitanu. Wayulili muYerusalema nyaka makumi ayedi nayitanu nayiwana. Mama yindi ijina dindi Yehowadina wakuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilichaŋa kumesu aYehova, hela chochu, helili neyi cheliliyi nkakulula yindi Daviduku; welili mweliliyi tata yindi Yowashi mwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, yinaŋanaŋa hiyayifumishiluku. Antu saŋa aketwilawu yimuna, saŋa ochelawu insensi hayinaŋanaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili wanta windi wunakoii dehi, hakujaha ambuŋindi ajahili tata yindi wadiŋi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hajahili anyana kawenowu ambanjuku; mwomwana soneku wu mumukanda wanshimbi jaMosi, mwayilejeliyi Yehova, nindi, Kujahila atata jawantu hanshidi jawanyana nehi, nianyana kuyijihila hanshidi jiwatata jawu nehi, ilaŋa antu ejima akayijihila hanshidi jawu awenawuhohu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuChinekineki Chamuŋwa wajahililumu aEdomi makombakaji ikumi, watambwili mukala waSela nanjita, wawutumbili ijina, nindi Yoketeli, nikulelu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya hakutemesha atuŋanda kudi Yehowashi mwana kaYehowahazi, Yehowahazi mwana kaYehu, mwanta wawaIsarela, nindi, Twaya tumonaŋani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela Yehowashi hakutemesha mazu kudi mwantawa waYuda Amaziya, nindi, Kachiputa kanyiŋa kadiŋi muLebanoni katemesheli mazu kudi musida wadiŋi muLebanoni, nindi, Letaku mwaneyi wamumbanda amusumbuli kudi mwanami; kanyama wamwisaŋa wadiŋi muLebanoni hakuhitaku, hakukadata kenoku kachiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalala eyiwunatapi dehi aEdomi, hiwukudivwimba nimumuchima; dishakaminikweyi kwitala deyi, wudisaminaŋaku, indi wudimweshi tuhu kweyi jakala, winzi wudimbuki tuhu kumu nawaYuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Amaziya kutiya nehi. Dichi mwanta wawaIsarela Yehowashihakuya kwenoku. Hakumonaŋana namwanta wawaYuda Amaziya kuBetishemeshi wawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYuda ayitapili kudi aIsarela, wejima wawuhiyakutemokela kunyikala yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela Yehowashi, hakukwata Amaziya mwanta wawaYuda mwana kaYowashi, mwana kaAhaziya, kuBetishemeshi; hakwinza kuYerusalema, haku humunampwembu yaYerusalema kufumisha kuchisu chakuEfweremi, ndo nikuchisucha kwiwombu, munkotweli jachikasa makulakaji awana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutambula wuru wejima nisiliva yejima, niyuma yejima yawenuwu nimwitala daYehova, nimuyuma yalema yamwitala damwanta, niantombu nawa, hakufunta kuSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYehowashi jayuma yeliliyi jinashaluku, niŋovu jindi, nichalwiliyina mwanta wawaYuda Amaziya; hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowashi wakamini hamu nawankakulula jindi, amujiikili muSamariya hamu nawanyanta awaIsarela. Mwanindi Yerobowami hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaziya mwana kaYowashi mwanta wawaYuda, wahandili nyakaikumi nayitanu kufumisha hafwiliyi Yehowashi mwana kaYehowa hazimwanta wawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.17",
            "verseOrgIds": [
              "2KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaAmaziya jinashaluku hiyanaji sonekimu mukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukwatilili chikuchi muYerusalema, hakutemukila kuLakishi. Ilaŋa wena hiyakumulondeshela antu kuLakishi, hiyakumujahila kwenoku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuleta cheŋi hatuwalu, hiyakumujiika kuYerusalema hamu nawankakulula jindi mumukala waDavidi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima amuYuda hiyakutambula Azariya wadiŋi wanyaka ikumi nayitanu nawumu, hiyakumuswanisha mwadiŋi tata yindi Amaziya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
            "verseOrgIds": [
              "2KI.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutuŋa mukala waElati, hakuwufuntisha cheŋi kudi aYuda, henohu mwanta nakami dehi hamu nawankakulula jindi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wekumi nakatanu waAmaziya mwana kaYowashi mwantawa waYuda, Yerobowami mwana kaYehowashi mwanta wawaIsarela watachikilikuyula muSamariya, wayulili nyaka makumi awana namwaka wumu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova; halekeli munshidi jejima jamwana kaNebati Yerobowami javulumwishiliyi nachu aIsarelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wafuntishili cheŋi ŋinza yawaIsarela kufumisha kuwiŋililu wakuHamati ndo nikwijiyadakuchana, mwomwaya izu daYehova Nzambi yaIsarela, dahosheliyi kukanwa kakambuŋindi kaprofwetu Yona mwana kaAmitayi, wadiŋi waku-Gati Hefwenai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova wamweni ikabi dadiŋi nakukabawu aIsarela, dadiŋi dalula nankashi, hikwasheli hela nduŋu hela mwana wahamukala, hela tuhu nkwashi wakukwasha aIsarelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hahoshelinindi nŋimaŋeshi ijina daIsarela mwishina dewuluku, ilaŋa waya mwinini nachikasa chamwana kaYehowashi Yerobowami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaYerobowami ijina shaluku, niyuma yeliliyi yejima, niŋovu jindi, nichalwila ŋayi, nichatambwiliyi cheŋi Damakasa naHamati yadiŋi yawaYuda, yiikali cheŋi yawaIsarela, hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowami wakamini hamu nawankakulula jindi anyanta awaIsarela, mwanindi Zekariya hakumuswana.",
          "type": "text",
