    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu Hezekiya wakatili yikatu yakufwa. Kaprofwetu Isaya mwana kaAmozi hakwinza kudi yena, hakumwila nindi, Yehova nahoshi nindi, Kanaku antaŋa jeyi, muŋa eyi wukufwa, hiwukuhandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakubalumuka chamesu indi kumbaŋu, hakulombakudi Yehova, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.2",
            "verseOrgIds": [
              "2KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Eyi Yehova, nalembi, aanuki mwani chinendelikumesu eyi chakashinshi namuchima walala, chineli niyuma yayiwa hikumesu eyi. Hezekiya hakudila nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.3",
            "verseOrgIds": [
              "2KI.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Isaya kanda ashiki hakachi kamukala, izu daYehova hidikwinzakudi yena, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.4",
            "verseOrgIds": [
              "2KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Balumukaku, wakamwili nlomboli yawantu amiHezekiya, neyi, Yehova Nzambi yankakulula yeyi Davidi nahoshi nindi, Natiyi kulomba kweyi, namoni madilu eyi. Nukukuuka. Hefuku damuchisatu wakakanduka kwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.5",
            "verseOrgIds": [
              "2KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumafuku eyi nukukushilakunyaka ikumi nayitanu. Nakakupulwisha nimukaliwu kudi mwanta waku-Ashuri. Nakahemba mukaliwu hamujimba wamami aweni, nihamujimbawakambuŋami Davidi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.6",
            "verseOrgIds": [
              "2KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya nindi, Nonenu dinkendi danyikabu yachikuyu. Hiyakunona, hiyakusha hehuti daHezekiya, akola nikukola. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.7",
            "verseOrgIds": [
              "2KI.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya hakumwila Isaya, nindi, Chinjikijilu chanka chinakeluka nachu nami Yehova wukupuka, nami nakakanduka kwitala daYehova ifuku damu chisatu? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.8",
            "verseOrgIds": [
              "2KI.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya nindi, Tiya chinjikijilu chakakulejayi Yehova, kulonda wakeluki neyi Yehova wakakopa chuma chanahoshiyi; mwevulu wetaŋwa wuswili kumbi diyi maŋu ikumi, tahindi wufunti hanyima yimaŋu ikumi? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.9",
            "verseOrgIds": [
              "2KI.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiyanindi, Chaswayi mwevulu kukunkumuka yimaŋu ikumi. Nehi, mwevulu chiŋa wufunti hanyima yimaŋu ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.10",
            "verseOrgIds": [
              "2KI.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu Isaya hakubilela kudi Yehova. Yehova hakufuntisha mwevulu hanyima yimaŋu ikumi muwakunkumuka dehi kuyimaŋu yaAhazi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.11",
            "verseOrgIds": [
              "2KI.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamafuku owu Berodaki Baladani, mwana kaBaladani, mwantawa kuBabiloni, hakutemesha nyikanda nichamukunkulu kudi Hezekiya, muloŋa watiyili nawu Hezekiya wadini nakukata. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.12",
            "verseOrgIds": [
              "2KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya wayitambwilichachiwahi, hakuyileja itala dayuma yindi yalema dejima, nisiliva, niwuru, ninyiseki, nimanji alema, niitala dayitwa yindi yanjita, niyuma yejima yadiŋi kuyuma yindi yalema. Kwosi chuma chadinimwitala dindihela chamuwanta windi wejima chabulili kuyilejayi Hezekiyaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.13",
            "verseOrgIds": [
              "2KI.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu Isaya hakwinza kudi mwanta Hezekiya, hakumwihula nindi, Awaantu anahoshi nawudi? Chanenzuwu kudeyi anafumi kudihi? Hezekiyanindi, Anafumi kumpata yayilehi, kuBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Yumani yanamonuwu mwitala deyi? Hezekiya nindi, Anamoni yuma yejima yidimwitala dami, kwosi chuma chamuyuma yami yalema chinabuli kuyilejaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaHezekiya jinashaluku, niŋovu jindi jejima, nichatuŋiliyi ŋiyanikapila, hakuleta meji mumukala, hiyanajisoneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.20",
            "verseOrgIds": [
              "2KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya wakamini hamu nawankakulula jindi. Mwanindi Manase hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.21",
            "verseOrgIds": [
              "2KI.20.21"
            ]
          }
        }
      ]
    }
  ],
