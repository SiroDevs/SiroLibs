  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "2KI 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachitiyiliyi mwanta Hezekiya, hakutabola mahinindi, hakudi kumbakesha chikeleyi, hakwijila mwitala daYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.1",
            "verseOrgIds": [
              "2KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutesamesha Eliya kimi, wadiŋi mukulumpi wawakwetala, ninsoneki Shebina, niakulumpi awatupristu, kudi kaprofwetu Isaya mwana kaAmozi, anadi kumbakeshiyikeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.2",
            "verseOrgIds": [
              "2KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, Hezekiya nindi, Lelu hiifukudayihuŋu, dakutuhoshola, dakututuka; anyana anashiki hakuvwalika, Ŋovu jakuyivwala kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.3",
            "verseOrgIds": [
              "2KI.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamba kela Yehova Nzambi yeyi wukutiya mazuejima aRabishake, ona anatemeshuwu kudi nkaka yindi mwanta wakuAshuri kulonda amuhoshi Nzambi wamumi chatama; wakabayisha mazu anatiyiyi Yehova Nzambi yeyi. Dichi dinu akanjiki kulomba kwakulombela chibalu chawantu chinashaluku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.4",
            "verseOrgIds": [
              "2KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋa mwanta Hezekiya hiyakwinza kudi Isaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.5",
            "verseOrgIds": [
              "2KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaya hakuyila nindi, Kamwilenu mwanta wenu nenu, Yehova nahoshi nindi, Bayi wutiya woma wamazu iwunatiyi anantukuwu kudi ambuŋa mwanta wakuAshuruku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.6",
            "verseOrgIds": [
              "2KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, mudi yena nakashamu spiritu yakwila chakatiyayi nsaŋu yaná wunáwu, hakafunta mwituŋa dindi, dimuna kamudi mbwishila nampoku yakabali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.7",
            "verseOrgIds": [
              "2KI.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.7",
            "verseOrgIds": [
              "2KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabishake hakufunta, hakuwana mwanta wakuAshuri wudi nakulwa naLibina, muloŋa natiyi nawu nafumi dehi kuLakishi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.8",
            "verseOrgIds": [
              "2KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatiyiliyi hiyakumutena mwanta wakuEtiyopiya Tirihaka, nawu, Tiya, yena nenzinakulwa naneyi; hakutemesha atuŋanda kudi Hezekiya ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.9",
            "verseOrgIds": [
              "2KI.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Kahoshenuna mwanta wawaYuda Hezekiya, nenu, Bayi witeja Nzambi yeyi wakuhwelelaŋa kukudimba, nindi, Yerusalema hiyakawuhana kudi mwantawa kuAshuruku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.10",
            "verseOrgIds": [
              "2KI.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunatiyi dehi chanakoŋuwu matuŋi ejima kudianyanta akuAshuri, chanayijilu munuwu chikupu; ochu eyi yeyi wakapuluka? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.11",
            "verseOrgIds": [
              "2KI.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AGozani naHarana naRezefwi, nianyana kaEdeni adiŋi muTelasari, nyuza yajilumwinuwu ankakulula jami, akishi awu ayipulwishili? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.12",
            "verseOrgIds": [
              "2KI.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela mwanta wakuHamati, nimwanta wakuAripadi, nimwanta wakumukala waSefwavwayimi, niwaHena, niwalvwa, adi kudihi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.13",
            "verseOrgIds": [
              "2KI.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.13",
            "verseOrgIds": [
              "2KI.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya watambwili mukanda kumakasa awatuŋanda, hakuwutaŋa, Hezekiya hakuya kwitala daYehova, hakuwuta ndumuna kumesu aYehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.14",
            "verseOrgIds": [
              "2KI.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaAmozi Isaya hakutemesha mazu kudi Hezekiya, nindi, Yehova Nzambi yaIsarela nahoshi nindi, Chiwunalombeli kudami nakutena mwanta wakuAshuri Senakeribi nachitiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.20",
            "verseOrgIds": [
              "2KI.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya izu danahoshiyi Yehova dakutena Senakeribi, nindi, Mujiki wamuZiyona nakudiwuli, nakusehi. Mwana wamumbanda wamuYerusalema nakulembuli nanamutu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.21",
            "verseOrgIds": [
              "2KI.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunahoshinyi chatama? Wunatukinyi? Wunahoshi nanyi izu dankalu? Wunaza mwininyi mesu? Hiyowu Wajila waIsarelaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.22",
            "verseOrgIds": [
              "2KI.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wunamuhoshi Mwanta chatama natuŋinda tweyi; wuneli neyi, Nenzi dehi nanyikankayami yamakálu hewulu damapidi amaneni, nimukachi kaLebanoni lwe. Nukutema nyisida yayilehi yiduku, ninyinjunŋa yayiwahi yiduku. Helakwashakamayi kwakumina masaŋa aweni ajika nukwiŋila, hela mwisapadakwiha dindi dasweja kusoŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.23",
            "verseOrgIds": [
              "2KI.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napundi mashima amwacheŋi namwacheŋi nakunwamu meji. Nakomisha tuloŋ twamu Ejipitu twejima namadachilu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.24",
            "verseOrgIds": [
              "2KI.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinafuukwili yumiyi hanyaka nichinayitoŋwelikushankulu eyi kuchitiya nehi? Ichi chiwunamoni kusanda nyikala yamapwembu hiyikwikala nyilumba yanswadi, yami nachikoŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.25",
            "verseOrgIds": [
              "2KI.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chabuliluwu enimbu Ŋovu, dichi chafwililuwu mutentu, hiyakubaya. Dichi cheliluwu neyi matahu amumpata, neyi munyenvu, neyi matahu amenaŋa hamawulu amatala, neyi tidiku yinomi chakadi nikukula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.26",
            "verseOrgIds": [
              "2KI.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuwashakaminaŋa, nimuwedikilaŋa, nimuweŋililaŋa, nimuwanzu wilaŋa, ami neluki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.27",
            "verseOrgIds": [
              "2KI.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanochu chiwanzuwilaŋa, nanochu chineli kudisama kuwadisamaŋakunashiki kumatu ami, nukukoba ilonda dami mumazulu eyi, nukusha chikuŋu chami mukanwa keyi, nukukubalumuna wufunti njilayiwenjili.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.28",
            "verseOrgIds": [
              "2KI.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.28",
            "verseOrgIds": [
              "2KI.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya chinjikijilu chiwakamona, makonu mwakadya yakudisoŋela, hamwaka wamuchiyedi mwakadya yachinkulu, mwaka wamuchisatu mwakadima, mwakadya, mwakatumba matempa anyivinyu, wakadya nyikabuyawu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akumutaŋa waYuda anashali, anapuluki, akashimata cheŋi nyiji hamaseki, akasoŋa nyikabu kwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akashalaku akafuma muYerusalema, akapuluka akafuma kumpidi yaZiyona; iyena dakumuchima waYehova dodakakoŋa chumichi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova nahoshi nakutena mwanta wakuAshuri, nindi, Hakenza kumukala wunuku, hakaasaku nsewuku, hakenza kwoku nankebuku, hela kudi minaku mpwembu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njila yenjiliyi diyi yakafuntayi, hakenza kumukala wunuku, dichi chanahoshiyi Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
