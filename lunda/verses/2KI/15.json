          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamwanta wawaYuda Azariya wamakumi atanu nakayedi, mwana kaRemaliya Peka watachikili kuyula aIsarela muSamariya, wayulilinyaka makumi ayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
