            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamakumi atanu wamwanta wawaYuda Azariya, mwana kaMenahemi Pekahiya watachikili kuyula aIsarela muSamariya, wayulilinyaka yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova, halekeli munshidiŋi mwana kaNebati Yerobowami javulumwishiliyi nachu aIsarelaku.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        }
      ]
    },
