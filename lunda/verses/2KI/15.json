        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumafuku amwanta wawaIsarela Peka, mwanta wakuAshuri Tigilati Pileseri wenjili nakutambula Iyoni, niAbeli Betimayaka, niYanowa, niKedeshi, niHazori, niGileyadi, niŊaliliya, niituŋa daNafwatali dejima, hakuyitwala kuAshuri muwukoli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
