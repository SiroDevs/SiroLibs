    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamakumi ayedi nakatanu nakayedi wamwanta wawaIsarela Yerobowami, Azariya mwana kaAmaziya mwanta wawa-Yuda watachikili kuyula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatachikiliyi kuyula wadiŋi wanyaka ikumi nayi tanu nawumu. Wayulili muYerusalema nyaka makumi atanu nanyakayi yedi. Mama yindi ijina dindi Yekoliya wakuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welilichaloŋa kumesu aYehova, mwejima mweliliyi tata yindi Amaziya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helachochu, yinaŋanaŋa hiyayifumishiluku. Antu saŋa aketwilawu yimuna, saŋa ochelawu insensi hayinaŋanaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamweteli mwanta, ekali mukwambumba nikwifuku dafwiliyi, washakaminaŋa mwitala dakumbadi. Mwana kamwanta Yotami diyi watalilaŋa akwetala, nikusompesha antu amwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaAzariya jinashaluku, niyuma yeliliyi yejima, hiyanaji soneki mumukanda wawanyanta awaYuda wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azari yawakamini hamu nawankakulula jindi. Amujiikili hamu nawankakulula jindi mumukala waDavidi. Mwanindi Yotami hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamakumi asatu nakatanu nakasatu wamwanta wawaYuda Azariya, mwana kaYerobowami Zekariya wayulili aIsarela muSamariya tukweji tutanu nakamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova neyi cheliluwu ankakulula jindi; halekeli munshidi jamwana kaNebati Yerobowami jivulumwishiliyi nachu aIsarelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYabeshi Shalumi wamukwatilili chikuchi, hakumutapila kumesu awantu, hakumujaha, hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaZekariya jinashaluku, talenu, anajisoneki mumukanda wawanyanta awaIsarela wakushindulula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
            "verseOrgIds": [
              "2KI.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Didizu daYehova damwililiyi Yehu, nindi, Anyaneyi akashakama hetanda daIsarela dawanta kushikani kwikiŋu damu chiwana. Ninochu dimu chelili.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.12",
            "verseOrgIds": [
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYabeshi Shalumi watachikili kuyula mumwaka wamwantawa waYuda Uziya wamakumi asatu nakatanu nakawana. Wayulili muSamariya kakweji kamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaGadi Menahemi hakufuma kuTiriza, hakwinza kuSamariya, hakutapa mwana kaYabeshi Shalumi muSamariya, hakumujaha, hakumuswana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaShalumi jinashaluku nichi kuchichindi chakwatiliyi, talenu, anajisoneki mumukanda wawanyanta awaIsarela wakushindulula. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Menahemi hakutapa Tifwisa, niantu ejima adiŋumu, niŋinza jawu kufumisha kuTiriza. Wawutapili nanochu chabulilu wukumwenzulwila. Niambanda ejima adiŋumu adiŋi namavumu, wayibuzili.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wamwanta wawaYuda Azariya wamakumi asatu nakatanunakawana, mwana kaGadi Menahemi watachikili kuyula aIsarela, wayulili muSamariya nyaka ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Welili chatama kumesu aYehova. Mafuku indi ejima halekeli munshidi jamwana kaNebati Yerobowami javulumwishiliyi nachu aIsarelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuAshuri Puli wenjili nakwasa ituiŋanjita. Menahemi hakumwinka Puli ntalenta jasiliva ikombakaji kulonda adibombi nindi amukolesheli wanta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.19",
            "verseOrgIds": [
              "2KI.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemi watambwili mali owukudi aIsarela, kudi aweni aheta nankashi, muntu wumu jishekeli jasiliva makumi atanu, muntu wumu jishekeli makumi atanu, kulonda kumwinka mwanta wakuAshuri. Mwanta wakuAshuri hakufuntamu, kushakama mwenomu mwituŋa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.20",
            "verseOrgIds": [
              "2KI.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu jaMenahemi jinashaluku, niyumayeliliyi yejima hiyanajisoneki mumukanda wawanyanta awaIsarela wakushindululaku? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemi wakamini hamu nawankakulula jindi. Mwanindi Pekahiya hakumuswana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
      ]
    },
