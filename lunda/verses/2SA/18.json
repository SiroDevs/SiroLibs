          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala Kabwibu hakwinza. Kabwibu nindi, Tiya nsaŋu, eyi nkaka yami mwanta. Lelu Yehova nakupulwishi dehi kudi antu ejima akunya mukila. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwihula Kabwibu, nindi, Mukwenzi Abisalomi wudi chachiwahi? Kabwibu hakwakula, nindi, Ayilumbu jankaka yami mwanta, niantu ejima akukunyamukila nakukwila chatama, amoni neyi chanamoniyi ona mukwenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuzaala nankashi, hakuka ndama mwitala dadiŋi hewulu dachisu champwembu, hakudila, iku wudi nakuya, iku wudi nakwila nindi, Eyi mwanami Abisalomi! Mwanami! Mwanami Abisalomi! Mutenowu yami nakufwila! Eyi Abisalomi! Mwanami, mwanami!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
