          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zalimoni mukwaAhowa, Maha rayi wakuNetofwati, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.28",
            "verseOrgIds": [
              "2SA.23.28"
            ]
          }
        },
