          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zeleki kaAmoni, Naharayi wakuBeyeroti, mukwakusenda yitwa yamwana kaZeruwiya Yowabi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.37",
            "verseOrgIds": [
              "2SA.23.37"
            ]
