          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elifweleti, mwana kaAhasibayi, wakuMayakati, Eliyami mwana kaAhitofweli wakuGilo, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.34",
            "verseOrgIds": [
              "2SA.23.34"
            ]
          }
