          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helebi mwana kaBayana wakuNetofwati, Itayi mwana kaRibayi waku Gibeya wawanyana kaBenjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.29",
            "verseOrgIds": [
              "2SA.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
