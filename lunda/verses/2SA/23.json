          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyahaba wakuShayalaboni, wawanyana kaYasheni Jonatani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.23.32",
            "verseOrgIds": [
              "2SA.23.32"
            ]
          }
        },
