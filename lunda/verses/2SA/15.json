              "2SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wumu hakumuleja Davidi, nindi, Ahitofweli wudi hamu nanawa anakwati chikuchi naAbisalomi. Davidi hakwila nindi, Eyi Yehova, balumunaku mwani maana alejaŋayi aAhitofweli ekali wusupi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.31",
            "verseOrgIds": [
              "2SA.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.31",
            "verseOrgIds": [
              "2SA.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Davidi nindi ashiki hewulu damukandu hamulemeshelaŋawu Nzambi, kukasumuka Hushayi wakuAraki hakwinza nakumukinkilila, chikovwelu chindi chakutabula, kunamutu windi kudi maseki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.32",
            "verseOrgIds": [
              "2SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davidi hakumwila nindi, Neyi tukuya chimu neyi wakankalisha; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.33",
            "verseOrgIds": [
              "2SA.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa neyi wukufunta kumukala, hiwukumwila Abisalomi, neyi, Ami nukwikala kambuŋeyi, eyi mwanta. Chinadiŋi kambuŋatata yeyi hamwaka, nukwikala kambuŋeyi nawa; wakanfwomweni maana aAhitofweli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.34",
            "verseOrgIds": [
              "2SA.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netu, kwenoku hiwudi nawatupristu aZadoki naAbiyataruku? Chonsu chiwakatiya mwi tala damwanta wakalejamu atupristu aZadoki naAbiyatari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.35",
            "verseOrgIds": [
              "2SA.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena adi nawanyanawu ayedi kwenoku, mwana kaZadoki Ahimayazi, nimwana kaAbivatari Jonatani. Wenawa diwu mwakatemeshaŋa nakunshimwina yuma yimwakatiyaŋa yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.36",
            "verseOrgIds": [
              "2SA.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibwambu daDavidi Hushayi hakuya mumukala. Abisalomi niyena hakwijila muYerusalema.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.15.37",
            "verseOrgIds": [
              "2SA.15.37"
            ]
          }
        }
      ]
    }
