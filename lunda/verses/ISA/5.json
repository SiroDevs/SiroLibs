          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hosi wakazeya hela kuhukanaku; hosi Wakanoŋaoka helakukama tuluku; hosi wakamona muya windi kusubuka mumbundaku, helamwonji wankwabilu yindi kuketukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.27",
            "verseOrgIds": [
              "ISA.5.27"
            ]
          }
        },
        {
