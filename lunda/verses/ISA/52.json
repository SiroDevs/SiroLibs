      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 52:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Ziyona, tonaku, tonaku, wuvwali Ŋovu jeyi. Eyi Yerusalema, mukala wajila, vwalaku mahineyi alubanji. Kufumisha hanumweyeyi himwakeŋa ila cheŋi chidima namukwamajiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.1",
            "verseOrgIds": [
              "ISA.52.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Yerusalema didikumuni lunkuŋu, nyamukaku wushakami. Eyi nkoli, mwana kaZiyona wamumbanda, subulaku nyonji yidi kunshiŋu yeyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 52:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.2",
            "verseOrgIds": [
              "ISA.52.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 52:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nahoshi nindi, Ayilandili chakadi chuma, akayikuula nawa chakadi mali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Mwanta Nzambi nahoshi nindi, Antu amihakusambila akunkumukili muEjipitu nakushakamamu; aAshuri nawaayikabishili chakadi muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Ichi dinu nukwila pahikunu chatwalawu dehi antu ami chamukunkulu? Yehova nindi, Antu ayiyulaŋa hiyakukaloka, ijina dami hiyakudihoshaŋa chatama mwaana wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chakelukilawu ijina dami. Dichi chakelukilawu ifukuodu nawu, Diyi ami nahoshaŋa, tiyenu, yami.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 52:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.6",
            "verseOrgIds": [
              "ISA.52.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 52:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O chiyasweja lubanji hamapidi nyendu yamuntu wukuleta nsaŋuyayiwahi, wukutiyakesha jakuwunda, wukuleta nsaŋu yayiwahi yayuma yayiwahi, wukushimuna wamwinu, wukumwila Ziyona nindi, Nzambi yeyidiyi Mwanta! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 52:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu awantu eyi akwakutalatala, owu! Hiyakunyamuna izu dawu kwiwulu, hiyakuvwakuka kwimba tumina; muloŋa chakafuntayi Yehova kuZiyona akadimona mesu namesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 52:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mahembi aYerusalema, vwakukenu nakuzaŋa alala nikwimba tumina, muloŋa Yehova nakundejidehi antu indi, nakuuli dehi Yerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nedishi dehi chikasachindi chajila hatooka, kumesu anyuza yejima; insa jeseki jejima jakamona wamwinu waNzambi yetu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 52:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fumenuku, fumenuku, idikenumu, bayi mukunka kuchuma chamajiluku. Fumenu mukachi kawu. Ikalenu atooka enu mwasendaŋa yuma? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa himwakedi kamu chalufuchuku, himwakaya chakutemukaku, muloŋa Yehova diyi wakatwaminaŋa kumukuya; Nzambi yaIsarela diyi wakayikumaŋa munyima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 52:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 52:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, kambuŋami wakela chakashinshi; akamutúumbakesha akamulemesha, wakela muneni nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.13",
            "verseOrgIds": [
              "ISA.52.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 52:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamuhayaminuwu kudi antu amavulu, chamutamishiluwu kumesu indi, kanda atamishaŋahu dehi muntuniwumu chochochuku, chamutamishiluwu nimwindi mwekalilayi, kanda atamishaŋahu dehi anyana kawantu chochochuku; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.14",
            "verseOrgIds": [
              "ISA.52.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 52:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi chakasampwilayi nyuza yayivulu. Anyanta ankanu chakamutalawu akajika kukanwa, muloŋa akamona chuma chabulili kuyilejawu, akashinshika chuma chabulili kutiyawu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.15",
            "verseOrgIds": [
              "ISA.52.15"
            ]
          }
        }
      ]
    }
