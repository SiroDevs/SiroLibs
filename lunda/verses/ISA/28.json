  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "ISA 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayo, chibaaba chawakwakunwa waiwa muEfweremi chadinkawu nachu wanta! Niwuluya walubanji lwindi lwasweja kuwaha wudinakuya nakulepuka, wudi kwafuma chinekineki chamanji chanawa adimboka dehi navinyu! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.1",
            "verseOrgIds": [
              "ISA.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, Mwanta wukweti chilobu wasweja Ŋovu; wakayinataheseki nachikasa, neyi nvula yamalola, neyi mpepela yasweja Ŋovu yakisaŋanaŋa yuma, neyi dibaji dameji aŊovu dinakombi to-o. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.2",
            "verseOrgIds": [
              "ISA.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiba abacha wakwakunwa walwa muEfweremi chakudinka nachu wanta anachidatoli dehi nanyendu; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.3",
            "verseOrgIds": [
              "ISA.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "niwuluya walubanji lwindi lwasweja kuwaha wudinakuya nakulepuka, wudi kwafuma chinekineki chamanji, wakekala neyimukabu wachikuyu wasambilaŋahu dehi kwiha ninkanza yichidi kanda, wakwila chakuwumonayi mukwakutala iku wuchidi muchikasa chindi hakudyanikudya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.4",
            "verseOrgIds": [
              "ISA.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Yehova wamazaza diyi wakekala chiba abachasweja kuwaha nichibaŋula chalubanji chawantu indi akashalaku; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.5",
            "verseOrgIds": [
              "ISA.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakekalaspiritu yakusompesha kudi wukushakama nakusompesha, niŋovu kudi akumwaŋa njita kuchisu champwembu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.6",
            "verseOrgIds": [
              "ISA.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wa anapedaŋali navinyu, anatedaŋili nawalwa; nikapristu nikaprofwetu anatedaŋili nawalwa, vinyu yinayikwati dehi, hiyakutedaŋila nawalwa, hiya ltupedaŋila muyimwenu yawu, hiyakuhukana hukana kuwuŋa aji wawu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.7",
            "verseOrgIds": [
              "ISA.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa jimesa jejima jineli kwamasanjila hohu namajilu, kwosi nikwakuwahuku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.8",
            "verseOrgIds": [
              "ISA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.8",
            "verseOrgIds": [
              "ISA.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinyi akulejayi kwiluka? Wukushinshikishanyi mwaya izu? Awa asumuka dehi kumayeli, awa afumishawu dehi kunyesi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.9",
            "verseOrgIds": [
              "ISA.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuleja hakuleja, kuleja hakuleja; mufunda hamufunda, mufunda hamufunda; ikukanti, iku kanti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.10",
            "verseOrgIds": [
              "ISA.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nehi dinu, yena wukuleja antu awa nanyivumbu yawantu akwacheŋi; nedimi dacheŋi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.11",
            "verseOrgIds": [
              "ISA.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "antu awa eliliyi nindi, Kwenikudiku kunooka, munookeshenu muntu nazeyi. Nindi, Kweniku diku kuhizumuka, ilaŋa wena kwonti kwawu kutiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.12",
            "verseOrgIds": [
              "ISA.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi izu daYehova dakekalakudi wena kuleja hakuleja; kuleja hakuleja; mufunda hamufunda, mufunda hamufunda; iku kanti, iku kanti; kulonda ayi nakuhinukila hanyima, akakotoki, akafwi mumuhetu, akakwachiki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.13",
            "verseOrgIds": [
              "ISA.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu akwakadiwu, mwayulapa antu awa ekala muYerusalema, tiyenu izu daYehova, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.14",
            "verseOrgIds": [
              "ISA.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chimunahoshi nenu, Tunatiyaloŋani dehi nakufwa, tunakwati dehi mpùŋa nakaluŋa. Nenu, Chimwakahita chipupu chasweja hichakashika kudetuku; muloŋa etu kutwambatwamba wowufuulu wetu, mukudimbana dimu tunabatami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.15",
            "verseOrgIds": [
              "ISA.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Yehova Nzambi nindi, Tiyenu, ami hinukwala muZiyona ilola dachikuku, ilola dakweseka dehi, ilola dalema wuseya dakwiwombu, dachikuku chakola; muntu wukwitiya hakanyakalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.16",
            "verseOrgIds": [
              "ISA.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuŋaji diwu nukwilisha mwonji wakweseka nachu, kuloŋi nawa diku nukwilisha levo; nvula yamalola yakakomba wufuuli wenu wakutwambatwamba, wakafumaku, meji akakumpula wubataminu wenu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.17",
            "verseOrgIds": [
              "ISA.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.22",
            "verseOrgIds": [
              "ISA.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shenuku matu mutiyi izu dami; tiyililenu mutiyi munukuhosha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.28.23",
            "verseOrgIds": [
              "ISA.28.23"
            ]
          }
        }
      ]
    }
