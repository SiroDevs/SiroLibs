          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 61:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatiya kuwaha nankashi naYehova, muchima wami wakazaŋajala naNzambi yami, muloŋa nanvwiki mahina awamwinu, nambuti kanji yakuloŋa, neyi chelaŋayi iyala wudi nakusumbula mumbanda hakudilepaleŋa nayuma yayiwahi, nichelaŋayi mumbanda akusumbulawu hakudiwahisha wahisha nayingelingeli yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.10",
            "verseOrgIds": [
              "ISA.61.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 61:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chabalwishaŋa iseki nyitombu yindi, nichameneshaŋa itempa yuma yakuwapamu antu, dichi chakameneshayi Yehova Nzambi nikuloŋa nikushimeka kumesu anyuza yejima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.11",
            "verseOrgIds": [
              "ISA.61.11"
            ]
          }
        }
      ]
