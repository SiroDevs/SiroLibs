          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami Yehova nakeŋa wuŋaji, hinakeŋa kubuwa nakuluwaku. Nakayinka wufwetu wawu walala, nakatiyaloŋa ana nawu chitiyaŋenu chahaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 61:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanawu akayilukaŋa mukachi kawajentili, niakavwalawu Yeremia akayilukaŋa mukachi kanyuza yawantu. Antu ejima akayimona aketŋanawu, Hiyanyana anakiswiliyi Yehova nkisu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.9",
            "verseOrgIds": [
              "ISA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
