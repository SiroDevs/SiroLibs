  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "ISA 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niisaŋa nimpata yakadi antu yakatiya kuwaha; ikuna dakazaŋa laladakakenuka neyi wuluya walubanji. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dakakenuka nankashi, dakazaŋalala nakutiya kuwaha nakwimba tumina; akadinka kulema kwaLebanoni niwutotombu waKarameli naSharoni; akamona kulema kwaYehova, niwutotombu waNzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koleshenu makasa anazeyi, koleshenu nimaniuju anabuli Ŋovu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilenu akweti nyichima yawoma, nenu, Dikoleshenu, bayi mutiyaŋwomaku; tiyenu, Nzambi yenu wukwinza nakutenda, nikufutisha kwafutishaŋayi Nzambi; wukwinza nakuyamwina. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu dihu hakatoneshawumesu awamputamesu, dihu hakajikulawu matu awajika matu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.5",
            "verseOrgIds": [
              "ISA.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu dihu hakakilukayi mukwakubalakata neyi nkayi, niidimi dakamama dakemba tumina; muloŋa mwisaŋa mwawuma chau mwakabuzika meji, mwikuna mwakabuzika tuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.6",
            "verseOrgIds": [
              "ISA.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hawusekulula hadi nakuyemokayemu yemu hakabalumuka kwikala ŋiya, heseki dikweti mpwila hakabalumukakwikala tuseloki twameji, muyididi mwashakaminaŋa nyumbumwakekala matahu hamu namateti nanyishinji. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.7",
            "verseOrgIds": [
              "ISA.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku kwakekalaninjila, akayitena nawu, Njila yakujila; mukwamajilu kuhitamu nehi, ilaŋayakekala yanawa; akwakwenda njila, hela ayisupi, hiyakaluwila mwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.8",
            "verseOrgIds": [
              "ISA.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikwakekala mutupaku, hela kanyama wachisuma hakakandukila mwokuku, hiyakamumona kwenokuku; ilaŋa akúulewa diwu akendamu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.9",
            "verseOrgIds": [
              "ISA.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa anakúuluwu kudi Yehova akafunta, akenza kuZiyona iku adina kwimba tumina twawu. Hanyitu yawu hakekala kuluŋa kwahaya nyaka. Akamona kuwaha nikuluŋa, yihuŋu nikudishishimona yakatemuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.10",
            "verseOrgIds": [
              "ISA.35.10"
            ]
          }
        }
      ]
    }
  ],
