          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mwakaya nakuzaŋalala, akayilombola nakuwunda; nimpidi jamaneni nŋanyanya jakavwakuka kwimba tumina kumukuyenu, ninyitondu yejima yamumpata yakasakila nkoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadiŋa mutondu wanyiŋa wuwabulili kwiluka munjunŋa, mwadiŋi chikwata wuwabulili kwiluka chibubu, chakekala chakutiyakesha nachu ijina daYehova, nichinjikijilu chakwiluka nachu haya nyaka, hichamba kafumaku.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.13",
            "verseOrgIds": [
              "ISA.55.13"
            ]
          }
        }
      ]
