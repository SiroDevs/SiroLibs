              "ISA.55.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 55:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chanokaŋa nvula, ninvula yachisika yitooka mwiwulu, hiyafuntaŋanawa cheŋuku, ilaŋa yazoweshaŋa maseki, yasoŋeshaŋa, hiyikumeneshani nyitombu, hiyikumwinka mukwakukuwa mbutu, nimukwakudya ihiyikumwinka yakudya; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "dichi chakekala izu dami dakafuma mukanwa ikami, hidakafunta kudami makasakasaku, dakela munakeŋa, dakakoŋa chachiwahi mudimu wadu wunaditemesheleli.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
