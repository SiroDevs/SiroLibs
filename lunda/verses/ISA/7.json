          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Yehova wakemba muloji, wakutambika ninjinji jekala kwakumina tuloŋa twamuEjipitu, nimpuka jekala mwituŋa daAshuri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
