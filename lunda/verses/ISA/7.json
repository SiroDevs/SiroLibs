          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu iyala wakalela iyoŋa damukaji waŋombi, ninyikokuyiyedi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakadya manteka nanowu mayeli amavulu akamonayi kudi wena; muŋa antu ejima akashala mwituŋa kadya manteka nawuchi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        }
