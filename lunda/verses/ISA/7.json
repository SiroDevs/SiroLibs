          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu hejima hadiŋa nyivinyu ikombakaji yakulanda nekombakajidamali asiliva hakekala hambala hayikwata nanyiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu kwinzaku chiŋa wudi nansewu nawuta wamukunji, muloŋa ituŋa dejima dakekala kwayikwata nanyiŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwakatwesha kwinza kumpidi jejima jiwadiminaŋa namatemwaku, kuchina kuyikwata nanyiŋa, hakekalahakudiishila aŋombi, nihakudatola nyikoku.",
          "type": "text",
