          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Yehova wakayitewula ninsuki, niwuvuji wakunyendu, nampoku yachayi yanatambuliyi mwishinadi daKaloŋa kukopaku nachu, kafwampi yowu mwanta wawaAshuri; niwevu wejima nawa wakawumanishazo chikupu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        }
      ]
