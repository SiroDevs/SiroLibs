          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova hakuhosha cheŋi naAhazi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Mulombi Yehova Nzambi yeyi chinjikijilu; lombaku hela mwakunama hela mwiwulu mwajindama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        }
      ]
    },
    {
