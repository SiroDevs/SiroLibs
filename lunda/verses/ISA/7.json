          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jakenza jejima nakuzemukila muyinekineki yamukunkulu, nimunyajiyamumalola, nihanyipa yejima, nihayiputa yejima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
