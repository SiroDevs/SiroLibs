  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woho, mukakweji kekumi nakayedi, yowu kakweji Adari, hefukudekumi nakasatu dayena kakweji owu, izu damwanta nalushimbi lwindichilwashikili kwakwihi nakulukoŋa, ayilumbu jawaYudeya denodu ifukuhiyakukuhwelela nawu tukwikala anyanta jawaYudeya, komana chinabalumuki dehi mwacheŋi dinu, aYudeya diwu akwikala anyanta jakwankunyinawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwahita mawuloŋu amwanta Ahasuwenausi mwejima, aYudeya hiyakudipompesha munyikala yawu, kulonda akwati makasa hadi akukeŋa kuyikatisha. Hi kwadiŋi muntu watwesheli kudikaŋa nawultu, womawawu wakwatili nyuza yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atulamba ejima amumawuloŋu, niayilolu, nianguvulu, nielilaŋa nyidimu yamwanta, hiyakuyikwasha aYudeya, muloŋa woma waModekayi wayikwata dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Modekayi natohi dehi mwitala damwanta, nimpuhu yindi yinatiyakani dehi mwahita mawuloŋu ejima, muloŋa yena iyala Modekayi wadiŋi nakuya kumbidi hohu, hakusweja nikutoha. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya atapili ayilumbu jawu ejima nampoku yakabali, ayijaholeli, ayijilumwini, ayikoŋeli akwankunyi nawu mwonsu mwakeŋa eluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muŋanda muShushani aYudeya ajahilumu, ajilumwinumu amayala makulakaji atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajahili niParesha ndata, niDalifwoni, niAsipata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "niPorata, niAdaliya, niAridata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "niParamashita, niArisayi, niAridayi, niVayizata, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikumi dawanyana kaHamani amayala, Hamani mwana kaHamedata, mukwankunyi nawaYudeya; kwinza yuma yawu kuyibuwanehi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku odu amushimwinini mwanta mwashikili antu ajahiluwu muŋanda muShushani. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakumwila mwadi Esita, nindi, Chikaŋa muŋanda muShushani aYudeya ajahamu dehi, ajilumunamu dehi amayala makulakaji atanu, nianyana kaHamani ikumi, indi mumawuloŋuamwanta anashali anelumu ŋahi? Dichi dinu wunakeŋidi? Akakwinka. Wunakeŋi kulombadi? Akachikoŋa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esita nindi, Neyi mwantanatiyi kuwaha, aytŋi aYudeya adi muShushani, kumadiki akeli mwomulushimbilwalelu, akakudiki nianyana kaHamani ikumi kumutondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuyila nindi, Eli chochochu. Ashimuna nilushimbi muShushani, anyana kaHamani mwikumi dawu ayikudika nikuyikudika.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwifuku dakakweji Adari dekumi nakawana nawa, aYudeya adiŋi muShushani hiyakudipompesha hamu, hiyakujaha muShushani amayala makulakaji asatu, kwinza yuma yawu kuyibuwa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya amakwawu, adiŋi mumawuloŋu amwanta, hiyakudipompeshahamu, hiyakulwila wumi wawu, amona nikunooka nansaŋu jawayilumbujawu, hiyakujaha akwankunyi nawu makombakaji makumi atanu nayedinamakombakaji atanu, kwinza yuma kuyibuwa nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chenichi achilili hefuku dakakweji Adari dekumi nakasatu, hefuku dakakweji dekumi nakawʼanaanookeli, adibalumwini hiifuku dakudya chawija nakuzaŋalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yudeya adiŋi muShushani adipompesheli hamu nihefuku dakakweji dekumi nakasatu nidekumi nakawana, kwinza ifuku dakakweji dekuminakatanu anookeli, adibalumwini hiifuku dakudya chawija nakuzaŋalala. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chelilaŋawu ashakama munyikala yakadi mpwembu, abalumuna ŋafuku dakakweji Adari dekumi nakawana hiifuku dakuzaŋalala nakudyachawija, hiifuku dadiwahi dakuditemeshela yuma.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Modekayi wasonekeli yumiyi, wayitemesheleli aYudeya ejima adiŋi mumawuloŋu amwanta Ahasuwenausi ejima, nikwakwihi nikwakulehi, ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyikanda yakuyileja kuhemba ifuku dakakweji Adari dekumi nakawana, nidekumi nakatanu dayena kakweji owu hamwaka hamwaka; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "wowumafuku anookeluwu aYudeya mukachi kawayilumbu jawu, kakweji kadiŋi kayihuŋu hikakubalumuka kakuzaŋalala, ifuku dadiŋi dakudila hidikubalumuka ifuku dadiwahi; wenowu mafuku akayi balumuni ekali mafuku akudya chawija nakuzaŋalala, akuditemeshela yuma, akutemeshela nituzweŋiya mukunkulu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AYudeya etŋili kwila mwatachikiluwu, mwomwayisonekeleliyi niModekayi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kaAgagi Hamani, mwana kaHamedata, mukwankunyina waYudeya ejima, wayifuukwilili aYudeya kuyijilumuna, wombishili Puri, chochinjikijilu chakusakula nachu, nindi ayinopeshi, ayijilumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashikiliyi Esita kumesu amwenta, mwanta wayilejeli kunyi kanda kulonda chatama chayifu ukwililiyi aYudeya chakamu balumukili kunamutu windi yomweni, kulonda akamukudiki nawanyanindi kumutondu. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chatumbililuwu mafuku owu nawu Purimi, hohejina daPuri, nanowu mazu amukandiwu ejima, ninoyu yuma yamwenuwu hansaŋu iyi, ninoyu yumayayiweni; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "dihu hafumini aYudeya kushamu lushimbi lwakwila niwena, ni anyanawu amba kavwalika, niantu ejima adibomba nawu, akahembaŋa mafuku awa ayedi hamwaka hamwaka, mwomwasonekeluwu, hohaya kaya yishiikiluwu, kulonda chakabuli kujiya; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mafuku awa akayanukaŋaho-o, akayihembaŋa ho-o, kumakiŋu ejima amba kavwalikilaŋawu antu mwahita yisaka yejima nimawuloŋu ejima, nimunyikala yejima; kulonda mafuku awa aPurimi akabuli kujiya mukachi kawaYudeya, akayanukaŋaho-o kudi anyanawu chakadi kukumisba. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        },
        {
