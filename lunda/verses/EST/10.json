              "type": "text"
            }
          ]
        },
        {
          "text": "Mwailta Ahasuwenausi walambwishili ituŋa niyikulishu yakukaluŋalwiji. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyidimu yaModekayi yejima, yaswejeli niwantaniŋovu, nimwalemeneniyi Modekayi mwejima, nimwamutohesheleliyi mwanta, hiyanayisoneki mumukanda wakushindulula wawanyanta akuMediya nakuPeresuku, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kaYudeya Modekayi diyiwalondeli munyima yamwanta Ahasuwenausi, watoheli mukachi kawaYudeya, amutiyili kuwaha kudi ana kwindi ejima mwavulilawu, wakeŋa akeŋelaŋa hakuwahishila antaŋa jindi, wahoshelaŋa chachiwahi kudi anyanindi ejima.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
