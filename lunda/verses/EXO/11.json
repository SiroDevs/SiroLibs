          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi naAroni elili yihayamisha iyi yejima kumesu aFwaro; Yehova wachinchikishili muchima waFwaro, haytŋili anyana kaIsarela kufuma mwituŋa dinduku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
