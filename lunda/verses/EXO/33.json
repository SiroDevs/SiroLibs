        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli cheŋi naMosi, nindi, Nyamukenu, mufumi kununineyi niantu iwafumishili mwituŋa daEjipitu, muyi kwituŋa dinasanyi kilili Abarahama, naIsaka, naYakoba, ituŋa dinelili nami, Nakadinka anyaneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.1",
            "verseOrgIds": [
              "EXO.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakatemeshaŋahu kapelu kumbidi kuwukuya; nakatemunamu kaKenani, ni kaAmori, nikaHiti, nikaPerizi, nikaHivi, nikaYebusi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.2",
            "verseOrgIds": [
              "EXO.33.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.6",
            "verseOrgIds": [
              "EXO.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Mosi watwelelaŋa itenti nakudilema kupandakana hachilombu kwakulehi nachilombu; waditeneni nindi, Itenti dakubulakena. Elili neyimuntu hakukeŋa Yehova hakwidika muchilombu hakuya kwitenti dákubula kena dadiŋi oku kwakupandakana chilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.7",
            "verseOrgIds": [
              "EXO.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelilaŋayi Mosi hakwidi kamuchilombu hakuya kwitenti, antu ejima hiyakunyamuka, hiyakwimana, muntu muchisu chetenti dindi, muntu muchisu chetenti dindi, hiyakuhuŋununa mesu nakutala mwakuyayi Mosi nichichakwijila yi mwitenti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.8",
            "verseOrgIds": [
              "EXO.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelilaŋayi Mosi hakwijila mwitenti, chishimi chevu hichi kuzenzumuka, hichikwimana kwokuchisu chetenti, niYehova hakuhosha naMosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.9",
            "verseOrgIds": [
              "EXO.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antuejima amweni chishimi chevu hichikwimana kuchisu chetenti, niantu ejima hiyakunyamuka, hiyakudifukula, muntu muchisu chetenti dindi, muntumuchisu chetenti dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.10",
            "verseOrgIds": [
              "EXO.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi mesu namesu, neyichahoshaŋayi muntu nebwambu dindi. Yena wafuntilaŋa cheŋi muchilombu; ilaŋa kambanji kindi, mwana kaNuni Yoshuwa, mukwenzi weyala, saŋa emenayi mwitenti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.11",
            "verseOrgIds": [
              "EXO.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili Yehova, nindi, Tala, wunaŋili neyi, Twalaku antu awa, ilaŋa wunabuli kunleja iwakantemesha nindi. Ilaŋa eyi wunahoshi neyi, Nakwiluki ijina deyi, neyi, Nakutoŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.12",
            "verseOrgIds": [
              "EXO.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu mwani, neyi wunantoŋi, anleji dinu njila yeyi, kulonda ni kwiluka, kulonda wuntoŋi; atali hadi muzdiwu wuyiluki neyi antu ami. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.13",
            "verseOrgIds": [
              "EXO.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Mesu ami akaya naneyi, nakakunookesha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi wamwilili nindi, Neyi mesu eyi kuya nanami nehi, bayi wututwalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.15",
            "verseOrgIds": [
              "EXO.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi antu akwiluka ŋahi nawu ami wunantoŋi ninamini antu eyi? Hiyakwiluka nanochu chitukuya naneyuku? Ami nawantu eyimwenomu dimu tukwambukila kudi antu ejima ekala hewulu damaseki, indiheŋi nawa? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.16",
            "verseOrgIds": [
              "EXO.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Mosi, nindi, Ami nukwila chumichi chiwunahoshi, muloŋa nakutoŋi, nakwiluki ijina deyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
              "EXO.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Anmwekesheli mwani, kulema kweyi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.18",
            "verseOrgIds": [
              "EXO.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi nindi, Kuwaha kwami kwejima nukukuhitisha kumesu eyi, nukubidika nakutena ijina daYehova kumesu eyi; yowunukukeŋa kutoŋa diyi nukutoŋa, yowu nukutiyila wushona, diyi nukutiyilawushona. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.19",
            "verseOrgIds": [
              "EXO.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Hiwukutwesha kumona kumesu amuku, muloŋakwosi muntu wakanmonami ahandaku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.20",
            "verseOrgIds": [
              "EXO.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova welili nindi, Tala, kunukunidi kudi kwakwimena, wukwimana helola; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "chikwila chikukuhita kulemakwami nukukusha mumwaji welola, nukukubuta nachikasa chami nichinukuhita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.22",
            "verseOrgIds": [
              "EXO.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukufumisha chikasa chami, wakanmona chanyima, ilaŋamesu ami hiyakamonewaku.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.23",
            "verseOrgIds": [
              "EXO.33.23"
            ]
          }
        }
      ]
    }
  ],
