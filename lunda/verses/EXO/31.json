    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli cheŋi naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.1",
            "verseOrgIds": [
              "EXO.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Tala, namutambi kiBezaleli mwana kaUri, Uri mwana kaHuri, wakumuchidi waYuda, hejina dindi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.2",
            "verseOrgIds": [
              "EXO.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "namwinzeshi naSpiritu yaNzambi, muma ana, nimukashinshi, nimukwiluka, nimuwukalawenu wejima, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.3",
            "verseOrgIds": [
              "EXO.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda akatoŋojoki chachiwahi muwililu wanyidimu yawutotombu yakukalakala nawuru, nasiliva, nawuneŋu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.4",
            "verseOrgIds": [
              "EXO.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "akaketoli nitumalola twakupata, akabazi nyitondu, akakalakali mwejima mwaya wukalawenu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.5",
            "verseOrgIds": [
              "EXO.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala, ami nabombeluku hadi yena Oholiyabi, mwana kaAhisamaki, wakumuchidi waDani; munyichimayawantu ejima akweti maana nashumu maana kulonda akatuŋi yumayejima yinakuleji; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.6",
            "verseOrgIds": [
              "EXO.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akatuŋi niitenti dakubulakena, nichimbaŋu chawunsahu, niitanda daluwi dekalahu, niyuma yejima yamwitenti; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.7",
            "verseOrgIds": [
              "EXO.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimesa, niyumayayu, niinoŋu ditooka to-o, niyuma yadu yejima, nikameŋa kainsensi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.8",
            "verseOrgIds": [
              "EXO.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nikameŋa kahimulambu wakushita, niyuma yaku yejima, nimbashilayakuwelela niitentaminu dayu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.9",
            "verseOrgIds": [
              "EXO.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyuma yakuvwala yakutuŋa chachiwahi, yuma yajila yakuvwala kapristu Aroni, niyuma yakuvwala anyanindi amayala kulonda akakalakali nachu mudimu wawupristu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.10",
            "verseOrgIds": [
              "EXO.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimanji akuwayishaŋanachu, niinsensi yevumba dadiwahi yamwajila; akeli mwejima munakuleji.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.11",
            "verseOrgIds": [
              "EXO.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli cheŋi naMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.12",
            "verseOrgIds": [
              "EXO.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nawanyana kaIsarela, neyi, Chiŋa muhembaŋa sabata jami, muloŋa hichinjikijilu chetunanami nanenu, mwamba kavwalikaŋawu anyanenu; kulonda mwakelukaŋanenu ami yami Yehova nayijilikaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.13",
            "verseOrgIds": [
              "EXO.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwakahembaŋa sabata, muloŋa yajila kwenu; yowu muntu wakayijilola, chiŋa akamujaha hohu; yenowu muntu wakakalakelamu mudimu, akamufumishi mudi antaŋa jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.14",
            "verseOrgIds": [
              "EXO.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafuku imukukalakalaŋa nyidimu wowu atanu nadimu hohu, kwinza ifuku damu chitanu nachiyedi hisabata yakunooka kwalema, dajila dambala daYehova hohu; yowu muntu wakakalakala mudimu hefuku dasabata, chiŋa akamujaha hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.15",
            "verseOrgIds": [
              "EXO.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi anyana kaIsarela akahembaŋa sabata, akashi sabata kumuchima kunyaka yejima amba kavwalikaŋa anyanawu, yachitiyaŋenu chahaya nyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.16",
            "verseOrgIds": [
              "EXO.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hichinjikijilu chetu, nanami nawanyana kaIsarela chahaya nyaka; muloŋa mafuku atanu nadimu Yehova wale dehi mawulu namaseki, hefuku damu chitanu nachiyedi hakunooka, hakutiyanihi-i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.17",
            "verseOrgIds": [
              "EXO.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakumishiliyi kuhanjika nindi hampidi yaSinayi wamwinkeli Mosi malola awunsahu ayedi, malola awubasa, akusoneka namunu waNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.31.18",
            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        }
      ]
    }
  ],
