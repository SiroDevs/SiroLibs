              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivu dabutili itenti dakubulakena wi-i, ni kulema kwaYehova kwenzesheli tabanaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
