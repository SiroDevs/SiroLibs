        },
        {
          "text": "Watambwili wunsahu, wawushili muchimbaŋu, waloŋeli ninyikambu kuchimbaŋu, washili itanda daluwi hewulu dachimbaŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
