          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosi hatwesheli kwijila mwitenti dakubulakenaku nevudabutiluhu, ni kulema kwaYehova kwenzesheli tabanaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
