          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elilaŋa ivuchidi kunyamuka hatabanaka anyana kaIsarela hiyakwenda, mwomwendeleluwu mukwenda kwawu kwejima; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.36",
