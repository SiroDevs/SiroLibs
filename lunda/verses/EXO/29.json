          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinakashakama dinu mukachi kawanyana kaIsarela, hinakekala Nzambi yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.45",
            "verseOrgIds": [
              "EXO.29.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 29:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwena akeluka nawu yami Yehova Nzambi yawu, yami nayifumishili mwituŋa daEjipitu, kulonda nakashakami nawu. Yami Yehova Nzambi yawu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.46",
            "verseOrgIds": [
              "EXO.29.46"
            ]
          }
        }
