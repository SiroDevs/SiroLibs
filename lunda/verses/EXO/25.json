              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakeli nimanoŋu adu, atanu nayedi; akabutuli manoŋuadu kulonda kutoŋeka chejeji kudidi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
