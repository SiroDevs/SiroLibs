          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakatuŋi ihina damaasamaasa dawanda wawuwahi dachikovwelu chahewulu, wakatuŋi ninkuku nehina dawanda wawuwahi, wakatuŋi nimuya, wakekali mudimu wamukwakuchima nakusowashana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        }
