              "type": "text"
            }
          ]
        },
        {
          "text": "nimesa, niyuma yayu yejima, nimankendi akutentekaŋa kumesu aNzambi; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
