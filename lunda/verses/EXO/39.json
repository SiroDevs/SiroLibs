            }
          ]
        },
        {
          "text": "mkameŋa kawuneŋu, nikanyungulu kaku kawuneŋu, ninyikambu yaku, niyuma yaku yejima, nimbashila yakuwelela, niishinadayu; ",
          "type": "text",
