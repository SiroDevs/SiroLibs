          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naMosi, nindi, Ami yami Yehova; mwejima munakahosha neyidimu wakahosha naFwaro mwanta wakuEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
