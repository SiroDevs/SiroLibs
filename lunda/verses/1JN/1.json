      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chadiŋi chakufumisha kutachi, chitunatiyi, chitunamoni namesu etu, chitwashinshikili, tuchikwata ninamakasetu, yowu izudawumi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumi wamwekeni, twawumweni, hitukushimuna wunsahu, hitukuyishimwina wumi wahaya nyaka wadiŋi naTata, watumwekesheleluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ochu chitunamoni, chitunatiyi, dichi chitukuyishi mwina ninenu, kulonda mwakakundaŋani nanetu; chalala kukundaŋana kwetu yowu kukundaŋana naTata ninaMwanindi Yesu Kristu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitukusoneka yumiyi kulonda muzaŋilu wenu wakawanini.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaŋu yitwatiyili kudi yena diyi tukuyishi mwinenu, netu Nzambi hichejeji mudi yena himwekala mwidima hela wantuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tukwila netu twadikunda nindi, iku seŋa twendela mumwidima, tunatwambi, hitwelaŋa mwaya nsaŋu yalalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi twendaŋa muchejeji, neyi chekalayi yena muchejeji, twakundaŋanaŋa wumu namukwawu, nimashi aMwanindi Yesu atutookeshaŋa nshidi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tukwila netu hitunavulumunuku, tunadidimbi, ninsaŋu yalala hiyekala mudetuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tukwiteja namutunavulumuni, yena washinshika waloŋa, wukutwanakena nyiloŋa yetu nakututookesha kuheŋa kwejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi tukwila netu hitunavulumunuku, tunamutwambishi, nimazu indi hiyekala mudetuku.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.10",
            "verseOrgIds": [
              "1JN.1.10"
            ]
          }
        }
      ]
    }
