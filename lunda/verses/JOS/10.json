      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chatiyiliyi Adoni Zedeki mwanta wakuYerusalema, nawu Yoshuwa nalukuki dehi Ayi, nawujilishi dehi chikupu, nawu mwomweliliyi Yeriku nimwanta wawu, dimu mwaneliyi niAyi nimwanta wawu, nawu nieniGibeyoni atiyaŋana dehi nawaIsarela, anashakami dehi nawu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.1",
            "verseOrgIds": [
              "JOS.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "atiya niwoma nankashi, muloŋa Gibeyoni wadiŋi mukala weneni, neyi kwiji mukala waŋanda, mukala waAyi wakeheluku, nimayala ejima adiŋumu adiŋi ayilobu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.2",
            "verseOrgIds": [
              "JOS.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Adoni Zedeki, mwanta wakuYerusalema watumesheli nikudi Hohama mwanta wakuHeberoni, nikudi Pirama mwanta wakuYaramuti, nikudi Yafwiya mwanta wakuLakishi, nikudi Debiri mwanta wakuEgeloni, nindi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.3",
            "verseOrgIds": [
              "JOS.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzenu kunu kunidami munkwashuku, tutapenu Gibeyoni; muloŋa jatiyaŋana dehi naYoshuwa nawanyana kaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.4",
            "verseOrgIds": [
              "JOS.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu anyanta awaAmori atanu, iwu mwanta wakuYerusalema, iwu mwanta wakuHeberoni, iwu mwanta wakuYaramuti, iwu mwanta wakuLakishi, iwu mwanta wakuEgeloni, apompeli hamu, akandukili, niwena ninjita jawu jejima, akaminini Gibeyoni hakatanda kalufu alwi nawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.5",
            "verseOrgIds": [
              "JOS.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala akuGibeyoni atumesheli kudi Yoshuwa kwaaiŋiyi kuchilombu chakuGiligali, nawu, Bayi wulaba kutukwashaku, etu ambugeyuku, tunyakeli swayi swayi, wutwamwini, wutukwashuku, muloŋa anyanta ejima awaAmori ashakama kumapidi anatupompeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.6",
            "verseOrgIds": [
              "JOS.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yoshuwa wafumini kuGiligali, wakandukiluku niyena niakwanjita ejima, niyilobu akwaŋovu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.7",
            "verseOrgIds": [
              "JOS.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Yoshuwa nindi, Bayi wuyitiya womaku, muloŋa ami nakwinkuwu; kwosi iyala niwumu wakataŋika naneyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.8",
            "verseOrgIds": [
              "JOS.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wayikasumwishili, wafumini kuGiligali nakukanduka wufuku wejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.9",
            "verseOrgIds": [
              "JOS.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayimwaŋili kumesu awaIsarela, wayijaholeli kwanyilaŋalaŋa kuGibeyoni, wayikupishili njila yakukandama kuBetihoroni, wayitapili tape-e ndo nikuAzeka nikuMakeda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.10",
            "verseOrgIds": [
              "JOS.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chayitemukiluwu aIsarela, hiyakuya nakukunkumuka mukandu wakuBetihoroni, Yehova wayasili malola amaneni kwiwulu, ase-e ndo nikuAzeka, afwili; niatapiluwu anyana kaIsarela nampoku yakabali akeheli, avulili afwili nanvula yamalola.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.11",
            "verseOrgIds": [
              "JOS.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifuku dayinkeliyi Yehova anyana kaIsarela aAmori, Yoshuwa wahosheli naYehova kumesu awaIsarela, welili nindi, Eyi itagwa, imanaku haGibeyoni, nineyi kakweji, imanaku muchinekineki chaAyijaloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.12",
            "verseOrgIds": [
              "JOS.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitagwa demeni nikakweji kemeni kuyadiŋi, nichaditendeli muza waIsarela hadi ayilumbu jawu. Chenichi hiyanachisoneki mumukanda waYasharaku? Itagwa demeni mukachi kewulu, hidanyakeli kuhumaku neyi ifuku dejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.13",
            "verseOrgIds": [
              "JOS.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela kunyaka yakusambila hela kunyaka yakukuminina, dena ifuku dafwana neyi odu kanda adimonuhu dehi kudi antuku, datiyilahu dehi Yehova mwizu damuntu, muloŋa Yehova wayilwilili aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.14",
            "verseOrgIds": [
              "JOS.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.21",
            "verseOrgIds": [
              "JOS.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henahana Yoshuwa welili nindi, Jikulenu kukanwa keyegu muyiidishi wenawa anyanta atanu mwiyegu, muyileti kudami. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.22",
            "verseOrgIds": [
              "JOS.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi cheliluwu, amwidishililuwu mwiyegu wenana anyanta atanu, iwu mwanta wakuYerusalema, iwu mwanta wakuHeberoni, iwu mwanta wakuYaramuti, iwu mwanta wakuLakishi, iwu mwanta wakuEgeloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.23",
            "verseOrgIds": [
              "JOS.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu anamwidishililuwu dehi Yoshuwa wenana anyanta, Yoshuwa hakutambika amayala aIsarela ejima, hakuyila awakulumpi akwanjita ayiliyi nawu, nindi, Twayenu kwakwihi muyidati wenawa anyanta hanshiŋu. Ayili kwakwihi, ayidatili hanshiŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.24",
            "verseOrgIds": [
              "JOS.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa hakuyila nindi, Bayi mutiya woma, hela kwakamaku; dikwatishenu, múumiki chacheni, muloŋa dichi chakayilayi Yehova ayilumbu jenu ejima imukulwa nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.25",
            "verseOrgIds": [
              "JOS.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu cheliliyi Yoshuwa nakumishi dehi kuhosha, hakuyitapa, hakuyijaha, hakuyikudika kunyitondu yitanu; ayilekeleluku chochayikudikawu nichikwela melela. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.26",
            "verseOrgIds": [
              "JOS.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili itagwa hidikuya nakuhuma, Yoshuwa wayilejeli antu, ayikulula nikuyikulula kunyitondu, ayumbila mwomwenomu mwiyegu mwabataminuwu, asha nimalola kukanwa keyegu, nilelu kwaduwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.27",
            "verseOrgIds": [
              "JOS.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dena ifuku odu Yoshuwa walukukili Makeda, wawutapili nampoku yakabali, nimwanta wawu; wayijilumwini ji-i niantu ejima adiŋumu; hashiyili hoku niwumuku mwomwamwililiyi mwanta wakuYeriku dimu mwamwililiyi nimwanta wakuMakeda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.28",
            "verseOrgIds": [
              "JOS.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wafumini kuMakeda niaIsarela ejima, ayili kuLibina, alwili naLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.29",
            "verseOrgIds": [
              "JOS.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayinkeluwu Isarela niwena nimwanta wawu, hakuwutapa nampoku yakabali, niantu ejima adiŋumu; hashiyili hoku niwumuku; mwomwamwililiyi mwanta wakuYeriku, dimu mwamwililiyi nimwanta wawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.30",
            "verseOrgIds": [
              "JOS.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wafumini kuLibina hamu nawaIsarela ejima, ayili kuLakishi, atuŋililuku chilombu, alwili nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.31",
            "verseOrgIds": [
              "JOS.10.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wayinkeli aIsarela mukala waLakishi, awulukukili ifuku damuchiyedi, awutapili nampoku yakabali niantu ejima adiŋumu, mwejima mweliliyi Libina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.32",
            "verseOrgIds": [
              "JOS.10.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
