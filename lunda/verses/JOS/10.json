            }
          ]
        },
        {
          "text": "Yoshuwa wafumini kuEgeloni hamu nawaIsarela ejima, akandukili nakuya kuHeberoni. Alwili nawu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
