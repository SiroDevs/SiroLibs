    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunahiti nyaka yayivulu, chanayimweneshiyi Yehova aIsarela kudi ayilumbu jawu kwi-ndo, niYoshuwa nakuli dehi, nyaka yindi yinamuvulili dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa hakutambika aIsarela ejima, niakulumpi jawu, nianyanta jawu, niansompeshi jawu, niatulala twawu, hakuyila nindi, Ami nakula dehi, nyaka yami yanvulila dehi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.2",
            "verseOrgIds": [
              "JOS.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "munamoni yuma yejima yanayiliyi Yehova Nzambi yenu nyuza iyi yejima hanyijimba yenu; muloŋa Yehova Nzambi yenu diyi nayilwili. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, nayambwilili nachinjikijilu chakusakula nachu nyuza oyu yinashali, kulonda yili wuswana wakuswana nyichidi yenu, kufumisha kuYodana, nanyuza yejima yinajilumuni ami, kushika nikukaluŋalwiji keneni kwayaŋa itagwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yenu diyi wakayishinjikilawu kumukuyenu, diyi wakayitemwinawu kumesu enu, mwakaheta ituŋa dawu mwomuna mwayiliosheliyi Yehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi umikenu nankashi, muhembi mwili yejima yinasonekewi mumukanda wanshimbi jaMosi, kulonda mubuli kutegulukamu nakuya hela kuchikasa chachidiilu hela kuchikasa chachimunswa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.6",
            "verseOrgIds": [
              "JOS.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mubuli kudibomba nanyuza iyi yinashali kudenu; bayi mwakatena hela ijina dawakishi awuku, hela kuyisanyika, hela kuyipesha, hela kuyifukaminaku; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.7",
            "verseOrgIds": [
              "JOS.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "chiŋa mumulamata Yehova Nzambi yenu neyi chimuneli kushika nikwitagwa dalelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yehova nayitemwini kumesu enu nyuza yamaneni yikweti Ŋovu; hakwila enu nilelu antu ejima saŋa ayikagenyawu, hosi niwumu natweshi kudikaŋa nenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenu wumu wakahaŋa ikombakaji dawantu; muloŋa Yehova Nzambi yenu diyi wayilwilaŋa mwomuna mwayiliosheliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi babalenu nankashi kulonda mwakakeŋi Yehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mona neyi mukufuntamu hela hantesha, nakulamata nyuza oyu yinashaluku, yoyu yinashali kudenu, nakusumbwaŋana nawu, nakwijila mudi wena, niwena nakwijila mudenu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilukenu kwenu chalala nenu Yehova Nzambi yenu hakayitemwina cheŋi nyuzoyu kumesu enuku; yakela muhetu nimbulu yakufwa enu, yakela chikoti chakumbavu jenu, yakela nyiŋa yakumesu enu, nichimwakajilumuka ji-i mwituŋa di dadiwahi danayinkiyi Yehova Nzambi yenu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu, lelu hinukuya mwayaŋa antu ejima ahanu heseki; enu muneluki nanyichima yenu yejima, nawumi wenu wejima, nenu hikunakaŋanyi chuma chachiwahi nichimu chayiteneniyi Yehova Nzambi yenuku, yejima munayimoni, kwosi nichuma chinakaŋanyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi chimunamoni yuma yayiwahi yejima yayiteneneniyi Yehova Nzambi yenu, dichi chakayimweshawu kudi Yehova yuma yatama yejima, nichakayijilumunayi ji-i mwituŋa di dadiwahi danayinkiyi Yehova Nzambi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimukumotoka chitiyaŋenu chayilejeliyi Yehova Nzambi yenu, nakuya nakupesha akishi nakuyifukamina, henohu kuzuwa kwaYehova kwakayivulumukila, ninenu mwakajilumuka mwituŋa di dadiwahi danayinkiyi swayi swayi hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
      ]
    }
  ],
