          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wahosheli naYoshuwa, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshaku nawanyana kaIsarela, neyi, Ambulenu nyikala yenu yakupulukila, yina yinayishimwini kukanwa kaMosi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda mbanji najahi mukwawu chakuluwukila chakadi kwiluka, akatemukiluku; yakekali nyikala yenu yakupulukila, kuchina mukwakutenda mukwawu anajahuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akatemukili kumukala owu, akemani kuwiŋililu wakuchisu chamukala, akashimuni nsaŋu yindi kudi awakulumpi amukala wuna, wena akamutambuli mumukala mwaduwu, akamuleji mwakushakama kulonda ashakami nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi mukwakutenda mukwawu wakamuhaŋa owu mbanji, bayi akamwinkayi owu muntuku, muloŋa yena watapili mukwawu chakadi kwiluka, hakusambila hadikwatili nindi nkunyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena akashakami mumukala wuna nichichakemanayi kumesu achipompelu nakumusompesha, nichichamba kafwayi kapristu muneni wakitunafuku ana; henohu mbanji akafunti cheŋi, akayi kumukala wawu, kwitala dindi, kwoku kumukala kwafuminiyi hatemukihyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu ajilikili niKedeshi wakuŊaliliya kuna kwituŋa daNafwatali damapidi, niShekemi wakwituŋa dakuEfweremi damapidi, niKiriyati Araba, diyi Heberoni, wakwituŋa daYuda damapidi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwishinadi daYodana kuYeriku mbadi yamusela, aambwili niBerezi mwisaŋa muchana, kumuchidi waRubeni, niRamoti Gileyadi kumuchidi waGadi, niGolani muBashani kumuchidi waManase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeniyi diyi nyikala yaambwililuwu anyana kaIsarela ejima, niafuma mumatuŋa acheŋi, kulonda muntu najahi mukwawu chakuluwukila akatemukiluku, akabuli kumujaha kudi mukwakutenda, nichichamba kemanayi kumesu achipompelu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
