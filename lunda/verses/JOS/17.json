    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imudimu mwasakwililuwu muchidi waManase nachinjikijilu; muloŋa yena hiwedi waYosefu. Hakwila Makiri wedi waManase, tata yaGileyadi, nanochu chadiŋiyi mukwanjita, hakutambula niGileyadi niBashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwasakwililuwu mwadiŋi mwambala mwawanyana kaManase asheluku, mwahita yisaka yawu; mwawanyana kaAbiyezeri, mwawanyana kaHeleki, mwawanyana kaAsiriyeli, mwawanyana kaShekemi, mwawanyana kaHefwenai, mwawanyana kaShemida, wenawa diwu adiŋi anyana kaManase mwana kaYosefu amayala, mwahita yisaka yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Zelofwehadi mwana kaHefwenai, Hefwenai mwana kaGileyadi, Gileyadi mwana kaMakiri, Makiri mwana kaManase, hadiŋi nawanyana amayalaku, wadiŋi nawanyana awambanda hohu; majina awanyanindi wowenawa; iwu Mahala, iwu Nowa, iwu Hoŋala, iwu Milika, iwu Tiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aswilili kwakwihi kumesu akapristu Eleyazari nikumesu amwana kaNuni Yoshuwa, nikumesu awatulamba, nawu, Yehova wamulejeli Mosi kutwinka wuswana wetu mukachi kawana kwetu amayala. Dichi mwomwalejeliyi Yehova wayinkeli wuswana mukachi kawana kwatata yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.4",
            "verseOrgIds": [
              "JOS.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwaholokeleli Manase maseka ikumi, kubombelaku niituŋa daGileyadi naBashani, dekala kwishinadi daYodana; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.5",
            "verseOrgIds": [
              "JOS.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa anyana kaManase awambanda adiŋi nawuswana wawu mukachi kawanyanindi amayala, niituŋa daGileyadi dadiŋi dawanyana kaManase amayala asheluku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.6",
            "verseOrgIds": [
              "JOS.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yaManase yafumini kuAsheri nakutwala kuMikimetata womba mesu kuShekemi; ŋinza yahitili kuchikasa chachidiilu, yashikili nikudi eniEntapuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.7",
            "verseOrgIds": [
              "JOS.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋa daTapuwa dadiŋi daManase; hakwinza Tapuwa, haŋinza yaManase, dadiŋi dawanyana kaEfweremi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.8",
            "verseOrgIds": [
              "JOS.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yakunkumukili kukakaloŋa yowu Kana, ishinadi dakakaloŋa dakabeta kakuchidiilu; nyikaloyu yadiŋi yaEfweremi, mukachi kanyikala yaManase; ŋinza yaManase yadiŋi ishinadi dakakaloŋa dakabeta kakuchimunswa, kuyakumini kwokukaluŋalwiji; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.9",
            "verseOrgIds": [
              "JOS.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukabeta kakuchidiilu kwadiŋi kwaEfweremi, kukabeta kakuchimunswa kwadiŋi kwaManase, nikaluŋalwiji yoyi ŋinza yindi; ashikili nikuAsheri kumbadi yakabeta kakuchimunswa, nikuIsakari kumusela. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.10",
            "verseOrgIds": [
              "JOS.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "NimuIsakari nimuAsheri Manase wadiŋi naBetisheyani ninyikala yawu, nibiyelamu ninyikala yawu, nieniDori ninyikala yawu, nieniEndori ninyikala yawu, nieniTanaki ninyikala yawu, nieniMegido ninyikala yawu, yowu nyikandu yisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilana anyana kaManase akaŋenyi kuyitemunamu akwanyikala yina, muloŋa aKenani elili nawu etu kwetu tukushakama mwituŋa di. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu anyana kaIsarela anakwati dehi Ŋovu ayikalakesheli aKenani nyidimu, hiyayitemwinumu chikuptiku.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaYosefu amwilili Yoshuwa nawu, Wunanyinkelidi wuswana weseka dimu hohu dakusakula nachinjikijilu, kweseka dimu hohu, kutoŋa yami muza weneni, niYehova saŋa ankoolekeshelayi nihanu! ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Yoshuwa nindi, Neyi eyi wumuza weneni, yaŋa kweyi mwisaŋa, wakaditemeni oku kwituŋa dawaPerizi nida waRefwa; neyi ituŋa daEfweremi damapidi dinakukeheli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaYosefu nawu, Ituŋa damapidi hitukuwana mwokuku, niaKenani ejima ashakana muchinekineki akweti makálu ayikugu ninana adi muBetisheyani nanyikala yawu, ninana adi muchinekineki, chaYezereyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wahosheli namutaŋa waYosefu, wowu aEfweremi naManase, nindi, Eyi wumuza weneni, wukweti niŋovu yayivulu; eyi wukutambula iseka dakusakula nachinjikijilu dimu hohu wanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa ituŋa damapidi dakela deyeyi, muloŋa hela hiisaŋa, wakaditema kweyi, nikudakumina dakela deyeyi, muloŋa aKenani wakayitemunamu, hela neyi akweti makálu ayikugu, hela akweti Ŋovu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
    }
  ],
