  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JOS 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Yoshuwa, nindi, Bayi wutiyaŋa womaku, bayi wakama akwenuku; akwanjita ejima yaŋa nawu, nyamukaku, yaku kuAyi. Tala, nakwinki dehi nimwanta wakuAyi, niantu indi, nimukala windi, niituŋa dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakakoŋi mukala waAyi nimwanta wawu neyi chiwakoŋeli mukala waYeriku nimwanta wawu; hakwila yuma yidumu, niŋombi jawu, mwakaditambwila yenwenu aweni. Wakabelamisha antu kumukala kunyima yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yoshuwa niakwanjita ejima anyamukili nakuya kuAyi. Yoshuwa watondeli amayala makombakaji makumi asatu, ayilobu akwaŋovu, wayitemesheli nawufuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.3",
            "verseOrgIds": [
              "JOS.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wayilejeli nindi, Talenu, mwakabelamina mukala, kwokunyima yamukala kachi, bayi muya kwakulehi namukalaku, wejima wenu mushakama nakutalila hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.4",
            "verseOrgIds": [
              "JOS.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ninami niantu ejima inidi nawu twakakundama kumukala. Chakedikawu nakulwa nanetu neyi cheliluwu hakusambila, twakayitemuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.5",
            "verseOrgIds": [
              "JOS.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena akedika nakutuhaŋa nichitwakayikoka nakuyifumisha kumukala, muloŋa akela nawu, Anatutemuki neyi cheliluwu hatachi; nochu twakayitemuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.6",
            "verseOrgIds": [
              "JOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mwakanyamuka kuna kumunayibelamini mwakatambula mukala, muloŋa Yehova Nzambi yenu wakayinkawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi munalukuki dehi mukala mwakawocha nakesi, mwakela mwomwaya izu daYehova. Talenu, nayileji dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wayitemesheli, ayili kuna kwakubelaminawu, ashakamini mukachi kaBeteli naAyi, kumbadi yaAyi yamujika. Hakwila Yoshuwa wena wufuku owu wakamini hadi antu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wanyamukili budidi, wapompesheli antu, niyena niakulumpi jawaIsarela atwaminini kumbidi kukuya antu, hiyakuya kuAyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.10",
            "verseOrgIds": [
              "JOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwanjita ejima adiŋiyi nawu ayili, akundamininuku, ashikili kwakwihi namukala, atuŋili chilombu chawu kumbadi yaAyi yakabeta kakuchimunswa; hakachi kawena naAyi hadiŋi chinekineki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.11",
            "verseOrgIds": [
              "JOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watambwili amayala kuyichinda neyi kwiji makombakaji atanu, wayilejeli kubelamina hakachi kaBeteli naAyi, kumbadi yamukala yamujika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.12",
            "verseOrgIds": [
              "JOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu ayishili antu, awa nahawu, awa nahawu, wowu akwizaza dejima dadiŋi kumbadi yamukala yakabeta kakuchimunswa, niakwakubelamina kumbadi yamukala yamujika. Yoshuwa wena wufuku owu wayili hakachi kachinekineki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chachimweniyi mwanta wakuAyi, anyakeli, anyamukili budidi, amayala amumukala edikili, niyena niantu indi ejima, adasi nawaIsarela, hakanaŋenuwu kunsa yachana, ilaŋa helukili nindi kunyima yamukala anamubelaminuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiYoshuwa niaIsarela ejima elili neyi adimbena kuyitemuka, atemukilili njila yakuya kwisaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.15",
            "verseOrgIds": [
              "JOS.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima adiŋi mumukala aditambikili ayihaŋi; amuhaŋili Yoshuwa, ayikokeli kwakulehi namukala. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.16",
            "verseOrgIds": [
              "JOS.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "NimuAyi nimuBeteli himwasheli hoku iyala niwumu wabulili kwidika nakulondela mwanayuwu aIsarelaku; ashiyili kuchisu champwembu kwachashi, ayihaŋa nikuyihaŋa aIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamwilili Yoshuwa, nindi, Ololaku iyoŋa didi muchikasa chevi wudiinyiki nakuditalisha kuAyi, muloŋa nukukwinkawu. Yoshuwa wolweli iyoŋa dadiŋi muchikasa chindi, wadiinyikih nakuditalisha kumukala.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.18",
            "verseOrgIds": [
              "JOS.8.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.23",
            "verseOrgIds": [
              "JOS.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneluwu aIsarela anamanishi dehi kuyijaha eniAyi ejima adiŋi nimumaha nimwisaŋa mwayiliaŋililuwu, chafwiluwu ejima kumpoku yakabali nichichajililuwu to-o, aIsarela ejima hiyakufunta kuAyi, hiyakutapa mukala nampoku yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.24",
            "verseOrgIds": [
              "JOS.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejima afwili denodu ifuku, niamayala niambanda, adiŋi makombakaji ikumi nayedi, wowu amayala akuAyi ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.25",
            "verseOrgIds": [
              "JOS.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yoshuwa hafuntishili cheŋi chikasa chindi cholweliyi nachu iyoŋaku, nichajilishiliyi eniAyi ejima ji-i. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.26",
            "verseOrgIds": [
              "JOS.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa gombi niyuma yamumukala apupili yawu aweni, mwomwaya izu daYehova dalejeliyi Yoshuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yoshuwa wocheli Ayi, wawilishili mulumba hohu wahaya nyaka, hiihembi nilelu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.28",
            "verseOrgIds": [
              "JOS.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwanta wakuAyi wamukudikili kumutondu nichikwelili melela; chahumini itagwa Yoshuwa walejeli antu, akulula nimufu kumutondu, amúumbila nikuwiŋililu wakuchisu chamukala, alumbikaku nimulumba wamalola weneni, nilelu kwaduwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Yoshuwa wanamutuŋilili Yehova Nzambi yaIsarela kameŋa hampidi yaEbali, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwomwayilejeliyi kambuŋa Yehova Mosi anyana kaIsarela, neyi chanasonekuwu mumukanda wanshimbi jaMosi, kameŋa kamalola amukuma, akadi kusoŋa nachikugu, amulambwililuhu Yehova nyilambu yakushita, aketwili niyimuna yakuwunda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwenoku hamalola owu wasonekeli nshimbi jaMosi jasonekeliyi, anyana kaIsarela amutalaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AIsarela ejima, niakulumpi jawu niatulala, niansompeshi jawu, emeni niishinadi niishinadi dachimbaŋu kumesu awatupristu, wowu aLevi, asendeli chimbaŋu chachitiyaŋenu chaYehova, nimwenyi, nimwenimbu, mukanka wumu wemeni kumpidi yaGerizimi, mukanka wukwawu kumpidi yaEbali, mwomwayilejeliyi kambuŋa Yehova Mosi, nindi akasambili kuyikiswila aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
