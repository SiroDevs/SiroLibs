  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOS 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipompelu chejima chawanyana kaIsarela chapompeli kuShilo, kwenoku alemeni tabanaka yákubulakena. Ituŋa dayifwomokeleli zo-o.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaIsarela mwasheli nyichidi yitanu nayiyedi yachidiŋi kanda ayibalwili wuswana wawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wayilili anyana kaIsarela nindi, Ituŋa dayinkayi dehi Yehova Nzambi yawankakulula jenu, indi mwakanyi mwamba kaleka kukatala nákubula kwijila mu nakuditambula? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.3",
            "verseOrgIds": [
              "JOS.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tondenu hamuchidi amayala asatu, hamuchidi amayala asatu; ami nakayitemesha, akanyamuki, akendoli mwituŋa nakudisoneka mwomwahita wuswana wawu; akenzi cheŋi kudami. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.4",
            "verseOrgIds": [
              "JOS.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadibaluli maseka atanu nayedi. AYuda akashakami muŋinza yawu kukabeta kakuchidiilu, nimutaŋa waYosefu wakashakami muŋinza yawu kukabeta kakuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋa mwakadisoneki maseka atanu nayedi mwakaleti kudami, ami nakayisakwila nachinjikijilu kunu kumesu aYehova Nzambi yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa aLevi hiyakweti iseka mukachi kenuku, muloŋa wuswana wawu wowu wupristu waYehova. NiaGadi niaRubeni nimuchidi waManase wachibalu atambula dehi wuswana wawu ishinadi daYodana damusela, wayinkeliyi kambuŋa Yehova Mosi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana amayala anyamukili, ayili; Yoshuwa wayikanini ayili nakusoneka ituŋa, nindi, Yenuŋa mwakendoli mwituŋa, mwakadisoneki, mwakenzi cheŋi kudami, nakayisakwili nachinjikijilu kunu kuShilo kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mayala ayili, ahitili mwituŋa, adisonekeli mumukanda hamukala, hamukala, maseka atanu nayedi, enjili cheŋi kudi Yoshuwa kwadiŋiyi kuShilo kuchilombu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuwa wayisakwilili nachinjikijilu kuShilo kumesu aYehova; kwenoku Yoshuwa yoyibalwila anyana kaIsarela ituŋa mwomwadambwililuwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chinjikijilu chamuchidi wawanyana kaBenjamini chamwekeni mwahita yisaka yawu; ŋinza yayisakwililuwu yayili hakachi kawanyana kaYuda nawanyana kaYosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yawu yamutamba wakabeta kakuchimunswa yafumini kuYodana; ŋinza yakandukilili kumbadi yaYeriku yakabeta kakuchimunswa, yakandukili nakuhanuka mwituŋa damapidi kumujika; kuyakumini kwisaŋa yaBetiaveni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yafumini kwenoku yihita nikuLuzi, kwokumbadi yaLuzi yakabeta kakuchidiilu, Luzi diyi Beteli; ŋinza yakunkumukili nikuAtaroti Adara, kumpidi yekala kumutamba wakabeta kakuchidiilu waBetihoroni wamunkulu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋinza ayipimini hiyikunyeŋumuka kumbadi yamujika kukabeta kakuchidiilu kufumisha kumpidi yatala mesu kuBetihoroni kukabeta kakuchidiilu; kuyakumini kwokuKiriyati Bayali, diyi Kiriyati Yeyarimi, mukala wawanyana kaYuda. Kweniku diku kumutamba wawu wamujika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.14",
            "verseOrgIds": [
              "JOS.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutamba wawu wakabeta kakuchidiilu wafumini kunsa yaKiriyati Yeyarimi, ŋinza hiyikuya kumujika, hiyikwidika nikukaseloki kameji akuNefwetowa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋinza yakunkumukili kwakumina mpidi yemana kuchinekineki chamwana kaHinomi, chekala kumuhoŋi wawaRefwa mbadi yakabeta kakuchimunswa, yakunkumukili nikuchinekineki chaHinomi kumbadi yawaYebusi kukabeta kakuchidiilu, yikunkumuka nikuEnirogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.16",
            "verseOrgIds": [
              "JOS.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayipimini kumbadi yakabeta kakuchimunswa, hiyikwidika kuEnshemeshi, yiidika nikuGeliloti, womba mesu kumukandu wakuAdumimi; hiyikukunkumuka nikwilola daBohana mwana kaRubeni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "yihita nimutamba wuna watala mesu kuchana kumbadi yakabeta kakuchimunswa, yikunkumuka nikuchana; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋinza yahitili nakushika kumbadi yaBetihoŋala kukabeta kakuchimunswa; kuyakumini ŋinza kwokumwendu wejiya damuŋwa wakukabeta kakuchimunswa, kunsa yaYodana yakabeta kakuchidiilu; yeniyi diyi ŋinza yakabeta kakuchidiilu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yodana diyi wadiŋi ŋinza yawu yamutamba wakumusela. Weniwu diwu wuswana wawanyana kaBenjamini, mwesekela ŋinza jawu kwi-ndo, mwahita yisaka yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nyikala yamuchidi wawanyana kaBenjamini mwahita yisaka yawu yadiŋi iwu Yeriku, iwu Betihoŋala, iwu Emekikezizi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.21",
            "verseOrgIds": [
              "JOS.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Betaraba, iwu Zemarayimi, iwu Beteli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.22",
            "verseOrgIds": [
              "JOS.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Avwimi, iwu Para, iwu Ofwara; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.23",
            "verseOrgIds": [
              "JOS.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Chefwara Amoni, iwu Ofwini, iwu Geba; nyikala yamaneni ikumi nayiyedi, ninyikala yayu yanyanya; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.24",
            "verseOrgIds": [
              "JOS.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Gibeyona, iwu Rama, iwu Beyeroti; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.25",
            "verseOrgIds": [
              "JOS.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Mizipa, iwu Chefwira, iwu Moza; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.26",
            "verseOrgIds": [
              "JOS.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Rekemi, iwu Iripeyeli, iwu Tarala; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.27",
            "verseOrgIds": [
              "JOS.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwu Zela, iwu Elefwi, niaYebusi, diwu Yerusalema, iwu Gibeyati, iwu Kiriyati; nyikala yamaneni ikumi nayiwana ninyikala yayu yanyanya. Weniwu diwu wuswana wawanyana kaBenjamini mwahita yisaka yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.28",
            "verseOrgIds": [
              "JOS.18.28"
            ]
          }
        }
      ]
    }
