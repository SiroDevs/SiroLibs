              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwijila mutembeli, hakutachika kutemunamu adiŋi nakulandishilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.45",
            "verseOrgIds": [
