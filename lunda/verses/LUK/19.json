          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyiieja hefuku hefuku mutembeli. Akulumpi jawatupristu niansoneki nawantu alema hiyakukeŋa hakumujahila; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.47",
            "verseOrgIds": [
