          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilaŋa akaŋenyi kumona mwakwila, muloŋa antu ejima hiyakudihudika nakumutiyilila.",
          "type": "text",
