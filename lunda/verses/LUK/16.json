              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena nindi, Nehi tata Abarahama, neyi muntu afuma mudi afu aya kudi wena, akabalumuka munyichima. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.30",
            "verseOrgIds": [
