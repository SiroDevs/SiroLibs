          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.52",
            "verseOrgIds": [
              "LUK.11.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 11:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanedikiyi mwenomu, ansoneki nawaFwarisi atachika nikumweseka naŋovu nankashi, hiyakumuvuloka kulonda ahoshi yuma yayivulu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.53",
            "verseOrgIds": [
              "LUK.11.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 11:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiya kumuta namazu akukanwa kindi, atiyi chuma chakuhoshayi, amwinkeluhu muloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.54",
            "verseOrgIds": [
              "LUK.11.54"
            ]
          }
        }
      ]
    }
