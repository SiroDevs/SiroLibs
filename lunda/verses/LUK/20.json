          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hamba kasaŋukawu afu, mumbanda wakela iŋoda wumwodihi? muloŋa mwatanu nayedi amusumbwili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
