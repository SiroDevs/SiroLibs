          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunyamuka, hakufuma mushikola, hakwijila mwitala daShimona. Mawenu yaShimona wadiŋi wakata mashika aweni, hiyakumulembelelayi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.38",
            "verseOrgIds": [
              "LUK.4.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwimana kwadiŋiyi yena, hakuhoshola mashika, amufuma nikumufuma; hohenohu yohinduka nikuhinduka, hakuyikalakela.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.39",
            "verseOrgIds": [
              "LUK.4.39"
            ]
          }
        }
      ]
