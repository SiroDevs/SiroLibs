  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "LUK 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku damuchimu damulungu, hiyakwinza kwijamu hankunku yakucha, anasendi nyitondu yamavumba amawahi yanaloŋeshuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.1",
            "verseOrgIds": [
              "LUK.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuwana ilola anadilaŋumuni dehi, anadifumishi kwijamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.2",
            "verseOrgIds": [
              "LUK.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwijila mu, kuwana mujimba waMwanta Yesu mwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.3",
            "verseOrgIds": [
              "LUK.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakujinokawu chumichi, kutala amayala ayedi anemani kwakwihi, anavwali mahina atoŋeka chejeji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.4",
            "verseOrgIds": [
              "LUK.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambanda hiyakutiya woma, anoŋama nimesu awu hamaseki. Owu amayala hiyakwila nawu, Mudi nakukeŋeladi wamumi mukachi kawafu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.5",
            "verseOrgIds": [
              "LUK.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadi munuku, wasaŋuka dehi mudi afu. Anukenu chayilejeliyi hadiŋiyi muŊaliliya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.6",
            "verseOrgIds": [
              "LUK.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Mwana kamuntu chiŋa akamuhana kumakasa awakwanshidi, akamupopela kukulusu, wakasaŋuka mudi afu hefuku damu chisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.7",
            "verseOrgIds": [
              "LUK.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwanuka mazu indi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.8",
            "verseOrgIds": [
              "LUK.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakufuma kwijamu kwayiluwu, hiyakuleja ikumi nawumu ni akwawu ejima yuma yejimiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.9",
            "verseOrgIds": [
              "LUK.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu ambanda adiŋi niMariya Mandaleni, niYowana, niMariya mama yaYakoba, hamu nawambanda amakwawu nawa, hiyakuleja apostolu yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.10",
            "verseOrgIds": [
              "LUK.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazu awa hiyakuyitiya neyi adi nakuhosha tuhu; kuyiteja kwawu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.11",
            "verseOrgIds": [
              "LUK.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakunyamuka, hakuya lufuchi kwijamu, hakubandama nakutalamu; hakumona mahina atooka adi hakanka wawu. Hakufunta kwiindi nakujinoka yuma yanamoniyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.12",
            "verseOrgIds": [
              "LUK.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala akwawu ayedi adi nakuya ifuku dodenodu kumukala ijina dawu Emawusi, wekala chintampu naYerusalema makilometa ikumi nayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.13",
            "verseOrgIds": [
              "LUK.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adiŋi nakuhanjika yuma yinamwekani yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.14",
            "verseOrgIds": [
              "LUK.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakuhanjikawu nakudihujola, yomweni Yesu hakukundama kwakwihi, hakwenda nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.15",
            "verseOrgIds": [
              "LUK.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mesu awu akaŋenyi kumwiluka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.16",
            "verseOrgIds": [
              "LUK.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Oyu nsaŋu yimudi nakuya nakuhosha, nsaŋwinyi? Wena hiyakwimana ku-ka nakudihomba. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.17",
            "verseOrgIds": [
              "LUK.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumu ijina dindi Kiŋa, hakumwakula nindi, Eyi yeyi mwenyi kanka weyi muYerusalema, wunabuli kwiluka yuma yinamwekanumu mafuku anu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.18",
            "verseOrgIds": [
              "LUK.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Yumanyi? Wena hiyakumwakula nawu, YaYesu wakuNazareta, wadiŋi kaprofwetu wasweja nikunyidimu yindi nikumazu indi, kumesu aNzambi ni kumesu awantu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.19",
            "verseOrgIds": [
              "LUK.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninichi chamuhanawu kudi awakulumpi jawatupristu hamu nawanyuli jetu, akamuhishi muloŋa wakumujaha, amupopela nikukulusu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.20",
            "verseOrgIds": [
              "LUK.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa etu twadiŋi nakukuhwelela netu diyi wukukeŋa kukuula Isarela. Eŋaŋi, hayuma yejimiyi hanalundami nsaŋu yi kwawu; lelu ifuku damu chisatu kufumisha helawu yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.21",
            "verseOrgIds": [
              "LUK.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwetu ambanda amenekela kwijamu anatuhayamishi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.22",
            "verseOrgIds": [
              "LUK.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chawanawu mujimba windi mwosi, hiyakwinza nakwila nawu amona chimwenu chawaŋelu ela nawu yena wamumi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.23",
            "verseOrgIds": [
              "LUK.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwetu amakwawu twadiŋi nawu aya kwijamu, amona mwomwashimunawu ambanda, ilaŋa yena kumumona nehi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.24",
            "verseOrgIds": [
              "LUK.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Mayalenu, o chimwasupa, o chimwalemendenda kwitiya yuma yejima yahosheli atuprofwetu! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.25",
            "verseOrgIds": [
              "LUK.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hichawahilili Kristu kukabakana yumiyi, akeŋili nimukulema kwinduku? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.26",
            "verseOrgIds": [
              "LUK.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyilumbulwila munyikanda yajila, kutachika hadi Mosi niatuprofwetu ejima, yuma yatenenuwu yomweni.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.27",
            "verseOrgIds": [
              "LUK.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu hiyakushika kwakwihi namukala kwadiŋi nakuyawu, yena hakwila nindi apandakani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.28",
            "verseOrgIds": [
              "LUK.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena hiyakumushinjila nawu, Kamaku hanu hetu, muloŋa kuneli dehi melela, itaŋwa dahita dehi. Yena hakwijila ashakami nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.29",
            "verseOrgIds": [
              "LUK.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashakamiyi nawu nakudya, hakunona dinkendi, hakukisula nkisu, hakudihumuna, hakuyinka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.30",
            "verseOrgIds": [
              "LUK.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesu awu atona nikutona, amwiluka nikumwiluka. Yena hakujimina kumesu awu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.31",
            "verseOrgIds": [
              "LUK.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakudileja wumu namukwawu nawu, Twatiyilahu munyichima yetu mumavumu busu, chadiŋi nakutulejayi munjila, chadiŋi nakutulumbulwilayi nyikanda yajila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.32",
            "verseOrgIds": [
              "LUK.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakunyamuka mpinji yoyenoyu, hiyakufunta kuYerusalema, kuwana ikumi nawumu anapompi dehi hamu, ninawa adiŋuwu nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena nawu, Chalala Mwanta nasaŋuki mudi afu, wamwekana dehi nikudi Shimona. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwawu ayedi hiyakushimuna yuma yanamonuwu munjila, nichanamwilukuwu hakuhumuna dinkendi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋi nakuhoshawu yumiyi, kukasumuka yomweni Yesu nemani dehi mukachi kawu. Hakuyila nindi, Kuwunda kwikali nanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.36",
            "verseOrgIds": [
              "LUK.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena hiyakutiya woma, afwa nimutentu, hiyakutoŋojoka nawu tunamoni muŋamu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.37",
            "verseOrgIds": [
              "LUK.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Munaakaminidi? Mukudihujoleladi munyichima yenu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.38",
            "verseOrgIds": [
              "LUK.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Talenu makasami ninyendu yami, yami aweni hohu. Nkwatakwatenu muntiyi; muŋamu hakweti musunyi nimafwaha, neyi ichi chimunanmonamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.39",
            "verseOrgIds": [
              "LUK.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanahoshiyi ochu, hakuyileja makasindi ninyendu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.40",
            "verseOrgIds": [
              "LUK.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku achidi kanda etiyi namuzaŋalu wawu nikujinoka, yena hakuyila nindi, Kunu mukweti yakudya? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.41",
            "verseOrgIds": [
              "LUK.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwinka chibalu chanshi chakuteleka dehi, ninamutu wawuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.42",
            "verseOrgIds": [
              "LUK.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakutambula, hakudya, iku adi nakumutala.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.43",
            "verseOrgIds": [
              "LUK.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Diwu mazu nahosheli hinadiŋi nanenu, akwila nami, yuma yasonekeluwu munyikanda yajila yejima, yamunshimbi jaMosi, nimudi atuprofwetu, nimumasamu yantenenuwu, chiŋa yakalumbuluka hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.44",
            "verseOrgIds": [
              "LUK.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakujikula kashinshi kawu kulonda eluki mwalumbulukila nyikanda yajila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.45",
            "verseOrgIds": [
              "LUK.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Anasoneki nawu Kristu chiŋa akakaba, akasaŋuka mudi afu ifuku damu chisatu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.46",
            "verseOrgIds": [
              "LUK.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "akashimwaŋena mwijina dindi nsaŋu yakubalumuka mumuchima, nikuyanakena nyiloŋa, mwahita nyuza yejima, kutachikila kuYerusalema. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.47",
            "verseOrgIds": [
              "LUK.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Enu yenu ayinsahu yayumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.48",
            "verseOrgIds": [
              "LUK.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu, nukutemesha hadenu kukana kwakaniniyi Tata yami; ilaŋa chiŋililenu muŋanda, kushika nihakayivwikawu Ŋovu yakufuma kwiwulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.49",
            "verseOrgIds": [
              "LUK.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyilombola nichashikiluwu kwatalaŋana naBetani. Hakwolola makasindi kwiwulu, hakuyikiswila nkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.50",
            "verseOrgIds": [
              "LUK.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wudi nakuyikiswila nkisu hakwambuka nawu, amutwala nimwiwulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
            "verseOrgIds": [
              "LUK.24.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 24:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wena hiyakudifukula munyichima yawu, hiyakufunta kuYerusalema namuzaŋalu waweni. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
              "LUK.24.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 24:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwikalaŋa mutembeli hefuku hefuku nakumukiswila Nzambi nkisu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.53",
            "verseOrgIds": [
              "LUK.24.53"
            ]
          }
        }
      ]
    }
