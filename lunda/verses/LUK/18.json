  "copyright": "PUBLIC DOMAIN",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "LUK 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitila chishimu kulonda alombaŋa mafuku ejima chakadi kuzeya, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.1",
            "verseOrgIds": [
              "LUK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Mumukala weneni wumu mwadiŋi mukwakuso-mpesha wumu wabulili kutiya Nzambi woma, hela kubaŋa antu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.2",
            "verseOrgIds": [
              "LUK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumukalowu mwadiŋi mumbanda wanfwila wumu; yena mumbanda hakuzebaŋa kudi owu mukwakusompesha nindi, Nhosheli muloŋa nasamuloŋa wami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.3",
            "verseOrgIds": [
              "LUK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahitili mafuku yena kwonti kwindi; nkumininaku hakwila mumuchima windi nindi, Ami hinatiyaloŋa Nzambi womaku, hela antu kuyibaŋa nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.4",
            "verseOrgIds": [
              "LUK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hela chochu, chakuswejayi mumbanda iwu kunzebela, keŋa anzeyeshi tuhu, chakwilayi zebe-e ichi, nukukumina dakumuhoshela muloŋa windi tuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.5",
            "verseOrgIds": [
              "LUK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wahosheli nindi, Tiyenu chahosheliyi owu mukwakusompesha waheŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.6",
            "verseOrgIds": [
              "LUK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi abuli kutenda antu indi atondayi dehi, amubilelaŋa nimwaana niwufuku, adiwunjikilaŋayi wunjike-e? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.7",
            "verseOrgIds": [
              "LUK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja nami hakalaba nakuyitendaku. Hela ochu, chakenzayi Mwana kamuntu, wakawana kukuhwelela hamaseki, tahindi?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.8",
            "verseOrgIds": [
              "LUK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutila nawa chishimu antu adikuhwelelaŋa awenawu nawu twaloŋa, hiyakudiwula akwawu ejima, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.9",
            "verseOrgIds": [
              "LUK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Antu ayedi akandukili mutembeli akalombi, iwu kaFwarisi, iwu nsonkeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.10",
            "verseOrgIds": [
              "LUK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "KaFwarisi hakwimana nakudilombela mumuchima windi nindi, Eyi Nzambi, nakusakilili chinabuli kwikala neyi antu acheŋi, akwanyilami, áheŋa, ayivumbi, hela tuhu neyi iwu nsonkeshi iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.11",
            "verseOrgIds": [
              "LUK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najiŋaŋa nanzala yakuleka kudya hamulungu kayedi, hamulungu kayedi; nalambulaŋa yamwikumi yayuma yinahetaŋa yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.12",
            "verseOrgIds": [
              "LUK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nsonkeshi hakwimana kwakulehi, kumona jakufumbula mesu indi atala kwiwulu nehi; Ilaŋa hakudetola hantulu yindi nindi, Eyi Nzambi, antiyili luwi, ami mukwanshidi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.13",
            "verseOrgIds": [
              "LUK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja nami, yeniwu muntu diyi wakunkumukili kwitala dindi nakuyiŋa, bayi iwu mukwawuku; muloŋa muntu wukuditohesha akamukehesha, ilaŋa muntu wukudikehesha akamutohesha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.14",
            "verseOrgIds": [
              "LUK.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuletela anyanawu anyanya kulonda yena ayikunki; atumbanji chanachimonuwu, hiyakuyihoshola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.15",
            "verseOrgIds": [
              "LUK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yesu hakuyitambika nindi, Yitejenu anyana anyanya enzi kudami, bayi muyilekeshaku; muloŋa wanta waNzambi wawena adi chochichi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.16",
            "verseOrgIds": [
              "LUK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja chalala nami, muntu wukubula kutambula wanta waNzambi neyi mwana wanyanya, hakwijila mu nihantuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.17",
            "verseOrgIds": [
              "LUK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyuli wumu hakumwihula nindi, Eyi Nkuluŋaŋa muwahi, nukwila ŋahi kulonda nakaswani wumi wahaya nyaka? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.18",
            "verseOrgIds": [
              "LUK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumwila nindi, Wukuntenenadi neyi muwahi? Hosi muwahuku chiŋa Nzambi hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.19",
            "verseOrgIds": [
              "LUK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nshimbi wajiluka dehi nawu, Kwila wuvumbi chinjila. Kujaha muntu chinjila. Kwiya chinjila. Kushimuna wunsahu wakutwamba chinjila. Lemeshaku tata yeyi namama yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.20",
            "verseOrgIds": [
              "LUK.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Yuma yejimiyi nayihemba dehi kufumisha kuwansi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.21",
            "verseOrgIds": [
              "LUK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu chanachitiyiyi, hakumwila nindi, Kunashali chuma chimu; landishaku yiwudi nayu yejima, wuyinki atuzweŋi, wuheti maheta amwiwulu; winzi wunlondaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.22",
            "verseOrgIds": [
              "LUK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa yena chanachitiyiyi, hakuneŋa nankashi, muloŋa wadiŋi wasweja kuheta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.23",
            "verseOrgIds": [
              "LUK.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakumutala, hakwila nindi, O chamonaŋawu akwakuheta kukala kwijila muwanta waNzambi! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.24",
            "verseOrgIds": [
              "LUK.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nŋameli kwijila mudisu dandoŋu chaswayi; mukwakuheta kwijila muwanta waNzambi chakala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.25",
            "verseOrgIds": [
              "LUK.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu achitiyili hiyakwila nawu, Indi wamba kahanda hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.26",
            "verseOrgIds": [
              "LUK.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Yuma yikukaŋanya antu, Nzambi wukuyitwesha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.27",
            "verseOrgIds": [
              "LUK.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu nindi, Tala, etu tunashiyi ayetu, tunakulondi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.28",
            "verseOrgIds": [
              "LUK.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Nukuyileja chalala nami, muntu wukushiya itala, hela Iŋodindi, hela ana kwindi, hela anvwali, hela anyana hansaŋu yawanta waNzambi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "wukutambula makonu amakwawu amavulu akubadika, nihanyaka yakenza wakatambula wumi wahaya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.30",
            "verseOrgIds": [
              "LUK.18.30"
            ]
          }
        }
      ]
    },
    {
