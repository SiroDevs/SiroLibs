          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku hefuku wadiŋi nakuleja antu mutembeli namwa ana; hawufuku wedikilaŋa nakuya nakukama kumpidi yaOliveta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima amenekelaŋa budidi kudi yena mutembeli amutiyi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
