  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "LUK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu hadiŋi nakwilawu ochu, kupompa nimakombakaji awantu akwila hiyakudidata nikudidata; hakutachika kuleja atumbanji twindi chakusambila, nindi, Babelenu iluŋi dawaFwarisi, wowu wufwikiji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.1",
            "verseOrgIds": [
              "LUK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hikwekala chuma chabutaŋawu chibula kumwekana hatookaku; hela chajindaŋawu chibula kutiyakanaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.2",
            "verseOrgIds": [
              "LUK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi yuma yejima yimwakahoshela mumwidima yakatiyakana hamwaana; niyimwakashawutila mwitu namutupeka twamukachi, akayibidika hatuwumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.3",
            "verseOrgIds": [
              "LUK.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.3",
            "verseOrgIds": [
              "LUK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu amabwambu jami nukuyileja nami, bayi mutiya woma wena ajahaŋa mujimbaku, akuminaŋa mwomwenomu hohu, kutwesha kwila chuma chikwawu nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.4",
            "verseOrgIds": [
              "LUK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyilejaŋahu dehi imukutiya woma; tiyenu woma yena wukweti Ŋovu jakwila ajaha anatila muntu mukaluŋa kachinana; eŋa, nukuyileja nami mutiyenu woma. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.5",
            "verseOrgIds": [
              "LUK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tujila twanyanya tutanu hiyatulandaŋa natumali tuyeduku? Hela chochu, hikwekala hela kamu kavulamenaŋawu kudi Nzambuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.6",
            "verseOrgIds": [
              "LUK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela nsuki jenu jajeni ajichinda dehi jejima. Dichi bayi mutiyaloŋa womaku, kulema kwenu kwabadika kulema kwatujila twatuvulu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.7",
            "verseOrgIds": [
              "LUK.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.7",
            "verseOrgIds": [
              "LUK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja nami antu ejima akuŋiteja kumesu awantu, ni mwana kamuntu niyena wakayiteja kumesu awaŋelu jaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.8",
            "verseOrgIds": [
              "LUK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukudikala kumesu awantu nindi haŋilukaku, niyena nawa akadikalayi kumesu awaŋelu jaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.9",
            "verseOrgIds": [
              "LUK.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukuhosha izu dakutena Mwana kamuntu chatama, akamwanakenadu; hakwila wukuhosha Spiritu Wajila chatama hiyakamwanakenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.10",
            "verseOrgIds": [
              "LUK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakayitwalawu nakuyimika mumashikola kumesu awanyuli nawanyanta, bayi mwakaakama mwakwakwila hela mwakuhoshelaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.11",
            "verseOrgIds": [
              "LUK.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Spiritu Wajila wakayileja chatela kuhosha henohu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.12",
            "verseOrgIds": [
              "LUK.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.12",
            "verseOrgIds": [
              "LUK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wahezaza dawantu wumu hakumwila nindi, Eyi Nkulupaŋa, mwili mana kwami twambuli nindi wuswana wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.13",
            "verseOrgIds": [
              "LUK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakumwila nindi, Eyi iyala, ananyinki kudinyi mudimu wakuyisompesha, hela wakuyipaŋila? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.14",
            "verseOrgIds": [
              "LUK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Babalenu, dihembenu muleki lwisu lwejima, muloŋa wumi wamuntu hiwekalaŋa kukuvula kwamahetinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.15",
            "verseOrgIds": [
              "LUK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyitila chishimu nindi, Maha amukwakuheta wumu aswejeli kusoŋa nankashi; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.16",
            "verseOrgIds": [
              "LUK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuhosha mumuchima windi nindi, Nukwila ŋahi chinabuli kwakuswekela kudya kwami? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.17",
            "verseOrgIds": [
              "LUK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nindi, Nukusanda nkalaŋa jami, nituŋa jamaneni, nakaswekumu tidiku yami yejima nimahetami. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.18",
            "verseOrgIds": [
              "LUK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nili wumi wami nami, Eyi wumi wami, wunalumbiki dehi maheteyi amavulu anyaka yayivulu; nookaku kweyi; dyaloŋa, nwaŋa, luŋaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.19",
            "verseOrgIds": [
              "LUK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi hakumwila nindi, Eyi chisupi, anakeŋi kutambula wumi weyi wufuku owu, indi iyi yuma yiwunaloŋeshi yikushala nanyi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.20",
            "verseOrgIds": [
              "LUK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochakekala muntu wadilumbikilaŋa maheta amavulu, nindi indi yomweni hohu, hekalaŋa namaheta kumesu aNzambuku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.21",
            "verseOrgIds": [
              "LUK.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.21",
            "verseOrgIds": [
              "LUK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila atumbanji twindi nindi, Nukuyileja nami lekenu kwakama wumi wenu nenu tukudyadi? hela kwakama nyijimba yenu nenu tukuvwaladi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.22",
            "verseOrgIds": [
              "LUK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumi wabadika yakudya, mujimba wabadika yakuvwala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.23",
            "verseOrgIds": [
              "LUK.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toŋojokenu ayipuŋu, hiyakuwaŋaku, hiyamunaŋaku; hiyaheta hela nkalaŋa hela itala dakuswekelaku; ayidiishaŋa kudi Nzambi hohu. Komana kulema kwenwenu hikwabadika nankashi kwatujilaku? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.24",
            "verseOrgIds": [
              "LUK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwinenwinyi wukwila akame-e, anuŋa kuchiminu chindi chikunku chakweseka munkotweli yachikasa? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.25",
            "verseOrgIds": [
              "LUK.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chuma chantesha muchikaŋanya kuchila, indi mwaakaminaŋadi yuma yinashaluku? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.26",
            "verseOrgIds": [
              "LUK.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonojokenu wuluya chiwakulaŋa; hiwakabakanaŋaku, hiwashintaŋaku; nukuyileja nami mwalemeneniyi Solomoni mwejima, havweli chakweseka nawuluyiwu wumuku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.27",
            "verseOrgIds": [
              "LUK.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi yovwika matahu amwiha chochichi, akwila lelu adi kwoku, kumadiki hiyakuyinatila mukesi, abuli kubadika kuvwikenu, enu mukweti kukuhwelela kwantesha? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.28",
            "verseOrgIds": [
              "LUK.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayi musha muchima kuyakudya hela kuyakunwaku; bayi mululutaŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.29",
            "verseOrgIds": [
              "LUK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yuma yejimiyi diyi yakeŋaŋa nyuza yamunu mwishina. Tata yenu neluki chimunakaankili yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.30",
            "verseOrgIds": [
              "LUK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi shenu muchima kuwanta windi, iyi yuma yejimiyi akayishilaku.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.31",
            "verseOrgIds": [
              "LUK.12.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.31",
            "verseOrgIds": [
              "LUK.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu kamukanka kawanyikoku kantesha, bayi mutiyaloŋa womaku, Tata yenu watiyaloŋa kuwaha kuyinka wanta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.32",
            "verseOrgIds": [
              "LUK.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Landishenu yimudi nayu muyinki atuzweŋi; namutuŋi yikwama yenu yabulaŋa kukula, maheta amwiwulu hiyanoŋaŋaku, mwiwulu himwashikaŋa ikombi nakwiyaku, hela kabubu kakukisaŋana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.33",
            "verseOrgIds": [
              "LUK.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kukwikala mahetenu diku kukwikala ninyichima yenu nawa.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.34",
            "verseOrgIds": [
              "LUK.12.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.34",
            "verseOrgIds": [
              "LUK.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pimpilenu mahinenu, manoŋu enu abutukaŋa. Enu aweni ikalenu neyi antu adi nakutalila mwanta wawu wukufuma kumawija kwayiliyi, kulonda hakenzayi nakudondomwena akamwenzulwili hohenohu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.35",
            "verseOrgIds": [
              "LUK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anduŋu akawanawu kudi nkaka yawu adi nakumutalila anakooleki; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.36",
            "verseOrgIds": [
              "LUK.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukuyileja chalala nami nkaka yawu wakavwala chachiwahi, wakayishakamisha nakudya, wakenza nakuyikalakela. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.37",
            "verseOrgIds": [
              "LUK.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi wakenza hachilu chamuchiyedi hela chamuchisatu, kuyiwana chochichi, anakooleki. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.38",
            "verseOrgIds": [
              "LUK.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu mwiluki, mwini itala neyi welukili mpinji yikwinza ikombi, mutenowu watoneni, hadi kwiteja kumupundila itala dinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.39",
            "verseOrgIds": [
              "LUK.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ninenu nawa babalenu, muloŋa mpinji yimukubula kutoŋojoka, diyi yakenzayi Mwana kamuntu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.40",
            "verseOrgIds": [
              "LUK.12.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.40",
            "verseOrgIds": [
              "LUK.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petulu hakumwila nindi, Mwanta, ichi chishimu wunatili etu hohu, tahindi munatili niantu ejima? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.41",
            "verseOrgIds": [
              "LUK.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta nindi, Kalama washinshika wukweti maana yowinyi, akushilawu kudi mwanta windi mudimu wakutala mukala windi, enkaŋa aŋamba jindi yakudya yawu hayinkelaŋawu?",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.42",
            "verseOrgIds": [
              "LUK.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 12:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.48",
            "verseOrgIds": [
              "LUK.12.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 12:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nenzi nakunatila kesi hanu hamaseki, nakeŋi nami kabutuki; indi neyi kanabutuki dehi, ami nakela ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.49",
            "verseOrgIds": [
              "LUK.12.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 12:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nidi nachipapatishu chakampapatishawu nachu; chinankatishi kumuchima nankashi nami chimani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.50",
            "verseOrgIds": [
              "LUK.12.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 12:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munatoŋojoki nenu ami nenzi nakuleta kumwena hanu hamaseki, tahindi? Nukuyileja nami, ami hinenzi nakuleta kumwenaku, nenzi nakwambola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.51",
            "verseOrgIds": [
              "LUK.12.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 12:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa kufumisha hanu, mwitala mudi antu atanu, asatu akaambuka kudi akwawu ayedi, ayedi akaambuka kudi asatu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.52",
            "verseOrgIds": [
              "LUK.12.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 12:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yamuntu wakadambula namwanindi weyala, mwana weyala wakadambula natata yindi; mama yamuntu wakadambula namwanindi wamumbanda mwana wamumbanda wakadambula namama yindi; mawenu yamuntu wakadambula namuku windi wamumbanda, muku wamumbanda wakadambula namawenu yindi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.53",
            "verseOrgIds": [
              "LUK.12.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LUK 12:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.53",
            "verseOrgIds": [
              "LUK.12.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LUK 12:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila mazaza awantu nindi, Mwelaŋa chimukumona ivu dikusela kumuji ka, himukuhosha nenu, Kukunoka kuvula; chalala kwaamu mwomwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.54",
            "verseOrgIds": [
              "LUK.12.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LUK 12:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimukumona mpepela yikukunka nakufmna kukabeta kakuchidiilu, himukuhosha nenu, Kukuholoka nkanza yasweja iyena; chalala kwaamu mwomwenomu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.55",
            "verseOrgIds": [
              "LUK.12.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LUK 12:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu anfwikiji! Muneluki kulumbulula nsaŋu jayuma yahamaseki niyamuluzwizu, indi munakaŋenyidi kulumbulula mukuya nsaŋu jamakonu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.56",
            "verseOrgIds": [
              "LUK.12.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LUK 12:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aweni mwakaŋenyaloŋadi kwiluka mukuya yuma yaloŋa? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.57",
            "verseOrgIds": [
              "LUK.12.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "LUK 12:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyiwudi nakuya kudi mukwakusompesha namuntu nakwinki muloŋa, esekaku kumanisha muloŋa hiwuchidi nindi munjila; mukunkulwayi wukukutwala kudi mukwakusompesha, mukwakusompesha hakukuhana kudi mukwakaleya, niyena hakukusha mukaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.58",
            "verseOrgIds": [
              "LUK.12.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "LUK 12:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukukuleja nami hiwamba kafuma mwokuku, kufumamu chiŋa wunafuti muloŋa wejima, nikadali kanyanya kakushalaku nehi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.12.59",
            "verseOrgIds": [
              "LUK.12.59"
            ]
          }
        }
      ]
    }
