  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JDG 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYerubayali Abimeleki wayili kuShekemi kudi amandumi ŋindi, wahosheli nawu, nachisaka chakumutaŋa watata yamama yindi chejima, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.1",
            "verseOrgIds": [
              "JDG.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Hoshenu mwani, namayala amuShekemi ejima, nenu, Enu kwenu chachiwahi chidihi? Chachiwahi awa anyana amayala aYerubayali ekali anyanta jenu wejima wawu makumi atanu nayedi, tahindi chachiwahi kwikala namwanta wenu wumu hohu? Anukenu nawa nenu ami mwinenu mwivumu detu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.2",
            "verseOrgIds": [
              "JDG.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amandumi jindi ahosheli namayala amuShekemi ejima nakumutena, ahosheli mazu awa ejima; munyichima yawu amukeŋeli Abimeleki, muloŋa elili nawu, Yena himana kwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.3",
            "verseOrgIds": [
              "JDG.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwinkeli mali asiliva makumi atanu nayedi amwitala daBayali Beriti. Abimeleki wakwatili nachu amayala akuhemesha amukunkulwayi, hakwendaŋa nawu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.4",
            "verseOrgIds": [
              "JDG.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.5",
            "verseOrgIds": [
              "JDG.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala amuShekemi ejima adipompesheli hamu, nimutaŋa waMilowejima, ayili nakumudiisha Abimeleki wanta kumukula wakumpwembu owuwadiŋi kuShekemi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.6",
            "verseOrgIds": [
              "JDG.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamulejeluwu Yotama wayili nakwimena kunamutu wampidi yaGerizimi, wanyamwini izu dindi kwiwulu, wabidikili, nindi, Tiyenu kunu enu amayala amuShekemi, kulonda Nzambi niyena atiyi kudenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.7",
            "verseOrgIds": [
              "JDG.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaka nyitonduyayili nakuwayisha mwanta wayu; yamwilili muolive nawu, Ikalaku mwanta wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.8",
            "verseOrgIds": [
              "JDG.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka muolive nindi, Ami nishiyi manji ami alemeshapa wunachu niNzambi niantu, niyi nakanyinkeshi niniku niniku hanyituyanyitondu yi kwawu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.9",
            "verseOrgIds": [
              "JDG.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitondu yamwilili chikuyu, nawu, Inzakuwikali mwanta wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.10",
            "verseOrgIds": [
              "JDG.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka chikuyu nindi, Ami nishiyi kutowalakwami, ninyikabu yami yayiwahi niyi nakanyinkeshi niniku niniku hanyituya nyitondu yi kwawu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.11",
            "verseOrgIds": [
              "JDG.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitondu yamwilili muvinyu, nawu, Inza kuwikali mwanta wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.12",
            "verseOrgIds": [
              "JDG.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka muvinyu nindi, Ami nishiyi vinyu yami yinatiyishapa nachu kuwaha niNzambi niantu, niyi nakanyinkeshi ninikuniniku hanyitu yanyitondu yi kwawu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.13",
            "verseOrgIds": [
              "JDG.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu nyitondu yejima hiyikumwila mutondu wanyiŋa, nawu, Inzaku wikali mwanta wetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.14",
            "verseOrgIds": [
              "JDG.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutondu wanyiŋa wayilili nyitondu, nindi, Neyi chalala himukunwayisha niikali mwanta wenu, komana inzenu kunu, mushakami muwulelu wami; neyi nehi, komana kesi kafumi mumutondu wanyiŋa kanoŋeshi nyisida yamuLebanoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.15",
            "verseOrgIds": [
              "JDG.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.15",
            "verseOrgIds": [
              "JDG.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu, chimunadiishi Abimeleki wanta munakoŋi mwalala mwaŋa? Munamukoŋi Yerubayali namutaŋa windi chachiwahi? Munamwili mwamuwahi mwayilayi enu? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.16",
            "verseOrgIds": [
              "JDG.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yami wayilwilili, wakeŋa elikuyikoola, wayamwinini kudi aMidiyani. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.17",
            "verseOrgIds": [
              "JDG.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelu munanyamukili mutaŋa watata yami, munajahi anyanindi makumi atanu nayedi helola dawu dimu, Abimeleki mwana kanduŋu yindi munamudiishi wanta, nenu ekali mwanta wa wamayala akuShekemi, nanochu chaneliyi himana kwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.18",
            "verseOrgIds": [
              "JDG.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi munakoŋi Yerubayali namutaŋa windi mwalala mwaloŋa lelu, komanatiyenu kuwaha naAbimeleki, niyena nawa atiyi kuwaha nanenu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.19",
            "verseOrgIds": [
              "JDG.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyinehi, kesi kafumi mudi Abimeleki kanopeshi amayala amuShekemi niamumutaŋa waMilo. Kesi kafumi mudi amayala amuShekemi, nimumutaŋa waMilo kanoŋeshi Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.20",
            "verseOrgIds": [
              "JDG.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotama watemukili lufuchi, wayili kuBeri nakushakamaku, muŋa wawoma wamana kwindi Abimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.21",
            "verseOrgIds": [
              "JDG.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki welili mwanta wawaIsarela nyaka yisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.22",
            "verseOrgIds": [
              "JDG.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi watemesheli spiritu yatama mukachi kaAbimeleki nawamayala amuShekemi; amayala amuShekemi amudimbili Abimeleki, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.23",
            "verseOrgIds": [
              "JDG.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulonda katama kayikopeluwuana anyana kaYerubayali makumi atanu nayedi, niyena akachimonuhu, kulonda mana kwawu Abimeleki wayijahili, ni amayala amuShekemi amukwashili kujaha ana kwindi, akakooli hanyijimba yawu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.24",
            "verseOrgIds": [
              "JDG.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.25",
            "verseOrgIds": [
              "JDG.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala, mwana kaEbedi wenjili nawana kwindi, wayili kuShekemi; amayala amuShekemi amukuhweleleli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.26",
            "verseOrgIds": [
              "JDG.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayili mumaha, akuŋwili mawundu amumatempa awu anyivinyu, ayisohweli, hiyakuzapajala nikuzaŋajala, eŋila ni mwitala damukishi wawu; adiili, anwini, hiyakunamutuka Abimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.27",
            "verseOrgIds": [
              "JDG.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.29",
            "verseOrgIds": [
              "JDG.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wamukala Zebuli chatiyiliyi mazu amwana kaEbedi Gala, wazuwili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.30",
            "verseOrgIds": [
              "JDG.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamutemesheleli Abimeleki antemesha chakujinda hohu, nindi, Tiyaku, mwana kaEbedi Gala nawana kwindi anenzi kunu kuShekemi; hakukupompeshela akwamukala, adikaŋi naneyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.31",
            "verseOrgIds": [
              "JDG.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichidinu, nyamukaku nawufuku, nineyi niantu wudi nawu, wakayibatamini kumaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.32",
            "verseOrgIds": [
              "JDG.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nantetemena, neyi itaŋwa hidikutuntuka, eyi wakamenekesha, wakalukuka mukala, niyena, niantu adiyi nawu, chiyakakwidikilawu, eyiwakayila mwejima muwunakeŋi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.33",
            "verseOrgIds": [
              "JDG.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wanyamukili nawufuku, niantu adiŋiyi nawu ejima, aambukili yendu yiwana nakubatamina kuShekemi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.34",
            "verseOrgIds": [
              "JDG.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaEbedi Galawedikili hanzi, wayili nakwimana kuwiŋililu wakuchisu chamukala; Abimeleki wanyamukili niantu adiŋiyi nawu kuna kwabatamininuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.35",
            "verseOrgIds": [
              "JDG.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala, chamweniyi antu, hakumwila Zebuli, nindi, Tala, antu akukunkumuka awa kunyitu yamapidi. Zebuli hakumwila nindi, Wunamoni mwevuluwamapidi neyi kwiji hiyantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.36",
            "verseOrgIds": [
              "JDG.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala yohoshamu cheŋi nindi, Tala, antu akukunkumuka awa, kuna kwikovu, nichendu chimu china chikwinjila kumukula wakuMeyonenimi china. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.37",
            "verseOrgIds": [
              "JDG.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchinka Zebuli nindi, Indi kanwakeyi kadihi kiwelili neyi, Indi Abimeleki hiiyalanyi mwaka tumukalakeli? Hidiwu wowu antu wadiwiluku? Idikaku dinu mwani, wulwi nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.38",
            "verseOrgIds": [
              "JDG.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gala wedi kili, watwamininuku, amayala amuShekemi amukumini munyima, walwili naAbimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.39",
            "verseOrgIds": [
              "JDG.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.39",
            "verseOrgIds": [
              "JDG.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wamukupishili lufuchi, yotemuka nikutemuka; amavuluhiya kudimboka anayikatishi dehi, kwakudimboka hohu njila yejima nikuwiŋililu wakuchisu chamukala. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.40",
            "verseOrgIds": [
              "JDG.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki washakamini kuAruma; Zebuli watemwinumu Gala niana kwindi kulonda abuli kushakama muShekemi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JDG 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.41",
            "verseOrgIds": [
              "JDG.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JDG 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikwachili antu hiyakuya mumpata; amulejelumu Abimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.42",
            "verseOrgIds": [
              "JDG.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JDG 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena watambwili antu, wayambwili yendu yisatu, wabataminini mumpata, nindi atali, antu akwidika mumukala awa; yoyilotokela nikuyilotokela, yoyitapa nikuyitapa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.43",
            "verseOrgIds": [
              "JDG.9.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JDG 9:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki niyendu yadiŋiyi nawu alotokeli kumbidi nakwimana kuwipililu wakuchisu chamukala; yendu yiyedi yayilotokeleli antu ejima adiŋi mumpata, ayitapili. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.44",
            "verseOrgIds": [
              "JDG.9.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki walwilina mukala mwaana wuna wejima; nkumininaku nimukala kwe-e, yoyiŋahani antu ejima adiŋumu, nimukala yowuhumuna nikuwuhumuna, yowukuwani muŋwa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JDG 9:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.45",
            "verseOrgIds": [
              "JDG.9.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JDG 9:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala akwakaposhi kakuShekemi ejima chachitiyiluwu epililimu chipaka chakudikaŋila chamwitala daEliberiti. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.46",
            "verseOrgIds": [
              "JDG.9.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JDG 9:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amulejeli Abimeleki nawu amayala ejima akwakaposhi kamuShekemi anadipompeshi hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.47",
            "verseOrgIds": [
              "JDG.9.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JDG 9:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wakandamini mpidi yaZalimoni, niyena niantu ejima adiŋiyi nawu; Abimeleki wasendeli chizembi muchikasa, kunyitondu yadiŋukuwa kunkwiluku mutayi wumu, wawunyamwini, yoditwikawu nihachifwiji; hakuyila antu adiŋiyi nawu, nindi, Ochu mukumona nakwilami, munyakalaŋaanakwila mwomumu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.48",
            "verseOrgIds": [
              "JDG.9.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JDG 9:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima akunkwili iwu mutayi windi, iwu mutayi windi, amulonda niAbimeleki, alumbika nikuchipaka chakudikapila, chipaka chakudikapila mwadiŋuwu achocheli nakesi, chochina amayala ejima, akwakaposhi kaShekemi niwena afwili, kubomba niamayalani ambanda kwiji ikombakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.49",
            "verseOrgIds": [
              "JDG.9.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JDG 9:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki hakuya nikuTebeza, hakuwukamina hakatanda kalufu, yowutambula nikuwutambula. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.50",
            "verseOrgIds": [
              "JDG.9.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JDG 9:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa mukachi kamukala mwadiŋi kaposhi kelola, mwatemukililuwu amayala ejima, niambanda, nienimukala ejima, adenzelelamu nikudenzelelamu, hiyakukandama hewulu dakaposhi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.51",
            "verseOrgIds": [
              "JDG.9.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JDG 9:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki wenjili kwadiŋi kaposhi, hakulwa nawu, hakukabila nindiashiki kwakwihi nachenzelu chakaposhi kulonda achochi nakesi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.52",
            "verseOrgIds": [
              "JDG.9.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JDG 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sidiŋi mumbanda wumu wanatili ilola dakuhala nachu hanamutu waAbimeleki, wamulokweli namutu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.53",
            "verseOrgIds": [
              "JDG.9.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JDG 9:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.53",
            "verseOrgIds": [
              "JDG.9.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JDG 9:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakutambika swayi swayi mukwenzi windiwa musendelaŋa yitwa, hakumwila nindi, Holaku mpoku yeyi yakatali, wunjahi, akenza kahosha nawu, Amujahili kudi mumbanda. Mukwenzi windi yomuhanwisha nimpoku zwa-a, yofwa ni kufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.54",
            "verseOrgIds": [
              "JDG.9.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JDG 9:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayala aIsarela chamwenuwu Abimeleki nafwi dehi, adiyila nikudiyilalwu nikwindi, iwu nikwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
            "verseOrgIds": [
              "JDG.9.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JDG 9:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu kutama kwaAbimeleki kwakoŋeliyi tata yindi, hajahiliyi ana kwindi makumi atanu nayedi, Nzambi wamufuntishililichu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.56",
            "verseOrgIds": [
              "JDG.9.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JDG 9:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikutama kwejima kwatamishiluwu amayala amuShekemi, Nzambi wayifuntishililichu hanyitu yawu. Chashipeniyi mwana kaYerubayali Yotama, achimweni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.57",
            "verseOrgIds": [
              "JDG.9.57"
            ]
          }
        }
      ]
    }
