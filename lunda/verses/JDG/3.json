          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichiifuku odu aMowabi ayifwomweni kudi aIsarela. Mwituŋa mumwena nizo-onyaka makumi atanu nasatu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
