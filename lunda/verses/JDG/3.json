        },
        {
          "text": "Henahana atapili amayala akuMowabi neyi kwiji makombakaji ikumi, ni amayala amaneni ejima niayilobu ejima, kwosi muntu niwumu wapulukiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
