        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samisoni wayili kuGaza, kwenoku wamweni chivumbi, hakwijila mudi yena. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.1",
            "verseOrgIds": [
              "JDG.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AkwaGaza achitiyili nawu Samisoni nenzi kunu. Amujikililili niniku, niniku, amubataminini wufuku wejima kuchisucha mpwembu yamukala, amwena nikumwena zo wufuku wejima, nawu, Chikukucha budidi tukumujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.2",
            "verseOrgIds": [
              "JDG.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samisoni wakamini kame-e nimukachi kawufuku; mukachi kawufuku yohinduka nikuhinduka, yokwataniye nzelu yakuchisu champwembu yamukala, niyishimi yayu, nimukomenukumu, yojúula nikujúula, hakusha hamafwiji indi, hakusenda nakutwalakwiwulu dampidi yaditala naHeberoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.3",
            "verseOrgIds": [
              "JDG.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kufuma henohu hakukeŋa mumbanda wakuchinekineki chakuSoreki, ijina dindi Delila. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.4",
            "verseOrgIds": [
              "JDG.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanta jawaFwilistinu ayili kudi yena nakumwilanawu, Mudimbeki kulonda wutiyi mwekala Ŋovu jindi jabadika, twilukinamutukwimikila mushindu hadi yena, kulonda twakamukasi, twakamubabeshi; ninetu wejima wetu, hamuntu hamuntu, twakakwinka maliasiliva makulakaji ikumi nadimu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.5",
            "verseOrgIds": [
              "JDG.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila hakumwila Samisoni, nindi, Nleji mwani, mwekala Ŋovu jeyi jabadika nimuyakukukasilawu nakukubabesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.6",
            "verseOrgIds": [
              "JDG.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samisoni hakumwila nindi, Neyi akunkasa nanyibuŋu yituuta, yakadi kwanyikahu dehi yitanu nayiyedi nakazeya, nakekala neyi chekalawu antu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.7",
            "verseOrgIds": [
              "JDG.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi anyanta jawaFwilistinu amutweleleli nyibuŋu yitanu nayiyedi yituuta zo-o yakadikwanyikahu dehi, niyena mumbanda wamukasili nachu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.8",
            "verseOrgIds": [
              "JDG.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi yenamumbanda kwadiŋi akwakubatamina, adiŋi mwitala damukachi. Yenamumbanda hakumwila nindi, AFwilistinu anakuwani, Samisoni. Yoketulani nyibuŋu ngwa ngwa, neyi chaketukapa wanda wunakwati kesi. NiŊovu yindi hiyayilukili muyekalaku.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.9",
            "verseOrgIds": [
              "JDG.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila hakumwila Samisoni, nindi, Aka! wunandimbi, wunanlejiya kutwamba. Ichi dinu, anleji mwani, muyakukukasilawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.10",
            "verseOrgIds": [
              "JDG.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samisoni hakumwila nindi, Neyi akukumina dakunkasa nanyonji yamaneni yayi haya mbalawanda yakadi kukopahu dehi nachu mudimu, nakazeya, nakekalaneyi chekalawu antu ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.11",
            "verseOrgIds": [
              "JDG.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu Delila hakutambula nyonji yamaneniyayiha yambalawanda, hakumukasa nachu, hakumwila nindi, AFwilistinu anakuwani, Samisoni. Akwakuba tamina adiŋi mwitala damukachi. Yena waketwili nyonji kumakasindi ngwa ngwa, neyi wanda hohu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.12",
            "verseOrgIds": [
              "JDG.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila hakumwila Samisoni nindi, Mafuku ejima wunandimbi hohu, wunanleji yakutwamba hohu; nleji muyakukukasilawu. Wamwilili nindi, Yiba aba yansuki yamunamutu wami neyi wukuyitupila kumutondu wekinadakutupa nachu mahina. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.13",
            "verseOrgIds": [
              "JDG.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhatisha nalubwambu, hakumwila nindi, AFwilistinu anakuwani, Samisoni. Yohinduka ninamutulu twindi, yohukwilakumu nilubwambu lwachipamba, nimutondu wekina.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.14",
            "verseOrgIds": [
              "JDG.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mumbanda hakumwila nindi, Indi eyi wunatweshi pahi kuhoshaneyi ami nakukeŋa? Kutala ami, eyi hiwapusha kumuchimaku. Wunandimbi dehi aka kasatu aka, hiwunanleji mwekala Ŋovu jeyi jabadikaku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.15",
            "verseOrgIds": [
              "JDG.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumukakeja nikumukakeja namazu indi, hakumushinjila, yena yotiyani kumuchima bwi neyi kufwa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.16",
            "verseOrgIds": [
              "JDG.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yomuleja nimumbanda muchima windi wejima to-o, nindi, Mpoku yachayi kanda yihiti hoku kunamutu wamuku, muŋa ami nikaNaziri kambala kaNzambi, kufumisha hinavwalikili mwivumu damama yami. Mona antewula, Ŋovu yami yikunfuma, nakazeya, nakekala neyi chekalawu antu ejima.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.17",
            "verseOrgIds": [
              "JDG.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Delila chamweniyi namuleji dehi muchima windi wejima to-o, hakutemeshana kutambika anyanta jawaFwilistinu nakuyila nindi, Twayenu akakamu hohu aka, muloŋa nanleji dehi muchima windi wejima to-o. Anyanta jawaFwilistinu aya nikudi yena, asenda nimali mumakasawu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.18",
            "verseOrgIds": [
              "JDG.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena mumbanda wamukamikili namutulu hamatafu indi, watambikili iyala, hakumutewula yibaaba yejima yitanu nayiyedi yakunamutu windi, watachikili kumukabisha, niŋovu yindi yimufuma nikumufuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.19",
            "verseOrgIds": [
              "JDG.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, AFwilistinu anakuwani, Samisoni. Yohinduka namutulu twindi, nindi, Tali niidikineyi chinedikaŋa dikalu, nakadinyi kumuni. Ilaŋa chafuminiyi Yehova kudi yena hachilukiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.20",
            "verseOrgIds": [
              "JDG.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AFwilistinu amukwata nikumukwata, amulokola nimesu, amutwela kuGaza, amupata munshimbi jawuneŋu; hakuhala mwitala dakaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.21",
            "verseOrgIds": [
              "JDG.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nsuki jakunamutu windi jatachikili kukula cheŋi nachina chamutewiluwu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.22",
            "verseOrgIds": [
              "JDG.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyanta jawaFwilistinu apompeli kulonda nawu amuketwili mukishiwawu Dagoni yimuna yayivulu, kulonda azaŋalali; muloŋa ahosheli nawu, Yena mukishi wetu diyi natwinki chilumbu chetu Samisoni muchikasa chetu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu chamumwenuwu, ahamekeli mukishi wawu, muloŋa elilinawu, Mukishi wetu diyi natwinki muchikasa chetu chilumbu chetu mukwakukisaŋana ituŋa detu, najahi akwetu amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliluwu anatiyi kunyichima yawu kunawahi, nawu, Mutambi kenu Samisoni tumutali chakuhemayi. Amutambika niSamisoni mwitala dakaleya mwadiŋiyi, hakuhema kumesu awu, amusha hakachi kayishimi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samisoni hakumwilakansi keyala wamukwatili kuchikasa, nindi, Nleki nitiyi yishimi yakolela itala, kulonda nikundamenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itala dadiŋi denzala to-o namayala nawambanda; nianyanta jawaFwilistinu ejima kwokwadiŋuwu; hewulu detalahadiŋi neyi kwiji makombakaji asatu amayala nawambanda, nakutala chakuhemayi Samisoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        }
      ]
    },
