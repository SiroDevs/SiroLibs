              "JDG.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi kwosi wakuyamwinaku, muloŋa kuZidoni kwadiŋi kwakulehi, niwena kwawu kwendapana munyikala yawakwawu nehi. Chadiŋi muchinekineki chekala kwakwihi naBetirehobi. Mukala awutuŋilwili cheŋi, ashakamamu nikushakamamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukala awutumbili ijina dawu nawu Dani, kafwampi dodijina datatayawu Dani avweliyi Isarela. Ilaŋa hakusambila ijina damukala dadiŋi daLayishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kaDani emikili mukishi owu wakusoŋa; Jonatani mwana kaGereshomi, Gereshomi mwana kaMosi, niyena ni anyanindi elili atupristu twamuchidi wawaDani anamutuukishi hamwaka wayikwatiluwu antu amwituŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.30",
            "verseOrgIds": [
              "JDG.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi emikili mukishi owu wakusoŋa weliliyi Mika nyakaye jima yadiŋi itala daNzambi muShilo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.31",
            "verseOrgIds": [
              "JDG.18.31"
            ]
          }
        }
