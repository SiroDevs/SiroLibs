      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "3JN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwunda kwikali naneyi. Akwetu anakwimwishi. Ŋimwishili akwetu ejima hejina hejina ijina daMwanta Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
      ]
