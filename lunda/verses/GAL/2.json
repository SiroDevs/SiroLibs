          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimunahiti nyaka ikumi nayiwana, hinukukanduka cheŋi kuYerusalema naBaranaba, tusenda niTitusa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.1",
            "verseOrgIds": [
              "GAL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayili chakunleja nachimwekeshu; hinukuyilumbulwila nsaŋu yayiwahi yinashimunaŋa mukachi kawajentili, ilaŋa akwetu alema nalejeli kwakanka wetu, kuchina kutemuka tuhu chamukunkulwayi, indi kwiji natemuki dehi chamukunkulwayi diyi Kefwasi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.2",
            "verseOrgIds": [
              "GAL.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.10",
            "verseOrgIds": [
              "GAL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chashikiliyi Petulu kuAntiyoki, nadikaŋili kumesu indi, muloŋa wadiŋi namuloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.11",
            "verseOrgIds": [
              "GAL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa heliluwu antu afumini kudi Yakoba achidi kanda enzi, wadiilaŋa nawajentili. Ilaŋa chanenzuwu wena, yena Petulu hakufumamu, hakwambuka kudi ajentili, muŋa natiyi dehi akwakwalama woma. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.12",
            "verseOrgIds": [
              "GAL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiaYudeya asheluku hiyakudimbana mwomumu nayena, kudimbana kwakwila niBaranaba nawa niyena hakuhuŋumuka chimu nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.13",
            "verseOrgIds": [
              "GAL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ami chinamweni adi nakwila mwabula kuya nsaŋu yayiwahi yalala, hinukumwila Petulu kumesu awakwawu ejima nami, Eyi kaYudeya hiwashakamaŋa mwaya wuYudeyaku, washakamaŋa neyi kaJentili, wakakejelaŋadi ajentili, neyi ashakami neyi chashakamaŋawu aYudeya? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.14",
            "verseOrgIds": [
              "GAL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu twela kuchisemwa chetu tudi aYudeya, hitudi kwetu ajentili akwanshiduku, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.15",
            "verseOrgIds": [
              "GAL.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "yetu tuneluki netu muntu hakutwesha kubalumuka kwikala waloŋa nanyidimu yanshimbuku, chiŋa nakumukuhwelela Yesu Kristu hohu; ninetu aweni tunamwitiyili Kristu Yesu kulonda tuloŋa nakukuhwelela Kristu, bayi nanyidimu yanshimbuku. Muloŋa hikudi muntu wukuloŋa nanyidimu yanshimbuku. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.16",
            "verseOrgIds": [
              "GAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etu twakeŋa eli kwikala aloŋa mudi Kristu, neyi akutumona nawu tudi akwanshidi, komana Kristu diyi wakoŋeshaŋa antu nshidi, tahindi? Chinjila! ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.17",
            "verseOrgIds": [
              "GAL.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi nukutuŋiulula cheŋi yuma yinakisaŋeni, nadi mwekeshi dehi kwikala mukwakuvulumuna. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.18",
            "verseOrgIds": [
              "GAL.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami kunshimbi nimufu hamudimu wanshimbi, kulonda nimuhandili Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.19",
            "verseOrgIds": [
              "GAL.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ampopela dehi kukulusu hamu naKristu, ilaŋa nahanda; hiyami nawaku, Kristu diyi wahandilaŋa mudami. Chinahandaŋa mumujimba nahandaŋa mukwitiya kwakukuhwelela Mwana kaNzambi, wankeŋeli, wadiheni kunkoolami. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.20",
            "verseOrgIds": [
              "GAL.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinadiwulaŋa luwi lwaNzambuku; Muloŋa neyi kuloŋa kwenzaŋa kunshimbi, komana Kristu wafwili tuhu kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.2.21",
            "verseOrgIds": [
              "GAL.2.21"
            ]
          }
        }
      ]
    }
  ],
