        },
        {
          "text": "Chashikili ifuku dalondelaŋa mwifuku dakuloŋesha paseka, awakulumpi jawatupristu niaFwarisi hiyakupompa kudi Pilatu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.62",
            "verseOrgIds": [
              "MAT.27.62"
            ]
          }
        },
        {
