          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi lejenu antu akakoleshi kwijamu kushika nikwifuku damu chisatu, mukunkulwayi atumbanji twindi akenza nakumwiyamu, akaleja antu nawu nasaŋuki mudi afu; kuluwaŋesha kwakukuminina kwakabadika kwakusambila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.64",
            "verseOrgIds": [
              "MAT.27.64"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
