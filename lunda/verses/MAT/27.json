          "items": [
            {
              "text": "66",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi wena hiyakuya, hiyakukolesha kwijamu, hiyakusha chilamiki kwilola, mashidika akwakuhemba saŋa aduwu nawu.",
          "type": "text",
