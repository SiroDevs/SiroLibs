  "copyright": "PUBLIC DOMAIN",
  "verseCount": 66,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "MAT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chikuneli budidi, awakulumpi jawatupristu ejima, niakulumpi jawantu hiyakumushakamina Yesu hampùŋa, kulonda amujahi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.1",
            "verseOrgIds": [
              "MAT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakumukasa, hiyakumutwala nakumuhana kudi nguvulu Pilatu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.2",
            "verseOrgIds": [
              "MAT.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.2",
            "verseOrgIds": [
              "MAT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu owu Yudasi wamufukejeli, chamweniyi anamuhishi dehi, hakubalumuka mumuchima windi, hakufuntisha cheŋi owu mali asiliva makumi asatu kudi awakulumpi jawatupristu nikudi awakulumpi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.3",
            "verseOrgIds": [
              "MAT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Chinafukeji mashi akadi muloŋa navulumuni. Wena hiyakumwila nawu, Nsaŋu yetu wanyi; oji jeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.4",
            "verseOrgIds": [
              "MAT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunatila owu mali asiliva mutembeli, hakufumaku, hakuya nakudikudika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.5",
            "verseOrgIds": [
              "MAT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi jawatupristu hiyakunona owu mali asiliva, hiyakwila nawu, kuyisha mwaswekelaŋawu mali ajila chinjila, muloŋa hiwuseya wamashi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.6",
            "verseOrgIds": [
              "MAT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutiyaloŋana, hiyakulanda nachu kapata kakaŋemi, kulonda ajiikaŋamu enyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.7",
            "verseOrgIds": [
              "MAT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kapatoku hiyakukatumba ijina nawu, Kapata kamashi; nikwifuku dalelu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.8",
            "verseOrgIds": [
              "MAT.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu mwahosheliyi kaprofwetu Yeremiya mwalumbulukili, mweliliyi nindi, Anoneni mali asiliva makumi asatu, diwu wuseya wayena esekeleluwu, wuseya wafuukwiluwu kudi aIsarela; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.9",
            "verseOrgIds": [
              "MAT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "alandili nachu kapata kakaŋemi, mwomwanlejeliyi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.10",
            "verseOrgIds": [
              "MAT.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.10",
            "verseOrgIds": [
              "MAT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwimana kumesu anguvulu; nguvulu hakumwihula nindi, Eyi yeyi Mwanta wawaYudeya, tahindi? Yesu hakumwila nindi, Mwomwenomu muwunahoshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.11",
            "verseOrgIds": [
              "MAT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamwinkeluwu muloŋa kudi awakulumpi jawatupristu nikudi awakulumpi, haakwili izuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.12",
            "verseOrgIds": [
              "MAT.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakumwila henohu nindi, Iyi yuma yayivulu yidi nakukushimunawu hiwunayitiyuku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.13",
            "verseOrgIds": [
              "MAT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwakwili hela izu nidimuku; nguvulu hakuhayama nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.14",
            "verseOrgIds": [
              "MAT.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.14",
            "verseOrgIds": [
              "MAT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hachawija ochu nguvulu wombililaŋa antu muntu wamukaleya wumu akutondawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.15",
            "verseOrgIds": [
              "MAT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu adiŋi namuntu wamukaleya wumu watiyakana, ijina dindi Baraba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.16",
            "verseOrgIds": [
              "MAT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi chanapompuwu, Pilatu hakuyila nindi, Munakeŋi niyumbilinyi? Baraba, tahindi Yesu atenaŋawu nawu Kristu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.17",
            "verseOrgIds": [
              "MAT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa welukili nindi anamuheni ichima danatiyuwu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.18",
            "verseOrgIds": [
              "MAT.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.18",
            "verseOrgIds": [
              "MAT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashakamiyi hetanda dakusompela, Iŋodindi hakumutemeshela muntu nindi, Bayi wukwata hansaŋu janowu muntu waloŋaku, muloŋa nsaŋili yindi lelu nayimweni yuma yakala yayivulu mukulota. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.19",
            "verseOrgIds": [
              "MAT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi jawatupristu niakulumpi hiyakukanjikŋa mazaza alombi Baraba, Yesu amujahi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.20",
            "verseOrgIds": [
              "MAT.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nŋuvulu hakuyakula nindi, Awa ayedi munakeŋi niyumbiluhu wumwodihi? Nawu, Baraba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.21",
            "verseOrgIds": [
              "MAT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakuyila nindi, Indi Yesu atenaŋawu nawu Kristu nukumwila ŋahi? Wejima wawu nawu, Amupopeli kukulusu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.22",
            "verseOrgIds": [
              "MAT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, muloŋanyi? Chuma chatama chanakoŋiyi chumanyi? Wena asweja nikubideka nawu, Amupopeli kukulusu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.23",
            "verseOrgIds": [
              "MAT.27.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.23",
            "verseOrgIds": [
              "MAT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu chanamoniyi nayikaŋanyi dehi, hihakusweja niipumba, hakutambula meji, hakwisuka kumakasindi, iku izaza didi nakumutala, nindi, Ami hinidi namuloŋa wamashi aniwu muntu waloŋaku; hinsaŋu yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.24",
            "verseOrgIds": [
              "MAT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima hiyakwakula nawu, Mashi indi atukumini etu aweni nawanyanetu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.25",
            "verseOrgIds": [
              "MAT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayumbilaku niBaraba. Chanamuvupoliyi Yesu yikoti, hakumuhana nindi amupopeli kukulusu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.26",
            "verseOrgIds": [
              "MAT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.26",
            "verseOrgIds": [
              "MAT.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mashidika anguvulu hiyakumutwala Yesu mwibulu dawu, amupompeshela nichendu chejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.27",
            "verseOrgIds": [
              "MAT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amuvúula nimahinindi, hiyakumuvwika ihina dawusombu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.28",
            "verseOrgIds": [
              "MAT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "atuŋa nichibaaba chanyiŋa, hiyakuchisha kunamutu windi; amusha niiteti muchikasa chindi chachidiilu, hiyakumufukamina, hiyakumuseha nawu, Kolenu, Mwanta wawaYudeya! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.29",
            "verseOrgIds": [
              "MAT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumufwŋila mazeŋi, hiyakumutambula cheŋi iteti odu, hiyakumweta nachu kunamutu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.30",
            "verseOrgIds": [
              "MAT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamanishuwu kumuseha, hiyakumuvúula odu ihina damuvwikiluwu, hiyakumuvwika cheŋi mahinindi, hiyakumutwala nakumupopela kukulusu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.31",
            "verseOrgIds": [
              "MAT.27.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.31",
            "verseOrgIds": [
              "MAT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋi nakwidikawu, hiyakuwana muntu wakuKireni, ijina dindi hiihina davwelaŋa anyanta. Shimona, hiyakumukwata nawu amusendeluku kulusu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.32",
            "verseOrgIds": [
              "MAT.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanashikuwu kwatenaŋawu nawu, Goloŋota; chaya mukwila nawu Kuchaŋu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.33",
            "verseOrgIds": [
              "MAT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakumwinka walwa wabatuka wabombashana nandulu anwi; chanawutompiyi, kuwinwa kwonti kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.34",
            "verseOrgIds": [
              "MAT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanamupopeluwu kukulusu, adipaŋila nimahinindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.35",
            "verseOrgIds": [
              "MAT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakushakama kwenoku nakumuhemba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.36",
            "verseOrgIds": [
              "MAT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwiwulu danamutu windi, ashiluku mukanda wamuloŋa wamwinkeluwu; awusonekeli nawu, Iwu diyi Yesu Mwanta wawaYudeya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.37",
            "verseOrgIds": [
              "MAT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu apopeleli kumakulusu chimu nayena atupondu ayedi, wumu kuchikasa chindi chachidiilu, mukwawu kuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.38",
            "verseOrgIds": [
              "MAT.27.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakunamutukola kudi antu ahitilaŋaku, hiyakumulembola nanyitu yawu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.39",
            "verseOrgIds": [
              "MAT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Eyi wasandaŋa tembeli, hiwukuyituŋa cheŋi mumafuku asatu, damwini; neyi wuMwana kaNzambi, sulukaku kukulusu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.40",
            "verseOrgIds": [
              "MAT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niawakulumpi jawatupristu amuseheli nawa mwomumu, niansoneki niakulumpi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.41",
            "verseOrgIds": [
              "MAT.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "elili nawu, Waamwinini akwawu, yomweni hanatweshi kudamwinaku. Yena hiMwanta wawaIsarela asuluki kukulusu katataka, tumwitiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.42",
            "verseOrgIds": [
              "MAT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakuhwelelaŋa Nzambi; neyi namukeŋi amupulwishi katataka; muloŋa yena welaŋa nindi ni mwana kaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.43",
            "verseOrgIds": [
              "MAT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niatupondu, apopeleluwu kumakulusu chimu nindi, amuhosholeli nawa mwomumu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.44",
            "verseOrgIds": [
              "MAT.27.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.44",
            "verseOrgIds": [
              "MAT.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kufuma kuora yamuchitanu nayimu, mwituŋa dejima mushishita nimwidima, kushika nikuora yamuchitanu nachiwana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.45",
            "verseOrgIds": [
              "MAT.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili neyi hikwakwihi naora yamuchitanu nachiwana, Yesu hakubilela nezu daŊovu nindi, Eli, Eli, lama sabakatani; chaya mukwila nawu, Nzambi yami, Nzambi yami, wunanshiyilidi kanka wami? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.46",
            "verseOrgIds": [
              "MAT.27.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 27:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakwawu emenuku, chanachitiyuwu, hiyakwila nawu, Iwu iyala hakutambika Elija. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.47",
            "verseOrgIds": [
              "MAT.27.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 27:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumu hakunyakala kunona siponja, hakuyisha muwalwa wabatuka hakuyisha kwiteti, hakumwinka nindi anwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.48",
            "verseOrgIds": [
              "MAT.27.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 27:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anashali nawu, Leka tutali neyi Elija wukwinza nakumwamwina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.49",
            "verseOrgIds": [
              "MAT.27.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 27:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakubilela cheŋi nezu daŊovu, yotula niwumi windi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.50",
            "verseOrgIds": [
              "MAT.27.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 27:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.50",
            "verseOrgIds": [
              "MAT.27.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 27:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihina dadiŋi dakujika mutembeli mwajila ditabuka nihakachi, kufumisha kwiwulu ndo nikwishina; maseki hiyakukanka, nimalola hiyakubaloka; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.51",
            "verseOrgIds": [
              "MAT.27.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "MAT 27:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumajamu hikukwenzuluka; akwakujila akamini dehi tulu amavulu hiyakusaŋuka nanyijimba yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.52",
            "verseOrgIds": [
              "MAT.27.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MAT 27:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Helili Yesu nasaŋuki dehi hiyakwijila muŋanda yajila, hiyakumwekana kudi antu amavulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.53",
            "verseOrgIds": [
              "MAT.27.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 27:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Senturinu ninowu ahembelaŋa yinawu Yesu, chanamonuwu mutentanshi niyuma yahitiluku, hiyakutiya woma nankashi, nawu, Chalala iwu wadiŋi Mwana kaNzambi!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.54",
            "verseOrgIds": [
              "MAT.27.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MAT 27:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.54",
            "verseOrgIds": [
              "MAT.27.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MAT 27:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadiŋi ambanda amavulu emeni kwakulehi nakumutala, wowu afumini naYesu kuŊaliliya, amukalakelelaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.55",
            "verseOrgIds": [
              "MAT.27.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 27:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadiŋi niMariya Mandaleni, ni Mariya mama yaYakoba naYosesi, nimama yawanyana kaZebedewu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.56",
            "verseOrgIds": [
              "MAT.27.56"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MAT 27:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.56",
            "verseOrgIds": [
              "MAT.27.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "MAT 27:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikuneli melela hikukwinza muntu waheta, wafumini kuAramateya, ijina dindi Yosefu, niyena nawa wadiŋi kambanji kaYesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.57",
            "verseOrgIds": [
              "MAT.27.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "MAT 27:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena muntu iwu hakuya nakulomba mujimba waYesu kudi Pilatu; Pilatu hakuyila nindi mwinkenuwu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.58",
            "verseOrgIds": [
              "MAT.27.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "MAT 27:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu hakutambula mujimba, hakuwujiŋajiŋa mwihina ditooka dakadi majilu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.59",
            "verseOrgIds": [
              "MAT.27.59"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "MAT 27:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakuwukamika mwijamu dindi dadiha dapokweliyi yomweni mwilola; kuchisu chejamu hakukunkumwinaku ilola deneni, hakufumaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.60",
            "verseOrgIds": [
              "MAT.27.60"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "61",
            "style": "v",
            "sid": "MAT 27:61"
          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiMariya Mandaleni wadiŋi kwoku, niMariya mukwawu, ashakamini nakutala mesu kwijamu.",
          "type": "text",
