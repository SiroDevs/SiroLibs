              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Eyi Mwanta tunaanuki dehi netu iwu mukwakudimbana hadiŋiyi wamumi welilaŋa nindi, Neyi munahiti dehi mafuku asatu nakasaŋuka mudi afu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.63",
            "verseOrgIds": [
              "MAT.27.63"
            ]
          }
        },
        {
          "name": "verse",
