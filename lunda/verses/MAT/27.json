          },
          "items": [
            {
              "text": "65",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pilatu hakuyila nindi, Mashidika akwakuhemba mudi nawu, yenu mwakakoleshuku mwonsu mumunatwesheli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.27.65",
            "verseOrgIds": [
              "MAT.27.65"
            ]
          }
        },
        {
