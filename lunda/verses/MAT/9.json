  "copyright": "PUBLIC DOMAIN",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "MAT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwijila cheŋi muwatu, hakuzambukila kwishinadi, hakushika mumukala windi yomweni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
            "verseOrgIds": [
              "MAT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala hiyakumuletela muntu wakata kalepa, nakami hakadidi. Yesu chanamoniyi kukuhwelela kwawu, hakumwila owu wakata kalepa nindi, Eyi mwanami, tiyaku kuwaha; anakwanakeni nyiloŋa yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.2",
            "verseOrgIds": [
              "MAT.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ansoneki amu hiyakwila munyichima yawu nawu, Iwu muntu wudi nakutuka Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.3",
            "verseOrgIds": [
              "MAT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwiluka yitoŋojoka yawu, hakuyila nindi, Muloŋanyi mudi nakutoŋojokela yatama munyichima yenu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaswayi kumwila muntu nami, Anakwanakeni nyiloŋa yeyi, tahindi chaswayi kumwila nami, Hindukaku, endaku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.5",
            "verseOrgIds": [
              "MAT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nalondi mwiluki nenu Mwana kamuntu wukweti wanta wakwanakena antu nyiloŋa hanu hamaseki. Hakumwila owu wakata kalepa nindi, Hindukaku, nonaku kadidi keyi wuyi kwitala deyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuhinduka, hakuya kwitala dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.7",
            "verseOrgIds": [
              "MAT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza awantu chanamonuwu ochu, hiyakutiya woma, hiyakumulemesha Nzambi wenkeli antu wantowu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.8",
            "verseOrgIds": [
              "MAT.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.8",
            "verseOrgIds": [
              "MAT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakupandakanayi Yesu nakufuma kwenoku, hakumona muntu ijina dindi Matewu, nashakami kwakutambwila nyombu; hakumwila nindi, Nlondi. Hakunyamuka, hakumulonda.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chashakaminiyi mwitala nakudya, kutala ansonkeshi nawakwanshidi amavulu hiyakwinza nakushakama chimu naYesu niatumbanji twindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.10",
            "verseOrgIds": [
              "MAT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanachimonuwu aFwarisi, hiyakuyila atumbanji twindi nawu, Nkuluŋaŋa yenu wadiilaŋadi nawansonkeshi nawakwanshidi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.11",
            "verseOrgIds": [
              "MAT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanachitiyiyi, hakwila nindi, Akola hiyakeŋakeŋaŋa chimbukuku, chiŋa akata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenu mwakashinshiki mazu elawu nawu, Nakeŋi luwi, bayi chimuna chakuketulaku; muloŋa hinenzi nakutambika aloŋaku, nenzi nakutambika akwanshidi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.13",
            "verseOrgIds": [
              "MAT.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.13",
            "verseOrgIds": [
              "MAT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu atumbanji twaYowanu hiyakwinza kudi yena nawu, Etu nawatumbanji twawaFwarisi twasweja kujiŋojoka nakuleka kudya, hakwila atumbanji tweyi hiyajiŋaŋaku. Chafumaŋa hanka? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.14",
            "verseOrgIds": [
              "MAT.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyila nindi, Adi nansumbuli akuneŋa ŋahi hachiduwu nansumbuli? Mafuku akenza akafumishawu nsumbuli kudi wena, dihu hakajiŋojokawu nakuleka kudya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.15",
            "verseOrgIds": [
              "MAT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikudi muntu wukusha chitabu chehina dadiha kuchikovwelu chachikuluku; mukunkulwayi ochu chadiŋi chakujikamu nachu chikutabula chi kovwelu, chiloku chikusweja kutoha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.16",
            "verseOrgIds": [
              "MAT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hikudi muntu wukulona vinyu yayiha munjeki jayitembi yayikuluku; neyi wukwila ochu, njeki jayitembi jikubuzika, vinyu yikumwaŋala, ninjeki jayitembi jikukisika; vinyu yayiha ayiloŋaŋa munjeki jajiha, dichi yejima yikwikala yayiwenyi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.17",
            "verseOrgIds": [
              "MAT.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.17",
            "verseOrgIds": [
              "MAT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahoshelaŋayi nawu yumiyi, kutala hikukwinza nyuli wumu, hakudifukula kudi yena nindi, Mwanami wamumbanda nafwi dehi katatakichi; hela chochu, inzaku wumunaŋiki chikasa cheyi, wukuhanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakunyamuka, hakumulondela niatumbanji twindi hamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala mumbanda wapwekelaŋa mashi nyaka ikumi nayiyedi, hakwinza kunyima yindi, hakukunka kumukundulu wehina dindi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋa welili mumuchima windi nindi, Hela nukukunka kwakwihina dindi hohu, nukukola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Yesu hakushetumuka, hakumumona; hakumwila nindi, Eyi mwanami, tiyakukuwaha; kukuhwelela kweyi kunakukoleshi dehi. Kufuma hampinji oyu owu mumbanda akola nikukola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanenziyi Yesu mwitala danowu nyuli, hakumona akwakwimba yisanji, niizaza dawantu adi nakuleta ipumba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Fumenumu; mwana hanafuku, wudi namutulu. Hiyakumuseha chakumudiwula. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izaza chidinediki, yena hakwijila mu, hakumukwata kuchikasa, owu mwana wamumbanda hakunyamuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.25",
            "verseOrgIds": [
              "MAT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpuhu yachumochu yitiyakana ni mwituŋa dejima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakuhitayi Yesu nakufuma kwenoku, amayala amputamesu ayedi hiyakumulonda nakubilela nawu, Eyi Mwana kaDavidi, tutiyili luwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
            "verseOrgIds": [
              "MAT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi mwitala, owu amputamesu hiyakwinza kudi yena; Yesu hakuyila nindi, Enu munetiyi nenu ami natweshi kwila chumichi, tahindi? Hiyakumwila nawu, Eŋa Mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi hakuyikunka kumesu awu nindi, Mwashika kukuhwelela kwenu dimu mwakuyililawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimesu awu atona nikutona. Yesu hakuyihosha chakola nankashi nindi, Bayi achiluka kudi muntuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa wena hiyakuya nakutiyakesha mpuhu yindi mwituŋa odu dejima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
              "MAT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
              "MAT.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayilaŋawu, kutala hiyakumuletela kamama wazakukaŋa demoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu demoni chanafumiyi, kamama hakuhosha; mazaza awantu hiyakuhayama nawu, muIsarela kanda amonaŋahu dehi chuma chidi neyi ichuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa Fwarisi nawu, Wudi nakufumisha ademoni naŋovu jamwanta wawademoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakutambatamba munyikala yejima, niyamaneni niyanyanya, nakuyileja mumashikolawu, nakushimuna nsaŋu yawanta yayiwahi, nakuuka nyisoŋu yejima niyikatu yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chanamoniyi mazaza awantu, hakuyitiyila wushona, muloŋa akabakeni, apalaŋeni neyi nyikoku yakadi kabiŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu hakuyila atumbanji twindi nindi, Chalala mbutu jajivulu jinahi dehi, ilaŋa akwakukalakala anakehi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi lombenu kudi Mwanta wakumuna atemeshi akwakukalakala kukumuna kwindi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
            "verseOrgIds": [
              "MAT.9.38"
            ]
          }
        }
      ]
    }
