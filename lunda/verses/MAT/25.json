  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "MAT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu wanta wamwiwulu akawufwikŋi neyi ikumi dawambanda ajiki asendeli manoŋu awu, hiyakuya nakukinkilila nsumbuli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.1",
            "verseOrgIds": [
              "MAT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanu adiŋi abula maana, atanu adiŋi nama ana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.2",
            "verseOrgIds": [
              "MAT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abula maana asendeli manoŋu akadi manji. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.3",
            "verseOrgIds": [
              "MAT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila adiŋi nama ana asendeli manoŋu awu nimanji muyipunda yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.4",
            "verseOrgIds": [
              "MAT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chalabiliyi nsumbuli, hiyakunoŋaoka wejima wawu, akama nitulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.5",
            "verseOrgIds": [
              "MAT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukachi kawufuku hiyakutiya ipumba nawu, Tiyenu, nsumbuli owu! Idikenu muyi nakumukinkilila! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.6",
            "verseOrgIds": [
              "MAT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu ajiki ejima ahindoka nihohenohu, akombojola nimanoŋu awu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.7",
            "verseOrgIds": [
              "MAT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abula maana hiyakuyila akweti maana nawu, Twinkenuhu manji, muloŋa manoŋu etu hiyakuya nakujima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.8",
            "verseOrgIds": [
              "MAT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akweti maana hiyakwakula nawu, Hadaha hitukuwaninaku; yenu mwakadilandili enu aweni kudi alandishaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.9",
            "verseOrgIds": [
              "MAT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayilaŋawu nakulanda, nsumbuli enza nikwinza; adiŋi nakumutalila eŋila nimumawŋia, enzela nichenzelu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.10",
            "verseOrgIds": [
              "MAT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkumininaku owu ajiki amakwawu hiyakwinza, hiyakwila nawu, Mwanta, Mwanta, twenzulwiluku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.11",
            "verseOrgIds": [
              "MAT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyakula nindi, Nukuyileja chalala nami hinayilukaku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.12",
            "verseOrgIds": [
              "MAT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tonenu, muloŋa himuneluki hela ifuku hela mpinjuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.13",
            "verseOrgIds": [
              "MAT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chidi neyi muntu wukukeŋa kuya kwituŋa dacheŋi, liakutambika anduŋu jindi, hakuyishiyila yuma yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.14",
            "verseOrgIds": [
              "MAT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wumu hakumwinka ntalenta jitanu, mukwawu jiyedi, mukwawu yimu, mwomwesekela Ŋovu jawu; hakuya nimunjila yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.15",
            "verseOrgIds": [
              "MAT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu owu watambwili ntalenta jitanu hakunyamuka, hakuya nakujila ndujola, hakuwaninahu jikwawu jitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.16",
            "verseOrgIds": [
              "MAT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chochimu nawa niwatambwili jiyedi, waheteleluhu nawa jikwawu jiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.17",
            "verseOrgIds": [
              "MAT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa owu watambwili yimu hakuya nakupunda heseki, hakuswekahu mali ankaka yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.18",
            "verseOrgIds": [
              "MAT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chihanalehi nankashi, nkaka yanowu anduŋu hakwinza, hakuchinda mali awu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.19",
            "verseOrgIds": [
              "MAT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu watambwili ntalenta jitanu hakwinza, hakumuletela jikwawu jitanu, nindi, Eyi nkaka, wanyinkeli ntalenta jitanu; tala, naheteluhu jikwawu jitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.20",
            "verseOrgIds": [
              "MAT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yindi hakumwila nindi, Chachiwahi, wunduŋu wamuwahi washinshika; wunashinshiki nayuma yantesha, nukukwinka wanta wayuma yayivulu; iŋila mumuzaŋalu wankaka yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.21",
            "verseOrgIds": [
              "MAT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watambwili ntalenta jiyedi hakwinza nawa, nindi, Eyi nkaka, wanyinkeli ntalenta jiyedi; tala, naheteluhu ntalenta jikwawu jiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.22",
            "verseOrgIds": [
              "MAT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yindi hakumwila nindi, Chachiwahi, wunduŋu wamuwahi washinshika; wunashinshiki nayuma yantesha, nukukwinka wanta wayuma yayivulu; iŋila mumuzaŋalu wankaka yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.23",
            "verseOrgIds": [
              "MAT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Watambwili ntalenta yimu hakwinza nawa, nindi, Eyi nkaka, nakwilukili nami wumuntu wakala, wamunaŋa kuwabulili kukuwa, wakuŋulaŋa kuwabulili kumwaŋila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.24",
            "verseOrgIds": [
              "MAT.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi natiyili woma, hinukuya nakuvumbika ntalenta yeyi heseki, tala, yuma yeyi iyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.25",
            "verseOrgIds": [
              "MAT.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yindi hakumwakula nindi, Eyi nduŋu watama wakatala, welukili neyi namunaŋa kunabulili kukuwa, nakuŋulaŋa kunabulili kumwaŋila; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.26",
            "verseOrgIds": [
              "MAT.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "walekelelidi kusha mali ami mubanki, kulonda ichi chinenzi nitambuli yami niyakulunjikahu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.27",
            "verseOrgIds": [
              "MAT.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mutambulenu ntalenta yadiŋi nayu, mwinki wukweti ntalenta ikumi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.28",
            "verseOrgIds": [
              "MAT.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa wukweti akamwinka, wakaheta yayivulu; hakwila wabula akamutambula ninaka kadiyi naku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.29",
            "verseOrgIds": [
              "MAT.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu nduŋu wamukunkulwayi múumbilenu kumwidima wahanzi; kwakekala kudila nakudisumona kumaji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
            "verseOrgIds": [
              "MAT.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa chakenzayi Mwana kamuntu nalubanji lwakulema kwindi, hamu nawaŋelu jindi ejima, wakashakama hetanda dawanta dakulema kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.31",
            "verseOrgIds": [
              "MAT.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akapompesha nyuza yejima kumesu indi; wakaambola muza namuza, neyi chaambulaŋayi kabiŋa anyikoku nawampembi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.32",
            "verseOrgIds": [
              "MAT.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyikoku wakayisha kuchikasa chindi chachidiilu, ampembi kuchimunswa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.33",
            "verseOrgIds": [
              "MAT.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu Mwanta wakayila akuchikasa chindi chachidiilu nindi, Inzenu enu anakoolekeshuwu kudi Tata yami, swanenu wanta wenu wayiloŋesheleluwu kufumisha haaliluwu chikuku champata yamunu mwishina. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.34",
            "verseOrgIds": [
              "MAT.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hinatiyili nzala, enu mwanyinkeli yakudya; hinatiyili mpwila, enu mwanyinkeli yakunwa; hinadiŋi mwenyi, enu mwantambwili; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.35",
            "verseOrgIds": [
              "MAT.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinadiŋi nawuvu, enu mwanvwikili; hinakatili, enu mwenjili nakuntala; hinadiŋi mukaleya enu mwenjili kudami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.36",
            "verseOrgIds": [
              "MAT.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu aloŋa akamwakula nawu, Mwanta, ifukwinyi twakumweni nanzala, etu tukudiishi? hela nampwila, etu tukunwishi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.37",
            "verseOrgIds": [
              "MAT.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifukwinyi twakumweni nawenyi, etu tukutambuli? hela nawuvu, etu tukuvwiki? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.38",
            "verseOrgIds": [
              "MAT.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifukwinyi twakumweni nakukata hela mukaleya, etu twinzi kudeyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.39",
            "verseOrgIds": [
              "MAT.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakayakula nindi, Nukuyileja chalala nami, chimwakalakeleli mana kwami wumu, chalala yowu wadiŋi wakehelamu, mwakalakelelami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.40",
            "verseOrgIds": [
              "MAT.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu wakayila akuchikasa chachimunswa nindi, Nfumenu enu mwashiŋcwa, yenu mukesi kahaya nyaka kaloŋesheleluwu diyabolu nawaŋelu jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.41",
            "verseOrgIds": [
              "MAT.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa hinatiyili nzala, enu kunyinka yakudya nehi; hinatiyili mpwila, enu kunyinka yakunwa nehi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.42",
            "verseOrgIds": [
              "MAT.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "hinadiŋi mwenyi, enu kuntambula nehi; hinadiŋi nawuvu, enu kunvwika nehi; hinakatili, nihinadiŋi mukaleya, enu kwinza nakuntala nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.43",
            "verseOrgIds": [
              "MAT.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu niwena nawa akaakula nawu, Mwanta, ifukwinyi twakumweni nanzala, hela nampwila, hela nawenyi, hela nawuvu, hela nakukata, hela mukaleya, etu tubuli kukukalakela? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.44",
            "verseOrgIds": [
              "MAT.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu hakuyakula nindi, Nukuyileja chalala nami, chimwabulili kukalakela wumu wahadi awa akehelamu, mwabulili kukalakelami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.45",
            "verseOrgIds": [
              "MAT.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenawa akaya kwawu mukubabesha kwahaya nyaka; aloŋa akaya muwumi wahaya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
      ]
    }
