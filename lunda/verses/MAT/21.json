  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "MAT 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanaswiluwu kwakwihi naYerusalema, anashiki dehi kuBetefwaji, kumpidi yaOliveta, Yesu hakutemesha atumbanji ayedi, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Yenu mumukala wudi kumbidi wuna, chimukushika mukuwana chimbulu anamukasi, wudi namwanindi; mwakamusubuli, mwakanleteluwu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi hadi muntu wukuyihoshahu, mukwila nenu, Mwanta diyi nayikeŋi; wukuyitemesha hohenohu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chumochu chalondeli kulumbulula mwahosheliyi kaprofwetu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Mulejenu mwana kaZiyona wamumbanda nenu, Tala, Mwanta weyi hakwinza kudeyi, wadizoza, wudi nakwendela hachimbulu nihamwana kachimbulu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.5",
            "verseOrgIds": [
              "MAT.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbanji hiyakwila mwayilejeliyi Yesu; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.6",
            "verseOrgIds": [
              "MAT.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiyakuleta chimbulu nimwanindi, hiyakunona mahinawu, hiyakushahu; yena hakukandamahu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.7",
            "verseOrgIds": [
              "MAT.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amavulu amwizaza dawantu hiyakwala mahinawu munjila, amakwawu hiyakukunkula nyitayi kunyitondu hiyakwala munjila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.8",
            "verseOrgIds": [
              "MAT.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza atwamininuku, nialondelelaŋa munyima hiyakubilela nawu, Hozana, mwana kaDavidi! Kisu kisu iwu wukwinza mwijina daYehova! Hozana mwiwulu dakubadika! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.9",
            "verseOrgIds": [
              "MAT.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaneŋiliyi muYerusalema, ŋanda yejima yivwakuka niipumba nawu, Yeniwu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.10",
            "verseOrgIds": [
              "MAT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mazaza nawu, Diyi kaprofwetu Yesu wakuNazareta wamuŊaliliya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakwijila mutembeli yaNzambi, hakutemunamu ejima alandishilaŋa nialandililaŋa mutembeli, hakuhinona jimesa jawakwakuhimpa mali, nimatanda wadiŋi nakulandisha tutela. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila nindi, Anasoneki nawu, Itala dami akaditena nawu itala dakulombela, hakwinza enu munadibalumuni dehi kwikala iyeŋu dawamakombi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.13",
            "verseOrgIds": [
              "MAT.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amputamesu niayifwayi hiyakwinza kudi yena mutembeli, hakuyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi jawatupristu niansoneki chanamonuwu yuma yakuhayama yeliliyi, nianyana akubilela mutembeli nawu, Hozana, mwana kaDavidi; hiyakutiya kutama nankashi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, Eyi wunatiyi chakuhoshawu? Yesu hakwakula nindi, Eŋa; ochu cheliluwu nawu, Wunawanishi kuhameka kwakufuma namutunwa twawanyikeki, nitwawakwakwamwa; kanda muchitaŋuhu dehuku? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.16",
            "verseOrgIds": [
              "MAT.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyishiya, hakufuma muYerusalema, hakuya nakukama kuBetani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.17",
            "verseOrgIds": [
              "MAT.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi nakufuntayi kuŋanda nabudidi, hakutiya nzala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.18",
            "verseOrgIds": [
              "MAT.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumona mutondu wachikuyu kumbadi yanjila, hakuyaku, kuwanaku chuma nehi, kwamafu hohu. Hakuwuhosha nindi, Kunyaka yejima bayi wakasoŋa, cheŋi nyikabuku. Hohenohu mutondu wachikuyu wúuma nichau. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.19",
            "verseOrgIds": [
              "MAT.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumbanji chanachimonuwu hiyakuhayama nawu, Iwu mutondu o, chiwunanyakali kuuma! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Nukuyileja chalala nami, neyi mukweti kukuhwelela kwakadi kutadika, himukwila ichi chaneluwu mutondu wachikuyu hohuku; hela kwila mpidiyi nenu, Tutulukaku, natikaku mwijiya; chikwila. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.21",
            "verseOrgIds": [
              "MAT.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejima yimukulomba nakukuhwelela mukuyitambula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.22",
            "verseOrgIds": [
              "MAT.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanepiliyi mutembeli, awakulumpi jawatupristu niakulumpi jawantu hiyakwinza kudi yena hadiŋi nakulejayi antu nawu, Eyi welaŋa yumiyi nawantanyi? Indi nakwinki wanta wakwila yumiyi hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.23",
            "verseOrgIds": [
              "MAT.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyakula nindi, Ninami nawa nukuyihula kadizu kamu; neyi mukuŋakula, ami nawa nukuyileja wanta wunelaŋa nachu yumiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.24",
            "verseOrgIds": [
              "MAT.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami, chiŋa patishu chaYowanu chafumini kudihi? Chakwiwulu, tahindi chakudi antu? Hiyakudihujola muntu namukwawu nawu, Neyi tukwila netu chakwiwulu, wukutwila nindi, Indi dinu mwalekelelidi kumwitiya? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza neyi tukwila netu chakudi antu, chi kweti woma wezaza dawantu, muloŋa antu ejima elaŋa nawu Yowanu hikaprofwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwakula Yesu nawu, Kwiji, etu kwiluka nehi. Niyena hakuyila nindi, Ninami nawa hinukuyileja wanta wunelaŋa nachu yumiyuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.27",
            "verseOrgIds": [
              "MAT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi enu munatoŋojokidi? Muntu wumu wadiŋi nawanyanindi amayala ayedi. Hakwinza kudi wakusambila nindi, Mwanami, yaku nakukalakala mwitempa danyivinyu lelu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.28",
            "verseOrgIds": [
              "MAT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena nindi, Kwonti kwami. Kutwala muna hakubalumuka hakuya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.29",
            "verseOrgIds": [
              "MAT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza kudi wamuchiyedi, hakumwila mwomumu. Yena hakumwakula nindi, Nukuya mwanta. Ilaŋa kuya nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.30",
            "verseOrgIds": [
              "MAT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awa ayedi, welili muchima watata yawu wumwodihi? Nawu, Wakusambila. Yesu hakuyila nindi, Nukuyileja chalala nami, ansonkeshi nawayivumbi akwijila ŋahu dehi muwanta waNzambi, enu mukushalahu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.31",
            "verseOrgIds": [
              "MAT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Yowanu wenjili kudenu munjila yakuloŋa, enu himwamwitiyiluku, ilaŋa ansonkeshi nawayivumbi amwitiyili; enu chimwachimweni, kubalumuka munyichima yenu mumwitiyi nehi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.32",
            "verseOrgIds": [
              "MAT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu chishimu chikwawu nawa. Kwadiŋi mwini itala wumu wadimini itempa danyivinyu, hakukolekaku ikoli, hakupunda mwakukamwina vinyu, hakutuŋa itala dakola, hakudishila akwakudima, hakuya kwituŋa dacheŋi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakeŋeli kushika chilaaka chanyikabu, hakutemesha anduŋu jindi kudi akwakudima nindi akamutambwili nyikabu yindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.34",
            "verseOrgIds": [
              "MAT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwakudima hiyakukwata anduŋu jindi, wumu hiyakumweta, mukwawu hiyakumujaha, mukwawu hiyakumwasa malola. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.35",
            "verseOrgIds": [
              "MAT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutemeshaku cheŋi nawa anduŋu amakwawu asweja kuvula, akusambila antesha, hiyakuyikoŋa mwomumu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.36",
            "verseOrgIds": [
              "MAT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa nkumininaku hakuyitemeshela mwanindi, nindi, Akamwakama mwanami. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.37",
            "verseOrgIds": [
              "MAT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa owu akwakudima chanamonuwu mwanindi, hiyakuhosha muntu namukwawu nawu, Iwu diyi nswana; tumujahenu, tutambuli wuswana windi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.38",
            "verseOrgIds": [
              "MAT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumukwata, hiyakumunatila hanzi yetempa danyivinyu, amujaha nikumujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.39",
            "verseOrgIds": [
              "MAT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi chakenzayi owu mukwetempa danyivinyu, wakayila ŋahi owu akwakudima? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.40",
            "verseOrgIds": [
              "MAT.21.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwila nawu, Owu antu atama wakayijilumuna chakadi luwi, itempa danyivinyu wakadishila akwakudima acheŋi akamwinkaŋa nyikabu yindi hayilaaka yayu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 21:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.41",
            "verseOrgIds": [
              "MAT.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 21:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu hakuyila nindi, Chasonekawu munyikanda yajila nawu, Ilola dalekeli antuŋi dodelisliiluwu namutu wewombu; ichi chafumini kudi Yehova, chakuhayama kumesu etu; kanda mutaŋaŋahu dehi, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.42",
            "verseOrgIds": [
              "MAT.21.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi nukuyileja nami, wanta waNzambi akayamukawu, akawinka muza wakasoŋaŋa nyikabu yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.43",
            "verseOrgIds": [
              "MAT.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wukuholokela helolidi wukukotoka kotu kotu; hakwila muntu akaholokelawu kudi ilolidi dakamufukumuna neyi lunkupu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.44",
            "verseOrgIds": [
              "MAT.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi jawatupristu niaFwarisi, chanatiyuwu yishimu yindi eluka nikwiluka nawu nateni etu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
            "verseOrgIds": [
              "MAT.21.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 21:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakeŋeluwu kumukwata, atiyili woma wamazaza awantu, muloŋa antu elilaŋa nawu hikaprofwetu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.46",
            "verseOrgIds": [
              "MAT.21.46"
            ]
          }
        }
      ]
    }
  ],
