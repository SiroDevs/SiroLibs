      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.31",
            "verseOrgIds": [
              "MAT.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi kwatilenu maana kumutondu wachikuyu. Chiwelaŋa neyi mutayi wawu wunovwahi dehi, hiwukusapuka mafu awu, himukwiluka nenu mayinza adi kwakwihi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.32",
            "verseOrgIds": [
              "MAT.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ninenu nawa chimwakamona yuma yejimiyi, kelukenu nenu yena wudi kwakwihi, kwokuyisu kachi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.33",
            "verseOrgIds": [
              "MAT.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja chalala nami chisakichi hichakahitaku, chiŋa yuma yejimiyi yinamani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.34",
            "verseOrgIds": [
              "MAT.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwulu neseki amba kahita, mazu ami hiyamba kahitaku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.35",
            "verseOrgIds": [
              "MAT.24.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 24:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa itaŋwodu hela mpinji oyu hosi wayilukaku, hela aŋelu amwiwulu, chiŋa Tata hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.36",
            "verseOrgIds": [
              "MAT.24.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 24:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chadiŋi hamafuku aNowa, dichi chakela nihakenzayi Mwana kamuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.37",
            "verseOrgIds": [
              "MAT.24.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 24:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa chakela neyi mafuku adiŋi akuleta kudibaji, adiilaŋa, anwinaŋa, asumbwilaŋa, asumbwishilaŋa, nikwifuku depililiyi Nowa muwatu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.38",
            "verseOrgIds": [
              "MAT.24.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 24:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "nichichenjili dibaji nakuyikumpula wejima wawu, wena kuchiluka nehi; dichi chakela nihakenzayi Mwana kamuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.39",
            "verseOrgIds": [
              "MAT.24.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 24:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henohu amayala ayedi akekala mwiha, wumu akamutwala, mukwawu wakashala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.40",
            "verseOrgIds": [
              "MAT.24.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 24:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambanda ayedi akekala kwiyanda, wumu akamutwala, mukwawu wakashala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.41",
            "verseOrgIds": [
              "MAT.24.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 24:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi tonenu, muloŋa himuneluki ifuku dakenzayi Mwanta wenuku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.42",
            "verseOrgIds": [
              "MAT.24.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 24:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuminenu dakwiluka nenu neyi mwini itala welukili chilu chikwinza ikombi, mutenowu watoneni, hadi kwiteja kumupundila itala dinduku. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.43",
            "verseOrgIds": [
              "MAT.24.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MAT 24:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi ninenu nawa babalenu, muloŋa mpinji yimukubula kutoŋojoka diyi yakenzayi Mwana kamuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.44",
            "verseOrgIds": [
              "MAT.24.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MAT 24:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indi nduŋu washinshika wukweti maana, anenkuwu kudi nkaka yindi mudimu wakuhemba mukala windi, akenkaŋa akwetala dindi yakudya yawu hayinkelaŋawu hayinkelaŋawu, hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.45",
            "verseOrgIds": [
              "MAT.24.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MAT 24:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu nduŋu akawanawu nakwila mwenomu hakenzayi mwanta windi, diyi wakakooleka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.46",
            "verseOrgIds": [
              "MAT.24.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MAT 24:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukuyileja chalala nami wakamwinka mudimu wakuhemba yuma yindi yahetayi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.47",
            "verseOrgIds": [
              "MAT.24.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "MAT 24:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaŋa neyi kudi nduŋu watama wakela mumuchima windi nindi nkakayami hakulaba, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.48",
            "verseOrgIds": [
              "MAT.24.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "MAT 24:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "hakutachika kweta akwawu anduŋu nindi, hakudya nakunwa nawakwakusheta; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.49",
            "verseOrgIds": [
              "MAT.24.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "MAT 24:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkaka yayenowu nduŋu hakwinza hefukudá kubula kutalilayi, nihampinji yákubula kwilukayi; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.50",
            "verseOrgIds": [
              "MAT.24.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "MAT 24:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "wakamuvupolachacheni, wakamusha kwijiku dawanfwikiji akadyaloŋa nawu; kwakekala kutumpa nikudisumona kumaji.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.24.51",
            "verseOrgIds": [
              "MAT.24.51"
            ]
          }
        }
      ]
    }
