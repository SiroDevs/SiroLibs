          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu aEtiyopiya nawa, akayijaha nampoku yami yakabali. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.12",
            "verseOrgIds": [
              "ZEP.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEP 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakayolwela akwakabeta kakuchimunswa chikasa chindi nawa, wakakisaŋana Ashuri, niNineve wakamubalumuna kwikala mahembi, kwominina chau neyi isaŋa dakadi meji. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.13",
            "verseOrgIds": [
              "ZEP.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEP 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikanka yawayimuna yakakamujokaŋa mukachi kindi, ninyitundu yawanyama amumpata ejima. Ikubi nakansaka akakamaŋa hewulu dayipamba yamatalawu. Chikuŋulu wakahoshaŋa mujinjanina hu-hu. Ikololu wakahoshaŋa muyisu ka-a ka-a. Muloŋa mapalanga anyisida akusoŋa nashali dehi hatooka. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.14",
            "verseOrgIds": [
              "ZEP.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEP 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weniwu diwu mukala wadiŋi wazaŋajala, washakaminaŋa nakudiwujola, welilaŋa mumuchima windi nindi, Yami hanu, hikudi wacheŋuku. O chiwabalumuka dehi mahembi, kwakukamujokaŋa anyama! Antu ejima akahitaŋaku akamuyiŋila, akazwiyazwiya makasa nawu, Ehe-e!",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.15",
            "verseOrgIds": [
              "ZEP.2.15"
            ]
          }
        }
      ]
    }
