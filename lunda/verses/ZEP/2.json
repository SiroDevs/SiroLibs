          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa Gaza akamushiya kanka windi; niAshekeloni wakekala chihembi; antu amuAshidodi akayitemunamu hakachi kamwaana; Ekeroni akamubwita.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.4",
            "verseOrgIds": [
              "ZEP.2.4"
            ]
          }
        }
      ]
    },
    {
