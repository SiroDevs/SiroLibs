          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "hachidi kanda ayihaŋi neyi muzuŋu wukuleluka, nikuzuwa kwaYehova kwasweja kanda kuyiwani, niifuku dandombu yaYehova dichidi kanda diyiwani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        }
