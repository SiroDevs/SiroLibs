            "number": "46",
            "style": "v",
            "sid": "DAN 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Nebukaneza wadumbili chamesu indi heseki nakudifukula kudi Danyeli, hakuleja antu nindi, Mulambulenu Danyeli himulambu, mumwipukishi mavumba amawahi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.46",
            "verseOrgIds": [
              "DAN.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DAN 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wamwilili Danyeli nindi, Chalala Nzambi yeyi diyi Nzambi yawanzambi, diyi mukulumpi wawanyanta, diyi wamwekeshaŋa yayuma yajindewa, muloŋa eyi wunatweshi kumwekesha chumichi chadiŋi chakujinda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.47",
            "verseOrgIds": [
              "DAN.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DAN 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi mwanta wamutohesheli Danyeli, wamwinkeli yamukunkulu yayivulu yalema, wamwinkeli niwanta wakuyulaŋa wuloŋu waBabiloni wejima, akekali nguvulu wamukulumpi wakuyulaŋa akwamaana amuBabiloni ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.48",
            "verseOrgIds": [
              "DAN.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DAN 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danyeli walombeli kudi mwanta, yena hakuyinka aShadaraki, naMeshaki, naAbedinego nyidimu yakutala nsaŋu jamuwuloŋu waBabiloni. Hakwila Danyeli washakamini kuchota chamwanta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.49",
            "verseOrgIds": [
              "DAN.2.49"
            ]
          }
        }
