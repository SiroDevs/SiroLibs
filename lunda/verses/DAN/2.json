            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi mwanta, eyi yeyi mwanta wawanyanta, Nzambi wamwiwulu nakwinki niwanta, niŋovu, nikukola, nimpuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwejima kwashakamawu antu nakwinki dehi nianyama amwisaŋa, niatujila ahaluzwizu; nakwili dehi hiwumwanta wawu wejima wawu. Yeyi namutu wawuru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadeyi hamba kalondela wanta wacheŋi wakuminamu, wákubula kweseka nawanta weyi; niwanta wukwawu wamuchisatu wawuneŋu, wakayula mpata yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wanta wamuchiwana wakekala wakola neyi chikuŋu; chahumunaŋa chikuŋu nakufwomona yuma yejima, chachikaŋa chikuŋu yuma yejimiyi, dichi chakela niwantowu, wakahumunaŋa nakuchika choche nochu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        }
      ]
    },
    {
