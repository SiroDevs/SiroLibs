      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwaka wakusambila wamwana kaAhasuwenausi Dariyusa, wakumuchidi wawaMediya, diyi Dariyusa adiishiluwu wanta wamwituŋa dawaKaladeya; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumwaka wayuliliyi wakusambila, ami Danyeli nashinshikili kunyikanda mwachindiluwu nyaka yateneni izu daYehova denjili kudi kaprofwetu Yeremiya, yakuwanisha nachu mahembi akuYerusalema yonyaka makumi atanu nayedi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukutalisha mesu ami kudi Mwanta Yehova, nimukeŋakeŋi nakulomba, nakulembelela, nakuleka kudya, nayikeleyi, namawuti. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukulomba kudi Yehova Nzambi yami, hinukudibayisha nami, Eyi Mwanta, eyi Nzambi muneni wakutiya woma, wahembaŋa chitiyaŋenu naluwi nanawa amukeŋa, ahembaŋa nshimbi jindi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tunavulumuni, tunaluwi, tunakoŋi chatama, tunadikani, tunasenuki nimuwalejaŋa nimuwuŋaji. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitunatiyilili ambuneyi atuprofwetu ahoshelana mwijina deyi, alejelaŋa anyanta jetu, niatulamba twetu, niankakulula jetu, niantu ejima amwituŋaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Mwanta, kuloŋa kwambala kweyeyi, hakwila etu kwetu kwansonyi hohu kumesu, neyi chitunamoni lelu, niaYuda, niashakama muYerusalema, niaIsarela ejima adi kwakwihi niadi kwakulehi, adi mwahita matuŋa ejima muwayihaŋahaŋila dehi nakumotoka kwamotokawu dehi nshimbi jeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyi Mwanta, nsonyi jinatukwati kumesu, nianyanta jetu, niatulamba twetu, niankakulula jetu, muloŋa tunakuvulumuni dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Nzambi yetu diyi wukweti luwi nŋakwanakena, hela tunadikaninindi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hitunovwahili izu daYehova Nzambi yetu, twendi munshimbijindi janatushiliyi kumesu etu kutunwa twawambuŋindi atuprofwetuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala, aIsarela ejima anamotoki dehi nshimbi jeyi, anasenuki dehi hambadi, kulonda abuli kwovwahila izu deyi. Dihu hanafumi kutwichilaishiŋu nikusanyika kwasonekeluwu munshimbi jakambuŋa Nzambi Mosi; muloŋa tunakuvulumuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakoleshi dehi mazu indi atuhosheliyi, etunawanyuli jetu atuyulilaŋa, nakutama kweneni kwanatuleteliyi. Muloŋa mwishina dewulu dejima kukoŋahu chuma chanakoŋuwu Yerusalema nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutama kwejimiku kunatuwani dehi neyi chanasonekuwu munshimbi jaMosi. Hela chochu, hitunalembi kudi Yehova Nzambi yetu netu tumoni wuselewa windi, kulonda tubalumuki tuleki kuluwaluwa kwetu, tushinshiki mwaya nsaŋu yeyi yalalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dihu hanafumi kututala kudi Yehova kutala kwakutuletela vatama; muloŋa Yehova Nzambi yetu waloŋa kunyidimu yindi yejima yakoŋaŋayi; hakwila etu hitunovwahili izu dinduku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku nichidi kuhosha, nakulomba, nakudibayisha nanshidi yami, ninshidi yamuza wetu aIsarela, anamutuukishi kulembelela kwami kumesu aYehova Nzambi yami, hansaŋu yampidi yaNzambi yami yajila; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwalala, iku nidi nakuhosha mukulomba, owu iyala Gabireli namweni hakusambila muchimwenu ochu, anamutuukishi dehi lufuchi, hakunkunka kwakwihi nampinji yahimulambu wamelela. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunlumbulwila, hakuhanjika nanami nindi, Eyi Danyeli, ami nediki dehi dinu, nenzi nakukwinka wukalawenu wakwiluka mwaya yuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiwatachikili kulembelela kwedikili izu, ami hinukwinza nakukuleja, muloŋa eyi wasweja kukeŋewa. Dichi toŋojokaku chachiwahi iyi nsaŋu, wushinshiki mwaya ochu chimwenu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamuza wenu nihamukala wenu wajila ashahu dehi lushimbi lwanyilungu makumi atanu nayedi, kulonda kumanisha muloŋa wakumotoka nshimbi, kulonda kukumisha nshidi, kulonda kubuta kuluwa, kulonda kuletamu kuloŋa kwahaya nyaka, kulonda kulamika chimwenu nawupro-fwetu nachilamiki, kulonda kuwayisha wasweja kujila manji. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilukaku Lulufu; wushinshiki neyi, kufumisha hakwidika izu dakuloŋesha nakutuŋiulula Yerusalema, nakushikija kudi yena awayishawu dehi manji, yowu Kalamba, kwakekala nyilungu yitanu nayiyedi; ninyilungu makumi atanu nadimu nanyilungu yiyedi, akawutuŋulula cheŋi nimukwakwa, nimpwembu, m akuri, munyaka yakwakama. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwakahita nyilungu oyu makumi atanu nadimu nanyilungu yiyedi, awayishawu dehi manji akamufumishamu, Makulona hakekala nachumaku. Antu akalamba wakenza akakisaŋana nimukala nimalala; kukumisha kwachu kwakekala nadibaji, hakekala njita ndo nikukukuminina; mahembi ayifuukula dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena wakatiyaloŋana chitiyaŋenu chakola nawantu amavulu mulungu wumu; hakachi kamulungu owu wakalekesha nikuketula chimuna nihimulambu; halupuula lwayishi-mashima hakenza wumu waleteshaŋa mahembi, ndo nihakechilawu hadi mukwakuletesha mahembi kumanisha kwafuukulawu dehi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.27",
            "verseOrgIds": [
              "DAN.9.27"
            ]
          }
        }
      ]
    }
  ],
