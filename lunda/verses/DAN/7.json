            "style": "v",
            "sid": "DAN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenimu dimu munakumini nsaŋu. Hakwila ami Danyeli, vitoŋojoka yami yaloŋakamishili nankashi, kumesu ami kubalumuka nikubalumuka. Ilaŋa nsaŋu oyu nayihembeli kumuchima wami.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
          }
        }
      ]
    }
