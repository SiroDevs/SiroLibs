    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Nebukaneza welili nkishi yawuru, chiminu chayu munkotweli jamakasa makumi atanu nadimu, mukutoha kwayu munkotwelŋamakasa jitanu nayimu. Wayiimikili muchana chaDura muwuloŋu waBabiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.1",
            "verseOrgIds": [
              "DAN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Nebukaneza watemesheli antu nakupompesha ayilolu, niatulala, nianguvulu, niakwakuhosha nyiloŋa, niakwakukuŋa nyilambu, niakulumpi amuyota, niatupita, niayulilaŋa mawuloŋu, kulonda akenzi akajiliki mukishi wemikiliyi mwanta Nebukaneza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.2",
            "verseOrgIds": [
              "DAN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nochu ayilolu, niatulala, nianguvulu, niakwakuhosha nyiloŋa, niakwakukuŋa nyilambu, niakulumpi amuyota, niatupita, niayulilaŋa mawuloŋu ejima, apompeli kulonda kujilika mukishi wemikiliyi mwanta Nebukaneza. Emeni kumesu amukishi wemikiliyi Nebukaneza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.3",
            "verseOrgIds": [
              "DAN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwakubidika nsaŋu wabidikili naŋovu, nindi, Enu antu amwacheŋi namwacheŋi, enu nyuza yawantu, enu akwamadimi eŋi na eŋi, anayileji, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.4",
            "verseOrgIds": [
              "DAN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nawu, Chimukutiya hiyakwimba jimpùŋa, nimapeleli, nitudada, nindimba, niyisanji, nimpanda, niyuma yakwimba yacheŋi nayacheŋi, mwakadinata hamaseki nakudifukula kudi mukishi wawuru wanemikiyi mwanta Nebukaneza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.5",
            "verseOrgIds": [
              "DAN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowu wakabula kudi nata hamaseki nakudifukula, yoyena mpinji oyu akamúumbila mukachi kaluteŋi ludi nakubidima kesi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.6",
            "verseOrgIds": [
              "DAN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu henohu owu antu amwacheŋi namwacheŋi ejima, chatiyiluwu hiyakwimba ŋŋimpùŋa, nimapeleli, nitudada, nindimba, niyisanji, niyuma yakwimba yacheŋi nayacheŋi, wenowu antu amwacheŋi namwacheŋi ejima, ninyuza yawantu, niakwamadimi eŋi na eŋi, hiyakudinata hamaseki nakudifukula kudi mukishi wawuru wemikiliyi mwanta Nebukaneza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.7",
            "verseOrgIds": [
              "DAN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi henohu aKaladeya amakwawu aswilili kwakwihi nakuyinka aYudeya muloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.8",
            "verseOrgIds": [
              "DAN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahosheli namwanta Nebukaneza nawu, Kalombu mwanta; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.9",
            "verseOrgIds": [
              "DAN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyi mwanta wunenkumu lushimbi lwakwila neyi antu ejima chiyakutiyawu jimpùŋa, nimapeleli, nitudada, nindimba, niyisanji, nimpanda, niyuma yakwimba yacheŋi nayacheŋi, akadinata hamaseki nakudifukula kudi mukishi wawuru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.10",
            "verseOrgIds": [
              "DAN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakabula kudi nata hamaseki nakudifukula, akamúumbila mukachi kaluteŋi ludi nakubidima kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.11",
            "verseOrgIds": [
              "DAN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudi aYudeya amakwawu wunakunjiki kumudimu wakutala nsaŋu jamuwuloŋu waBabiloni, wowu aShadaraki, naMeshaki, naAbedinego, wenowu antu kwawu, eyi mwanta, hiyanakushi kumuchimaku. Wena hiyapeshaŋa akishi eyuku, hiyadifukulaŋa kudi mukishi wawuru wunemikuku.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.12",
            "verseOrgIds": [
              "DAN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukaneza hakuzuwa, hakulendumuka, hakuyila nindi, Kaletenu aShadaraki, naMeshaki, naAbedinego. Nochu ayileteli wenowu amayala kudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.13",
            "verseOrgIds": [
              "DAN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukaneza hakuhosha nawena, nindi, Indi enu aShadaraki, naMeshaki, naAbedinego, chimwabulaŋa kupesha mukishi wami, hela kudifukula kudi mukishi wami wawuru wunemiki nehi, munatoŋojoki ŋahi? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.14",
            "verseOrgIds": [
              "DAN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu chimukutiya jimpùŋa, nimapeleli, nitudada, nindimba, niyisanji, nimpanda, niyuma yakwimba yacheŋi nayacheŋi, neyi munatweshi kudi nata hamaseki nakudifukula kudi mukishi wami wuneli, chachiwahi. Neyi kudifukula nehi, akuyumbila mukachi kaluteŋi ludi nakubidima kesi, mpinji yoyenoyu hohu, indi Nzambinyi wukuyipulwisha kudami? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.15",
            "verseOrgIds": [
              "DAN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AShadaraki, naMeshaki, naAbedinego amwakwili mwanta nawu, Eyi Nebukaneza, hitukukaba nakukwakula chumichuku. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.16",
            "verseOrgIds": [
              "DAN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela chochu, Nzambi yetu twakalakelaŋa natweshi kutupulwisha muluteŋi ludi nakubidima kesi, ninodu wukutupulwisha kudeyi, eyi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.17",
            "verseOrgIds": [
              "DAN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hela neyi nehi, ilukaku chachiwahi, eyi mwanta, etu kwetu kwonti kwetu kupesha akishi eyi, hela kudifukula kudi mukishi weyi wawuru wuwunemiki.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.18",
            "verseOrgIds": [
              "DAN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukaneza hakusweja kulendumuka nankashi, hakuzuwa nankashi, kumesu kwabalumukili neyi kwacheŋi hohu nawaShadaraki, naMeshaki, naAbedinego. Hakuhosha, hakuleja antu, nindi, Kazakasenu luteŋi mapampa katanu nakayedi, kakubadika muna muyaluzakasilaŋawu dikalu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.19",
            "verseOrgIds": [
              "DAN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuleja amayala amakwawu amunjita yindi asweja Ŋovu, nindi, Yikasenu aShadaraki, naMeshaki, naAbedinego, muyumbili muluteŋi ludi nakubidima kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.20",
            "verseOrgIds": [
              "DAN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wenowu amayala ayikasili iku saŋa avwelelawu niyikovwelu yawu, nimahinawu, niyuma yawu yakuvwala yi kwawu, ayumbilili mukachi kaluteŋi ludi nakubidima kesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.21",
            "verseOrgIds": [
              "DAN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanochu chayihindishiliyi mwanta, nichaswejeli luteŋi kutata, nyizuzu yakesi yajahili owu amayala asendeli aShadaraki, naMeshaki, naAbedinego. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.22",
            "verseOrgIds": [
              "DAN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila awa amayala asatu aShadaraki, naMeshaki, naAbedinego aholokeli mukachi kaluteŋi ludi nakubidima kesi, iku saŋa ayikasilawu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.23",
            "verseOrgIds": [
              "DAN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Nebukaneza hakuhayama, hakunyamuka swayi swayi hohu, hakuhosha nakuyiihula antu indi awakulumpi amuchota, nindi, Etu hitwanata amayala asatu akukasa dehi mukachi kakesuku? Wena amwakwili mwanta nawu, Chalala mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.24",
            "verseOrgIds": [
              "DAN.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakuyila nindi, Talenu, ami namoni amayala awana akadi kukasa adi nakwenda mukachi kakesi, hiyanamoni chuma chakuyikatishaku, wamuchiwana wudi neyi mwana kaNzambi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
