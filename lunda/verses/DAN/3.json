          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niayilolu, niatulala, nianguvulu, niakulumpi amuchota chamwanta, apompeli, amweni awa amayala, komana kesi hikadiŋi naŋovu yakuyila nyijimba yawu chatamaku, kwosi hela kalusuki kakunyitu yawu kababikiluku, hela yi kovwelu yawu hiyabalumukiluku, nikadivumba kakesi kanunkiluwu kwosi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.27",
            "verseOrgIds": [
              "DAN.3.27"
            ]
          }
        }
