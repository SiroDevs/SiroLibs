    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muchikasa chachidiilu chayena washakama hetanda dawanta hinukumona mukanda, awusoneka nimukachi nihewulu, awulamika ehacheni nayilamiki yitanu nayiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukumona kaŋelu waŋovu hakubidika nezu datiyakana nindi, Nateli kubakula mukandowu nakulamona yilamiki yawu hinyi? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwiwulu nihamaseki nimwishina damaseki himwadiŋi watwesheli hela kubakula mukandowu, hela kuwutalaku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami hinukudila chacheni chikunabuli kumwekana muntu watela kubakula mukandowu hela kuwutala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukulumpi wumu hakuŋila nindi, Bavi wudilaku; tala, Mutuŋa wakumuchidi waYuda, Muji waDavidi, nemiki mushindu wakubakula mukanda nakulamona yilamiki yawu yitanu nayiyedi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukumona mukachi ketanda nimukachi kawamomi awana nimukachi kawawakulumpi, munemani Kana kamukoku kadi neyi anakŋahi dehi, kakweti nseŋu jitanu najiyedi, nimesu atanu nayedi, diwu aspiritu aNzambi atanu nayedi anatemeshuwu mwahita iseki dejima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza nakuwutambula kuchikasa chachidiilu chayenowu wadiŋi washakama hetanda dawanta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chanatambuliyi mukandowu, awa amomi awana ninawa awakulumpi makumi ayedi nawana, hiyakudinata chamesu heseki kunyendu yaKana kamukoku. Wejima wawu akweti tudada niyeŋa yawuru yakunama yenzala insensi, yowu kulomba kwawakwakujila. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwimba kamina kakaha nawu, Wunateli kutambula mukanda nakulamona yilamiki yawu; muŋa akujahili, wunamukuuli li Nzambi antu akunyichidi yejima, akumadimi ejima, akumatuŋa ejima, akunyuza yejima, namashi eyi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anekali dehi wanta waNzambi niatupristu; hiyakuyula hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinukwila nikumona nikutiya izu dawaŋelu amavulu anyepumuka itanda dawanta niamomi niakulumpi; kuyichinda makombakaji ikumi mapampa makombakaji ikumi, nimakombakaji amakombakaji. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakwila nezu datiyakana nawu, Kana kamukoku kajahilewi nateli kutambula Ŋovu, nimaneta, nima ana, niwudumi, nimpuhu, ni kulema, ninkisu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yejima yaleŋeluwu yekala mwiwulu nihamaseki nimwishina damaseki nihakaluŋalwiji, niyuma yejima yidumu, hinukuyitiya nakwila nawu, Ninkisu, nimpuhu, ni kulema, niwanta, yiikali yawashakama hetanda dawanta, niyaKana kamukoku, haya nyaka nanyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niamomi awana hiyakwila nawu, Amena. Niawakulumpi hiyakudinata heseki nakudifukula.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
              "REV.5.14"
            ]
          }
        }
      ]
    }
  ],
