            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu mukwawu nawa hakwidika mutembeli yekala mwiwulu, niyena nawa wudi nachikwakwa chatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu mukwawu nawa hakufuma kukameŋa, wukweti Ŋovu nakesi; hakutambika owu wukweti chikwakwa chatwa nezu datiyakana nindi, Shaku chikwakwa cheyi chatwa, wukuŋuli nyikanji yamawundu amuvinyu waheseki; muloŋa mawundu awu asweja dehi kuha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.18",
            "verseOrgIds": [
              "REV.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaŋelu hakuzwiyazwiya chikwakwa chindi omu mwishina, hakukuŋula mawundu amuvinyu waheseki, hakunatila muwukamwinu, wowu wukamwinu weneni wandombu yaNzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.19",
            "verseOrgIds": [
              "REV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wukamwinu wavinyu hiyakuwudatila kunsembwa yaloŋanda; muwukamwinu himukufuma mashi ashika nikuyikuŋu yakwendesha nachu atuwalu, kuleha neyi makilometa makulakaji asatu namakumi ayedi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.20",
            "verseOrgIds": [
              "REV.14.20"
            ]
          }
        }
      ]
    }
