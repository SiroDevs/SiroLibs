    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiwulu himukumwekana chinjikijilu cheneni; mudi mumbanda wavwala itaŋwa, mwishina danyendu yindi mudi kakweji, kunamutu windi kudi chibaaba chatutumbwa ikumi natuyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.1",
            "verseOrgIds": [
              "REV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wudi nevumu, 1, 260 hakukaloka nyiteti, hakufunyisha, hakukata nyisoŋu yakuvwala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.2",
            "verseOrgIds": [
              "REV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiwulu mumwekana nichinjikijilu chikwawu. Nami nitali, hinukumona chazaŋombi muneni wuchinana, wukweti nyitu yitanu nayiyedi ninseŋu ikumi; kunyitu yindi kudi yibaŋula yitanu nayiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.3",
            "verseOrgIds": [
              "REV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukila windi hiwukukoka chibalu chatutumbwa twamwiwulu chamuchisatu, hakutunatila heseki. Chazaŋombi hakwimana kwakwihi namumbanda wudi hanchiŋa, kulonda chakuvwalayi adiyi mwanindi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.4",
            "verseOrgIds": [
              "REV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuvwala mwana, himwana weyala, diyi wamba kayula nyuza yejima nambwechi yachikuŋu. Hiyakuhukwila mwanindi kwadiyi Nzambi nikwitanda dindi dawanta. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.5",
            "verseOrgIds": [
              "REV.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumbanda hakutemukila mwisaŋa mwamuloŋeshelawu dehi kudi Nzambi, kulonda amudiishilumu ikombakaji damafuku namafuku makulakaji ayedi namakumi atanu nekumi dimu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.6",
            "verseOrgIds": [
              "REV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiwulu himukwila njita; Mikeli nawaŋelu jindi hiyakwasa njita nanowu chazaŋombi; chazaŋombi niyena nawaŋelu jindi nawa hiyakwasa; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwimika mushindu nehi; mwiwulu himwamwekeni nawa cheŋi mwakushakama wenaku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu chazaŋombi muneni hiyakumunatila heseki; yowu kapela mukulu atenaŋawu nawu Diyabolu, diyi Satana, wadimbaŋa antu ampata yamunu mwishina ejima. Yena hiyakumunatila hamaseki, niaŋelu jindi hiyakuyinatila hamu nayena. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitiya niizu datiyakana mwiwulu nindi, Ichi dinu wamwinu niŋovu niwanta waNzambi yetu wunenzi dehi, nikuyula kwaKristu windi; muloŋa mukwakuyinka ana kwetu nyiloŋa anamunatili dehi heseki, yowu wayinkaŋa a nyiloŋa kumesu aNzambi yetu nimwaana niwufuku. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwimika mushindu namashi aKana kamukoku, namazu ashimwinuwu. Hiyakeŋeli wumi wawuku; nawu hela kufwa tukufwa tuhu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.11",
            "verseOrgIds": [
              "REV.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi enu mawulu, zaŋalalenu, ninenu mwashakamamu. O yihuŋu yakamona iseki nakaluŋalwiji! Muloŋa diyabolu nayisulukili, wudi nandombu yayeni, chanelukiyi nindi kunashali dehi mpinji yindi yantesha hohu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.12",
            "verseOrgIds": [
              "REV.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu chazaŋombi chanamoniyi anamunatili dehi heseki, hakukabisha mumbanda wavweli mwana weyala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumwinka mumbanda mpuula jambuulu muneni jiyedi, kulonda atúukili mwisaŋa mwamuloŋeshclawu dehi, mwakumudiishilawu mpinji yimu, ŋijimpinji, nimpinji yachiketu, kwákubula kumumonawu kudi kapela. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapela hakumupumbila mumbanda meji neyi kaloŋa, kulonda amuhuŋumuni nakaloŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
            "verseOrgIds": [
              "REV.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maseki hiyakukwasha mumbanda, hiyakwasama mukanwa kawu, aminya ni kaloŋa kanapumbiyi chazaŋombi mukanwa kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.16",
            "verseOrgIds": [
              "REV.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chazaŋombi hakuzuwa namumbanda, hakufumaku nindi aasi njita nawanyanindi anashali, awa achidi kuhemba mwanayilejuwu kudi Nzambi, achidi kukakela kushimuna nsaŋu yaYesu. Hakwimana hawusekulula wakukaluŋalwiji.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.17",
            "verseOrgIds": [
              "REV.12.17"
            ]
          }
        }
      ]
    }
  ],
