      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilenu ana kwenu nenu, Amimi; niahelenu nenu, Ruhama. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulembelelenu mama yenu, lembelelenu chacheni; muloŋa yena hiŋodamuku, ninami hininfumwinduku. Akafumishi mawuvumbi indi kumesu indi, nimawujila indi hakachi kamayeli indi; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.2",
            "verseOrgIds": [
              "HOS.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mukunkulwayi nakamuvúula akekali nzekesi, akekali neyi chadiŋiyi ifuku davwalikiliyi, nakamubalumuna ekali chinkalampata, ekali neyi mpata yawuma yakadi meji, nakamujaha nampwila; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.3",
            "verseOrgIds": [
              "HOS.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwalala, anyanindi hinakayitiyila luwi lwakuyanakenaku; muloŋa wena hiyanyana awuvumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.4",
            "verseOrgIds": [
              "HOS.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa mama yawu nakoŋa koŋi wuvumbi; wayimitili nakoŋi yansonyi; muloŋa yena nahoshi nindi, Nukuya nakulondela ami ankeŋa, anyinkaŋa kudya kwami nimeji ami, anyinkaŋa mavuji ami, niwanda wami nimanji ami, niyuma yinanwaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.5",
            "verseOrgIds": [
              "HOS.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tiya, kunjila yeyi nukukolekaku ikoli danyiŋa, nukunamutuŋila chipaka, kulonda akakaŋanyi kumona njila jindi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.6",
            "verseOrgIds": [
              "HOS.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakalonda indi amukeŋa, hakayiwanaku; wakayikeŋakeŋa, hakayimonaku; henohu wakahosha nindi, Niyi nifunti kudi nfumwami wakusambila, muloŋa nadiŋi nakumona kuwaha kubadika chinidi nakumona katataka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.7",
            "verseOrgIds": [
              "HOS.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa yena kwiluka nindi yami namwinkelaŋa tidiku navinyu nimanji, hela nindi yami namuvulishililaŋa siliva nawuru yapeshelaŋawu nachu Bayali, nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.8",
            "verseOrgIds": [
              "HOS.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi komana nakafumisha tidiku yami hachila aka chayu, nivinyu yami hachila aka chayu, nakafumisha mavuji ami anyikoku, niwanda wami wakeŋeli kuvwalayi hakekalayi nawuvu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.9",
            "verseOrgIds": [
              "HOS.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamwekesha wusonyi windi hatooka kumesu anowu amukeŋa, kwosi muntu wakamupulwisha kudamuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.10",
            "verseOrgIds": [
              "HOS.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuzaŋajala kwindi kwejima nakakukumisha, niyawija yindi yakushiika, nitukweji twindi tukwalukaŋa, nisabata jindi, niyipompelu yindi yalema yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.11",
            "verseOrgIds": [
              "HOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakisaŋana nyivinyu yindi, niyikuyu yindi yanateniyi nindi wowu wufwetu wami wananyinkuwu kudi ami ankeŋa. Nakayibalumuna kwikala isaŋa, akayidyaloŋa kudi anyama amumpata. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.12",
            "verseOrgIds": [
              "HOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Nakamubabesha nansaŋu yamafuku awaBayali ochelelaŋayi insensi; hadiŋi nakudileŋa leŋayi natuzeya twindi twakumatu, niyingelingeli yindi, hadiŋi nakulondelayi indi amukeŋeli, hanvulameneniyi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.13",
            "verseOrgIds": [
              "HOS.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu tiyenu, nakamukokweja, nakamutwala mwisaŋa, nakahosha nindi mazu ashika nikumuchima windi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.14",
            "verseOrgIds": [
              "HOS.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakamwinka matempindi anyivinyu kwenoku, hichinekineki chaAkori chakekali chisu chachikuhwelela. Yena waketiya kwenoku, neyi cheliliyi mumafuku awansi windi, nimwifuku dakandukiliyi mwituŋa daEjipitu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Hefuku odu wakantena neyi, Nfumwami; hiwakantena nawa cheŋi neyi, Bayaluku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muloŋa ami nakafumisha majina awaBayali mukanwa kindi, hiyakayitena nawa cheŋi hamajinawuku. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hefuku odu nakayitiyaŋena chitiyaŋenu nawanyama amumpata, nawatujila ahaluzwizu, niyuma yazalalaŋa hamaseki. Nakafumisha mwituŋa nimata anyikunji nimpoku jatubali ninjita, nakayikamika chakadi kwakama. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakusumbula wakekalaŋa wami haya nyaka; mwalala, nakakusumbula wakekalaŋa wami mukuloŋa, nimuwuŋaji, nimuluwi, nimukwanakena. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakakusumbula wakekalaŋa wami mukashinshi; wakamwiluki Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova nindi, Hefuku odu naketiya, naketiya mawulu, wena nawa aketiya iseki; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.21",
            "verseOrgIds": [
              "HOS.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HOS 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iseki daketiya tidiku nivinyu nimanji; niwena aketiya Yezereyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.22",
            "verseOrgIds": [
              "HOS.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HOS 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ami nakamuti imba akekalaŋa wami mumaseki; wabulilaŋa kumona kumwanakena nakamwanakena; abulili kwikala antu ami nakayila nami, Muyantu ami; niwena akela iwu nindi, Yeyi Nzambi yami, iwu nindi, Yeyi Nzambi yami.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.23",
            "verseOrgIds": [
              "HOS.2.23"
            ]
          }
        }
      ]
    }
