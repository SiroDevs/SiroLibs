  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "1KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili yumiyi, Naboti wakuYezereyeli wadiŋi netempadindi danyivinyu, dadiŋi muYezereyeli dadihata netala dawantada mwanta waSamariya Ahabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.1",
            "verseOrgIds": [
              "1KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakumwila Naboti, nindi, Nyinkiitempa deyi danyivinyu, kulonda diikali itempa dami danyiseki, muŋa didikwakwihi netala dami. Nukukwinka itempa dacheŋi dabadika kuwaha. Hela neyi wunakepi nukukwinka mali ashikila mundandu yadu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.2",
            "verseOrgIds": [
              "1KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabotihakumwila Ahabi, nindi, Chinjila kumesu aYehova ami kukwinka wuswanawawankakulula jami.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.3",
            "verseOrgIds": [
              "1KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakwinza kwitala dindi namuchima walema, natiyi dehi kutamananowu mazu anamwiliyi Naboti wakuYezereyeli; muloŋa namwili dehi nindi, Kwonti kwami kukwinka wuswana wawankakulula jami. Hakukama hakadidi kindi, hakufutalelaku, nikudya yakudya kwonti kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.4",
            "verseOrgIds": [
              "1KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋodindi Yezebeli hakwinza kudi yena, hakumwila nindi, Wunaneŋelidi mumuchimaweyi wubuli kudya yakudya? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.5",
            "verseOrgIds": [
              "1KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Muloŋa nahoshi naNaboti wakuYezereyeli, namwili nami, Nyinki itempa deyi danyivinyu nikwinki mali; hela neyi wunakepi nukukwinka itempa dacheŋi. Yena naŋakuli nindi, Kwonti kwami kukwinka itempa dami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.6",
            "verseOrgIds": [
              "1KI.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iŋodindi Yezebeli hakumwila nindi, Hiyeyi wudi nakuyula aIsarela ku, tahindi? Hindukaku, wudyai yakudya, wutiyi kuwaha mumuchima weyi. Ami nukukwinka itempa danyivinyu daNaboti wakuYezereyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.7",
            "verseOrgIds": [
              "1KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakusoneka nyikanda mwijina daAhabi, hakuyilamika nachilamiki chindi, oyu nyikanda hakuyitemesha kudi awakulumpi nawayilolu adiŋi mumukala wawu, adiŋi ashakama naNaboti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.8",
            "verseOrgIds": [
              "1KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyikandoyu wasonekelumu nindi, Bidikenu nenu, Kudi chawija; mwakamusha kamishi Naboti hakachi kawantu halema; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.9",
            "verseOrgIds": [
              "1KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumesu indi mwakashaka mishuku antu amukunkulwayi ayedi, akamushimuni wunsahu, nawu, Wunatuki Nzambi ni mwanta. Mwaka mutwali mumpata, mwakamwasi malola, akafwi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.10",
            "verseOrgIds": [
              "1KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amumukala wawu, wowu awakulumpi nawayilolu ashakamini mumukalawawu, elili mwayilejeliyi Yezebeli, mwomwasonekeluwu munyikandayayitemesheleliyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.11",
            "verseOrgIds": [
              "1KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidikili nawu, Kudi chawija amushili Nabotihakachi kawantu halema. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.12",
            "verseOrgIds": [
              "1KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu amukunkulwayi ayedi hiyakwinza nakushakama kumesu indi. Wenowu antu amukunkulwayi hiyaku mushi muna yena Naboti wunsahu kumesu awantu nawu, Naboti natuki Nzambi nimwanta. Hiyakumufumisha kumukala, hiyakumwasa malola, hakufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.13",
            "verseOrgIds": [
              "1KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutemesha mazu kudi Yezebeli, nawu, Naboti anamwasi dehi malola, nafwi dehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.14",
            "verseOrgIds": [
              "1KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yezebeli chanatiyiyi nawu, Naboti anamwasi dehi malola, nafwi dehi, Yezebeli hakumwila Ahabi, nindi, Nyamukaku, wutambuli itempa daNaboti wakuYezereyeli dalekeliyi kukwinka nandandu yamali, muloŋa Naboti himumi nawaku, wafwa dehi kwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.15",
            "verseOrgIds": [
              "1KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi chanatiyiyi nawuNaboti nafwi dehi, Ahabi hakunyamuka nindi akunkumuki kwitempa daNaboti wakuYezereyeli, aditambuli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.16",
            "verseOrgIds": [
              "1KI.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izu daYehova hidikwinza kudi Elija wakuTishebi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.17",
            "verseOrgIds": [
              "1KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Nyamukakuwuyi nakumubulakana mwanta wa waIsarela Ahabi washakama muSamariya; owu wudi mwitempa daNaboti owu, nayi dehi nakuditambula. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.18",
            "verseOrgIds": [
              "1KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakahoshi nindi, neyi, Yehova nahoshi nindi, Wunajahani dehi, hiwukutambulanawa? Wakahoshi nindi, neyi, Yehova nahoshi nindi, Mwalashililuwu atuwa mashi aNaboti, dimu mwakalashilawu nimashi eyeyi nawa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.19",
            "verseOrgIds": [
              "1KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakumwila Elija nindi, Eyi chilumbu chami, wunanwani dehi, tahindi? Hakwakula nindi, Eŋa, nakuwani, muloŋa wunadilandi dehi mukwila chatama kumesu aYehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.20",
            "verseOrgIds": [
              "1KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiya, nukukuletela yatama, nukukukombamu chikupu, Ahabi nukumufumisha anyana amayala ejima, niwenzelewa niwudi hatooka muIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.21",
            "verseOrgIds": [
              "1KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutaŋa weyi nukuwila neyichikwamutaŋa wamwana kaNebati Yerobowami, namutaŋa wamwana kaAhiya Bayasha, nanochu chiwunanvuloki nizuwi, nichiwuna vulu mwishi aIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.22",
            "verseOrgIds": [
              "1KI.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamuteneni Yezebeli nawa, nindi, Atuwa akamudya Yezebeli kumpwembu yaYezereyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "WaAhabi wakafwila mumukala akamudya kudi atuwa, windi wakafwila mumpata akamudya kudi atujila amuluzwizu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
            "verseOrgIds": [
              "1KI.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalala hikwadiŋi wakweseka naAhabuku, wadilandili mukwila chatama kumesu aYehova, asaŋu mwishiluwu kudi iŋodindi Yezebeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Washimeni nankashi nakulondela akishi akutuŋa, neyi mwejima mwelilila ŋawu aAmori atemwiniyi Yehova kumesu awanyana kaIsarela.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
            "verseOrgIds": [
              "1KI.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
