        "sid": "1KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chimwahitili mafuku amavulu, hamwaka wamuchisatu izu daYehova hidikwinza kudi Elija, nindi, Yaku wakadimwekeshikudi Ahabi; ami nakanokesha nvula heseki.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakuya nakudimwekesha kudi Ahabi. MuSamariya mwadiŋi nzala yasweja. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakutambika Obadiya wadiŋi mukulumpi wawakwetala. Obadiya wadiŋi wamutiya Yehova woma nankashi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.3",
            "verseOrgIds": [
              "1KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "muloŋaheliliyi Yezebeli hakujilumuna atuprofwetu aYehova, yena Obadiya watweli atuprofwetu nkulakaji, wayiswekeli, makumi atanu mwiyeŋu, makumi atanu nawa mwiyeŋu, wayidiishili yakudya nameji. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.4",
            "verseOrgIds": [
              "1KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakumwila Obadiya, nindi, Hitaku mwaya ituŋa, wuyi kutuseloki twameji twejima, nikutwanatwatuloŋi twejima; wamba kela twakawana matahu, twakahandishi tuwalu nayi ngonŋavalu, kuchina kujiyisha anyama ejima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakudambwila nimpata jiyakahitawu. Ahabi hakuya njila yimukanka windi, Obadiya niyena nawa hakuya njila yi kwawu kanka windi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi Obadiya wudi nakuya munjila, nindi atali, Elija iwu wukwinzanakumubulakana iwu. Wamwilukili, hakudinata chamesu heseki, hakwila nindi, Yeyi nkaka yami Elija, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukwawu hakumwakula nindi, Yami. Yaku wakaleji nkaka yeyi neyi, Elija iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila nindi, Indiami navulumunidi mwaka wuhanami kambuŋeyi kudi Ahabi akanjahi tuhu? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.9",
            "verseOrgIds": [
              "1KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chahandayi Yehova Nzambi yeyi kwaamu, hikunashali hoku hela muzahela wanta kunabulewi kutumayi nkaka yami muntu wakukukeŋakeŋaku; cheliluwu nawu, Kunu kwosi, wasanyikishili wantowu hela muzowu, nawu, Hitunamumonuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.10",
            "verseOrgIds": [
              "1KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi eyi hiwukwila neyi, Yaku wakaleji nkaka yeyi neyi, Elija iwu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.11",
            "verseOrgIds": [
              "1KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwaha chinukwila ami nafumi dehi kudeyi, Spiritu yaYehova hakakutwala kwakadi kwilukami. Chinakaya nakumuleja Ahabi, niyena chakabula kukumonayi, hakanjaha tuhu. Hakwila ami kambuŋeyi namutiyaŋi Yehova woma kufumisha kuwansi wami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.12",
            "verseOrgIds": [
              "1KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chajahiliyi Yezebeli atuprofwetu twaYehova, chinaswekeli atuprofwetu twaYehova nkulakaji, mwiyeŋu dimu niswekamu makumi atanu, mwiyeŋu di kwawu niswekamu makumi atanu, hinukuyidiisha yakudya nameji, ochu hiyakulejeli mwokuku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.13",
            "verseOrgIds": [
              "1KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi eyi hiwukwila neyi, Yaku wakaleji nkaka yeyi neyi, Elija iwu. Wakanjaha tuhu! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija nindi, Chahandayi Yehova wamazazainemanaŋa kumesu indi kwaamu, chalala kwaamu lelu nukudimwekesha kumesu indi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi Obadiya hakuya nákubulakana naAhabi, hakumuleja. Ahabini yena hakuya nákubulakana naElija. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi chamumweniyi Elija, hakumwila nindi, Komana yeyi, yeyi wudi nakukabisha aIsarela, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakwakula nindi, Hiyami nakabishaŋi aIsarelaku. Yeyi, nimutaŋa watata yeyi, nanochu chimunaleki mwayilejeliyi Yehova, hiwukulondela kweyi aBayali. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.18",
            "verseOrgIds": [
              "1KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi temeshaku dinu antu akampompesheli aIsarela ejima kumpidi yaKarameli, niatuprofwetu twaBayali makulakaji awananamakumi atanu, niatuprofwetu twakunyiyombu makulakaji awana nawa, wowu adyaŋa kumesa yaYezebeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakutemesha antu kudi anyana kaIsarela ejima, hakupompeshani atuprofwetu kumpidi yaKarameli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.20",
            "verseOrgIds": [
              "1KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakwinza kudi antu ejima, hakwila nindi, Chimululuta, niniku kumukukundama nehi? Neyi Yehova diyi Nzambi, londenu yena; neyi diyi Bayali, komana londenu yena. Antuni izu dakumwakula nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakuyila antu, nindi, Ami yami kaprofwetu kaYehova nashaluhu kanka wami; atuprofwetu twaBayali adi amayala makulakaji awana namakumi atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.22",
            "verseOrgIds": [
              "1KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atwinki dinu aŋombi amayala ayedi. Wena atondi ŋombi yawu wumu, amuhaboli, amwali hanchawa, kushahu kesi nehi. Ami nawa nukuloŋesha ŋombi mukwawu, nukushahanchawa, kushahu kesi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.23",
            "verseOrgIds": [
              "1KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enu mutambiki ijina damukishi wenu, ami nitambiki ijina daYehova; yowu wukwakula nakesi diyi Nzambi. Antu ejima hiyakumwakula nawu, Muwunahoshi mwamuwahi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakuyila atuprofwetu twaBayali nindi, Tondenu ŋombi yenu wumu, musambilaŋahu dehi kumuloŋesha, muloŋa enu yenu amavulu. Mutambiki niijina damukishi wenu, kushahu kesi nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakutambula ŋombi yayinkeluwu, hiyakumuloŋesha, hiyakutambeka ijina daBayali, kufumisha kubudidi, tambeke-e, niitaŋwa mwiwulu, nawu, Eyi Bayali, tutiyi. Niizu nehi, niwakuyakula nehi. Hiyakumotojoka nihakameŋakatuŋiluwu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chidashikili itarova mwiwulu Elija hakuyiseha, nindi, Bide kenu chakola; muŋa nenu hiNzambi; kwiji hadi yadi nakutopojokayi, indi kwiji hadi kwanayiyi, indi kwiji wudi munjila, wamba kela wudi namutulu, chipa kumuhindwisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.27",
            "verseOrgIds": [
              "1KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakubidika chakola, hiyakuditapola nampokunamayembi, mwomwelilaŋawu, ninyijimba yawu kwamashi nŋe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.28",
            "verseOrgIds": [
              "1KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chelili itaŋwa dinaŋandakani dehi mukachi kewulu chaprofwetawu hohu, kushika nihalambwilaŋawu himulambu wahamelela; hikwadiŋi hela izu hela wakwakula, hela wakutala kwokuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakuyila antu ejima nindi, Twayenu kunu kwakwihi nanami. Antu ejima hiyakwinza kwakwihi nayena. Hakuloŋesha cheŋi kameŋa kaYehova kahumukili.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakunona malola ikumi nayedi mwomwashikila nyichidi yawanyana kaYakoba, eliluwu kudi wena diku kwenjili izu daYehova, dakwila nindi, ijina deyi dakekala yeyi Isarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu malolahakutupa nachu kameŋa mwijina daYehova. Kukameŋi hakupundakukapila kwi-ndo, kapila kakutwesha kuya yesekelu yambutu yiyedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakufwikanchawa chachiwahi, hakuhabola ŋombi, hakumwala hanchawa. Nindi, Inzeshenu nswaha jiwana nameji, mumwaŋili hahimulambu wakushita, nihanchawa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Ilenu kamuchiyedi; hiyakwila kamuchiyedi. Nindi, Ilenu kamuchisatu; hiyakwila kamuchisatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meji hiyakuhita kukameŋa kwi-ndo. Nikapila nawa wakenzesheli nameji.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chihashikili hakulambwiia himulambu wahamelela, kaprofwetu Elijahakwinza kwakwihi. Hakwila nindi, Eyi Yehova Nzambi yaAbarahama, niyaIsaka, niyaYakoba, lelu eluki nawu yeyi Nzambi muIsarela, nawu ami nikambuŋeyi, niyumiyi yejima yineli eluki nawu nayili yakunleja kudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyi eyi Yehova, ntiyi, kulonda antu awa eluki nawu eyi Yehova yeyi Nzambi, yeyi wunafuntishi cheŋi nyichima yawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hohenohu kesi kaYehova hikakuholoka, hikakunoŋesha himulambu wakushita, ninchawa, nimalola, nimaseki, hikakulasha nimeji adiŋi mukapila, chau. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antuejima chanachimonuwu hiyakudimboka chamesu awu hamaseki. Hiyakwilanawu, Yehova diyi Nzambi, Yehova diyi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakuyila nindi, Kwatenu atuprofwetu twaBayali; bayi hapuluka hela wumuku. Ayi kwatani kuyi kwata. Elija hakuyikunkumwisha kukakaloŋa Kishoni, hakuyijihila kwenoku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elija hakumwila Ahabi, nindi, Yaŋa kweyi wakadyi, wakanwi, muŋa kudi lushindu lwanvula yeneni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi hakuya kwindi kulonda akadyi, akanwi. Elija hakukandama hewulu daKarameli. Hakudumba hamaseki, hakusha mesu mumanuŋu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila pamba yindi nindi, Kanda makuwutali kukaluŋalwiji. Hakukandama, hakutala, nindi, Kwosi chumaku. Nindi, Funtaku cheŋi; mapampa katanu nakayedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakapampa kamu chitanuna chiyedi hakwila nindi, Namoni mukaluŋalwiji mudi nakunya mukakadivu kanvanya kadi neyi chikasa chamuntu. Nindi, Yaku wakamwili Ahabi, neyi, Lopeshaku ikalu deyi, wukunkumuki kuchina nvula kukukaŋesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chihanalehi chanti iwulu diiyila nibwi namavu nimpepela, hikukunoka ninvula yeneni. Ahabi hakwenda mwikalu, hakuya kuYezereyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikasa chaYehova hichikwikala hadi Elija, hakupimpila mahinindi, hakuya lufuchi, hakumupandakana Ahabi, hakushikaŋahu dehi kuwiŋililuwa kuYezereyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    }
