  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "1KI 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSiriya Benihadadi wapompesheli njita yindi yejima. Wadiŋi nawanyanta ankanu makumi asatu nawanyanta ayedi, nituwalu, nimakálu. Hakuya nakukuchika Samariya, hakulwa nawu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.1",
            "verseOrgIds": [
              "1KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakutemesha atuŋanda mumukala kudi mwanta wa waIsarela Ahabi, hakumwila nindi, Tiya chanahoshiyi Benihadadi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.2",
            "verseOrgIds": [
              "1KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindi, Siliva yeyi niwuru weyiwamami. Niapodi jeyi nawa, nianyaneyi wowu aduku asweja kuwaha, amami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.3",
            "verseOrgIds": [
              "1KI.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakuyakula nindi, Mwomu muwunahoshieyi nkaka yami mwanta. Ami niweyi niyuma yami yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.4",
            "verseOrgIds": [
              "1KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuŋandahiya kwinza cheŋi, hiyakwila nawu, Tiya chanahoshiyi Benihadadi, nindi, Mwalala natemesha kudeyi mazu akwila nami, Wakanyinki nisiliva yeyi, niwuru weyi, ni aŋodi jeyi, nianyaneyi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.5",
            "verseOrgIds": [
              "1KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ichi dinu nakatemesha ambuŋa mikumadiki kudeyi neyi aha hanashiki itaŋwa, akaboloŋonza mwitala deyi, nimumatala awambuŋeyi; chonsu chiwamona eyi kuwaha akanona, akatwala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakutambika awakulumpi ejima amwituŋa, nindi, Tiyenu mwani, muntu iwu chakukeŋayi yatama; muloŋa yena watemesha dehi kudami nindi atambuli niapodi jami, ni anyanami, nisiliva yami, niwuruwami, ami kumulekesha nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.7",
            "verseOrgIds": [
              "1KI.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulumpi ejima nawantu ejima hiyakumwilanawu, Bayi wutiyilila mwoku, bayi witŋiku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.8",
            "verseOrgIds": [
              "1KI.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuyila atuŋanda twaBenihadadi, nindi, Kamwilenu nkaka yami mwanta, nenu, Mwonsumuwatemeshela ami kambuŋeyi hakusambila nukwilamu; ilaŋa chumichi hinukutweshaku. Atuŋanda hiyakuya nakumutwelela cheŋi mazu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.9",
            "verseOrgIds": [
              "1KI.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.9",
            "verseOrgIds": [
              "1KI.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi hakumutemeshela mazu akwila nindi, Neyi maseki amuSamariya akawanina mumakasa awantu ejima inidi nawu, komana akishi akaŋili mwomumu nichakubadikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.10",
            "verseOrgIds": [
              "1KI.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakuyakulanindi, Kamwilenu nenu, Muntu wukumanyeka bayi adisama neyi muntuwudi nakuvúulaku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.11",
            "verseOrgIds": [
              "1KI.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi chatiyiliyi mazu awa wadiŋi nakunwawalwa nawanyanta muyisolu, hakuyila ambuŋindi nindi, Tandamenu. Hiyakutandamina mukala.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.12",
            "verseOrgIds": [
              "1KI.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.12",
            "verseOrgIds": [
              "1KI.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutala kaprofwetu hakukundama kwakwihi namwanta wawaIsarela Ahabi, nindi, Yehova nahoshi nindi, Luntu lwejimilu wunalumoni, tahindi? Nukuluhana kudeyi lelu; nineyi wakeluka neyi yami Yehova. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.13",
            "verseOrgIds": [
              "1KI.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabi nindi, Nanyi? Mukwawu nindi, Yehova nahoshi nindi, Nawanyikwenzi awatulamba twamumawuloŋu. Nindi, Akata chika njita anyi? Hakumwakula nindi, Yeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakupompesha anyikwenzi awatulamba twamumawuloŋu, ashikili mumakulakaji ayedi namakumi asatu nawatulamba ayedi; hakupompesha munyima yawu antu ejima, wowu anyana kaIsarela ejima ashikili mumakombakaji atanu nayedi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edi kili hashikili itaŋwa mwiwulu. Benihadadi kwindi wadiŋi nakunwawalwa muyisolu, nakusheta hamu nawanyanta ankanu, wowu anyanta makumi asatu nawanyanta ayedi amukwashilaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.16",
            "verseOrgIds": [
              "1KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyikwenzi awatulambahiya kusambilaŋahu dehi kwidika. Benihadadi hakutemeshaku antu, hiyakumuleja nawu, MuSamariya munafumi antu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.17",
            "verseOrgIds": [
              "1KI.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindi, Hela neyianenzi chakumwena, yikwatenu amomi; hela neyi anenzi chanjita, yikwatenu amomi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyikwenzi awatulamba twamumawuloŋu hiyakwidika mumukala ninjita yawu munyima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.19",
            "verseOrgIds": [
              "1KI.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakujaha antu, iwu ojaha windi, iwu ojahawindi. ASiriya atemoka nikutemoka, aIsarela hiyakuyihaŋa. Benihadadi mwanta wakuSiriya hakupulukila hakawalu hamu nawakwatuwalu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.20",
            "verseOrgIds": [
              "1KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakwidika, hakutapa atuwalu niakwamakálu, hakujaha aSiriya amavulu nankashi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu hakukundama kwakwihi namwanta wawaIsarela, hakumwila nindi, Yaku wakadikoleshi wiluki chiwakela, muloŋa chiwakabalumuka mwaka mwanta wakuSiriya wakenza nakulwa neyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋa mwanta wakuSiriya hiyakumwila nawu, Nzambi yawu hiNzambi wakumapidi, dichi chatubadikililuwu Ŋovu. Neyi twakalwilanawu muchana, hitwakayibadika Ŋovuku? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.23",
            "verseOrgIds": [
              "1KI.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilaku mwenimu, awa anyanta ankanu kayifumishumu wejima wawu, wuhiŋishumu awakulumpi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.24",
            "verseOrgIds": [
              "1KI.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kachindinjita yidi neyi njita yinanoŋi, kawalu nakawalu, ikalu nekalu; twakalwilinawu muchana. Hitwakayibadika Ŋovuku? Hakutiyilila mwizu dawu, hakwila nimwenomu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka chiwabalumukili Benihadadi hakupompesha aSiriya, hakuya kuAfweki, akadasi njita nawaIsarela. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.26",
            "verseOrgIds": [
              "1KI.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyana kawaIsarela niwena, hiyakupompa, hiyakuloŋesha yakudya yawu, hiyakuya nakulwa nawu. Anyana kaIsarela hiyakushakama muchilombu kumesu awu neyi tunyikankatuyedi twawanyana kampembi. Kwinza aSiriya ituŋa dejima diwu hohunihasheli hosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu waNzambi hakukundama kwakwihi, hakuhosha namwantawa waIsarela, nindi, Ochu chanahoshuwu aSiriya nawu, Yehova hiNzambi wakumapidi kwindi, hiNzambi wakuyinekinekuku; dichi dinu luntu lwejimilunukuluhana kudeyi, mwakeluki nenu yami Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashakamini muyilombu yawu chakutalaŋana mafuku atanu nayedi. Ifuku damu chitanu nachiyedi akwata nikunjita. Anyana kaIsarela hiyakujaha aSiriya makombakaji nkulakaji awakwakwenda hamaseki ifuku dawudimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.29",
            "verseOrgIds": [
              "1KI.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anashali hiyakutemukila kuAfweki, lwe nimumukala; mpwembu hiyi kukundukila antu asheluku, makombakaji makumi ayedi namakombakaji atanu nayedi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi hakutemuka, hakwijila mumukala, lwe nimukapeka kamukachiketala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋindi hiyakumwila nawu, Tunatiyi nawu anyanta akumutaŋa wawaIsarela hiyanyanta akweti luwi. Atwitiji mwani tuvwaliyikeleyi mumbunda jetu, tushi ninyonji hanyitu yetu, twidiki kudi mwantawa waIsarela. Hadaha wakakuhandisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.31",
            "verseOrgIds": [
              "1KI.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakuvwala niyikeleyi mumbunda jawu, hiyakusha ninyonji hanyitu yawu, hiyakwinza kudi mwanta wa waIsarela, nawu, Kambuŋeyi Benihadadi nindi, Nalembi, nihandi. Yena nindi, Komana wuchidi wamumi? Himana kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu mayala hiyakutiyilila nankashi, kulonda amutiyi kwizu dindi, eluki muchima windi; hiyakwila nawu, Mana kweyi Benihadadi. Hakuyilanindi, Yenu mwakamuleti. Benihadadi hakwidika, hakwinza kudi yena. Yena hakumukanjika mwikalu dindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benihadadi hakumwila nindi, Nyikala yatambwili tata yami kudi tata yeyi nukuyifuntisha; eyi wakelanyikwakwa yeyi muDamakasa neyi cheliliyi tata yami muSamariya. Ahabi nindi, Nukukúumbaku nachitiyaŋenu ichi. Hakutiyaŋana nindi chitiyaŋenu, hakumúumba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntu wakudi anyana kawatuprofwetu hakumwila mukwawu chakumulejakudi Yehova, nindi, ŋeti mwani. Mukwawu kwonti kwindikumweta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Ichi chiwunaleki kwovwahila izu daYehova, chiwukwila wunafumi dehi kudami akakujaha kudi mutupa. Cheliliyi nafumi dehi kudi yena, mutupa hakumuwana, hakumujaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakuwana muntu mukwawu, hakumwila nindi, ŋeti mwani. Owu muntu hakumweta, chamweteliyi hakumukatisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaprofwetu hakufumaku, hakuya naku muchiŋilila mwanta kunjila; hakudifwikŋi neyi muntu wacheŋi, hakukasaihina kumesu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheliliyi mwanta hakuhita, hakumubidika mwanta, nindi, Ami kambuŋeyi naya mukachi kanjita; kutala muntu hakubalumuka, hakunletela muntu nindi, Muhembi iwu muntu; neyi wakatemuka, wumiwindi wakawufuta nawumi weyi, hela kufuta ntalenta yasiliva. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amikambuŋeyi chinela nami nilabajali niniku niniku, kumu kasumuka kwosi. Mwanta wawaIsarela hakumwila nindi, Wunadibayishi eyi aweni, yeyi aweniwunahoshumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakunyakala kufumisha ihina kumesu indi. Mwantawa waIsarela hakumwiluka nindi, Komana wawatuprofwetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila nindi, Yehova nahoshi nindi, Ochu chiwunamu umbuku muntu inafu ukwilili kujilumuka, wumi weyi wunati nawumi windi, antu eyi anati nawantu indi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wawaIsarela hakuya kwitala dindi namuchima walema, natiyi dehi kutama, hakushika kuSamariya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.43",
            "verseOrgIds": [
              "1KI.20.43"
            ]
          }
        }
      ]
    }
