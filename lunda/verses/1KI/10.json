  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1KI 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSheba wamumbanda walukanu chatiyiliyi mpuhu yaSolomoni yakutena ijina daYehova, hakwinza nakumwesekana kumwi hujola yuma yakala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.1",
            "verseOrgIds": [
              "1KI.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwinza kuYerusalema naluntu lwaluvulunankashi, nianŋameli asenda nyiseki, niwuru wawuvulu nankashi, nitumalola twawuseya weneni. Chashikiliyi kudi Solomoni wahoshelinindi yadiŋi mumuchima windi yejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.2",
            "verseOrgIds": [
              "1KI.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni wamuiejeli mwamwihwiliyi mwejima; hikwadiŋi chuma chakaŋenyiyi mwanta chabuliliyi kumulejaku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.3",
            "verseOrgIds": [
              "1KI.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wakuSheba chamweniyi maana aSolomoni ejima, niitaladatuŋiliyi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.4",
            "verseOrgIds": [
              "1KI.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyadiilaŋawu kumesa yindi, nimwashaka minaŋwu ambuŋindi, nimwemenaŋawu aŋambela jindi, niwuvwalu wawu, niantu indiakwakutwala mpasa, nimwakandukililaŋayi kwitala daYehova, hadiŋi nawacheŋi naŋovuku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.5",
            "verseOrgIds": [
              "1KI.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwila mwanta nindi, Chinatiyili mwituŋa dami mwashi mwinuwuni muwelaŋa ninsaŋu jamaana eyi, komana chalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.6",
            "verseOrgIds": [
              "1KI.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwashimwi nuwuhinetiyili mwokuku; ichi chinenzi namoni dehi namesu ami; komana hiyanshimwinini hela chibaluku; nima ana eyi nimaheteyi anabadikimumpuhu yinatiyili. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.7",
            "verseOrgIds": [
              "1KI.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu eyi amona kuwaha, awa ambuŋeyi emanajimafuku ejima kumesu eyi nakutiya maana eyi amona kuwaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.8",
            "verseOrgIds": [
              "1KI.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisukisu Yehova Nzambi yeyi, wakutiyili kuwaha, wakushakamishili hetandadawanta wawaIsarela. Ochu chakeŋeluwu Isarela kudi Yehova hayanyaka, dichi chanakudiishiliyi wanta, kulonda wilaŋa ngwuŋaji ngloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.9",
            "verseOrgIds": [
              "1KI.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakumwinka mwanta ntalenta jawuru nkulakaji namakumi ayedi, ninyiseki yayivulu nankashi, nitumalola twawuseya weneni. Hikwenjilinawa cheŋi nyiseki yayivulu yidi neyi yamwinkeluwu mwanta Solomoni kudi mwanta wakuShebaku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.10",
            "verseOrgIds": [
              "1KI.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimaatu aHirami nawa enjili nawuru wakuOfwiri, kuOfwiri afumishiluku nyitondu yaalimuŋi yayivulu nankashi, nitumalola twawuseyaweneni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.11",
            "verseOrgIds": [
              "1KI.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyu nyitondu yaalimuŋi mwanta hakutuŋi nachu yishimiyakwitala daYehova, niyakwitala damwanta, nitudada niyisanji yawakwakwimba. Hikwenjili nawa cheŋi nyitondu vaalimuŋi yidi neyi oyuku, helakuyimonahu, nilelu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.12",
            "verseOrgIds": [
              "1KI.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni wamwinkeli mwanta wakuSheba yakeŋeliyi, yalombeliyi yejima, yakulunjika hayuma yamutoŋwelawu dehi kudi mwanta Solomoni. Hakubalumuka, hakufunta kwituŋa dindi, niyena niambuŋindi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.13",
            "verseOrgIds": [
              "1KI.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pezu yawuru yenjilaŋa kudi Solomoni mumwaka wumu yashikilaŋa muntalenta jawuru makulakaji atanu nadimu namakumi atanu nadimu, nantalenta jitanu nayimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.14",
            "verseOrgIds": [
              "1KI.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakulunjika hayafuminaŋa kudi akwakulandulula, nihayalandulwila ŋawu akwakulandisha, nihayafuminaŋa kudi anyanta ankanu awantu eŋi neŋi, nihayafuminaŋa kudi ayilolu amwituŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.15",
            "verseOrgIds": [
              "1KI.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni welili yibasa yawuru wakuchila makulakaji ayedi; chibasa chimu chakwila najishekeli jawuru makulakaji atanu nadimu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.16",
            "verseOrgIds": [
              "1KI.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ninkebu jawuru wakuchila makulakaji asatu; nkebu yimu yakwila najipawundi jawuru jisatu. Mwanta wajishili mwitala damulusesa lwaku-Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.17",
            "verseOrgIds": [
              "1KI.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta watuŋili nawa itanda dawanta deneni dambiŋa yanjamba walamikiluhu wuru wasweja kukoseka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.18",
            "verseOrgIds": [
              "1KI.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itanda dawanta dadiijinayimaŋu yakukandamina yitanu nachimu, kunyima yewulu detandakwadiŋi kwawujiya, kuwushakaminu kwadiŋi hawusachilu wamakasaniishinadi niishinadi, ninyitupa yiyedi yemana kumbadi yahawusachilu wamakasa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.19",
            "verseOrgIds": [
              "1KI.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninyitupa ikumi nayiyedi yemana kwenoku kumbadŋyimapu yakukandamina yitanu nachimu nimbadi nimbadi. Mwituŋa dacheŋi himwadiŋi chuma chidi neyi ochuku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.20",
            "verseOrgIds": [
              "1KI.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuma yakunwina mwanta Solomoni yadiŋi yawuru hohu yejima, niyuma yakwitala damulusesa lwakuLebanoni yadiŋi yawuru wakoseka hohuyejima; hikwadiŋi chasiliva nichimuku; hamafuku aSolomoni ayimweninawu yamukunkulwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.21",
            "verseOrgIds": [
              "1KI.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta wadiŋi namaatu akuTarashishi hamunama atu aHirami kukalupalwŋi. Maatu akuTarashishi elilaŋa muhitanyaka yisatu enza kamu, chochu hohu, aletelaŋa niwuru, nisiliva, nimbiŋjanjamba, niampombu, niatujila twayisusu yayilehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.22",
            "verseOrgIds": [
              "1KI.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Solomoni hakubadika anyanta ankanu ahamaseki ejima, nimaheta nima ana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ahamaseki ejima enjilaŋa kudi Solomoni kulonda kutiya maana indi anamushiluwu mumuchima windi kudi Nzambi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
