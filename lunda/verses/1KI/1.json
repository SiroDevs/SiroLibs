  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1KI 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi welili kashinakaji, nyaka yindi yamuvulili; hiyakumubutaŋa mahina, kukwata iyena nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.1",
            "verseOrgIds": [
              "1KI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuŋindi hiyakumwila nawu, Amukeŋeli nkaka yami mwanta chaŋadima wamujiki; akemanaŋa kumesu amwanta, akamuhembaŋa, akaakamaŋa kunyima yeyi, kulonda nkaka yami mwanta akakwati iyena. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.2",
            "verseOrgIds": [
              "1KI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakukeŋakeŋa chaŋadima walubanji mwahitaituŋa dawaIsarela dejima, hiyakuwana Abishaŋi wakuShunemi, hiyakumuletakudi mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.3",
            "verseOrgIds": [
              "1KI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owu chaŋadima wadiŋi wasweja lubanji, wamuhembelaŋa mwanta, hakumukalakelaŋa, ilaŋa mwanta kudi mona nindi nehi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.4",
            "verseOrgIds": [
              "1KI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya mwana kaHagiti hakuditohesha, nindi, Yami nukwikalamwanta. Hakudiloŋeshela nimatemba niakwatuwalu, ni amayala makumi atanu akuyaŋilu dehi kumbidi yindi lufuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.5",
            "verseOrgIds": [
              "1KI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tata yindi kanda amutiyishaŋahu dehi kutama kwakumwila nindi, Wunelilidi mwenimu? Niyenanawa wadiŋi wasweja kuwaha kumutala, diyi walondeli munyima yaAbisalomi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.6",
            "verseOrgIds": [
              "1KI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakukwata mpùŋa namwana kaZeruwiya Yowabi, nakapristu Abiyatari; hiyakukuma kudi Adoniya, hiyakumukwashaŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.7",
            "verseOrgIds": [
              "1KI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwinza kapristu Zadoki, namwana kaYehoyada Benaya, nakaprofwetu Natani, naShimeyi, naReyi, nawayilobu ambaia aDavidi, kwikala kudi Adoniya nehi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.8",
            "verseOrgIds": [
              "1KI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya hakujaha ninyikoku, niŋombi, nianyama anuna, kwilola daZoheleti dekala kwakwihi naEniropeli. Hairutambikilaku ana kwindianyana kamwanta ejima, ni amayala akuYuda ambuŋi mwanta ejima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.9",
            "verseOrgIds": [
              "1KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila kaprofwetu Natani, naBenaya, nawayilobu, namana kwindi Solomoni, hayitambikili kwinduku.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.10",
            "verseOrgIds": [
              "1KI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani hakuhosha namama yaSolomoni Batisheba, nindi, Eyi kutiyanawu mwana kaHagiti Adoniya wela dehi mwanta chakadi nkaka yetu Davidi kuchiluka, nehi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.11",
            "verseOrgIds": [
              "1KI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichi dinu mwani, twaya kunu nikuleji maanakulonda wakadihandishi nineyi aweni nimwaneyi Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.12",
            "verseOrgIds": [
              "1KI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakuwakeŋili mwa-mwanta Davidi, wakamwili neyi, Eyi nkaka yami, eyi mwanta, hiwansanyikilili ami kambuŋeyi, neyi, Chalala mwaneyi Solomoni diyiwakekala mwanta wakunswanami, diyi wakashakama hetanda dami dawantaku? Indi dinu Adoniya neli dehi mwanta ŋihi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.13",
            "verseOrgIds": [
              "1KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwakela eyiwuchidi kuhosha namwanta, ninami nawa nakakulondela mwenomu, nakakoleshamazu eyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.14",
            "verseOrgIds": [
              "1KI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba weŋilili mwa-mwanta mwitala damukachi. Henohu mwantawela dehi kashinakaji nankashi. Abishaŋi wakuShunemi wadiŋi nakumu kalakela mwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.15",
            "verseOrgIds": [
              "1KI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba hakubandama, hakudifukula kudi mwanta. Mwanta nindi, Wudi nakukepadi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.16",
            "verseOrgIds": [
              "1KI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yena hakumwila nindi, Nkaka yami, eyi wansanyikilili ami kambuŋeyi Yehova Nzambi yeyi, neyi, Chalala mwaneyi Solomoni diyi wakekala mwanta wakunswanami, diyi wakashakamahetanda dami dawanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.17",
            "verseOrgIds": [
              "1KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi dinu tala tuhu, Adoniya neli dehi mwanta, nineyi nkaka yami mwanta kuchiluka nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.18",
            "verseOrgIds": [
              "1KI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajaha dehi aŋombi, nianyama anuna, ninyikoku, kwalumbama dehi, watambika dehi nianyana kamwanta ejima, nikapristu Abiyatari, nimukulumpi wanjita Yowabi. Hakwila kambuŋeyi Solomoni hanamutambikuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.19",
            "verseOrgIds": [
              "1KI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dichidinu, eyi nkaka yami mwanta, mesu awaIsarela ejima adi nakukutaleyi, wushimuni wakashakama hetanda dawanta dankaka yami mwanta, wakahiŋai mudeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.20",
            "verseOrgIds": [
              "1KI.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchina kwila neyi nkaka yami mwanta nakami dehi tuluhamu nawankakulula jindi, ami namwaneyi Solomoni hitwakekala akwanyiloŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.21",
            "verseOrgIds": [
              "1KI.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wuchidi kuhosha namwanta, kaprofwetu Natani eŋila nikwijila. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.22",
            "verseOrgIds": [
              "1KI.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumuleja mwanta nawu, Kaprofwetu Natani iwu. Chanashikiyi kumesu amwanta, hakubandama kumesu amwanta chamesu indi hamaseki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.23",
            "verseOrgIds": [
              "1KI.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani hakwila nindi, Eyi nkaka yami mwanta, yeyi wunahoshi neyi, Adoniya answanami, akashakami hetanda dami dawanta, tahindi? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.24",
            "verseOrgIds": [
              "1KI.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leluwaya dehi, najahi dehi nia ŋombi, nianyama anuna, ninyikoku, kwalumbama dehi, watambika dehi nianyana kamwanta ejima, niakulumpi anjita, nikapristu Abiyatari. Hiyakudya nakunwa kumesu indi, hiyakwila nawu, Mwanta Adoniya ahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.25",
            "verseOrgIds": [
              "1KI.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakwila ami yami kambuŋeyi, nikapristu Zadoki, ni mwana kaYehoyada Benaya, nikambuŋeyi Solomoni, hanatutambikuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.26",
            "verseOrgIds": [
              "1KI.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkaka yami mwanta neli chumichi chakadi kutulejamu etuambuŋeyi, tahindi? Hiwunatuleji wakashakama hetanda dawanta dankaka yami mwanta, wakahiŋa mudeyuku. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi hakwakula nindi, Ntambikili Batisheba. Hakwijila mwadiŋi mwanta, hakwimana kumesu amwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakusanyika nindi, Chahandayi Yehova, wankúulili muyuma yakala yejima, kwaamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "chalala mwomunakusanyikilili Yehova Nzambi yaIsarela, nami, Chalala mwaneyi Solomoni diyi wakanswanami, diyi wakashakama hetanda dami dawanta, ahiŋi mudami, dimu nukwila lelu chalala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisheba hakubandama chamesu indi hamaseki, hakudifukula kudi mwanta, nindi, Nkakayami mwanta Davidi ahandi haya nyaka.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.31",
            "verseOrgIds": [
              "1KI.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta Davidi hakwila nindi, Ntambikilenu kapristu Zadoki, nikaprofwetu Natani, ni mwana kaYehoyada Benaya. Hiyakwinza kumesuamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.32",
            "verseOrgIds": [
              "1KI.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta hakuyila nindi, Yenu nawambuŋankaka yenu, mwakamwendeshimwanami Solomoni hachingonŋavalu chamami aweni, mwakamukunkumwishi kuGihoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.33",
            "verseOrgIds": [
              "1KI.1.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Zadoki nakaprofwetu Natani akamuwayishi wanta wawaIsarela. Mwakembi mpùŋa, mwakelinenu, Mwanta Solomoni ahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.34",
            "verseOrgIds": [
              "1KI.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakenzi nindi, mwakamu shakamishihetanda dami dawanta; muŋa diyi wakanswanami. Ami namukunjika dehi nami ekali nlomboli yawaIsarela nawaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.35",
            "verseOrgIds": [
              "1KI.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana kaYehoyada Benaya hakumwakula mwanta, nindi, Amena, niYehova Nzambi yankaka yami mwanta ahoshi nawa mwomumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.36",
            "verseOrgIds": [
              "1KI.1.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanashakaminiyi Yehova nankaka yami mwanta, ashakami nawa ninaSolomoni, niitanda dindi dawanta adibadishi kulema dibadiki niitanda dawanta dankaka yami mwanta Davidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.37",
            "verseOrgIds": [
              "1KI.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Zadoki, nakaprofwetu Natani, namwana kaYehoyada Benaya, nawaKereti, nawaPeleti, hiyakukunkumuka hiyakumwendesha Solomoni hachingonŋavalu chamwanta Davidi, hiyakumutwala kuGihoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.38",
            "verseOrgIds": [
              "1KI.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Zadoki hakunona luseŋu lwamanji mwitenti, hakumuwayisha Solomoni. Emba nimpùŋa, antu ejima hiyakwila nawu, Mwanta Solomoni ahandi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.39",
            "verseOrgIds": [
              "1KI.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Antu ejima hiyakwinza nindi, antu hiyakwimbamahululu, hiyakuzaŋilala kwakweni, niiseki hidikubaluka nezudawu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.40",
            "verseOrgIds": [
              "1KI.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya nawantu atambikiliyi ejima hiyakuchitiya hiyeliluwu hiyakuyanakukumisha kudya. Yowabi chatiyiliyi mpùŋa ayikuvuma, hakwila nindi, Odu ipumba dikutiyakana kumukala danka? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.41",
            "verseOrgIds": [
              "1KI.1.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku wuchidi kuhosha, kukasumuka Jonatani mwana kakapristu Abiyatari hakushika. Adoniya nindi, Ipilaku, muloŋa eyi wumuntu walumbuluka, wunasendi nsaŋuyayiwahi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.42",
            "verseOrgIds": [
              "1KI.1.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatani hakwakula, hakumwila Adoniya nindi, Chalalankaka yetu mwanta Davidi namudiishi dehi Solomoni wanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.43",
            "verseOrgIds": [
              "1KI.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanta namutemeshi dehi hamu nakapristu Zadoki, nakaprofwetu Natani, namwana kaYehoyada Benaya, nawaKereti, nawaPeleti, anamwendeshi dehi nihachingo nŋavalu chamwanta. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.44",
            "verseOrgIds": [
              "1KI.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapristu Zadoki nakaprofwetu Natani anamuwayishi dehi wanta kuGihoni. Hiyakufumaku nakuzapalala, hamukala havuŋana nikuyuŋana. Didi ipumba dimunatiyi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.45",
            "verseOrgIds": [
              "1KI.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "NiSolomoni nashakami dehi hetanda dawanta wetuŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.46",
            "verseOrgIds": [
              "1KI.1.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1KI 1:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niambuŋa mwanta aneŋili dehi nakumukiswila nkaka yetu mwanta Davidi nkisu, nawu, Nzambi yeyi awahishi ijina daSolomoni dibadiki deyeyi, atoheshi nawa itanda dindi dawanta dibadiki deyeyi; mwanta hakubandamina nikukadidi kindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.47",
            "verseOrgIds": [
              "1KI.1.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyenu nawa chanahoshiyi mwanta, nindi, Kisu kisu, Yehova Nzambi yaIsarela nanyinki dehi wakushakama hetanda dami dawanta lelu, mesu ami achimonaŋa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1KI 1:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.48",
            "verseOrgIds": [
              "1KI.1.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1KI 1:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atambikiliyi Adoniya ejima atiya niwoma, hiyakunyamoka, hiyakuyalwu namwindi, iwu namwindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.49",
            "verseOrgIds": [
              "1KI.1.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1KI 1:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adoniya hakutiya woma wansaŋu yaSolomoni, hakunyamuka, hakuya nakukwata kunseŋu jakameŋa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.50",
            "verseOrgIds": [
              "1KI.1.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1KI 1:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyakumule jaSolomoni, nawu, Adoniya natiyi dehi mwanta Solomoni woma; owu nakwati dehi kunseŋu jakameŋa owu, nindi, Mwanta Solomoni ansanyikililelu nindi kunjaha ami kambuŋindi nampoku yakabali nehi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.51",
            "verseOrgIds": [
              "1KI.1.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1KI 1:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakwila nindi, Neyi wukwi kala iyala dalala, lusuki lwindi nilumuhilwakaholoka hamasekuku; ilaŋa neyi kudi yena kwakamwekana katama, wakafwa hohu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.52",
            "verseOrgIds": [
              "1KI.1.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1KI 1:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni hakutemeshaku niantu, hiyakumusulwi shakukamepa. Hakwinza nakudifukula kudi mwanta Solomoni. Solomoni hakumwila nindi, Yaŋa kwitala deyi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.53",
            "verseOrgIds": [
              "1KI.1.53"
            ]
          }
        }
      ]
    }
