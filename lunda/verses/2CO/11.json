          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuDamakasa nguvulu yamwanta Aretasi, wahembeli ŋanda yaDamakasa, nindi ankwati; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
