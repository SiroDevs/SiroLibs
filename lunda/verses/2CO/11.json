              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyi chinawahi ami kudisamba, nukudisamba nansaŋu yakuzeya kwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
