          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambi yaMwanta Yesu, yowu Tata yindi, wakisulewaŋa haya nyaka, neluki nindi hinatwambuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
