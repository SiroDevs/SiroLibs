          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.12",
            "verseOrgIds": [
              "NAM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wamazaza nindi, Tiyaku, ami nidi neyi nandombu, nakakwochela makálu eyi kwawishi hohu fwi-fwi-fwi, nyenzi yeyi yanyitupa akayivwota kudi mpoku yakabali. Anyama iwakwatilaŋa nakayifumisha hanu heseki, izu dawatuŋanda tweyi hiyakaditiya nawa cheŋuku.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.13",
            "verseOrgIds": [
              "NAM.2.13"
            ]
          }
        }
      ]
    }
