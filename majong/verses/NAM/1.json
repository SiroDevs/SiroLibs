      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aŋoit ka Akuj ŋina amunyaran ŋituŋa a Ninepe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋakiro ŋuna ajokak aŋuna a Yudaya",
          "type": "text"
        }
