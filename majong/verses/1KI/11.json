        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋadyakanareta a Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu erwosit Solomon kiit ŋaberu ŋuna alalak ŋunamoen kaapei ka nakoku a Parao. Arae ŋaberu ŋun: Ŋamoabi, Ŋaamoni, Ŋaedomi, Ŋasidoni ka Ŋaitaiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.1",
            "verseOrgIds": [
              "1KI.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋaberu ikes ŋuna anakwapin a ŋuna abu Ekapolon tolimok Ŋisirael tema, “Nyemaikina iyes kipotonokinos anakiito ka ŋituŋa a ŋakwapin aŋace, anerae ituruworete kire jik ikes ŋitai kus ŋulu eminasi ŋakujo kec.” Nai amina Solomon ŋaberu ŋun nooi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.2",
            "verseOrgIds": [
              "1KI.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakar Solomon ŋaberu ŋamiae ŋakanikaarei ŋuna auritae alokalya a ŋirwosi ka ŋace ŋamiae ŋauni ŋuna pa eitit; apotu ŋaberu keŋ ŋun kibatasi etau a Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.3",
            "verseOrgIds": [
              "1KI.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edoli ŋikaru ŋulu amojoŋia Solomon, kituruwosi ŋaberu ŋun etau a Solomon ŋolo amina ŋakujo kec, tojamak etau a Solomon ainakina neni ke Ekapolon ka Akuj keŋ nyeminak lopite ŋolo sek aminar etau a Daudi a papa keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.4",
            "verseOrgIds": [
              "1KI.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋun aŋuna abunio Solomon kiwuapya Asitores akuj ŋina a ŋisidoniani ka Milikom akuj ŋina a Ŋiamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.5",
            "verseOrgIds": [
              "1KI.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Solomon kitiya ŋuna aronok alokiŋaren Ekapolon, abu nyiwuap Ekapolon anakiyookino, lopite ŋolo kebunio Daudi papa keŋ kiwuapya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.6",
            "verseOrgIds": [
              "1KI.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Solomon todukok akai a Cemes akuj a Ŋimoabi ka todukok akai a Milikom a akuj a Ŋiamoni kidiama emukura ŋolo eyai Kide Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.7",
            "verseOrgIds": [
              "1KI.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon todukonok ŋakais a ŋakuj a ŋaberu keŋ a ŋunamoen a ŋun a daadaŋ. Apotu ŋaberu ŋun yaanasi nakujo kec ekinyate ka ŋamuronisya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.8",
            "verseOrgIds": [
              "1KI.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun nai, abu Ekapolon toŋoik Solomon, anerae abu etau keŋ nyemitak Ekapolon Akuj ŋina a Isirael, ŋina aris ketakanu neni keŋ ŋarwa ŋaarei, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.9",
            "verseOrgIds": [
              "1KI.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido aris Ekapolon kicik Solomon atemar, nyemaikina iŋes iwuapi ŋakujo ŋace nai abu Solomon nyiwuap ŋuna ecikit Ekapolon iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.10",
            "verseOrgIds": [
              "1KI.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, abu Ekapolon tema neni a Solomon, “Ikwapei eraakatar ŋuna itiya iyoŋ ŋuna kon a elope, ido nyiwuapa iyoŋ Acamunet kaŋ ka ŋikisila kaŋ ŋulu abu ayoŋ ekecik iyoŋ, kire jik, elielaari ayoŋ apukan aneni kon, oinak neni a eketiyan kon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.11",
            "verseOrgIds": [
              "1KI.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai aŋuna a Daudi a papa kon, nyetiyakini ŋun eriŋa iyoŋ iyari. Elielaari ayoŋ apukan edoli ŋirwa ŋulu ipukaa lokoku kon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.12",
            "verseOrgIds": [
              "1KI.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeelielaari ayoŋ apukan daadaŋ; ainakini ayoŋ lokoku kon kipuka ekabila epei, aŋuna a eketiyan kaŋ a Daudi ka aŋuna a Yerusalem a ŋolo aseu ayoŋ aruwor etaun kaŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋimoe a Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.13",
            "verseOrgIds": [
              "1KI.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak nai Ekapolon lotau ka Adad ŋiman, abu toremokinos ka Solomon. Arae Adad lokoku ke erwosit alo Edom. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.14",
            "verseOrgIds": [
              "1KI.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekiŋaren sek apaki ŋina ajioto Daudi ka Ŋiedomi, kebu Yoab ekarikon ajore a Daudi tolot nakwap ŋina a Edom akinuk ŋikatwak, ido kebu iŋes apaki ŋin toar Ŋiedomi ŋulusapa daadaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.15",
            "verseOrgIds": [
              "1KI.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(anerae kepotu Yaob ka Ŋisirael daadaŋ kiboiyoto alo Edom ŋilapyo ŋikanikapei, akitodol ŋina amunyaryata ŋisapa alo Edom daadaŋ.) ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.16",
            "verseOrgIds": [
              "1KI.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai kebu Adad tosi tolot Ijipit ka Ŋiedomi, ŋice ŋulu arae ŋiketiyak a papa keŋ. Arae Adad edya ŋolo adit apaki ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.17",
            "verseOrgIds": [
              "1KI.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kepotu ikes torotokis alo Midian toloto tari Paran; toriko ŋikilyok alo Paran torukosi ka ikes Ijipit neni a Parao a erwosit a Ijipit, a ŋolo abu inak Adad akai, inanak iŋes akimuj ka inak daŋ ŋalup ŋuna toruwor ŋuna keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.18",
            "verseOrgIds": [
              "1KI.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tojokyar Adad aneni a Parao, aŋun, abu Parao inak nakaato ka aberu keŋ neni ka Adad toruwor aberu keŋ. Arae ŋin nakaato ka arwosit a ŋina anyaritae Tapenes. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.19",
            "verseOrgIds": [
              "1KI.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nakaato a Tapenes kidou ikoku ka Adad, tolimokinae ekiro keŋ Genubas. Kitopolou Tapenes ikoku ŋin alo kai a Parao. Kiboi Genubas alo kai a Parao erukito ka ŋidwe a Parao. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.20",
            "verseOrgIds": [
              "1KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eriŋa Adad eyai Ijipit, kiira atemar adau Daudi atwanare ikwapei atapapaakeŋ ka adau Yoab daŋ ekarikon ka ajore atwanare, tema Adad neni a Parao, “Kimyekinae ayoŋ alot, ikotere aboŋori nakwap kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.21",
            "verseOrgIds": [
              "1KI.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai abu Parao kiŋit iŋes tema, “Nyo icanakin iyoŋ aneni kaŋ ŋini icamitor iyoŋ tokona alosit nakwap kon?” Toboŋok iŋes tema, “Mam ibore, kimyekinae ayoŋ alot.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.22",
            "verseOrgIds": [
              "1KI.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak Akuj ŋiman lotau a emoit a Solomon a ece a ŋolo abu toremokinos ka iŋes, arae ŋol Reson, lokoku ke Eliada, ŋolo kebu tosi aneni a ekapolon keŋ a erwosit a ŋolo alo Soba aŋolo anyaritae Adadeser. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.23",
            "verseOrgIds": [
              "1KI.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ŋol tocunak ŋulu ewuapito iŋes, kituruwor iŋes bon ekarikon a ajore aŋulu aŋerite apukan a Soba apaki ŋina aarya Daudi ŋituŋa kec. Toloto ikes Damasko kiboiyoto a nen, toruwor Reson erwosit a Damasko. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.24",
            "verseOrgIds": [
              "1KI.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torubak Reson erae emoit ŋolo a Isirael ŋirwa daadaŋ ŋulu epukator Solomon, kican iŋes Solomon lopite ŋolo ecanitor Adad Solomon. Abu Reson kipuka Aram, torubak imanit Isirael.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toŋer Yeroboam Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.25",
            "verseOrgIds": [
              "1KI.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toŋer lokoku a Nebat ŋolo anyaritae Yeroboam Solomon. Arae Yeroboam epei a ŋikapolok anapukan a Solomon, ŋolo alo Sereda. Arae toto keŋ apuserut ŋina anyaritae Serua. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.26",
            "verseOrgIds": [
              "1KI.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro ŋuna aŋeryo Yeroboam erwosit ikes nu: Kebu Solomon toduk akititis ido kebu togolonok neni keorori anarwatata a ŋina ke etaun a Daudi a papa keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.27",
            "verseOrgIds": [
              "1KI.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae Yeroboam ekile ŋolo apedorit akitiyaa ejok nooi. Ani iŋolikini Solomon epite ŋolo etiyaa ekile ŋol ejok nooi, abu kiwuak iŋes apolokinit ŋulu areikinitae akitiya etic ŋolo ka akai a Yosepu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.28",
            "verseOrgIds": [
              "1KI.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋin, ani erotokini Yeroboam alo Yerusalem, abu iŋes kiryamun lorot ka ekadwaran ŋolo anyaritae Aija, ŋolo arae Esilonit Anapit Aija elou ŋolokitete apaki ŋin. Apotu ŋul ŋiarei make kiryamunos nariet alorot, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.29",
            "verseOrgIds": [
              "1KI.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "tolacu Aija elou keŋ ŋolokitete ŋolo anapit iŋes, tocilicili ŋacilet ŋatomon ka ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.30",
            "verseOrgIds": [
              "1KI.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema nai Aija neni a Yeroboam, “Ya ŋacileta ŋatomon toruwor ŋuna kon, anerae ŋakiro nu ikes alimu Ekapolon Akuj ŋina a Isirael ebe, ‘Kiira, alosi ayoŋ akielar apukan anakan a Solomon, ido okoinak iyoŋ ŋikabilae ŋitomon kipuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.31",
            "verseOrgIds": [
              "1KI.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai aŋuna a eketiyan kaŋ a Daudi ka aŋuna a etaun a ŋolo a Yerusalem, a ŋolo aseu ayoŋ alokabilae a Isirael a daadaŋ, ipukae iŋes ekabila epei bon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.32",
            "verseOrgIds": [
              "1KI.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiyae ayoŋ ŋun, anerae ekemyek ayoŋ, ido ilipi neni ka Asitores a akuj a ŋisidonianineni a Cemes a akuj a Ŋimoabi ka neni a Milikom a akuj a Ŋiamoni. Awou iŋes akiwuap ŋuna abala ayoŋ, nyitiya daŋ ŋuna iyookino alokiŋaren kaŋ, nyiwuapa daŋ ŋikisila kaŋ ka ŋuna atubunit ayoŋ kitiya iŋes lopite ŋolo etiyator Daudi ŋolo arae papa a Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.33",
            "verseOrgIds": [
              "1KI.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikote neni daŋ, nyalemari ayoŋ apukan daadaŋ anakan keŋ, nai emyekini ayoŋ iŋes kipuka ŋirwa daadaŋ ŋulu eyarya iŋes. Itiyakin ŋun ŋuna a eketiyan kaŋ a Daudi a ŋolo abu ayoŋ oseu, ido abu kiwuap ŋakiciketa kaŋ ka ŋuna atubunit ayoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.34",
            "verseOrgIds": [
              "1KI.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai alemari ayoŋ apukan anakan alokoku keŋ, okoinak iyoŋ. Apukan ŋin, iŋes ŋikabilae ŋulutomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.35",
            "verseOrgIds": [
              "1KI.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ainakini ayoŋ lokoku keŋ, ekabila epei, ikotere nai erubakinete ŋituŋa a eketiyan kaŋ a Daudi eyakasi kiŋaren kaŋ alo Yerusalem, alotaun a ŋolo aseu ayoŋ toyakaun ekiro kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.36",
            "verseOrgIds": [
              "1KI.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaseuni ayoŋ iyoŋ, ido ipukae iyoŋ neni daadaŋ ecamit etau kon; iruwor iyoŋ erwosit a ŋikabilae a ŋulu alowae aŋolo alo Kuju Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.37",
            "verseOrgIds": [
              "1KI.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiira iyoŋ daadaŋ ŋuna iyookino alokiŋaren kaŋ iwuapit ŋikisilakaŋ, ka ŋakiciciketa kaŋ, lopite ŋolo etiyaa Daudi eketiyan kaŋ, ikiruki iyoŋ ka ayoŋ, ido eturubakini ŋiletok kon erae ŋikepukak ekaku kon lopite ŋolo abunio eturubakinia ŋulu a Daudi. Akainakini ayoŋ iyoŋ ŋikabilae ŋulu alo Kuju Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.38",
            "verseOrgIds": [
              "1KI.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋakiro a ŋun, esicani ayoŋ ŋiletok a Daudi, nai meere ŋikaru ka ŋikaru.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Solomon kiwar epite ŋolo earya Yeroboam, nai abu Yeroboam apaki ŋin tosi tolot Ijipit, neni a erwosit Sisak a ŋolo a Ijipit. Kiboi iŋes alo Ijipit akitodol ŋina atwania Solomon.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atwanare a Solomon",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiticisyo a Solomon ŋuluce daadaŋ ka ŋuna daadaŋ etiyat iŋes ka ŋuna ka aosou keŋ, igiritae lokitaabo ŋolo a ŋiticisyo a Solomon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon kipuka Isirael daadaŋ alo Yerusalem ŋikaru ŋatomoniomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Solomon totwana ikwapei atapapaa keŋ ka aponi tonukae lotaun a Daudi a papa keŋ, kilunyokin Reoboam lokoku keŋ lokicoloŋ toruwor erwosit.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
