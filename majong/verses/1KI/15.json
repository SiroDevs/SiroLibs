              "1KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alokaru a ŋolo a ŋiuni ipukat erwosit Asa Yudaya, kisyak Baasa akipuka Isirael alo Tirisa; kipuka iŋes Isirael ŋikaru ŋatomonairei ka ŋiomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Baasa kitiya ŋuna aronok alokiŋaren Ekapolon, kiwuap ŋuna etiyat Yeroboam ka asecit ŋina abu Yeroboam torikok Ŋisirael toseca.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        }
