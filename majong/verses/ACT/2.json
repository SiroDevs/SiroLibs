{
  "id": "ACT.2",
  "number": "2",
  "bookId": "ACT",
  "reference": "Ŋitic. 2",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
