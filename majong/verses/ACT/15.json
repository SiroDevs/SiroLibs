          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiboiyoto Paulo ka Baranaba alo Antiokio, itatamete ka elimonokinete ŋakiro ŋuna ke Ekapolon, kaapei ka ŋice daŋ ŋulu alalak.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
