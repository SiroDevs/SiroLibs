      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Totyakas Paulo ka Baranaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
