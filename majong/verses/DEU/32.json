          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erae ikes ŋituŋa ŋulu emam aosou,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.28",
            "verseOrgIds": [
              "DEU.32.28"
