          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe ŋituŋa a ŋakwapin, kitopoloosi ŋituŋa a Ekapolon",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.43",
            "verseOrgIds": [
              "DEU.32.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Todwarae atwanare a Moses",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 32:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋinapei, kirwor Ekapolon neni a Moses tema, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kitipeiyo lomoru ŋulu ka Abarim, todoka lomoru Nebo ŋolo eyai nakwap a Moab ŋolo iteosi ka Yeriko, torou akwap a Kanaan ŋina abuni ayoŋ ainakin neni a Ŋisirael aruwor ŋina kec, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "itwani iyoŋ ikwapei atapapaa kon alokidiama emoru ŋolo idokari iyoŋ, lopite ŋolo atwana lokaato kon Aron alomoru Or ikwapei atapapaa keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae ipotu iyes daadaŋ ŋiarei nyikikinyoma ayoŋ alotuŋa a Isirael apaki ŋina iyakatar neni aya ŋakipi ŋuna a Meribas-Kades analoŋisat a Sin ka aŋuna pa itoodiuniata iyes asegis kaŋ alokiŋaren Ŋisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari kiŋolik iyoŋ akwap ŋin aneni alwanan, nyilomari iyoŋ nakwap ŋina abuni ayoŋ ainakin Ŋisirael.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
