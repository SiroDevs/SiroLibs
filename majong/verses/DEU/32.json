          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kire jik, ituruwori Ekapolon ŋituŋa keŋ ŋulu iyookino,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.36",
            "verseOrgIds": [
              "DEU.32.36"
            ]
          }
        }
