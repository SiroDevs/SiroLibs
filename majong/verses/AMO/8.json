        },
        {
          "text": "Abu Ekapolon ekesileerek ayoŋ ŋakiro nu: Abu ayoŋ eŋolik Ebukit ŋolo aya ŋaraito ŋuna akonok. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
            "verseOrgIds": [
              "AMO.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekeŋit ayoŋ Ekapolon tema, “Amos, nyo ite iyoŋ?” Oboŋok ayoŋ otema, “Ete ayoŋ ebukit ŋolo eya ŋaraito ŋuna akonok.” Tema nai Ekapolon neni kaŋ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        }
      ]
