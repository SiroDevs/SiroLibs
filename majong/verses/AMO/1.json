        },
        {
          "text": "Erae nu ŋakiro ka Amos a ŋolo arae epei a ŋikeyokok alotaun a ŋolo anyaritae Tekoa. Abu Akuj kisileerek Amos aŋuna a Isirael alorwa a ŋulu epukator Usia Yudaya, kipukate Yeroboam lokoku a Yoas Isirael. Esileerekini Akuj Amos ŋakiro nu ŋikaru ŋiarei eriŋa nyeyakauna amaranikinet ka akwap.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atubokino a ŋikidunyet a Isirael",
          "type": "text"
        }
      ]
    },
