{
  "id": "2TH.3",
  "number": "3",
  "bookId": "2TH",
  "reference": "2 Ŋites. 3",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
