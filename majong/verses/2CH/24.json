          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keponi towanae Yoas nooi, ani kerotokis ŋasigarya ka Aram, apotu ŋikapolok ŋiarei ŋulu sek epukatotor iŋes kimana Yoas aŋuna ka akinyaŋarya Sakariya lokoku a esacaradoti a Yeoiyada, ido toara iŋes alokitaada keŋ. Aponi nai Yoas tonukae lotaun a Daudi, nai meere neni anukitae ŋirwosi ŋuluce. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋikapolok ŋuluarei ŋulu apotu toara Yoas ikes Sabad lokoku a Simeas a ŋina arae Amonait, ŋoloce iŋes Yeosabad lokoku a Simiris a ŋina arae Amoabait. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro a ŋidwe a Yoas aŋulusapa ka ŋuna kedwaryo itoroniyaritae Yoas ta ŋuna ka adukokin iŋes Akai ka Akuj nabo, igiritae lokitaabo ŋolo isileereunit ŋakiro ŋuna eya lokitaabo ŋolo a Ŋirwosi. Abu nai Amasia lokoku keŋ kilunyokin lokicoloŋ kipuka Yudaya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
