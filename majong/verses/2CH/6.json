          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani keseca ikes neni kon, anerae mam ŋini nyesecenene, ido toŋoik iyoŋ ikes, kipotok lomoe kec, ikotere erikorete ŋimoe ikes nakwap kec erae ŋikikamara alojie, yaarae ikes neni elwana, kori neni eapi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani nai ketamut ikes anakwap a ŋina erikoryo ŋuna kepotu kitiyata, ido tokiwa, todyekanaros neni kon anakwap a ŋulu arikorete ikes, temasi, ‘Ikisec isua ka ikitiya ŋuna nyiyookino; ikitiya isua ŋuna a ŋileec;’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ani kekiwa ikes alotai kec a daadaŋ ka anakiyar kec a daadaŋ anakwap a ŋina a ŋimoe kec a ŋulu arikorete ikes erae ŋikikamara alojie, ido kilipa ikes neni kon iŋoliunito nakwap kec, ŋina ibu iyoŋ inak atapapaa kec ka lotaun ŋolo idau iyoŋ aseun ta Kai ŋina adau ayoŋ akiduk aŋuna ka akilipya neni kon; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekelipit kiira anakuj aneni erae akibois ŋina iboiyo iyoŋ akilip ka adyekitoi kec, ido kiŋarak ikes anatyonis a ŋin. Kisyoni ŋituŋa kon ŋulu adaut akisec aneni kon. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tokona okoe Akuj kaŋ, kiŋolik ka kiira akilip ŋina ilipyo anakibois a na.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
