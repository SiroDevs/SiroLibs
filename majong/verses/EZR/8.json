    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikarikok a ŋikalya ŋulu aboŋorete kaapei ka Esira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae lu ŋikarikok a ŋikalya ka ŋirorwa atapapaa a Ŋisirael a ŋulu apotu etipeiyosi kaapei ka ayoŋ alo Babilon alorwa a ŋulu epukator erwosit Aritaseses. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.1",
            "verseOrgIds": [
              "EZR.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Pineas ayai Gerisom, aloletok a Isamar ayai Daniel aloletok a Daudi ayai Atus ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.2",
            "verseOrgIds": [
              "EZR.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "lokoku a Sekania, aloletok a Paros ayai Sakariya ka ŋikilyok apei miat ka ŋatomonikan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.3",
            "verseOrgIds": [
              "EZR.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Paros-Moab ayai Elieoenai lokoku a Seraia ka ŋikilyok ŋamiae ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.4",
            "verseOrgIds": [
              "EZR.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Saitu ayai Sekania lokoku a Yaasiel ka ŋikilyok ŋamiae ŋauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.5",
            "verseOrgIds": [
              "EZR.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok ka Adin ayai Ebed lokoku a Yonasan ka ŋikilyok ŋatomonikan. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.6",
            "verseOrgIds": [
              "EZR.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Elam ayai Yesaia lokoku ka Asalia ka ŋikilyok ŋatomonikanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.7",
            "verseOrgIds": [
              "EZR.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Sepatia ayai Sebadia lokoku a Mikael ka ŋikilyok ŋatomonikanikauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.8",
            "verseOrgIds": [
              "EZR.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok ka Yoab ayai Obadia lokoku ka Yeiel ka ŋikilyok ŋamiae ŋaarei ka ŋitomon ka ŋikanikauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.9",
            "verseOrgIds": [
              "EZR.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok ka Bani ayai Selomis lokoku a Yosipia ka ŋikilyok apei miat ka ŋatomonikanikapei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.10",
            "verseOrgIds": [
              "EZR.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Bebai ayai Sakariya lokoku a Bebai ka ŋikilyok ŋatomoniarei ka ŋakanikauni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.11",
            "verseOrgIds": [
              "EZR.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok ka Asigad ayai Yoanan lokoku ka Akatan ka ŋikilyok apei miat ka ŋitomon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.12",
            "verseOrgIds": [
              "EZR.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok ka Adonikam a ŋulu apote ekaku, ŋirorwa kec lu: Elipelet, Yeuel ka Semaia ka ŋikilyok ŋatomonikanikapei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.13",
            "verseOrgIds": [
              "EZR.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aloletok a Bigipai ayai Usai ka Sakur ka ŋikilyok ŋatomonikanikaarei.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋiketiyak ka Akai ka Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.14",
            "verseOrgIds": [
              "EZR.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ ocunak ikes diyete aŋolol ŋina elele Aapa, aponi isua kiriyae a nen ŋirwa ŋiuni. Ani emarakini ayoŋ ŋituŋa ka ŋisacaradotin, abu ayoŋ aryamu atemar amam ŋiletok a Lepi aya nen. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.15",
            "verseOrgIds": [
              "EZR.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi abu ayoŋ eyakiya ituŋanan anyarare Eliesar, Ariel, Semaia, Elinasan, Yarib, Nasan, Sakariya ka Mesulam ŋulu arae ŋikarikok, abu daŋ onyara Yeoiarib ka Elinasan ŋikilyok ŋulu aosok, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.16",
            "verseOrgIds": [
              "EZR.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "abu ayoŋ eyakiya ikes neni ka Ido a ekarikon a ŋituŋa a ŋulu aya Kasipia olimok ikes ŋuna emaikina tolimokis Ido ka ŋirukitos keŋ ŋulu arae ŋiketiyak ka Akai ka Akuj alo Kasipia, ikotere ikes ikiyakikis isua ŋiketiyak ŋulu a Akai ka Akuj kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.17",
            "verseOrgIds": [
              "EZR.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwapei ikiŋarakinitor isua Ekapolon, apotu ikes ikiyakikis isua Serebia ekile ŋolo ajokak ŋipitesyo ŋolo arae epei a ŋiletok a Mali alokoku a Lepi a ŋolo arae lokaku a Isirael, abu Serebia torukut ka ŋidwe keŋ ka ŋiyeneta keŋ arae ikes daadaŋ ŋitomon ka ŋikanikauni, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.18",
            "verseOrgIds": [
              "EZR.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "torukut daŋ ikes ka Asabia ta Yesaia ŋulu arae ŋiletok a Merari ka ŋiyeneta kec ta ŋidwe kec arae daadaŋ ŋatomoniarei ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.19",
            "verseOrgIds": [
              "EZR.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "pa imaritae ŋiketiyak ka Akai ka Akuj ŋamiae ŋaarei ka ŋatomoniarei ŋulu apotu Daudi ka ŋikapolok ŋulu epukatotor iŋes totyakasi aŋuna ka akitiyanakin ŋilepi. Aponi tonyarae ŋituŋa ŋul daadaŋ a ŋirorwa kec.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiredakin akiron ka akilip aŋuna ka aiuno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.20",
            "verseOrgIds": [
              "EZR.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai ayoŋ olimu atemar kiredakinae akiron anaŋolol Aapa, emika ŋawat kosi alokiŋaren Akuj kosi ibore ŋini ecamito ka eŋita iŋes ikiyok isua analosit kosi kaapei ka ŋidwe kosi ka a ŋuna a ŋiboro a daadaŋ ŋulu ikiyakar isua, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.21",
            "verseOrgIds": [
              "EZR.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekerumito ayoŋ ŋileec akiŋit erwosit ainakin isua ŋasigarya ka ŋaŋolei ka ŋikametok kec aŋuna ka aiun isua alomoe alosyo alorot, anerae aris isua kelimokin erwosit atemar iŋarakini Akuj daadaŋ ŋulu ikinyomito, iŋes, eyai nai apedor keŋ ka anyunyura keŋ neni a ŋulu eŋerito iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.22",
            "verseOrgIds": [
              "EZR.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, aponi isua kiredakinae akiron ka odyeka Akuj kosi aŋuna a ŋakiro a ŋun, ido abu iŋes kiira adyekitoi kosi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋainakineta aŋuna ka Akai ka Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai ayoŋ otyaka ŋisacaradotin ŋitomon ka ŋiarei ŋulu arae ŋikarikok kec ikes lu: Serabia, Asabia ka ŋiyeneta kec ŋitomon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi abu ayoŋ epimak ikes esilipa ka egolid ka oinak ikes ŋiboro ŋulu isitiyao alo Kai ka Akuj, arae ŋul daadaŋ ŋainakineta aŋuna ka Akai ka Akuj yok, ŋainakineta ŋuna apotu erwosit inakis kaapei ka ŋulu iŋaranakinito iŋes akipuka, ŋikapolok anapukan keŋ ta Ŋisirael daadaŋ ŋulu eboiyete anakwap a ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ epimak ikes ŋakiloi ŋalipyo ŋaarei ka ŋamiae ŋaarei ŋuna ke esilipa ka ŋiboro ŋulu isitiyao alo Kai ka Akuj ŋulu etiyaunitae ke esilipa apei miat ŋulu arae apotis kec ŋakiloi ŋatomonikanikaarei, ŋakiloi ŋalipyo ŋauni ka ŋamiae ŋaomwon ŋuna ke egolid, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋabakulei ŋatomoniarei ŋuna etiyaunitae ke egolid ŋuna arae apotis kec ŋakiloi ŋuna aapikinito ŋakanikauni ka atutubet ka ŋabakulei ŋaarei ŋuna etiyaunitae ke eburonis a ŋolo ajokan a ŋolo apwasitae, ariyan egyelit a ŋabakulei a ŋun ka ŋolo a ŋabakulei a ŋuna etiyaunitae ke egolid. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi abu ayoŋ olimok ikes otema, “Ikitaleoritae iyes neni ke Ekapolon, italeoritae tari ŋiboro ŋulu isitiyao alo Kai ka Akuj, ido erae esilipa ka egolid ŋainakineta ŋuna elemunitae aŋuna ke Ekapolon Akuj atapapaa kus. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyoko ikes ka kiricakisi ikes tari ŋina ipimiata iyes ikes alokiŋaren ŋisacaradotin ka ŋilepi ta ŋikarikok a ŋikalya a Ŋisirael alo Yerusalem alotooma ŋagulei ŋuna a Akai ke Ekapolon.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu ŋisacaradotin ka ŋilepi kijaasi esilipa, egolid ka ŋabakulei apaki ŋina epimere ikes, ikotere eyaarete Yerusalem, Kai ka Akuj kosi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aboŋor Yerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZR 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi nai isua torotokinoe anaŋolol Aapa ŋirwa ke elap ŋitomon ka ŋiarei elap ŋolo ke epei, aŋuna ka alosit Yerusalem, ikiŋarakinit isua Ekapolon, abu iŋes ikiiu isua anapedor a ŋimoe kosi ka alotuŋa a ŋulu ikidapito isua alorot. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.31",
            "verseOrgIds": [
              "EZR.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZR 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Todolunoe isua Yerusalem kiboi a nen ŋirwa ŋiuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edolete ŋirwa ŋiomwon eyakae Kai ka Akuj kosi, aponi kipimae esilipa, egolid ka ŋabakulei, inakinae neni a esacaradoti Meremos alokoku ka Uria, arukito iŋes ka Eleasar lokoku a Pineas, arukito ikes ka ŋilepi lu: Yosabad lokoku ka Yesua ka Naodia lokoku a Binui. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi tocunakinae ŋiboro ŋul daadaŋ, ido kipimae ka aponi kigirakinae lokitaabo apotis a ŋiboro a daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
      ]
    },
