              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋin, apotu ŋituŋa ŋulu aboŋunete anakwap a ŋina arikoritae ikes inakis ŋainakineta ŋuna epeyo neni ka Akuj a Isirael; inakis ikes ŋimoŋin ŋitomon ka ŋiarei aŋuna a Ŋisirael a daadaŋ, ŋimesekin ŋatomonikanikaomwon ka ŋikanikapei, ŋikaalei ŋulumesekin ŋatomonikanikaarei ka ŋikanikaarei, tosodi ikwapei ainakinet aŋuna ka asecit apotu ikes inakis ŋikorwa ŋitomon ka ŋiarei. Arae ŋul daadaŋ ŋainakineta ŋuna epeyo neni ke Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu daŋ ikes kikobakis ŋakiro a erwosit neni a ŋikepukak ŋakwapin ka ŋikapolok a ŋakiboisyo ŋuna alokekwaye aŋolol Eupurate, ido apotu ŋikepukak ŋul ka ŋikapolok ŋul kiŋarakis Ŋisirael ka Akai ka Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
      ]
