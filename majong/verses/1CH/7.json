        },
        {
          "text": "Arae ŋidwe ka Aser ŋulusapa lu: Imina, Isipa ka Isipi ta Beria. Anyaritae ŋinapese Sera. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
