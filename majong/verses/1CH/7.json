              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋidwe a Yapilet ŋulusapa lu: Pasak ka Bimal ta Asipas. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
