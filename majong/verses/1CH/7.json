              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋidwe ke Eber ŋulusapa lu: Yapilet ka Somer ta Osam. Anyaritae ŋinapese Sua. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
