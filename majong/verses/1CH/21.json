              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Ekapolon tolimok emalaika akinyakakin ekileŋ keŋ nakuraro, ido abu emalaika kinyakak ekileŋ nakuraro.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.27",
            "verseOrgIds": [
              "1CH.21.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akibois ŋina aseunitae aŋuna ka Akai ka Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
