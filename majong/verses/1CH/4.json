          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoel, Yeu lokoku a Yosibia a ŋolo arae lokoku a Seraia a ŋolo arae lokoku ka Asiel, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.35",
            "verseOrgIds": [
              "1CH.4.35"
            ]
          }
