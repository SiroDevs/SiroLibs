          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toara Ŋiamaleki ŋulu kidoŋito nen, ŋulu sek kepotu tobucar. Iboiyete tokona Ŋisimeoni ŋul a nen tari nakoloŋit na.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
              "1CH.4.43"
            ]
          }
        }
