          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋice ikes Elibenai, Yaakoba, Yosoaya, Asaia, Adiel, Yesimiel, Benaia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.36",
            "verseOrgIds": [
              "1CH.4.36"
            ]
          }
        },
