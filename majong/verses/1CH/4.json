              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikilyok lu ŋikarikok a ŋatekerin kec: Mekobab, Yamilek, Yosa lokoku ka Amasia, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.34",
