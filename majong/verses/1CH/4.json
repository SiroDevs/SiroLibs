          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sisa lokoku a Sipi a ŋolo arae lokoku ka Alon a ŋolo arae lokoku a Yedaia a ŋolo arae lokoku a Simiri a ŋolo arae lokoku a Semaia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.37",
            "verseOrgIds": [
              "1CH.4.37"
            ]
          }
        },
