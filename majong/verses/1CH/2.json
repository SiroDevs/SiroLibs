              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.41",
            "verseOrgIds": [
              "1CH.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋidwe a Kaleb alokaato a Yerameel ŋulusapa lu: Mesa iŋes ŋolokiyae, ŋolo abu touru Sip. Anyaritae lokoku a Kalubai ŋoloce Maresa, ŋolo abu touru Eburon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.42",
            "verseOrgIds": [
              "1CH.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋidwe ke Eburon ŋulusapa lu: Kora, Tapua ka Rekem ta Sema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.43",
            "verseOrgIds": [
              "1CH.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Sema touru Raam, touru Raam Yorekeam. Abu Rekem touru Samai. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.44",
            "verseOrgIds": [
              "1CH.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaritae lokoku a Samai Maon, ido abu Maon touru Bes-Sur. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.45",
            "verseOrgIds": [
              "1CH.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Epa aberu a Kaleb ŋina pa eitit touru Aran ka Mosa ta Gases. Abu Aran touru Gases. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.46",
            "verseOrgIds": [
              "1CH.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CH 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋidwe a Yadai ŋulusapa lu: Regem, Yosam, Gesan, Pelet ka Epa ta Saap. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.47",
            "verseOrgIds": [
              "1CH.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CH 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maka aberu a Kaleb ŋina pa eitit iŋes abu touru Seber ka Tirana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.48",
            "verseOrgIds": [
              "1CH.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu daŋ Maka touru Saap ŋolo abu touru Madmana ka Sepa ŋolo abu touru Makibena ka Gibea. Ayakar daŋ Kalubai nakoku keŋ ŋina anyaritae Akisa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.49",
            "verseOrgIds": [
              "1CH.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CH 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae lu ŋipapae a Kalubai, ŋidwe a Ur ke ekiyae a Kalubai ka aberu keŋ Epurasa ŋulusapa: Sobal ŋolo abu kisyak Kirias-Yearim. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.50",
            "verseOrgIds": [
              "1CH.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CH 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saluma ŋolo abu kisyak Betelem ka Arep ŋolo abu kisyak Bes-Goder. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.51",
            "verseOrgIds": [
              "1CH.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CH 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae lu ŋipapae a Sobal a ŋolo abu kisyak Kirias-Yearim; ŋituŋa ŋulu anyaritae Ŋiaroi, atutubet a Ŋimanasi ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.52",
            "verseOrgIds": [
              "1CH.2.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CH 2:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ŋatekerin nu ŋuna a ŋituŋa a Kirias-Yearim: Ŋiisiri, Ŋipusi, Ŋisumasi ka Ŋimisirai. Lotuŋa lu iŋes aponiata Ŋisorasi ka Ŋiesitaoli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.53",
            "verseOrgIds": [
              "1CH.2.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CH 2:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae lu ŋipapae a Saluma, ŋituŋa a Betelem, Ŋinetopasi, Ŋiatirosibesiyoab, atutubet a Ŋimanasi, Ŋisori, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.54",
            "verseOrgIds": [
              "1CH.2.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CH 2:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋatekerin a ŋituŋa a ŋulu ayenete akigir nooi, a ŋulu eboiyete alo Yabes. Ŋatekerin ŋun ikes nu: Ŋitirasi, Ŋisimeasi ka Ŋisucasi. Arae ŋatekerin ŋun ŋuna a Ŋikeni a ŋulu apote aneni ka Amas, a ŋolo arae papa a Ŋirecabi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.2.55",
            "verseOrgIds": [
              "1CH.2.55"
            ]
          }
        }
      ]
    }
