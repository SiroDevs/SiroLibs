        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema ŋini erworo neni kaŋ, “Okoe lokoku a ituŋanan, tonyam ibore ŋini ikiinakinitae iyoŋ; tonyam ekitaabo lo, ido tolot kisirwor Ŋisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai ayoŋ oŋaam, okoinak iŋes ayoŋ ekitaabo onyam.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema iŋes neni kaŋ, “Lokoku a ituŋanan, tonyam ekitaabo lo ŋolo akainakinit ayoŋ iyoŋ kisimwon akook kon.” Aŋun, abu ayoŋ onyam ekitaabo, oryamu ayoŋ ebob nooi anakituk kaŋ ikoni ao.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema ŋini erworo neni kaŋ, “Lokoku a ituŋanan ape tokona neni a Ŋisirael kirwor ŋakiro kaŋ pei neni kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyekeyakiyarit ayoŋ iyoŋ lotuŋa ŋulu nyileerete aneni kon ŋakiro ŋuna irworosi ikes ka ŋulu etyono a ŋajep kec, nai neni a Ŋisirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyekeyakiyarit ayoŋ iyoŋ nakwapin ŋuna alalak ŋuna nyileerete aneni kon ŋakiro ŋuna irworosi ikes ka ŋulu etyono a ŋajep kec. Ani kire kekeyakiya ayoŋ iyoŋ neni kec, epupokinete ikes ŋakiro ŋuna irworo iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai emam Ŋisirael ŋini ecamuni apupokin ŋakiro ŋuna irwori iyoŋ, anerae nyecamito daadaŋ akiirar ŋuna erworo ayoŋ aŋuna etogogoŋioto ŋakyes kec ka aruworotor ŋasyanisya alotai kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiira, ilaerekini iyoŋ ŋakiro kec lopite ŋolo elaerekioto ikes anakiro aŋuna irworo iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eketuruwori ayoŋ iyoŋ ŋolo igogoŋ ikwa amoru ka ŋolo nyiryaŋiryaŋa ikwa ataaba. Nyikuryaniar aŋuna a ŋituŋa a ŋul, kori nyikitubulo ikes iyoŋ iŋolikini, tari daŋ kerae ikes ekal ŋolo aŋeron.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema ŋini erworo neni kaŋ, “Lokoku a ituŋanan, topupok mono iyoŋ icoikinit nooi ka kiwuak lotau kon ŋakiro daadaŋ ŋuna erwori ayoŋ neni kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ape tokona neni a ŋituŋa a akwap kon a ŋulu erikoritae nakwapin ŋace, ido kirwor neni a ŋituŋa kon, tema neni kec, ‘Ŋakiro ŋuna irworo Ekapolon Akuj ikes nu,’ ebe, ‘Kecamito ikes akiirar ŋakiro ŋuna irworo iyoŋ, kori pa kecamito.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esekiel anaŋolol Kebar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Etau ŋolo ka Akuj ekekyaa ayoŋ kidiama, eiira ayoŋ alokaku kaŋ eruye ŋolo acela nooi ŋolo alosi atipei ebala, “Kipuroe apolou ŋina ke Ekapolon alokidiama anakuj!” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae eruye ŋol ŋolo aŋiŋatar ŋabebenuk a ŋisubuna a ŋulu ayarete ka ŋolo a ŋiboorei a ŋulu ekwaan ka ŋakejen a agaari a ŋulu aya diyete ŋisubuna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.13",
            "verseOrgIds": [
              "EZK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai Etau ŋolo ka Akuj ekekyaa ayoŋ kidiama okoya a nen, abu ayoŋ onyunyur ka abu etau kaŋ toŋo aŋuna eketiŋakinitor Ekapolon ayoŋ ŋuna acamit iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ odol neni a ŋirikon a ŋulu ayakasi Tel-Abib diyete aŋolol Kebar. Abu ayoŋ eboiyoto ka ikes a nen ŋirwa ŋikanikaarei ekeilorito ŋakiro etau ŋuna abu eŋolik.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edaun ŋirwa ŋikanikaarei, abu Ekapolon kirwor neni kaŋ tema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lokoku a ituŋanan, eketuruwo ayoŋ iyoŋ ekeyokon Ŋisirael, apaki daadaŋ ŋina iirarya iyoŋ ŋakiro aneni kaŋ, emaikina iyoŋ tolimok ikes ŋuna abala ayoŋ tocoikisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.17",
            "verseOrgIds": [
              "EZK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kalimok ayoŋ ŋulu aronok ebe, ‘Itwakete iyes kire jik, ido towou iyoŋ alimokin ikes acoikin aronis kec, kori towou iyoŋ akirwor ŋakiro ŋuna iteesikinete ikes aronis kec ikotere eiunete akiyar kec, etwakete kire jik ŋikaronok ŋul aŋuna ka asecit kec, ido emarakini ayoŋ atwanare kec erae nakou kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.18",
            "verseOrgIds": [
              "EZK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani kilimok iyoŋ ŋituŋa ŋulu aronok aesikin aronis kec, ido toŋero aesikin aronis kec, kori kitiyata ŋuna aronok, etwakete ŋituŋa ŋul aŋuna ka asecit kec; nai iuni iyoŋ akiyar kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋace nu, ani keesikis ŋituŋa ŋulu iyookino akiyookino kec, ido kitiyata ŋuna aronok, ido ewuak ayoŋ ibore ŋini itukuruwori ikes akitiya ŋuna aronok, etwakete ŋituŋa ŋul, anerae nyelimokina iyoŋ ikes aesikin akitiya ŋuna aronok, etwakete ikes aŋuna ka asecit kec, nyetamunio nabo jik ŋuna ka akiyookino a ŋina sek etiyato ikes, nai emarakini ayoŋ atwanare kec nakou kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.20",
            "verseOrgIds": [
              "EZK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani kilimok iyoŋ ŋulu iyookino akiŋer asecit, ido toŋero ikes asecit, eyarete kire jik ikes, anerae apotu kiirasi ŋuna ibala iyoŋ tocoikisi; iŋes atemar iuni iyoŋ akiyar kon.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Totyakarae Esekiel neni keŋ bon kisililiŋae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.21",
            "verseOrgIds": [
              "EZK.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu apedor ŋina ke Ekapolon bu neni kaŋ aneni akatyakaritae, tema Ekapolon neni kaŋ, “Tonyou, ape totiyaar nakadipaalat, ido ekesirworik ayoŋ iyoŋ a nen.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.22",
            "verseOrgIds": [
              "EZK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nai ayoŋ onyou a nen, otiyaar nakadipaalat, abu akica ŋina ke Ekapolon toyakaun nakadipaalat, ekwaan akica ŋin ka ŋina sek eŋolikinit ayoŋ anaŋolol Kebar. Abu ayoŋ oper obuburiyar. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.23",
            "verseOrgIds": [
              "EZK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bu nai etau ŋolo ka Akuj tooma kaŋ, eketonyou ayoŋ, tema neni kaŋ, “Ape togolokin kai kon. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikienio iyoŋ lokoku a ituŋanan a ŋaunoi, nyipedo iyoŋ alosit neni eya ŋituŋa ŋuluce. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emiidikini ayoŋ aŋajep kon nakituk kon alokidiama, ikotere iyoŋ ililiŋi todaun alimokinet ikes acoikin ŋuna aronok ŋuna itiyaete, anerae erae ikes ekal ŋolo aŋeron. ",
          "type": "text",
