            }
          ]
        },
        {
          "text": "Abu Ekapolon kirwor neni kaŋ tema, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
