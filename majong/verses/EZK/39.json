    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tomunyarae ŋasigarya a Gog",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon Akuj kirwor neni kaŋ tema, “Lokoku a ituŋanan, todwar itoroniyarit Gog, tolimok iŋes atemar alimu Ekapolon Akuj ebe, ‘Okoe Gog, ekemanit ayoŋ iyoŋ, iyoŋ ekepukan ŋolo ipolokinit Mesek ka Tubal. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.1",
            "verseOrgIds": [
              "EZK.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekesirimirimokini ayoŋ iyoŋ, okomyaa tolot kiŋaren, ibu alo Kuju ainati kaina. Akarikuni ayoŋ iyoŋ ibu torem ŋituŋa ŋulu iboiyete alokamukumukui a ŋulu a Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.2",
            "verseOrgIds": [
              "EZK.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abili ayoŋ akau a ŋikaleŋeleŋe kon anakan kon a ŋina alokyedeny, emyek ŋikaleŋeleŋe tocakakin kwap anakan kon a ŋina aloteten. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.3",
            "verseOrgIds": [
              "EZK.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwanikini iyoŋ kidiama ŋikamukumukui ŋulu a Isirael, kaapei ka ŋasigarya kon daadaŋ ta ŋituŋa ŋulu irukito ka iyoŋ. Ekepotokini ayoŋ iyoŋ neni a ŋolokabila a ŋikeny a daadaŋ a ŋulu anyamak ŋituŋa; ekepotokini ayoŋ iyoŋ neni a ŋityaŋ a ŋulu ka ariet, ikotere itonyam iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.4",
            "verseOrgIds": [
              "EZK.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itwanikini iyoŋ neni elapat anariet, ayoŋ Ekapolon Akuj adau alimun ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.5",
            "verseOrgIds": [
              "EZK.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "eyakuuni ayoŋ akim bu nakwap Magog ka neni a ŋituŋa a ŋulu iboiyete anakiboisyo a ŋuna emam awasya alodiyete anam; eyenunete ŋituŋa ŋul atemar arae ayoŋ Ekapolon.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.6",
            "verseOrgIds": [
              "EZK.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Etaanyuni ayoŋ ŋituŋa kaŋ Ŋisirael ekiro kaŋ ŋolo asegan; nyacamuni nabo ayoŋ tojamuwarae ekiro kaŋ ŋolo asegan, eyenunete ŋituŋa a ŋakwapin atemar arae ayoŋ Ekapolon, Akuj ŋina asegan ŋina ayai Isirael. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.7",
            "verseOrgIds": [
              "EZK.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimu Ekapolon Akuj atemar eponito ŋakiro ŋun, itiyakinosi ŋakiro ŋun kire jik. Akoloŋit ŋin iŋes abu ayoŋ ekiŋaren erwor ŋakiro keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.8",
            "verseOrgIds": [
              "EZK.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Akoloŋit ŋin, elomarete ŋituŋa a Isirael ŋulu iboiyete alotaunio kiŋa ŋitaunio, kisitiyata ŋiboro ŋulujiet erae ŋakito ŋuna inokyo. Inokete ikes ŋiupala ŋulucicik ka ŋuna apolok, ŋakausinei a ŋikaleŋeleŋe ka ŋikaleŋeleŋe, ŋabiroi ŋuna ejiere ka ŋakwaaras. inokete ikes ŋiboro ŋul ŋikaru ŋikanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.9",
            "verseOrgIds": [
              "EZK.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyemitakinete ikes akikeyen ŋakito anariet, kori akiyep ŋikito ŋidi anamoni aŋuna a ŋakito, anerae inokete ŋakimya kec a ŋiboro a ŋulujiet. Eŋatarete ikes ŋiboro a ŋituŋa a ŋulu apotu toŋatasi ŋiboro kec ka elemarete ikes ŋiboro a ŋituŋa a ŋulu apotu tolemasi ŋiboro kec.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tonukae Gog",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.10",
            "verseOrgIds": [
              "EZK.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon tema, “Akoloŋit ŋin, ainakini ayoŋ Gog akibois ŋina enukakinio alo Isirael, ainakini ayoŋ iŋes akibois ŋin anakadipaalat a ŋikalotok, Kide Anam ŋina Atwan. Ekuryakiata ŋikalotok akitor nakadipaalat ŋin, anerae arae nen aponi tonukakinae Gog ka ŋajoresyo keŋ daadaŋ; enyarao akadipaalat ŋina ka Amon-Gog. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:11",
              "type": "text"
            },
            {
              "text": "Amon-Gog:",
              "type": "text"
            },
            {
              "text": "Iŋes atemar ŋina a ŋajoresyo a Gog.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.11",
            "verseOrgIds": [
              "EZK.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edoli ŋitapyo ŋikanikaarei enukete Ŋisirael ŋituŋa ŋul, ikotere kitojoka akwap kec nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.12",
            "verseOrgIds": [
              "EZK.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enukete ŋituŋa a akwap a Isirael daadaŋ ŋituŋa ŋul, itopolooryo ikes a ŋakiro a ŋun akoloŋit ŋina etoodiunia ayoŋ apolou kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.13",
            "verseOrgIds": [
              "EZK.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaku a ŋilapyo a ŋikanikaarei, eseunio ŋikilyok ŋulu erae etic kec alosenen ŋinakibois daadaŋ anakwap a Isirael, ikotere enukete ŋawat a ŋikaremok a ŋul, ŋuna eriŋa eyakasi nakwap kec; erae ŋun aŋuna ka akitojok ikes akwap kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.14",
            "verseOrgIds": [
              "EZK.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani apaki ŋina irimitotor ŋikilyok ŋul ŋakiboisyo, emaikina ituŋanan kiwuak ibore idio nakoyo ŋun ŋini itoodiunit atemar eya ŋakoyo nen, erubakini ibore ŋin eyai nen akitodol ŋina enukiata ŋikilyok ŋul ŋakoyo ŋun neni enyaritae akadipaalat ŋina ka Amon-Gog. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.15",
            "verseOrgIds": [
              "EZK.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Eyakaun daŋ nakadipaalat ŋin etaun ŋolo enyaritae Amona.) ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:16",
              "type": "text"
            },
            {
              "text": "Amona",
              "type": "text"
            },
            {
              "text": "Iŋes atemar ŋajoresyo a Gog",
              "type": "text"
            }
          ]
        },
        {
          "text": " Alopite a ŋol, itojokete ŋikilyok ŋul akwap kec.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.16",
            "verseOrgIds": [
              "EZK.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lokoku a ituŋanan, alimu Ekapolon Akuj ŋakiro nu atemar tonyarau ŋikabilae a ŋikeny daadaŋ ka ŋityaŋ ŋulu ka ariet daadaŋ, tolimok ikes ebe, ‘Tocunakinos, ido potu kaapei anakiboisyo a daadaŋ akinyam ŋituŋa ŋulu aarit ayoŋ aŋuna kus, aarit ayoŋ ŋituŋa ŋulu alalak nooi alokamukumukui a ŋulu a Isirael, inyamete iyes akiriŋ kec ka imasete ŋaokot kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.17",
            "verseOrgIds": [
              "EZK.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyamete iyes akiriŋ a ŋituŋa a ŋulu agogoŋok ka imasete iyes ŋaokot a ŋikepukak ka akwap; esibit erae ikes ŋimeesekin, ŋikaalei ŋulumesekin, ŋikorwa ka ŋimaniko; ŋibaren ŋulu aminae akiyok alo Basan totuma nooi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotuŋa a ŋulu etemokini ayoŋ aŋuna kus, inyamete iyes ŋasepwa akitodol ŋina ilelebunitor ŋakokyes pic ka imasete iyes ŋaokot kec akitodol ŋina imerakinotor. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyamete iyes alomesa kaŋ akiriŋ a ŋaŋolei ka ŋina a ŋikametok kec, akiriŋ a ŋikajiok a ŋulu agogoŋok ka ŋina a ŋikabilae a daadaŋ a ŋasigarya.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akinyakuno a Isirael nakwap kec",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon tema, “Esiŋolikini ayoŋ ŋituŋa a ŋakwapin apolou kaŋ ka epite ŋolo atubokinia ayoŋ ŋituŋa ta epite ŋolo esicania ayoŋ ikes a apedori kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameun akoloŋit ŋin tari lorwa ŋulu eponito, eyenunete Ŋisirael atemar arae ayoŋ Ekapolon Akuj kec. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
            "verseOrgIds": [
              "EZK.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyenunete daŋ ŋituŋa a ŋakwapin atemar apotu Ŋisirael kielar nakwapin aŋuna ka asecit kec, anerae apotu ikes tojoŋoto akikinyomit ayoŋ. Aŋuna aponiata ikes kitiya ŋun, abu ayoŋ nyesiŋolikin ikes ka abu epotok ikes napedor a ŋimoe kec ka aponi toarae ikes daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.23",
            "verseOrgIds": [
              "EZK.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ etiya neni kec ŋuna amaikina kitiyae neni kec aŋuna araakatar ikes ŋulu amunaara ka ŋulu etiyato aronis; abu ayoŋ nyesiŋolikin ikes.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.24",
            "verseOrgIds": [
              "EZK.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aŋun, alimu Ekapolon Akuj atemar, enyakuni tokona ayoŋ ŋapiya a Yakob anakwapin a ŋuna aponi torikoroe, esyoni ayoŋ Ŋisirael daadaŋ ka euryari ayoŋ ekiro kaŋ ŋolo asegan nyituruwor ekoŋinait. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.25",
            "verseOrgIds": [
              "EZK.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyetamunete nabo jik ikes ŋileec kec ka ŋakiro daadaŋ ŋuna apotu ikes kitiya emam akikinyomit ayoŋ apaki ŋina eboiyoto ikes anakwap kec emam awasya ka emam ituŋanan etukuryani ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
            "verseOrgIds": [
              "EZK.39.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 39:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kadau ayoŋ akinyakun ikes anakwapin ka acunun ikes anakiboisyo a ŋimoe kec, etoodiun ayoŋ aneni kec neni a ŋituŋa a ŋakwapin a ŋuna alalak arae ŋolo aseg. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.27",
            "verseOrgIds": [
              "EZK.39.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 39:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyenunete nai Ŋisirael atemar arae ayoŋ Ekapolon Akuj kec, anerae abu ayoŋ eela ikes nakwapin ka abu ayoŋ ocunu ikes anakwapin esiboik nakwap kec. Nyemyekini ayoŋ ikes tari ipei anakwapin a ŋunagelae; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.28",
            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mam nabo jik nyaŋeri ayoŋ akisiŋolikin ikes apaki ŋina abukokinia ayoŋ etau kaŋ neni a Ŋisirael.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.29",
            "verseOrgIds": [
              "EZK.39.29"
            ]
          }
        }
      ]
    }
