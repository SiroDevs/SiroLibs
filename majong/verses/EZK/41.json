              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ŋolopuke, ayai agolyet ŋina atubitoe alokidiŋ apei kidiama ka apei Kwap, kiwuakinitetei ŋinatubet narwatata a ŋipetae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.24",
            "verseOrgIds": [
              "EZK.41.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ecianakinitae nagolyeta a ŋipukei a ŋul ŋitorubei a ŋisubuna a ŋulu a ŋabebenuk ka ŋulu a ŋiŋolya, ekwaan ŋitorubei ŋul ka ŋulu ayakasi narwatatain. Apesitae ŋakito kidiama arwatata ŋina ke epuke a ŋolo elomarere nagule ŋina esyaunan elomaryo Kai ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.25",
            "verseOrgIds": [
              "EZK.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayakasi ŋidirisae narwatatain ŋuna anawae agule ŋin, esibusitae ŋarwatatain ŋun a ŋitorubei a ŋiŋolya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.26",
            "verseOrgIds": [
              "EZK.41.26"
            ]
          }
        }
