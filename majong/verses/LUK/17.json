          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.36",
            "verseOrgIds": [
              "LUK.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋita ŋikasyomak keŋ iŋes temasi, “Ai Ekapolon?” Toboŋok iŋes tema, “Neni eyai ibore ŋini atwan, iŋes iudakin ŋataruk.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
    }
