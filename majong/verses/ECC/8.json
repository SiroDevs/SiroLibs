{
  "id": "ECC.8",
  "number": "8",
  "bookId": "ECC",
  "reference": "Ekal. 8",
  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
