  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ECC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akitopoloorit, akitiditeuna bon ka akiomorikina a ibore a ŋini iyakar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toceikinite epite daadaŋ ŋolo ilosyononoo iyoŋ Kai ŋina ka Akuj. Ape kai ŋin akiirar ŋakiro ka Akuj akilo alosit ainakin ŋamuronisya ŋuna eayeneneete ŋibaŋaanotin nen; anerae nyeyenete ikes epite ŋolo eŋeryoto akitiya aronis. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikirikirak akirworo, kori nyicamak etau kon kikirikirak akiikin akirot alokiŋaren Akuj, anerae eyai Akuj nakuj ka iyai iyoŋ nakwap; aŋun, emaikina ŋakiro ŋuna ilimuni iyoŋ ekudyoko.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiumonok iyoŋ ŋakiro ŋuna alalak, epatana iyoŋ akiruja ŋakiro ŋuna aronok ka ani kirwor iyoŋ apaki ŋina aoyan, epatana iyoŋ akirworo ŋakiro ŋuna emam apolou. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, ani iikini iyoŋ akirot neni ka Akuj, nyidid akitiyakin ŋuna idau iyoŋ akiikin, anerae nyelakar Akuj a ŋakiro a ŋuna irworosi ŋibaŋaanotin, kitiyak ŋuna idau iyoŋ akiikin. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
              "ECC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejok iyoŋ awoun akiikin akilo iyoŋ akiikin, ido nyitiya ŋuna idau iyoŋ akiikin. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
              "ECC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyicamak akituk kon ikirikori iyoŋ nasecit, ido tolimok iyoŋ eketiyan ŋolo ka Akuj ebe, “Pa eredakini ayoŋ akitiya.” Kaanukiro emaikina Akuj eŋoi a ŋakiro a ŋuna irworo iyoŋ, ido kitoŋopiya ŋiticisyo ŋulu idau iyoŋ akitiya?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani elalak ŋakirujaeta elalaketa ŋakiro ŋuna ŋakoŋinae; nai emaikina kitopoloorite Akuj.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kiŋolik anakibois etiŋitae ŋulu a ŋican erono ka emam atubonokin anakiyookino ka akiwuapit ŋuna iyookino, nyiumok aŋuna a ŋakiro a ŋun, anerae ite ŋini epol ŋuna itiyae ŋini nyepol akilo iŋes ka eyai ice ŋini epol akilo ikes. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ibore ŋini erupuni analup, erae ŋini emaikina ŋituŋa a akibois a ŋin daadaŋ toryamut; erwosit daŋ emaikina eyakar neni itae.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ituŋanan ŋini emina ŋisiliŋa, nyetemari aryamu ŋisiliŋa ŋulu itemokino, tari ŋini emina ebari, nyeryamuni ibore daadaŋ ŋini ecamit iŋes aryamun.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iatakin ibore ŋininyamat, iatakin ŋikanyamak daŋ. Nyo nai eryamuni ituŋanan ŋini eyakar ibore ŋininyamat ŋin? Mam ipei daŋ mati akitere ŋituŋa imujete ebari keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebobokinito ŋiketiyak ŋajo ejotoete, tari daŋ kimujete ikes akimuj ŋina edit, kori ŋina alalan, nai nyejotoonor ŋikabarak aŋuna etamyata akuwar kya ŋuna a ebari kec.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adau ayoŋ akiŋolikin anakwap a na aronis eyai nakwap: Iŋadaete ŋituŋa ebari kec akitodol apaki ŋina emunaarya ebari ŋol ikes, ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido toŋopiya ebari ŋol daadaŋ alopite a ŋolo emam ajokis, todaun ibore eyakatar ŋikabarak ŋul, ido emam ibore irumete ŋidwe a ŋikabarak a ŋul. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elomunete ŋituŋa anakookyes atatoto kec elerete lopite ŋolopei alomuniata ikes anakwap a na. Mam aloboro a ŋulu aryamunito ikes aloticisyo kec ŋulu etijete ikes a ŋakan torukoryata anakwap a na. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae nu daŋ ŋuna eyaunito aronis: Lopite ŋolopei elomuniata ŋituŋa anakookyes atatoto kec, elomarete daŋ ikes anakwap a na. Nyo nai erae eropit ŋolo eryamunete ikes anaŋirikinit etic ŋolo erae akirisit ekuwuam? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo daŋ alorwa a daadaŋ a ŋulu eyariata ŋituŋa, imujete ŋituŋa pa eyenete ibore idio, eyakatar akadakinit ŋina apolon, eyakatar ŋidekesyo ka anyunyura.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae nu ŋuna eŋolik ayoŋ erae ŋuna ejokak: Ŋuna ejok ŋinituŋanan akitiya iŋes akimuj ka akimat, ikotere iruwor ŋini ilakara alotic a daadaŋ a ŋolo itiyae iyoŋ anakwap a na alorwa a ŋulu ekudyoko a ŋulu ikiinakinit Akuj iwon, anerae erae ŋin ainakinet ŋina ikiinakinitae iwon. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.18",
            "verseOrgIds": [
              "ECC.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwaŋinapei, ŋituŋa daadaŋ ŋulu ainaki Akuj ebari ka ŋiboro ŋice daŋ, ŋituŋa ŋulu ainakin alakara anakimuj ebari ŋol, emaikina ŋituŋa ŋul elakara, ido kileilyaa ibore daadaŋ ŋini adaut ikes aryamun aŋuna a ŋiticisyo kec. Erae ebari ŋol ainakinet aneni ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.19",
            "verseOrgIds": [
              "ECC.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋuna acamakinia Akuj ikes aruwor ŋulu elakara, nyepatana ŋituŋa ŋul atamatam epite ŋolo euruwuaketa ŋirwa ŋulu ka akiyar kec anakwap a na.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.20",
            "verseOrgIds": [
              "ECC.5.20"
            ]
          }
        }
      ]
    }
  ],
