          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eyai apaki a ibore a daadaŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyai apaki a ibore a daadaŋ, eyakasi ŋarwa aŋuna a etic a daadaŋ a ŋolo itiyao anakwap a na:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.1",
            "verseOrgIds": [
              "ECC.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Etic ŋolo erae Akuj ikiinakinit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
            "verseOrgIds": [
              "ECC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyo mono ikiryamuni iwon aloticisyo yok a daadaŋ? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋolik ayoŋ etic ŋolo einakinit Akuj ŋinituŋanan akitiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eturuwo Akuj ibore daadaŋ ŋini ejok apaki ŋina eyakar ibore ŋin; adau daŋ Akuj akiwuakin lotai a ŋituŋa ayenut ŋuna alunyar ka ayenun ŋuna eponito alokiŋaren, kerae tomam ayenut ŋin aneni a ituŋanan, pa kepedorit ituŋanan ayenun etic ŋolo itiyae Akuj ŋinapei anakisyakinet tari momit nasalunet. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayoŋ atemar mam ibore itojokito ŋituŋa alemar araakau ŋulu elakara ka ŋulu elelyanete ŋawat kec apaki daadaŋ ŋina ka akiyar kec. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae daŋ nu ainakinet ŋina ka Akuj, emaikina ŋinituŋanan kimuj ka tomat, kilubulub analelyanu ibore daadaŋ ŋini adau iŋes aryamun aŋuna a etic keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayoŋ atemar ŋuna daadaŋ itiyae Akuj, erubakinete ŋikaru ka ŋikaru; mam ibore iyatakino nen, kori mam ŋini elemaryo a nen; etiya Akuj ŋun, ikotere ŋituŋa daadaŋ itopoloorete Akuj; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.14",
            "verseOrgIds": [
              "ECC.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibore daadaŋ ŋini eyai, ayai sek ekiŋaren, ibore daadaŋ ŋini eyakaun, ayai sek ekiŋaren; itoboŋonokini Akuj ibore ŋini sek ayai toyakaun nabo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akuj eyeni ŋakiro ŋuna ka atubokino ka ŋuna alokiŋaren",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.15",
            "verseOrgIds": [
              "ECC.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nabo ayoŋ eŋolik anakwap a na atemar akilo atubonokin anakiyookino, etubonokinete ŋituŋa ŋuluce anaronis ka akilo akitiya ŋuna iyookino, itiyaete ŋituŋa ŋuna aronok. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.16",
            "verseOrgIds": [
              "ECC.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ otam bon otema, “Etubi Akuj ŋakiro a ŋituŋa a ŋulu iyookino ka ŋuna a ŋulu aronok, anerae adau Akuj akitemokin apaki ŋina a ŋunakiro daadaŋ ka ŋina a ŋolotic daadaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu daŋ ayoŋ otam bon otema, “Ani eruwor ŋituŋa, ikatanakini Akuj ikes, ikotere eyenunete atemar erae ikes ŋityaŋ koŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.18",
            "verseOrgIds": [
              "ECC.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwaan ŋuna itiyakin neni a ŋituŋa ka ŋuna itiyakin neni a ŋityaŋ, lopite ŋolopei etwakyata ŋituŋa daŋ, etwakete ŋityaŋ daŋ. Kieŋasi ŋituŋa lopite ŋolo ieŋatar ŋityaŋ, mam ibore ejokyata ŋituŋa akilo ŋityaŋ, anerae eruwor ŋul daadaŋ ŋikoŋinae. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.19",
            "verseOrgIds": [
              "ECC.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elomarete daadaŋ nakibois apei, elomunete daadaŋ analup ka eboŋorete daadaŋ nalup. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.20",
            "verseOrgIds": [
              "ECC.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mam ŋini eyeni kelosete ŋitai a ŋituŋa kidiama, kori kelosete ŋitai a ŋityaŋ kwap ŋalup.” ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.21",
            "verseOrgIds": [
              "ECC.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun abu ayoŋ oyenu atemar mam ibore itojokito ŋituŋa alemar aryamun alelyanu aŋuna a etic kon a ilope, anerae erae alelyanu ŋin ainakinet keŋ, ŋae epedori akiteyarun ituŋanan ketwana, kisiŋolik ŋuna eponito alokiŋaren?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.22",
            "verseOrgIds": [
              "ECC.3.22"
            ]
          }
        }
      ]
    }
  ],
