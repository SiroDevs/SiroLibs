          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towo Yesu, tonyara ikes kiŋit tema, “Nyo icamito iyes etiyak ayoŋ neni kus?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
