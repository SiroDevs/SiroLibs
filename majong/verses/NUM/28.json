            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋina iyauniata iyes ŋaraito ŋuna eŋarenok, apaki ŋina iyauniata iyes neni ke Ekapolon ainakinet ŋina a ŋikinyom aŋuna a ŋasuban a ŋisabito, emaikina iyes tocunakinos kilipa, nyilot loticisyo kus kitiyata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyes yaut ŋainakineta nu ŋuna epeyo, ŋuna ebob eure kec aneni ke Ekapolon: Ŋimoŋin ŋiarei ŋulusorok, emesek ka ŋikaalei ŋulumesekin ŋikanikaarei ŋulu erae apolou kec ekaru epei, ŋulu emam neni eŋwalit. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwapei ainakinet ŋina a ŋikinyom, emaikina iyes yaut ŋakirya ŋuna ajokak ŋuna iguritoe ka akimyet, emaikina iyes yaut ŋakirya ŋuna iguritoe ka akimyet ŋakiloi ŋauni aŋuna a ŋolomoŋ, ŋakiloi ŋaarei aŋuna a emesek ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka akilo apei aŋuna a ŋinikale a ŋulukanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina daŋ iyes yaut ekoroe aŋuna ka amookuno kus. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Einakinio ŋainakineta ŋun kaapei ka ŋainanakineta ŋuna epeyo ŋuna a ŋinakoloŋit kaapei ka ŋainakineta ŋuna a ŋikinyom ta ainakinet ŋina a ŋimaten. Emaikina ŋibaren ŋul daadaŋ emam neni eŋwalit.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
            "verseOrgIds": [
              "NUM.28.31"
            ]
          }
        }
