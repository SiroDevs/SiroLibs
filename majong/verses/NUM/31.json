            "number": "29",
            "style": "v",
            "sid": "NUM 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nai alotooma atutubet ŋina ekorakinio Ŋisirael ŋuluce, emaikina iyoŋ tolemu ipei alotooma ŋatomonikan, kerae a ŋituŋa, a ŋimoŋin, a ŋisigirya, a ŋamesekin, kori a ŋamee, kori ŋibaren ŋuluce daadaŋ, tosodi inakis neni a ŋilepi, a ŋiketiyak loeema ŋolo ke Ekapolon.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Moses ka Eleasar esacaradoti kitiyata lopite ŋolo ecikitor Ekapolon Moses.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.31",
            "verseOrgIds": [
              "NUM.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiboro ŋulu apotu kidoŋo aloboro a ŋulu aŋatunio kedaun akorakin ŋikilyok ŋulu alosito lojie ikes lu: Ŋamesekin ŋalipyo ŋamiae ŋakanikapei ka ŋatomonikanikaarei ka ŋakan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋimoŋin ŋalipyo ŋatomonikanikaarei ka ŋaarei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.33",
            "verseOrgIds": [
              "NUM.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋisigirya ŋalipyo ŋatomonikanikapei ka apei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.34",
            "verseOrgIds": [
              "NUM.31.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋapesur ŋuna pa eryamakina ka ŋikilyok ŋalipyo ŋatomoniuni ka ŋaarei.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epeiwae a ŋiboro ŋulu aponi tokorakinae ŋikilyok ŋulu alosito lojie arae ŋakinei ŋalipyo ŋamiae ŋauni ka ŋatomoniuni ka ŋakanikaarei ka ŋamiae ŋakan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido aponi inakinae neni ke Ekapolon ŋakinei ŋalipyo ŋakanikapei ka ŋatomonikanikaarei ka ŋakan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋimoŋin ŋalipyo ŋatomoniuni ka ŋakanikapei, ido aponi inakinae neni ke Ekapolon ŋimoŋin ŋatomonikanikaarei ka ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋisigirya ŋalipyo ŋatomoniuni ka ŋaarei ka ŋamiae ŋakan, ido aponi inakinae neni ke Ekapolon ŋisigirya ŋatomonikanikapei ka apei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋapesur ŋuna pa eryamakina ka ŋikilyok ŋalipyo ŋatomon ka ŋakanikapei, ido aponi inakinae neni ke Ekapolon aŋuna ke etic keŋ ŋapesur ŋatomoniuni ka ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Moses inak ŋainakineta ŋuna atyakakinitae Ekapolon neni ke Eleasar a esacaradoti, lopite ŋolo ecikitor Ekapolon Moses.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 31:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epeiwae a ŋiboro a ŋulu aŋatunio alojie a ŋulu abu Moses totyakaki Ŋisirael ŋuluce kedau atyakakin ŋikilyok ŋulu alosito lojie ikes lu: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42",
            "verseOrgIds": [
              "NUM.31.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 31:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakinei ŋalipyo ŋamiae ŋauni ka ŋatomoniuni ka ŋakanikaarei ka ŋamiae ŋakan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
            "verseOrgIds": [
              "NUM.31.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 31:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋimoŋin ŋalipyo ŋatomoniuni ka ŋakanikapei, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.44",
            "verseOrgIds": [
              "NUM.31.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 31:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŋisigirya ŋalipyo ŋatomoniuni ka ŋamiae ŋakan ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 31:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ŋapesur ŋuna pa eryamakina ka ŋikilyok ŋalipyo ŋatomon ka ŋakanikapei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alotooma ŋiboro lu ŋulu atyakakinitae Ŋisirael ŋuluce daadaŋ, abu Moses totyaka ipei alotooma ŋatomonikan a ŋituŋa ka a ŋibaren, ido inak neni a ŋilepi a ŋiketiyak loeema ŋolo ke Ekapolon, lopite ŋolo ecikitor Ekapolon Moses.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 31:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 31:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekaku ŋun, apotu ŋikarikok a ŋikajiok a ŋalipulipui ka ŋikarikok a ŋikajiok a ŋamiamiae potu neni a Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimokis iŋes temasi, “Emari isua ŋikilyok ŋulu epolokinitoe isua ka aryamun atemar eyakasi daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi eyaunitae isua ainakinet neni ke Ekapolon, ŋiboro lu ŋulu abu ŋinituŋanan kosi toryamu: Ŋiboro ŋulu etiyaunitae ke egolid, ŋinapen anakan, ŋiriko, ŋikabobooe, ŋikadoŋidoŋ, ŋinapen alodokolei aŋuna ka amookunor alokiŋaren Ekapolon.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Moses ka Eleasar esacaradoti kijaut aneni a ŋikilyok a ŋul egolid ŋolo etiyaunitere ŋiboro ŋulu egelegelya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi arae egolid daadaŋ ŋolo etiyaunitere ŋiboro ŋulu apotu ŋikarikok a ŋalipulipui ka ŋamiamiae ŋul inakis Ekapolon ŋakiloi ŋuna eapikinito ŋamiae ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kebu ŋolokajion toŋata ŋiboro aŋuna keŋ a ilope ŋulu apotu ikes toŋatut.) ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu Moses ka Eleasar esacaradoti kijaut egolid aneni ŋikarikok a ŋikajiok a ŋulu arae ŋalipulipui ka ŋamiamiae, kiwuakis egolid ŋol tooma eema ŋolokilipet ikwapei ibore ŋini etamunitotor Ŋisirael Ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
            "verseOrgIds": [
              "NUM.31.54"
            ]
          }
        }
      ]
    }
