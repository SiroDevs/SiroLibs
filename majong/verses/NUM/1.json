            "sid": "NUM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi kigirae ŋiletok a Ruben a ŋolo arae lokoku a Isirael ŋolokiyae, kigirae ŋikilyok daadaŋ ŋulu arae ŋikaru kec ŋatomoniarei ka adepar, ŋulu apedorito alosit lojie, kigirae ikes a ŋirorwa kec a ŋipeipei, a ŋatekerin ka a ŋikalya, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.20",
            "verseOrgIds": [
              "NUM.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "arae ekimar a ŋikilyok a daadaŋ alokabila a Ruben ŋalipyo ŋatomoniomwon ka ŋakanikapei ka ŋamiae ŋakan.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.21",
            "verseOrgIds": [
              "NUM.1.21"
            ]
          }
        }
      ]
    },
