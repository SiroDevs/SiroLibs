          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai pa aponi kimarae ekabila a ŋilepi kaapei ka Ŋisirael ŋuluce.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.47",
            "verseOrgIds": [
              "NUM.1.47"
            ]
          }
        }
