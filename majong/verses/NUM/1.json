              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋul ŋikilyok ŋulu apotu Moses ka Aron kigira, iŋarakinito ikes ŋikilyok ŋulutomon ka ŋiarei ŋulu arae ŋikarikok a ŋikabilae a Ŋisirael a ŋulutomon ka ŋiarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.44",
            "verseOrgIds": [
              "NUM.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekimar a Ŋisirael a ŋulu arae ŋikilyok ŋulu arae ŋikaru kec ŋatomoniarei ka adepar ka a ŋulu apedorito alosit lojie ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.45",
            "verseOrgIds": [
              "NUM.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
