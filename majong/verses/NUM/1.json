        {
          "text": "Aponi kigirae ŋiletok a Simeon a ŋipeipei a ŋatekerin kec iwuapitae ŋikalya atapapaa kec, kigirae ŋirorwa a ŋikilyok a daadaŋ a ŋulu arae ŋikaru kec ŋatomoniarei ka adepar, ŋulu apedorito alosit lojie, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.22",
            "verseOrgIds": [
              "NUM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "arae ekimar a ŋikilyok a ŋulu aponi kigirae alokabila a Simeon ŋalipyo ŋatomonikan ka ŋikanikaomwon ka ŋamiae ŋauni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.23",
