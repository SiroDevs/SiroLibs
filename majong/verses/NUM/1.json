        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.19",
            "verseOrgIds": [
              "NUM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
