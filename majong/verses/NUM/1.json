          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "arae ŋalipyo ŋamiae ŋakanikapei ka ŋauni ka ŋamiae ŋakan ka ŋatomonikan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.46",
            "verseOrgIds": [
              "NUM.1.46"
            ]
          }
        },
