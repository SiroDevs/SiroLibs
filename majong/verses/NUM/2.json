          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae ekimar a ŋikilyok a ŋulu apedorito ejie a ŋulu aponi kigirae ŋalipyo ŋatomoniomwon ka ŋamiae ŋakan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.19",
            "verseOrgIds": [
              "NUM.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyete ekabila a Epuraim, emaikina toloma ŋituŋa a ekabila a Manase. Ekarikon kec iŋes, Gamaliel lokoku a Pedasur. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae ekimar a ŋikilyok a ŋulu apedorito ejie a ŋulu aponi kigirae ŋalipyo ŋatomoniuni ka ŋaarei ka ŋamiae ŋaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totupak ekabila a Benjamin, erae ekarikon a ŋituŋa a ekabila a Benjamin Abidan lokoku a Gideoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae ekimar a ŋikilyok a ŋulu apedorito ejie a ŋulu aponi kigirae ŋalipyo ŋatomoniuni ka ŋakan ka ŋamiae ŋaomwon. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
        {
          "name": "verse",
