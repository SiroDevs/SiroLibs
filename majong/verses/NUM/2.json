              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekimar a Ŋisirael a daadaŋ a ŋulu aponi kimarunae a ŋikalya atapapaa kec a ŋatuketa analomarisinei kec, arae ŋalipyo ŋamiae ŋakanikapei ka ŋauni ka ŋamiae ŋakan ka ŋatomonikan. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.32",
            "verseOrgIds": [
              "NUM.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwapei ecikitor Ekapolon Moses, pa emarakinitae ŋilepi lokimar a Ŋisirael a ŋuluce.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
            "verseOrgIds": [
              "NUM.2.33"
