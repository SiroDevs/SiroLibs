            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Diyete ekabila a Dan emaikina toloma ŋituŋa a ekabila ka Aser, ekarikon kec iŋes Pagiel lokoku ka Okiran. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
