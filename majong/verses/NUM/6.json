          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“‘Erae ŋol ekisil aŋuna a Ŋinasari a ŋulu ikoŋete. Emaikina ikes inakis neni ke Ekapolon ŋainakineta kec lopite ŋolo ikoŋitotor ikes, pa imaritae ibore ice ŋini epedorete ikes alemun. Emaikina ikes kitiyata ŋuna ikoŋito iwuapito ŋikisila ŋulu akitaleoro kec.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiterereŋ a ŋisacaradotin ŋituŋa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
