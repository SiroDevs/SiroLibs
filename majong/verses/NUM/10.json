              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu ikes towotokis alomoru ke Ekapolon (iŋes Sinai), torubakis ewosete ŋirwa ŋiuni, kiŋarenikinite ikes Asaduku ŋina ka Acamunet ke Ekapolon aryamun aŋuna kec akibois ŋina elomete, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.33",
            "verseOrgIds": [
              "NUM.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "ayai adis ke Ekapolon kidiama kec naparan, apaki ŋina awotokiniata ikes alomoru Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.34",
            "verseOrgIds": [
              "NUM.10.34"
            ]
          }
        }
