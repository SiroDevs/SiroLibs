  "bookId": "1SA",
  "reference": "1 Sam. 30",
  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "1SA 30"
      },
