{
  "id": "1SA.17",
  "number": "17",
  "bookId": "1SA",
  "reference": "1 Sam. 17",
  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "1SA 17"
      },
      "items": [
        {
