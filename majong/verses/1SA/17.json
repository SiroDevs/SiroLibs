          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.54",
            "verseOrgIds": [
              "1SA.17.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1SA 17:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iŋolikini Saul Daudi elosi akisiiryakin Epilistait, kiŋit Abiner ŋolo arae ekarikon ajore keŋ tema, “Abiner, lokoku a ŋae esorokit lo?” Toboŋok Abiner tema, “Ikwapei iyarya iyoŋ okoe erwosit, nyayeni ayoŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.55",
            "verseOrgIds": [
              "1SA.17.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1SA 17:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema erwosit, “Kiŋitu atemar lokoku a ŋae esorokit lo.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.56",
            "verseOrgIds": [
              "1SA.17.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1SA 17:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eboŋuni Daudi aneni aarakini Epilistait, toriku Abiner Daudi yau kiŋaren a Saul etiŋit akou ke Epilistait. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.57",
            "verseOrgIds": [
              "1SA.17.57"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1SA 17:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit Saul iŋes tema, “Lokoku a ŋae iyoŋ esorokit?” Toboŋok Daudi tema, “Arae ayoŋ lokoku a Yese a eketiyan kon a ŋolo alo Betelem.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.17.58",
            "verseOrgIds": [
              "1SA.17.58"
            ]
          }
        }
