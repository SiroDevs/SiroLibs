              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋakito ke eewoi etiyaunitor iŋes Namuroet ŋin, ido toburusik egolid nakito ŋun.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
