  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "EXO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikisila aŋuna ke etacit a ŋamicae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kekokoiya ituŋanan emoŋ, kori amesek toar, kori togyela, emaikina ekokolan ŋol totac ŋimoŋin ŋikan aŋuna ke emoŋ ke epei ka totac ŋamesekin ŋaomwon aŋuna ka amesek ka apei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kikamun ituŋanan ekokoi, ido kidicae totwan, mam etacit elemunio aŋuna a ekokolan a ŋol. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani kitiyakina ŋakiro ŋun kedau akoloŋ alomun, emaikina ituŋanan ŋini aari ekokolan totac iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Emaikina kire jik ekokolan totac ibore ŋini ekokoiyarit, nai ani kemam ibore etacia, emaikina togyelarae iŋes kisitiyae ŋisiliŋa ŋulu agyelarere iŋes atacia ibore ŋini ekokoiyarit iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keryamun ibarasit ŋini akokoiyarit iŋes eriŋa eyari, emyat iŋes, kerae emoŋ, kori esigirya, kori amesek, emaikina iŋes totacu ŋibaren ŋiarei aŋuna a ipei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kitanyam ituŋanan ŋibaren keŋ emanikor, kori epiini a ituŋanan a ice, emaikina iŋes totac a ŋikinyom a ŋulu ajokak nooi alomanikor keŋ, kori a epiini keŋ a ŋolo ajokan nooi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kicunyak ituŋanan akim topetar tonom ŋamon ka kitoro ŋatukon a ŋikinyom a ŋulu elemitae, kori ŋikinyom ŋulu eriŋa nyelema, kori tonomiya emanikor daadaŋ, emaikina ituŋanan ŋini ecunyakini akim totac ŋikinyom ŋul daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kicikak ituŋanan ikidunyet keŋ ŋisiliŋa, kori ŋiboro akiyok aŋuna keŋ, ido tokokoiyarae a nen, emaikina ŋini akokoiyarit erae kikamun, totacu ŋice ŋiarei aŋuna a ipei. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani pa kikamun ekokolan ŋol, emaikina kisitakinae alokiŋaren ŋikatubok ituŋanan ŋini ecikakinitae ŋiboro toanyut ŋikatubok ŋul keyai sek ibore elemarit ilope a ŋiboro a ŋul aneni a ikidunyet keŋ a ŋini ecikakinitae ŋiboro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋiburasyo ŋuluce daadaŋ ŋulu iburaata ŋituŋa aŋuna kerae ke emoŋ, a esigirya, a amesek ka a ŋilowi, kori aŋuna a ibore a ice a ŋini ecakara, a ŋini ebala ipei, ‘Erae ibore en ŋini kaŋ,’” emaikina ebura ŋol yaarae neni a ŋikatubok. Ani ŋini eryamunete ŋikatubok edyakarit, emaikina ŋin totac ŋinice a ŋiboro, kori a ŋibaren a ŋiarei aŋuna a ipei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kicikak ituŋanan ekidunyet keŋ esigirya, kori emoŋ, kori amesek, kori ibarasit ice daadaŋ, ido totwan ibarasit ŋin, kori towana, kori tolema ibore ice, pa eyeni ŋini ecikakinitae, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "emaikina ebura ŋolo ikoni ŋol tocamunos ŋituŋa ŋul ŋiarei, kikoŋo alokiŋaren Ekapolon atemar mam sek nyitatacit ŋini alemar ikeebore ekidunyet keŋ ibore idio. Emaikina ŋini alemar ikeebore tocamu ŋakiro ŋun, ido mam ibore etacakini ikidunyet keŋ ŋin iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani kekokoiyaritae ibarasit ŋin aneni a ŋini ecikakinit iŋes, emaikina totacakinae elope a ibarasit ibarasit ice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keryamunitae alyal ŋina kenyamyata ŋityaŋ ibarasit ŋin, emaikina inunae ilope a ibarasit a ŋin ibore idio ŋini idoŋit anibarasit keŋ, ido nyitatacio ituŋanan ŋin ibarasit ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kijaa ituŋanan ibarasit aneni a ŋinice akisitiya mono, ido towana aneni keŋ, kori totwan emam ilope, emaikina ibarasit ŋin totacae. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kitiyakina ŋadi nibarasit ŋin eyai ilope, nyetacyo erae ca kerae sek ŋini epaŋgaunitae; ŋisiliŋa bon ŋulu epaŋgaunitere emaikina totacae.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋikisila aŋuna ke ekiboiye kaapei ka ŋikisila aŋuna ke edin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani kimaimaiya ituŋanan apese ŋina sek nyiryamakina ke ekile ŋina sek nyetiŋit, ido kiryamakinos ka iŋes, emaikina ituŋanan ŋin kiit apese ŋin toruwor aberu keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani keŋer papa ka apese a ŋin ituŋanan ŋin, emaikina ituŋanan ŋin tolemu ibore ŋinipei sek etya ŋini iisere ŋapesur.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyemaikina iyes kimyekis ŋakekukujak eyarete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ituŋanan daadaŋ ŋini elosi akiryamanakin ka ŋibaren, emaikina toarae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        }
      ]
    },
    {
