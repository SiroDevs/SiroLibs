          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ituŋanan ŋini iceni papa keŋ, kori toto keŋ, emaikina toarae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.17",
            "verseOrgIds": [
              "EXO.21.17"
            ]
          }
        }
