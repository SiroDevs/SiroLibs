          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "akoŋu aŋuna ka akoŋu, ekelae aŋuna ke ekelae, akan aŋuna ka akan, akeju aŋuna ka akeju, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
            "verseOrgIds": [
              "EXO.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "akicuny aŋuna ka akicunyia, ajeme aŋuna ka ajeme ka aramat aŋuna ka aramat.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.25",
            "verseOrgIds": [
              "EXO.21.25"
            ]
          }
        }
      ]
