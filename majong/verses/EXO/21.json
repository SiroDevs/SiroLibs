        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.15",
            "verseOrgIds": [
              "EXO.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ituŋanan ŋini ekokoiyari ituŋanan ŋinice, kegyelarit iŋes ituŋanan ŋin, kori keriŋa eyai neni keŋ, emaikina toarae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.16",
            "verseOrgIds": [
              "EXO.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 21:16"
          },
          "items": [
            {
              "text": "16",
