              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki daadaŋ ŋina ikyaaror edou aneni ayai Eema ŋolo iryamununoi, awotonokinete Ŋisirael a nen iwace; ",
          "type": "text",
          "attrs": {
