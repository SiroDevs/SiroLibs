          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ekapolon neni a Moses, “Tolimok Ŋisirael ŋakiro nu ebe, ‘Idaut iyes ŋikulepek aanyun atemar adau ayoŋ akirwor neni kus anakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyitiyaut aŋuna kus ŋakujo kilipete neni kec, ido kilipete neni kaŋ daŋ, nyemaikina iyes kitiyaut aŋuna kus ŋakujo tari alosilipa, kori alogolid. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iyes kitiyaut a ŋalup Namuroet aŋuna kaŋ, ido inanakis ŋainakineta kus neni kaŋ a nen, ŋainakineta kus ŋuna a ŋamesekin ka ŋimoŋin ŋuna epeyo ka ŋuna ke ekisil. Abuni ayoŋ akiterereŋ iyes anakibois a daadaŋ a ŋina akainakini ayoŋ iyes akilipya ayoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kitiyaut iyes a ŋamoru Namuroet aŋuna kaŋ, nyitiyaut a ŋamoru a ŋuna ibesitae ejok; anerae ani kibeta iyes ŋamoru ŋunakitiyaunet Namuroet ŋin, idaut iyes amunaar Namuroet ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiwuakis ŋadoketa Namuroet kaŋ ŋuna idoketa iyes, ikotere nyisileereun a nen ikwa itakaniata iyes.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
            "verseOrgIds": [
              "EXO.20.26"
            ]
          }
        }
      ]
