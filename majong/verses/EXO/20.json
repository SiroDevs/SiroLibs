          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nyiar.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.13",
            "verseOrgIds": [
              "EXO.20.13"
            ]
          }
        }
