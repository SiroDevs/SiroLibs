  "bookId": "EXO",
  "reference": "Awos. 1",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EXO 1"
      },
