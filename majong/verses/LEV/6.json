      },
      "items": [
        {
          "text": "Ŋainakineta aŋuna ka asecit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ekapolon neni a Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tolimok Aron ka ŋidwe keŋ ŋulusapa ebe, ‘ŋikisila ŋulu emaikina kiwuapae lu aŋuna a ŋainakineta aŋuna ka asecit. Emaikina ainakinet aŋuna ka asecit toarae alokiŋaren Ekapolon anakibois a ŋina eareneneere ainakinet ŋina epeyo; erae ainakinet ŋin ŋina eseg. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.25",
            "verseOrgIds": [
              "LEV.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina esacaradoti ŋolo eai ainakinet kimuj adio a ainakinet a ŋin anakibois a ŋina asegan analapatu ke eema a ŋolo ilipere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.26",
            "verseOrgIds": [
              "LEV.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋini daadaŋ etapi akiriŋ ka ainakinet a ŋin, eruwor ŋini eseg. Ani kiterakin ŋaokot a ainakinet a ŋin lolou, emaikina kilotarae anakibois a ŋina asegan neni eya ŋaokot alolou a ŋol. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.27",
            "verseOrgIds": [
              "LEV.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina tobwaŋabwaŋaarae amot ŋina esitiyao akipoo ainakinet ŋin, nai ani kerae eborosit ŋolo itiyaunitae ke eburonis epotere, emaikina kirigaarae, ido kilotarae a ŋakipi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.28",
            "verseOrgIds": [
              "LEV.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina ituŋanan daadaŋ ŋini erae ŋinisapat aloletok a ŋisacaradotin kimuj ainakinet ŋin, erae ainakinet ŋin ŋina eseg nooi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.29",
            "verseOrgIds": [
              "LEV.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ainakinet aŋuna ka asecit daadaŋ, ŋina eyaunio ŋaokot keŋ tooma eema ŋolo ilipere nakibois ŋina asegan nooi, aŋuna ka amookunia ituŋanan anasecit, nyemaikina kimujae ŋin; itemokino kicunyae.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.30",
            "verseOrgIds": [
              "LEV.6.30"
            ]
          }
        }
      ]
