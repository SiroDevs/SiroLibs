            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kerae ipei alokidiŋ ŋituŋa ŋuluce daadaŋ eseci pa iredakinit akitiya ŋuna nyecamakinito ŋakiciketa ŋuna ke Ekapolon, esecit iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keyenu iŋes asecit keŋ ŋina itiyat, emaikina iŋes yau ameot ŋina ajokan ŋolo emam neni eŋwalit ikwapei ainakinet aŋuna ka asecit keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina iŋes kidokok akan keŋ nakou ka ainakinet a ŋina elemarere asecit a ŋin, ido nai toarak nakibois ŋina sek icunyere ŋainakineta ŋuna epeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani ekaku, emaikina esacaradoti tolemu ŋaokot ŋadi, kilumok ekimoin keŋ, ido ya kiosak loboorei ŋulu esibito ŋamomwar alokoonae anamuroet a ŋina icunyere ŋainakineta ŋuna epeyo. Ŋaokot ŋunace ŋuna idoŋete, emaikina iŋes tobukok neni ewuar namuroet. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina esacaradoti tolema asepwae daadaŋ lopite ŋolo alemanarere ŋina ka ainakinet a ŋina ke ekisil, ido emaikina kicuny alokidiama namuroet ikwapei ainakinet ŋina epeyo, ŋina ebob eure keŋ aneni ke Ekapolon. Alopite a ŋol, emookuni esacaradoti ituŋanan ŋin anasecit keŋ, ido isyonio ituŋanan ŋin.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.31",
            "verseOrgIds": [
              "LEV.4.31"
            ]
          }
        }
      ]
