              "type": "text"
            }
          ]
        },
        {
          "text": "Tema Ekapolon neni a Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26",
            "verseOrgIds": [
              "LEV.22.26"
            ]
          }
        },
        {
