          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ani eurunio itaok, kori imesek, kori imeot, emaikina toruko ka toto keŋ ŋirwa ŋikanikaarei. Ani epete ŋirwa ŋikanikauni ka ŋice, ecamakinio ibarasit eruwor ainakinet neni ke Ekapolon ŋina epeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.27",
            "verseOrgIds": [
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai nyemaikina toarae itaok, kori imesek kaapei ka toto keŋ akoloŋit apei. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iyaarete iyes ainakinet ŋina ka alakar neni ke Ekapolon, toara iyenete atemar ecamakinio aŋuna kus. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaikina tonyamae akoloŋit ŋinapei ŋin, nyimyekis akiriŋ keŋ adio kiwalak. Arae ayoŋ Ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alopite a ŋol, iwuapete iyes ŋakiciketa kaŋ ka iricete ikes. Arae ayoŋ Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyemaikina iyes tomunaasi ekiro kaŋ ŋolo asegan. Emaikina ayoŋ akacamunito ŋituŋa kaŋ Ŋisirael arae ŋolo aseg. Arae ayoŋ Ekapolon, ŋolo abu eketuruwo iyes ŋulu isegak. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayoŋ abu okoyau iyes anakwap a Ijipit, ikotere aruwor Akuj kus. Arae ayoŋ Ekapolon.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        }
      ]
    }
