      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai tokona, adau Akuj ainakin iwon akiikinet keŋ ŋina abu itolimok iwon atemar ieŋunete. Nai aŋuna tokona eriŋaakar akiikinet ŋina ka Akuj ŋina ka alomar nakwap ŋina ka akieŋun keŋ eyai, itemokino ocoikisi, ikotere nyekuruwo ipei daŋ alokidiŋ yok alomar nakieŋun ŋin. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.1",
            "verseOrgIds": [
              "HEB.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anerae ikiira ŋakiro ŋuna ajokak ŋuna ka akieŋun a ŋin lopite ŋolo eiraryata atapapaa yok analoŋisat. Nai ŋina eiraryata ikes ŋakiro ŋun, emam ibore ŋini ajokan ŋini apotu ikes toryamut, anerae apotu towout akinup ŋakiro ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.2",
            "verseOrgIds": [
              "HEB.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae anupit bon ŋakiro ka Akuj, iŋes ikilomarya iwon nakwap ŋina ka akieŋun ikwapei elimunitor Akuj atemar,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyari akirot ŋina ka Akuj ka itiyae daŋ ka agogoŋu, iloit akwanis keŋ ŋina ka atum a ŋina ekwaka ŋiwaetin keŋ daadaŋ. Eduŋi todol tari neni iryamiryameta akiyar ka etau kori tari neni eya ŋakilenyet ka asumet, isileereununui ŋatameta ka ŋakiro ŋuna elosikinit etau. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emam isubuna ipei daŋ ŋini epedoryo akiwua aneni ka Akuj, ileere ibore daadaŋ eyai eŋaara aneni keŋ. Erae neni keŋ elimoryo iwon ŋakiro ŋuna kitiya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Esacaradoti ŋolo Apolon nooi ŋolo isyonit kire apalagu yok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino iwon orubakisi ikititinyikinit ananupit Yesu; anerae Yesu Lokoku ka Akuj, iŋes erae Esacaradoti yok ŋolo Apolon nooi, ŋolo adau alosit nakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae Esacaradoti ŋolo Apolon nooi ŋolo isyonit kire apalagu yok ŋina a ŋitai. Esacaradoti ŋolopei ŋol abu Satan kitem alopitesyo a daadaŋ a ŋulu ikitemio iŋes iwon, nai abu iŋes nyesec. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otitinyoto nai tokona iwon, oloto neni ka Akuj a ŋina ipukat ka ajokis, ikotere ikiryamuni akisyon ka ajokis, ikiŋarakis iwon apaki ŋina ka akiitanit.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
