              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodi nai, kerae acamit ŋina ka Akuj, abuni ka alelyan ka eeŋu apaki ŋina ayakar ayoŋ neni kus. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.32",
            "verseOrgIds": [
