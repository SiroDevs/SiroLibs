          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emalaika ka ekitaabo ŋolo adit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nabo ayoŋ oanyuwa emalaika ŋolo agogoŋon ebunit anakuj. Anapit iŋes edou, kirimokinite alokakinet akou keŋ, kikoni ereet keŋ akoloŋ, kikote ŋakejen keŋ arira ŋina eremit kidiama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayai nakan keŋ ekitaabo ŋolo adit ŋolo aŋaara. Abu kiwuak akeju keŋ ŋina aloteten nanam ka ŋina alokedyen kwap, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kiworou a etoil a ŋolo apolon ikwa ŋolo ke eŋatuny irurumae; ani kiworou, torukis ŋagirokineta ŋunakanikaarei. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keruut ŋagirokineta ŋunakanikaarei ŋun adikino ayoŋ egirakini, nai abu eira etoil anakuj ebala, “Kipuca ŋakiro ŋuna alimut ŋagirokineta ŋunakanikaarei, nyigirak ikes!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.4",
            "verseOrgIds": [
              "REV.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu emalaika ŋolo aris ayoŋ keŋolik ewuoi ananam ka akwap kikyaa akan keŋ ŋina aloteten nakuj. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu iŋes kikoŋ alokiro ka Akuj a ŋina eyari ŋikaru ka ŋikaru, a ŋina asubuni nakuj, akwap, anam ka ibore daadaŋ ŋini eyai tooma kec; tema, “Emam nabo apaki ace ŋina idaryo.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai, ani ekutakini emalaika ŋolo a ŋikanikaarei arupepe keŋ, irikakini Akuj ŋakiro ŋuna ka akimunono ŋuna elosikinit iŋes akitiya, ikwaŋinapei alimokinitor ŋikadwarak ŋulu erae ŋiketiyak keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu nabo etoil ŋolo sek eirarit ayoŋ irworo anakuj okolimok ayoŋ tema, “Ape tolema ekitaabo ŋolo eŋaara ŋolo eyai nakan ŋina ke emalaika a ŋolo ewuoi ananam ka anakwap.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ olot neni ke emalaika, eŋit iŋes ainakin ayoŋ ekitaabo ŋol. Abu iŋes okolimok ayoŋ tema, “Tolema tonyam; edwariar anakook kon, nai eboboor anakituk kon ikwa akimyet ŋina ka ao.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu ayoŋ ejau ekitaabo ŋolo adit ŋol anakan keŋ onyam, toboboor iŋes anakituk kaŋ ikwa akimyet ŋina ka ao. Nai ani kadau ayoŋ akilikor, abu todwaryar anakook kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aponi nai okolimokin ayoŋ temarae, “Itemokino iyoŋ nabo todwar ŋakiro ŋuna ka Akuj ŋuna ikamunito ŋakwapin, ŋibukui, ŋaŋajepa ka ŋirwosi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
      ]
    }
  ],
