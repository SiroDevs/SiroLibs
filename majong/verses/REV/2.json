              "type": "text"
            }
          ]
        },
        {
          "text": "“Kigir neni ke emalaika a ŋolo ka atukot a Ŋikristo alo Simirina atemar:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
