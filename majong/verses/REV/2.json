    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iŋes ŋini ilouni, nyeari atwanare ŋina a ŋaarei iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.11",
            "verseOrgIds": [
              "REV.2.11"
            ]
          }
        }
      ]
