    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erae ŋakiro nu ŋuna eponito aneni a ŋolo erae ŋolo Eŋarenon ka ŋolo Esidyon, ŋolo abu totwan ka toyaru nabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayeni ayoŋ ŋatyokisyo kon ka ayeni ayoŋ atemar ikulyakana iyoŋ, nai kire ibarit! Ayeni ayoŋ tari ŋuna aronok ŋuna ikirworotor iyoŋ ŋituŋa ŋulu ebasi ebe ikirae ikes Ŋiyudayan, nai nyerae; eraakasi ikes atukot ŋina a Satan! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.9",
            "verseOrgIds": [
              "REV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyikuryaniar aŋuna a ŋican a ŋulu eapi iyoŋ aryamun. Topupok! Eapi Satan acunakin ŋice alokidiŋ kus mabus, ikikatak iyes, ido toryamut akisicanio ŋirwa ŋitomon. Torubak ananupit, erae kedolu atwanare daŋ, ido akainakini ayoŋ iyoŋ akiyar, toruwor eropit.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.10",
            "verseOrgIds": [
              "REV.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
