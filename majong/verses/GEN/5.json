          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedau auruun Enos, abu kiboi ŋikaru ŋamiae ŋakanikauni ka ŋikanikaarei, touru ŋisapa ŋice ka ŋapesur. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
