              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedau Set akiboi ŋikaru amiat ka ŋikan, abu touru Enos. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
