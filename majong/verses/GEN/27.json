          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Isaka iŋes tema,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
