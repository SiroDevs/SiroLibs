              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.40",
            "verseOrgIds": [
              "GEN.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiman Esau Yakob aŋuna ka arereŋu a ŋina abu Isaka inak Yakob, tema Esau alotau keŋ, “Aapuut ŋirwa ŋulu egworyo ayoŋ papa kaŋ; ekaku, aari ayoŋ Yakob lokaato kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.41",
            "verseOrgIds": [
              "GEN.27.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai keponi tolimokinae Rebeka ŋakiro a Esau alokoku keŋ a ŋolokiyae; aŋun, abu iŋes kiyakiya ituŋanan anyarare Yakob lokoku keŋ ŋolo cici, tema neni a Yakob, “Ililiŋia lokaato kon Esau ŋakiro, ido itemonokin akiar iyoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.42",
            "verseOrgIds": [
              "GEN.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, lokoku, kiwuap ŋakiro kaŋ; tosi atipei Aran neni a Laban alokaato kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.43",
            "verseOrgIds": [
              "GEN.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "GEN 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiboiyoto ka iŋes apaki adio akitodol ŋina edaunor aŋoit aneni alokaato kon ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.44",
            "verseOrgIds": [
              "GEN.27.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "GEN 27:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ŋina epuripuryaaror anyunyura keŋ aŋuna kon kimuryakis daŋ ŋuna itiya iyoŋ neni keŋ. Eyakuuni ayoŋ ituŋanan itonyar iyoŋ aina edaun ŋun. Kaanukiro atwaniyarya ayoŋ iyes daadaŋ akoloŋit apei?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.45",
            "verseOrgIds": [
              "GEN.27.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "GEN 27:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tema nai Rebeka neni a Isaka, “Akaup ayoŋ akiyar kaŋ na aŋuna a ŋaberu a ŋuna erae Ŋaitaiti. Ani kiit Yakob Aititait ikwapei ŋaberu nu, apei anaberu a ŋuna ka akwap a na, anijokis aryamuni ayoŋ anakiyar kaŋ?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.46",
            "verseOrgIds": [
              "GEN.27.46"
            ]
          }
        }
      ]
