          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eruwor ŋikaru ke Esau ŋatomoniomwon, kiit iŋes Yudis nakoku a Beri a ŋolo arae Eititait, ka Basemas nakoku a Elon a ŋolo arae Eititait; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
