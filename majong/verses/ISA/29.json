            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani keinakin neni a ŋulu nyeyenete akisyom ebookoi, “Tosyoma ekitaabo lo,” etemarete ikes, “Nyikipedori isua akisyom.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
