              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebunit akoloŋit ŋina eyakaunor eletonit a Yese, eruwor iŋes akitoodikinet neni a ŋituŋa a ŋakwapin, epote ŋituŋa a ŋakwapin akiŋitanar iŋes ka eruwor akibois keŋ ŋina ecai nooi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        }
