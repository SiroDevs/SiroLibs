          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋolikis ŋituŋa ŋulu sek ayakasi nakiryonut akica ŋina apolon.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atubokino a ŋikesupak ka ŋulu isicanito ŋuluce",
          "type": "text"
        }
      ]
    },
