            "number": "1",
            "style": "v",
            "sid": "ISA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikote neni daŋ, nyeyakaun akiyaloloŋ neni a ŋulu sek eryebasi. Alorwa a ŋulu a ekiŋaren aponi tojamuwarae ŋituŋa a akwap a Sebulon ka ŋulu a akwap a Naputali, nai alorwa a ŋulu eponito itopolooryo Galileya akwap ŋina a ŋituŋa a ŋakwapin. Epoloor iŋes aŋuna ke erot a ŋolo itorunit diyete anam Mediteranian ka aŋuna ke erot a ŋolo alokekwaye Yorodan.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
