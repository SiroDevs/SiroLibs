          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aŋun, itolomuni Ekapolon ŋajemei anakyes ikec,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        }
