            "number": "17",
            "style": "v",
            "sid": "ISA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.17",
            "verseOrgIds": [
              "ISA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
