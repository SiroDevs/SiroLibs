          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameun akoloŋit ŋin nyetamunio nabo Tiro ŋikaru ŋatomonikanikaarei, apaki ŋina ka akiyar a erwosit. Ekaku a ŋikaru a ŋatomonikanikaarei,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        }
