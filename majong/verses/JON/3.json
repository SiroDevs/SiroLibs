          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iŋolikini Akuj ŋuna apotu ikes kitiyata, epite ŋolo aponiata ikes tokiwa aronis kec, kisyoni Akuj ikes kimyek aronis ŋina sek aris ketema esicania ŋituŋa a Ninepe; ido abu nyisican ikes.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
            "verseOrgIds": [
              "JON.3.10"
            ]
          }
        }
      ]
    }
  ],
