        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emalas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayoŋ Paulo ŋolo arae ekiyakia ŋolo a Yesu Kristo, aŋuna ka akicikakinet a ŋina ka Akuj a ŋina erae Akaiunan yok ka aŋuna ka akicikakinet a Yesu Kristo a ŋolo erae akigeno yok, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.1",
            "verseOrgIds": [
              "1TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "egirit abaruwa na neni a Timoteo a ŋolo erae lokoku kaŋ ŋolo a kire ananupit.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyai neni kon ajokis, akisyon ka ekisil aneni ka Akuj Papa ka aneni a Yesu Kristo Ekapolon yok.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tocoikinite ŋakitatameta ŋuna ka alyokonu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.2",
            "verseOrgIds": [
              "1TI.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acamit ayoŋ iyoŋ kiboi alo Epeso ikwapei akadyekitor ayoŋ iyoŋ apaki ŋina alosio ayoŋ Makedonia. Itatamete ŋituŋa ŋice aina ŋakiro ŋuna erae alyokonu, ido itemokino iyoŋ kicikak ikes tojoŋoto akitatam ŋakiro ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.3",
            "verseOrgIds": [
              "1TI.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok ikes tojoŋoto akitumoro aloemuto a ŋul ka anakimar ŋirorwa ŋulu alalak ŋulu atapapaa--ŋulu iatakinete ŋakiŋiseta ka ŋipegeta akilo akiyokit etic ŋolo ka Akuj ananupit. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.4",
            "verseOrgIds": [
              "1TI.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ŋuna elosikinitoe isua anakitatam kosi erae amina ŋina ebunit alotau a ŋolo Asegan, anatameta a ŋuna ecayete ka ananupit a ŋina a kire. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.5",
            "verseOrgIds": [
              "1TI.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aoliyosi ŋituŋa ŋice anakiro a ŋun, ido alosikis akiyan ŋakiro ŋuna koŋinae. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.6",
            "verseOrgIds": [
              "1TI.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iitanito ikes araakau ŋiketatamak a Ŋikisila, nai nyeyenete ŋakiro kec a ŋilopeyek kori ŋakiro ŋuna irworosi ikes ebasi ikiyeni nooi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.7",
            "verseOrgIds": [
              "1TI.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ikiyeni iwon atemar ejokak Ŋikisila, erae kisitiyae alopite a ŋolo itemokino kisitiyaere. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.8",
            "verseOrgIds": [
              "1TI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itemokino iwon oyenete atemar nyeyeunitae Ŋikisila aŋuna a ŋituŋa a ŋulu iyookino, nai aŋuna a ŋulu ebilibiliyete Ŋikisila ka ŋulu eŋerito akipukao, aŋuna a ŋulu nyenupito Akuj, ŋikasecak, aŋuna a ŋulu nyesegak alotai ka ŋulu ejamuwarito Akuj, aŋuna a ŋulu earete atapapa kec kori atatoto kec, ka ŋikaarak, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.9",
            "verseOrgIds": [
              "1TI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŋuna a ŋulu emalaaka, aŋuna a ŋikilyok a ŋulu iteperete ŋikilyok ŋuluce, aŋuna a ŋulu ekokoiyanarete ŋituŋa ŋuluce, aŋuna a ŋikalyokonok ka ŋulu ikoŋete ka alyokonu ka ŋulu itiyaete ŋace ŋuna nyemaasi ka akitatam ŋina iyookino. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.10",
            "verseOrgIds": [
              "1TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emaasi akitatamet ŋin ka Ŋakiro ŋuna Ajokak ŋuna aponi ekecikakin ayoŋ akisera, Ŋakiro ŋuna Ajokak ŋuna elimorito apolou ŋina ka Akuj a ŋina erereŋ.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alakara a Paulo aŋuna a ŋisyon a ŋulu ka Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.11",
            "verseOrgIds": [
              "1TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakara ayoŋ neni a Yesu Kristo Ekapolon yok, ŋolo akainaki ayoŋ agogoŋu aŋuna ke etic kaŋ, anerae ekemarak ayoŋ atemar arae ŋolo ekinyoma aŋuna ekewuakinia ayoŋ lotic keŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.12",
            "verseOrgIds": [
              "1TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "tari paaran keyanyit ayoŋ iŋes kori kesicanit kori ketoŋoit; nai aponi ekesyoni ayoŋ, anerae apaki ŋin, pa anupit ayoŋ Kristo; aŋun, pa ayeni ayoŋ ŋuna etiyae. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.13",
            "verseOrgIds": [
              "1TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon okoinak ayoŋ ajokis keŋ ilapara; ido okoinak anupit ka amina, ŋuna erae ŋuna yok alotooma akimorikina ka Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.14",
            "verseOrgIds": [
              "1TI.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erae na alimunet ŋina ikinyoma ka emaikina tocamunae: Abuni Yesu Kristo nakwap aiun ŋikasecak. Ayoŋ iŋes ekasecan ŋolo aronon nooi akilo daadaŋ, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.15",
            "verseOrgIds": [
              "1TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nai aponi ekesyoni ayoŋ; ikotere nai itoodiuni Yesu Kristo akidaŋidaŋ keŋ daadaŋ alotooma ŋuna abu iŋes ekiŋaren kitiya neni kaŋ. Alopite a lo, abu eketuruwo ayoŋ akitaanyikinet neni a daadaŋ a ŋulu epote ekaku akinup Yesu, ido toryamut akiyar ŋina nyedaun. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.16",
            "verseOrgIds": [
              "1TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyai akerit ka apolou ŋina nyedaun neni ke Erwosit a ŋolo ipukae ŋikaru ka ŋikaru, ŋolo nyetwani, ŋolo erae iŋes bon erae Akuj! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.17",
            "verseOrgIds": [
              "1TI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteo lokoku kaŋ, ekecikakini ayoŋ iyoŋ ŋakiro nu, ikwaŋina koloŋ kedwaritere aŋuna kon. Kisitiya ŋakiro nu ikwapei ŋiboro ŋulu ijiyo iyoŋ, ikotere ijiyo ejok, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.18",
            "verseOrgIds": [
              "1TI.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ido torubak irae ŋolo inupit ka ŋolo ecayete ŋatameta. Aŋero ŋituŋa ŋice akipup ŋuna ecayete anatameta kec, tosodi enyasut anupit kec. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.19",
            "verseOrgIds": [
              "1TI.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋice alokidiŋ ŋul ikes Umenayo ka Alekisanda, ŋulu adau ayoŋ akipotokin neni a Satan; ikotere itatamete ŋun ikes ajoŋore ŋiyany kec.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.1.20",
            "verseOrgIds": [
              "1TI.1.20"
            ]
          }
        }
      ]
    }
  ],
