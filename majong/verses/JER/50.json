          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimu Ekapolon ŋolo a ŋajoresyo ebe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.50.33",
            "verseOrgIds": [
              "JER.50.33"
            ]
