    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Todyeka ŋituŋa Ekapolon kisyoni ikes",
          "type": "text"
        }
      ]
    },
