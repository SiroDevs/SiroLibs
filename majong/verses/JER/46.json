            "style": "v",
            "sid": "JER 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kirwor Ekapolon neni a Yeremia a ekadwaran aŋuna a ŋituŋa a ŋakwapin.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
              "JER.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimu Ekapolon aŋuna a Ijipit, aŋuna ka asigar a Parao Neko a erwosit a ŋolo a Ijipit, asigar ŋina ayai Karikemis diyete aŋolol Eupurate ŋuna a asigar a ŋina abu erwosit Nebukadinesar ŋolo a Babilon kilou alokaru a ŋolo a ŋiomwon ipukat Yeoakim lokoku a Yosia a ŋolo a Yudaya. Tema Ekapolon,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Itijikini Babilon Ijipit",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro ŋuna abu Ekapolon tolimok Yeremia ekadwaran aŋuna ka abunore a Nebukadinesar a erwosit a Babilon akitijikin ŋituŋa a akwap a Ijipit. Tema Ekapolon neni a Yeremia,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
              "JER.46.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.19",
            "verseOrgIds": [
              "JER.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikwaan Ijipit ka ataok ŋina ebusan,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.20",
            "verseOrgIds": [
              "JER.46.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.21",
            "verseOrgIds": [
              "JER.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aema ŋituŋa a Ijipit igworosi ikwa emun ŋolo eemi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.22",
            "verseOrgIds": [
              "JER.46.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.24",
            "verseOrgIds": [
              "JER.46.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimu Ekapolon ŋolo a ŋajoresyo, Akuj a Ŋisirael tema, “Kiirasi, ayauni ayoŋ akisicanet neni ka Amon a akuj a Tebes ka neni a Parao, Ijipit ka ŋakujo keŋ ta ŋirwosi keŋ, neni a Parao ka daadaŋ ŋulu ikinyomito iŋes. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.25",
            "verseOrgIds": [
              "JER.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Epotokini ayoŋ ikes neni a ŋulu imanito akiyar kec, neni a erwosit Nebukadinesar a ŋolo a Babilon ka neni a ŋikapolok a ŋulu ipukatotor iŋes. Ekaku, epote ŋituŋa akiboi alo Ijipit lopite ŋolo ayakatar alorwa a ŋulu a koloŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eiuni Akuj Ŋisirael",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.26",
            "verseOrgIds": [
              "JER.46.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nai ani eruwor iyes, nyikuryaketa iyes ŋiletok a Yakob,",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.27",
            "verseOrgIds": [
              "JER.46.27"
            ]
          }
        }
      ]
