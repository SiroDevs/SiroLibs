    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toarae Gedalia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edoli elap ŋolo a ŋikanikaarei, abu Isimael lokoku a Nesania a ŋolo arae lokoku a Elisama a ŋolo anateker a erwosit, epei a ŋikapolok a ŋulu epukatotor erwosit, abu iŋes torukut ka ŋikilyok ŋitomon neni a Gedalia alokoku ka Aikam potu Misipa. Apaki ŋina emujata ikes ŋamugati kaapei alo Misipa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonyout Isimael lokoku a Nesania ka ŋikilyok ŋulutomon toara a ekileŋ Gedalia lokoku ka Aikam a ŋolo arae lokoku a Sapan, anerae kebu erwosit a Babilon toseu iŋes akipuka ŋituŋa alo Yudaya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu daŋ Isimael toar Ŋiyudayan daadaŋ ŋulu arukito ka Gedalia alo Misipa ka ŋasigarya a Ŋibabiloniyae ŋuna ayakasi nen.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋina atupakini akoloŋit ŋina aarere Gedalia, eriŋa idiotuŋanan nyeyanyuna ŋakiro ŋun, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "todolut ŋikilyok ŋatomonikanikauni alo Sekem, Silo ka Samaria ebanyaritae ŋipeneka kec, tonapito ŋilowi ŋulu acilicilya toduŋuduŋo ŋawat kec, ayaunito ikes ŋainakineta ŋuna a ŋikinyom ka ekinyate ainakin neni ke Ekapolon alo Kai ka Akuj. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolomu Isimael lokoku a Nesania kiŋa alo Misipa akisiryam ŋikilyok ŋul, egworo iŋes ebunit. Ani iryamun iŋes ka ikes, tolimok ikes tema, “Potu neni a Gedalia a lokoku a Aikam.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edolete ŋikilyok ŋul kidiŋ etaun, apotu Isimael lokoku a Nesania ka ŋikilyok ŋulu arukitotor iŋes toara ŋikilyok ŋul a ekileŋ, kimasakis ŋawat kec tooma akare. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai aya alokidiŋ kec ŋikilyok ŋitomon ŋulu apotu tolimokis Isimael temasi, “Nyikiar kare ca isua, anerae ikiyakar isua ŋisitowae a ŋikinyom a ŋaganoi, a ŋikinyom a ŋulu esibito erau ka akimyet ta ao, iwuaitae isua ŋiboro ŋul alomanikor.” Aŋun, abu Isimael nyear ikes kaapei ka ŋirukitos kec.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae akare ŋina emasakini Isimael ŋawat daadaŋ ŋuna a ŋikilyok a ŋulu abu iŋes toar, akare ŋina apolon, ŋina koloŋ keboki erwosit Asa aŋuna ka akiuryarya erwosit Baasa ŋolo a Isirael nyerem iŋes. Abu Isimael kilelebik akare ŋin ŋawat a ŋikilyok a ŋulu abu iŋes toar. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toriko nai Isimael ŋituŋa ŋuluce daadaŋ ŋulu aya Misipa, ŋidwe a erwosit ŋulupesur ka ŋituŋa daadaŋ ŋulu edoŋito Misipa ŋulu kebu Nebusaradan ekapolokiniton a ŋasigarya a Babilon kicikak neni a Gedalia alokoku a Aikam. Abu Isimael toriko ŋituŋa ŋul daadaŋ erae ŋirikon totuboror nakwap a Ŋiamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai ani iirarete Yonasan lokoku a Karea ka ŋikarikok a ŋajoresyo ŋulu arukitotor iŋes ŋakiro daadaŋ ŋuna kebu Isimael lokoku a Nesania kitiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "tocunakis ŋikilyok ŋulu arukitotor ikes daadaŋ toloto akitijiore Isimael lokoku a Nesania. Kisiiryakis ikes iŋes anabwal a ŋina apolon a ŋina ayai Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iŋolikinete ŋituŋa ŋulu arukito ka Isimael Yoanan lokoku a Karea ka ŋikarikok a ŋajorei erukito ka iŋes, tolakar. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, apotu ŋituŋa daadaŋ ŋulu abu Isimael torik erae ŋirikon alo Misipa toboŋosi toloto neni a Yoanan alokoku a Karea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai abu Isimael lokoku a Nesania tosi aneni a Yoanan kaapei ka ŋikilyok ŋikanikauni, toloto neni a Ŋiamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu nai Yoanan lokoku a Karea ka ŋikarikok a ŋajorei ŋulu arukitotor iŋes yaasi ŋituŋa ŋulu edoŋito ŋulu kebu Isimael lokoku a Nesania toriko alo Misipa erae ŋirikon kedau akiar Gedalia lokoku ka Aikam, ŋasigarya, ŋaberu, ŋidwe, ŋikolupanotin ŋulu sek kebu Yoanan yau alo Gibeon. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torotokis nai ikes, ido kieŋut alo Gerus-Kimiam alodiyete Betelem ecamito alosit Ijipit, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "akisii aneni a Ŋibabiloniyae a ŋulu etubulito ikes, anerae abu Isimael lokoku a Nesania toar Gedalia lokoku ka Aikam ŋolo abu erwosit a Babilon kituruwo ekepukan a Yudaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
