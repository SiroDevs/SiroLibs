      },
      "items": [
        {
          "text": "Akiŋuruŋura a Yeremia neni ka Akuj",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Toboŋok Akuj ŋakiro a Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
