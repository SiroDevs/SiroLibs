              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akoloŋit ŋinapei ŋin nakwaare, aponi toarae Balisasar ŋolo arae erwosit a Ŋimedes, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.30",
            "verseOrgIds": [
