        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŋakiro ŋun, iŋes eyakiunia Akuj akan ŋina abu kigir ŋakiro ŋun. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋakiro ŋuna egiritae ikes nu: MENE, MENE, TEKEL, PARISIN. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apolou a ŋakiro a ŋun iŋes na, MENE iŋes atemar adau Akuj akimarun ŋirwa ŋulu a apukan kon ka adaun apukan kon. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "TEKEL iŋes atemar, adaun akipim iyoŋ anakipimeta ka ikiryamun atemar nyipedorit akipuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.27",
            "verseOrgIds": [
              "DAN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "PERES iŋes atemar atyakatyakae akwap ŋina ipukat iyoŋ, ainakin epeiwae neni a Ŋimedes ka epeiwae neni a ‘Niperisian;’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.28",
            "verseOrgIds": [
              "DAN.5.28"
            ]
          }
        }
      ]
