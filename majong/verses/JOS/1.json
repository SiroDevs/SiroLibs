  "bookId": "JOS",
  "reference": "Yos. 1",
  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOS 1"
      },
      "items": [
        {
          "text": "1",
