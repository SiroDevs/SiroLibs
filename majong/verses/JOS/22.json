            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirarete Pineas ŋolo arae esacaradoti ka ŋikarikok a Ŋisirael ŋulu aponito a natekerin a Ŋisirael ŋakiro ŋuna alimunete ŋituŋa a Ruben ka ŋulu a Gad ta ŋulu ka atutubet a apei a ŋina Manase, apotu tolakaros. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tolimok nai Pineas lokoku ka Eleasar ŋolo arae esacaradoti ŋituŋa a Ruben ka ŋulu a Gad ta ŋulu ka atutubet a a apei a ŋina a Manase tema, “Ikiyenu iwon nakoloŋit na atemar ikirukit iwon ka Ekapolon, anerae nyeŋero iyes akiwuapit ŋakiro ke Ekapolon anakiduk Namuroet na. Idaut tokona iyes aiun Ŋisirael, ido nyisicani Ekapolon ŋituŋa yok.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
