{
  "id": "1CO.16",
  "number": "16",
  "bookId": "1CO",
  "reference": "1 Ŋikor. 16",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
