        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋainakineta neni a ŋikanupak",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acamit tokona akirwor ŋakiro ŋuna etapito ŋuna a ŋisiliŋa a ŋulu erae tocunakinae kiŋaranakinere ŋituŋa ŋulu ka Akuj ŋulu eyakasi Yudeya. Itemokino iyes kitiyata ŋuna abu ayoŋ olimok ŋatukon ŋuna a Ŋikristo a ŋulu anakwap a Galatia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ŋinakoloŋit a Esabit, itemokino ŋinituŋanan kus toseta nawae ŋisiliŋa ŋidi lotyae ŋolo ke ebari keŋ, kidiatakinos, ikotere ani abuni ayoŋ, nyecuni nabo ŋice. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani adoluni ayoŋ neni kus, ainakini ŋikilyok ŋulu iseunete iyes ŋabaruwae ŋuna elimorito atemar erae ikes ataŋae; kiyakiyarae ikes yaasi ŋainakineta kus Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani erae kejok ayoŋ daŋ alosit, ikirukori ayoŋ ka ikes.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋakiro ŋuna atubunit Paulo akitiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuni ayoŋ aanyun iyes kadau akitor nakwap a Makedonia, anerae itemokino etor Makedonia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acepaki ikiruki iwon adiouriyen, kori daŋ ikiruki iwon ŋirwa ŋulu ka alilimu; ikotere ikiŋarakis iyes ayoŋ olot kiŋaren analosit kaŋ neni ca alosi ayoŋ daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyacamit akitorun aanyun iyes tokona alotooma apaki na ŋina euruwuana, nai egeno ayoŋ akiya adiopaki ŋina aoyan ka iyes, erae kecamaki Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai eboi ayoŋ a ne alotaun a Epeso akitodol akoloŋit ŋina a Pentekoste. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anerae ayakar tokona ayoŋ apaki ŋina ajokan ŋina itemokino ayoŋ etiyaa etic ŋolo apolon ŋolo emaikina etiya, tari kelalak ŋiketepegak a ne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani kebu Timoteo neni kus, kijautu iŋes ejok, ikotere nyekuryana iŋes irukito ka iyes; anerae itiyae iŋes etic ŋolo ke Ekapolon ikwa ayoŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyejamuwa idiotuŋanan iŋes. Kiŋarakisi iŋes, ikotere torubak elosi a ekisil, ido toboŋu neni kaŋ; anerae edarit ayoŋ iŋes torukut ka ŋikanupak. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋuna etapito lokaato yok Apolo, abu ayoŋ esimukek iŋes nooi abunore kaapei ka ŋikaitotoi ŋuluce aanyun iyes, nai nyecamunit iŋes nooi abunore inaa ŋirwa lu. Nai ani eryamuni iŋes apaki, ebuni.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ŋakiro ŋuna esidyok",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.12",
            "verseOrgIds": [
              "1CO.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totenito, kicata ananupit, totitiny ka togogoŋ! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.13",
            "verseOrgIds": [
              "1CO.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋuna daadaŋ itiyaete iyes, kitiyata anamina. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.14",
            "verseOrgIds": [
              "1CO.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyenete iyes Stepana ka ŋituŋa ŋulu ke ekal keŋ, erae ikes Ŋikristo ŋulu esyaunete akinup anakwap a ŋina ka Akaia ka ainakinosi akitiya etic aŋuna a ŋituŋa ka Akuj. Ekemaimai ayoŋ iyes ŋikaitotoi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "topupo ŋikilyok ŋulu ikote ŋul ka ŋulu itiyaete ka ikes.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alakara ayoŋ aŋuna ka abunore a Stepana, Potunato ka Akaiko, anerae etemokis ikes daadaŋ ŋuna arae ŋuna kus; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "anerae esiyeŋut etau kaŋ, ikwaŋinapei aponiata kisieŋuniata ŋitai kus. Ejok akerit ŋikilyok ŋulu ikote ŋul.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikimalaete iyes ŋituŋa ŋulu ka akwap a Asia. Ikimalaete iyes nooi Akwila ka Prisila ta ŋikanupak ŋulu iryamunun kai kec akilip alotooma Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikimalaete iyes ŋikaitotoi daadaŋ ŋulu eya ne. Kimalas itunasi make itoodiunito atemar iminin.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayoŋ Paulo egirit ŋimalasyo lu ka akan kaŋ a elope. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.21",
            "verseOrgIds": [
              "1CO.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani pa kemina ituŋanan Ekapolon, itemokino iŋes kicenoi. Ekapolon kosi, bua! ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.22",
            "verseOrgIds": [
              "1CO.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyai neni kus ajokis ŋina ke Ekapolon Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.23",
            "verseOrgIds": [
              "1CO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyai neni kus daadaŋ amina kaŋ anakimorikina yok ka Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.24",
            "verseOrgIds": [
              "1CO.16.24"
            ]
          }
        }
      ]
    }
  ],
