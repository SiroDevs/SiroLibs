          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikigworo isua a ŋakiro a ŋun, eleleete ŋakiyo anakonyen kosi,",
          "type": "text",
          "attrs": {
