          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Apotu ŋimoe kaŋ ekekamasi ayoŋ ikwa ikeny, tomam bo aronis etiyat ayoŋ neni kec.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.52",
            "verseOrgIds": [
              "LAM.3.52"
            ]
