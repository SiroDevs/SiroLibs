          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe Ekapolon, abu ayoŋ ekalou neni kon apaki ŋina asiporitor kwap akipany;",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.55",
            "verseOrgIds": [
              "LAM.3.55"
            ]
          }
        }
