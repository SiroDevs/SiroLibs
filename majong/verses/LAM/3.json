          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe Ekapolon, ibu iyoŋ towo aŋuna kaŋ, ibu iyoŋ tolaku akiyar kaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.58",
            "verseOrgIds": [
              "LAM.3.58"
            ]
          }
