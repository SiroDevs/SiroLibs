          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe Ekapolon, aŋuna a ŋiticisyo kec, kisican ikes lopite ŋolo emaikina kisicanere ikes.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.64",
