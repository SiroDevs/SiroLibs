          },
          "items": [
            {
              "text": "61",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Okoe Ekapolon, iira iyoŋ ikes ekeyanyete ayoŋ, iyeni iyoŋ daadaŋ ŋuna eyeete ikes akitiya ekemanito ayoŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.61",
            "verseOrgIds": [
              "LAM.3.61"
            ]
