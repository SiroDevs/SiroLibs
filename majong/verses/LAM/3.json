          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikiyanyete ka ikijamuwarito isua ŋimoe kosi daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.46",
            "verseOrgIds": [
              "LAM.3.46"
