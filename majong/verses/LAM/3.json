          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Erubakinete ŋakiyo eleleete anakonyen kaŋ, mam nyejoŋoete alel,",
          "type": "text",
          "attrs": {
            "verseId": "LAM.3.49",
            "verseOrgIds": [
              "LAM.3.49"
            ]
          }
        }
