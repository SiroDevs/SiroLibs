{
  "id": "MRK.15",
  "number": "15",
  "bookId": "MRK",
  "reference": "Mar. 15",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "MRK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu alokiŋaren Pilato",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taparacu sek, totukokinos ŋisacaradotin ŋulu apolok ka ŋikatukok ka ŋiketatamak ŋulu a Ŋikisila ta Atukot daadaŋ. Toena ikes Yesu torikosi inakis Pilato. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.1",
            "verseOrgIds": [
              "MRK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit Pilato Yesu tema, “Irae iyoŋ erwosit a Ŋiyudayan a?” Toboŋok Yesu iŋes, “Ilimu iyoŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.2",
            "verseOrgIds": [
              "MRK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.2",
            "verseOrgIds": [
              "MRK.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisitakis ŋisacaradotin ŋulu apolok Yesu a ŋakiro a ŋuna alalak. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.3",
            "verseOrgIds": [
              "MRK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit nabo Pilato Yesu tema, “Emam ŋuna iboŋokini iyoŋ a? Kiira iyoŋ ŋakiro ŋuna ikisitakinitotor ikes iyoŋ, elalak!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.4",
            "verseOrgIds": [
              "MRK.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.4",
            "verseOrgIds": [
              "MRK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai nyeboŋok Yesu adiokirot daŋ. Toumok nai Pilato nooi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Totubokinae Yesu atwanare",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.5",
            "verseOrgIds": [
              "MRK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anasuban a daadaŋ a ŋuna a Paska, amina Pilato alacanakin emabus daadaŋ ŋolo iŋisete ŋituŋa iŋes alacakin. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.6",
            "verseOrgIds": [
              "MRK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayai epei ŋolo anyaritae Baraba, ŋolo aŋerit apukan, ŋolo aenitae alomabus kaapei ka ŋulu aŋerito apukan, ŋulu kepotu toara icetuŋanan alojiye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.7",
            "verseOrgIds": [
              "MRK.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocelut ŋituŋa, kisyakis akilip Pilato alacakin emabus ikwaŋinapei sek elacanakinia. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.8",
            "verseOrgIds": [
              "MRK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toboŋok Pilato ikes tema, “Icamito iyes olacak ayoŋ erwosit a Ŋiyudayan a?” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.9",
            "verseOrgIds": [
              "MRK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Totamu Pilato atemar, “Ekepotokis ŋisacaradotin ŋulu apolok ayoŋ Yesu aŋuna ka arakao.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.10",
            "verseOrgIds": [
              "MRK.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.10",
            "verseOrgIds": [
              "MRK.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kicocoa nai ŋisacaradotin ŋulu apolok ŋituŋa temasi, “Tolimokisi Pilato tolacak Baraba.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.11",
            "verseOrgIds": [
              "MRK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit nabo Pilato ŋituŋa tema, “Ekokini ayoŋ ekile lo ŋolo ibasi iyes erwosit a Ŋiyudayan ai?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.12",
            "verseOrgIds": [
              "MRK.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.12",
            "verseOrgIds": [
              "MRK.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocelut nabo ikes temasi, “Kibubuk iŋes lomusalaba!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.13",
            "verseOrgIds": [
              "MRK.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.13",
            "verseOrgIds": [
              "MRK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiŋit Pilato ikes tema, “Nyo esecit iŋes?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocelut nabo nooi temasi, “Kibubuk iŋes!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.14",
            "verseOrgIds": [
              "MRK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋuna acamitor Pilato akitalakar aruruma ŋin, abu tolacak Baraba. Kisibuŋa ŋisigarya Yesu, ani irikakinete, yaasi ikes iŋes kibubukis lomusalaba.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tokyenatar ŋisigarya Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.15",
            "verseOrgIds": [
              "MRK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torikosi ŋisigarya Yesu tooma kai ŋina ke ekawuoikiniton ekepukan a Roma anakwap a ŋin, tonyaraut ŋisigarya ŋuluce daadaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.16",
            "verseOrgIds": [
              "MRK.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitanapa Yesu elou ŋolo kipurat areŋan, toyeut aikit ŋina a ŋikukwa, kiwuakis nakou keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.17",
            "verseOrgIds": [
              "MRK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisyakis akyenar iŋes imalaete ebasi, “Toyai jik erwosit a Ŋiyudayan!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.18",
            "verseOrgIds": [
              "MRK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kikoŋikoŋo akeekou a ebela, kimwaanakis iŋes ka toryediko alokiŋaren keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.19",
            "verseOrgIds": [
              "MRK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedaut akisol iŋes, tolacasi elou ŋolo kipurat areŋan aneni keŋ, kitanapikis nai ŋilowi keŋ. Yaa ikes iŋes akibubukin lomusalaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kibubukinoe Yesu lomusalaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.20",
            "verseOrgIds": [
              "MRK.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiryamas ikes lorot ka ecekaloton ŋolo anyaritae Simoni, papa ka Alekisanda ka Rupus. Arae iŋes ŋolo alo Kurene, alosi lotaun. Toreikis ikes iŋes akiryoŋ emusalaba a Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.21",
            "verseOrgIds": [
              "MRK.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torikosi ikes Yesu tari Gologota, akeepolou iŋes atemar, “Akwap ŋina ka Akuulu.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.22",
            "verseOrgIds": [
              "MRK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inakis ikes iŋes epiini ŋolo enyalitae ka apid, towou Yesu akimat. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.23",
            "verseOrgIds": [
              "MRK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibubukis ikes Yesu, tokora ŋikeelowi, kilamilama ikotere totedoryata ŋini elemari elou ŋolo alacunete ikes aneni a Yesu, kiwuakis kiŋaren kec. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.24",
            "verseOrgIds": [
              "MRK.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebubukinio Yesu lomusalaba ŋisaae ŋiuni ŋulu ka ataparacu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.25",
            "verseOrgIds": [
              "MRK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigira lomusalaba ŋakiro ŋuna esitakinitere ebe, “ERWOSIT A ŊIYUDAYAN”. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.26",
            "verseOrgIds": [
              "MRK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kibubukis ikes ŋikademanarak ŋiarei kaapei ka iŋes, epei teten ka ŋoloce kedyany keŋ. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.27",
            "verseOrgIds": [
              "MRK.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyookinotor Ŋakigireta ŋuna igiritae ebe, “Aponi kimarakinae iŋes kaapei ka ŋikasecak.”]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.28",
            "verseOrgIds": [
              "MRK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋituŋa daadaŋ ŋulu kepotu kitorut nen, kiyanya yesu, kimuŋimuŋete ŋakyes ebasi, “Okoe! Iyoŋ ŋoon ibala ebe ituwori Akai ka Akuj, ido todukok nabo alotooma ŋirwa ŋiuni! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.29",
            "verseOrgIds": [
              "MRK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toiun iyoŋ bon, todoku alomusalaba!” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.30",
            "verseOrgIds": [
              "MRK.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋisacaradotin daŋ ŋulu apolok kaapei ka ŋiketatamak a Ŋikisila kisoloto iŋes ebasi, “Aiununui iŋes paaran ŋulucetuŋa, nai tokona nyeiun iŋes bon. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.31",
            "verseOrgIds": [
              "MRK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eteutu cenite Kristo, erwosit a Isirael, edokuni alomusalaba; ikotere ikiyanyuni ka ikinupi daŋ.” Tari ŋulu ebubukinitoe kaapei ka iŋes, apotu tojamuwasi iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Atwanare a Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.32",
            "verseOrgIds": [
              "MRK.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ameun ŋisaae ŋikanikapei tari ŋikanikaomwon ŋulu ka apaaran, kiryoniar akwap daadaŋ cuc. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.33",
            "verseOrgIds": [
              "MRK.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani edoli ŋisaae ŋikanikaomwon, kiworou Yesu a etoil a ŋolo apolon tema, “Eloi, Eloi, lama sabakasani?” Akeepolou iŋes atemar, “Akuj kaŋ, Akuj kaŋ, kaanukiro ikiesikinia iyoŋ ayoŋ?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.34",
            "verseOrgIds": [
              "MRK.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirarete ŋituŋa ŋulu edunyito iŋes ŋakiro ŋun, temasi, “Kiirasi, enyarit iŋes Eliya.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.35",
            "verseOrgIds": [
              "MRK.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomotun epei alokidiŋ kec, kilumok ibore ŋini yabuk lopiini ŋolo adadaŋan, toenik lobela, inak Yesu tomat. Tema iŋes ebe, “Edareutu mono! Eteutu cenite kebuni Eliya alacun iŋes alomusalaba.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.36",
            "verseOrgIds": [
              "MRK.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiworou Yesu a etoil a ŋolo apolon, kiridak nai.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.37",
            "verseOrgIds": [
              "MRK.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tocila anaŋga ŋina eneno alo Kai ka Akuj beret ageun alokidiama tari kwap. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.38",
            "verseOrgIds": [
              "MRK.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋolopite aanyuwarya ekapolokiniton ŋisigarya amiat ŋolo awuoi a nen atemar eridak Yesu tema, “Kire, kerae ekile lo Lokoku ka Akuj.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.39",
            "verseOrgIds": [
              "MRK.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyakas ŋaberu ŋace ŋuna eteete iŋes aneni alwanan, arae Maria Magadalena, Maria toto a Yakobo ka Yose ta Salome. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.40",
            "verseOrgIds": [
              "MRK.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani apaki ŋina ayakar iŋes Galileya, apotu ikes tonupa ŋakiro keŋ ka kiŋaranakinete iŋes. Aya nabo daŋ ŋaberu ŋuna alalak ŋuna apote kaapei ka Yesu tari Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tonukae akuwan a Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.41",
            "verseOrgIds": [
              "MRK.15.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eboŋ akoloŋit ŋina a ŋakan ŋina etemonokinere aŋuna a Sabato, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.42",
            "verseOrgIds": [
              "MRK.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "bu Yosepu ŋolo ka Arimatea. Arae iŋes ekile ŋolo apolon a Natukot a Ŋiyudayan ka edarit Apukan ka Akuj bu. Tolot iŋes neni a Pilato, kiŋitak akuwan a Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.43",
            "verseOrgIds": [
              "MRK.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "MRK 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toumok Pilato iirari atemar keris Yesu atwana. Tonyara iŋes ekarikon a ŋisigarya amiat, kiŋit iŋes erae kire ketwanit Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.44",
            "verseOrgIds": [
              "MRK.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "MRK 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedau Pilato akiirar aneni ke ekarikon a ŋisigarya, abu tocamak Yosepu alemar akuwan a Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.45",
            "verseOrgIds": [
              "MRK.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "MRK 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togyelu Yosepu anaŋga, ani kelemu akuwan kwap, kilogilogak anaŋga. Tosodi ya akuwan a Yesu nalyal ŋina abokakinitae nataaba. Kikokorik amoru ŋina apolon lokek ka alyal. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.46",
            "verseOrgIds": [
              "MRK.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "MRK 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiteete Maria Magadalena ka Maria toto a Yose, neni eperikinio akuwan a Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.15.47",
            "verseOrgIds": [
              "MRK.15.47"
            ]
          }
        }
      ]
    }
