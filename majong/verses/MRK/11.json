{
  "id": "MRK.11",
  "number": "11",
  "bookId": "MRK",
  "reference": "Mar. 11",
  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
