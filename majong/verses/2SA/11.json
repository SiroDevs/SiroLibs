              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani iirari aberu a Uria atemar aari lokile keŋ, abu kigwor iwololoe aŋuna alokile keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.26",
            "verseOrgIds": [
              "2SA.11.26"
            ]
          }
        },
        {
          "name": "verse",
