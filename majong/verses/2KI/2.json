            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Elisa torotok a nen kidir Besel. Ani elosi iŋes alorot, potu ŋidyain ŋice, ido ijutanarete iŋes ecelasi ebasi “Tolot ane, iyoŋ ŋolopalor lo! Tolot ane iyoŋ ŋolopalor lo!” ",
          "type": "text",
