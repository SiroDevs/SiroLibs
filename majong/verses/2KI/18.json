              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu Eliakim lokoku a Ilikia ka Sebina ta Yoa todyeka ekapolokiniton ejie a ŋasigarya ka Asiriya temasi, “Iyoŋ ikipolokinit isua. Ikilipit iyoŋ ikisirwor isua anaŋajep a ŋina ka Aramaik, anerae ikiyeni isua aŋajep ka Aramaik. Nyikisirwor isua a Ŋaburaniyae, anerae iirarete ŋituŋa ŋulu edukito ŋakais kec narwatata alotooma.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nai abu ekapolokiniton ejie a ŋasigarya ka Asiriya tolimu tema, “Pa sek ekeyakuunit ekapolon kaŋ ayoŋ neni ke erwosit kus ka neni kus make alimokin ŋakiro ŋun, nai arae tari neni a ŋulu edukito ŋakais kec narwatata alotooma, ŋulu elosyo kaapei ka iyes akitanyam ŋacin ka akimat ŋakul kus pei.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Towo nai ekapolokiniton ejie a ŋasigarya ka Asiriya tosodi tocelu nooi a ŋaburaniyae tema, “Kiirasi ŋakiro ŋuna ke erwosit a ŋolo arwon a ŋolo ka Asiriya! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala iŋes nyicamut Esekia ikimodianakini iyes, anerae nyepedori iŋes alakun iyes aneni kaŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebala iŋes nyicamut Esekia ikilimonokini iyes akikinyom Ekapolon ebala, kire ikilakuni Ekapolon iyes ka nyipotokini Ekapolon Yerusalem nakan ŋuna ke erwosit ka Asiriya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyiirasi ŋakiro ŋuna ke Esekia, anerae ebala erwosit ŋolo ka Asiriya tojala ejie, potu esila, ikotere torubakis iboiyete alorerya kus, tonyam ŋinituŋanan epiini ka ŋiboboryo keŋ a elope, tomat daŋ ŋakipi a akare keŋ; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "akitodol ŋina akaomunio ayoŋ iyes akiya nakwap ŋina ikwaan ka ŋina kus, nakwap ŋina eya ŋikinyom ka epiini, nakwap ŋina eya ŋamugati ka ŋimanikorin ŋulu ke epiini, nakwap ŋina eya ŋikito ŋulu ka akimyet ka eyai ao daŋ. Ikiteyarete iyes ŋamuja ŋun, nyitwakete. Kiuryaasi Esekia nyikimodianak aŋuna irworor ebe, ‘Ikilakuni Ekapolon iyes.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyai anakujo aŋuna a ŋakwapin adio ŋina abu tolaku akwap keŋ aneni ke erwosit a ŋolo ka Asiriya a? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ai mono eyakasi ŋakujo ŋuna ka Amas ka Arapad? Ai mono eyakasi ŋakujo a Separabaim ka Ena ta Ipa? Apotu mono ikes tolakut Samaria aneni kaŋ a? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anu mono alotooma ŋakujo ŋun daadaŋ ŋuna a ŋakwapin apotu toiut ŋakwapin kec aneni kaŋ? Alipite nai elakunia Ekapolon Akuj Yerusalem aneni kaŋ?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apotu ŋituŋa kililiŋa cek nyeboŋokis tari akirot apei, anerae ecikit Esekia ikes ebe, “Nyiboŋonokis ŋakiro ŋuna a ekapolokiniton ejie aŋasigarya ka Asiriya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodo nai Eliakim lokoku a Ilikia ŋolo apolokinit etic alokai ke erwosit ka Sebina ekegirigiran ta Yoa lokoku ka Asap ŋolo eŋadae ŋakiro ŋuna adaun akigir, toloto neni ke Esekia ecilicilito ŋilowi kec, tolimokis iŋes ŋakiro ŋuna erworo ekapolokiniton ejie a ŋasigarya ka Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
