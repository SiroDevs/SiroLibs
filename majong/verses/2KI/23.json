              "2KI.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Yosia tolema ŋimurok, ŋikapilak, ŋakujo ŋuna a ŋikalya ŋuna ayeunitae ta asiilio daadaŋ ŋina ayai nakwap a Yudaya ka Yerusalem. Abu Yosia kitiya ŋun, ikotere isiyookini ŋuna a ŋikisila a ŋulu egiritae lokitaabo ŋolo abu Ilikia esacaradoti torukau alotooma Akai ke Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amam sek ekiŋaren erwosit ece ŋolo ekoni Yosia ŋolo ewuapit Ekapolon a etau keŋ a daadaŋ ka anakiyar keŋ a daadaŋ ta anagogoŋu keŋ a daadaŋ anakiwuapit ŋikisila a Moses. Mam tari erwosit ece ŋolo abu min ekaku keŋ ŋolo etiyae ŋuna etiyat iŋes.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tari kikote nen daŋ abu Ekapolon torubak eŋoit nooi neni ka akwap a Yudaya aŋuna ka aronis a daadaŋ a ŋina sek kebu Manase kitoŋoya Ekapolon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Ekapolon totub tema, “Alemari ayoŋ Yudaya daŋ ejoŋo akitere lopite ŋolopei abunio olemarya alo Isirael ŋituŋa a Isirael. Aŋeri ayoŋ tari Yerusalem neni sek erae etaun ŋolo aseunit ayoŋ. Aŋeri nabo tari Akai na ŋina sek abu ayoŋ otema ekelipeneneere ayoŋ.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Totwan Yosia alojie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŋiticisyo a Yosia ŋuluce daadaŋ, ŋuna daadaŋ etiyat iŋes, igiritae lokitaabo ŋolo a ŋakiro a ŋirwosi a Yudaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apaki ŋina epukator Yosia abu Parao ŋolo anyaritae Neko bu anakwap keŋ alo Ijipit, tolot neni ke erwosit a ŋolo ka Asiriya anaŋolol Eupurate. Acamit Neko akiŋarakin erwosit ŋolo ka Asiriya akitijiore Yosia, tolot neni keŋ pa eyeni ŋakiro ŋadi, nai ani iryamete ikes lorot aneni enyaritae Megido, abu Parao Neko toar Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosodo ŋirukitos ŋulu a Yosia kiwokosi akuwan keŋ a agaari a ŋina eritae a ŋaŋolei, yaut Yerusalem tonuka neni sek etemokinit iŋes aŋuna keŋ. Apotu ŋituŋa kinyonyoa Yeoas ŋolo arae lokoku keŋ toruwor erwosit, kilunyokin lokicoloŋ a Yosia a papa keŋ, kipuka Yudaya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Apukan a Yeoas ka akikamaro keŋ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikaru a Yeoas ŋatomoniarei ka ŋiuni apaki ŋina esyakinia akipuka; kipuka iŋes Yudaya alo Yerusalem ŋilapyo ŋiuni. Arae ekiro a toto keŋ Amutal nakoku keŋ a Yeremia a ŋolo alo Libina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiyat iŋes ŋakiro ŋuna aronok aneni ke Ekapolon lopite jik ŋolo etiyatotor atapapaa keŋ. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Parao Neko toen iŋes aneni anyaritae Ribila anakwap ka Amas, todaun Yeoas epite ŋolo iboikinor Yerusalem akipuka. Toreik Parao ŋituŋa a Yudaya akitac ocur neni keŋ, totacae neni keŋ ŋatalantae amiat ŋulu ke esilipa ka etalantait ŋolo ke egolid. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiwuak Neko Eliakim lokoku a Yosia toruwor erwosit kilunyokin neni a papa keŋ toruwor erwosit, kilocok tari ekiro keŋ toruwor Yeoiakim. Nai ya iŋes Yeoas Ijipit totwanik inaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu Yeoiakim inak esilipa ke egolid neni a Parao Neko, totubok ŋituŋa ocur ŋolo alalan nooi aŋuna ka arukaunia ŋisiliŋa ŋulu eitanit Parao. Toreiyanak iŋes ŋituŋa daadaŋ alemikin iŋes esilipa ka egolid, atubokinitae ŋinituŋanan ocur alotyae a ŋolo a ebari keŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kipuka Yeoiakim Yudaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arae ŋikaru a Yeoiakim ŋatomoniarei ka ŋikan apaki ŋina esyakinia akipuka Yudaya. Kipuka iŋes Yudaya alo Yerusalem ŋikaru ŋitomon ka epei. Arae ekiro a toto keŋ Sebida nakoku keŋ a Pedaia a ŋolo alo Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abu iŋes kitiya ŋakiro ŋuna aronok aneni ke Ekapolon lopite jik ŋolo etiyatotor atapapaa keŋ daadaŋ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
      ]
    }
