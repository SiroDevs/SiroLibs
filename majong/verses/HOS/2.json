            "number": "1",
            "style": "v",
            "sid": "HOS 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŋun, tolimok ŋituŋa kon Ŋisirael ebe erae ikes, “Ŋituŋa ŋulu ka Akuj” ka “Ŋiminan ŋulu ke Ekapolon.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aŋerenen a Ŋisirael Akuj ka akisicanio ta alakuno.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.15",
            "verseOrgIds": [
              "HOS.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HOS 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alimu Ekapolon atemar, akoloŋit ŋin, ikinyarae iyoŋ ayoŋ, “Ekile kaŋ”, nyeriŋa nabo iyoŋ ikinyarae ayoŋ, “Baal kaŋ.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.16",
            "verseOrgIds": [
              "HOS.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HOS 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alemari ayoŋ ŋirorwa ata Baal anakituk keŋ, ido nyenyarao nabo jik ata Baal a ŋirorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.17",
            "verseOrgIds": [
              "HOS.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HOS 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewuakini ayoŋ aŋuna kus akoloŋit ŋin acamunet, ikotere tomaikin iyes ka ŋityaŋ ŋulu adedeŋak, ŋikyeny ŋulu eporete ka ŋiboorei ŋulu elyato alokwap, ekisari ayoŋ anakwap akau a ŋikaleŋeleŋe, ekileŋ ka ejie, ido akainakini ayoŋ iyes kiboikinos emam ŋace. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.18",
            "verseOrgIds": [
              "HOS.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HOS 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayai ayoŋ iyoŋ toruwor aberu kaŋ ŋikaru ka ŋikaru, iruwor iyoŋ aberu kaŋ anakiyookino, anacamit ka anamina a ŋina nyiryaŋiryaŋa ta anakisyon. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.19",
            "verseOrgIds": [
              "HOS.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HOS 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akayai ayoŋ iyoŋ toruwor aberu kaŋ anakikinyoma, tosodi iyenuni iyoŋ Ekapolon.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.20",
            "verseOrgIds": [
              "HOS.2.20"
            ]
          }
        }
      ]
    }
  ],
