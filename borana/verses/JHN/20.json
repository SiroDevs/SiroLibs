          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, Atini na arginaani d'ugefatte? Ayyaana worra ka ato inargiini d'ugefatu jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
