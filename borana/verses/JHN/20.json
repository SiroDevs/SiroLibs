              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasoni, Aabbo kiyyafi Waaqa kiyya! jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
