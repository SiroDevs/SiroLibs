              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni akheekha d'ibi heddu jara ufi durati tolche, ka kitaaba kana keesati int'aafini. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
