              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo haga kana ya t'aafani, aka isani aka Yesoni Kristo Ilma Waaqa d'ugefattani, d'ugefannaani aka maqa isatiini jireenna argattani.",
          "type": "text",
          "attrs": {
