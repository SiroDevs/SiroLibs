        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaraa fiit'e, waan anini jed'u, kad'achaafi yaamachafi galata Waaqa deebisiti maro nama ch'ufatiifi tolcha; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.1",
            "verseOrgIds": [
              "1TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle hayyootafi worra lafa fidu ch'ufa kad'ad'a aka nu jireenna dansa ka nagayaa ke teennu, Waaqa beekhitiifi adaba dansaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti kunini dansa, ammalle Waaqa Qarqaarsa keenna gammachiifti. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni nama ch'ufa ka baafame d'uga baratu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi Waaqa toko ch'allati jira, ammalle ka Waaqafi nama woltiini d'ufu namicha toko, ka Kristo Yeso jed'ani, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.5",
            "verseOrgIds": [
              "1TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka nafa ufii kenne akasiini nama ch'ufaa baasu. Guyyaani geennaani, dubbi suni ya d'ugeesani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.6",
            "verseOrgIds": [
              "1TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.11"
              },
              "items": [
                {
                  "text": "2 Tim 1.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maro waan kanatifi aka anini ergattufi, barsiiftu gosa d'ibi tahu na ergani, aka d'aamsa d'ugefachaatifi ka d'ugaa odeesu. Anini kiyyibuuti injiru d'uga dubbachuu jira!",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.7",
            "verseOrgIds": [
              "1TI.2.7"
            ]
          }
        }
      ]
    },
