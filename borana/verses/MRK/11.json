    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yerusalemufi gaara Bethfagefi Bethaniati d'iaannaani, fulla gaara Ejersa jed'ani, Yesoni jara ufi keesa nama lama erge ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'eeni, Olla isani dura jiru olduuda, duuba yo olduuddani, bukhura harree, ka hid'aansa qabu, ka taka illenjisiini argitani, hiikha, kootaani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami, Maafi hiitani? jed'e, Aabbooti fed'a, ammalle inni indeebisa jed'aani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.3",
            "verseOrgIds": [
              "MRK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri kae yae, bukhura harre, ka hid'aansa qabu argani, duuba hiikhani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.4",
            "verseOrgIds": [
              "MRK.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami achi ejaanju waan jed'eeni, Bukhura maafi hiitani, maani tolchitani? jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.5",
            "verseOrgIds": [
              "MRK.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri waan Yesoni jed'e, iti himnaani, worra gadi lakise. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.6",
            "verseOrgIds": [
              "MRK.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri bukhura harree kaani Yesotiini d'ufe woya ufi raro tolchani Yesoni yaabate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.7",
            "verseOrgIds": [
              "MRK.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hedduuni woya ufi kara keesa afe, ka gari dame mukha ch'ire, kara keesa afani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.8",
            "verseOrgIds": [
              "MRK.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.25+PSA.118.26"
              },
              "items": [
                {
                  "text": "Far 118.25-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami isa dura jiruufi ka isa duuba yauleeni waan jed'ani, Waaqa faarsa, Nami maqa Aabbootiini d'ufu la eebifame! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.9",
            "verseOrgIds": [
              "MRK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi finna Aabbo keenna Daudi, ka d'ufu jiru eebisinna! Waaqa faarsa!",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.10",
            "verseOrgIds": [
              "MRK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni Yerusalemu seene Mana Waaqa d'aqe. Waan ch'ufa mimillate, maro aduuni d'iiteefi, jara ufi kud'ani lamaani woliini Bethania d'aqe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni mukha odaa abaara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyya, worri Bethaniani baanaani, inni beelae. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.12",
            "verseOrgIds": [
              "MRK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba mukha oda toko, ka baala qabu, fagoti arge, mid'aani ira laalu d'aqe. Achi geennaani, baala male, woma iraa d'abe; wonti akanatiifi hojjaani odaani bilchaatu ingeenne. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.13",
            "verseOrgIds": [
              "MRK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Nami tokoleeni iti deebie mid'aani sira inyaatini! Jari isaa waan kana d'agaye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni Mana Waaqa qulqulleesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerusalemu gahani jennaani Mana Waaqa seene, gumi Mana Waaqa keesati wo gurgurattufi ta bitattu achi had'e, mesa nama hori jijiratufi barch'uma nama sabaliisa gurgurule garagalche, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.15",
            "verseOrgIds": [
              "MRK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nama d'aatu Mana Waaqa kara tolfate miha baate dabruuni yau d'owe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.16",
            "verseOrgIds": [
              "MRK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Isa 56.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba worra barsiise waan jed'eeni, Mani kiyya mana eeba gosa ch'ufa jed'ani t'aafaniiniti? Ammo isani goda hattu tolchitani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaalole gugurdofi jari Seera beekhu akasi d'ageennaani kara isaani ijeesani malatani. Ammo maro gumiini ch'ufti barsiisa isaa maadefatteefi isa sodaatani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti galgaloomnaani, Yesofi jari isaa dira keesaa bahani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jabeenna d'ugefacha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato ganamaani dabranu, oda hiddi gogeeni bahani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petroni waan tahe qaabate waan jed'eeni, Aabbo, ilaali, odaani atini abaarte kaani ya gogoge. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Waaqa d'ugefad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.22",
            "verseOrgIds": [
              "MRK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.20"
              },
              "items": [
                {
                  "text": "Mat 17.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.2"
              },
              "items": [
                {
                  "text": "1 Kor 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "D'uguma, waan anini isaniini jed'u, Nami gaara kanaani, Arma buqai, galaana keesa bui jed'eeni, yo garaa ufi keesati ind'arefanne, ammo aka wonti inni jed'u taatu d'ugefatu, wonti suni inguutamtiifi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.23",
            "verseOrgIds": [
              "MRK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan anini isaniini jed'u, Waan isani Waaqa kad'attani ch'ufa, d'ugefad'a, aka qara d'uguma argattani, duuba inuma argattani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
            "verseOrgIds": [
              "MRK.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.14+MAT.6.15"
              },
              "items": [
                {
                  "text": "Mat 6.14-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle, hojja ejattani Waaqa kad'attani ch'ufa, namaa araarama, yo nami isani dabse jiraate, aka Abbaani keesani ka gubba wollaala keesanile isanii araaramu. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.25",
            "verseOrgIds": [
              "MRK.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo isani namaa araaramu diddani, Abbaani keesani ka gubbaa jiru wollaala keesanile isanii araaramu dida.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
            "verseOrgIds": [
              "MRK.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan jabeenna Yeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.26",
            "verseOrgIds": [
              "MRK.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yerusalemuti deebiani. Ato Yesoni Mana Waaqa keesa deedeemu qaalole gugurdofi jara Seera beekhufi jaaroleeni isati d'ufte ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.27",
            "verseOrgIds": [
              "MRK.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jetteeni, Jabeenna kamiini waan kana tolchita? Yokhaani, eentu jabeenna kana sii kenne, aka waan kana tolchitu? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.28",
            "verseOrgIds": [
              "MRK.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, Anileeni waan toko isani gaafad'a; nati hima, duuba anileeni jabeenna anini waan kana tolchuuni isaniti hima. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.29",
            "verseOrgIds": [
              "MRK.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batisooni Yohana gubbaa baate mo lafaa baate? Nati hima. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.30",
            "verseOrgIds": [
              "MRK.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri wolmorme waan woliini jed'e, Yo gubbaa jenne, inni, Isani maafi isa ind'ugefatiina? jed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.31",
            "verseOrgIds": [
              "MRK.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo Lafaa jenne (gumi sodaatani, waan nami ch'ufti Yohana raaga sehuufi). ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.32",
            "verseOrgIds": [
              "MRK.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan Yesoni jed'ani, Nu imbeennu. Yesoni waan jed'eeni, Yoosi, anileeni jabeenna waan kanaani tolchu isaniti inhimu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.33",
            "verseOrgIds": [
              "MRK.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mammaasa oobru zabibu",
          "type": "text"
        }
      ]
    }
