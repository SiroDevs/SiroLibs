              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'uguma, waan anini isaniini jed'u, Dabaafi araba nami jed'u ch'ufa Waaqi nama inaraarama, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.28",
            "verseOrgIds": [
              "MRK.3.28"
            ]
