          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti Yesoni akana jed'eefi, waan qara biyyiti, Inni jinni qaba jetteefi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.30",
