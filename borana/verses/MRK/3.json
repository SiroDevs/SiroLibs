          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani haad'afi oboleyaani Yeso d'ufani, ala ejaanjani, nama isati ergani yaamani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini isa d'aatu teteetu waan jetteeni, Ilaali, haatetiifi oboleyaani tante ala ejaanjani si barbaadani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Haad'a tiyyaafi oboleyaani tiyya eennu? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyya isa marsite ch'iiftu millate waan jed'e, Kuno, haad'afi oboleyaani tiyya tana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami fed'i Waaqa guutu ch'ufti oboleesafi haad'a tiyya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.35",
            "verseOrgIds": [
              "MRK.3.35"
            ]
          }
        }
      ]
