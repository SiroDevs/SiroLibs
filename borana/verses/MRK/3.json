                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ammo nami Lubbu Qulqullo arabsu araarama inargatu, haga hegeri daba qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.29",
