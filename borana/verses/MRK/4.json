              "items": [
                {
                  "text": "Luk 11.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Isiyii, d'uguma ifse d'ufaniini qori yokhaani sire jala inkayani? Gubbati fannisaniiniti? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.21",
            "verseOrgIds": [
              "MRK.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.26"
              },
              "items": [
                {
                  "text": "Mat 10.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.2"
              },
              "items": [
                {
                  "text": "Luk 12.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti d'ossani ta imullimne injirtu, yokhaani wonti daboolaani ta imbuqimne injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.22",
            "verseOrgIds": [
              "MRK.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gurra qabu ha d'agayu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.23",
            "verseOrgIds": [
              "MRK.4.23"
            ]
          }
        }
      ]
    },
