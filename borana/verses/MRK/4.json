              "items": [
                {
                  "text": "Luk 6.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle inni waan worraani jed'e, Waan d'ageetani mid'aafad'a! Waan isani namaa kennitani isanile kennani, iti isani daranile. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
