  "reference": "Mariko 5",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MRK 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesofi jari isaa moga galaana Gerasene geennaani, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.1",
            "verseOrgIds": [
              "MRK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuma inni hobolo keesaa bueni, nami jinni hamtu qabu toko, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.2",
            "verseOrgIds": [
              "MRK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka awaala keesati galu, ka nami tokoleeni dandae sibiilaleeni inhiinne isaani bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.3",
            "verseOrgIds": [
              "MRK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro heddu harkafi miila isaa sibiilaani hid'ani, ammo sibiila ch'ufa gargari maaqe, ammalle sibiila miilaani hid'ani kute. Nami tokoleeni isa eegu dad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.4",
            "verseOrgIds": [
              "MRK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halkani guyya inni awaalafi gaara gubba dedeeme, iye, d'akhaani ufi d'aane.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeso fagoti arginaani, utaale, durati jige, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.6",
            "verseOrgIds": [
              "MRK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "qonqo olfud'ate, lalabe waan jed'eeni, Atini maani nara qabda, Yeso, Ilma Waaqa ka gubba jiru? Anini si kad'ad'a, maqa Waaqatiini, na ingaargalchiini. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Wonti inni akasi jed'eefi, Yesoni qara jinni sunini, Jinni, namicha kana keesaa bahi jed'e.) ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yesoni waan jed'eeni, Maqaani kanke eennu? Inni waan jed'e, Maqaani kiyya Gumi, nu heddu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni guddo Yeso kad'ate aka lafa suni keesaa inni jinni suni imbaamne.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Booyyeti laaga gaara d'eedu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.11",
            "verseOrgIds": [
              "MRK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jinniini Yeso kad'atte waan jetteeni, Booyye suniti nu ergi, aka nu d'anne ke duunnu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.12",
            "verseOrgIds": [
              "MRK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi Yesoni gadi lakise; jinniini namicha keesaa yaate, booyye ke duudde, duuba booyyeeni ta haga kunki lama orite, galaana duudde, galaani liqimse.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tissituuni baqatte, odu tana diraafi reerati odeesite. Jennaani biyyiti dawachu d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoti d'ufani, namicha jinni gumi qabu kaani, ka achi tau argani, ka woya uyifate, qalbi ufi qabu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.15",
            "verseOrgIds": [
              "MRK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri arge kaani waan namicha jinni Gumi jed'ani qabutiifi waan booyyeeni taate worrati odeese. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri Yeso kad'ate, aka inni lafa worraa keesaa deemu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato inni hobolo keesa seenu jiru, namichi qara jinni qabu kaani Yeso kad'ate, aka isa woliini deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yesoni dide, waan jed'eeni, Beeni, worra ke gali, waan Aabbooni sii tolcheefi aka inni sii nahe worrati himi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni kae gale, lafa Dira Kud'ani ch'ufa keesati waan Yesoni isaa tolche hasae; nami isa d'agaye ch'ufti mame.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fayyisa intala Yairotiifi niiti d'ibi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni galaana gama kaaniti taakinaani, gumiini guddooni ammalle isati baate, ato inni galaana bira jiru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.21",
            "verseOrgIds": [
              "MRK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi toko, ka Yairo jed'ani, guddaani mana Waaqa iti kad'atani, isati d'ufe. Yeso arginaani, inni miila isati jige, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.22",
            "verseOrgIds": [
              "MRK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "guddo kad'ate waan jed'eeni, Intalti tiyya diquma induiini, kooti, harka kanke isi ira kayi, aka isiini fayyitu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yesoni kae isa woliini deeme, gumiini guddooni isa gula d'ufte isa gaargalchite.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiti tokoti jira, ta d'iigi ganna kud'ani lama keesaa yae; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.25",
            "verseOrgIds": [
              "MRK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "isiini guddo harka ch'ireeyiti gaargalte, hori hobaafte, ammo fayyu dad'abde haga qarale ira d'ibamte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.26",
            "verseOrgIds": [
              "MRK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Odu Yeso d'ageennaani, gumi keesaa isa duuba d'ufte, woya isaa qabatte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.27",
            "verseOrgIds": [
              "MRK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan ufiini jette, Yo anini woya isaa qabad'ele, anini imfaya jette. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni d'iigi yaasuma lakise, aka fayyite nafa keesati ufi beete. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.29",
            "verseOrgIds": [
              "MRK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro tokotu Yesoni aka humniti isa keesaa baate arginaani, gumi keesa garagale, Eentu woya tiyya qabate? jed'e gaafate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari isaa waan jed'eeni, Gumi si d'iibdu, ato argitu, Eentu na qabate jetta? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni worra millate aka nama isa qabate argu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.32",
            "verseOrgIds": [
              "MRK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini taani waan taate beete, sodaatte, holatte, d'ufte, isa durati jidde, diideesite waan ch'ufa iti himte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.33",
            "verseOrgIds": [
              "MRK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan isiini jed'e, Intala, d'ugefachaani tante la si fayyifte, nagayaani deemi, d'ukuba kanke fayyi jed'eeni.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Yesoni dubbachu jiru, nami gari ka mana nama gudda suniti d'ufe waan jed'eeni, Intalti tante la doote; maafi moticha ammalle gaargalchita? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yesoni dubbi worraa ch'aqasu dide, waan gudda mana Waaqatiini jed'e, Insodaatini, ammo d'ugefachuma d'ugefad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.36",
            "verseOrgIds": [
              "MRK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni nama ch'ufa ufi jala rare, Petrofi Yakobofi Yohana oboleesa Yakobo male. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra nama gudda mana Waaqa iti kad'atani geennaani, Yesoni biyya lalalaani ch'aarte boote iyitu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.38",
            "verseOrgIds": [
              "MRK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana seennaani inni waan worraani jed'e, Isani maafi bootani? Intalti indoone, ammo ufumaa rafti. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri isa koble, ammo inni worra ch'ufa alati arie, jennaani abba intalatiifi haad'a isitiifi jara isa woliini jiru woliini fulla isiini ch'iiftu seene. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.40",
            "verseOrgIds": [
              "MRK.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harka isii qabe, waan jed'eeni, Talitha, kumi, akasi jechaani, Intala, anini kai siini jed'a jecha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni intalti kaate deemte. Ganni isii kud'ani lama. Worri duuba aka taka inargiini maadefate. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yesoni nami tokoleeni waan kana ind'againi jed'e worrati seere.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.43",
            "verseOrgIds": [
              "MRK.5.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeso tuffatani didani Nazareti keesa",
          "type": "text"
        }
      ]
    }
  ],
