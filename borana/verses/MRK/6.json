          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galaana taakinaani, lafa Genesaretiti d'ufani, hobolo lafa goddu afaani galaanati hid'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.53",
            "verseOrgIds": [
              "MRK.6.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MRK 6:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hobolo keesaa buunaani, biyyiti maro tokotu Yeso hubatte. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.54",
            "verseOrgIds": [
              "MRK.6.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MRK 6:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa suni ch'ufa keesa oriani nama fayya inqamne itille ira kayani fulla isa iti d'agayani ch'ufati iti geesani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.55",
            "verseOrgIds": [
              "MRK.6.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MRK 6:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla inni seene ch'ufa, ollafi diraafi lafa oobru taanaanile, nama fayya inqamne geesani fulla gabaya kayani, aka handaara woya isaa tuqani isa kad'atani; duuba nami isa tuqe ch'ufti imfaye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.56",
            "verseOrgIds": [
              "MRK.6.56"
            ]
