  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "MRK 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Yesoni Mana Waaqa keesaa bahu, jara isaa keesa nami toko waan jed'eeni, Aabbo, D'akhaye dadansa manaani jaarani tana dawad'u! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.1",
            "verseOrgIds": [
              "MRK.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan isaani jed'e, Maneeni gugurdo tana agarta? D'akhaani tokoleeni woli irati inhafu; ch'ufa gargari jissani.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.2",
            "verseOrgIds": [
              "MRK.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni gaargala d'ufu hima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.2",
            "verseOrgIds": [
              "MRK.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato inni gaara Ejersa jed'ani gubba tau, ka Mana Waaqa moga suni jiru, Petrofi Yohanafi Yakobofi Andareani kobati isa gaafatani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.3",
            "verseOrgIds": [
              "MRK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa wonti kunini taatu nuti himi; ammalle, akheekha kamiti d'ufa, yo wonti kunini d'iaatte? jed'aniini.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.4",
            "verseOrgIds": [
              "MRK.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.4",
            "verseOrgIds": [
              "MRK.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Eegad'a, aka nami tokoleeni isani insoomne. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.5",
            "verseOrgIds": [
              "MRK.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hedduuni maqa kiyyaani d'ufe, Anini Kristo jed'e nama heddu soba. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.6",
            "verseOrgIds": [
              "MRK.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo isani waan lola yokhaani gurra lola d'ageetani iriifatiina. Wonti kuni qara d'ufu malte, ammo guyyaani muumme qara ingeenne. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.7",
            "verseOrgIds": [
              "MRK.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gochi kaate gosaani wolhaati, lafti lafaani wolhaati; lafti fulla hedduuni chochoti, beeltileeni ind'ufti, wonti kuni gaargala qaraati.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.8",
            "verseOrgIds": [
              "MRK.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.8",
            "verseOrgIds": [
              "MRK.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 13:9"
          },
          "items": [
            {
