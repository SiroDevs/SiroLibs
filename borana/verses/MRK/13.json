              },
              "items": [
                {
                  "text": "Mul 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Ilma Nama ka dumansa keesa jabeennaafi guddinnaani d'ufu argani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni malaika erge nama inni fohate gama ch'ufa wolti guura, haga muumme lafatiifi ta gubba ch'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
    },
    {
