          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "haga qara ira Daudi sodaate, haga jiru ch'ufa nyaapa iti tahe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
