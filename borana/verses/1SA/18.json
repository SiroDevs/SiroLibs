              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauloni aka AABBO Waaqi Daudi woliini jiru arge, ammalle aka intalti isaa Mikalini isa jaalatule arginaani, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
