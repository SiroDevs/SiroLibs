            "style": "v",
            "sid": "1SA 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.25",
            "verseOrgIds": [
              "1SA.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.52"
              },
              "items": [
                {
                  "text": "Luk 2.52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Much'aani Samueli jed'ani kaani guddachuma guddate eeba namafi AABBO Waaqale iraa kutate.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan worra Eli ka fagani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.26",
            "verseOrgIds": [
              "1SA.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raagi toko Eliti d'ufe waan jed'eeni, AABBO Waaqi waan siini jed'u: Gaafa ababooni kanke Harunifi worri isaa lafa Misiri keesati tisse Farao tahani anini worrati imulane? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.27",
            "verseOrgIds": [
              "1SA.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1+EXO.28.2+EXO.28.3+EXO.28.4"
              },
              "items": [
                {
                  "text": "Bah 28.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.35+LEV.7.36"
              },
              "items": [
                {
                  "text": "Law 7.35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini gosa Israeli ch'ufa keesa worra isaa fohad'e, aka fulla sorio iti naa qalani keesa worri hojate, hit'aana aarse na durati woya qaallu qomati keeyate qaalole naa tahe naa hojatu. Ammalle anini sorio gubani naa baasani keesa jifu worraa kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.28",
            "verseOrgIds": [
              "1SA.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini maanifi soriofi waan na baasani ch'ufa ka anini worra kiyya iraa fed'u, d'araatafi? Ammalle atini maanifi ilmaani tante nara ulfeesite fooni dandansa sorio ka gochiti tiyya ta Israeli na baaftu iti lakifte, akanaani ilmaani tante ufi gagabbifte? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.29",
            "verseOrgIds": [
              "1SA.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi anini, AABBO Waaqi Israeli, waan jed'u: Anini duri aka worraafi gochiti tante haga jiru jireenna qaallu naa tatu kakhad'e. Ammo anini amma aka suni ya dide! Anini amma nama na guddisu guddise ammo nama ch'eera naa d'abu tufad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.30",
            "verseOrgIds": [
              "1SA.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba guyyaani ind'ufa, ka anini kaima worra keesanitifi gosa teesani fit'u, aka nami worra keesani tokoleeni guddate injaare. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.31",
            "verseOrgIds": [
              "1SA.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini gaargalte eeba anini worra Israeli kaanii kennu d'araatafi; ammo worra kanke keesa nami tokoleeni deebie guddate injaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.32",
            "verseOrgIds": [
              "1SA.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo akasile taate, anini isani keesa nama toko hambisa, ka qaallu naa tahu. Ammo inni ilad'abe ufi jibbaata, ammalle d'alooti keesani ch'ufti woraanani hobaa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.33",
            "verseOrgIds": [
              "1SA.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.11"
              },
              "items": [
                {
                  "text": "1 Sam 4.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafa ilmaani tante Hofnifi Finehasini lachu guyya taka hobaatu, guyyaani sunini akheekha isanii taha, aka wonti anini jed'u ch'ufti d'ugaa tatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.34",
            "verseOrgIds": [
              "1SA.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nama d'uga ka waan anini jed'u ch'ufa guutu qaallu fohad'e, ilmaanile ta hojja ch'ufa hayyu anini fohad'e durati na hojatu kennaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.35",
            "verseOrgIds": [
              "1SA.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami worra keesani ka hafu qaallu suni d'aqe beesefi sagale kad'ate waan jed'uuni, Huji qaallu ta tateefu naa kenni, aka anini waan nyaad'e d'uga argad'e garaachaa bulu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.2.36",
            "verseOrgIds": [
              "1SA.2.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi Samueliti mullate",
          "type": "text"
        }
      ]
    }
  ],
