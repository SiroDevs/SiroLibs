              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2 Od-dur 4.2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hayyu Ahazini waan aka gaari, ka sibiila diimani mid'aasani, gargari baase, qori gubba jirtu taani iraa fuud'e; ammalle inni haro sibiila diimani mid'aasani koromi sibiila diima kud'ani lamaani taani iraa fuud'e, d'akha gubba kaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle aka hayyu Ashuru gammachiisu Ahazini waan barch'umani hayyu ira eju Mana Waaqaa keesaa baase, balbala Mana Waaqa ta hayyuuni ch'allaani olseenuni ch'ufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
