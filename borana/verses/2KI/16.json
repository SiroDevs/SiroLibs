          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan hayyu Ahazini tolche ch'ufa kitaaba Odu Hayyoota Yuda keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Isa 14.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ahazini due jennaani irreesa hayyoota, ka dira Daudi keesati, awaalani, ilmi isaa Hezekiani fulla isa hayyu tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    },
    {
