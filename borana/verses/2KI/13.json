        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.12"
              },
              "items": [
                {
                  "text": "2 Hay 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Raagi Elisha jed'ani kaani aka hama faaya d'abe, duud'ame; jennaani ato inni inch'ichini Yehoashini isa argu d'ufe, iti bohe waan jed'e, Aabbo kiyya! Atini duri guddo Israeli nyaapa ira d'owarte!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishani waan jed'eeni, Guubefi t'iya fud'adi. Inni fud'ate jennaani Elishani harka ufi harka hayyu ira keeyate. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishani, aka darbattu kurfefad'i jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani dubbi raaga gula hayyichi deresha gara lafa Shamuti aanu bane. Elishani waan jed'eeni, T'iya darbad'u. Akuma hayyichi t'iya darbateeni raagi waan jed'eeni, T'iyiti AABBO Waaqa ta inni Shamuni dabsatu sii, atini worra Shamu haga dabsatuuti Afeki keesati haata.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Elishani waan hayyuuni jed'e, T'iya hafte fuud'i, lafaani woraani. Hayyichi maro sadi lafaani woworaane eege yaala bahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Elishani iti dallane waan jed'eeni, Atini sila maro shani jaa lafaani woraanu malte, duuba ato sila akasi tolchite worra Shamu ch'ufa inhobaafta; ammo amma tana maro sadi ch'alla worra dabsatta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eege Elishani due awaalani. Ganna ch'ufa duuli Moabu lafa Israeli had'u d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa toko ka nama toko awaalu jirani duula worra suni argani jennaani, biyyiti reefa suni awaala Elisha keesa buufte, kaate biraa baqate. Reefi sunini akuma lafe Elisha tuqeeni jiraate, namichi kaani kae oli eje.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Woraana worra Israelitiifi ka Shamu jiddu jiru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni Shamu Hazaelini haga Yehoahazini lafa mohate ch'ufa worra Israeli aka hama dabse, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo AABBO Waaqi worra jaalate naheefi, worra balleesu dide qarqaare, maro inni duri wold'aqisa Abrahamufi Isaaqofi Yakobo woliini tolfateefi. Inni takuma haga arrale worra isaa indeene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
    },
