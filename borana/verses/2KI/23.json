          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoiakimuni faana ababoota isa gula bahe, AABBO Waaqa durati ch'ubbu tolche.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
