                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.35"
              },
              "items": [
                {
                  "text": "32.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayyu Yosiani ammalle fulla waaqa d'ara iti kad'atani ta Tofethi jed'ani, ta bale Hinomu keesa, ch'ach'abse, aka, nami tokoleeni ilma isaa yokhaani intala isaa aka sorio gubani waaqa Moleki jed'ani imbaamne. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle fardoole hayyooti Yuda huji kad'acha aduti jette baafte achi balleese, gaari huji suni baasanile ch'ufa gube. (Wonti kuni Manuma Waaqa d'aatu fulla fullo ta d'aatu mana Nathan-Meleki jaallabi guddaani iti galu, jirti.) ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.5"
              },
              "items": [
                {
                  "text": "2 Hay 21.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.5"
              },
              "items": [
                {
                  "text": "2 Od-dur 33.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Fulla waaqa d'araati sorio irati baasani, ta gubbaa mana Ahazi, ta hayyooti Yuda mid'aasiteefi ammalle fulla waaqa d'araati sorio irati baasani ta Manaseeni ballinna Mana Waaqa gama lachutu jaare ch'ufa, gadi hirkise ch'ach'abse bulleese, bulla haftele bale Kidroni keesati jisse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.7"
              },
              "items": [
                {
                  "text": "1 Hay 11.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayyu Yosiani fulla sorio irati baasani, ta hayyu Solomonini gaara ejersaatini bitaa Yerusalemu ilaboruti jaare aka waaqa d'ara ka Ashtorethifi waaqa Sidonitifi Kemoshi waaqa Moabutifi Milkomu waaqa Amoni iti kad'attani t'ureese balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Yosiani d'akha aka utuba old'ad'aabani kaani ch'ach'abse bulleese, akheekha waaqa Ashtorethi jed'ani kaani ch'ire duuba fulla akheekhi kunini qara jiru kaani lafele namaatiini guute. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.33"
              },
              "items": [
                {
                  "text": "1 Hay 12.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yosiani ammalle fulla waaqa d'ara iti kad'atani, ta hayyu Yeroboamu, ilmi Nabathi, Betheliti jaare akasiini worra Israeli ch'ubbu keesa buuse kaani ch'ach'abse. Yosiani ammalle fulla suni buqise, d'akha jaaranini ch'ach'abse bulleese, tume d'ukeese; ammalle akheekha Asherale fuud'e gube. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Hay 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eege Yosiani ufi d'aatu laale, awaala kubi gubaati arge. Jennaani nama yaame, lafe keesaa guura jed'eeni, lafele suni fulla sorio irati baasani gubbati gube. Akanaani fulla suni yake t'ureese. Duuba inni fulla suni t'ureese, akasiini dubbi raagi duri, gaafa jila, ka hayyu Yeroboamuni fulla suni d'aatu eju jed'e taani guute. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.30+1KI.13.31+1KI.13.32"
              },
              "items": [
                {
                  "text": "1 Hay 13.30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani hayyuuni Irreesa sunini ka eenu jed'e gaafate? Worri Betheli waan jed'eeni Irreesi sunini ka raaga Yudea d'ufe, waan atini fulla sorio irati baasani tana tolchite kana fage. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Yosiani waan jed'e, Akasumati lakisa lafe isaa tokole intuqina. Tanaafi lafe isaatiifi ta raaga Samaria d'ufele tokole awaala keesaa infuud'ini. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dira Israeli ch'ufa keesa hayyu Yosiani fulla sorio iti baasani waaqa dara iti kad'atani ch'ufa, ta hayyooti Israeli jaarte akanaani AABBO Waaqa dallansiifte, ch'ach'abse. Fulla sorio iti baasani tana ch'ufa, akuma Betheliti tolche kaani, tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni qaalole waaqa d'ara taani ch'ufa fulla sorio iti baasani, ta isiini hojattu irati fit'e, duuba lafele nama fulla sorio irati baasani suni ch'ufa gubbati gube; eege Yerusalemuti deebie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yosiani jila Pasaka tolche",
          "type": "text"
        }
      ]
    },
