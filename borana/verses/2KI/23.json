              },
              "items": [
                {
                  "text": "Yer 22.18-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.1+JER.26.2+JER.26.3+JER.26.4+JER.26.5+JER.26.6"
