              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Yosiani jaarole gugurdo Yudatifi ta Yerusalemutifi ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "qaaloleefi raaga, ammalle nama d'ibi dureesafi hiyyeesale ch'ufa wolti yaame, worri ch'ufti woliini gara Mana Waaqa d'aqe, duuba hayyuuni gumi ch'ufa dura eje, lalabe, kitaaba wold'aqisa ka Mana Waaqa keesati argani soomeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni d'aatu utuba hayyu eje, wold'aqisa AABBO Waaqa woliini tolfate, aka Waaqa gula deeme, seerafi aadaafi waan inni fed'u ch'ufa garaafi qalbi isaatini tolchu, aka taka tana dubbi kitaaba wold'aqisa keesati t'aafani guutu. Duuba nami ch'ufti aka wold'aqisa kana jabeese guutu kakhate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
