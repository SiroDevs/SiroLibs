    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Hezekiani waan Isayaani jed'e, Dubbini AABBO Waaqa, atini nati himte tunini, waan dansa. Wonti Hezekiani akasi jed'eefi, inni waan sehe, waan haga inni lafa fidu lafti nagaya taatu seha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Hezekiani tolche ch'ufa, jannoomafi aka inni haro qote jaare, fulla bisaani haro suni keesaa diratini yaani mid'aasele ch'ufa Kitaaba Odu Hayyoota Yuda keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.20",
            "verseOrgIds": [
              "2KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 20:21"
          },
          "items": [
