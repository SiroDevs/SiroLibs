              },
              "items": [
                {
                  "text": "2 Od-dur 36.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Guyyaani ind'ufa, ka waan mana kanke keesa jira ch'ufafi waan ababooti tante olkeetele ch'ufa fuud'ani lafa Babiloni geesani; wonti tokoleeni inhaftu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.17",
            "verseOrgIds": [
              "2KI.20.17"
            ]
          }
        },
        {
