              },
              "items": [
                {
                  "text": "2 Hay 24.14-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2+DAN.1.3+DAN.1.4+DAN.1.5+DAN.1.6+DAN.1.7"
              },
              "items": [
                {
                  "text": "Dan 1.1-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ilmaani atini d'altele haga toko boojiani sasangisiisani mana hayyu Babiloni keesa hojachiisani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.18",
            "verseOrgIds": [
              "2KI.20.18"
