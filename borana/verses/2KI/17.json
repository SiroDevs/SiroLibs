    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna kud'ani lameeso ka Ahazini hayyu Yuda tahe, Hosheani ilmi Eela hayyu Israeli tahe, ganna sagali Samaria keesa lafa mohate. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni AABBO Waaqa durati ch'ubbu tolche, ammo tatule haga hayyoota isa durati Israeli mohate intolchine. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni Ashuru, ka Shalmanesa jed'ani d'ufe isa had'e; jennaani Hosheani isati harka kennate, ganna ch'ufa damoosa baaseefi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo ganna toko Hosheani qonqo gara hayyu Misiri, ka So jed'ani, erge, qarqaarsa kad'ate, damoosa duri gannati Ashuru baasu kaani baasu dide. Shalmanesani waan suni d'agaye jennaani Hoshea qabe, mana hid'aansa keesa buuse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka dira Samaria dabsatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Shalmanesani lafa Israeli d'ufe had'e, dira Samaria marse. Ganna sadeeso ka dira suni marsani, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ammalle haga Hosheani lafa mohate ganna sagali, hayyuuni Ashuru dira Samaria dabsate, worra Israeli boojie, lafa Ashuru geese, ka gari dira Hala geese, ka gari d'aatu galaana Habori, ka lafa Gozani, geese, ka gari dira worra Medi geese achiti qubsise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti dira Samaria akasi taheefi waan worri Israeli AABBO Waaqa isaani, ka worra harka hayyu Misiritiifi lafa Misiri keesa baase durati, ch'ubbu tolcheefi. Worri waaqoota d'ibi kad'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "aada gosa AABBO Waaqi gumi ufi duraa gusse gula yae, aada hayyooti Israeli d'uftenile tolfate. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli waan hamtu AABBO Waaqi infane tolfate, fulla Waaqa d'ara iti kad'atu dira ch'ufa keesati jaarate, dira didiqafi gugurda ch'ufa keesale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Hay 14.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gaareeni gubbafi mukeeni gaadisa gugurdo jalale ch'ufa, d'akhaa old'ad'aabani, akheekha Ashera mid'aafatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle fulla waaqa d'ara iti kad'atani ch'ufati hit'aana aarsani, aada gosa AABBO Waaqi lafa keesaa gusse, gula yaani. Worri waan hamtu tolfate, waan sunini AABBO Waaqa dallansiise, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "seera AABBO Waaqa ka Waaqa harkaani boch'ani inkad'atiina jed'u, ch'abse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi raaga erge, worra Israelitiifi ka Yuda gorse waan jed'e, Kara keesani hama kana iraa deebia, aada tiyya ta seera anini duri ababoota teesani kenne, eegi sunile raagoota tiyyaani isani barsiise, jabeesa guuta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri guutu dide, akuma ababooti worra ta duri mata jabaate AABBO Waaqa d'ugefachu didde taani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri aada isaa gula yau dide, wold'aqisa inni ababoota worra woliini tolfate guutu dide, gorsa isale ch'aqasu dide. Worri waan woma imbaane, ka harkaani boch'ani, kad'ate ufile woma bahu dad'abe. Ammalle worri aada gosa d'aatu worra jirtu gula yae, dubbi AABBO Waaqi worra seere, aada suni gula iyyaaiina jed'eeni ch'abse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Hay 12.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri seera AABBO Waaqa isaani ch'ufa ch'abse, sibiila tume akheekha koromi lama mid'aafate; ammalle akheekha waaqa Ashera jed'ani mid'aafatani, urji kad'atani, waaqa Baali jed'ani hojatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10"
              },
              "items": [
                {
                  "text": "Qab-Ser 18.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri ilmaani ufi, ta d'iirafi dubra waaqa d'araati gube sorio baase falfatuufi nama wo himu wo gaafate, kara ch'ufaani waan hamtu Waaqi infeene tolfatani, duuba akasiini isa dallansiisani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi aka hama worra Israeliti dallane, fuula ufi dura worra gusse, gosa Yuda ch'alla hambise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri Yudaleeni seera AABBO Waaqa isaani inguunne, ammo aada worri Israeli d'ufeeni gula yaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi worra Israeli ch'ufa dide, worra gaargalche, harka nyaapa worraati worra kenne duuba eege akasiini fuula ufi dura worra balleese.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi AABBO Waaqi worra Israelitiifi ka Yuda gargari baase, worri Israeli Yeroboamu ilma Nabathi hayyu tolfate. Yeroboamuni worra kara Waaqa iraa gorse ch'ubbu hamtu keesa buuse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri faana Yeroboamu bahe, ch'ubbu inni tolche ch'ufa tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eege AABBO Waaqi fuula ufi duraa worra balleese akuma inni duri raagoota isatini jed'e. Duuba akanaani worra Israeli boojiani lafa Ashuru geesani haga arrale worri achuma jira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri Ashuru lafa Israeli keesa qubate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni Ashuru worra dira Babilonitifi Kuthatifi Avatifi Hamathifiti Sefarvaimu fuud'e, dira Samaria keesati qubsise, fulla qara worri Israeli ka boojiani jiru. Worri dira suni ch'ufa fud'ate keesa tae. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gaafa qara achi qubatani AABBO Waaqa insodaanne; tanaafi inni nyeench'a worra hobaasu iti erge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani waan hayyu Ashurutini jed'ani, Biyyiti dira Samaria keesa qubatu seera waaqa lafa suni imbeetu, tanaafi waaqi suni nyeench'a worra balleesa iti erge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyuuni Ashuru waan jed'e, Qaalole nu boojine taani nama toko gadi deebisa; inni ha gale, achi tae, seera waaqa lafa suni biyya barsiisuti. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akasiini qaallichi Israeli toko, ka qara Samaria keesaa boojiani, kae, Betheliti deebie, achi tae, aka AABBO Waaqa kad'atani biyya barsiise.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri dira Samaria sunini akuma kaani waan boch'ani waaqa tolfatani maneeni worri Israeli duri jaare keesa kayani, kad'atani. Gochiti ch'ufti, dira keesa teetu keesati, waan harkaani boch'ani waaqa tolfatte kad'atte: ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Babiloni akheekha waaqa Sukoth-Benothi mid'aafate; worri Kutha ka Nergali mid'aafate; worri Hamathi ka Ashima mid'aafate; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "worri Ari ka Nebhazitifi Tartaki mid'aafate; ammalle worri Safarvaimu ijoolle ufi waaqa Adrameleki jed'anifi Anameleki sorio gube baase. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri kunini ch'ufti AABBO Waaqale inuma kad'ata. Ammalle gosa ufi keesa namuma argani fohatani qaalole tolfatani, worri sunini fulla Waaqa d'araa suni iti kad'atani hojate, gumi ch'ufa jed'e sorio baase. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri AABBO Waaqale kad'ate, ammalle waaqa ufile kad'ate, aada lafa worri keesaa bahe gula.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
