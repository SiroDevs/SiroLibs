          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hayyichi nama askarti shantamati mata toko d'ibi jara isaa woliini erge. Inni gaara kore Eliya durati jilbifate kad'ate waan jed'eeni, Ee nama Waaqaa, anaafi jara kiyya nahi, lubbu nu baasi! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.13",
            "verseOrgIds": [
              "2KI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra askarti mata kaani lamaanifi askarti worrale ibidi gubba d'ufe, balleese, ammo atini na nahi, lubbu na baasi!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.14",
            "verseOrgIds": [
              "2KI.1.14"
            ]
          }
        }
      ]
    },
