            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziani akuma AABBO Waaqi Eliyaani jed'e kaani due. Ahaziani ilma inqabu, tanaafi oboleesi isaa Yoramuni fulla isaa hayyu tahe, ganna lameeso ka Yehoramuni, ilmi Yehoshafathi, hayyu Yuda tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        }
      ]
    },
