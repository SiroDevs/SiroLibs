          "type": "text",
          "attrs": {
            "verseId": "2KI.1.17",
            "verseOrgIds": [
              "2KI.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan hayyu Ahaziani tolche ch'ufa kitaaba Odu Hayyoota Israeli keesati t'aafaniti, t'aafani.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.18",
            "verseOrgIds": [
              "2KI.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Eliya gubbati olfuud'ani",
          "type": "text"
        }
      ]
