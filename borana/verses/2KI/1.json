          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi nama askarti shantamati mata toko d'ibi jara isaa woliini erge, worri d'ufe waan Eliyaani jed'e, Ee nama Waaqaa hayyuuni, hurrisi, gabui sini jed'a!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.11",
            "verseOrgIds": [
              "2KI.1.11"
            ]
          }
        }
      ]
