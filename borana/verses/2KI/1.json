        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni namicha askarti shantamati mata toko gara Eliya ka gaara gubba jiruti erge waan jed'eeni, Ee, nama Waaqaa, hayyuuni gabui sini jed'a.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
