          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani waan jed'eeni, Yo anini nama Waaqa taate, ibidi ha gubba gad'ufe siifi jara kankele balleesu! Hojuma suni ibidi gara Waaqati gabue, namichafi jara isale balleese.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.12",
            "verseOrgIds": [
              "2KI.1.12"
            ]
