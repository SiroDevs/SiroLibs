            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi aka worri Israeli gaargala gudda qabu, ka nami worra qarqaaru tokoleeni injirre arge. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo AABBO Waaqi worra suni ch'ufa haga jiru jireenna balleesu infeene, tanaafi harka hayyu Yeroboamutini worra baase.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
