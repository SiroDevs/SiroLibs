          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeroboamuni due jennaani irreesa hayyoota keesati isa awaalani, ilma isaa Zekariani fulla isaa hayyu tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
