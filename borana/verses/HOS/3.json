            "number": "1",
            "style": "v",
            "sid": "HOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini qarsi kud'ani shanitiifi kintaala lama ka garbutiini isi bitad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba waan jed'eeni, Atini tiyya taata, ammo haga guyya heddu ufumaa tau malte; deebite sharmut'oma indeemtu yokhaani namileeni isiti indeemu. Haga kana anileeni si bira ingahu, ufumaa iraa taa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani worri Israelileeni hayyufi jaarsa male yokhaani ka soriofi d'akha woyyu ka old'ad'aabani yokhaani akheekha waaqoota d'ara ta woini garsiisani inqamne, tau male. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo eegi suni guyyaani ind'ufa ka worri Israeli AABBO Waaqa isaanitifi ilma Daudi hayyu isaaniti deebiu. Gaafasi AABBO Waaqa sodaatani waan dansa inni worraa kennu fud'atani.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Himacha AABBO Waaqi Israeli himatu",
          "type": "text"
        }
      ]
    }
  ],
