              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan naani jed'e, Ammalle beeni, niiti daru ta nama d'ibi jaalatu, jaalad'u. Akuma anini worra Israeli, ato worri naraa gore waaqa d'ibi mid'aani zabibu baaseefi kad'atele jaalad'e, atileeni isi akasuma jaalad'i.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.1",
            "verseOrgIds": [
              "HOS.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
