                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.9+MRK.3.10"
              },
              "items": [
                {
                  "text": "Mar 3.9-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.1"
              },
              "items": [
                {
                  "text": "4.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eegi suni, ato Yesoni d'awatu galaana Genesareti eju, gumiini dubbi Waaqa d'agayu feetu isa d'id'iibde. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.1",
            "verseOrgIds": [
              "LUK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hobolo lama galaana birati arge; ammo guurtuuni qurt'umi yayu t'urura d'iqachu d'at'e. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.2",
            "verseOrgIds": [
              "LUK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hobolo toko ta Simoni seene, Diqo lafa ira bisaani keesa hiisi jed'eeni. Inni hobolo keesa tae biyya barsiise.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.3",
            "verseOrgIds": [
              "LUK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbi buufannaani inni waan Simoniini jed'e, Hobolo wod'aka bisaaniti hiisi, t'urura buusi aka qurt'umi qabatani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.4",
            "verseOrgIds": [
              "LUK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.3"
              },
              "items": [
                {
                  "text": "Yoh 21.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Simoniini waan jed'eeni, Aabbo, nu halkani kana ch'ufa guddo hojanne, ammo tokole inarganne, ammo dubbi tantetiifi anini t'urura imbuusa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.5",
            "verseOrgIds": [
              "LUK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.6"
              },
              "items": [
                {
                  "text": "Yoh 21.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akasi tolchinaani qurt'umi heddu qabani, t'ururaani ch'itu gahe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.6",
            "verseOrgIds": [
              "LUK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahela worraa ka hobolo d'ibi keesa jiru harkaani yaamani, Nu qarqaara jed'aniini. Worri d'ufe hobolo lachu qurt'umiini guute hobolooni diquma illit'iini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.7",
            "verseOrgIds": [
              "LUK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petroni waan kana arginaani jilba Yesoti jige waan jed'e, Na biraa deemi, Aabbo, anini nama dabaati. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.8",
            "verseOrgIds": [
              "LUK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaafi nami ch'ufti ka isa woliini jiruleeni guddo mamani, maro qurt'umi heddu qabaniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.9",
            "verseOrgIds": [
              "LUK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasuma Yakobofi Yohanaleeni, ilmaani Zebedayo, waheli Simoni mamani. Yesoni waan Simoniini jed'e, Insodaatini, armaa achi atini nama guurta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.10",
            "verseOrgIds": [
              "LUK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hobolo ufi afaani galaanati hirkisani artumati lakisani kaani Yeso gula yaani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni qomaat'a fayyisa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.11",
            "verseOrgIds": [
              "LUK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni, ato inni dira toko jiru, nami toko, ka qomaat'aani nafa ch'ufa balleesite, Yeso arginaani durati jige kad'ate waan jed'eeni, Aabbo, yo feete, na qulqulleesu indandeeta. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.12",
            "verseOrgIds": [
              "LUK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni harka d'eerefate isa tuqe waan jed'eeni, Imfed'a, qulqullai. Maro tokotu qomaat'aani iraa badde. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.13",
            "verseOrgIds": [
              "LUK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.14.1+LEV.14.2+LEV.14.3+LEV.14.4+LEV.14.5+LEV.14.6+LEV.14.7+LEV.14.8+LEV.14.9+LEV.14.10+LEV.14.11+LEV.14.12+LEV.14.13+LEV.14.14+LEV.14.15+LEV.14.16+LEV.14.17+LEV.14.18+LEV.14.19+LEV.14.20+LEV.14.21+LEV.14.22+LEV.14.23+LEV.14.24+LEV.14.25+LEV.14.26+LEV.14.27+LEV.14.28+LEV.14.29+LEV.14.30+LEV.14.31+LEV.14.32"
              },
              "items": [
                {
                  "text": "Law 14.1-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yesoni waan jed'eeni, nama tokoleti inhimini, ammo d'aqi qaallicha ufi garsiisi, duuba aka aada Seera Musa gula sorio qali akasiini aka qulqullofte nama ch'ufa garsiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.14",
            "verseOrgIds": [
              "LUK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo gurri isaa haga qarale ira lafa ch'ufa gahe; gumiini guddooni aka isa ch'aqaftufi aka d'ukuba fayyitu d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.15",
            "verseOrgIds": [
              "LUK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni guyya gari fulla nami injirre d'aqe Waaqa kad'ate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Fayyisa nama kokotae",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa toko, ato inni nama barsiisu jiru, Farisayoofi jari Seera beekhu ka olla ch'ufa ka Galilayatiifi ka lafa Yahuditiifi dira Yerusalemule d'ufe woliini tataani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.17",
            "verseOrgIds": [
              "LUK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari, toko nama kokotae toko wosaasani baate d'ufeeni olseensisu fed'e, aka Yeso dura kayani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.18",
            "verseOrgIds": [
              "LUK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo maro gumitiifi fulla seenanini d'abani, jennaani mana gubba korani guutu saaqani wosaasa woliini mana iraa gadi buusani jiddu biyya keesati Yesotiini d'ufani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.19",
            "verseOrgIds": [
              "LUK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'ugefacha worra arginaani Yesoni waan jed'eeni, Abbo, ch'ubbu tante la si araaramani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.20",
            "verseOrgIds": [
              "LUK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani jara Seera beekhufi Farisayooni wolgaafatte waan jette, Nami akana Waaqati muratu kunini eennu? Eentu dandae daba nama araarama, Waaqa male? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.21",
            "verseOrgIds": [
              "LUK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yesoni herega worra arginaani waan jed'eeni, Maalifi akana hereddani garaa keesani keesati? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.22",
            "verseOrgIds": [
              "LUK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tami jechuti ira laaftu, Ch'ubbu tante la si araaramani mo, Kai deemi jecha? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.23",
            "verseOrgIds": [
              "LUK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini aka Ilmi Nama lafa tana keesati humna dabaani nama araaramuuni qabu isani garsiisa. Duuba inni namicha kokotae kaaniini waan jed'e, Waan anini siini jed'u, kai, wosaasa tante fud'ad'u, mana keetiti gali. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.24",
            "verseOrgIds": [
              "LUK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni inni olkae, fuula worra durati wosaasa fud'ate kae mana ufiti gale Waaqa guddise. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.25",
            "verseOrgIds": [
              "LUK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ch'ufti maadefate Waaqa guddise guddo sodaate, waan jed'ani, Arra waan mama la argine.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.26",
            "verseOrgIds": [
