                  "text": "Zek 9.2-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaargala kanke dira Korazini! Gaargala kanke dira Bethsaida! Ato sila huji gugurdo isani keesati tolchani suni Tirofi Sidoni keesati tolchani, worri arra kale daba iraa deebie ch'arqi naqate daara ufi indibiini. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.13",
            "verseOrgIds": [
              "LUK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo gaafa qorsuma Waaqi fulla isaanii nahu, dira Tirotiifi ka Sidoniti naha. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.14",
            "verseOrgIds": [
              "LUK.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.13+ISA.14.14+ISA.14.15"
              },
              "items": [
                {
                  "text": "Isa 14.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dira Kapernaumu, ehayi, gubbati ufi olfuud'u feeta? Ammo qile si buusani!",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.15",
            "verseOrgIds": [
              "LUK.10.15"
            ]
          }
        }
      ]
