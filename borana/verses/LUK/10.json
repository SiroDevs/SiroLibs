                "loc": "JHN.13.20"
              },
              "items": [
                {
                  "text": "Yoh 13.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami isani d'agayu nale d'agaya, ka isani didu nale dida; ammalle ka na didu nama na erge dida.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.10.16",
            "verseOrgIds": [
              "LUK.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Deebia jara torbaatama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
