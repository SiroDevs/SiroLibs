          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, D'iirafi nad'eeni lafa tana wolfuuti; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
