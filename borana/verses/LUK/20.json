                  "text": "Bah 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo aka worra due kaasani, Musaleeni, fulla waan gurbi bobeetu t'aafani taaniti ya agarsiise, gaafa inni waan Abbo dubbate, inni Waaqa Abrahamutiifi, ka Isaaqotiifi ka Yakobole jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
