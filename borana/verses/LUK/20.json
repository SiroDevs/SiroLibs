          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba iti deebiani dubbi d'ibi isa gaafachu sodaatani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.40",
            "verseOrgIds": [
              "LUK.20.40"
