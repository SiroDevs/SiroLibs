          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jara Seera beekhu eegad'a, ka woya d'ed'eertuuni yau fed'u, ka fulla gabayati aka nagaya fuud'ani fed'u, ka mana Waaqa iti kad'atani keesati dura tau fed'u, ka barch'uma dansa hojja sagale woliini nyaatani fed'u, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.46",
            "verseOrgIds": [
              "LUK.20.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
