          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni Waaqa nama duetiiniti, ammo ka worra jiruti; wonti akanatiifi nami ch'ufti isaafi jira.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        }
      ]
