          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo d'iirafi nad'eeni, ta taka tana duisa keesa kaasani, haga hegeri teetu, wolinfuutu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
