          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka mana nad'eeni hiyyeeyiti wo nyaatu, ka kiyyibe kad'acha d'ed'eertu kad'atu. Yaka taka inargiini worrati murani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.47",
            "verseOrgIds": [
              "LUK.20.47"
            ]
          }
        }
