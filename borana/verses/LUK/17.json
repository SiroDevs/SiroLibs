          "items": [
            {
              "text": "Uum 18.20—19.25",
              "type": "text"
            }
          ]
        },
        {
          "text": " Akuma bara Lutu taati — nyaatani d'uugani, bitatani gurguratani, oobraatani mana ijaaratani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
