              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan anini isaniini jed'u, Halkani suni nama lamati sire toko ira rafa: toko fuud'ani, kaani lakisani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
