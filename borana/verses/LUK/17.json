          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo guyya Lutuuni Sodoma keesaa bahe, ibidafi dillooni aka ibida bobeetu gubba gadi roobde worra ch'ufa balleesite. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
