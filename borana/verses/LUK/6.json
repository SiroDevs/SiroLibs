              "LUK.6.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.14"
              },
              "items": [
                {
                  "text": "1 Pet 4.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ayyaana keesani hojja nami isani jibbe gusse arabse, maqa keesani aka waan hamtu alati gatu, maro Ilma Namatiifi! ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.22",
            "verseOrgIds": [
              "LUK.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.16"
              },
              "items": [
                {
                  "text": "2 Od-dur 36.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.52"
              },
              "items": [
                {
                  "text": "Huji 7.52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya suni gammada, qilit'ama olch'ech'ea; wonti akanatiifi waan guddo gubbaa argattani. Ababooti worraleeni akasuma duri raagoota tolchite.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.23",
            "verseOrgIds": [
              "LUK.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.25",
            "verseOrgIds": [
              "LUK.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani hojja nami ch'ufti isani saadu; wonti akanatiifi ababooti worraa akasuma raagoota d'ara saade.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.6.26",
            "verseOrgIds": [
              "LUK.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyaapa keesani jaalad'a",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
