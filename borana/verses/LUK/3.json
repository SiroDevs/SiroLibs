          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamekini ka Methusela, Methuselani ka Henoko, Henokoni ka Yaredi, Yaredini ka Mahalaleli, Mahalalelini ka Kennani, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.37",
            "verseOrgIds": [
              "LUK.3.37"
            ]
          }
        },
