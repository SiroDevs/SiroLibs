              },
              "items": [
                {
                  "text": "Luk 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Lubbuuni Qulqullooni ta bifa sabaliisa qabdu isa ira buute, qonqooni gubba d'ufte waan jette, Atini Ilma kiyya, ka anini jaalad'u, guddo na gammachiifta.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.22",
            "verseOrgIds": [
              "LUK.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan ababoota Yeso Kristo",
          "type": "text"
        }
      ]
    },
    {
