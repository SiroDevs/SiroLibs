          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lawini ka Simeoni, Simeonini ka Yuda, Yudani ka Yusufu, Yusufuni ka Yonamu, Yonamuni ka Eliakimu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.30",
            "verseOrgIds": [
              "LUK.3.30"
            ]
          }
        },
        {
          "name": "verse",
