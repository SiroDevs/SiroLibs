          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa Yesoni huji ufi iti keyate ganni isaa sodomafa; nami ilma Yusufu isa sehe, Yusufuni ilma Eli. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.23",
            "verseOrgIds": [
              "LUK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elini ka Mathati, Mathatini ka Lawi, Lawini ka Melki, Melkini ka Yana, Yanani ka Yusufu, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
            "verseOrgIds": [
              "LUK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufuni ka Maatathia, Maatathiani ka Amosi, Amosini ka Nahumu, Nahumuni ka Esli, Eslini ka Nagai, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.25",
            "verseOrgIds": [
              "LUK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagaini ka Maathi, Maathini ka Matathia, Matathiani ka Semei, Semeini ka Yusufu, Yusufuni ka Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.26",
            "verseOrgIds": [
              "LUK.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yudani ka Yoana, Yoanani ka Resa, Resani ka Zerubabeli, Zerubabelini ka Shealtieli, Shealtielini ka Neri, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.27",
            "verseOrgIds": [
              "LUK.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerini ka Melki, Melkini ka Adi, Adiini ka Kosamu, Kosamuni ka Elmadamu, Elmadamuni ka Eri, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.28",
            "verseOrgIds": [
              "LUK.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erini ka Yoshua, Yoshuani ka Eliezeri, Eliezerini ka Yorimu, Yorimuni ka Mathati, Mathatini ka Lawi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.29",
            "verseOrgIds": [
              "LUK.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
