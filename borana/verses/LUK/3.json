          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yudani ka Yakobo, Yakoboni ka Isaaqo, Isaaqoni ka Abrahamu, Abrahamuuni ka Tera, Terani ka Nahori, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.34",
            "verseOrgIds": [
              "LUK.3.34"
            ]
          }
        },
