          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salani ka Kennani, Kennanini ka Arfaksadi, Arfaksadini ka Shemu, Shemuni ka Nuhu, Nuhuni ka Lameki, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.36",
            "verseOrgIds": [
              "LUK.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
