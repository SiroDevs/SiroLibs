          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nashonini ka Aminadabu, Aminadabuni ka Aramu, Aramuni ka Hesroni, Hesronini ka Peresi, Peresini ka Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.33",
            "verseOrgIds": [
              "LUK.3.33"
            ]
          }
        },
