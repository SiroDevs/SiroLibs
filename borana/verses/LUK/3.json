          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliakimuni ka Melea, Mealani ka Mena, Menani ka Matatha, Matathani ka Nathani, Nathanini ka Daudi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.31",
            "verseOrgIds": [
              "LUK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini ka Yese, Yeseni ka Obedi, Obedini ka Boazi, Boazini ka Salmoni, Salmonini ka Nashoni, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.32",
            "verseOrgIds": [
              "LUK.3.32"
            ]
          }
        },
