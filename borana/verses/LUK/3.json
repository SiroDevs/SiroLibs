          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahorini ka Serugi, Serugini ka Ragau, Ragauni ka Pelegi, Pelegini ka Eberi, Eberini ka Sala, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.35",
            "verseOrgIds": [
              "LUK.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
