          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni waan worraani jed'e, Beena, waan geedala suniini jettani, Anini arrafi bori jinni baase nama fayyisa, guyya sadeeso huji tiyya inhobaafad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.32",
            "verseOrgIds": [
              "LUK.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo kara kiyya qabachu male arrafi borifi iftaanile; wonti akanatiifi raagi Yerusalemu male fulla d'ibiti duu himmalle.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.33",
            "verseOrgIds": [
              "LUK.13.33"
            ]
          }
        }
