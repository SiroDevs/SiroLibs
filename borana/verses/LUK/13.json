          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami mirga bitaa d'ufe, oli gadi d'ufe, Finna Waaqa keesati sagale nyaatani. ",
          "type": "text",
