              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni Farisayooni d'ufte waan jetteeni, Arma baqad'u, Herodeni si ijeesu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.31",
            "verseOrgIds": [
              "LUK.13.31"
            ]
          }
        },
        {
          "name": "verse",
