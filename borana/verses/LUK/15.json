            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Duuba jara damoosa guurufi nami dabaleeni ch'ufti Yesoti d'iaate isa ch'aqase.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        }
