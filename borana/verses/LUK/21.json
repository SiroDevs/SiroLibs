                "loc": "REV.6.12+REV.6.13"
              },
              "items": [
                {
                  "text": "Mul 6.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akheekhati mullata adufi jiafi urji keesa. Lafa keesaleti gochiti ch'ufti ufi jibbaatti, maro gohannaafi d'awa galaana sodaataniifi waan tahani wollaalaani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami naasuuni gagaba, yo waan lafati d'ufu heregu; wonti akanatiifi wonti gubba jira ch'ufti kara ufi iraa gorti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Dan 7.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Mul 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafasi Ilmi Nama, ka jabeennaafi guddinnaani dumansa keesa d'ufu argani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja wonti kuni qara taatu, mata olfud'ad'a, olmillad'a, baafami keesani ya d'iaate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.28",
            "verseOrgIds": [
              "LUK.21.28"
            ]
          }
        }
      ]
    },
    {
