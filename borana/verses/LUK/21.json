              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya ch'ufa Yesoni Mana Waaqa keesati nama barsiise, ammalle lafti halkani geennaani inni d'aqe Gaara Ejersa jed'ani gubbaa bule. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
