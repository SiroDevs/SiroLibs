  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "57",
        "style": "c",
        "sid": "ISA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'ugaa indua, ammo nami waan isaa herege yokhaani yaalu injiru. Ammo ato innileeni due, badiini tokoleeni ta isa qabatu injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'ugaafi qajeelumaani deemu nagaya argate, yo duele lubbuuni isaa boqoti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arma fulla qorsumati koota, dabdoole! Isani falfaltufi nama nad'eeni biyya baratufi sharmut'a ira injirtani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani eenu goyeesitani? Isani eenu miitani, teetani akana iti tabatani? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani mukha woyyu jaalati woli d'araatani woli bira raftani. Isani ijoolle teesani goda d'akhaatifi bale keesati sorio baaftani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani d'akha qulqullicha achi fuutani, old'ad'aabdani, waaqa jettani kad'attani. Ammalle daad'i iti d'ibaafattani, mid'aani kennitaniifi. Isani waan anini waan kana ch'ufa iraa gammadu seetani? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle isani gaareeni d'ed'eertu d'at'ani sorio baaftani achiti woliini raftani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani afaani balbala teesani yokhaani d'aatu mikhikila balabala akheekha waaqa keesani ka d'ara old'aabdani. Isani na lakiftani, woya yaafatani, sire teesani gugurdo kortani beese baaftani, nad'eeni woliini bultani, achiti waan d'araatanifi kaani ch'ufa quuftani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani qayya naqattani d'ad'a ibsatani, waaqa keesani ka Moleki jed'ani kad'achu d'at'ani. Isani barbaada waaqoota nama fulla ch'ufaa ergitani, fulla ekheraani teetuleeni baatani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani waaqoota d'ibi barbaaddani, ufi dad'absiiftani, jibbaachu dad'abdani. Ammalle waan irre isani qabdani tana waaqooti teesani ta d'ara suni isanii kennite seetani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Waaqi isani sodaachise lubbu isani naqu kunini kami kana, ka isani d'ara nati dubbatani na deetani? Waan anini guyya heddu afaani qabad'eefi na sodaachu diddani? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
              "ISA.57.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 57:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani waan tau jirtani kana dansaa seetani, ammo anini ch'eera keesani mullisa, waaqooti teesani ta d'ara suni dandeete isani inqarqaartu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.12",
            "verseOrgIds": [
              "ISA.57.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 57:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja isani qarqaarsa kad'attani, waaqooti teesani ta d'ara suni ha isani qarqaartu! Waaqooti suni ufiftu qilleensi diqaani tokoleeni afufe balleesa! Ammo worri na d'ugeefatu lafa tana keesa tae Mana kiyya keesati na kad'ata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Waaqi worra qarqaare fayyisu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 57:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.13",
            "verseOrgIds": [
              "ISA.57.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 57:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Gumiini tiyya ha naa galtu. Gufu ch'ufa duraa gorsa, kara ch'ira, kurfeesa!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 57:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.14",
            "verseOrgIds": [
              "ISA.57.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 57:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini Waaqa gudda, qulqullo, haga jirule tau. Anini gubba fulla qulqullo taa, ammo nama ch'ubbu iraa deebie ufi diqeesule woliini taa, aka akasiini garaa worraa jabeese abdi kennuufi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.15",
            "verseOrgIds": [
              "ISA.57.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 57:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini duri gumi tiyya jireese duuba deebie worra inhimad'u, yokhaani haga jiru jireenna iti indallanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 57:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro ch'ubbufi sabdooma worraatifi anini worrati dallane, tanaafi worra gaargalche yaala bahe. Ammo worri mataa jabaate, kara ufi lakisu dide.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 57:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 57:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan worri tahe ya arge, ammo inuma fayyisa. Anini worra dura deeme qarqaare nama bohule garaa jabeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.18",
            "verseOrgIds": [
              "ISA.57.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 57:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.17"
              },
              "items": [
                {
                  "text": "Efs 2.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini nama fagootifi ka d'iole nagaya isanii kenna jed'e worra fayyisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.19",
            "verseOrgIds": [
              "ISA.57.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 57:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri ch'ubbuu baariini wold'au fakaata, ka d'awani isaa ejachu dide t'uriifi d'oqeeni d'uftu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.20",
            "verseOrgIds": [
              "ISA.57.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 57:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.48.22"
              },
              "items": [
                {
                  "text": "Isa 48.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, ch'ubbichi nagaya inqabu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.21",
            "verseOrgIds": [
              "ISA.57.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ufi agabsiti d'ugaa",
          "type": "text"
        }
      ]
    }
  ],
