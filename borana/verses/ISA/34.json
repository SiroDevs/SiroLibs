                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aduufi jiaafi urjileeni bulloofte awaara taati. Gubbaani aka woraqata wolti dachaasani wolti deebite baddi. Urjileeni akuma obeensa zabibutifi yokhaani ka oda jidde baddi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        }
