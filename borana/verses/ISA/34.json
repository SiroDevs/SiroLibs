              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa ch'ufa koota, asi wolti baha, ch'aqasa. Lafa ch'ufafi nami keesa jiru ch'ufti ha arma d'ufe wo d'agayu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.1",
            "verseOrgIds": [
              "ISA.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi yayu gosa ch'ufafi duula worraleeti dallane baddi iti mure. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.2",
            "verseOrgIds": [
              "ISA.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reefa worraa inawaalani akanumati lakisani artumati ajae shame bada; gaareeni ira d'iigi worraa aka laga yaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.3",
            "verseOrgIds": [
              "ISA.34.3"
            ]
          }
        },
        {
          "name": "verse",
