                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi yayu goraade ufi gubbati kurfeese, isiini d'ufte Edomu woraanti, worra inni baddi iti mure kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goraadeeni isaa d'iigaafi gabbinnaani ka d'iigaafi gabbinna ilmoole hoolaatifi elemiyeefi korbeeyyi ta sorio qalani fakaatuni ch'uubamti. AABBO Waaqi sorio tana dira Bosra keesati qale lafa Edomu keesaleti waan guddo qala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.6",
            "verseOrgIds": [
              "ISA.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti akuma gafarsaatifi jiboota lafa dod'oofte laftileeni d'iigaani badde, biyyeleeni d'ad'ani fiilti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.7",
            "verseOrgIds": [
              "ISA.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini hojja AABBO Waaqi worra Sioni baase nyaapa isaani balleese akasiini haalo baasufi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.8",
            "verseOrgIds": [
              "ISA.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bisaani galaana Edomu garagalani gogogani, biyyeeni isiileeni garagalte dillo taate, lafti ch'ufti aka kosi gubani gubati. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.9",
            "verseOrgIds": [
              "ISA.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.11"
              },
              "items": [
                {
                  "text": "Mul 14.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.3"
              },
              "items": [
                {
                  "text": "19.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isiini halkani guyya ind'aamtu, aarileeni haga jiru jireenna keesaa yaa, bara ch'ufa lafti badde akanumati ona taate, deebie miili namaa keesa inejatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.10",
            "verseOrgIds": [
              "ISA.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urungufi haranqeesa male waan d'ibi keesati inargani. AABBO Waaqi lafa balleese duwa tolche akanumati lakisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.11",
            "verseOrgIds": [
              "ISA.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa keesa hayyu d'abani, jari gugurdaani isa jala hojatuleeni ch'ufti bada. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.12",
            "verseOrgIds": [
              "ISA.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoraatifi goraani maneeni hayyuutifi dira gugurda jabeesani jaarani keesati bahe sare diidatifi urunguni iti galti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.13",
            "verseOrgIds": [
              "ISA.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa alaatifi worabeesi wolti bahe, jinnileeni woli yaamte goorjami halkani achi d'ufe fulla tau barbaada. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.14",
            "verseOrgIds": [
              "ISA.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urunguni achiti mana jaarate okhokaani d'alte, baqasite ilmaani isii guddifti. Allaatileeni achiti d'altufi kormani, wolti baati.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.15",
            "verseOrgIds": [
              "ISA.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kitaaba AABBO Waaqa ka waan bineensa keesati t'aafani barbaada sooma. Bineensa kana tokole keesa ind'abdani, inni ch'ufti d'alaafi korma qaba. Nami bineensa kana wolti baase AABBO Waaqa, isumati wolti yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.16",
            "verseOrgIds": [
              "ISA.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami lafa suni bineensa ch'ufaa gargari qoode kennuufi AABBO Waaqa. Bineensi sunini bara ch'ufa achiti gala lafti sunini haga jiru jireenna ta worraa taati.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.17",
            "verseOrgIds": [
              "ISA.34.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kara qulqullooma",
          "type": "text"
        }
      ]
    }
