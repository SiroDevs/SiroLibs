          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.21",
            "verseOrgIds": [
              "ISA.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hafuuruma, maani keesa jira? Tanaafi maani ira gula yaatani isa d'ugeefatani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.22",
            "verseOrgIds": [
              "ISA.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gaargala Yerusalemu keesa jiru",
          "type": "text"
        }
      ]
