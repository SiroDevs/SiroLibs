            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.1.9"
              },
              "items": [
                {
                  "text": "2 Thes 1.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Biyyiti goda d'akha keesati d'okhate, yokhaani lafa keesati boola qotani aka dallansu AABBO Waaqa dura baqatani, jabeennaafi guddinna isaa duraa bahani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani ind'ufa, ka nama kiyyibu hobaasani nama ufi saadule balleesani. Gaafasi AABBO Waaqa ch'alla guddisani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya suni AABBO Waaqi guddaani nama irre qabu ch'ufa diqeese, nama kiyyibe ufi saadule ch'ufa akasuma tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.12",
            "verseOrgIds": [
              "ISA.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hind'eesa d'ed'eera Lebanonitifi dambi lafa Bashanile balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.13",
            "verseOrgIds": [
              "ISA.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gaareeni d'ed'eertuufi kubileefi ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.14",
            "verseOrgIds": [
              "ISA.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "doofi d'ed'eertuufi, girgida mana jajaba ch'ufa ch'ach'absa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.15",
            "verseOrgIds": [
              "ISA.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni hobolo hobolo ch'ufa ira guddotifi ta iraa mid'aadule ch'ufa bisaani keesa lit'isisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.16",
            "verseOrgIds": [
              "ISA.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiyyiba nama ira kutani saadu nami ufi saadule iraa balleesani. Waan harkaani boch'ani kad'atani qulqullumaa lafaa d'abani, guyya suni AABBO Waaqa ch'alla guddisani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.17+ISA.2.18",
            "verseOrgIds": [
              "ISA.2.17",
              "ISA.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.17+ISA.2.18",
            "verseOrgIds": [
              "ISA.2.17",
              "ISA.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti goda d'akha keesati d'okhati yokhaani lafa keesati boola qotatti, aka dallansu AABBO Waaqaa duraa baqatani, jabeennaafi guddinna AABBO Waaqa duraa bahani, gaafa inni lafa chochoosu d'ufu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.19",
            "verseOrgIds": [
              "ISA.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja guyyaani sunini d'ufu worri waan worqifi qarsi ka harkaani boch'ani kad'atani gate, tuqaafi raaree lakisani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.20",
            "verseOrgIds": [
              "ISA.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja AABBO Waaqi lafa chochoosuu d'ufu, biyyiti boolafi goda d'akhaati d'okhati, aka dallansu isaa duraa baqate, jabeennaafi guddinna isaa duraa baatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.21",
            "verseOrgIds": [
              "ISA.2.21"
            ]
          }
        }
      ]
    },
