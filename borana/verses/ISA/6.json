                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ganna hayyu Uziani due, anini AABBO Waaqa, ka guddinna ufiitini barch'uma gubba tae, woyaani isaa dudda duubaani d'eeratte Mana Waaqa ch'ufa guuttu, arge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isa d'aatu waan lubbu qaba, ka aka ibida bobaati ejaanja, ka wonti suni ch'ufti koola jaa qabdu; koola lamaani fuula d'ofatani lamaani miila d'ofatani lamaani barisani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.8"
              },
              "items": [
                {
                  "text": "Mul 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Woli yaamani waan woliini jed'ani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
