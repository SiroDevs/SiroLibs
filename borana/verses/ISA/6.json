          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani wonti lubbu qaba kaani toko nati barifte, ch'ile ibida waan hit'aana irati aarsani iraa qad'abeeni fuute, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ch'ile sunini hid'i tiyya tut'e waan naani jette ch'ileeni tunini amma ya hid'i sii tut'e, ch'ubbu ya sira fuud'ani, daba yayu sii araaramani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
