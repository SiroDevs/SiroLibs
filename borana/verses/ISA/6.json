                  "text": "Mul 15.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Qonqooni worraa yayaba Mana Waaqaa chochoofte, Mana Waaqale aari guute.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.4",
            "verseOrgIds": [
              "ISA.6.4"
