                "loc": "ACT.28.26+ACT.28.27"
              },
              "items": [
                {
                  "text": "Huji 28.26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani inni waan naani jed'e, Beeni, dubbi tana biyyati himi: ato haga feetani d'ageetanile inhubattani. Ato haga feetani ilaaltanile waan taha inagartani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.9",
            "verseOrgIds": [
              "ISA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni waan nani jed'e, Qalbi biyya tana duuchi, gurra worraa ch'ufi, ila worra bassi, aka worri woma arge yokhaani d'agaye yokhaani inhubanne. Yo sila worri akasi tahe, hegeri worri garagaleti fayya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.10",
            "verseOrgIds": [
              "ISA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini waan jed'eeni, Aabbo wonti kunini haga yoomi taati?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan naani jed'e, Haga dira ch'ufa balleesani ona tolchani, maneeni ch'ufti duwa taate, oobruuni, ch'ufti badde raasa taatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.11",
            "verseOrgIds": [
              "ISA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini gumi suni fageese, lafa ch'ufa duwa tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.12",
            "verseOrgIds": [
              "ISA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato nama kud'ani keesa nami toko hafele, takacha sunile imballeesani; inni hunda mukha dambi ka murani fakaata. Ammalle akuma hunda suni worri Waaqaa ka d'ibiini late ga baha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.13",
            "verseOrgIds": [
              "ISA.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aamsa hayyu Ahaziti ergani",
          "type": "text"
        }
      ]
    }
