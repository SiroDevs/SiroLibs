              "items": [
                {
                  "text": "22.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "D'alooti Yese hunda mukha murani fakaata; ammo akuma dameeni latte hunda suni iraa baatu, akasuma hayyuuni d'aloota isa keesa d'alata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri boojiani galu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
