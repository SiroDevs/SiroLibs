                "loc": "ROM.15.12"
              },
              "items": [
                {
                  "text": "Rum 15.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyyaani ind'ufa, ka nami d'aloota Daudi hayyu tahe, akheekha gosa ch'ufaa tahu. Worri dira isaa keesati wolti bahe isa guddisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi Aabbooni ammalle harka ufii d'eerefate, nama isaa ka lafa Ashurutifi Misiritiifi, Pathrositifi Kushitifi Elamutifi Babilonitifi Hamathitifi lafa d'aatu baariinitifi lafa bisaani baariini jiddu jirtu keesati hafe, galcha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi baandera oliqabe gosa ch'ufa garsiisa, aka inni worra Israelitiifi ka Yuda ka gargari firfirsani boojiani, wolti guure, gama lafa ch'ufaa woltiini d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qot'eeni Efraimu badde, worri Yudaleeni deebie worri Efraimu qot'ise worra Israeliti nyaapa intahu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri wold'aqe, worra Filisti, ka ila aduu jiru, had'e, worra ilaboru tau saame, worra Edomutifi ka Moabu dabsate, worri Amoni harka worra jalati bula. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Mul 16.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi galaana Misiri gosse, galaana Frati bubbe owituuni gosse laga didiqa torba tolcha, aka nami miilaani taaku. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worra isaa, ka worra Ashuru jalaa bahe, achiti hafe, kara balla tolchaafi, akuma duri ababoota worraa, ta lafa Misiri keesaa baate, tolche.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.16",
            "verseOrgIds": [
              "ISA.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Faaru galataani deebisani",
          "type": "text"
        }
      ]
    }
