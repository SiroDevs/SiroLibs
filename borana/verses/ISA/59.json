          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.19",
            "verseOrgIds": [
              "ISA.59.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 59:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.26"
              },
              "items": [
                {
                  "text": "Rum 11.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan gumi isatini jed'u, Anini Yerusalemu d'ufe, isanii kalche, nama keesani ka daba ira deebie ch'ufa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 59:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini wold'aqisa isani woliini tolfad'a; anini yayu irre tiyya isanii kenne, dubbi tiyya isani barsiise; armaa achi isani naa saalfatani, ijoolle teesaniifi d'aloota worrale barsiiftani aka haga jiru jireenna worri naa saalfatu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.21",
            "verseOrgIds": [
              "ISA.59.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yerusalemuni takaa tana guddinna argatu",
          "type": "text"
        }
      ]
    }
  ],
