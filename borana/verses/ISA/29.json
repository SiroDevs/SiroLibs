              "ISA.29.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.8+MAT.15.9"
              },
              "items": [
                {
                  "text": "Mat 15.8-9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.6+MRK.7.7"
              },
              "items": [
                {
                  "text": "Mar 7.6-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aabbo Waaqi waan jed'u, worri kunini afaanini na sosobe si kad'anna nani jed'a, ammo garaani isaani gara kiyya injiru. Aadaani worraa woma nami ufiini ga baase tolfatu, ka namu mataani barate. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.13",
            "verseOrgIds": [
              "ISA.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.19"
              },
              "items": [
                {
                  "text": "1 Kor 1.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tanaafi anini gumi tana waan mama iti buuse worra mamsiisa. Qaroomi qaroo bade, qalbiini nama wo beekhu lafaa d'abani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abdi takaa tana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
              "ISA.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri haga dandau mala ufi AABBO Waaqa d'ofatu ya bade! Worri d'ossani wo tolche waan jed'u, Eenuti na arga. yokhaani eenuti quba quba? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.15",
            "verseOrgIds": [
              "ISA.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.9"
              },
              "items": [
                {
                  "text": "Isa 45.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri waan ch'ufa garagalcha. Okotee faaratifi nama isi mid'aasu eenuti ira jaba? Wonti nami mid'aase dandeete nama isi mid'aase sunini, Atini na mid'aasini injetti? Yokhaani dandeete, Atini waan taatu imbeetu injetti? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'iotu baddaani Lebanoni lafa oobru taate, lafti oobruleeni deebite badda intaatu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafasi duudaleeni dubbi kitaaba ta soomani d'agaye, ballaleeni ka duri lafti iti dukanooftu amma ila banate wo arga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiyyeesafi nami guddinna inqamneleeni deebie gammade waan AABBO Waaqi qulqullooni Israeli namaa kennu argata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nama dabsufi ka Waaqa tufatu bade nama ch'ubbu qabu ch'ufti hobaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle Waaqi nama gurra nama yakufi ka nama wo yakele dubbi keesa ira ch'iisufi, ka d'ara dubbate nama sila d'uga qabu d'uga d'owu imballeesa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi ammatana AABBO Waaqi Israeli, ka Abrahamu duri gaargala keesaa baase, waan jed'u, Gumi tiyya ta Yakobo deebiani inch'eersani, fuuli worraa deebie ch'eeraani inhamaatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri ilmaani anini worraa kennu argu, worri hojja suni aka anini Waaqa qulqullo Israeli beekhe, na guddise na sodaata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daalleeni wo barate, nami guyya ch'ufa gungumu waan isa barsiisani ee jed'e fud'ata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.24",
            "verseOrgIds": [
              "ISA.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wold'ageeti woma keesa injirre",
          "type": "text"
        }
      ]
    }
  ],
