                }
              ]
            }
          ]
        },
        {
          "text": " Gumiini Babiloni, ta Waaqi fohate, nagaya isanii d'aamti, ilmi kiyya Marikoleeni nagaya d'aamata. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'ungo jaalala Kristianatiini nagaya wolfuud'a. Nageenni isani worra Kristo ch'ufa woliini tahinna.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
