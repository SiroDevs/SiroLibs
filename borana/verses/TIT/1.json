            "number": "1",
            "style": "v",
            "sid": "TIT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqaani kiyya Paulo, anini hojattu Waaqatiifi ergattu Yeso Kristo. La na fohatani aka anini d'aqe, d'ugefacha worra Waaqi fohate qarqaare, d'uga aadaani teenna, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.1",
            "verseOrgIds": [
              "TIT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta jireenna hegeri abdattu barsiiftu worra barsiisu. Waaqi, ka d'ara indubbanne, ya jireenna kana duru nuu kakhate, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
              "TIT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hojjaani geennaani dubbi ufi keesati nuti mullise. Waan kana harka kiyyati kennani, d'aamsa Waaqa, ka Qarqaarsa keenna, gula odeesa.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        }
      ]
    },
    {
