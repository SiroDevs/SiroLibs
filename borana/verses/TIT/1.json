                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.10"
              },
              "items": [
                {
                  "text": "2 Tim 4.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini tatabe tana Titoti t'aafa; inni ilma kiyya ka d'uga, d'ugefacha nu woliini qamnu tana keesa: Waaqa Abbaafi Yeso Kristoni, Qarqaarsi keenna, eebafi nagaya isanii kenniina.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Huji Tito lafa Krete keesa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini aka atini waan tolchu malani guutuufi lafa Krete keesati si lakise, ammalle aka atini dira ch'ufa keesati jaarole gumi fohattu. Gorsa kiyya qaabad'u: ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.3.2+1TI.3.3+1TI.3.4+1TI.3.5+1TI.3.6+1TI.3.7"
              },
              "items": [
                {
                  "text": "1 Tim 3.2-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " jaarsi wollaala qabaachu himmalle; niiti toko ch'alla qabaachu male, ilmaani isaa d'ugefacha qabaachu malte, ijoolle hamamtu ta aka bineensa jirtu, ta dubbi nama inch'aqamne intahiini. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro inni huji Waaqa harka qabuufi inni wollaala qabaachu himmalle. Kiyyibe miira indiqaatiini, farso d'uge namaani woldide insabdaiini. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nama bulche waan dansa jaalatu. Ha ufi qorqorate qajeele, qulqullo tahe, adaba dansaani deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbi d'uga ha aka dansa jabeesu, ta d'ugefataniifi ta waan barsiisatini woli fakaattu. Kara kanaani inni dandae nama d'ibi barsiisa d'ugatiini qarqaare, wollaala nama didule agarsiisa.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi nama hedduti jira, ka dubbi ch'aqasu dide dubbi d'aratiini nama sobu, keesuma worri aada Yahudi iti galefaani. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sila worra dubbachu d'owu malani; wonti akanatiifi waan barsiisu himmalini barsiisani, akanaani ollowaani heddu balleesu jirani, aka hori argatani. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi Krete toko, ka raaga worraa waan jed'e: Jari Krete ch'ufti kiyyiba, bineensa hama, ammalle sabdi woma hojachu imfeene. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti inni jed'e sunini d'uga. Maro waan kanatifi aka dansa worra gorsu malte, aka worri d'ugefacha qit'e horate ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "odu Yahuditiifi seera nama d'ugaa dide iraa d'ufu lakisu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama qulqulloti wonti ch'ufti qulqullo; ammo worra t'uri, ka ind'ugefanne, wonti tokoleeni iti qulqulloniti, maro qalbifi heregi worraa t'uri qabuufi. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "TIT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa beenna ufiini jed'ani, ammo hujiini worraa ind'areesiti. Worri nama jibbani, namale inch'aqasu, waan dansa tokole dandae intolchu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jireennafi barsiisa Kristo",
          "type": "text"
        }
      ]
    }
  ],
