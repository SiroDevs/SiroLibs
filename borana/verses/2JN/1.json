            "number": "3",
            "style": "v",
            "sid": "2JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.3",
            "verseOrgIds": [
              "2JN.1.3"
            ]
          }
