          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.12",
            "verseOrgIds": [
              "MIC.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Worra Sioni kaa, nyaapa keesani aka mid'aani d'aanani d'aana! Anini aka korma looni ka gaafa sibiila guraachatiifi qeench'a sibiila diima qabu isani tolcha. Isani gosa heddu d'aantani ch'ach'arasitani, ammalle hori worri kara dabatini argate iraa fuutani ana, abba lafa ch'ufaati baaftani.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.13",
            "verseOrgIds": [
              "MIC.4.13"
            ]
          }
        }
      ]
    }
