            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani worri Yerusalemu, duula keesani wolti baasa! Ya marsani nu had'ani! Hayyu Israelile ya d'abanaasani!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Waaqi nama gosa Yuda fidu fohatu",
          "type": "text"
        }
      ]
    },
