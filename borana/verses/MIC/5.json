              "items": [
                {
                  "text": "Yoh 7.42",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " AABBO Waaqi waan jed'u, Bethlehemu Efrata, atini dira gosa Yuda ch'ufa keesa dira diqa, ammo si keesaa anini nama Israeli fidu, ka d'alooti isaa uumama duri iraa bahe, tolcha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi AABBO Waaqi gumi ufii harka nyaapa worraati lakisa, haga isiini dau geete ilma deetuuti. Jennaani worra gosa isaa ka boojiani worra isaani ka Israeliti deebisani. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gaafa d'ufu jabeenna AABBO Waaqatifi guddinna isaatiini gumi ufii tissa. Gumiini isaaleeni nagayaani teeti, waan nami lafa keesa jiru ch'ufti guddinna isaa beekhuufi; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle inni nagaya lafatini d'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baafamafi gaargala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri gosa Ashuru lafa teenna d'ufe had'e naabo teenna ch'ach'abse nuu dabsatu, nu jara nuu mataa jajanna had'iisaa worrati ergina. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.8+GEN.10.9+GEN.10.10+GEN.10.11"
              },
              "items": [
                {
                  "text": "Uum 10.8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Irre woraanatiini worri worra Ashuru suni dabsate, worri suni gaafa worri kaani d'ufe lafa teenna had'u duraa nu baasa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli ka hafe fit'eesa AABBO Waaqi gosa hedduti ergu yokhaani ebele mid'aaniti roobdu fakaata. Ammalle worri suni Waaqa male nama inheregatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri gosa taani keesati hafe nyeench'a sagale raasa keesa yokhaani fulla reeni ooltu keesa barbaadu fakaata: inni ree keesa seene iti ch'ee qabe nyaate fit'a — nami tokoleeni ka dandae iraa baasu injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri Israeli nyaapa ufii ch'ufa dabsate had'e balleesa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Gaafasi anini fardoole teesani isani iraa fuud'e gaari keesani ka fardi hirkisu balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
              "MIC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini dira keesani balleese waan isani nyaapani ufiraa d'owartani jaartani ch'ufa ch'ach'absa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.11",
            "verseOrgIds": [
              "MIC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini qud'aama keesani ka falfalaa isani iraa fuud'e worra keesani ka wo himule balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.12",
            "verseOrgIds": [
              "MIC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini akheekha isani kad'attanifi d'akha keesani ka woyyumale lafa teesani keesaa balleesa; isani deebitani gajettani waan harka keesaniini mid'aasitani inkad'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.13",
            "verseOrgIds": [
              "MIC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini akheekha waaqa Ashera jed'ani, ka lafa teesani keesa jiru, ch'ach'abse dira keesani balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.14",
            "verseOrgIds": [
              "MIC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle dallansu tiyya guddo keesa gosa na ch'aqasu dide ch'ufa haalo fuud'a.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.15",
            "verseOrgIds": [
              "MIC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi Israeli himate",
          "type": "text"
        }
      ]
    }
  ],
