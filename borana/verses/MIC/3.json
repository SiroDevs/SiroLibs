            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tanaafi maro teesanifi diri Sioni bade adaala taha. Yerusalemuleeni onte badde, gaari fulla Mana Waaqaa iti jaaranileeni badda taha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.3.12",
            "verseOrgIds": [
              "MIC.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqi lafa ch'ufa nagayaani fidu",
          "type": "text"
        }
      ]
    }
