          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini Mahanaimuni bahe jennaani, Shobi, ilmi Nahasi, ka dira Raba, ka lafa Amoni keesatifi Makiri ilma Amieli ka dira Lodebaritifi ammalle Barilai ka Rogolemu lafa Gileadi keesaa d'ufeeni wolwoldaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri kunini qori okote faarati miha hiribati ammalle sagale Dauditifi ta worri isaa nyaatu: dargaye, garbu, boshe, akhaawi, halquqa, d'engo, damma, qarru, baadu, ammalle hooliye qalma, d'ufaniini waan jed'ani, Daudifi jari isaa yayu beelae d'eebote dad'abe, lafa aloo tana keesati.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.28+2SA.17.29",
            "verseOrgIds": [
              "2SA.17.28",
              "2SA.17.29"
            ]
          }
        }
      ]
    },
