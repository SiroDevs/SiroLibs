      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni Nahashonini hayyuuni Amoni due jennaani ilmi isaa Hanunini fulla isaa hayyu tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba hayyu Daudini waan jed'e, Anini Hanunini akuma abbaani isaa duri naa nahe na qarqaare anileeni akasuma isa qarqaara. Duuba Daudini nama erge, iraa hafi Hanuniniini jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri sunini Amonini bahe, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "jennaani jaaroleeni Amoni waan hayyuuni jette, Atini waan d'uguma Daudini ulfinna abba kanketitifi lubbu isaa iraa hafi jed'a jara kana siti erge seta? Akasiniti, insobamini! Inni aka dooyate hegeri dira kana balleesuufi worra kana gadi erge!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Hanunini worra Daudini erge suni qaqabe, areeda worraa gama toko iraa haade, woya worraa hid'aanati iraa ch'ire worraa, ufira galche. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini qonqo suni d'ageennaani nama fuula keesa worra erge maro worri ch'eeraa galu dad'abeefi inni iti d'aame waan jed'eeni Yerikoti hafa, haga areedi isaani bahuti achi taa, duuba eegi suni koota.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gosa Amoni aka Daudi nyaapa ufifi tolchani hubate, jennaani askarti Shamu ta kuma diddama ta Bethiresbufi Soba d'ufteefi askarti kuma kud'ani lama ta Tobu d'ufte ammalle hayyu Maaka nama kuma toko woliini hori baaseefi goli ufi tolfate. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini dubbi suni d'ageennaani Yoabufi askarti Israeli ch'ufa woliini, had'a jed'e worra fuula keesa erge. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Amoni diraa gabahe fullo dira Raba durati wolti bahe had'iisa kurfefate, ka worri Seriatifi Tobatifi Maaka ballinna lafa keesati gama ufitini had'iisa kurfefate.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabuni aka nyaapi durafi duubaani isaa marse arge jennaani askarti Israeli nama jajaba file, duula worra Shamu kaani duraani d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni askarti isaa ta hafte taani oboleesa isaa Abishai gudda iti tolche, duuba Abishaini askarti suni duula worra Shamu kaani duraani d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoabuni waan Abishaini jed'e, Yo worri Shamu na dabsata garte, kooti naa kalchi, ammo yo worri Amoni si dabsate aninileeni d'ufe sii kalcha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaa jabaad'i nama keennafi dira Waaqi keenna nuu kenne nyaapa hanne iraa d'owarra. Fed'iini AABBO Waaqa ha taatuti!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoabufi jari isaa had'iisa oriani, worri Shamu duraa baqate. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Amoni worra Shamu ka baqatu agarraani worrileeni Abishai duraa baqate dira duude. Jennaani Yoabuni had'iisa Amoni iraa deebinaani Yerusalemuti gale.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Shamu aka Israeliini worra dabsate agarraani askarti isaani ch'ufa wolti baase. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadezerini askarti Shamu ta galaana Efraititini ila boru jirtu ta Shobakini nami gudda askarti isaa ch'ufa iti mata, gayaame worri Helamuti isati d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini waan kana d'ageennaani, askarti Israeli ch'ufa wolti baase, galaana Yordani taake, had'iisaa Helemu d'ufe, fulla askartini Shamu ch'ibra teetu. Jennaani worri lachu had'iisaa hirba wolti kaachise. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli worra dabsate baase, Daudifi worri Israeli askarti Shamu nama d'ibba torba, ka gaari fardi hirkisuni yaatufi askarti farda nama kuma afurtama hobaasani, ammalle shobaki nama gudda askarti Shamule woraanani, artumati ijeesani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyooti Hadadezeri jalati bultu taani, aka Israeliini worra dabsate agarraani booju kad'atte finna worraa jalati bulte. Duuba Akanaani worri Shamu worra Israeli sodaate worra Amoniti eegi suni kalchu dide.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudifi Bathsheba",
          "type": "text"
        }
      ]
    }
  ],
