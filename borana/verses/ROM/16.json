                  "text": "Huji 16.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Timotheoni, ka na woliini hojatu, nagaya isanii d'aama; Lukiofi Yasonifi Sosipatro, gosa tiyya, nagaya d'aamani.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini Tertioni, nami tatabe tana t'aafe, nagaya isani d'aama.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
