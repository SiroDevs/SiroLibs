              "items": [
                {
                  "text": "53.1-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma t'aafiini jettu:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.10",
            "verseOrgIds": [
              "ROM.3.10"
            ]
          }
        }
      ]
