            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oboleyaani isaatifi worri isaa ch'ufti reefa isaa fuud'u d'ufe. Duuba reefa isaa suni fuud'ani, jiddu Zoratifi ta Eshtaoli awaala abba isaa Manoa keesati awaalani. Inni ganna diddama jaallaba Israeliti tahe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan harkaani boch'ani ka Mikaani kad'ate",
          "type": "text"
        }
      ]
