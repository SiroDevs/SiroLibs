        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5+MAT.27.6+MAT.27.7+MAT.27.8"
              },
              "items": [
                {
                  "text": "Mat 27.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Yudani hori inni dabaani argate kaaniini eegi oobru bitate, lafati jige, garaani tarsae, marumaani ch'ufti keesaa buani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Yerusalemu jiru ch'ufti waan kana d'agaye, afaani worratiini oobru suni maqa Akeldama iti baasani, akasi jechaani oobru d'iiga jecha.) ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        },
        {
