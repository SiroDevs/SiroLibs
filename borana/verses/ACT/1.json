        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni gubbati oldeebia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
