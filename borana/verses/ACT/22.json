              "type": "text"
            }
          ]
        },
        {
          "text": "Guddaani askarti d'ufe waan Pauloni jed'e, Ila, atini gosa Rumiti? Pauloni, Ee jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        },
        {
