              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guddaani askarti waan jed'eeni, Anini hori gudda baase nama Rumi tahe. Pauloni waan jed'eeni, Ammo anini lafa suniti d'alad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
