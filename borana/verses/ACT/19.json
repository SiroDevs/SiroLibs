      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Apoloni Korintho ke jiru, Pauloni arda suni ch'ufa keesa deeme Efesoni bahe. Jara Yeso ka gari arginaani ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.1",
            "verseOrgIds": [
              "ACT.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "inni waan worraani jed'e, Isani gaafa d'ugefattani Lubbu Qulqullo argattani? Worri waan jed'eeni, Hiyyo, aka Lubbuuni Qulqullooni jirtule imbeennu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.2",
            "verseOrgIds": [
              "ACT.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni duuba waan worraani jed'e, Batiso tamiini batifamtani re? Batiso Yohanatiini batifamne jed'aniini. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.3",
            "verseOrgIds": [
              "ACT.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.11"
              },
              "items": [
                {
                  "text": "Mat 3.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.4"
              },
              "items": [
                {
                  "text": "Mar 1.4",
                  "type": "text"
                }
