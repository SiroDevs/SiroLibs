              "items": [
                {
                  "text": "Huji 4.32-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri d'ugefate ch'ufti wold'aqe waan ch'ufa woliini tolche woliini qoodate. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "ACT 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hori yo gurgurani nami ch'ufti akuma woli ira gaargala qabuuni gargari qoodata. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.45",
            "verseOrgIds": [
              "ACT.2.45"
            ]
          }
        },
        {
          "name": "verse",
