          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Israeli ch'ufti ha hubatuuti, aka Waaqi Yeso kana ka isani mukhati fanniftani Aabboofi Kristo tolche!",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.36",
            "verseOrgIds": [
              "ACT.2.36"
            ]
          }
        }
      ]
    },
    {
