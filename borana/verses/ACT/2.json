          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya ch'ufa Mana Waaqa keesati wolwoldaani sagale mana woli keesati nyaatani garaa gammadatiifi d'ugaatini woliini taani, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "ACT 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa faarsani, biyyiti ch'ufti worra jaalatte. Guyya ch'ufa Aabbooni nama baafamu gumiti dare.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.47",
            "verseOrgIds": [
              "ACT.2.47"
            ]
          }
        }
      ]
