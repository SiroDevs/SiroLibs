              "ACT.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.17",
            "verseOrgIds": [
              "ACT.24.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.17+ACT.21.18"
              },
              "items": [
                {
                  "text": "Huji 21.17-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ganna heddu Yerusalemu iraa tae jennaani horifi sorio gosa tiyya baasu d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.17",
            "verseOrgIds": [
              "ACT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaa waan kana tolchu jiru Mana Waaqa keesati na argani, eegi anini aada qulqullefacha hobaafad'e. Gumiini na woliini injirtu, gohantileeni injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.18",
            "verseOrgIds": [
              "ACT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yahudiini lafa Asia achi jirti, worri si dura eje na himachu male, yo waan na himataniifi qabaate. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.19",
            "verseOrgIds": [
              "ACT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yokhaani worri kunini ha wollaala anini gaafa gumi kora dura eje dubbad'e tolche himuti, waan tokoti ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.20",
            "verseOrgIds": [
              "ACT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini worra durati olkae jennaani jed'e male. Wonti na",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.6"
              },
              "items": [
                {
                  "text": "Huji 23.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " qoraniifi maro anini kaisa nama due d'ugefad'uufi na qorani.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Felikini, ka waan kara kana aka dansa beekhu, kora baase dubbi teesani inilaala yo guddaani askarti ch'ufa ka Lisia jed'ani d'ufe jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Askarticha Paulo tissuuni, Aka dansa isa eegi ammo inhid'iini, aka jaalaani isaa waan inni fed'u kennituufi ind'owiini jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi bulti diqo toko Felikini, niiti ufi Drusila ta gosa Yahudi, woliini d'ufe. Inni Paulo yaame waan d'ugefacha ta Yeso Kristo d'ugefatani nati himi jed'e, isa ch'aqase. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.24",
            "verseOrgIds": [
              "ACT.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Pauloni tae waan d'ugaatifi ka obsaatifi ka qorsuma hegeri d'uftu dubbatu, Felikini sodaate waan jed'e, amma beeni, yo isiini naa fuute si yaama. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.25",
            "verseOrgIds": [
              "ACT.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan Pauloni beeseni isa gumbeesu sehe. Tanaafi maro heddu isa yaame hasaeeni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.26",
            "verseOrgIds": [
              "ACT.24.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
