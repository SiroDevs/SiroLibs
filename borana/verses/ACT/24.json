        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.26",
            "verseOrgIds": [
              "ACT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
