        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla d'aalti jirtu, nami iraa d'aalani qara duu male, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "d'aalti haga nami iraa d'aalani suni jiru injirtu, yo inni due ch'alla taati. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
