            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eegi waan kana kurfeesani, qaaloleeni hojja ch'ufa bada waaro taani olseenti, aka huji ufi hojattu; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.6",
