        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.18+EXO.25.19+EXO.25.20+EXO.25.21+EXO.25.22"
              },
              "items": [
                {
                  "text": "Bah 25.18-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sanduqa gubba fakeenna waan lubbu qabaati ka aka Waaqi achi jiru garsiiftuti jira, ta koola ufi fulla daba namaa araaramaniti balliftu. Ammo yoi waan ch'ufa diideesani himani, ammaniti.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
