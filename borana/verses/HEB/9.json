              "HEB.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro waan kanatifi Kristoni nama wold'aqisa haraa kurfeesu tahe, aka worri Waaqi yaame eeba hegeri ta Waaqi kakhate argatu. Wonti woni kuni taatuufi, maro duisi jiruufi ka wollaala wold'aqisa qara jalati tolchani, keesaa nama baasu jiruufi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        }
      ]
    },
