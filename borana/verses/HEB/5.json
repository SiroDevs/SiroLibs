              "type": "text"
            }
          ]
        },
        {
          "text": " Akasuma Kristoni guddinna kana ufi fud'ate qaallu gudda ufi intolchine, ammo Waaqi waan isaani jed'e,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
