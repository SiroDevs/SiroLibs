                {
                  "text": "Ayu 5.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.11+PRO.3.12"
              },
              "items": [
                {
                  "text": "Mam 3.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dubbi dansa ta Waaqi aka ilmaani isaa isaniti dubbatu la deettani?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
      ]
    },
    {
