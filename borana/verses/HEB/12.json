            "sid": "HEB 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me, aka inni gaargale, jibba nami daba isa jibbe ch'ufa obse herega! Tanaafi illaafiina, indad'abiina! ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.3",
            "verseOrgIds": [
              "HEB.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi gaargala keesani ka daba keesati, d'iigi keesani injinne, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
