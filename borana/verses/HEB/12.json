            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi harka keesani ka aare isani iraa bue olfud'ad'a! Jilba keesani ka lalaafe qajeelfad'a! ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.12",
            "verseOrgIds": [
              "HEB.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.4.26"
              },
              "items": [
                {
                  "text": "Mam 4.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kara qajeela gula deema, aka miili buqae innaafanne ammo fayyu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.13",
            "verseOrgIds": [
              "HEB.12.13"
            ]
          }
        }
