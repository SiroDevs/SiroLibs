        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.4",
            "verseOrgIds": [
              "HEB.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
