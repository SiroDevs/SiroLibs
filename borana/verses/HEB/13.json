          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini aka oboleesi keenna Timotheoni hid'aansa keesaa bahe isani beesisu fed'a. Yo inni hurrise d'ufe, hojja gara keesani d'ufu wolumaani d'umna, aka wolgarru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.23",
