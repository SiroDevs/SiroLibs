              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.63",
            "verseOrgIds": [
              "EZR.2.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "EZR 2:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami boojiani ka gale ch'ufti wolti nama 42,360. Hojattuuni worraa uwafi d'iirtileeni nama 7,337. Sirbituni d'iirafi nad'eeni 200, fardoleeni 736, gaangeleeni 245, gaali 435, harreleeni 6,720. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.64+EZR.2.65+EZR.2.66+EZR.2.67",
            "verseOrgIds": [
              "EZR.2.64",
              "EZR.2.65",
              "EZR.2.66",
              "EZR.2.67"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "68",
            "style": "v",
            "sid": "EZR 2:68"
          },
          "items": [
            {
              "text": "68",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja worri boojiani kaani Mana AABBO Waaqa ka Yerusalemutini bahe, jaaroleeni balbala gosa ta gari, fed'i ufi gula wo baafte, aka Mana Waaqa fulluma inni duri eju taani irati mid'aasani jaarani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri haga d'aqabu baase, wonti baasani suni ch'ufti wolti hagana taate: Worqiini kilo d'ibba shani, qarsiini kilo kuma lamatiifi d'ibba saddeeti, ammalle ubaara d'ibba toko ka qaaloleeni naqatu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        }
      ]
    },
