        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mihi kuni ch'ufti wolti, qorifi mihi d'ibiini ka Sheshbazani, gaafa isaafi worri boojiani kaani lafa Babiloniti bahani Yerusalemu d'aqani, fuud'e deemeni 5,400.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
