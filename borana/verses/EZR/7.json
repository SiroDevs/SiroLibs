            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi gamna heddu Artashastani hayyu Ajemi tahe. Gaafasi namicha tokoti jira, ka Ezra jed'ani inni, ilma Seraya, ka ilma Azaria, ka ilma Hilkia, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.1",
            "verseOrgIds": [
              "EZR.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ilma Shalumu, ka ilma Sadoki, ka ilma Ahitubu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.2",
            "verseOrgIds": [
              "EZR.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ilma Amaria, ka ilma Asaria, ka ilma Merayothi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.3",
            "verseOrgIds": [
              "EZR.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ilma Zerahiya, ka ilma Uzi, ka ilma Buki, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.4",
            "verseOrgIds": [
              "EZR.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ilma Abishua, ka ilma Finehasi, ka ilma Eleazari, ka ilma Haruni qaallicha gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.5",
            "verseOrgIds": [
              "EZR.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezrani guddo waan Seera AABBO Waaqa Israeli, ka inni Musaa kenne, soome barate. Maro inni eeba AABBO Waaqa isaa qabuufi, hayyichi waan inni kad'ate ch'ufa kenneefi. Ganna torbeeso ka Artashastani lafa mohate, Ezrani Babiloni kae, worra Israeli ka garitifi qaalole, worra Lawiti, Sirbitu, worra mana eegu, hojattu Mana Waaqa ta gari woliini Yerusalemu yaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.6+EZR.7.7",
            "verseOrgIds": [
              "EZR.7.6",
              "EZR.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri guyya qara, ka jia qara, lafa Babiloniti bahe qarqaarsa Waaqatini guyya qara ka jia shaneeso Yerusalemuni bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.8+EZR.7.9",
            "verseOrgIds": [
              "EZR.7.8",
              "EZR.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezrani haga jiru ch'ufa Seera AABBO Waaqa soome barate guute, aadaafi waan keesati t'aafani ch'ufa gumi Israeli barsiise.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tatabe hayyuuni Artashastani Ezraa kenne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.10",
            "verseOrgIds": [
              "EZR.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Artashastani tatabe tana t'aafe, qaallicha Ezra, ka waan seera nama barsiisu, ka aadaafi seera AABBO Waaqi worra Israeliti kenne aka dansaa barate iti, kenne. Dubbini tatabeeni sunini jettu tana: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.11",
            "verseOrgIds": [
              "EZR.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi Artashastani tatabe tana qaallicha Ezra ka waan Seera Waaqa gubba jiru nama barsiisuti t'aafe waan jed'e: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.12",
            "verseOrgIds": [
              "EZR.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woni anini jed'u tana: Nama Israeli ch'ufti, ka lafa tiyya keesa jiru, ka Yerusalemu d'aqu fed'u qaaloleefi worri Lawi taanaani ha siini woliini yauti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.13",
            "verseOrgIds": [
              "EZR.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaafi jari mala na d'au, nami torba, si ergina, aka atini Yerusalemu d'at'e, finna lafa Yuda hubatte, ammalle aka Seera AABBO Waaqa keeti jabeesani guutani laaltu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.14",
            "verseOrgIds": [
              "EZR.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini Worqifi qarsi, ta anaafi jari mala na d'au Waaqa Israeli, ka mani isaa Yerusalemu jiru, baasu feenu, fuute deemuuni malte. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.15",
            "verseOrgIds": [
              "EZR.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle atini qarsifi worqi, lafa Babiloni ch'ufa keesaa guurtefi waan worri Israelitiifi qaaloleeni Mana Waaqa isaani, ka Yerusalemu keesati baaftule, fuute deemuuni malte. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.16",
            "verseOrgIds": [
              "EZR.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beese tana aka dansaa jabeesi, koromi loonitifi Elemiyeefi ilmoole hoolatifi mid'aanifi daad'iini biti, waan sorio irati baasani ka Mana Waaqa ka Yerusalemu keesa jiru irati sorio baasi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.17",
            "verseOrgIds": [
              "EZR.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qarsifi worqi ta huji suni ira hafte siifi gochiti tante waan feetani tolfad'a, fed'i Waaqa keesani gula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.18",
            "verseOrgIds": [
              "EZR.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miha Mana Waaqa keesani hojattani ka siti kennani, hojja Yerusalemuni baate Waaqa kenni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.19",
            "verseOrgIds": [
              "EZR.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle waan Mana suni d'ibi atini feetu ch'ufa, fulla beese hayyu iti olkayani keesaa sii kennani.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.20",
            "verseOrgIds": [
              "EZR.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini nama hori hayyu olkayu ch'ufa, ka lafa Efrati ta ila adu jiru, waan jed'uuni: Waan qaallichi Ezrani, ka waan Seera Waaqa gubbaa ch'ufa beekhu, isani gaafatu ch'ufa hurrisa, iti keenna, ammo haga kana indabarsina: ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.21",
            "verseOrgIds": [
              "EZR.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "qarsi kilo kuma saditifi d'ibba afuri, dargaye kilo kuma kud'ani, daad'iini d'ebbe d'ibba toko, d'ad'aleni d'ebbe d'ibba toko, sooda haguma worri fed'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.22",
            "verseOrgIds": [
              "EZR.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZR 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Mana Waaqa gubbaa ka inni fed'u ch'ufa jabaad'a baasa aka inni anaafi ilmaani tiyyati indallanne. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.23",
            "verseOrgIds": [
              "EZR.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZR 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle qaalole worra Lawiti, sirbitu, worra balbala eegufi hojattu Mana Waaqa, yokhaani nama taatefu ka huji mana suni hojattu, gibira iraa infuud'ina. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.24",
            "verseOrgIds": [
              "EZR.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezra, atileeni, qarooma Waaqi kanke sii keenne kanaani, jaarole lafa fidduufi jaallaboota, worra lafa Efrati ka Seera Waaqa kanketi keesati fidamu fiddu, fohad'i. Nama waan Seera suni imbeennele ch'ufa barsiisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.25",
            "verseOrgIds": [
              "EZR.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami tokoleeni Seera Waaqa kanketi yokhaani seera hayyu ch'abse, hurrisi, hojuma suni waan kana iti muri: duisa yokhaani lafa keesaa baasiti yokhaani hori iraa saamiti, yokhaani hid'aansa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Ezrani Waaqa faarse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.26",
            "verseOrgIds": [
              "EZR.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezrani waan jed'e, AABBO, Waaqa ababoota teenna, ha faarsani inni yayu hayyicha waan dansa qaabachise, aka inni akanaani Mana Waaqa ka Yerusalemu mid'aasu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeba Waaqatini anini yayu hayyichaafi jara isaa mala d'aufi jara isaa gugurdale naasu iraa argad'e; AABBO Waaqi kiyya yayu garaa na jabeese, anileeni worra balbala gosa Israeliti mataa heddu sobad'e ufi gula deebise woliini galle.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra eegi boojiani gale",
          "type": "text"
        }
      ]
    }
  ],
