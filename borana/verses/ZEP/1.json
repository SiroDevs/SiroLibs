            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.16",
            "verseOrgIds": [
              "ZEP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Anini gaargala namatiini d'ufa, aka nami ch'ufti balla tahe jaanjuru. Waan worri nati ch'ubbamefi, d'iiga worraa aka bisaani lafati jissani, reefa worrale aka d'oqe lafati d'opani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.17",
            "verseOrgIds": [
              "ZEP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya AABBO Waaqi dallanu, qarsifi worqiini worraleeni dandeete worra imbaaftu. Lafti ch'ufti dallansu isaatiini gubati. Inni nama lafa keesa jiru ch'ufa yoosu maro tokotu hobaasa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.18",
            "verseOrgIds": [
              "ZEP.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka AABBO Waaqati deebia jed'ani",
          "type": "text"
        }
      ]
    }
