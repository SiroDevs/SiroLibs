                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Uum 19.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yo anini d'uguma Waaqa Israeli taate, anini worra Moabutiifi ka Amoni akuma Sodomafi Gomora balleesani balleesa. Lafti suni doobifi boola soodda taate haga jirtu badi. Nami kiyya ka hafu worra suni saame lafa worraa fud'ata.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.9",
            "verseOrgIds": [
              "ZEP.2.9"
            ]
          }
        }
