            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani worra Moabutiifi ka Amoni gaargalchani, maro kiyyiba isaanitifi ammalle waan worri gumi AABBO Waaqa Gudda arabse dabseefi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.10",
            "verseOrgIds": [
              "ZEP.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEP 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi worra sodaachiise, waaqoota worrale waan woma keesa injirre tolcha. Duuba gochiti ch'ufti lafa ufi keesati isa durati gajette kad'ati.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.11",
            "verseOrgIds": [
              "ZEP.2.11"
            ]
          }
        }
      ]
