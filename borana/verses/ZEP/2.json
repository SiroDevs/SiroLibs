            "number": "2",
            "style": "v",
            "sid": "ZEP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato gogoddani aka daraara imbadiini, ammalle ato dallansuuni AABBO Waaqa isani ingubini, ammalle ato guyyaani dallansu AABBO Waaqaa isani ind'aqabiini. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEP 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa barbaada, isani worri balchichi, ka seera isaa guutu. Waan qajeela barbaada, AABBO Waaqa durati ufi balchoomsa. Hegeri guyya dallansu AABBO Waaqa duraa baatanifa.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
