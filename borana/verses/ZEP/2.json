        },
        {
          "text": " AABBO Waaqi Guddaani waan jed'u, Anini worra Moabutiifi ka Amoni, ka gumi tiyya arabse goyeese, Lafa teesani fud'anna jed'u, ya d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.8",
            "verseOrgIds": [
              "ZEP.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
