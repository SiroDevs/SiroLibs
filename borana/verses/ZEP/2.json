              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa ch'eera inqamne, wolti koota, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
              "ZEP.2.1"
            ]
          }
        },
        {
          "name": "verse",
