              "items": [
                {
                  "text": "Uum 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anini isani nama haga gari, akuma anini Sodomafi Gomora balleese, balleese. Isani nami hafe aka qoraani ibidaa, ka ibida keesaa fuud'ani, jirtani. AABBO Waaqi waan jed'e, Taatule isani nati indeebine. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi worra Israeli, wonti anini isani tolchu tana: Waan anini waan kana isani tolchufi aka Waaqa keesani dura d'uftani kurfefad'a!",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka daba iraa deebia namaani jed'ani",
          "type": "text"
        }
      ]
    }
