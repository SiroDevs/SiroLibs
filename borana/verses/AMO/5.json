            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.42+ACT.7.43"
              },
              "items": [
                {
                  "text": "Huji 7.42-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Isani gumi Israeli, gaafa lafa aloo ta gamooji keesa ganna afurtama teetani, soriofi waan naa baaftani d'ibi, ya na d'uftaniini? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
            "verseOrgIds": [
              "AMO.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "AMO 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo amma waan isani akheekha Sikuthi hayyu keesanitiifi Kiuni waaqa keesani ka urji kad'attanifi, akheekha suni baachu maltani, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "AMO 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
