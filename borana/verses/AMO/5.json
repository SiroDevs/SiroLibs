              "AMO.5.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.11+ISA.1.12+ISA.1.13+ISA.1.14"
              },
              "items": [
                {
                  "text": "Isa 1.11-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " AABBO Waaqi waan jed'u, Anini jila teesani ta aadaa jibbe tufad'e dida! ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.21",
            "verseOrgIds": [
              "AMO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "AMO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato isani waan gubani sorio na baaftanifi mid'aani keesani na baaftanile anini imfud'ad'u. Hori isani gabbiftani na baaftanile ani imfud'ad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.22",
            "verseOrgIds": [
              "AMO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "AMO 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyyanna teesani ta sirba tana lakisa; anini dibbe teesani ch'aqasu imfed'u. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.23",
            "verseOrgIds": [
              "AMO.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "AMO 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla sirba suni, d'ugaani ha aka lola yaatu, qajeelumtileeni ha aka galaani hojja ch'ufa yau yaatu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.24",
            "verseOrgIds": [
              "AMO.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
