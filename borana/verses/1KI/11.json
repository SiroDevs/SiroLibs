        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.39",
            "verseOrgIds": [
              "1KI.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi Solomonini Yeroboamu ijeesu fed'e, ammo inni hayyu Misiri ka Shishaki jed'aniti baqate, haga Solomonini duuti achuma tae.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.40",
            "verseOrgIds": [
              "1KI.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duisa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
