          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.7+2KI.8.8+2KI.8.9+2KI.8.10+2KI.8.11+2KI.8.12+2KI.8.13"
              },
              "items": [
                {
                  "text": "2 Hay 8.7-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'eeni, Beeni, lafa aloo ta d'aatu Damaskiti deebii, duuba dira suni — seeni, Hazaeli muudi, hayyu Shamu tolchi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.1+2KI.9.2+2KI.9.3+2KI.9.4+2KI.9.5+2KI.9.6"
              },
              "items": [
                {
                  "text": "2 Hay 9.1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yehu ilma Nimshile muudi, hayyu Israeli tolchi. Ammalle Elisha, ilma Shafathi, ka worra Abel-Mehola, muudi, fulla tante raaga tolchi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.16",
            "verseOrgIds": [
              "1KI.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama baqate Hazaeli duraa bahe Yehuti hobaasa, ammalle ka Yehu duraa bae Elishati hobaasa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.17",
            "verseOrgIds": [
              "1KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.4"
              },
              "items": [
                {
                  "text": "Rum 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ammo taatule anini nama kuma torba, ka Israeli, ka Baali gula bahe d'ungate durati jilbifate inkad'atiini, imbaasa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yaamicha Elisha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.18",
            "verseOrgIds": [
              "1KI.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani kae iti d'aabate, Elisha ilma Shafathi, ka tae qotiyoni lafa qotu jiruni bahe; karaaba t'indi kud'ani tokoti isa dura yaa, ammo inni ka eegeetini qotu jira. Eliyaani woya ufi ufira fuud'e Elishati uyise. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.19",
            "verseOrgIds": [
              "1KI.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Elishani qotiyo lakise, Eliyaa gula utaale waan jed'eeni, Eegi, abbaafi haad'a tiyyaani nagayati jed'e, Duuba si gula d'ufa. Eliyaani waan jed'eeni, Hayye, beeni deemi, anini si ind'owu!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.20",
            "verseOrgIds": [
              "1KI.19.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 19:20"
          },
