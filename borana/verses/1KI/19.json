    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Ahabuni waan Eliyaani tolche ch'ufa ammalle aka inni raagoota Baali ch'ufa hobaase niiti isaa Yezebeliti hime. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.1",
            "verseOrgIds": [
              "1KI.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isiini qoonqo Eliyaati ergite waan jette: Waaqi na ijeesinna, hojja anini bori aka atini raagoota suni ijeefte si inijeesiini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.2",
            "verseOrgIds": [
              "1KI.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Eliyaani qoonqo suni d'ageennaani sodaate, aka lubbu ufi baasu hojattu isaa fud'ate kae, dira Beersheba ka lafa Yuda keesa jiru, baqate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiti hojattu isaa lakise, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.3",
            "verseOrgIds": [
              "1KI.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.4.3"
              },
              "items": [
                {
                  "text": "Yon 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ufi guyya suni ch'ufa lafa aloo keesa deema oole. Jennaani ato deemu ejate gaadisa mukha jala tae, Waaqaani, lubbu na keesa fuud'i, hojja anini due ira na jirti jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.4",
            "verseOrgIds": [
              "1KI.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni mukha kaani jala gach'iise rafe. Jennaani malaikaani d'ufte isa kaafte waan jetteeni, kai waan kana soorad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.5",
            "verseOrgIds": [
              "1KI.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni kae ufi bira millate qit'afi sorora bisaani d'aatu mata ufiti arge, nyaate, d'uge deebie gach'iise. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.6",
            "verseOrgIds": [
              "1KI.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani AABBO Waaqa ammalle iti deebite isa kaafte waan jetteeni, Kai, sagale soorad'i, imaltuni siti guddo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.7",
            "verseOrgIds": [
              "1KI.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani kae nyaate d'uge, akanaani jajabaate, bulti afurtama gara gaara qulqullo Sinai jed'ani miilaani deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Artini bahe jennaani goda d'akha toko seene bule. Jennaani AABBO Waaqa isaani dubbate waan jed'eeni, Eliya, maani armaa tolfata?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.9",
            "verseOrgIds": [
              "1KI.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
