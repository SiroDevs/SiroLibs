  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi bulti heddu, ganna sadeeso ka oola hamtu suni keesa, AABBO Waaqi waan Eliyaani jed'e, Beeni, Ahabu argu d'aqi, duuba anini bokayaani isanii d'ufa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.1",
            "verseOrgIds": [
              "1KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani Ahabu argu d'aqe. Oolani lafa Samaria keesati guddo jabaate, jennaani Ahabuni Obadia, namicha huji mana hayyuti gudda, yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.2",
            "verseOrgIds": [
              "1KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Obadiani nama guddo AABBO Waaqa sodaatu; gaafa Yezebelini raagoota AABBO Waaqa fit'e ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.3",
            "verseOrgIds": [
              "1KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadiani raagoota d'ibba toko fuud'e goda d'akhaa keesati shantama shantamani d'osse, sagaleefi bisaani kenneefi.) ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.4",
            "verseOrgIds": [
              "1KI.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabuni waan Obadiani jed'e, Me, maddaafi laga ch'ufa keesa nu yaasi, marra fardooleefi gaangele duu d'owu barbaanna, akasiini hegeri hori keenna lubbu baamna. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.5",
            "verseOrgIds": [
              "1KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri lachu ee jed'e, lafa abuuru d'aqu wolgaafate, abbu kara ufi iti d'aabate.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.6",
            "verseOrgIds": [
              "1KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato Obadiani kara deemu Eliyaani bahe, isa hubate durati gajed'e, waan jed'eeni, Aabbo Eliya kunini d'uguma sii?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.7",
            "verseOrgIds": [
              "1KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Ee anuma, beeni, hayyichaani, Eliyaani ya d'ufe jed'i.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.8",
            "verseOrgIds": [
              "1KI.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obadiani waan jed'eeni, Anini maani yake ka atini harka Ahabu keesa na buufte? inni na ijeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.9",
            "verseOrgIds": [
              "1KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqa AABBO Waaqa kanketitini siti kakhad'a, aka hayyichi lafa ch'ufa keesa si barbaade si d'abe. Hojja hayyuuni lafa tateefu Eliyaani lafa tiyya keesa injiru jed'u Ahabuni hayyu sunini, kakhad'i jed'a, aka inni si inargini. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.10",
            "verseOrgIds": [
              "1KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini amma, beeni, deemi Eliyaani arma jira jed'iini jetta? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.11",
            "verseOrgIds": [
              "1KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja akuma anini deemeni lubbuuni AABBO Waaqa arma si fuute fulla nami imbeenne si geesite, anini maani taha? Duuba hojja anini Ahabuti hime arti si d'abani, Inni na ijeesa. Atini imbeeta anini haguma d'alad'e AABBO Waaqa sodaad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.12",
            "verseOrgIds": [
              "1KI.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini aka anini gaafa Yezebelini raagoota AABBO Waaqa hobaafte, raagoota d'ibba toko goda d'akha keesati shantama shantamani d'osse, sagaleefi bisaani kenneefi ind'ageenne, jed'iini nani jetta, inni na ijeesa! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.13",
            "verseOrgIds": [
              "1KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba amma tana atini akami beeni hayyuti himi, anini arma jira, jed'iini nani jetta, inni na ijeesa!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.14",
            "verseOrgIds": [
              "1KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani waan jed'eeni, Anini maqa AABBO Waaqa gudda anini hojad'uni kakhad'a aka anini arra hayyu arge male inteenne.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.15",
            "verseOrgIds": [
              "1KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Obadiani kae gara Ahabu d'aqe, dubbi suni iti hime, Ahabuni kae Eliya argu d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.16",
            "verseOrgIds": [
              "1KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabuni Eliya arge jennaani waan jed'eeni, Kunini d'aguma sii, ka lafa Israeli balleese?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.17",
            "verseOrgIds": [
              "1KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani waan jed'eeni, Nami Israeli balleese, ananiti siifi worra keesani, waan isani seera AABBO Waaqa ch'absitani, Waaqa Baali jed'ani gula baatanifi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.18",
            "verseOrgIds": [
              "1KI.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma waan taatu, worra Israeli ch'ufa gaara Karmeliti wolti naa yaani. Ammalle raagoota d'ibba afuritiifi shantama ta Baalitifi raagoota d'ibba afuri ta Ashera, ta hayyiti Yezreelini fiddu natiini kooti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.19",
            "verseOrgIds": [
              "1KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Ahabuni worra Israelitiifi raagoota Baali ch'ufa gaara Karmeliti wolti yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.20",
            "verseOrgIds": [
              "1KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani biyyati d'ufe waan jed'eeni, Isani haga jirtani waan lama jiddu yau illakiftani? Hojja AABBO Waaqi Waaqa taate isa gula baha; ammo yo Baalini Waaqa taate isa gula yaa! Ammo biyyiti woma isa gula indubbanne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.21",
            "verseOrgIds": [
              "1KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani waan jed'e, Raagi AABBO Waaqa ka hafe anuma ch'alla, ammo raagooti Baali nama d'ibba afuritiifi shantama. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.22",
            "verseOrgIds": [
              "1KI.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koromi lama gadi nuu kenna; raagooti Baali ha toko fuute qalte gargari ch'irte qoraani guba keetuti — ammo ibida imbobeesiini. Anileeni korma kaani akasuma tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.23",
            "verseOrgIds": [
              "1KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba raagooti Baali ha Waaqa ufi kad'atu, anileeni AABBO Waaqa kad'ad'a; duuba abba ibida gabuuse akanaani kad'a namaa d'agayeti Waaqa d'ugaati. Jennaani biyyiti ch'ufti dubbi suni quufte, hataatu jette.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.24",
            "verseOrgIds": [
              "1KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani waan raagoota Baalitini jed'e, Isanitu nama heddu, korma toko fuud'a na durati qala. Qoraani kana ibidaani intuqina, Waaquma keesani ch'alla kad'ad'a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.25",
            "verseOrgIds": [
              "1KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri korma kennanifi kaani fuud'e qale, haga aduuni guyya gudda geetuti asi Baali iti kad'ate, waan jed'e, Ee Baali, nu ch'aqasi, ammalle worri d'aatu waan sorio irati baasani ka worri jaare suni, mare, olch'ech'eani sirbani, ammo nami owaate dubbi worra jala qabe tokoleeni injiru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.26",
            "verseOrgIds": [
              "1KI.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafti guyya gudda geennaani, Eliyaani worra goyeese waan jed'e, Lalabdani yaamtani ho? Inni Waaqa keesaniniti, inni hegeri muguu jira yokhaani gabaefa, yokhaani imaltu fa jira! Yokhaani hegeri raafu jira kaasu maltani! ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.27",
            "verseOrgIds": [
              "1KI.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani raagooti taani lalabde kad'ate, aada ufi gula bilaafi woraanani ufi mumurte d'iiga ufi keesaa yaaafte. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.28",
            "verseOrgIds": [
              "1KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri akuma kaani haga lafti galgalooftuti iyyee maraate; ammo taatule nami qonqo worra d'agaye yokhaani worra jala owaate tokoleeni injiru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.29",
            "verseOrgIds": [
              "1KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Eliyaani waan biyyaani jed'e, Me nati gad'iaad'a jennaani biyyiti iti gad'iaate. Inni fulla sorio AABBO Waaqa iti baasani ta qara balleesani mid'aase, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.30",
            "verseOrgIds": [
              "1KI.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.28"
              },
              "items": [
                {
                  "text": "Uum 32.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.10"
              },
              "items": [
                {
                  "text": "35.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "d'akhaa kud'ani lama, gosa kud'ani lama ta ilmaani Yakobo namicha AABBO Waaqi Israeli maqa baase kaani gula fuud'e, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.31",
            "verseOrgIds": [
              "1KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "d'akhaaye sunini fulla AABBO Waaqa sorio irati baasani jaare. Jennaani fulla suni d'aatu, boola bisaani haga butte toko fuutu qote. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.32",
            "verseOrgIds": [
              "1KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qoraani fulla sorio iti baasani suniti tuule, korma suni qale, fooni isaa qoraani suni gubba naqe waan jed'e, Butte afuri bisaani guuta foonifi qoraani kana gubbati naqa. Worri bisaani keesaa naqe jennaani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.33",
            "verseOrgIds": [
              "1KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle iti deebia jed'eeni, Worri ammalle iti deebie, jennaani ammalle akasuma iti deebia jed'e worri iti deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.34",
            "verseOrgIds": [
              "1KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bisaani suni fulla sorio irati qalani taani ira jigani, boola inni d'aatuti qote taani guutani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.35",
            "verseOrgIds": [
              "1KI.18.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galgala yoi sorio baasani gahe jennaani Eliyaani fulla sorio irati qalani suniti d'iaate Waaqa kad'ate waan jed'e, Ee AABBO, Waaqa Abrahamutifi ka Isaaqotifi ka Yakobo, arra ha beekhani aka atini d'uguma Waaqa Israeli, ammalle aka anini hojattuuni tante waan kana ch'ufa jecha kanke gula tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.36",
            "verseOrgIds": [
              "1KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee AABBO, na d'agayi! Na dagayi AABBO! Aka gumiini tunini ch'ufti, aka atini AABBO Waaqa beete, ammalle aka atini worra gara kanke deefatu, hubatu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.37",
            "verseOrgIds": [
              "1KI.18.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 18:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi ibida gubbaa gabuuse, ibidi sunini foonifi qoraanifi d'akhaaye taanile ch'ufa gube lafa gogose, bisaani kaanileeni ch'ufti fooqatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.38",
            "verseOrgIds": [
              "1KI.18.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti waan kana ch'ufa garte jennaani lafati jijidde, lalabde waan jette, AABBOONI Waaqa, isa male Waaqi d'ibiini injiru!",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 18:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani waan worraani jed'e, Raagoota Baali ch'ufa qaqaba, tokoleeni imbahini! Biyyiti raagoota suni ch'ufa qabde, jennaani Eliyaani galaana Kishoniti geese worra ch'ufa fit'e.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka oolani dabarte",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Eliyaani waan hayyu Ahabuni jed'e, Beeni, amma sagale nyaad'i; anini huuru bokaya d'agaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 18:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.18"
              },
              "items": [
                {
                  "text": "Yak 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Ahabuni sagale nyaachu d'aqe, Eliyaaleeni gaara Karmeli fiit'e kore lafati gadi jed'e, mata isaa kaarra jilba isaa lamaani keeyate. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.42",
            "verseOrgIds": [
              "1KI.18.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba waan hojattu isaatini jed'e, Beeni, gara baariini fuula deefad'i, achi laali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 18:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojattuuni taani deemte, deebite waan jetteeni, Anini woma inagarre. Maro torba Eliyaani akasuma isa erge, innileeni ka woma inargini akasuma maro jaa deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.43",
            "verseOrgIds": [
              "1KI.18.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo maro torbeeso deebinaani waan jed'e, Anini dumansa diqa toko, ka haga harka namaa, ka Baariini keesaa gadibahu arge. Eliyaani waan hojattu isaatini jed'e, Gara Ahabu d'aqi waan jettuuni, Gaari kanke ka fardi hirkisu yaabad'i, ato bokeeni si ind'aqamne kai gali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 18:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.44",
            "verseOrgIds": [
              "1KI.18.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 18:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani maro tokotu jaldooni dumansa gubba ch'ufa qabate, bubbeeni bubbifte, bokeeni gubbaa baafate. Ahabuni gaari isaa yaabate, kae gara Yezreeli iti d'aabate. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.45",
            "verseOrgIds": [
              "1KI.18.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 18:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyaani woya mart'ifate, jabeenna irree AABBO Waaqatini Ahabu dura haga Yezreeli utaale.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.46",
            "verseOrgIds": [
              "1KI.18.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Eliyaani gaara Sinai gubbati arge",
          "type": "text"
        }
      ]
    }
