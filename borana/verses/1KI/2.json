              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini guyyaani isa alaa hobae jennaani ilma isa Solomoni yaame dubbi tana iti d'aamate: ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.1",
            "verseOrgIds": [
              "1KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani kiyya ya alaa hobae, jabaad'u aka d'iira tahi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.2",
            "verseOrgIds": [
              "1KI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan AABBO Waaqi tolchi sinjed'e tolchi kara isaa gula deemi, aadaafi seera isa, ta Seera Musa keesati t'aafani guuti, aka waan tolchitufi fulla atini deemtu ch'ufa keesa, eeba argattu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.3",
            "verseOrgIds": [
              "1KI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo atini Seera isaa guute, AABBO Waaqi kakhu inni naa kakhate, ta gaafa inni, d'alooti kanke worra Israeli mohate haga worri Seera kiyya garaa tokooni jabeese guutu, nani jed'e, sii guuta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.4",
            "verseOrgIds": [
              "1KI.2.4"
            ]
          }
        }
      ]
    },
    {
