            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.16+2SA.19.17+2SA.19.18+2SA.19.19+2SA.19.20+2SA.19.21+2SA.19.22+2SA.19.23"
              },
              "items": [
                {
                  "text": "19.16-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle namicha toko ka Shemei ilma Gera, ka gosa Benjamini, ka worri isaa Bahurimuti jira. Gaafa anini Mahanaimu d'aqe inni aka hama na abaare, ammo galaana Yordaniti woliargine jennaani, anini maqa AABBO Waaqatini iti kakhad'e aka anini isa inijeemne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.8",
            "verseOrgIds": [
              "1KI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo atini isa ka woi intolchini illakisini. Waan tolchu malani atu imbeeta, illakisini ijeesi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.9",
            "verseOrgIds": [
              "1KI.2.9"
            ]
          }
        }
      ]
    },
