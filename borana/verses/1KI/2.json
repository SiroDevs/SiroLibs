            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Adoniani, ilmi Hagithi, gara Bathsheba haad'a Solomoni d'aqe. Isiini waan jetteeni, Naguma d'ufte? Inni waan jed'eeni, Ee, naguma d'ufe, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.13",
            "verseOrgIds": [
              "1KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo waan siini jed'u qaba. Isiini waan jetteeni waan jechu feetu jed'i.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.14",
            "verseOrgIds": [
              "1KI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan jed'eeni, Atini imbeeta aka hayyumti sila tiyya ammalle nami Israeli ch'ufti ya aka hayyu na heregate. Ammo dubbini suni akasi intaane, oboleesa kiyyati, fed'i Waaqa gula, hayyu tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.15",
            "verseOrgIds": [
              "1KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini amma waan toko si kad'ad'a, na ind'owatini naa kenni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.16",
            "verseOrgIds": [
              "1KI.2.16"
            ]
          }
        }
      ]
    },
    {
