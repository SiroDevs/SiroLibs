            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.3+1KI.1.4"
              },
              "items": [
                {
                  "text": "1 Hay 1.3-4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Bathshebani waan jetteeni, Hayye kad'ad'i. Inni waan jed'eeni hayyicha Solomoni na kad'ad'i ani imbeekha inni si jala indidu — aka inni intala Abishagi jed'ani, ta lafa Shunamiti d'ufte, naa kennu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.17",
            "verseOrgIds": [
              "1KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan jetteeni hayye dansa, ya d'agaye, hayyuti sii hima.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.18",
            "verseOrgIds": [
              "1KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
