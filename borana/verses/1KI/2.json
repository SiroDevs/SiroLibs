              "items": [
                {
                  "text": "1 Sam 22.20-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.24"
              },
              "items": [
                {
                  "text": "2 Sam 15.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani hayyuuni waan qaallicha Abiatharini jed'e, Beeni, Anathothi lafa tanteeti gali, atini sila duu malte, ammo anini amma si inijeesu, wonti akanatiifi siti duri gaafa abba kiyyaani woliini jirtani, Sanduqa Wold'aqisa AABBO Waaqa qorqoratte, ammalle gaargala ch'ufa keesa abba kiyyaani woliini teetani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.26",
            "verseOrgIds": [
              "1KI.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.27+1SA.2.28+1SA.2.29+1SA.2.30+1SA.2.31+1SA.2.32+1SA.2.33+1SA.2.34+1SA.2.35+1SA.2.36"
              },
              "items": [
                {
                  "text": "1 Sam 2.27-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Solomonini Abiathari huji qaallu AABBO Waaqa keesaa baase, akanaani dubbi AABBO Waaqi duri Shiloti dubbate waan qaallu Eliifi d'alooti isaa tahu hime guute.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.27",
            "verseOrgIds": [
              "1KI.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yoabuni dubbi suni d'agaye; inni duri goli Absalomu tau dide, ammo eege goli Adonia tahe. Tanaafi inni Waaro Woyyumati d'eete gaafa waan mesa fakaata kaani qabate. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.28",
            "verseOrgIds": [
              "1KI.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomonini aka Yoabuni Waaro Woyyumati d'eete d'aatu waan mesa fakaata kaani eju d'agaye jennaani, Benaiya ilma Yohaida iti erge waan jed'eeni Beeni Yoabu ijeesi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.29",
            "verseOrgIds": [
              "1KI.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gara Waaro Woyyuma d'aqe waan Yoabuni jed'e, Hayyichi, gadi bahi siini jed'a. Ammo Yoabuni waan jed'eeni, Anini ind'ufu, armumati dua. Jennaani Benaiyani hayyuuti deebie waan Yoabuni isaani jed'e iti hime.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.30",
            "verseOrgIds": [
              "1KI.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomonini waan jed'eeni, Waan inni fed'u tolchi, artumati ijeesi awaali. Aka akanaani anaafi worri keenna nama tokole d'iiga nama woma iyyakini ka Yoabuni fit'e ingaafanne. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.31",
            "verseOrgIds": [
              "1KI.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Yoabu ingaargalcha, waan inni, ka abbaani kiyya Daudini quba inqamne, worra suni fit'eefi. Inni nama lama ka woma iyyakini, ka isa ira jiru, ijeese: Abineri gudda askarti Israelitiifi Amasa gudda askarti Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.32",
            "verseOrgIds": [
              "1KI.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'iigi worraa gubba Yoabutifi d'aloota isaa haga jiru jireenna taha. Ammo AABBO Waaqi ha hojja ch'ufa Daudifi d'aloota barch'uma isaa ka hayyuma ira tau eebise nagaya kennufi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.33",
            "verseOrgIds": [
              "1KI.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Benaiyani kae Waaro Woyyuma d'aqe Yoabu ijeese, worra isaa ka diida jiruti isaa awaalani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.34",
            "verseOrgIds": [
              "1KI.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi fulla Yoabu Benaiya gudda askarti tolche, fulla Abiathari Sadoki qaallu tolche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Duisa Shimei",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.35",
            "verseOrgIds": [
              "1KI.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyichi Shimei yaame waan jed'eeni, Yerusalemu keesati mana jaarad'i, dira suni keesaa imbahini keesuma tai. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.36",
            "verseOrgIds": [
              "1KI.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo atini guyya tokole armaa baate galaana Kidroni taakite, atini inuma doota. D'iigi kanketileeni gubbuma teeti.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.37",
            "verseOrgIds": [
              "1KI.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemeini waan jed'eeni, Hayye, ha taatu, Ee hayyichi, waan atini jettu inuma guuta. Duuba akanaani inni bara heddu Yerusalemu keesa tae. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.38",
            "verseOrgIds": [
              "1KI.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eege, eegi inni ganna Sadi tae, tisseleeni Shemei lama baqate hayyu Gathi, ka Akishi ilma Maaka jed'aniini baate. Shemeini aka tisseleeni isaa lafa Gathi jirtu d'agaye jennaani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.39",
            "verseOrgIds": [
              "1KI.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "harre ufi faate, gara Akishi hayyu Gathi d'aqe, tissele suni barbaade. Inni worra arge jennaani fuud'e galeeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.40",
            "verseOrgIds": [
              "1KI.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomonini waan Shemeini tahe d'agaye jennaani, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.41",
            "verseOrgIds": [
              "1KI.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "isa yaame waan jed'eeni, Anini maqa AABBO Waaqatini si kakhachiise aka atini dira kana keesa garu ind'anne. Ammalle anini si gorse yo atini armaa baate indoota jed'e siti hime atinileeni, Hayye, dansa inguuta nani jette. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.42",
            "verseOrgIds": [
              "1KI.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini maanifi duuba kakhu suni ch'absite dubbi tiyya gula deemu didde? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.43",
            "verseOrgIds": [
              "1KI.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1KI 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hayyichi waan Shemeini jed'e, Waan hamtu atini abba kiyya Daudi tolchite aka dansaa beeta maro ch'ubbu sunitifi AABBO Waaqi si gaargalcha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.44",
            "verseOrgIds": [
              "1KI.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1KI 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni na eebise hayyuma Daudi haga jiru jireenna jabeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.45",
            "verseOrgIds": [
              "1KI.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1KI 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyichi Benaiya yaame, Beeni, Shemei ijeesi jed'eeni; jennaani inni kae ijeese. Akanaani Solomonini aka jaba lafa suni ch'ufa fide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.46",
            "verseOrgIds": [
              "1KI.2.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Solomonini qarooma kad'ate",
          "type": "text"
        }
      ]
    }
