          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudini due jennaani isa diruma isaa keesati awaalani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.10",
            "verseOrgIds": [
              "1KI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.4+2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5.4-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.4"
              },
              "items": [
                {
                  "text": "1 Od-dur 3.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni ganna afurtama gosa Israeli mohate, ganna torba Hebroni keesa tae, ganna sodomi sadi Yerusalemu keesa tae. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.11",
            "verseOrgIds": [
              "1KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.23"
              },
              "items": [
                {
                  "text": "1 Od-dur 29.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Solomoni hayyuma abbaa isaa iraa fuud'e, aka dansaa jabeese lafa fide.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.12",
            "verseOrgIds": [
              "1KI.2.12"
            ]
          }
        }
      ]
    },
