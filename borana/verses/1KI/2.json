              },
              "items": [
                {
                  "text": "20.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle waan tokoti jira — waan Yoabuni gaafa inni worra gugurda lamaani askarti Israeli, Abineri ilma Neritifi Amasa ilma Yetheri ijeese na tolche, imbeeta. Ammalle aka inni bara lafti nagaya worra fit'e, akasiini haalo worra duri woraana keesati fit'ani baafate imbeeta. Inni nama woma iyyakini fit'e, wollaali suni amma gubba tiyya tahe na t'ureese. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.5",
            "verseOrgIds": [
              "1KI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma waan isa tolchu malani qalbi tante gula tolchi, ammo ato inni jaarsale taate inni ufiini induiini ijeesi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.2.6",
            "verseOrgIds": [
              "1KI.2.6"
            ]
          }
        }
      ]
    },
