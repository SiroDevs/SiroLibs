            "number": "27",
            "style": "v",
            "sid": "1KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramuni nama gari, ka huji hobolo beekhu, Solomonii, erge aka worri hojattu isaa woliini hojatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.27",
            "verseOrgIds": [
              "1KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
