          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri suni gara lafa Ofiri hojattu Solomoni woliini hobolooni d'aqe, worqi kilo kuma kud'ani afuri Solomonii geese.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.28",
