              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyu Solomonini ammalle hobolo heddu Ezion-Geberi, ta d'aatu dira Eliothi, afaani galaana Diima, lafa Edomu keesa, jaare. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.26",
            "verseOrgIds": [
              "1KI.9.26"
            ]
          }
        },
