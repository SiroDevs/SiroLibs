            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.17"
              },
              "items": [
                {
                  "text": "Bah 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.23"
              },
              "items": [
                {
                  "text": "34.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Qab-Ser 16.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ganna ch'ufa keesa maro sadi Solomonini sorio gubanifi sorio wold'ageeti, waan mesa fakaata ka inni AABBO Waaqa jaare, irati baase. Ammalle inni hit'aana AABBO Waaqaa aarse. Duuba akanaani Mana Waaqa jaare hobaase. ",
          "type": "text",
          "attrs": {
