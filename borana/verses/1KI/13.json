          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi dubbi taanile Yeroboamuni kara hama kaani iraa indeebine, inni qaalole fulla infakaanne ta sorio irati baasani ta inni jaare hojattu ta namuma arge inni filate taani, filachu illakimne. Inni nama qaallu taha jed'e ufi gabaase ch'ufa qaallu tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dabi Yeroboamuni tolche sunini worra isaatiifi d'aloota isaa ch'ufa balleese hobaase.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
