        "style": "s1"
      },
      "items": [
        {
          "text": "Daba hama Yeroboamuni tolche",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
