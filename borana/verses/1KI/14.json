            }
          ]
        },
        {
          "text": "Waan hayyu Rehoboamuuni tolche ch'ufa kitaaba Odu Hayyoota Yuda ch'ufa keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
