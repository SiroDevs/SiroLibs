              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara suni ch'ufa Rehoboamufi Yeroboamu woraanati jiddu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.14.30",
            "verseOrgIds": [
