              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama fiit'a tanteeti ka dira keesati duu sareeti nyaata, ammo ka alati duu allaatiti nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.24",
