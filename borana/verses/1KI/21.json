          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ch'ubbu hamtu ch'eera tolche, waan harkaani boch'ani kad'ate, akuma worri Amori, ka AABBO Waaqi worra Israeli duraa gusse, tahe.)",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.26",
