              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan raaga Eliyaani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.28",
            "verseOrgIds": [
              "1KI.21.28"
            ]
          }
