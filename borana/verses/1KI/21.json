          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nami tokoleeni ka aka Ahabu ufi baase waan hamtu AABBO Waaqa durati tolche injiru waan suni ch'ufa niiti isaa Yezebaliti isa tolchisise. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.21.25",
            "verseOrgIds": [
              "1KI.21.25"
            ]
          }
        },
        {
