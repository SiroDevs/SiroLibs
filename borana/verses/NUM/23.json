          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakini akuma tolchi jed'aniini tolche, koromi loonitifi elemiye suni, toko tokooni irati sorio baase.",
          "type": "text",
