          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakini waan jed'eeni, Na woliini kooti, fulla d'ibi si geesa. Hegeri Waaqi achiti ee jed'afa, aka atini worra falfalte naraa abaartu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.27",
            "verseOrgIds": [
              "NUM.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
