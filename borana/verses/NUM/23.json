          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Balamuni waan jed'eeni, Anini qara siti inhimne aka waan AABBO Waaqi nani jed'e ch'alla tolchu!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        }
      ]
