            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Balakini waan Balamuni jed'e, Atini ya worra Israeli abaaru didde, ammo yo sule dad'abde ini eebisinifi!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.25",
