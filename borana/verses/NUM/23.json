          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan Balakini jed'e, Fulla sorio iti qalani torba d'akhaani na mid'aasi, ammalle koromi looni torbafi elemiye torba natiini kooti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balakini waan Balamuni tolchi jed'eeni tolche, isaafi Balamuni; fulla sorio irati qalani taani torbaani irati koromi loonitifi elemiye taani, toko tokooni, sorio baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Balamuni waan Balakini jed'e, Atini arma fulla sorio gubani tana eji, duuba anini deeme, aka AABBO Waaqi nati d'ufu laale, deebie waan inni na garsiise siti hima. Duuba inni koba ufi iti d'aabate fiit'e gaara kore, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi achiti iti d'ufe. Jennaani Balamuni waan Waaqaani jed'e, Anini yayu fulla sorio irati qalani torba mid'aase, ch'ufa kormafi elemiye, toko tokooni irati baase. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Balamuni Balakini jechu male iti hime, Beeni deebii, iti himi jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni deebie Balaki, ka fulla sorio gubani taani jaarole Moabu woliini eju arge.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        }
      ]
    },
