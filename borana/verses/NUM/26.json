          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Israeli, mana worra isaani gula heda, nama d'iira ka ganna diddamati oli, ka duula d'aqu dandau ch'ufa maqa t'aafa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.2",
            "verseOrgIds": [
              "NUM.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi Eleazarini ee jed'ani, nama d'iira ka ganna suni ch'ufa wolti yaamani. Diida Moabu ka hojja arti ejani Yerikoni galaana Yordani gamaa nama dura mullatuti, wolti d'ufani. Worri Israeli ka lafa Misiri keesaa bahe kana:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.3+NUM.26.4",
            "verseOrgIds": [
              "NUM.26.3",
              "NUM.26.4"
            ]
          }
        }
      ]
