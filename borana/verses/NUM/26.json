          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami Israeli tokoleeni ka Musafi Harunini gaafa henna qara lafa aloo ta Sinai keesati hedani, inhamne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.64",
