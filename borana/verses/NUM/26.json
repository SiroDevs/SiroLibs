        },
        {
          "text": "Gaafa Musafi Eleazarini gosa Israeli ch'ufa diida Moabu ka yo arti ejani Yerikoni galaana Yordani gamaa nama duraa mullatuti hedani, balbala worraa tana ch'ufa maqa t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.26.63",
            "verseOrgIds": [
              "NUM.26.63"
            ]
          }
        },
        {
          "name": "verse",
