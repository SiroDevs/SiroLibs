          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri Israeli lafa Amori keesa qubate, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani dooya erge, ta dira Yazeri dooyate oduuni galtu. Ammalle worri Israeli dira sunifi dira d'aatu jirule had'e worra Amori ka keesa taule baase, dira suni fud'ate.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
