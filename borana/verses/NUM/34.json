          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, Waan atini worra ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.1",
            "verseOrgIds": [
              "NUM.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israelitini jettu: Hojja lafa Kanaani ta anini isanii kennu seentani, seeri lafa teesani akana taha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.2",
            "verseOrgIds": [
              "NUM.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri gama bitaa, lafa aloo ta Siniti bahe seera lafa Edomuti Eja. Gara ilaboru seeri muumme galaana Sooda ta bitaati bahe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bitaa qajeela kaarra Akrabimu keesa dabre, Sinile keesa dabre, haga Kadesh-Barneaati eja. Jennaani seeri mirga ila adu Hasar-Adariti qajeele, Azmoniti dabre, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.4",
            "verseOrgIds": [
              "NUM.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "achiti bale afaani seera Misiri deebie, Baariini Guddati muumme baha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.5",
            "verseOrgIds": [
              "NUM.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri ila adu Baariini Gudda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
