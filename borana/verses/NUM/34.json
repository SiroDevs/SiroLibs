                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Musani waan worra Israelitini jed'e, Tunini lafa isani hit'aani argattani, ta AABBO Waaqi gosa sagalifi gosa Manase ta haga gariti kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.13",
            "verseOrgIds": [
              "NUM.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gochiti Reubenitifi ta Gaditifi worra gosa Manase ka ila boru jiruleeni yayu lafa ufi argatte worra ufi gula qoodate, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "galaana Yordani ilaboru Yeriko gama.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.15",
            "verseOrgIds": [
              "NUM.34.15"
            ]
          }
        }
      ]
    },
