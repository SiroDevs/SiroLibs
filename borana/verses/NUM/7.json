        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.9",
            "verseOrgIds": [
              "NUM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gugurdaani kaanileeni wabase, guyya waan sorio irati baasani muudani eebisani. Hojja worri waan baasu suni baasiti fulla suniti kurfae, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.10",
            "verseOrgIds": [
              "NUM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, Waan worra gugurda kanani jettu, Isani namu guyya ch'ufa, haga bulti kud'ani lama, ha waan ufi ka baasuni d'ufuti, aka fulla sorio iti qalani suni eebisani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.11",
            "verseOrgIds": [
              "NUM.7.11"
            ]
          }
        }
      ]
    },
