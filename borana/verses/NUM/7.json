      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya Musani ijaarsa Waaro Woyyuma hobaase, inni Waaro sunifi miha isii ch'ufafi waan sorio irati baasanifi miha isaale ch'ufa muude eebise. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.1",
            "verseOrgIds": [
              "NUM.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri gugurdaani balbala gosa Israeliti mataa, ka qara huji henna harkaa qabu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.2",
            "verseOrgIds": [
              "NUM.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan waaqaa baasu male AABBO Waaqatini d'ufe: gaari jaafi qotiyo kud'ani lama, nami lama gaari toko, ammo nami ch'ufti qotiyo toko tokooni d'ufe. Eegi worri waan kanani d'ufe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.3",
            "verseOrgIds": [
              "NUM.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.4",
            "verseOrgIds": [
              "NUM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan worri baasu kana iraa fuud'i, huji Waaro Woyyumatiini hojad'i; worra Lawiti kenni, huji worri hojatu gula. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.5",
            "verseOrgIds": [
              "NUM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani gaarifi qotiyo worra Lawiti kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.6",
            "verseOrgIds": [
              "NUM.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni gaari lamafi qotiyo afuri worra Gershoniti kenne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.7",
            "verseOrgIds": [
              "NUM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "gaari afurifi qotiyo saddeeti worra Merariti kenne. Nami huji tana ch'ufati mataa Ithamari ilma qaallu Haruni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.8",
            "verseOrgIds": [
              "NUM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Musani gaarifi qotiyo worra Kohathiti inkennine, wonti akanatiifi mihi qulqullooni worri qorqoratu waan gurmuti baatani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.9",
            "verseOrgIds": [
              "NUM.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
