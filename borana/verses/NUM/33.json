        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 33:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli gaafa gaara Horiti kae diida Moabuti godaane, fullaani worri jiddu ququbate tana: Salmona, Punoni, Obothi, Iye-Abarimu ka lafa Moabu keesa, Dibon-Gadi, Almon-Diblathaimu, gaara Abraimu, ka d'aatu gaara Nebo ammalle diida Moabu ka yo arti ejani Yerikoni galaana Yordani gamaa nama dura mullatu, jiddu Beth-Yeshimothitifi bale Shitimu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.41+NUM.33.42+NUM.33.43+NUM.33.44+NUM.33.45+NUM.33.46+NUM.33.47+NUM.33.48+NUM.33.49",
            "verseOrgIds": [
              "NUM.33.41",
              "NUM.33.42",
              "NUM.33.43",
              "NUM.33.44",
              "NUM.33.45",
              "NUM.33.46",
              "NUM.33.47",
              "NUM.33.48",
              "NUM.33.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan ato galaana Yordani intaakini gumi Israeliti himani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
