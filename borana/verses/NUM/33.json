            "number": "50",
            "style": "v",
            "sid": "NUM 33:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa worri diida Moabu, ka yo arti ejani Yerikoni galaana Yordani gamaa nama dura mullatu jiru, AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu, Hojja isani galaana Yordani taakitani lafa Kanaani seentani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "nama lafa suni keesa jiru ch'ufa keesaa gussuu maltani. Waan worri kad'atu ka d'akhaafi Sibiilani mid'aasanifi fulla worri iti kad'atu ch'ufale balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
