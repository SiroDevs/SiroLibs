                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dubbi AABBO Waaqa gula qaallichi Harunini gaara Hori kore, ganna d'iba tokofi diddami saditi due, gaara suni irati. Gaafasi guyya tokeeso ka jia shaneeso ka ganna afurtameeso, eegi worri Israeli lafa Misiri keesaa godaane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38+NUM.33.39",
            "verseOrgIds": [
              "NUM.33.38",
              "NUM.33.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 33:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.1"
              },
              "items": [
                {
                  "text": "Hen 21.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hayyuuni Aradi, ka lafti isaa lafa Kanaanitini bitaa aka worri Israeli d'ufu d'agaye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.40",
            "verseOrgIds": [
              "NUM.33.40"
            ]
          }
        }
      ]
