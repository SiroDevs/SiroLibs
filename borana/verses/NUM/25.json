          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.16",
            "verseOrgIds": [
              "NUM.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Midiani had'i balleesi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "wonti akanatiifi worri Peoriti isani sobe isani balleese ammalle maro Kozbi ta gaafa ch'iisa Peori ijeesani jed'i had'i balleesi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.18",
            "verseOrgIds": [
              "NUM.25.18"
            ]
          }
        }
      ]
    },
    {
