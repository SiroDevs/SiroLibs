              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eegi suni worri balbala Kohathi, ka godaana miha woyyuma baatu godaana. Hojja worri fulla qutumati worra kaani d'aqabe, Waaro ya jaarani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
