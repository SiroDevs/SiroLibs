                  "text": "Far 68.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hojja Sanduqi Wold'aqisa godaana kae ch'ufa, Musani waan jed'u, AABBO Waaqa, kai: Nyaapa kanke gargari baasi, nama si jibbule ufi duraa gussi! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.35",
            "verseOrgIds": [
              "NUM.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hojja Sanduqi miilad'aabate, inni waan jed'u, AABBO Waaqa, worra Israeli ka kunkiti deebii.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.36",
