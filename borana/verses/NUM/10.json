          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni worri bandera gosa Efraimu jala jiru mana manani kae godaana, ka Elishama ilmi Amihudi gudda worraa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
