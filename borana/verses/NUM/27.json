              "items": [
                {
                  "text": "Qab-Ser 3.23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "32.48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, Beeni, gaara Abarimu kori, lafa anini worra Israeliti kennu dawaad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi agarte, atinileeni, akuma oboleesi kanke Harunini due, doota. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi isani lachu nani morkitani lafa aloo ta Sini keesati, gaafa gumiini ch'ufti Meribati nati gungumte, isani na d'aarefatani gumi ch'ufa durati na ch'eersitani (Meribani maddo Kadeshi lafa aloo ta Sini keesa.)",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
