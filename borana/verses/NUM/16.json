          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma inni dubbi hobaafateni, lafti worri ira ejaanju gadi ch'ite ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
