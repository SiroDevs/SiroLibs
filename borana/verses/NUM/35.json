                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Qab-Ser 17.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yoi nama nama ijeese ijeesani, yo nami lamafi sadi, inni ya nama ijeese jed'e hime ch'alla; himaansi nami toko, nami kunini ya nama ijeese jed'e ingahu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama harka d'iiga ijeesuu malani. Inni beese baase dua jalaa bahu indandau. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami dira iti baqataniti baqate, aka inni beese baase, ato qaallichi guddaani induini worra ufiti deebiu, ee injed'ina. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo isani akasi taatani, lafa keesa teetani t'ureesitani. D'iigi lafa t'ureesa, nama harka d'iiga fit'ani male, karaani lafa nami keesati dueni qulqulleesani injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa isani keesa teetani int'ureesina: wonti akanatiifi anini AABBO Waaqa, ka gumi Israeli jiddu keesa tau.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aala nad'eeni fuud'ani",
          "type": "text"
        }
      ]
    }
