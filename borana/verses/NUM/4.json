            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musafi Harunini jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.1",
            "verseOrgIds": [
              "NUM.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra gosa Lawi ka balbala Kohathi, manafi balbala worra gula heda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.2",
            "verseOrgIds": [
              "NUM.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "maqa nama d'iira ch'ufa, ka ganna sodomatifi shantama jiddu jiru, ka huji Waaro Woyyuma keesa hojachu dandau, t'aafa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.3",
            "verseOrgIds": [
              "NUM.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti worri hojachu male, waan waan ch'ufa ira qulqullo qorqorachu male.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.4",
            "verseOrgIds": [
              "NUM.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi ammalle dubbi tana Musani jed'e, Hojja godaanu geetani, Harunifi ilmaani isaa ha Waaro Woyyuma seenani, golla Sanduqa Wold'aqisa durati jiru iraa baasani, Sanduqani mamaraniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.5",
            "verseOrgIds": [
              "NUM.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri ha golla d'iisisani irati mamare, woya bule gubati ballise, duuba kalcho baataniini keesa naquuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.6",
            "verseOrgIds": [
              "NUM.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri ha woya bule mesa qit'a AABBO Waaqaa baasani ira kayani irati ballisuuti: ammalle mesa suni ira saanifi waan hit'aana keesati aarsanifi d'ameelafi muduunu daad'i Waaqaa baasani iti naqani ha d'ad'abaniti; ammalle qit'aani hojja ch'ufa mesa suni gubba jiraachu male. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.7",
            "verseOrgIds": [
              "NUM.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba ammalle waan kana ch'ufa ha woya diimtu irati ballisani, golla d'iisisani ira kaayani, kalcho baataniini keesa naqaniti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.8",
            "verseOrgIds": [
              "NUM.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri ha woya bule fuud'e, waan ifseeni ira ejitufi ifse isiitiifi qad'abefi saanifi waan d'ad'a iti naqani ch'ufa ira ballisuuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.9",
            "verseOrgIds": [
              "NUM.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri ha waan suni ch'ufa golla d'iisisanini mamare waan aka sire ta baataniini ira kayuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.10",
            "verseOrgIds": [
              "NUM.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle waan aka mesa, ka worqi ha woya bule iti ballise, golla d'iisisani ira kaye, kalcho baataniini keesa naquuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.11",
            "verseOrgIds": [
              "NUM.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba ammalle ha miha Fulla Qulqullo keesati hojatanini ch'ufa fuud'ani, woya buleeni mamarani, golla d'iisisani ira kayani waan aka sire ta baataniini ira kayani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.12",
            "verseOrgIds": [
              "NUM.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle ha waan mesa fakaata kaani, daara d'ad'ani iti jige, keesaa baasani, woya bule diimtu irati ballisaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.13",
            "verseOrgIds": [
              "NUM.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba miha ch'ufa, ka huji soriotini tolchani, ha gubba kayaniti: daboola ibidati, hooko, bao, qori. Duuba ha golla d'iisisani ira kayani, kalcho baataniini iti naqaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja godaanani, worri balbala Kohathi ha d'ufe, waan qulqullo kana ch'ufa baatuti, ammo haga Harunifi ilmaani isaa huji tana ch'ufa kurfeesani hobaasaniti worri inqabatini. Worri balbala Kohathi waan qulqullo kana tokole intuqini, yo tuqani induani. Hujiini worra balbala Kohathi ta hojja Waaro Woyyuma godaansisani worri hojatu suni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazarini ilmi qaallicha Haruni, hujiini isaa aka Waarofi d'ad'a ifsetifi, hit'aanafi, mid'aani Waaqaa baasanifi d'ad'a muudatiifi waan Waaro keesa jira ka huji AABBO Waaqatini hojatani ch'ufa qorqoratini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
