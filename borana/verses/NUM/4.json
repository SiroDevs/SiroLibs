            "sid": "NUM 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra gosa Lawi, ka balbala Gershoni, Manafi balbala worraa hedi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "maqa nama d'iira ch'ufa, ka ganni isaa sodomafi shantama jiddu jiru, ka huji Waaro Woyyuma keesa hojachu dandau, t'aafi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri miha kana baachu male: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waarofi golla isii ka keesatifi ka alaatifi golla d'iisisani ka gubbati ballisanifi golla balbalatifi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "gollafi haada naabo ka Waarofi waan mesa fakaata ka sorio irati baasani marsufi golla fulla balbala naaboti kayani, ammalle waan waan kana ch'ufaani wolti naqanile. Worri waan waan kana male ch'ufa tolchu male. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi Harunini ha huji worri Gershoni, hojatufi ammalle waan Harunifi ilmaani isaa baad'a jed'aniini qorqorataniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hujiini worri balbala Gershoni Waaro keesa hojatu tana: Worri ha aka Ithamarini ilmi qaallicha Haruni, tolcha jed'uuni gula tolchuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Huji worra gosa Lawi ka balbala Merari",
