                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.5",
            "verseOrgIds": [
              "NUM.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini gumi Israelitini jettu, Hojja nami tokoleeni Waaqa durati wollaala tolche, waan nama d'ibile kara hamani fud'ate, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
            "verseOrgIds": [
              "NUM.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nami sunini ha daba ufi himate, nama waan isaa duraa fud'ate suni gati baasuti, ammalle gati suni ira ha waan d'ibile d'iba keesa diddama baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hojja nami sunini nama qara due taate, ka inni nama fiit'a ka gati suni fud'atu inqamne, gati suni ha AABBO Waaqaa baasani aka qaalluuni nyaatu. Wonti baasani kunini herega elemo nama wollaala tolcheeni qulqulleesani keesa injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle wonti worri Israeli AABBO Waaqaa baasu kama qaallu itiini d'ufaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaalluuni ch'ufti ha waan itiini d'ufani fud'atuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dubbi nad'eeni d'iirsi dugeefata inqamne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.11",
            "verseOrgIds": [
              "NUM.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini gumi Israelitini jettu, Yo hegeri nami waan niitiini isaa nama d'ibi baratu sehe, ka ammo d'iirsi d'uga iti inqamne, waan niitiini isaa d'ossiteefi ka nami isi arge yokhaani irati qabe injirre; yokhaani yo hegeri fayyuma tana d'iirsi isi quufa d'abe, ka isiini jaala inqamne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.12+NUM.5.13+NUM.5.14",
            "verseOrgIds": [
              "NUM.5.12",
              "NUM.5.13",
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka ch'ufafu namichi niiti suni ha qaalluti geesuti. Ammalle inni ha garbu kilo toko ta iraa fed'ani fuud'u; ammo d'ad'a yokhaani hit'aana iti inaarsini. Wonti akanatiifi woni baasani sunini waan d'iirsi maro d'ugeefata niiti ufi d'abeefi baasu, aka d'uga diidati baasani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi ha niiti suni gayaame, fulla sorio iti baasani duraani d'ufuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha bisaani qulqullo okote faarati naqe, biyye Waaro Woyyuma keesa lafa iraa fuud'e, bisaani suniti naqe had'esuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni ha rifeensa niiti suni hiikhe, garbu d'ufaniini taani harka isiiti kennuti. Harka ufi keesa qaallichi ha okote faara ta bisaani had'ao abaarsaani d'ufaa qabdu, qabaatuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi niiti suni ha kakhu tanaani kakhachiisuti: You nami tokoleeni si imbaratini yokhaani ka atini d'iirsa kanke lakifte, inhammaatini, abaarsi bisaani kunini d'ufaniini woma si intolchu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo nami si barate, atini d'iirsa kanke lakifte nama d'ibi gula seseega deemte, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi maqa kanke ha gumi keesa abaaruti. Inni ha saaba kanke yake garaa kanke iitesuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bisaani kunini ha garaa kanke seenani, garaa kanke iitesani, saaba kanke yakaniiti. Isiini ha ee, AABBO Waaqi akasi na tolchina jettuti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi ha abaarsa kana t'aafe t'aafi suni bisaani had'ao okote taaniitini d'iquuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.23",
            "verseOrgIds": [
              "NUM.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato inni niiti bisaani had'aa qaba, ka isi d'ukubsa suni inobaamne, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.24",
            "verseOrgIds": [
              "NUM.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "qaallichi ha garbu Waaqaa baasani taani harka niiti suni iraa fuud'e, Waaqati olqabe, waan aka mesa ka sorio irati baasani kaani ira kayuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni ha garbu taani harka guutate, aka waan kana Waaqa iraa argate fulla sorio irati baasani irati gubuti. Duuba eege inni ha niiti suni bisaani obaasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja isiini hameenna suni keesa jiraate, bisaani had'aoni sunini guddo isi d'ukubsani, garaani isii iitae, saabi isii hamaata. Maqaani isiileeni gosa keesa abaarsa argata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo isiini waan suni keesa injirre, isiini woma intaatu, ijoolle akuma aada d'alti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri kana ka hojja nami niiti ufi hinaafe, waan isiini jaala qabdu sehate quufa d'abe. Niitiini ha AABBO Waaqa dura d'ufte, qaallichi aada tana guututi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.29+NUM.5.30",
            "verseOrgIds": [
              "NUM.5.29",
              "NUM.5.30"
            ]
          }
        },
        {
