              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Mala, Tirsa, Hogla, Milkafi Noani, dubriti Selofahadi, akuma AABBO Waaqi Musani jed'e tolchite, ijoolle d'iira ta oboleyaani, abba isii d'at'e fuute. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.10+NUM.36.11",
            "verseOrgIds": [
              "NUM.36.10",
              "NUM.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami isi fuud'e worra balbala gosa Manase, ka ilma Yusufu, d'aalti worraleeni gosa abba isaani keesati hafti.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.12",
            "verseOrgIds": [
              "NUM.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini seerafi aada AABBO Waaqi worra Israeliti afaani Musatiini kenneefi, diida Moabu, ka yo arti ejani Yerikoni galaana Yordani gamaa nama dura mullatu keesati.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.13",
            "verseOrgIds": [
              "NUM.36.13"
            ]
          }
        }
      ]
