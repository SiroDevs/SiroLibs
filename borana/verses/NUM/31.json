          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri abbooti duula kaani gara Musa d'aqe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 31:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'eeni, Nu worra keenna ka duula ch'ufa ya tohanne nami tokoleeni ka nu keesa d'abani injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.49",
            "verseOrgIds": [
              "NUM.31.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 31:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi nu amma faaya worqitiifi, waan irreefi harkati keeyatanifi, qube qabatifi, gurrale, yokhaani imule d'ufuniti jirra. Nu waan kana ch'ufa Lubbu teenna jenne AABBO Waaqaa baafna, aka inni nu qorqoratu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 31:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi qaallichi Eleazarini faaya worqi fud'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 31:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henni worqi ka abbootini duula baafte, ulfinni isii diquma kilo d'iba lama hanqata. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 31:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami abbaa duula intahini waan boojie fud'ate. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 31:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musafi qaallichi Eleazarini worqi suni abbooti duula iraa fuud'ani Waaro Woyyumatiini d'ufani, aka AABBO Waaqi gumi Israeli qaabate qorqoratu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.54",
            "verseOrgIds": [
              "NUM.31.54"
            ]
          }
        }
      ]
    },
