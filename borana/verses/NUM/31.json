              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodi gumitifi ka worra duula kaani haguma taka: hoolafi laleesi 337,500, looni 36,000, dubarti 16,000. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.42+NUM.31.43+NUM.31.44+NUM.31.45+NUM.31.46",
            "verseOrgIds": [
              "NUM.31.42",
              "NUM.31.43",
