    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Midiani waan worri gumi Israeli tolcheefi haalo baasiifi. Eegi halo suni baafte indoota.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani waan biyyaani jed'e, Had'iisa kurfefad'a, aka Midiani haatani waan worri AABBO Waaqa tolche haalo baaftani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gosa Israeli ch'ufa keesa nama kunki toko duula erga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba nama kunki toko gosa ch'ufa keesa fohatani, nami kunki kud'ani lama, lola kurfae. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.5",
            "verseOrgIds": [
              "NUM.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani worra kana ch'ufa had'iisa erge, ka Finehasini, ilmi qaallicha Eleazari, abba duula suni, ammalle ka inni miha Fulla Qulqullootifi magalata lola harkaa qabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani worri worra Midiani had'e, akuma AABBO Waaqi Musani jed'e, nama d'iira ch'ufa hobaasani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "hayyoota Midiani shananile woliini: maqaani hayyoota shanani suni tana: Evi, Rekemu Suri, Huri, Reba. Ammalle Balamu ilma Beorile ijeesani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli nad'eenifi ijoolle Midiani ch'ufa boojie, loonifi ree worrale ch'ufa fud'atini, waan worri qabu ch'ufa saamani, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.9",
            "verseOrgIds": [
              "NUM.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "dirafi ollowaani worra ch'ufa gubani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.10",
            "verseOrgIds": [
              "NUM.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan saamanifi ka boojiani suni ch'ufa, namafi saale, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.11",
            "verseOrgIds": [
              "NUM.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi Eleazarifi gumi Israeli, ta diida Moabu, ka hojja arti ejani Yerikoni galaana Yordani gamaa, nama dura mullatuti worra duraani d'ufani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worri duula gale",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musafi Eleazarifi jaaroleeni gosa Israeliti mataa ch'ufti worraa baate duula yoyo fulla keesa yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.13",
            "verseOrgIds": [
              "NUM.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani abbooti duula ta nama kunki tokotifi nama d'ibba tokofati mata ta duula galteti dallane, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'eeni, Isani maanifi nad'eeni taana hambiftani? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.15",
            "verseOrgIds": [
              "NUM.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.1+NUM.25.2+NUM.25.3+NUM.25.4+NUM.25.5+NUM.25.6+NUM.25.7+NUM.25.8+NUM.25.9"
              },
              "items": [
                {
                  "text": "Hen 25.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani imbeetani, aka nami dubbi Balamu gula bahe lafa Peoriti AABBO Waaqa iraa biyya gorse balleese nad'eeni? Wonti ch'iisa d'ukuba hama kaani gumi AABBO Waaqatini d'ufe suniniti? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi amma ijoolle d'iira ch'ufafi nad'eeni ch'ufa fit'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.17",
            "verseOrgIds": [
              "NUM.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo ijoolle dubra ch'ufa lakifad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani nami nama ijeese yokhaani reefa qabate, haga bulti torba worra keesa alati gala. Guyya sadeesotifi ka torbeesole nama isani boojitanifi ufile qulqulleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.19",
            "verseOrgIds": [
              "NUM.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle gaad'a nafa keesani ch'ufafi waan goga ira mid'aasanifi, waan rifeensa reetifi mukhaani mid'aasani ch'ufa qulqulleesa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi Eleazari waan jara duula galeeni jed'e, Kunini seera AABBO Waaqi Musaa kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan ibidi gubu indandeenne worqi taanaani, qarsi taanaani, sibiila diima taanaani, sibiila guraacha taanaani, saldaqa taanaani sibiila d'ibi taanaani, ibidaani qulqulleesu malani. Suni male, waan d'ibi ch'ufa ha bisaanini qulqulleesaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.22+NUM.31.23",
            "verseOrgIds": [
              "NUM.31.22",
              "NUM.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya torbeeso woya teesani miich'ad'a; duuba isani qulqulluma teesaniti deebitani ollati dachaatani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka waan boojiani qoodatani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siifi Eleazarini jaarole gumi taani woliini, waan boojiani ch'ufa, namafi saale ch'ufa, hedu maltani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.26",
            "verseOrgIds": [
              "NUM.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan boojiani ch'ufa fulla lamati gargari qooda, qooda toko jara duula d'aqe qooda, kaani gumi lakisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.27",
            "verseOrgIds": [
              "NUM.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda duula suni keesa, d'iba shani keesa toko, nama taanaani, looni taanaani, harre taanaani, hoolafi laleesa taanaani, damoosa AABBO Waaqaa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
              "NUM.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Damoosa suni ch'ufa qaallicha Eleazariti Kenna, ha inni AABBO Waaqa baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.29",
            "verseOrgIds": [
              "NUM.31.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
