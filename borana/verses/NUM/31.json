          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini henna waan worri duula suni boojie, waan worri fud'ate male: hoolafi laleesa 675,000 looni 72,000, harreeni 61,000, dubra 32,000. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32+NUM.31.33+NUM.31.34+NUM.31.35",
            "verseOrgIds": [
              "NUM.31.32",
              "NUM.31.33",
              "NUM.31.34",
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qoodi duula kennani kaani, hoolafi laleesi 337,500 tana keesa damoosi AABBO Waaqaa baasani 675; looni duulla qoodani 36,000, kana keesa damoosi AABBO Waaqaa baasani 72; harreeni duula qoodani 30,500 tana keesa damoosi AABBO Waaqaa baasani 61; ammalle dubarti worra duulati qoodani kunki kud'ani jaa tana keesa damoosi AABBO Waaqaa baasani 32. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36+NUM.31.37+NUM.31.38+NUM.31.39+NUM.31.40",
            "verseOrgIds": [
              "NUM.31.36",
              "NUM.31.37",
              "NUM.31.38",
              "NUM.31.39",
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani damoosa kana, ka AABBO Waaqaa baasani, qaallicha Eleazari kenne, akuma AABBO Waaqi Musani jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
      ]
