          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda gumi kaanile, shantama keesa toko, nama taanaani, looni taanaani, harre taanaani, hoolafi laleesa taanaani, fuud'a, worra Lawi ka huji Waaro Woyyuma harkaa qabu, kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.30",
            "verseOrgIds": [
              "NUM.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
