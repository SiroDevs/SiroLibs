                {
                  "text": "Qab-Ser 5.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waan d'ara indubbatiina, nama d'ara dubbatule d'uga intahiinaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumi waan hamtu tolchitu gula indeemina, yokhaani gumi d'ara gula yaatu gula baatani d'uga ind'ossina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.2",
            "verseOrgIds": [
              "EXO.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
