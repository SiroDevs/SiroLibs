                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo sanga yokhaani harre nyaapa keesani ta badi deemtu agartani deebisaafi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.4",
            "verseOrgIds": [
              "EXO.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo harre nyaapa keesani ta mihaani jidde agartani, olkaasu indidina, qarqaara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.5",
            "verseOrgIds": [
              "EXO.23.5"
            ]
          }
        }
