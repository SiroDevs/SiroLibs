            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Law 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nama hiyyeesale fulla qorsumati d'ara ind'ugesiina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.3",
            "verseOrgIds": [
              "EXO.23.3"
            ]
          }
        }
