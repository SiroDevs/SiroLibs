          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle aka inni d'akhaye ch'ululut'u boch'e mid'aase, mukhale boch'e waan harkaani tolchani ch'ufa tolchu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.33",
            "verseOrgIds": [
              "EXO.35.33"
            ]
          }
        },
