          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi yayu isaafi Oholiabu, ilma Ahisamaki, ka gosa Dani, qalbi biyya d'ibiini waan oguma suni barsiisani kenneefi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.34",
            "verseOrgIds": [
              "EXO.35.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 35:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle inni yayu worra qalbi waan ch'ufa ta woini tolchanifi waan boch'anifi waan barreesanifi waan woya boofta, bule taanaani, bule diimtu taanaani, yokhaani dabassa diimtule taanaani kenneefi. Worri waan gosa ch'ufa ka harkaani tolchani oguma tolchuni qaba.",
          "type": "text",
