          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musani waan worra Israelitini jed'e, AABBO Waaqi yayu Bezaleli, ilma Uri, ka ilma Huri, ka gosa Yuda, fohate ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.30",
            "verseOrgIds": [
              "EXO.35.30"
            ]
          }
        },
        {
          "name": "verse",
