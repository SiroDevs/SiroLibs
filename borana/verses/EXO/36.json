          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golla woya boofta, ka liilana bulefi bule diimafi ammalle diimani d'aahani mid'aasani, golla sunile akheekha waan lubbu qaba ka koolatiini barreesani ch'okhani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle dongora d'adacha afuri ka nafa isaa ch'ufa mullachu d'owani worqiini duuchani, hooko worqi iti mid'aasani golla kaani iti fannisani. Duuba waan afuri qarsiini mid'aasani, dongora suni jala d'ad'aabani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.36",
            "verseOrgIds": [
              "EXO.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balbala Waaro Woyyuma golla woya boofta, ka liilana bulefi bule diimafi ammalle diimani d'aahaniini ch'okhani mid'aasani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.37",
            "verseOrgIds": [
              "EXO.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dongora shani, ka hooko iti mid'aasani, golla kana mid'aasani; fiit'e isaatiifi ule ira dagalchanile nafa isii ch'ufa mullachu d'owani worqiini duuchani; ammalle waan shani ka sibiila diimani mid'aasani ka dongora jala d'ad'aabani mid'aasani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.38",
            "verseOrgIds": [
              "EXO.36.38"
            ]
          }
        }
      ]
    },
