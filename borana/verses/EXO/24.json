      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Sifi Haruni, Nadabu, Abihu ammalle jaarole Israeli nama torbatama woliini gaara gubbati nati koota; ammalle ato nara diqo fago jirtanu, gajed'a kad'ad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.1",
            "verseOrgIds": [
              "EXO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si male nami tokoleeni nati gadi ind'iaatiini, biyyitileeni gaara olinkoriini.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.2",
            "verseOrgIds": [
              "EXO.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani deebie seerafi gorsa AABBO Waaqi jed'eeni ch'ufa worrati hime. Nami ch'ufti qonqo takaani jalaa qabe waan jed'e, Waan ch'ufa ka Waaqi jed'e intolchina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.3",
            "verseOrgIds": [
              "EXO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani dubbi AABBO Waaqi jed'eeni ch'ufa t'aafe. Boriyya diirame lafaa kae gaara jalati fulla sorio Waaqa iti qalani jaare, d'akha kud'ani lama aka gosa kud'ani lama ta Israeli gula old'ad'aabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.4",
            "verseOrgIds": [
              "EXO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni nama kaima ka gosa Israeli erge, duuba worri sorio gubani baase ammalle looni qale sorio wold'ageeti AABBO Waaqaa baase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.5",
            "verseOrgIds": [
              "EXO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani d'iiga hori suni ka gari fuud'e qoriti naqe, ammalle ka hafe kaani fuud'e fulla Waaqa sorio iti qalaniti nanaqe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.6",
            "verseOrgIds": [
              "EXO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani inni kitaaba wold'aqisaa ka aada AABBO Waaqaa keesati t'aafani fuud'e qonqo olfud'ate biyyaa soome. Worri waan jed'e, Nu waan AABBO Waaqi jed'e guunne tolchina.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.7",
            "verseOrgIds": [
              "EXO.24.7"
            ]
          }
        }
      ]
    },
