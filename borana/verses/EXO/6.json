              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri hayyu Misiritiini, Gosa Israeli galakisa jed'eenileeni worruma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
