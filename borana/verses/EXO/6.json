              "EXO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunini Elisheba, ta dubra Aminadabu, ta oboleeti Nashoni, fuud'e; isiini Nadabufi Abihufi Eleazarifi Ithamari d'alteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korani ilmaani d'iira sadi d'ale: Asiri, Elkana, Abiasafu. Balbalti Kora, ta fulla saditi gargari baate, worra kana iraa baate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
