              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunifi Musani worruma AABBO Waaqi worra Israeliti erge, Beena, lafa Misiri keesaa worra Israeli baasa jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
