          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazarini, ka ilma Haruni, dubra Putieli fuud'e, isiileeni Finehasi d'alteefi. Worri kunini nama gosa Lawi ch'ufafi balbala gosa sunile ch'ufa iti angafa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
