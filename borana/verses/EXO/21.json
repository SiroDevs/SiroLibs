          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo inni tissiti isaa yokhaani tissicha isaa d'ae ilkaani buqise, ha ilkaani inni buqise suni jed'e tisse suni gad'iisu.",
          "type": "text",
          "attrs": {
