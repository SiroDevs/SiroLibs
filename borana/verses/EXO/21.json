        {
          "text": "Ammo yo ijeechaani danu taate, ha lafa anini fohufiti baqatu, duuba achiti imbaha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
