              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri atini worra Israeliti himtu kana: ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.1",
            "verseOrgIds": [
              "EXO.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.39+LEV.25.40+LEV.25.41+LEV.25.42+LEV.25.43+LEV.25.44+LEV.25.45+LEV.25.46"
              },
              "items": [
                {
                  "text": "Law 25.39-46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo isani nama Ebrania bitattani tisse tolfattani, inni ha haga ganna jaa tisse isanii tahu; ammo ganna torbeeso gad'iisa, inni ka waan tokole imbaamne ha isani biraa deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.2",
            "verseOrgIds": [
              "EXO.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo inni gaafa d'ufe niiti male d'ufe, gaafa deemule ha niiti male deemu, ammo yo inni niitiini d'ufe, gaafa deemu ha niiti isaa fud'ate deemuuni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.3",
            "verseOrgIds": [
              "EXO.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami inni hojatufi nad'eeni fuusise, niitiini suni ilmaani d'alteefile, nad'eenifi ijoolleeni ta abba fuusise suni; tanaafi tissichi suni ha kobuma deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.4",
            "verseOrgIds": [
              "EXO.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo tissichi, Abba kiyyafi niiti tiyyafi ijoolle tiyya injaalad'a biraa deemu imfed'u jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.5",
            "verseOrgIds": [
              "EXO.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "abbaani isaa ha fuud'e fulla Waaqa iti kad'atani geese, mikhikila balbalati hirkachiise gurra isaa toko uru, aka inni haga jiru ch'ufa tisse isaa tahu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.6",
            "verseOrgIds": [
              "EXO.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami intala isaa aka tisse gurgure, isi aka tisse d'iira gad'iisu himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.7",
            "verseOrgIds": [
              "EXO.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami isi bite suni qara fuud'u fed'e ammo eege isi jibbe, nami suni ha abba isi d'aleti gurguru; nami suni isii dandae nama gosa d'ibiti ingurguru, wonti akanatiifi inni ya qara waan hamtu isi tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.8",
            "verseOrgIds": [
              "EXO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami tisse uwa bitate ilma ufii fuusise, ha akuma intala ufi d'ale tolfatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.9",
            "verseOrgIds": [
              "EXO.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami nad'eeni lameeso fuud'ele, niitiini qara ha waan ch'ufa, sagaleefi gaad'ale, akuma duri argattu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.10",
            "verseOrgIds": [
              "EXO.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo inni waan kana intolchiinifi inni ka worra isii woma iraa imfud'anne gad'iisuti.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.11",
            "verseOrgIds": [
              "EXO.21.11"
            ]
          }
        }
      ]
    },
