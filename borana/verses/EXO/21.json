          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo tisseeni suni guyya toko lamati induiini, abba suni woma intolchani; wonti akanatiifi tisseeni suni hori isaati.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.21",
            "verseOrgIds": [
              "EXO.21.21"
            ]
          }
        }
