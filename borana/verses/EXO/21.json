          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami tissiti isaa yokhaani tissicha isaa d'ae ila basse, nami suni ila inni basse suni jed'e ha tisse suni gad'iisu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
