          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dallansuuni beekhaa nama ijeese, ha isale ijeesani, ato inni fulla sorio iti na baasanile d'eete.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
