        {
          "text": "Yo nami tissicha yokhaani tissiti isaa uleeni d'aane ijeese isale ha wo tolchani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
          }
        },
        {
