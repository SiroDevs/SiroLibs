              "EXO.16.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Ebr 9.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri Israeli sagale suniini Manna jed'eeni. Sagaleeni suni adaadi aka misinga, ta aka keki dammaani d'aabani miooftu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waan jed'e, Seeri AABBO Waaqi jed'e kana: dadu toko safara, jabeesa olkaya, aka ilmaani teesanileeni haga jirtu sagale anini lafa alooti isani nyaachise gartu, gaafa anini lafa Misiri keesaa isani baase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.4"
              },
              "items": [
                {
                  "text": "Ebr 9.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Musani waan Harunini jed'e, Eele faara fuud'i, sagale Manna jed'ani t'aasa lama dadu tokoti naqi, fuula AABBO Waaqa dura kayi, aka ilmaani teenna taka tana argitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma AABBO Waaqi Musani jed'e Harunini fuud'e Sanduqa Wold'aqisa dura kaye, aka isiini haguma jirtu artuma teetu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.34",
            "verseOrgIds": [
              "EXO.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.12"
              },
              "items": [
                {
                  "text": "Yos 5.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba worri Israeli ganna afurtama haga lafa Kanaani ta iti godaanani ingahiini sagale Manna jed'ani suni nyaatani. Worri sagale Manna jed'ani suni haga lafa Kanaaniti bahaniti nyaate. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Bara suni waan bitatani keesa henni t'aasa diddama d'ebbe toko.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.36",
            "verseOrgIds": [
              "EXO.16.36"
            ]
          }
        }
      ]
    },
