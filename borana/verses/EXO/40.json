    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO waaqi waan musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.1",
            "verseOrgIds": [
              "EXO.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya qara ka jia qara waaro woyyuma ta AABBO Waaqaa old'aabi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.2",
            "verseOrgIds": [
              "EXO.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi keesa sanduqa Wold'aqisa, ka Seeri Kud'annaani kaani keesa jiru, kayi. Sanduqa suni durati golla hid'i. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.3",
            "verseOrgIds": [
              "EXO.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mesaani kooti, miha ch'ufa ira naqi, ammalle waan ifse ira d'aabanileeni kooti, ifse ira d'aabi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan mesa fakaata ka worqi, ka hit'aani irati aarsani, Sanduqa Wold'aqisa dura kayi, ammalle golla balbala Waaroti fannisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaro dura waan mesa fakaata ka sorio irati baasani kayi, aka sorio irati gubani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qori guddo bisaani iti d'iqatani Waarofi waan aka mesa ka sorio irati baasani kaani jiddu d'aabi bisaanini guuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
              "EXO.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naabo jaari, golla balbala iti mid'aasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.8",
            "verseOrgIds": [
              "EXO.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Waarofi miha isiile eebisi, d'ad'a qulqullooni muudi, aka isiini qulqullo taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle waan aka mesa ka sorio irati baasanifi miha isaa muudi eebisi, aka inni qulqullo tahu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.10",
            "verseOrgIds": [
              "EXO.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle akasuma qori bisaani iti d'iqatanifi waan isiini ira ejitule kara suniini eebisi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.11",
            "verseOrgIds": [
              "EXO.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harunifi ilmaani isaale fulla balbala Waaro Woyyumatiini kooti bisaani d'iqi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haruni woya qaallu iti kayi muudi, akaani isa eebisi, aka inni qaallu tahe naa hojatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani isaaleeni kooti, ubaara iti naqi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba akuma abba muudde worrale muudi, aka worri qaallu tahe naa hojatu. Muuditiini tunini worraafi d'aloota worrale ch'ufa qaalole tolchiti, haga jiru jireenna.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waan AABBO Waaqi jed'eeni kaani ch'ufa tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri guyya qara, ka jia qara, ganna lameeso ka worri lafa Misiri keesaa bahe keesa, Waaro Woyyuma ta AABBO Waaqaa old'aabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.17",
            "verseOrgIds": [
              "EXO.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani waaro old'aabe, waan utuba ira d'ad'aabani jala naqe, utuba isii d'ad'aabe, mukha ira dadagalche dangora old'ad'aabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.18",
            "verseOrgIds": [
              "EXO.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni golla Waaro Woyyumati ballise, golla d'ibi alaani iti golle, akuma AABBO Waaqi, Tolchi jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.19",
            "verseOrgIds": [
              "EXO.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni d'akha hahafalicha kaani lamaani fuud'e, sanduqa Wold'aqisa keesa kaye. Kalcho qube Sanduqa keesa kaye. Kalcho qube Sanduqa keesa naqe Sunduqa suni qadaade. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.20",
            "verseOrgIds": [
              "EXO.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Sanduqa Waaro keesa kaye, golla Waaro gargari qoodu kaani fafannisa, akuma AABBO Waaqi isaani jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.21",
            "verseOrgIds": [
              "EXO.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni mesa gama mirga gollaani ala Waaro keesa kaye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
              "EXO.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba qit'a AABBO Waaqaa baasani gubba kaye, akuma AABBO Waaqi jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.23",
            "verseOrgIds": [
              "EXO.40.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle waan ifseeni ira ejitu Waaro keesa gama bitaa, mesaani gama, kaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.24",
            "verseOrgIds": [
              "EXO.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Artiti AABBO Waaqa durati ifse bobeese, akuma AABBO Waaqi jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.25",
            "verseOrgIds": [
              "EXO.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan mesa fakaata, ka worqiini mid'aasani, Waaro keesa golla dura d'aabe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuma AABBO Waaqi jed'eeni, hit'aana urgaale aarse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.27",
            "verseOrgIds": [
              "EXO.40.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Golla balbala Waaroti fannise, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.28",
            "verseOrgIds": [
              "EXO.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "artiti, golla suni dura, waan aka mesa jira, ka sorio irati baasani kaani kaye, irati sorio gubanifu ta mid'aani baase, akuma AABBO Waaqi jed'eeni kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.29",
            "verseOrgIds": [
              "EXO.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qori bisaani iti d'iqatani taani bisaani guute, jiddu Waarotiifi ta waan mesa fakaata kaani d'aabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.30",
            "verseOrgIds": [
              "EXO.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa, Haruni, ilmaani isaati, harkaafi miila artiti d'iqatani, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.31",
            "verseOrgIds": [
              "EXO.40.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 40:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "hojja Waaro Woyyuma olseenani, yokhaani waan mesa fakaata bira d'ufani, akuma AABBO Waaqi isaani jed'eeni kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.32",
            "verseOrgIds": [
              "EXO.40.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani Waarofi waan mesa fakaata kaani naaboni marse jaare, balbala naabo suni golla iti fannise. Akanaani huji isaa hobaasa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
