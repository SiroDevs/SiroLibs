        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.33",
            "verseOrgIds": [
              "EXO.40.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 40:34"
          },
