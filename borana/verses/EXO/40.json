          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani Waaro seenu dad'abe; wonti akanatiifi dumansi Waaro d'osse, ammalle guddinni AABBO Waaqaa waaro guute. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.35",
            "verseOrgIds": [
