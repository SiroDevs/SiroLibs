          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo haga dumansi Waaro suni ira tau worri ingodaanu, haga inni iraa galuti. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.37",
            "verseOrgIds": [
              "EXO.40.37"
            ]
          }
        },
        {
