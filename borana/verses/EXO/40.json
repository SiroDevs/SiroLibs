              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba dumansi Waaro d'osse, guddinni AABBO Waaqaa isi guute. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.34",
            "verseOrgIds": [
              "EXO.40.34"
            ]
          }
