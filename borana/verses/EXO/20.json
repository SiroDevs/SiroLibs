            }
          ]
        },
        {
          "text": "Duuba nami ch'ufti mandisufi angaasufi qonqo magalatatiifi aara gaara keesaa kau arginaani sodaate hollate, gaara ira fago ejaanjani ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
