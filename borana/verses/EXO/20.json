          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan Musani jed'ani, Atini nuuni dubbad'i, nu si ch'aqamna, ammo Waaqi ch'allaani nuuni indubbatiini; yo inni nuuni dubbate nu inhobaana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
