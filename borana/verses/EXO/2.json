              "EXO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.24"
              },
              "items": [
                {
                  "text": "Ebr 11.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musani guddate jennaani guyya toko gara gosa isaa d'aqe, aka worra gaargalchani hubate; ammalle namicha gosa Misiri toko ka tae nama gosa isaa ka Ebrania d'aanu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.11",
            "verseOrgIds": [
              "EXO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani mirga bitaa millate, namu ufi bira d'amnaani namicha gosa Misiri kaani ijeese maansa keesati awaale. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.12",
            "verseOrgIds": [
              "EXO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyya achiti deebie worra Ebrania lama ka woli diduu jiru arge namicha fulla injirreeni waan jed'e, Maafi oboleesa kanke d'aanta?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.13",
            "verseOrgIds": [
              "EXO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi waan jed'eeni, Eentu hayyufi jaallaba keenna si tolche? Akuma kale namicha Misiri suni ijeefte nale ijeesu feeta? Jennaani Musani sodaate waan ufiini jed'e, Ada woni anini tolche ya beekhamte! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.14",
            "verseOrgIds": [
              "EXO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Huji 7.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.27"
              },
              "items": [
                {
                  "text": "Ebr 11.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Faraoni waan kana d'agaye jennaani Musa ijeesu fed'e. Ammo Musani Farao duraa baqate lafa Midiani d'ufe, fulla eela tokotini bahe arti tae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.15",
            "verseOrgIds": [
              "EXO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani dubarti qaallu Midiani torba eela suni d'ufte bisaani keesa toote naanigati nat'e ree obaafte. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo tissituuni d'ibiini d'ufte dubra taani eela iraa gussite jennaani, Musani kae dubra suni qarqaare ree bisaani obaaseefi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini worrati gallaani abbaani isii Reueliini waan jed'eeni, Arra eesa akana yoosu hure galtani?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan jetteeni, Namicha Misiri tokoti harka tissitu keesa nu baase bisaani nu woraabe ree nuu obaase. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.19",
            "verseOrgIds": [
              "EXO.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan dubra ufiitini jed'e, Me namichi? Maafi namicha lakiftani? Beena, yaama, ha nu woliini gololfatu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.20",
            "verseOrgIds": [
              "EXO.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Musani worra namicha suni gale jennaani jaarsi suni intala isaa ta Zipora jed'ani Musaa kenne, inni isi fuud'e. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
            "verseOrgIds": [
              "EXO.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
