              "items": [
                {
                  "text": "Ebr 8.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waan kana ch'ufa akheekha gaara gubbaa anini si garsiise iraa ingorini, gula mid'aasi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
            "verseOrgIds": [
              "EXO.25.40"
            ]
          }
        }
      ]
    },
