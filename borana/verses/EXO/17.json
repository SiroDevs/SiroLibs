            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Qab-Ser 25.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Musani jed'e, Waan woraani kana ch'ufa aka indeenne kitaaba keesa t'aafi Yoshuati soomi: anini gosa Amaleki ch'ufa imfit'a, aka iti deebiani maqa worraa lafa tana irati inqaabanne. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani fulla sorio iti qalani Waaqaa jaare maqa Yehova-Nisi baaseefi. Yehova-Nisi jechuuni AABBO Waaqi bandera kiyya jechu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.15",
            "verseOrgIds": [
              "EXO.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle Musani waan jed'e, AABBO Waaqi ya kakhate, aka d'aloota Amaleki akuma inni woli gula d'alatuni ch'ufa woraana iti buusu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.16",
            "verseOrgIds": [
              "EXO.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yethrooni Musa argu d'aqe",
          "type": "text"
        }
      ]
    }
  ],
