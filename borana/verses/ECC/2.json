              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.25"
              },
              "items": [
                {
                  "text": "1 Od-dur 29.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akanaani anini jabaad'e nama Yerusalemu keesati d'alate ch'ufa bira dabre, ammalle beekhi kiyya taka na iwollaachimne. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan fed'u ch'ufa inargad'e, waan ilti tiyya d'araatufi ch'ufa inquubse, gammachu tokole ufi ind'owarre, wonti anini hojad'e ch'ufti na gammachiifti. Wonti anini argad'e kunini ch'ufti galata huji tiyya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani eegi suni huji tiyya aka isiiti d'ibame hojad'e herege, ammalle aka wonti suni tokoleeni woma keesa injirre hubad'e. Fakeenna, isiini akuma qilleensa gussani jirti — woma keesa injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qarale hayyuuni woma hayyuuni d'ibiini qara tolche male dandae waan d'ibi intolchu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini eegi suni waan qaroomafi maraatufi daallumti qabdu herege. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, anini imbeekha, qaroomi daalluma ira dansa, akuma ifsaani dukana ira dansaa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami qarooni gara deemu beekha, ammo daalleeni imbeekhu. Yo akasile taate, anini imbeekha, aka nama ch'ufa dooti eegattu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini herege waan ufiini jed'e, Yo wonti daalle qabata nale qabatu qaroomi kiyya maani na baha ree? Woma tokole na imbahu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama qaro inqaabatani, daallele inqaabatani. Takaa tana nama ch'ufa inded'ani. Nami ch'ufti akuma takaa dua, qaroofi daallele inqabdu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi anini jireenna jibbe; wonti akanatiifi gaargala male woma ira ingargatani. Jireenni woma keesa injiru, seeruma nama qilleensa gussuuti.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan huji hojad'eefi ch'ufa ya gaabe; wonti akanatiifi anini imbeekha, namuma d'ibi eege tiyya d'ufuti lakisa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eentu beekha — inni qaro taanaani yokhaani daalle taanaani? Ammo ha taatuti, waan anini hojad'eefi ka qaroomi kiyya lafa tana irati naa kenne ch'ufti isumaa hafti. Tokoleeni woma imbaatu. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi huji hojad'e suni ch'ufa gaabe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami qaroomafi beekhumafi oguma ufitiini hojate, duuba eege nama waan suni inhojatiiniti lakisa. Aki kunini woma imbahu, ammalle daba! ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hojate jireenna ufi keesa heregaani deeme maani iraa argata? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Ayu 5.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.14.1"
              },
              "items": [
                {
                  "text": "14.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nami haga jiru ch'ufa heregafi gaargala qaba. Halkanile qalbiini isaa imbultu; tuleeni woma imbaatu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
      ]
    },
