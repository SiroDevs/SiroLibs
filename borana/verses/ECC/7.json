            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Miira guddad'i; haalo wolfuud'itiini daalluma.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.9",
            "verseOrgIds": [
              "ECC.7.9"
