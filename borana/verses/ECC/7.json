              "type": "text"
            }
          ]
        },
        {
          "text": " Gurri dansaani waan horatani ch'ufa ira jira; guyyaani dua ka d'aloota ira jira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.7.1",
