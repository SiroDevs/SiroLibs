          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.1.17+2PE.1.18"
              },
              "items": [
                {
                  "text": "2 Pet 1.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eegi guyya jaa Yesoni Petrofi Yohanafi oboleesa isaa Yakobo yaame, gaara d'eera toko koba korsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.1",
            "verseOrgIds": [
              "MAT.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra durati jijirame, fuuli isaa aka adu ifse, woyaani isaa aka ifsa adaatte. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.2",
            "verseOrgIds": [
              "MAT.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musafi Eliyaani worrati mullatani Yeso woliini hasaani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.3",
            "verseOrgIds": [
              "MAT.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petroni waan Yesoni jed'e, Aabbo guddo dansa aki nu arma jiru. Yo atini feete, hoosa sadi armati jaara; toko keeti tokoleeni ka Musati kaleeni ka Eliyati. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.4",
            "verseOrgIds": [
              "MAT.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.2"
              },
              "items": [
                {
                  "text": "Uum 22.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.15"
              },
              "items": [
                {
                  "text": "Qab-Ser 18.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Far 2.7",
