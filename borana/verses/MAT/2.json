              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Herodeni aka jari ilaboru d'ufe kaani isa sobe arginaani guddo dalane, nama erge ijoolle d'iira ta Bethlehemu keesa jirtuufi ta reera suni keesaa, ta ganna lama asi fit'a jed'e, aka ganna jara mirga d'ufe iraa hubate gula.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.16",
            "verseOrgIds": [
              "MAT.2.16"
            ]
          }
        }
      ]
    },
    {
