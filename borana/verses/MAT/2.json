                  "text": "Hos 11.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Wonti kunini aka dubbini Aabbooni afaani raagatiini duri fage, ta anini lafa Misiri keesa yayu ilma kiyya yaame jettu guutamtufi taate.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.15",
            "verseOrgIds": [
              "MAT.2.15"
            ]
          }
        }
      ]
