          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yusufuni aka Arkeloni fulla abba ufi Herode lafa Yudea fidu d'ageennaani achi d'aqu sodaate. Oobjuuni iti himnaani gara lafa Galilaya gore, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.2.22",
            "verseOrgIds": [
              "MAT.2.22"
            ]
          }
        },
