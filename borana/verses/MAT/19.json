              "items": [
                {
                  "text": "Luk 13.30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo nami hedduuni ka amma qara ka eege taha, ka amma eege ka qara taha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
            ]
          }
        }
      ]
