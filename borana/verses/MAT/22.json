  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "MAT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni ammalle mammaasaani biyyati dubbate waan jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.1",
            "verseOrgIds": [
              "MAT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finni gubba hayyu ilma ufi dubra fuusise, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.2",
            "verseOrgIds": [
              "MAT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "tissele keessuma yaamtu erge, ammo keessumaani d'ufu didde fakaata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.3",
            "verseOrgIds": [
              "MAT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi hayyuuni kaani tissele d'ibi erge waan jed'eeni, Amma mirgoolefi jiboota tiyya yayu qalani, wonti ch'ufti ya kurfoofte, keessumaani jila fuud'a, Koota jed'aani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.4",
            "verseOrgIds": [
              "MAT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo keessumaani ch'ufti jalaa didde; toko oobru ufi d'aqe, tokoleeni daldala ufi d'aqe; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.5",
            "verseOrgIds": [
              "MAT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ta gari tissele guurte d'aante fitt'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.6",
            "verseOrgIds": [
              "MAT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni guddo dalane, askarti ufi erge, worra nama ijeese suni ch'ufa fit'e dira worrale gube. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.7",
            "verseOrgIds": [
              "MAT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani tissele ufi gadi yaame waan jed'eeni, Jilti tiyya kurfo jirti, ammo worri anini yaame jilaa himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.8",
            "verseOrgIds": [
              "MAT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kara dira gula yaa, namuma gartani yaama. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.9",
            "verseOrgIds": [
              "MAT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tisseleeni kara gula yaate nama agarte ch'ufa dansaafi hamale yaamte, nami mana fuud'aa guute.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.10",
            "verseOrgIds": [
              "MAT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyuuni mana fuud'aa olseene keessuma ilaale; nama toko ka woya fuud'a ufira inqamne arge, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.11",
            "verseOrgIds": [
              "MAT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'eeni, Isii, abbo, atini akami woya fuud'a male arma seente? Ammo namichi kaani waan jed'u d'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.12",
            "verseOrgIds": [
              "MAT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.30"
              },
              "items": [
                {
                  "text": "25.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.28"
              },
              "items": [
                {
                  "text": "Luk 13.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba hayyuuni waan tisseleeni jed'e, Harkafi miila wolti hid'a, alati baasa, ha achiti bohe ilkaani qaru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.13",
            "verseOrgIds": [
              "MAT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi nami yaamani heddu, ammo ka fohatani diqa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan gaafi gibira baasani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.14",
            "verseOrgIds": [
              "MAT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farisayooni yaate aka Yeso afaani fuutu wolmariatte. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.15",
            "verseOrgIds": [
              "MAT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jara worraatiifi jara Herode woliini Yesoti ergani waan jed'ani, Aabbo, nu imbeenna aka atini nama d'uga, atini waan Waaqi nama ira fed'u akuma d'uga barsiifta; waan nami jed'ule iyaaltu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.16",
            "verseOrgIds": [
              "MAT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Me, herega kanke nuti himi. Aki gibira hayyu Rumiti baasani fullaa mo fullaaniti? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.17",
            "verseOrgIds": [
              "MAT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesoni ch'ubbu worra beennaani waan jed'e, Isani kiyyibdoole! Maanifu afaani na fuud'u feetani? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.18",
            "verseOrgIds": [
              "MAT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilingi toko na agarsiisa jed'e. Worri shilingi toko agarsiise ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.19",
            "verseOrgIds": [
              "MAT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "jennaani inni waan jed'e, Matafi maqa eennu irati t'aafani? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.20",
            "verseOrgIds": [
              "MAT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka hayyu Kaisari jed'ani. Jennaani Yesoni waan jed'eeni, Yoosi hayyu waan isaa male baasa, Waaqale waan maleefi baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.21",
            "verseOrgIds": [
              "MAT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana d'ageennaani mamani, biraa yaani iti d'aabatani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan gaafi kaisa hegeri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
