                "loc": "LUK.17.3"
              },
              "items": [
                {
                  "text": "Luk 17.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo oboleesi kanke siti dabe, kobati yaami gorsi. Yo inni dubbi tante d'agaye, atini ya oboleesa keti waan guddo taate. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.15",
            "verseOrgIds": [
              "MAT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Qab-Ser 19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo yo inni si d'agayu d'ibaate, nama toko lama yaami, aka dubbini ch'ufti d'uga nama lama sadiini taatu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.16",
            "verseOrgIds": [
              "MAT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo inni dubbi worra d'agayu d'ibaate gumiti himi; ammalle yo inni gumi Waaqa ch'aqasu dide, nyaapafi aka nama damoosa guuruti heregi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.17",
            "verseOrgIds": [
              "MAT.18.17"
            ]
          }
        }
      ]
    },
