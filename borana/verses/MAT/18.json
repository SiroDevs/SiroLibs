              "items": [
                {
                  "text": "Yoh 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilaala, waan anini isaniini jed'u, Waan isani lafa tana keesati diddani, gubbaleti ya didani; ammalle waan isani lafati ee jettani gubbaleti ya ee jed'ani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.18",
            "verseOrgIds": [
              "MAT.18.18"
            ]
          }
        }
