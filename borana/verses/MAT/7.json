          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba, nami dubbi tiyya tana d'agaye guutu nama qalbi qabu fakaata, ka d'akha gubbati mana ijaare. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokeeni roobe, guddo lolaase, bubbeeni bubbifte mana suni d'oofte. Ammo mani jigu dide, maro yayabi d'akha gubba jiruufi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dubbi tiyya tana d'agaye inguunne nama daalle ka mana maansa irati ijaare fakaata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.26",
            "verseOrgIds": [
              "MAT.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokeeni roobe, guddo lolaase, bubbeeni bubbifte mana kaani d'oofte, mani jige. Jigisi mana suni waan gudda!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.27",
            "verseOrgIds": [
              "MAT.7.27"
            ]
          }
        }
      ]
