              "items": [
                {
                  "text": "Luk 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani bofafi ilmaani bofaati! Murisa hegeri dandeetani duraa imbaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi waan anini isaniti himu: Anini raagootafi worra qalbi qabuufi qaaloota isani erga; ka gari fitt'ani, ka gari mukhati fanniftani, ka gari Maneeni Waaqa iti kad'atani keesati lichooni d'aantani, dira ch'ufa keesaa haatani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
