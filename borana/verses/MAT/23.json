              "items": [
                {
                  "text": "Huji 23.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaargala keesani, jara Seera beekhufi Farisayo! Kiyyibdoole! Isani aka awaala gubbaa adeesani jirtani, ka alaani guddo mid'aagu, ammo keesi lafefi waan shame qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akasuma alaani isani dansaa fakaattani, ammo garaani keesani d'arafi daba qaba.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni d'aanicha worraa hima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
