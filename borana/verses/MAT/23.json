              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
