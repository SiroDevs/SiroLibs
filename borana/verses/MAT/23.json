                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.26"
              },
              "items": [
                {
                  "text": "Luk 22.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami isani ch'ufa ira gudda ha hojattu teesani tahu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.14.11"
              },
              "items": [
                {
                  "text": "Luk 14.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.14"
              },
              "items": [
                {
                  "text": "18.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nama ufi guddisu indiqeesani, ammo nama ufi diqeesu inguddisani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesoni kiyyiba worraa hima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.12",
            "verseOrgIds": [
              "MAT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani jara Seera beekhufi Farisayo! Kiyyibdoole! Isani Finna gubba nama duraa ch'uftani, ammo ufile inseentani, yokhaani worra seennu fed'ule d'owartani. [ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.13",
            "verseOrgIds": [
              "MAT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani, isani jara Seera beekhufi Farisayo! Kiyyibdoole! Isani nad'eeni d'iirsi iraa due dabsitani, waan worra hattani, kad'acha teesani kiyyibafi d'eersetani. Maro waan kanatifi nama ch'ufa ira gaargaltani.]",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani, jara Seera beekhufi Farisayo! Kiyyibdoole! Galaana taakitani, lafa fago yaatani, aka nama toko aada teesani barsiiftani; yo inni barate, maro lama haga keesanile ira ibidaa male!",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.15",
            "verseOrgIds": [
              "MAT.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani, balloota nama dura yaatu! Yo nami Mana Waaqatiini kakhate womaniti jettani barsiiftani; ammo yo inni worqi Mana Waaqa keesa jirtuuni kakhate akasi woi jettani barsiiftani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaani daalle ila inqamne! Worqi mo Mana Waaqaati ira jira, ka worqi qulqulleesu? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle yo nami waan sorio irati qalanini kakhate, womaniti jettani barsiiftani, ammo yo inni sorio waan sorio irati qalani gubba teetuni kakhate woi jettani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani guddo balla! Sorio mo waan sorio irati qalani ka sorio qulqulleesuti ira jaba? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi yo nami waan sorio irati qalanini kakhate, inni waan sorio irati qalaniifi waan gubba jiru ch'ufaani kakhata; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "akasuma yo nami Mana Waaqatiini kakhate, isaafi Waaqa achi tauleeni kakhata; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.1"
              },
              "items": [
                {
                  "text": "Isa 66.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.34"
              },
              "items": [
                {
                  "text": "Mat 5.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "ammalle yo nami gubbaani kakhate inni barch'uma Waaqatiifi nama ira tauleeni kakhata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.22",
            "verseOrgIds": [
              "MAT.23.22"
            ]
          }
        }
      ]
    },
