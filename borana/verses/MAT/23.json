              "MAT.23.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30"
              },
              "items": [
                {
                  "text": "Law 27.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani, jara Seera beekhufi Farisayo. Kiyyibdoole! Qooda kud'anneeso ka gurbi urgotiifi waan d'ibi ka sagaleeni urgesanile Waaqa baaftani, ammo barsiisa isa jajabdu ta Seera diddani, ta aka nagayafi nasufi d'ugaa. Waan kana guutu maltani, ato seera d'ibile indinne. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balloota, nama dura yaatu! Tiite aanani keesaa fud'attani, ammo gaala liqimsitani!",
          "type": "text",
          "attrs": {
