            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "D'iigi worra woma iyakini ch'ufti mata keesani gubba jira, d'iiga Habiliti haga d'iiga Zekaria ilma Barakia, ka isani Mana Waaqatiifi waan sorio irati baasani jiddu lamanti ijeeftani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini isaniti hima, wonti kunini ch'ufti mata d'aloota kana gubba buuti.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        }
      ]
    },
