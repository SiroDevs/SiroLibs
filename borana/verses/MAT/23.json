              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaargala keesani, jara Seera beekhufi Farisayo! Kiyyibdoole! Qorifi mudunu ala d'it'ani, ammo keesa isii hannafi ufi jaalachaani guutani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farisayo balloota! Waan mudunu keesa jira d'iqi, duuba alileeni inqulqullaa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.26",
            "verseOrgIds": [
              "MAT.23.26"
            ]
          }
        }
