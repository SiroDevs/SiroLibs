              "items": [
                {
                  "text": "Luk 10.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani Yesoni waan jara isatiini jed'e, Mid'aani murani guddo, ammo nami mid'aani muru diqa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
