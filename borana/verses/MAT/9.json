          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi abba mid'aani suni kad'ad'a aka inni nama mid'aani muru oobruti ergu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.38",
