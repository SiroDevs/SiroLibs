                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo Farisayooni waan jette, Inni jabeenna gudda jinnitiini jinni baasa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
