                  "text": "Mul 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "jennaani anini artiti ifsa bibiliqu, ka aka AABBO Waaqi Israeli arti jiru garsiisu, ka ilaboruti gad'ufu, arge. Qonqooni Waaqaa aka d'awa baariini dibbifte laftileeni ifsa bibiliqu kaaniini guyyaate. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daayyani tunini daayya anini gaafa Waaqi Yerusalemu balleesu d'ufefi ammalle ta anini d'aatu galaana Kebariti arge taani fakaati. Jennaani anini isa durati lafa d'ae. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifsaani bibiliqu kaani balbala ilaborutini oliseene, Mana Waaqati dabre.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani lubbuuni AABBO Waaqa oli na fuute, naabo garaa keesatini na d'ufte, anini artiti, aka Mani Waaqa guddinna AABBO Waaqatini guutame arge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namichi kaani artuma d'aatu tiyya eje, jennaani anini AABBO Waaqa, ka Mana Waaqa keesaa naani dubbatu, d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan nani jed'e, Namicha, fullaani anini barch'uma kiyya ka guddinna ira tau tana. Anini arma worra Israeli keesa tae worra fida. Worra Israelitiifi hayyooti worraleeni deebite waaqa d'ibi kad'atte, yokhaani reefa hayyoota worraa fulla tanati awaalte maqa kiyya qulqullo int'ureesitu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyooti mana ufi mikhikilafi siddo iti mid'aasite balbala keesa keete d'aatu mikhikila balbala mana kiyya jaarte. Aka duuba akanaani girgidaani ch'allaani nu jiddu jiru. Worri waan hamtu ch'ufa tolche, akasiini maqa kiyya qulqullo t'ureese. Jennaani anini dallansu keesa worra balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma tana worri Waaqa d'ibi kad'achu lakise reefa hayyoota guuru male. Yo worri waan suni tolche, anini haga jiru jireenna jiddu worra taa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle AABBO Waaqi waan jed'e, Namicha, waan Mana Waaqa kana worra Israeliti haasai, worri ha ijaarsa isaa kana aka dansaa ilaale hubatuti, akasiini ch'ubbu ufi arge ch'eeruti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba yo worri waan suni arge ch'eere, aka Mana Waaqa kana jaaru malani worra garsiisi — aka inni jiraachu male, balbalafi d'aaba isatifi aka nafi isaa ch'ufti jiruufi aadaafi seera isaale ch'ufa. Waan akana ch'ufa worraa t'aafi, aka worri aka waan ch'ufa mid'aasu malani arge, aadaafi seera isaa ch'ufa guutu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seeri Mana Waaqa kana: Mana suni, ka fiit'e gaara jiru, qayeeni isaa, haguma geetuuni, qulqullo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan sorio irati baasani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Bah 27.1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2 Od-dur 4.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Waan sorio irati baasani, ka mesa fakaata, d'und'umuma Mana Waaqatini biimanini biimani. Waan mesa jala d'ad'aabani waan gingiti d'iigi iti yau iti mid'aasani waan suni qilumani isii d'und'uma toko, ballinni isiileeni d'und'uma toko. Ammalle moga isii ta ala, waan woi jigu d'owa toko, ka old'eerinni isaa taaku toko jira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jali mesa suni, waan inni ira eju kaani oli d'und'uma lama. Jidduuni isaa keesileeni jala isaa suni d'und'uma toko moga ch'ufaani hanqate, ammalle old'eerinni isiileeni d'und'uma afuri. Ammalle gubani isaaleeni jiddu isaa suni d'und'uma toko moga ch'ufaani hanqate. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gubaani isaa tunini, ta sorio irati gubanileeni, old'eerinni isi d'und'uma afuri gaafi isaa, ka qota ch'ufati ejaanjuleeni, fiit'e isaa ch'ufa ira d'eerata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gubaani mesa suni mogaani isaa ch'ufti wolqit'e, ch'ufti d'und'uma kud'ani lamaati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiddu isaa taanileeni mogaani isii ch'ufti wolqit'e ch'ufti d'und'uma kud'ani afuriti; ammalle isiini waan woi jigu d'owa, ka old'eerinni taku toko qabdi. (Wonti gingitini d'iigi sorio iti yau d'und'uma toko.) Faanoni mesa sunini olkorani gama ilaboru jirti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka waan sorio irati baasani eebisani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan nani jed'e, Namicha, wonti AABBO Waaqi guddaani jed'u tana: Hojja waan mesa fakaata suni jaarani aki isa eebisani akana: Sorio isa gubbati gubani, d'iiga hori sorio sunile iti fifit'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaalole gosa Lawi, ta d'aloota Sadoki ch'allati, na dura d'ufe naa hojata. Jibicha korma, ka sorio dabaani ufi iraa baasani baasani, ha iti kennaniti. Nami, waan kana tolcha jed'u ana, AABBO Waaqa gudda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba d'iiga jibicha suni haga toko fuud'i, gaafa mesa sunifi qota jiddu isaatiifi moga isaa ch'ufale ibsi. Akanaani atini mesa qulqulleesite eebifta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Korma sorio dabaani ufi iraa baasani fuud'i, qaye Mana Waaqa fulla isa iti gubu malaniti gubi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boriyyaate korbeesa toko, ka aabo womatu inqamne, fuud'i, sorio dabaani ufi iraa baasani baasi. D'iiga isaatini waan mesa fakaata kaani, akuma atini d'iiga jibichatini qulqulleesite, qulqulleesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi waan suni ch'ufa tolchite jibicha tokofi elemo toko fuud'i, ka horini kunini lachu aabo womatu inqamne, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
