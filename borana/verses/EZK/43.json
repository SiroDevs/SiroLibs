          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya torba qaaloleeni ha waan mesa fakaata suni eebifte, qulqulleesite huji kurfesituti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
