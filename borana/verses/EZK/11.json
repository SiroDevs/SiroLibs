            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Eze 43.2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani wonti koola ka lubbu qaba kaani barifte, wonti miila gaari fakaata kaanileeni worruma woli yaati; ammalle ifsaani bibiliqu, ka aka AABBO Waaqi Israeli arti jiru garsiisu kaanileeni gubba waan suni jira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba ifsaani kaani dira keesaa bahe gaara diraani ilaboru d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.23",
            "verseOrgIds": [
              "EZK.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 11:24"
          },
