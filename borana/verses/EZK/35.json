                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi na yaame waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.1",
            "verseOrgIds": [
              "EZK.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namicha, lafa Edomu abaari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.2",
            "verseOrgIds": [
              "EZK.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan jettuuni, AABBO Waaqi guddaani waan jed'u: Gaareeni Edomu, anini nyaapa keesani! Anini harka isaniti olfud'ad'e balleese ona isani tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.3",
            "verseOrgIds": [
              "EZK.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini dira keesani balleese ona tolche, lafti teesanileeni aka hamtu baddi; duuba akanaani aka anini AABBO Waaqa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.4",
            "verseOrgIds": [
              "EZK.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani haguma duriti nyaapuma Israeliti, ammalle nama isi harka nama woraanaani nama fit'uti lakiftani, guyya maro ch'ubbu isiitiifi worra balleesani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.5",
            "verseOrgIds": [
              "EZK.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi anini, AABBO Waaqi guddaani waan jed'u, muummeeni teesani duuma, jalaa imbaatani. Isani nama woraanati woraanuma sunini ch'ittani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.6",
            "verseOrgIds": [
              "EZK.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini lafa gaareeni ta Edomu balleese ona tolche, ideemtu isii keesa baatu ch'ufa hobaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.7",
            "verseOrgIds": [
              "EZK.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini gaareeni ch'ufa reefani guute, goblooli nama woraanaani hobae gaareenifi bale keesa guuta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.8",
            "verseOrgIds": [
              "EZK.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini haga jiru jireenna lafa teesani balleese ona tolche, dira keesanile aka nami dandae keesa inteenne tolcha. Duuba akanaani aka anini AABBO Waaqa beetani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.9",
            "verseOrgIds": [
              "EZK.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani, gosa Yudatifi ta Israeli lafa worraatini woliini qamne fud'anna jettani — ato anini AABBO Waaqa worraa tahele. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.10",
            "verseOrgIds": [
              "EZK.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba anini, AABBO Waaqi guddaani, amma inkakhad'a, waan isani worra kiyyati dallantani d'iibifatani jibbitaniifi, anini haalo tana imbaasa. Duuba akanaani worri imbeekha, aka anini, maro isani worra woi tolchitaniifi, isani gaargalchu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.11",
            "verseOrgIds": [
              "EZK.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isani aka anini, AABBO Waaqi, isani tufi keesa gaareeni Israeli ya ona taate, ammalle ya nuti kennani aka nu balleesinu jettani d'agaye, beetani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.12",
            "verseOrgIds": [
              "EZK.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini aka isani kiyyibdani, dubbi heddu dubbattani afaani keesanini ufi guddiftanile ya d'agaye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.13",
            "verseOrgIds": [
              "EZK.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u, Anini aka taka nami inargini balleese ona si tolche nami lafa keesa jiru badi tante suni iraa gammada, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.14",
            "verseOrgIds": [
              "EZK.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuma isani gaafa gumi tiyya ta Israeli balleesani kaani iraa gammaddani. Gaareeni Edomu ee lafti Edomu ch'ufti badde ona taati. Duuba akasiini nami ch'ufti aka anini AABBO Waaqa beekha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.35.15",
            "verseOrgIds": [
              "EZK.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Waaqi Israeli eebise",
          "type": "text"
        }
      ]
    }
  ],
