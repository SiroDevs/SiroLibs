          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi inni ufi qulqulleese, inni bulti torba eege, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.26",
            "verseOrgIds": [
              "EZK.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 44:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba naabo Mana Waaqa gaaraa keesa d'aqe, sorio ufiini qulqulleesu baasu male, aka dandae Mana Waaqa keesa deebie hojatu. Nami dubbi tana jed'e ana, AABBO Waaqa gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.27",
            "verseOrgIds": [
