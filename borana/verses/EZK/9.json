        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.2",
            "verseOrgIds": [
              "EZK.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
