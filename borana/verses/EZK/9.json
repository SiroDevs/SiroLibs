              },
              "items": [
                {
                  "text": "14.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beeni, dira Yerusalemu kana ch'ufa keesa deemi, nama waan hamtu dira kana keesati tolchani ch'ufaa jed'e laalefate bohu, adda isaani beesisa ira kayi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
