              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Waaqi waan worraani jed'e, Mana kiyya kana t'ureesa, ch'icha isale reefani guuta. Amma kaa hojad'a! Duuba akasiini worri kaani kae, nama dira keesa jiru hobaase.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
