              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini qonqo Waaqa ta, Isani nami dira kana balleesu woraana guurad'a koota, jettu d'agaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.1",
            "verseOrgIds": [
              "EZK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojuma suni nami jaa, ka woraana qabu, balbala mirga ta Mana Waaqa ta alaatini gabahe. Worra suni woliini nama toko, ka waan woini t'aafufi waan irati t'aafule harkaa qabu, ka woya boofta keeyatuti jira. Worri kunini ch'ufti d'ufe d'aatu waan sorio irati qalani, ka sibiila diimani mid'aasani, ejaanje.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.2",
            "verseOrgIds": [
              "EZK.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
