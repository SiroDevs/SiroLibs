              "attrs": {
                "loc": "JER.52.4+JER.52.5+JER.52.6+JER.52.7+JER.52.8+JER.52.9+JER.52.10+JER.52.11+JER.52.12+JER.52.13+JER.52.14"
              },
              "items": [
                {
                  "text": "52.4-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya shaneeso, ka jia kud'anneeso, ka ganna kud'ani lameeso, ka nu haga nu boojiani teenne, nami toko ka dira Yerusalemu keesaa baqate nati d'ufe waan nani jed'e, Dira kenna ya nyaapi balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galgala inni d'ufe suni aka kaleeti, harki AABBO Waaqa na tuqe jennaani afaani na duudani. Boriyyaate namichi kaani d'ufnaani AABBO Waaqi afaani na bane.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
