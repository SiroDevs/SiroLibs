          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.10",
            "verseOrgIds": [
              "EZK.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.11",
            "verseOrgIds": [
              "EZK.17.11"
            ]
          }
        },
        {
          "name": "verse",
