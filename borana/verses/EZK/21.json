            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daayyani isani agartani tunini d'ara, wonti isani agartani kunileeni kiyyiba. Guyyaani isani balleesani ya alaa hobae. Goraadeeni d'iotu d'ufte mata isani iraa ch'irti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.29",
            "verseOrgIds": [
              "EZK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goraade qalqalti deefad'a! Fulla iti isani uumani lafa isani keesati d'alatani keesati wollaala isaniti mura. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.30",
            "verseOrgIds": [
              "EZK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo anini aka ibida isaniti bobae, dallansu tiyya agartani. Ammalle anini harka nama naasu inqamne, ka aka male nama fit'uti isani kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.31",
            "verseOrgIds": [
              "EZK.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibidaani isani balleesani, lafa teesani keesati d'iiga keesani jissani, nami tokoleeni deebie isani inqaabatu, Nami dubbi tana jed'e AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.32",
            "verseOrgIds": [
              "EZK.21.32"
            ]
          }
        }
      ]
    },
