                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namicha, woi fagi, waan anini, AABBO Waaqi guddaani, worra Amoni, ka worra Israeli arabsuni jed'u, iti himi waan jettuuni:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.28",
            "verseOrgIds": [
              "EZK.21.28"
            ]
          }
        }
      ]
