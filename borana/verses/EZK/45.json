        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami lafa keesa jiru ch'ufti waan Waaqaa baasani kana hayyu lafa Israeli mohatuti geesu male. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni hori gubanifi mid'aani Waaqaa baasanifi daad'i Waaqaa baasanile gaafa jila baatitifi ta Sabatotifi jila d'ibile, maro gosa Israeli ch'ufaa jed'e, baasu male. Ammalle inni sorio dabaani ufi iraa baasanifi mid'aani Waaqaa baasanifi hori gubani sorio baasanifi sorio wold'ageetile baasu male. Aka akanaani ch'ubbu worra Israeli balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jila",
          "type": "text"
        }
      ]
    },
    {
