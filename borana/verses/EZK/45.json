            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.16+NUM.28.17+NUM.28.18+NUM.28.19+NUM.28.20+NUM.28.21+NUM.28.22+NUM.28.23+NUM.28.24+NUM.28.25"
              },
              "items": [
                {
                  "text": "Hen 28.16-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Guyya kud'ani afreeso ka jia qara isani jila Pasaka tolfachu maltani. Bulti torba nami ch'ufti qit'a bukho inqamne nyaachuu male. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.21",
            "verseOrgIds": [
              "EZK.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya qara ka jila suni hayyichi jibicha korma maro ch'ubbu ufitifi ta gumi ch'ufati jed'e qaluu male. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.22",
            "verseOrgIds": [
              "EZK.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Torbaani jila suni, guyya ch'ufa, inni jiboota koromi torbafi elemiye torba, ka horini kunini ch'ufti aabo womatu inqamne, gube AABBO Waaqaa sorio baasuu male. Ammalle inni guyya ch'ufa korbeesa toko sorio dabaani ufi iraa baasani qaluu male. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.23",
            "verseOrgIds": [
              "EZK.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiboota koromi sunifi elemiye sorio baasani suni ch'ufa, mid'aani t'aasa gudda kud'ani torbatiifi t'aasa diqa tokotifi d'ad'a dulo sadii woliini baasuu malani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
