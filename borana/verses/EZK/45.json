                "loc": "LEV.19.36"
              },
              "items": [
                {
                  "text": "Law 19.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nami ch'ufti waan woini biimani ka d'uga qabaachu male, misana taanaani, efa taanaani, bathile taanaani.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        }
