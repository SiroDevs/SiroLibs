          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani hooliye tiyya ta anini tissu, aninileeni Waaqa keesani. Nami dubbi tana jed'e ana, AABBO Waaqa gudda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.34.31",
