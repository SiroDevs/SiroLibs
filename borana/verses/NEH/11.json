    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaarole Yerusalemu qubateefi gumiini taani, hit'aa buufate mana kud'ani keesa mana toko ka godaane dira qulqullo Yerusalemu qubatu fohate, ka maneeni hafte taani dira d'ibi keesa qubattu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti nama ufi baase Yerusalemuti godaane ch'ufa eebifte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.7.73"
              },
              "items": [
                {
                  "text": "Neh 7.73",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dira kaani ch'ufa keesa, worra Israelitiifi qaaloleefi worra Lawitifi worra huji Mana Waaqa hojattufi worri d'aloota hojattu Solomonileeni dira ufi keesa woma ufiitini bula. Kunini maqa jaarole gugurdo, ta worra Yuda, ta Yerusalemu keesa teetu:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.3",
            "verseOrgIds": [
              "NEH.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Athaya, ilma Uzia Uziani ka Zekaria, Zekariani ka Amaria, Amariani ka Shefatia, Shefatiani ka Mahalaleli, Mahalaleliini ka Peresi, Peresini ka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaseya, ilma Baaruki, Baarukini ka Kolohoze, Kolohozeni ka Hazaya, Hazayani ka Adaya, Adayani ka Yoyaribu, Yoyaribuni ka Zekaria, Zekariani ka Shela, Shelani ka Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri d'aloota Perezi, nami Yerusalemu keesa tau, nama 468 ka ch'ufti nama jajaba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salu, ilma Meshulamu, Meshulamuni ka Yoedi, Yoedini ka Pedaya, Pedayaani ka Kolaya, Kolayani ka Maaseya, Maaseyani ka Ithieli, Ithielini ka Yeshaya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabaifi Salaini fiit'a Saluti. Nami gosa Benjamini, ka Yerusalemu keesa tau ch'ufti wolti nama 928. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoelini, ilmi Zikri, gudda worrati, ammalle Yudaani, ilmi Hassenua, nama gudda dira suniti aanu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yedaya, ilma Yoyaributifi Yakini.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Serayaani ilma Helkia, Hilkiani ka Meshulamu, Meshulamuni ka Sadoki, Sadokini ka Merayothi, Merayothini ka Ahitubu, Ahitubuni suni qaallicha gudda. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami balbala tana, ka Mana Waaqa keesa hojatte, nama 822. Adayani, ilma Yorohamu, Yorohamuni ka Pelalia, Pelaliani ka Amzi, Amzini ka Zekaria, Zekariani ka Pashuri, Pashurini ka Malkia.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami balbala worra kanati mataa ch'ufti wolti 242. Maasaini ilma Azareli, Azarelini ka Azai, Azaini ka Meshilemothi, Meshilemothini ka Imeri. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami balbala tana jajabaani nama d'ibbaafi diddami saddeeti. Guddaani worra Zabdieli, ka ilma Hagedolimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaya ilma Hashubu; Hashubuni ka Azrikamu, Azrikamuni ka Hashabia, Hashabiani ka Buni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shabethaifi Yozabadini worra Lawi gugurda ka huji Mana Waaqa ta ala, harkaa qabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataniani ilma Mika, Mikaani ka Zabdi, Zabdini ka Asafu. Inni nama sirbitu Mana Waaqa, ta sirba galata Waaqa deebisanini sirbituti mataa. Bakbukia, ka Matania qarqaaru. Ammalle Abda ilma Shamua, Shamuani ka Galali, Galalini ka Yeduthuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa Lawi, ka dira qulqullo Yerusalemu keesa tau, nama 284.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akubu, Talmoni, worraafi fiit'aani worraa wolti nama 172.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Israeli kaani ch'ufafi qaaloleefi worri Lawi ka hafe dira Yuda keesa mana ufiti gale. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari Mana Waaqa hojattu Yerusalemu keesa moga ofeli qubata, nami gudda worraleeni Sihaafi Gishpa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guddaani, worra Lawi ka Yerusalemu keesa tau, Uzi ilma Baani, ka ilma Hashatia, ka ilma Matania, ka ilma Mika. Inni balbala gosa, Asafu, ta huji sirba Mana Waaqa harkaa qabdu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle seera sirba ka hayyuuni baaseti jira ka balbalti worra faro farooni Mana Waaqa keesati sirbitu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pethahiyani, ilmi Meshezabeli, ka balbala Zeraka, gosa Yuda, gumi worra Israeli hayyu durati dubbi dubbataafi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Biyya dira d'ibi keesa jirtu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
              "NEH.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyiti hedduni dira ufi keesa d'aatu oobru ufi teete. Worri gosa Yuda Kiriathi Arbaafi Debonifi. Yekabzeelifi ollowaani d'aatu jirtu keesa taa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
              "NEH.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri dira Yeshua, Molada, Beth-Peleti, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.26",
            "verseOrgIds": [
              "NEH.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazar-Shali, Bethshebafi ollowaani d'aatu jirtu keesa taa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.27",
            "verseOrgIds": [
              "NEH.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri dira Ziklagifi Mekonafi ollowaani isaatiifi ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.28",
            "verseOrgIds": [
              "NEH.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enrimonifi Sorafi Yarmuthifi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoafi Adulamufi ollowaani d'aatu dira kana jirtule keesa taa. Ammalle worri Lakishifi oobru d'aatu dira suni jirtuufi Azekafi ollowaani isaa keesa taa. Akasi jechaani worri Yuda lafa Beersheba ta bitatifi bale Hinomu ta mirga jiddu tae. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri gosa Benjamini dira kana keesa taa: Geba, Mikimashi, Aya, Bethelifi ollowaani d'aatu jirtu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.31",
            "verseOrgIds": [
              "NEH.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anathothi Nobu, Anania, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.32",
            "verseOrgIds": [
              "NEH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazuri, Rama, Gitaimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.33",
            "verseOrgIds": [
              "NEH.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hagidi, Seboimu, Nebalati, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.34",
            "verseOrgIds": [
              "NEH.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lodi, Onofi Bale Ogeeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.35",
            "verseOrgIds": [
              "NEH.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Lawi ka gari, ka qara lafa Yuda keesa tau, Godaansisani, lafa Benjamini qubsisani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.36",
            "verseOrgIds": [
              "NEH.11.36"
            ]
          }
        }
      ]
    },
