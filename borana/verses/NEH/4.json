      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbalatini aka nu Yahudiini dira jaaru jiru d'agaye jennaani aka male dallane d'ufe nu goyeese. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.1",
            "verseOrgIds": [
              "NEH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni jara isaatiifi askarti Samaria durati waan jed'e, Worri mumuyooni Yahudi kunini maani tahu jira? Worri dira kana ammalle jaaru fed'a? Worri waan sorio baasufi waan aruma huji tana hobaasu seha? Worri dandae huura gubani kana keesaa d'akhaa manaani jaarani inargata?",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.2",
            "verseOrgIds": [
              "NEH.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.2",
            "verseOrgIds": [
              "NEH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tobialeeni ka hojja suni d'aatu eju waan jed'e, Naaboni worri jaaru tana? Ta geedaltileeni dandeete ch'ach'absitu!",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.3",
            "verseOrgIds": [
              "NEH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini Waaqa kad'ad'e waan jed'e, Ee Waaqa, aka worri kunini nu goyeesu d'agayi! Goyeesa tana mata worrati deebisi worra boojii, lafa d'ibi geesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.4",
            "verseOrgIds": [
              "NEH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ch'ubbu worra inaraaraminifi, daba worrale ind'ossini, waan worri nu ka naabo jaaru arrabseefi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.5",
            "verseOrgIds": [
              "NEH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akanaani nu naabo jaare, maro tokotu wod'akaani geenne, waan biyyiti garaa tokooni hojatteefi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.6",
            "verseOrgIds": [
              "NEH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanbalatifi Tobiafi jara lafa Araftitifi ka Amonitifi ka Ashdodileeni, aka nu jabaanne naabo Yerusalemu jaare, fulla d'akhaani wolhanqatuni ch'ufa duuchine d'agaye jennaani, aka hama dallane. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.7",
            "verseOrgIds": [
              "NEH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba worri ch'ufti aka d'ufe Yerusalemu had'e waan ch'ufa balleese garagalchu malate. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.8",
            "verseOrgIds": [
              "NEH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nu Waaqa keenna kad'anne, halkani guyya nama worra suni nuraa eegu tolchine.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.9",
            "verseOrgIds": [
              "NEH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yuda sirba kana baase sirbe:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.10",
            "verseOrgIds": [
              "NEH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.10",
            "verseOrgIds": [
              "NEH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaapi keenna waan jed'e, Haga nu jiddu worra buune worra balleesine huji ejachimnuti, worri woma arge inhubatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.11",
            "verseOrgIds": [
              "NEH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja ch'ufa Yahudiini nyaapa keennani woliini teetu d'ufte, mala worri nuti d'aatu nuti himti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.12",
            "verseOrgIds": [
              "NEH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi anini goraadeefi woraanafi t'iya biyyaa kenne, worra worraani naabo duuba d'aabe, Fulla inhobaini ch'ufa duuba ejaanja, nama eega, jed'eeni. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.13",
            "verseOrgIds": [
              "NEH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini aka biyyiti mudamte arge jennaani, waan worraafi jaaroleefi gugurda worratiini jed'e, Nyaapa keenna ind'eetina. Qaabad'a, aka AABBO Waaqi ireefi jabeenna qabu; gosa teesanifi ilmaani teesanifi nad'eeni teesanifi olla keesanii jed'a, nyaapa had'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.14",
            "verseOrgIds": [
              "NEH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaapi keenna aka nu mala worraa beekanne d'agaye, akanaani aka Waaqi mala worra balleese arge. Duuba nuni ch'ufti deebine naabo jaarre.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.15",
            "verseOrgIds": [
              "NEH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya suni asi jari kiyya hagi toko hojate, kaani d'ibiini miha lola naqate woraanafi wonteefi t'iyale qabate worra eege. Ammalle jaaroleeni teennaleeni ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.16",
            "verseOrgIds": [
              "NEH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "worra naabo ijaaru bira ejaanjite garaa jabeesite. Nami waan manaani jaarani baatuleeni ch'ufti, harka tokooni wobaate, kaanini woraana baata; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.17",
            "verseOrgIds": [
              "NEH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle nami wo jaaruleeni ch'ufti goraade hid'aanati hid'ate. Namichi hojja lola magalata d'auleeni naa bira eja. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.18",
            "verseOrgIds": [
              "NEH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan biyyaafi worra gugurdafi jaaroleeni jed'e, Hujiini tunini guddo, yayu woli nu hanqifte fulla fullati gargari nu baafte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.19",
            "verseOrgIds": [
              "NEH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo magalata d'ageetani, fulla magalata suni d'aani koota, Waaqa keennati nyaapa nuraa had'a. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.20",
            "verseOrgIds": [
              "NEH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba akanaani guyya ch'ufa, haguma ganama lafti barite haga galgala urjini baatu, nami keenna hagi toko naabo jaare, kaani woraana guurate lafa eege.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
            "verseOrgIds": [
              "NEH.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.21",
            "verseOrgIds": [
              "NEH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara suni waan anini biyyaani jed'e, Jari gugurdafi hojattuuni worraleeni ha dira Yerusalemu keesa bulaniti, aka nu halkani dira eenne guyyale hojannu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.22",
            "verseOrgIds": [
              "NEH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaafi wahela kiyyafi hojattu tiyyaafi nami na eeguleeni takaa fulla bultileti woya imbaafanne, nu ch'ufti woraana keenna qabanne bullaani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.4.23",
            "verseOrgIds": [
              "NEH.4.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka hiyyeeyi dabsani",
          "type": "text"
        }
      ]
    }
  ],
