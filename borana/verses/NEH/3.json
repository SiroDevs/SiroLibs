          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barai, ilmi Henadadi, ka arda Keila gama kaani mohatu, isati aane qooda ufi jaare.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.18",
            "verseOrgIds": [
              "NEH.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
