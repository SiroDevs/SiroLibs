        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu, gumifi qaaloleefi worri Lawileeni, ganna ch'ufa hit'aa buufanne balbala gosa ta qoraani sorio AABBO Waaqa keennatiini gubani ch'absitu akasiini fohanna, akuma Seera keesati t'aafani gula.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.34",
            "verseOrgIds": [
              "NEH.10.34"
            ]
          }
        }
      ]
    },
