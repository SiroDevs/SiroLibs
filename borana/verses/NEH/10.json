                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nu nama gosa d'ibi, ka lafa teenna keesa tauni, woli infuunu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.30",
            "verseOrgIds": [
