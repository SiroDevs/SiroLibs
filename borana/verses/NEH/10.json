                "loc": "DEU.26.2"
              },
              "items": [
                {
                  "text": "Qab-Ser 26.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nu ganna ch'ufa mid'aani qara muranifi mid'aani mukeeni teenna baaftu ka qara bilchaatu, Mana Waaqa geesina. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.35",
            "verseOrgIds": [
              "NEH.10.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Bah 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ilma angafa ka nuu d'alatu ch'ufa Mana Waaqa geesine qaaloleetini d'umna, aada seera keesati t'aafani gula. Ammalle nu watiyefi ilmoole ree, ta qara d'alatu ch'ufa, Waaqaa baamna. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.36",
            "verseOrgIds": [
              "NEH.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Hen 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nu mid'aani daakhani bukheesani, ka mid'aani qara muranitifi waan d'ibi baasani, daad'i taanaani, d'ad'a tanaani, mid'aani gosa heddu ka mukha taanaanile, ganna ch'ufa Mana Waaqati geesine qaaloleeti kennina. Ammalle qooda mid'aani oobruuni teenna baaftu, ka nu baasu male, worra Lawi ka qooda mid'aani olla keenna guuruti kennina. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.37",
            "verseOrgIds": [
              "NEH.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.26"
              },
              "items": [
                {
                  "text": "Hen 18.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Qaaloleeni d'aloota Haruni worra Lawi, hojja qooda mid'aani guurani woliini jiraachu malte. Ammalle worri Lawi qooda guuru suni kud'ani keesa qooda toko ha mana keesa fulla woi olkayaniti geesu, aka Mana Waaqatini hojattani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.38",
            "verseOrgIds": [
              "NEH.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Israelitiifi worri Lawi mid'aanifi daad'ifi d'ad'a baasani ch'ufa ha mana keesati woi olkayaniti geesuti, fulla miha Mana Waaqa iti olkayanifi fulla qaaloleefi jara Mana Waaqa eegufi sirbituleni iti galtu. Nu Mana Waaqa keenna haga jiru illakimnuu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.39",
            "verseOrgIds": [
              "NEH.10.39"
            ]
          }
        }
      ]
    },
