          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu, worri Israeli, qaaloleefi worra Lawitifi worra Mana Waaqa eegufi sirbitufi, hojattu Mana Waaqatifi nami kaani d'ibiini ch'ufti, ka Seera Waaqa gula gosa d'ibi ta lafa teenna keesa teetu keesaa ufi baamne, nuufi nad'eeni teennafi ilmaani teenna gugurdoleni, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.28",
            "verseOrgIds": [
              "NEH.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "jaarole teenna woliini, inkakhanna aka, hojja nu kakhu suni ch'absine abaarsa argannu. Kakhuuni suni tana: aka nu Seera Waaqi Musani nuu kenne jalati bullu. Ammalle aka nu waan AABBO Waaqi guddaani keenna nu barsiisu guunnu; ammalle aka nu seerafi waan inni fed'u ch'ufa jabeesinu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.10.29",
            "verseOrgIds": [
              "NEH.10.29"
            ]
          }
        }
      ]
