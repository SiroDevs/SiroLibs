      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni nami hedduni, d'iirafi nad'eenileni, gosa isani ta Yahuditi gungumani, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.1",
            "verseOrgIds": [
              "NEH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'ani, Nu ilmaani heddu qamna, mid'aani nu gaha nuu keenna, duu nu d'owa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.2",
            "verseOrgIds": [
              "NEH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo nami garileeni waan jed'e, Nu oobru teenna ta mid'aanitifi ta zabibutifi maneeni teennale qabdo keenna, aka mid'aani arganne sunini duu ufi d'owarru. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.3",
            "verseOrgIds": [
              "NEH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle jari d'ibileeni waan jed'e, Nu gati fuune, gibira oobru teenna ta mid'aanitifi ta zabibu hayyu baamna. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.4",
            "verseOrgIds": [
              "NEH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu ch'ufti gosa taka, ijoolleeni teennaleeni oboleyaani, ka nu amma ijoolle teenna tisse tolchinu. Ammalle dubra teenna haga toko yayu gurgurani tisse tolchani. Oobru teenna ch'ufa yayu nami d'ibiini nuraa fud'ate, tanaafi amma nu waan taanu inqamnu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.5",
            "verseOrgIds": [
              "NEH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini gungumsu suni d'agaye jennaani guddo dallane, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Bah 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.35+LEV.25.36+LEV.25.37"
              },
              "items": [
                {
                  "text": "Law 25.35-37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Qab-Ser 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mala d'ae, jaaroleefi worra gugurdale, wolti yaame, Isani ya oboleyaani teesani dabsitani jed'eeni. Jennaani kora iti baase, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.7",
            "verseOrgIds": [
              "NEH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'e, Qara haga dandeennu oboleyaani teenna ta Yahudi, ta nyaapati ufi gurgurte, hori baamne deebimne, ammo isani amma tana, oboleyaani teesani dabsitani yo, worra isaniti ufi gurguru bitattani! Jaaroleeni taani waan jettu d'abde, akanumati afaani qabate teteete.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.8",
            "verseOrgIds": [
              "NEH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini waan jed'eeni, wonti isani tolchitani sunini diqole dansaniti! Sila Waaqa sodaatani waan dansa tahu maltani. Yo akasi taatani nyaapi keenna, ka gosa d'ibi, waan nu goyeesuuni inqabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.9",
            "verseOrgIds": [
              "NEH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini yayu mid'aanifi beesele biyya gati kenne, waheli kiyyafi hojattuuni tiyyaleeni akasuma tolchite. Amma waan taanu, nu gati suni imbarbaannu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.10",
            "verseOrgIds": [
              "NEH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isanileeni gati worra iraa qabdani imbaarbadina lakisa, beese taanaani mid'aani taanaani, daad'ifi d'ad'ale taanaani. Amuma tana oobru mid'aanitifi ta zabibutifi ta ejersatifi maneenile deebisa!",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.11",
            "verseOrgIds": [
              "NEH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani jaaroleeni waan nani jette, Nu dubbi tante la ee jenne, waan suni ch'ufa deebimne gatile worraa lakimna. Duuba anini qaalole yaame, jaarole suni qaalole durati kakhachiise, aka worri dubbi suni hegeri imormanne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini woya hid'aanati marad'u taani hikhad'e, hargufe waan jed'e, Waaqi isani nama kakhu tana inguunne ch'ufa ha akanuma hargufuti. Waaqi maneeni teesanifi waan isani qabdani ch'ufa ha isani iraa fuud'e, duwa isani teesisuti. Nami achi jiru ch'ufti Amini jed'e AABBO Waaqa faarse. Duuba jaaroleleeni kakhu suni guute.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arjooma Nehemia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna kud'ani lamaani anini gudda lafa Yuda tahe kana ch'ufa, haguma ganna diddameeso ka Artashartani lafa mohate, haga ganna Sodomi lameeso ka mootuma isa, anaafi nami fiit'a tiyyaleeni taka waan sila anini argachu male insooranne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.14",
            "verseOrgIds": [
              "NEH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari duri na durati gudda lafa suni tahe ch'ufti biyya dabse, guyya ch'ufa qarsi afurtamatiifi daad'ifi sagale ira guurata. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.15",
            "verseOrgIds": [
              "NEH.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojattuuni worraleeni biyya dabsite, ammo anini maro Waaqa sodaad'eefi akasi intolchine. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.16",
            "verseOrgIds": [
              "NEH.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini iti jabaad'e, naabo suni jaare, waan nafa kiyya ka sila horad'u yaalabahe, hojattuuni tiyyaleeni ch'ufti hujuma suni hojatte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.17",
            "verseOrgIds": [
              "NEH.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini guyya ch'ufa nama Yahuditiifi jaarole worrale ch'ufa nama gosa d'ibi ka lafa d'aatuti d'ufe malele nama d'ibbaafi shantama gololcha. Guyya ch'ufa anini sanga tokofi hooliye gagabbo jaafi luku heddu qale biyya nyaachise, guyya kud'ani ch'ufa keesa daad'i gorjo muumme inqamne biyyaani gololche. Ammo anini gaargala biyyiti qabdu imbeekha, tanaafi anini sagale sila namichi guddaani argachu male imbarbaanne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Waaqa kiyya, anini si kad'ad'a, waan dansa anini worra kana tolche kana, jed'i na qaabad'i.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Nehemiati malatani",
          "type": "text"
        }
      ]
    }
  ],
