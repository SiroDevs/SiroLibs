    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunini maqa qaaloleetifi ka worra Lawi, ka Zerubabeli, ilma Shealthielitifi qaallicha gudda Yoshua jed'ani woliini, lafa iti boojiani keesaa gale:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yoshua jari kunini ch'ufti balbala worra, ta qaalole keesa worra matati.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2+NEH.12.3+NEH.12.4+NEH.12.5+NEH.12.6+NEH.12.7",
            "verseOrgIds": [
              "NEH.12.2",
              "NEH.12.3",
              "NEH.12.4",
              "NEH.12.5",
              "NEH.12.6",
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari sirba galatani deebisani iti mataa kana: Yeshua, Binui, Kadmieli, Sherebia, Yuda, Matania.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami worrati fuula deefate sirbu worra kana: Bakbukia, Unofi worra Lawi d'ibi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aloota qaallicha gudda Yoshua jed'ani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuani abba Yoyakimu; Yoyakimuni abba Eliashibu, Eliashibuni abba Yoiyada, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoiyadani abba Yonathani, Yonathani abba Yadua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jara balbala qaaloleti mataa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Yoyakimuni qallicha gudda, qaaloleeni tunini balbala qaaloleeti mataa:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21",
            "verseOrgIds": [
              "NEH.12.12",
              "NEH.12.13",
              "NEH.12.14",
              "NEH.12.15",
              "NEH.12.16",
              "NEH.12.17",
              "NEH.12.18",
              "NEH.12.19",
              "NEH.12.20",
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan worraa qaaloletifi ka Lawi ka t'aafani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21",
            "verseOrgIds": [
              "NEH.12.12",
              "NEH.12.13",
              "NEH.12.14",
              "NEH.12.15",
              "NEH.12.16",
              "NEH.12.17",
              "NEH.12.18",
              "NEH.12.19",
              "NEH.12.20",
              "NEH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan nama worra Lawitifi ka qaaloleeti mata ka t'aafani, olkayani. Nami gaafasi qaalole gugurdo worraa kana: Eliashibu, Yoyada, Yonathani, Yadua. Waan kana, gaafa Darioni hayyu Ajemi t'aafani hobaasani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo jara worra Lawiti mataa kitaaba waan qaalole keesati t'aafaniti t'aafani; wonti t'aafani suni bara Yonathani akhaakhu Eliashibu muumme baate bara d'ibiti intaakimne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka huji Mana Waaqa qoodani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra Lawi huji iti qoodani Hashabiafi Shenebiafi Yeshuafi Benufi, Kamieli gudda iti tolchani, Aada duri namichi Waaqa Daudini biyyaa kenne gula. Jara fulla fullati qoodani suni qoodi lamaani maro maroti Waaqa faarse galata deebisaafi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari Mana Waaqa eegu, ka worra mana wo iti olkayani, ka d'aatu Fullo Mana Waaqa jiru eeguti mataa, kana: Matania, Bakabukia, Obadia, Meshulamu, Talmoni, Akubu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari kunini bara Yoyakimu ilma Yoshua, ka ilma Yosadakitifi bara Nehemia namicha guddatifi bara qaallicha Ezra jed'ani, ka waan Seera guddo beekhu, lafa jira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Nehemiani naabo dira eebise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa naabo dira Yerusalemu eebisani, worra Lawi ch'ufa fulla worri jiru d'ufaniini, aka worri guyya jila suni sirba galatani deebisani bilbilafi kiraari d'ae sirbu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sirbituni worra Lawi fulla worri jiru, ta d'aatu Yerusalemutifi d'aatu dira Netofathifi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beth-Gilgalifi Gebaafi Asmarethi, keesaa wolti d'ufte. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaaloleefi worri Lawi ufi qulqulleesani, gumifi Fulofi naabo dirale qulqulleesani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini jaarole Yuda naabo suni gubbati wolti yaame, gumi guddo muumme inqamne, ta fulla lama yaate dira sunini marte sirbite galata Waaqaa deebiftu mataa tolche. Gumiini qara mirga qajeelte, naabo gubba gara Fullo Huura yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshayani worra duuba deeme, jaaroleeni Yuda hagi toko isa gula yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari qaalole, ka worra suni gula yae magalata d'ae kana: Azaria, Ezra, Meshulamu, Yuda, Benjamini, Shemaya, Yeremia. Nami worrati aanu Zekaria ilma Yonathani, ka ilma Shemaya, Shemayani ka Matania, Mataniani ka Mikaya, Mikayaani ka Zakuri, Zakurini ka Asafu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33+NEH.12.34+NEH.12.35",
            "verseOrgIds": [
              "NEH.12.33",
              "NEH.12.34",
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isale worra balbala isaati iti aana — Shemaya, Azareli, Milalai, Gilalai, Maai, Nethaneli, Yuda, Hanani worri kunini ch'ufti miha sirba ka miha duri hayyu Daudini namichi Waaqa kaani fakaatuni sirba. Namicha Ezra jed'ani ka waan seera beekhu kaaniti gumi tana dura deema. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Fullo Maddo gahe jennaani Faano dira Dauditini seenani olkore, mana Daudi bira dabre, gama dira ka ilaborutiini. Naabo fulla Fullo Bisaanitini deebie. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumiini taani d'ibiini ta sirba galata sirbuti, bita qajeelte naabo guba yaate, anileeni, biyya haga gari woliini faana worraa d'ufe. Nuu Doofi Ibida dabarre Naabo Ballooni baane, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "artile iti d'aabanne, Fullo Efraimutifi Fullo Yeshanatifi ta Qurt'umitifi Doofi Hananelitifi Doofi d'ibba toko jed'anifi Fullo Hooliyele dabarre, d'aatu Fullo Mana Waaqa geennaani yaasuma keenna lakimne. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani gumiini galata Waaqaa deebiftu taani lamaani fulla Mana Waaqatini baate. Jaarole na woliini jirtu malele, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "qaaloleeni magalata d'ooftu tunileni na woliini jirti. Eliakimu, Maaseya, Miyamini, Mikaya, Elioenai, Zekaria, Hanania. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle Maaseya, Shemaya, Eleazari, Uzi, Yehihanani, Malkia, Elemu, Ezeri. Sirbituni, ta Yezrahiyani iti mataa, lalabde sirbite. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya suni sorio heddu qalani, biyyitileeni guddo gammadde, waan Waaqi worra gammachiisefi. Nad'eenifi ijoolleleeni gammadde, lalabde, sirbite, qonqo worraa fagole d'agayani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
