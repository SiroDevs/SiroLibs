                }
              ]
            }
          ]
        },
        {
          "text": "waan worri aada woi qulqulleesanifi aada d'ibi Waaqi worraa kenne ch'ufa guutefi. Sirbituni Mana Waaqatifi jari Mana Waaqa eeguleeni huji ufi, aada duri Daudifi ilmi isaa Solomonini lafaani d'ufe, gula hojate. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
