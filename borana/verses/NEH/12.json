          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haguma bara Dauditifi bara Asafu ka duri kaani asi, aadaani sirbani galata Waaqa deebisani tunini inuma jirti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
