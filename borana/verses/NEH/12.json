            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara Zerubabelitifi ka Nehemia, worri Israeli ch'ufti guyya ch'ufa wo baase, waan worri baase sunini sirbitu Mana Waaqatifi jara Mana Waaqa eeguni gololchani. Biyyiti worra Lawiti qooda worraa kennite, worrileeni qooda qaalole qaalolee kenne.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
      ]
