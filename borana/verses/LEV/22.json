              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqa kiyya qulqullo int'ureesina; gumiini Israeli ch'ufti ha aka anini qulqullo beetu, anini AABBO Waaqa, ka isani qulqulleesu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
