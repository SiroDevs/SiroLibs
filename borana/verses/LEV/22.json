              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja ilmooleeni yokhaani watiyeni d'alate, haga isiini torba bultuti haad'a jalaa imfuud'ina, ammo eegi suni dandaani sorio gubani baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26+LEV.22.27",
            "verseOrgIds": [
              "LEV.22.26",
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saa d'alafi ilme isaa, yokhaani hoola d'alafi ilme isaa, yokhaani reeti d'altufi ilme isii, guyya taka sorio woliini imbaasina. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja sorio baaftani AABBO Waaqaa galata deebiftani, aada gula baasa, aka Waaqa isani iraa fud'atu; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "guyyuma suni nyaad'a, imbulchina. Anini AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
