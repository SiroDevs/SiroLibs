              "items": [
                {
                  "text": "Qab-Ser 15.7-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami gosa teesani ka Israeli hiyyoomate ufi bulchu dad'abe qarqaari, aka atini keessuma qarqaartu, aka duuba inni sibiraa infagaanne. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woma ira infud'atini, ammo Waaqa sodaad'i, inni ha sibira tau. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Bah 22.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "Qab-Ser 23.19-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Beese atini isaa liqeesitele tirfi ira imfud'atini, sagale atini iti gurgurtele tirfi keesa imbarbaadini. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunini dubbi AABBO Waaqa keesani, kafa Misiri keesaa isani baase, Waaqa keesani tahe lafa kanaani isanii kenne.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka tisse gad'iisani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
