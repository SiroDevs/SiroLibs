              },
              "items": [
                {
                  "text": "27.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle AABBO Waaqi Waan jed'e, Waan harkaani mid'aaani, d'akha boch'ani taanaani, akheekha woi taanaani, d'akha old'ad'aabani taanaani, tokole mid'aafatani inkad'atiina. Wonti akanatiifi anini AABBO Waaqa keesani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jila tiyya ch'ufa jabeesa fulla iti na kad'atanile ulfeesa. Anini AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
