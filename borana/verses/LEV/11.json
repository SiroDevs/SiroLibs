              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini Waaqa keesani, ka lafa Misiri keesaa isani baase, aka Waaqa keesani tahu. Tanaafi akuma anini qulqullo isanileeni qulqullo tahu maltani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
