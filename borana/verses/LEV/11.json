            }
          ]
        },
        {
          "text": "Anini, AABBO Waaqi keesani Waaqa qulqullo, Tanaafi ufi qulqulleesa, qulqullo taha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
