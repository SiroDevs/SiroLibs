        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nama Israelitiifi yokhaani nami gosa d'ibi ka worra keesa godaanu, bineensa yokhaani simpirre qulqullo intahini adamse ijeese, inni ha d'iiga bineensafi simpirre suni lafati jisse biyye ira deebisu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jireenni waan lubbu qaba ch'ufti d'iiga keesa jira, tanaafi AABBO Waaqi waan worra Israelitini jed'e, fooni d'iiga qaba inyaatina, nama nyaatule deebiani gumi tiyyati inheregani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        }
      ]
    },
