          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "fulla balbala Waaro Woyyuma male fulla d'ibiti AABBO Waaqaa baasu, deebiani gumi Waaqati inheregani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
