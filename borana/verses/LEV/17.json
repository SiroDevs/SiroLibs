          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami tokoleeni ka fooni bineensa ufiini duefi yokhaani ka bineensi d'ibiini ijeese nyaatu, Israeli taanaani, yokhaani nama gosa d'ibile taanaani ha woya miich'ate, nafa d'iqate, haga aduuni d'iituti tauti, duuba eege inqulqullaa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo akaso tolchu baate wollaali kauma isaati.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.16",
            "verseOrgIds": [
              "LEV.17.16"
            ]
          }
