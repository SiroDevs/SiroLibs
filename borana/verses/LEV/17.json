                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja nami Israeli yokhaani nami gosa d'ibi, ka worra keesa godaanu, fooni d'iiga qaba nyaate, AABBO Waaqi nama suniti qaragale deebie nama suni gumi isaati inheregu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Ebr 9.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jireenni waan lubbu qaba ch'fti, d'iiga keesa jira, tanaafi AABBO Waaqi d'iiga ch'ufa d'aatu waan mesa fakaatati jissa, akasiini daba gumi iraa fuud'a jed'e. D'iigati, ka isa male nami dandae injiranne, daba nama iraa fuud'a. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kanafi AABBO Waaqi waan worra Israelitini jed'e, Isanifi yokhaani nami gosa d'ibi, ka isani keesa godaanu, fooni d'iiga qaba inyaatina.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
      ]
    },
