          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hojja madaani wonti adiifi diimtuni keesani baatu molu suni keesani baate, isiini d'ukuba hama aka qomaat'aati. ",
          "type": "text",
          "attrs": {
