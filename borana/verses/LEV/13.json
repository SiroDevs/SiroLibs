          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo damansi ammalle iti deebie, damansi suni guddachu jiraate abbaaleni ha miha suni gubuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.57",
            "verseOrgIds": [
