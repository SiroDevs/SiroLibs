          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami d'iira taanaani, yokhaani uwa taanaani mada mata yokhaani areeda qabaate, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.29",
