          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi waan suni gubu male, wonti akanatiifi, damansi suni ya guddate waan ch'efa qabate, tanaafi ibidaani gubu malani.",
          "type": "text",
          "attrs": {
