              "type": "text"
            }
          ]
        },
        {
          "text": "inni ha miha suni d'iqa haga bulti torba olkaya jed'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
