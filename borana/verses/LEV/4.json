        "style": "s1"
      },
      "items": [
        {
          "text": "Sorio ch'ubbu danu tolchanini baasani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini worra Israelitini jettu, hojja nami danu waan AABBO Waaqi seera ch'abse ch'ubbu tolche, inni akana tahu male.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami ch'ubbu suni tolche qaallicha gudda tahe, akasiini ch'ubbuuni gumi qabatte inni ha jibicha korma ka aabo inqamneeni d'ufe, maro ch'ubbu isaatiifi AABBO Waaqa durati qale sorio baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha korma suni fulla balbala Waaro Woyyumatiini d'ufe, harka mata ira keeyate harirate, artiti AABBO Waaqa durati gorauti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi guddaani ha d'iiga korma suni ka gari fuud'e, Waaro Woyyumati geese, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "quba isaa d'iiga suni keesa kaye, maro torba golla woyyuma durati, AABBO Waaqa durati fifit'u. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni ha d'iiga haga toko gaafa afraani waan mesa fakaata ka Waaro Woyyuma keesati hit'aana irati aarsaniiti naquuti. Ammalle d'iiga hafe kaani ha waan mesa fakaata ka sorio irati Gubani, ka fulla balbala Waaro Woyyuma eju, jalati jissu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan korma kana inni ha gabbinnafi moora ch'ufafi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle kaleefi gabbinna isiitiifi arabicho tirulle ch'ufa fuud'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan mesa fakaata ka sorio gubani irati baasani kaani irati gubuti akuma inni gabbinna hori sorio wold'ageetiti baasani kaani tolchu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo gogafi foonifi matafi miilafi miha garaa ch'ufafi marumale ha fuud'e, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "alati baase, fulla qulqullo daara iti haraniti ibidaani gubuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja gumiini Israeli ch'ufti danu seera AABBO Waaqa ch'absite akasiini ka imbeekhini ch'ubbu tolchite, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuma ch'ubbuuni suni beekhamteeni, gumiini ha jibicha korma fuute, Waaro Woyyuma ta AABBO Waaqatini d'uftu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba jaaroleeni gumii ha harka mata ira keeyate harirate, duuba artumati goraaniti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaallichi guddaleeni ha d'iiga korma suni haga toko fuud'e Waaro Woyyumati geese, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "quba isaa keesa kaye maro torba AABBO Waaqa durati golla durati fifit'uti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha d'iiga suni haga toko, gaafa afraani waan mesa fakaata ka Waaro Woyyuma keesati hit'aana irati aarsaniiti naquuti, Ammalle d'iiga hafe kaani ha waan mesa fakaata ka sorio irati Gubani, ka fulla balbala Waaro Woyyuma eju, jalati jissuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni ha gabbinna isaa suni ch'ufa fuud'e waan mesa fakaata suni irati gubuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni korma kana ha akuma korma sorio dabaani ufi iraa baasani tolchani tolchuti, duuba akanaani inni sorio daba gumiitini baasani baase, gumii araaramani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.20",
            "verseOrgIds": [
              "LEV.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni ha korma suni alati baase gubuti akuma inni korma daba isaatini baasani tolchu. Tunini sorio daba gumiitini baasani.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
