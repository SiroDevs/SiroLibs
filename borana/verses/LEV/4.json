          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha harka ufi mata ira keeyate harirate, waan mesa fakaata kaani gama mirgati, fulla hori gubani sorio baasani iti goraaniti, gorauti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
