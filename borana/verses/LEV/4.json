            }
          ]
        },
        {
          "text": "Yo gumi keesa nami toko danu seera AABBO Waaqa ch'abse, akasiini ka imbeekhini ch'ubbu tolche, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.27",
            "verseOrgIds": [
              "LEV.4.27"
            ]
          }
        },
        {
          "name": "verse",
