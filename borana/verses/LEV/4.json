          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "akuma ch'ubbuuni isaa suni mullateeni, inni ha reeti aabo inqamne tokooni d'ufe sorio baasuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
            "verseOrgIds": [
              "LEV.4.28"
            ]
          }
        },
        {
