          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaallichi ha quba ufi d'iiga hori suni keesa kaye, gaafa afraani ka waan mesa fakaata, ka sorio irati gubaniti naqe, ka hafe kaani d'ibi mesa suni jalati jissuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.30",
            "verseOrgIds": [
              "LEV.4.30"
            ]
          }
        },
        {
