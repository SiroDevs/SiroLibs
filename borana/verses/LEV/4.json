              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo nami hoola sorio dabaani ufira baasani baase, hoolani suni ha hoola d'ala aabo inqamne tahuti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
