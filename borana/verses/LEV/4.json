            "number": "29",
            "style": "v",
            "sid": "LEV 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ha harka isaa mata ira keeyate harirate, waan mesa fakaata kaani, gama mirga, fulla hori gubani sorio baasani iti goraaniti ha gorauti. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.29",
            "verseOrgIds": [
              "LEV.4.29"
            ]
          }
        },
        {
