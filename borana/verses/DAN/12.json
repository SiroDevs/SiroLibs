              },
              "items": [
                {
                  "text": "Yoh 5.29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami hedduuni ka qara due inkaa: ka gari jireenna ind'umanne argata, ammo ka gari ch'eera ind'umanne argata. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.2",
            "verseOrgIds": [
              "DAN.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaaroleeni qalbi qabdu aka gubbani bilit'u bibilit'i; jari nama heddu d'uga barsiisuleeni akuma urji haga jiru jireenna ifsa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
        }
      ]
    },
