              "items": [
                {
                  "text": "12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaikaani woya boofta uyifattu waan jette, Gaafasi malaikaani guddoni, Mikaeli jed'ani, ta gosa tante qorqorattu, ind'ufti. Duuba guyya gaargala ka haga nama lafa irati uumani takaa inarginiti d'ufa. Gaafasi nami gosa teeti, ka maqa isaa kitaaba keesati t'aafani ch'ufti lubbu baha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.19"
              },
              "items": [
                {
                  "text": "Isa 26.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.46"
