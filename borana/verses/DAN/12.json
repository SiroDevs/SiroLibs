            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inni waan nani jed'e, Danieli, amma kitaaba ch'ufi, beesisa ira kayi, haga muummeeni d'uftuti. Nami hedduuni olgadi orie waan baratu barbaada.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.4",
            "verseOrgIds": [
              "DAN.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
