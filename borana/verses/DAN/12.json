                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Haguma gaafa sorio guyya ch'ufa baasani balleesani, yokhaani haguma gaafa waan hamtu nama rifachiisa kaani old'aabani, guyya kuma tokotifi d'ibba lamafi sagaltamati dabra. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.11",
            "verseOrgIds": [
              "DAN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami bulti kuma tokotifi d'ibba sadiifi sodomi shani obse eegatu eeba argata! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danieli, atini akuma kanke kaani, haga muumme, kara d'uga keesati buli, Duuba eege indoota, ammo yo dootele gaafa muumme kaate galata kanke argatta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
