              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan nani jette, Danieli, beeni, ufiraa deemi, wonti akanatiifi haga muummeeni d'uftuti, dubbi tana jabeesani d'ossu malani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.11"
              },
              "items": [
                {
                  "text": "Mul 22.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami hedduuni qulqullae aabo womatu d'aba, ammo namnami hamamani woma inhubatu, hameennuma sunini taa; ammo nama qalbi qabu ch'allaati hubata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.10",
            "verseOrgIds": [
              "DAN.12.10"
            ]
          }
        }
      ]
    },
