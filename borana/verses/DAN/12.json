              },
              "items": [
                {
                  "text": "12.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaikaani taani harka lachu gara Waaqa olqabatte, maqa Waaqa haga jiru jireenna jirutini kakhate waan jette, wonti sunini eegi ganni sadiifi jii jaa dabre guutamti. Gaafa gumi Waaqa gaargalchani iraa deebiani wonti kunini gaafasu ya guutamte. Gaafa isiini dubbi suni jette anini artuma jira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.7",
            "verseOrgIds": [
              "DAN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan isiini jettu ind'agaye male ammo inhubanne. Tanaafi anini isii gaafad'e, Aabbo, dubbini tunini akami buufatti? jed'e.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 12:8"
          },
          "items": [
            {
