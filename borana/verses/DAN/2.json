              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi waan Danieli, ka maqaani d'ibiini Belteshazatini jed'e, Atini waan anini oobjad'eefi, waan oobjuuni tiyya d'ooftu naati himu indandeeta?",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.26",
            "verseOrgIds": [
              "DAN.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Danielini waan jed'eeni, Ee hayyicha, nami qarooni, yokhaani falfaltuni, yokhaani nami wohimu, ka yokhaani ayyaana heddu, ka waan suni dandae siti himu injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.27",
            "verseOrgIds": [
              "DAN.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Waaqa gubbati jira, ka dandae waan d'ossani mullisu. Inni, ee hayyicha, yayu waan taka tana taha siti hime. Anini amma oobju atini oobjateefi daayya atini hiriba keesa agartele siti hima.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.28",
            "verseOrgIds": [
              "DAN.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee hayyicha, atini, ato raftu, waan taka tana taha oobjuuni agarte; jennaani Waaqileeni, ka waan d'ossani mullisu waan taka tana taha si agarsiise. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.29",
            "verseOrgIds": [
              "DAN.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti waan d'ossani kana mullisanifi, waan; anini nama ch'ufa ira qarooma qabuniti, ammo, ee hayyicha, atini waan oobjuuni tante d'ooftu baratte herega siti d'ufale hubatu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.30",
            "verseOrgIds": [
              "DAN.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee hayyicha, oobju tante keesa atini akheekha nama gudda bibiliqu, ka nami millatu ch'ufti sodaatu, agarte. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.31",
            "verseOrgIds": [
              "DAN.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mata isaa worqi mid'aadu ch'allaani mid'aasani — qomafi harka isaa qarsiini mid'aasani garaafi gudeeda isaa sibiila diimani mid'aasani; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.32",
            "verseOrgIds": [
              "DAN.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "miila isaa sibiila guraacha, faana isaa sibiila guraachafi faaraani mid'aasani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.33",
            "verseOrgIds": [
              "DAN.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato atini ilaaltu, d'akhaani nami indarbini fiit'e d'akha d'ibi iraa ch'ee, faana waan kaani ta sibiilafi faaraani mid'aasani taani d'ae ch'ach'abse. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.34",
            "verseOrgIds": [
              "DAN.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hojuma suni sibiilafi faarafi sibiila diimafi qarsifi worqiini ch'ach'abt'e, gargari jidde, bullofte, awaara guyya bona oobdi keesaa kaatu fakaatte. Jennaani bubbeeni d'ufte, ka tokole inhambisiini ch'ufa fuute. Ammo d'akhaani akheekha suni d'ae kaani gaara tahe lafa ch'ufa guute.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.35",
            "verseOrgIds": [
              "DAN.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oobjuuni atini oobjate suni amma, ee hayyicha, waan isiini d'ooftu siti hima, ch'aqasi, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.36",
            "verseOrgIds": [
              "DAN.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee hayyicha, atini hayyu lafa jiru ch'ufa ira jirta. Waaqi gubbaa yayu irreefi jabeennafi guddinna sii kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.37",
            "verseOrgIds": [
              "DAN.2.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 2:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni yayu hayyu lafa nami keesa tau ch'ufa si tolche, horifi bineensafi simpirre ch'ufa si jalati bulche. Mataani worqi suni sii. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.38",
            "verseOrgIds": [
              "DAN.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi tante gosa d'ibiti d'ufe lafa tana mohata, ammo worri haga kanke ingahu, eegi sunile ka sadeesoti d'ufa, ka sibiila diima, ka lafa ch'ufa mohatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.39",
            "verseOrgIds": [
              "DAN.2.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 2:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba eege ka afreesoti d'ufa, jabaani aka sibiila guraacha, ka waan ch'ufa gargari ch'ach'abse bulleesu. Akuma sibiili guraachi waan ch'ufa ch'ach'absu, worrileeni finna qara kaani ch'ufa bulleese d'ukeesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.40",
            "verseOrgIds": [
              "DAN.2.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 2:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini ammalle faana isaa ta sibiila guraachafi faaraani mid'aasani ya agarte. Suni wonti isiini garsiiftu, aka finni gargari qoodamu garsiifti. Finna suni keesa, jaba aka sibiilaati jira, akuma atini faarafi sibiila wolkeesa mid'aasani agarte kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.41",
            "verseOrgIds": [
              "DAN.2.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 2:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma quba miila, ka atini agarte kaani gama toko sibiila guraachani mid'aasani, kaani faaraani mid'aasani, akasuma finni suni gami toko jabaate gami kaani laafa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.42",
            "verseOrgIds": [
              "DAN.2.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 2:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle atini sibiila guraachafi faara wolti makhani agarte. Wonti woni suni garsiiftu, aka worri lafa mohatu suni wolfuud'e akasiini taka tahu garsiifti, ammo dandaani woliini intaani, akuma faarafi sibiili guraachi woli intaane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.43",
            "verseOrgIds": [
              "DAN.2.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 2:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bara hayyooti suni lafa fiddu Waaqi gubbaa finna haga jiru jireenna ind'umanneeni d'ufa. Finna suni dandaani indabsatani, ammo inni finna d'ibi ch'ufa balleese haga jiru jireenna mohata. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.44",
            "verseOrgIds": [
              "DAN.2.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini d'akha nami indarbini, ka fiit'e d'akha d'ibi iraa ch'ee, akheekha sibiila guraachafi sibiila diimafi faarafi qarsifi worqiini mid'aasani d'ae agarte. Ee hayyicha, Waaqi guddaani waan taka tana taha si garsiisuu jira. Anini waan atini oobjateefi waan isiini d'ooftule ch'ufa, ka diqole iraa ingorini, ya siti hime.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka hayyichi Danieli galata galche",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 2:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.45",
            "verseOrgIds": [
              "DAN.2.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DAN 2:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyu Nebukadrezani Danieli guddise isa durati lafaani ufi d'ae waan biyyaani jed'e, sorio baasafi hit'aanale aarsafi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.46",
            "verseOrgIds": [
              "DAN.2.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DAN 2:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hayyichi waan Danielini jed'e, D'uguma Waaqi kanke Waaqa Waaqa ch'ufati, ka abba hayyoota ch'ufa ka waan d'ossani ch'ufa namaa mullisu, Tanaafi atini waan d'ossani kana dandeete nati himte. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.47",
            "verseOrgIds": [
              "DAN.2.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DAN 2:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani duuba hayyuuni Danieli ulfinnaafi waan heddu muumme inqamne kenneefi, gudda lafa Babiloni ch'ufa isa tolche, jara hayyu mala d'aule ch'ufa mataa iti tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.48",
            "verseOrgIds": [
              "DAN.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DAN 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kad'acha Danieli gula, hayyichi huji lafa Babiloni ch'ufa harka Shadrakafi Meshekifi Abednego kenne; ammo Danieli hayyuma birati hafe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.49",
            "verseOrgIds": [
              "DAN.2.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Nebukadrezani woi worqiini mid'aase nama ch'ufaani kad'ad'a jed'e",
          "type": "text"
        }
      ]
    }
  ],
