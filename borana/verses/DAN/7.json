        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.27",
            "verseOrgIds": [
              "DAN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti daayyani suni d'ooftu hagasuma. Jennaani anini aka male rifad'e, mudame waan suni biyya d'osse akanumati tae.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elemofi korbeesa Danielini daayyani arge",
          "type": "text"
        }
      ]
    }
