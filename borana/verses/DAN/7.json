              },
              "items": [
                {
                  "text": "14.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daayya suni keesa anini waan nama fakaata arge. Inni, ka dumansa keesa deemu, nati gadi d'ufe, namicha haga jiru jireenna jiru kaaniti qajeele, jennaani isa duraani d'ufani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Mul 11.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani jabeennafi ulfinnaafi irre inni woini fiddu isaa kennani, aka nami gosafi d'alootafi afaani afaani dubbatu ch'ufti isa hojatu. Jabeenni isaa haga jiru jireenna taa, finna isaa muumme inqabu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka waan daayya taani himani",
          "type": "text"
        }
      ]
    },
