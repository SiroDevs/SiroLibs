              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato anini tae ilaalu, gaafa diqa kaani, ka tae kiyyibe ufi saadu, d'agaye. Jennaani ato anini tae ilaalu bineensa afreeso kaani ijeesani reefa isaa ibida keesa buusani gubani. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.11",
            "verseOrgIds": [
              "DAN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa hafe kaani sadeeni jabeenna isaani iraa fuud'ani lubbu isaani haga bulti gabaabdu lakisani.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.12",
            "verseOrgIds": [
              "DAN.7.12"
            ]
          }
        }
      ]
    },
