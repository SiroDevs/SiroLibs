          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.3"
              },
              "items": [
                {
                  "text": "Mul 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "13.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle ato anini tae laalu, bineensi afreeso gadi bahe kunini gudda, hama, nama sodaachisu. Ilkaani isaa ka sibiilatini waan ijeesu gargari ch'ire ira ejaanjata. Inni bineensa kaani ch'ufa iraa gore, gaafa kud'ani qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.7",
            "verseOrgIds": [
              "DAN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.5+REV.13.6"
              },
              "items": [
                {
                  "text": "Mul 13.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ato anini tae gaafa isaa suni ilaalu, gaafi diqaani toko jiddu gaafa kaanitini bahe, gaafi diqaani suni gaafa gugurda kaani sadi bubuqise. Gaafi diqaani suni ila namaatifi afaani kiyyibo ufi totolcha qaba.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.8",
            "verseOrgIds": [
              "DAN.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nama haga jiru jireenna jiru ka Danielini daayyani arge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
