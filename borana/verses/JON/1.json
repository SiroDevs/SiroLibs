            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani AABBO Waaqi qurt'umi guddo toko Yonati erge, isiini isa liqimsite, inni garaa isii keesa guyya sadi oole halkani sadi bule.",
          "type": "text",
          "attrs": {
            "verseId": "JON.1.17",
