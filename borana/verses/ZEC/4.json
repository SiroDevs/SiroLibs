              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani naani dubbatte taani d'ufte, aka nama hiriba keesaa kaasani na kaafte, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.1",
            "verseOrgIds": [
              "ZEC.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maani agarta? jette na gaafatte.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan jed'eeni, Anini waan ifseeni ira ejitu, ka worqiini mid'aasani, arga. Gubba isii d'ameela d'ad'aa jira, ammalle ifse torbati ira ejaanja, ta tamu bututu bobeesaniini torba qabdu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.2",
            "verseOrgIds": [
              "ZEC.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.4"
              },
              "items": [
                {
                  "text": "Mul 11.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammalle ejersa lamati d'aatu isi mirgafi bita jira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.3",
            "verseOrgIds": [
              "ZEC.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini malaika suniini, Aabbo, wonti kunini maani garsiifti? jed'e gaafad'e.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.4",
            "verseOrgIds": [
              "ZEC.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
