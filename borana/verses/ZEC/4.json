              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani anini waan jed'eeni, Mukhi ejersa ka mirgafi bita waan ifseeni ira ejitu jiru ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
