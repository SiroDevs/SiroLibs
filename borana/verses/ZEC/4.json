          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle dameeleeni ejersa lamaani ka d'uyumti worqi d'aatu jirtu, ta d'ad'aani keesaa yau, maani?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
