                "loc": "ZEC.6.12"
              },
              "items": [
                {
                  "text": "Zek 6.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Duuba Yoshua, qaallicha gudda ch'aqasi, ammalle qaalole wahela isaa isanileeni ch'aqasa, isani akheekha dansa milki ka d'ufu: anini hojattu tiyya ta Dame jed'aniini d'ufa! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini Yoshua dura d'akha toko, ka moga torba qabu, kaya. Anini d'akha suni irati wo t'aafe, duuba guyya tokooni ch'ubbu lafa tana iraa fuud'a. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.4"
              },
              "items": [
                {
                  "text": "Mik 4.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja guyyaani suni gahe, isani ch'ufti nama mana isaniti aanu yaamtani nagayaani zabibufi oda keesani jala woliini teetani.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan ifseeni ira ejitu ka daayyani argani",
          "type": "text"
        }
