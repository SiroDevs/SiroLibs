            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yoshuani, ka woya t'uriti ufira qabu, arti eje.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.3",
            "verseOrgIds": [
              "ZEC.3.3"
            ]
          }
        }
