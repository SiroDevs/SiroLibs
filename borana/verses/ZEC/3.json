            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isiini worra isi woliini hojatu kaaniini waan jette, Sure t'uri inqamne isaati mara. Duuba worri akuma suni tolche, woya hareetile, ato malaikaani AABBO Waaqa arti ejitu, iti uyise.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        }
      ]
    },
    {
