                }
              ]
            }
          ]
        },
        {
          "text": " Daayya d'ibi keesa AABBO Waaqi qaallicha gudda, Yoshua jed'ani, ka malaika AABBO Waaqaa dura eju na agarsiise. Ammalle Yoshua d'aatu, gama mirga, Sheet'ana isa himatuti eja. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
