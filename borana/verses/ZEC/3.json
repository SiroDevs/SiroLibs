              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani malaikaani AABBO Waaqaa waan Yoshuani jette, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi Guddaani waan jed'u, Yo atini seera kiyya guutte huji anini sii kenne tolchite, atini Mana kiyyafi qaye isaa, akuma qara hojatte kaani, hojatta; ammalle anini kad'acha tante d'agaye, akuma anini kad'acha malaika na dura ejitu tana d'agayu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
