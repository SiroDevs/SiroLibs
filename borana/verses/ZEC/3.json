              },
              "items": [
                {
                  "text": "Yud 9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani malaikaani AABBO Waaqaa waan Sheet'anani jette, AABBO Waaqi si balleesinna, Sheet'ana! AABBO Waaqi, ka Yerusalemu jaalatu, si balleesina! Nami kunini qoraani ibidaa, ka ibida keesaa fuud'aniniti?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.2",
            "verseOrgIds": [
              "ZEC.3.2"
            ]
          }
        }
      ]
    },
