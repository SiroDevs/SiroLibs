            "sid": "1TH 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nule Waaqa kad'ad'a, oboleyaani tiyya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.25",
            "verseOrgIds": [
              "1TH.5.25"
            ]
          }
        }
