              "items": [
                {
                  "text": "Huji 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Paulofi Silwanofi Timotheoti tatabe tana gara gumi Thesalonike, ta Waaqa Abbatiifi Aabbo Yeso Kristoni taka taate t'aafa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eebafi nagayi ha keesani tahu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jireennafi d'ugefacha gumi Thesalonike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.1",
            "verseOrgIds": [
              "1TH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu hojja ch'ufa maro teesaniifi Waaqaa galata deebimne kad'acha teenna keesa maqa keesani d'oomna. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi nu Waaqafi Abba keenna durati qaabanna, aka isani d'ugefacha teesani hujiini hojattani, aka jaalalti teesani huji guddo isani tolchisiifte, ammalle aka abdiini teesani Aabbo Yeso Kristo keesa jabdu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.3",
            "verseOrgIds": [
              "1TH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu imbeenna, oboleyaani teenna, aka Waaqi isani jaalate isani fohate, aka nama isaa taatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.4",
            "verseOrgIds": [
              "1TH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu Odu Dansa afaani ch'allaani isanii ind'umneeni, ammo jabeennaafi Lubbu Qulqullofi d'uga malaikatini isanii d'umne. Aka nu gaafa isani woliini jiru teenne imbeetani; nu maro dansuma teesaniifi teenne. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.5+ACT.17.6+ACT.17.7+ACT.17.8+ACT.17.9"
              },
              "items": [
                {
                  "text": "Huji 17.5-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuufi Aabbo ufi fakeesitani; ammo ato guddo gaargaltanile, gammada Lubbu Qulqullo iraa argataniini dubbi aka dansa fud'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi isani jara d'ugefate ka Makedoniatiifi ka Akaya akheekha taatani. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi dubbini Aabbo isani ira baate, Makedoniafi Akaya ch'alla ingeenne ammo oduuni d'ugefacha isani Waaqa d'ugefattani ya fulla ch'ufa geete. Wonti nu jechu malle injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.8",
            "verseOrgIds": [
              "1TH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ch'ufti waan gaafa nu gara keesani d'umne, ka isani aka dansa nu bulchitani, dubbata, aka isani waan harkaani boch'ani lakiftani Waaqati deebitani, Waaqa d'uga ka jiru hojattani, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.9",
            "verseOrgIds": [
              "1TH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma isaa ka gubba gadi d'ufu eegattani, Ilma isaa Yeso, ka inni duisa keesaa kaase, dalansu Waaqa ta hegeri d'uftu duraa nu baasu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.10",
            "verseOrgIds": [
              "1TH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Huji Paulo Thesalonike keesa",
          "type": "text"
        }
      ]
    }
  ],
