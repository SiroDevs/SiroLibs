        },
        {
          "text": " miili isaa aka sibiila bassani qulqulleesani ifsa, qonqooni isaa akuma galaana dibbifti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni urji torba harka mirgicha qaba, aflameedi qara qabduti afaani isaa keesa jira. Fuuli isaa aka adu guyya gudda ifsa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        },
        {
