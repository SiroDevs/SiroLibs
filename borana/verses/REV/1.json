                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jiddu ifse suni keesa waan aka nama jira tokoti eja, ubaari isaa miila gaha, qoma isaa gubbati woya worqiti mara qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
