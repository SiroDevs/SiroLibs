            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini garagale, aka qonqo naani dubbatu argu. Garagalaani anini waan ifseeni ira ejaanjitu torba ta worqi arge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
