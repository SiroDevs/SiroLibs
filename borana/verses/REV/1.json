              "items": [
                {
                  "text": "10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Rifeensi mata isaa akuma boofta adaate, adi aka haama, ilti isaleeni aka ibida bobeete; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
