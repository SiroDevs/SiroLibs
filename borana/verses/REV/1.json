                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yeso Kristoni, d'ugaani d'ugefatani, Ilmi angafa ka duisa keesaa kaasani, ka hayyu hayyoota lafa tana, eebafi nagaya isani kenninna.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
