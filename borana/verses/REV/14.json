            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anini millannaani, dumansa adi, ka nami Ilma Nama fakaatu gubba tau arge. Inni sure worqi mataa qaba ammalle haamtu qara qabdu harkaa qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.14",
            "verseOrgIds": [
              "REV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yoe 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Malaikaani d'ibiini Mana Waaqa keesaa baate, nama dumansa gubba tau qonqo guddooni yaamte waan jetteeni, Haamtu tante fud'ad'u haami. Hojjaani haamani yayu geete; mid'aani yayu bilchaatani muraansa gahani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.15",
            "verseOrgIds": [
              "REV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani nami dumansa gubba tau kaani haamtu ufi fud'ate haame, akanaani mid'aani lafa haamani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.16",
            "verseOrgIds": [
              "REV.14.16"
            ]
          }
        }
      ]
