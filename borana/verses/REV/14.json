          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi malaikaani haamtu ufi fud'atte, mid'aani zabibu guurte, duuba fulla zabibu iti ch'ach'arasani ta dalansu Waaqa keesa buufte. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.19",
