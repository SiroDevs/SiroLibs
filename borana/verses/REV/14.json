          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jari qulqullooni ka seera Waaqa guute d'ugefacha Yeso jabeesu, waan kana obsu male.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.12",
