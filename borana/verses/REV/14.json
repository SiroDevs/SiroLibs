          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini qonqo gubba baate ta, Waan kana t'aafi, Ayyaana isaa nama armaa achi huji Aabbo keesati duu jettu d'agaye! Lubbuuni waan jettu, D'uguma akasi. Worri suni huji jabdu iraa boqota, waan hujiini worraa worra gula deemtuufi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.13",
            "verseOrgIds": [
              "REV.14.13"
            ]
          }
        }
      ]
    },
