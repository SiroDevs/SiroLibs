              },
              "items": [
                {
                  "text": "Isa 34.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aari ibida worra gaargalchu haga hegeri oli deema. Nama bineensafi akheekha isaa kad'atuufi ka beesisa maqa isaa argate ufira qabuleeni boqota inargatu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.11",
            "verseOrgIds": [
              "REV.14.11"
            ]
