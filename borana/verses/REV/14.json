              "items": [
                {
                  "text": "Eze 38.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " inni daad'i dalansu Waaqa d'uga, ta ato ilaafisiini mudunu dalansu isati naqani! Ammalle ibidafi qanqeeni fuula malaika qulqullofi Ilme Hoola durati isa gaargalchani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.10",
            "verseOrgIds": [
              "REV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 14:11"
          },
          "items": [
            {
