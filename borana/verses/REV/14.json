          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani d'ibiini, ta sadeeso, lamaani taani gula deemte waan jette, Yo nami tokoleeni bineensafi akheekha isaa ka boch'ani guddise, ammalle akheekha adda yokhaani harka ufi ira argate, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.9",
            "verseOrgIds": [
