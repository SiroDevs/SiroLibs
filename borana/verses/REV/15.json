              "type": "text"
            }
          ]
        },
        {
          "text": " Eegi waan kana anini gubba millannaani Mana Waaqa ka Waarooni d'uga ke jirtu, Ka banisa qabu arge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
