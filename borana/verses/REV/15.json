          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani torbaani ta gaargala torba harkaa qabdu keesaa yaate, woya boofta adi uyifatani, woya worqi qomati maratani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani waan lubbu qaba afraani kaani keesa toko qori torba ta worqi ta dalansu Waaqa ammafi hegerile jirutiini guutani, toko toko malaika torbaanti kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
