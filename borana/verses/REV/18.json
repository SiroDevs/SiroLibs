                {
                  "text": "36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Daldaltuuni lafaa isii lalefatte booti, waan nami iti deebie miha worraa imbitannefi; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.11",
            "verseOrgIds": [
              "REV.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
