            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jara gugurda hobolotiifi worra hobolo yaabatufi ka hobolo keesa hojatufi ka galaana keesaa liqimsa argatu ch'ufti fago iraa ejaanjani, aara gubacha isii argani ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.32"
              },
              "items": [
                {
                  "text": "Eze 27.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " bohani waan jed'ani, Diri aka dira gudda kana tokoleeni lafaa wa jira? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
            "verseOrgIds": [
              "REV.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.30+EZK.27.31+EZK.27.32+EZK.27.33+EZK.27.34"
              },
              "items": [
                {
                  "text": "Eze 27.30-34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Awaara mata gubbati guuratani, bohani iyani waan jed'ani, Waan dabaati! Gaargala dira guddati! Worri hobolo bisaani keesa deemtu qabu ch'ufti isa keesati duroome. Ammo saatuma toko keesati ya waan ch'ufa d'abe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.19",
            "verseOrgIds": [
              "REV.18.19"
            ]
          }
        }
      ]
    },
    {
