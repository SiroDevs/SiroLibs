              "items": [
                {
                  "text": "Yer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Isiini daad'i ufi gosa ch'ufa obaafte, daad'i jabdu ta d'araani isii hamtu. Hayyooti lafaa isi woliini rafte, daldaltuuni lafaa d'araa isi hamtuuni duroomte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
