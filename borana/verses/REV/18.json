            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hayyooti lafa tana isi woliini rafte, hameenna tolchite, aara gubacha isii keesa yau argite booti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri maro gaargala isii sodaatufi fago ejaanje waan jed'u Waan dabaati! Waan hamtu! Dira Babiloni gudda kana! Saatuma toko keesati ya si gaargalchani!",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
