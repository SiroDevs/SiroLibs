                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Mul 14.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Sheeftiini qara qabdu afaani isaa keesaa baate, ta inni gosa ch'ufaani dabsatu. Inni ule sibiilatiini worra fide, daad'i dalansu Waaqa Gudda ch'unfa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woya isatiifi miila isaa gubbati maqa isaa t'aafani, Hayyu hayyoota, Aabbo abbooti ch'ufa jed'ani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
