        {
          "text": " Jennaani anini malaika adu keesa ejitu arge. Isiini qonqo guddooni simpirre gubba bariftu ch'ufa yaamte, Koota, jila Aabbo guddoti woli woldaa! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koota, fooni hayyootatiifi ka abbooti duulatiifi ka askartitiifi ka fardatiifi ka nama farda yaabatutiifi fooni nama ch'ufa, tisseefi balchale, diqaafi guddale nyaad'a jette.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
