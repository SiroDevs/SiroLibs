              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duula worraa, sheefti afaani namicha farda yaabatu keesa baatuuti fit'e: allaatiini haguma dandeetu ch'ufa fooni worraa nyaatte.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.21",
