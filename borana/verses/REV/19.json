        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.13"
              },
              "items": [
                {
                  "text": "Far 115.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani fulla barch'uma guddinnati qonqooni gadi baate waan jette, Waaqa keenna faarsa, hojattuuni isaa ch'ufti, nami ch'ufti diqaafi guddaleeni, nami isa sodaatu ch'ufti! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.24"
              },
              "items": [
                {
                  "text": "Eze 1.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.93.1"
              },
              "items": [
                {
                  "text": "Far 93.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.1"
              },
              "items": [
                {
                  "text": "97.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.99.1"
              },
              "items": [
                {
                  "text": "99.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani anini waan aka qonqo nama heddufi waan aka bisaani guddo gubbaa gadi jigatifi, waan aka qawe mandiisu d'agaye. Ammalle waan jed'ani, Waaqa faarsa! Wonti akanatiifi Aabbooni, Waaqi keenna Guddaani, Hayyu! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gammanna, qilit'amna; guddinna isaa faarsina. Hojjaani Ilmeeni Hoola dubra fuutu ya geete, intalti inni fuud'u ya kurfefatte. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ee jed'ani aka woya boofta adi d'aati keyattu. (Booftaani suni huji d'uga ta worra Waaqa.)",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
