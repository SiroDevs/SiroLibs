            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara malaika Thiatira waan kana t'aafi:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
