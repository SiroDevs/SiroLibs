              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma suni nama barsiisa worra Nikolai gula yau qabda. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
