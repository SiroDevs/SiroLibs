            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daba iraa deebii yoosi. Yokhaani anini hurrise siti d'ufe, worra suni sheefti afaani kiyya keesa jirtuuni had'a. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
