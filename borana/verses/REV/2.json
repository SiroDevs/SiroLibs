          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dabsatu anini mid'aani mukha jireenna, ka oobru Waaqa keesati bahu, nyaachisa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
