              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isaniini kaani Thiatira keesa, ka barsiisa hamtu tana gula indeemne, yokhaani waan nami gari baddi Sheet'ana jed'uuni imbaratiini, anini baa d'ibi isani ira inkayu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.24",
            "verseOrgIds": [
              "REV.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo waan harkaa qabdani suni jabeesa, haga anini d'ufuti. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.25",
            "verseOrgIds": [
              "REV.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.8+PSA.2.9"
              },
              "items": [
                {
                  "text": "Far 2.8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nama dabsate huji tiyya haga muumme tolchu, anini jabeenna gosa ch'ufaani fidani kennaafi, jabeenna anini Aabbo ira argad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.26",
            "verseOrgIds": [
              "REV.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ule sibiilatiini worra fida, duuba akuma okote faara ch'absani gargari worra ch'ach'absa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.27",
            "verseOrgIds": [
              "REV.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "REV 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle anini bakalcha bari worraa kenna.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.28",
            "verseOrgIds": [
              "REV.2.28"
            ]
          }
        }
      ]
