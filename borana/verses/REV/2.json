              "items": [
                {
                  "text": "Far 62.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini ijoolle isile d'ae fit'a, duuba gumiini ch'ufti aka anini heregafi garaa nama ch'ufa ilaalu baratti. Ammalle anini isanii ch'ufa, huji teesani gula, woi isani kenna.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.23",
            "verseOrgIds": [
              "REV.2.23"
            ]
          }
        }
      ]
