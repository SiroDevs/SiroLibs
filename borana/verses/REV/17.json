              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jennaani malaika torbaani, qori torbaani harkaa qabdu keesa toko, gara kiyya d'ufte waan naani jette, Kooti aka sharmut'iti guddo gaargalchani sii garsiisa, isiini dira gudda kaani, ka afaani galaana hedduti jaarani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.1",
            "verseOrgIds": [
              "REV.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.17"
              },
              "items": [
                {
                  "text": "Isa 23.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hayyooti lafa sharmut'iti tana woliini hameenna tolchite, nami lafaa ch'ufa farso hameenna isii kaani d'uge machae.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.2",
            "verseOrgIds": [
              "REV.17.2"
            ]
          }
        }
      ]
    },
    {
