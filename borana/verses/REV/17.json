              "REV.17.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.13.1"
              },
              "items": [
                {
                  "text": "Mul 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Lubbuuni na fuute, malaikaani lafa gamooji naa geesite. Achiti anini niiti toko, ta bineensa diima maqa hamama irati t'aafani gubba teetu, arge; bineensi suni mata torbaafi gaafa kud'ani qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.3",
            "verseOrgIds": [
              "REV.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.7"
              },
              "items": [
                {
                  "text": "Yer 51.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Niitiini woya diimtufi daalati uyifatte, miha worqitiifi d'akha mimid'aagafi dooqa naqatte. Mudunu worqi ta waan t'uri qaba qabduufi ta t'uri algalooma isii qabdu harkaa qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.4",
            "verseOrgIds": [
              "REV.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adda isi gubba maqa waan d'ossa irati t'aafani: Babiloni Guddo, haad'a sharmut'afi t'uri lafa keesa jirtu ch'ufa jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.5",
            "verseOrgIds": [
              "REV.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini aka niitiini d'iiga worra Waaqatiifi ka worra Yeso d'ugefate ka fit'aniini machoofte arge.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi arginaani anini guddo maadefad'e. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.6",
            "verseOrgIds": [
              "REV.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani Waan naani jette, Maafi maadefatte? Anini waan d'ossa ka niititiifi waan bineensa isii baatu, ka mata torbaafi gaafa kud'ani qabu siti hima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.7",
            "verseOrgIds": [
              "REV.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.7"
              },
              "items": [
                {
                  "text": "Dan 7.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.7"
              },
              "items": [
                {
                  "text": "Mul 11.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.28"
              },
              "items": [
                {
                  "text": "Far 69.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bineensi atini argate suni duri injira, ammo amma injiru; diquma boola keesaa imbahiini, aka balleesani. Nami lafa keesa jiru, ka maqa worraa, ato lafti inuumamiini, kitaaba jireenna keesati int'aafiini, yo bineensa suni ilaalani imaadefatani. Wonti akanatiifi inni duri injira ammo amma injiru, hegeri imullata.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.8",
            "verseOrgIds": [
              "REV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti kunini qalbifi hubacha feeti. Mataani torbaani gaareeni torbaani ka niitiini gubba teetu. Ammalle mataani suni hayyoota torba: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.9",
            "verseOrgIds": [
              "REV.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "shani yayu hayyuma d'abde, toko ammalle mohu jira, toko ind'umne; yo d'ufe diqo toko ch'alla tau male. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.10",
            "verseOrgIds": [
              "REV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi duri jiru, ka amma injirre, hayyu saddeeteesooti, ka torbaani kaani ke jiru, ammo kae deemu, aka balleesani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.11",
            "verseOrgIds": [
              "REV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.24"
              },
              "items": [
                {
                  "text": "Dan 7.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafi kud'ani, ka atini agarte, hayyoota kud'ani, ta ammalle imohatiini, ammo ta jabeenna mohatuuni, bineensa woliini, haga saa toko iti kennani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.12",
            "verseOrgIds": [
              "REV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri kunini ch'ufti herega takaa qaba, aka humnafi jabeenna ufi ch'ufa bineensa suni kennani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.13",
            "verseOrgIds": [
              "REV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma Hoola inhad'ani ammo Ilme Hoolatiifi jari d'uga ka isii gula yau, ka isiini fohate yaamte worra dabsata, waan isiini guddo abbooti ch'ufatiifi, hayyu hayyoota ch'ufa tatefi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.14",
            "verseOrgIds": [
              "REV.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malaikaani ammalle waan naani jette, Bisaani atini garte, ka niitiini gubba teetu, gosafi gumifi lafafi afaani heddu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.15",
            "verseOrgIds": [
              "REV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa kud'annaani atini garteefi bineensileeni sharmut'iti taani injiba; waan isiini qabdu ch'ufa fud'atani, qulla isii lakisani; fooni isii nyaatani, ibidaani isii gubani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.16",
            "verseOrgIds": [
              "REV.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqati fed'i inni fed'u aka tolchani garaa worraa ke kaye, aka worri waan takaa tahe, jabeenna mohatuuni bineensaa kennu haga dubbini Waaqa guutamtuuti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
              "REV.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
