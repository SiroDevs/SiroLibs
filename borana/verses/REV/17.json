          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.17",
            "verseOrgIds": [
              "REV.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini atini garte sunini dira gudda ka hayyoota lafa mohatu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.17.18",
            "verseOrgIds": [
              "REV.17.18"
            ]
          }
        }
      ]
    },
    {
