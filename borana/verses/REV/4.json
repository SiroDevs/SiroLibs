        },
        {
          "text": "Barch'uma guddinna suni keesaa hangaasufi iyanafi mandiisuuni baate. Ammalle barch'uma durale ifse torba ta ibidati bobaa; tunini lubbu Waaqa torba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
