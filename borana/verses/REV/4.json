              },
              "items": [
                {
                  "text": "10.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maro tokotu Lubbuuni Waaqa na seente, olmillannaani barch'uma guddinna toko ka nami ira tau gubbati arge. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fuuli isaa akuma d'akha daalachafi diima ifse; ammalle d'awatu barch'uma suni ule Waaqa, ta aka waan dotaatu fakaatuti jira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'awatu barch'uma suni barch'uma diddami afuri d'ibiti jira, ammalle barch'uma suni gubba jaarole diddami afuri, ta woya adi uyifatte sure hayyuma maratteti jira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.4",
            "verseOrgIds": [
              "REV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
