                  "text": "Yud 9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani loli gubbati bahe! Mikaelifi malaikaani isaa jawe taaniini wolhaate, jaweleeni malaika ufitiini wolhaate; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.7",
            "verseOrgIds": [
              "REV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo jawe dabsatani, isiifi malaika isii gubba tau d'owani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.8",
            "verseOrgIds": [
              "REV.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.1"
              },
              "items": [
                {
                  "text": "Uum 3.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.18"
              },
              "items": [
                {
                  "text": "Luk 10.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jawe guddo taani gadigatani! Isiini suni bofa duri kaani, ka Sheet'ana yokhaani Jinni jed'aniini, ka lafa ch'ufa sobe. Isaafi malaika isaa ch'ufa lafati gatani.",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        }
      ]
