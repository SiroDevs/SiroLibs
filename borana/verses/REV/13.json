                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.7+REV.17.8+REV.17.9+REV.17.10+REV.17.11+REV.17.12"
              },
              "items": [
                {
                  "text": "7-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jennaani anini bineensa toko ka galaana keesaa bahu arge. Gaafa kud'anifi mata torba qaba, gaafa ch'ufa ira sure hayyumati jira, mata ch'ufa irati maqa hamama t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.4+DAN.7.5+DAN.7.6"
              },
              "items": [
                {
                  "text": "Dan 7.4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bineensi suni aka qeeramsa jira, miili isaa aka miila goorjama jira, afaani isaa aka afaani nyeench'a jirani. Jaweeni taani jabeennaafi guddinnaafi humna ufi ch'ufa bineensa suni kennite. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.2",
            "verseOrgIds": [
              "REV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataani bineensa suni toko mada guddo hamtu qaba, ammo madaani taani la fayyite. Lafti ch'ufti mamte, bineensa kaani gula yaate. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.3",
            "verseOrgIds": [
              "REV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ch'ufti jawe guddise, waan inni jabeenna ufi ch'ufa bineensa kaani kenneefi. Bineensale guddisani kad'atani waan jed'ani, Eentu aka bineensa kana jira? Eentu dandae isa had'a?",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.4",
            "verseOrgIds": [
              "REV.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
