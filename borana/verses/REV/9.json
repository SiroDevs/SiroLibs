                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.5.23"
              },
              "items": [
                {
                  "text": "Dan 5.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nami lafati hafe kaani, ka gaargali kunini inijeesiini, waan harka ufitiini mid'aafatani kaani iraa indeebine, jinniifi waan harkaani boch'ani ka worqifi qarsifi saldaqafi d'akhafi mukhaani mid'aasani, ka dandae lafa ingarre, ka woma indandeenne, ka dandae indeemne, kad'achu illakimne. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.9.20",
            "verseOrgIds": [
              "REV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijeechafi falfalafi algaloomafi hanna tolchani, tokole iraa indeebine.",
          "type": "text",
          "attrs": {
