          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami daalle guddise owise, akuma nama d'akha gullubaani darbani gulluba keesati hid'u jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.8",
