            "number": "5",
            "style": "v",
            "sid": "PRO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama dubbi aka injirre si gaafate, atinileeni dubbuma aka injirre deebisifi, duuba nami si gaafate sunini aka woma imbeenne ufi arga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.5",
            "verseOrgIds": [
              "PRO.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
