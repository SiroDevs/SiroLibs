          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mammaasi daalle, akuma nama miila naafate, woma imbaanefiini, deemu jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.7",
            "verseOrgIds": [
              "PRO.26.7"
            ]
          }
        }
      ]
