          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daalleeni mammaakhu akuma nama farso d'uge machae, qorati harka keesa fud'atu, jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.9",
