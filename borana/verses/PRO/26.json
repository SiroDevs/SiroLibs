          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma qabanti bona hagayya infakaanne, yokhaani bokeenileeni fulla mid'aani murani infakaanne, ulfinnileeni daalle infakaanne.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.1",
            "verseOrgIds": [
              "PRO.26.1"
            ]
          }
        }
      ]
    },
    {
