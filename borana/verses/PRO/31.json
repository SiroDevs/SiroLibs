              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini arja, hiyyeesafi nama laafale ch'ufa wo kennitifi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.20",
            "verseOrgIds": [
              "PRO.31.20"
            ]
          }
        },
        {
