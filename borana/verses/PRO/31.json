              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini waan mid'aasitu ch'ufa aka keesaa woi argattu imbeeti, tanaafi halkanile ifse bobeesite hojatti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.18",
