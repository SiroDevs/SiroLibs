          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini d'aamochale insodaatu, wonti akanatiifi worra isii ch'ufa ya woya d'aamocha d'owartu mid'aasite.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.21",
            "verseOrgIds": [
