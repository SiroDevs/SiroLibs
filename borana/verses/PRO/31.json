          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini ganamaa kaate sagale worra isiiti d'aabde, dubra isii hojatule huji garsiifti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.15",
            "verseOrgIds": [
              "PRO.31.15"
            ]
          }
        }
