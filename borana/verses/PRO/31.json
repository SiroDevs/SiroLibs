      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.11",
            "verseOrgIds": [
              "PRO.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini haga jirtu ch'ufa isa qarqaarti, waan dansa male waan hamtu isa intolchitu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.12",
            "verseOrgIds": [
              "PRO.31.12"
            ]
          }
        }
      ]
    },
    {
