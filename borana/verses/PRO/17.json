          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami wo beekhu jecha tokooni wo barata, ammo daalle uleeni d'ibba tokoleeni woi imbarsiiftu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.10",
            "verseOrgIds": [
              "PRO.17.10"
            ]
