          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worqifi qarsi ibidaani bassani ilaalani, AABBO Waaqileeni akasuma garaa namaa laala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.3",
            "verseOrgIds": [
              "PRO.17.3"
            ]
          }
        }
      ]
    },
    {
