              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi nama nama d'uga gula deemu dabsufi yokhaani nama nama hama baasule diqole infed'u.",
          "type": "text",
          "attrs": {
