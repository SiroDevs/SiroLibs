          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nama gumbeesu, waan nama suni falfale waan fed'u ch'ufa ira argatu ufi seha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.8",
            "verseOrgIds": [
              "PRO.17.8"
            ]
          }
        }
