          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Horini woi barachaa jed'ani daalleti baasani, ka inni ufiftu qalbi inqamne, mali baha?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.16",
