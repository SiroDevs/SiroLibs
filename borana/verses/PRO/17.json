          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hamaani waan hamtu ch'aqasa, kiyyibaleeni kiyyiba ch'aqasa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.4",
            "verseOrgIds": [
              "PRO.17.4"
            ]
          }
        }
      ]
    },
    {
