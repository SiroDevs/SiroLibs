            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla nama daalle tae waan aka injirre hojatu argani, nama gorjama ilmaani jala fit'ani arguti ira jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.12",
