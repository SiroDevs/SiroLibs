            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaallowaani yo ch'ufa woli jaalati. Oboleesi, yo atini gaargala qabdu si inqarqaare, oboleesa maani?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.17",
            "verseOrgIds": [
              "PRO.17.17"
            ]
          }
