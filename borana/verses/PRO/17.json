          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama nagayaani qit'a gogeesa nyaatuti, nama mana ufi keesati jila tolfate, jila suni keesati woldidu, ira jira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.1",
            "verseOrgIds": [
              "PRO.17.1"
            ]
          }
        }
      ]
    },
    {
