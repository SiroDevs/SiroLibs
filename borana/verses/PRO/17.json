          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami wollaala biraa namaa deemu nama nagaya barbaadu, ammo nami haalo fuud'u nama waan hamtu barbaade jaalani ufileeni wold'abuni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.9",
            "verseOrgIds": [
              "PRO.17.9"
