          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama ch'ubbicha waan hamtu barbaadu, waan hamtu isa ijeesa iti ergani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.17.11",
