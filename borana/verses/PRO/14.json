              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo qotiyo lafaani qotatu inqamne khod'oni tante duwa, ammo nami sanga lafaani qotatu qabu aka dansa mid'aani argate khod'o guuta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.14.4",
