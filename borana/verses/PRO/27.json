          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma qarsifi worqi bassani ilaalani, akasuma gurra namaa hamafi tolalle laalani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.21",
            "verseOrgIds": [
