              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami isi ch'allisisiti iti game namuma bubbe d'owe yokhaani d'ad'a harkati naqate jigu d'owu fakaata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.16",
