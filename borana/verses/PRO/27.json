          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ganamaani jaala ufiiti lalabe nagaya fuud'e lafaa kaasu seeruma nama isa abaare.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.14",
