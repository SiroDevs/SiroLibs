          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo harki nyaapa keeti si madeesele womaniti, ammo d'ungo nyaapa keeti ufira eegad'i.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.6",
            "verseOrgIds": [
              "PRO.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
