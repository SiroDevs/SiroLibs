          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo mukha oda qorqorate mid'aani isaa nyaata, ammalle nami abba isaa qorqoratuleeni gurra dansa argata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.18",
