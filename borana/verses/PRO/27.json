          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuma gaandidu namaa dandaani bisaani keesati argani, akasuma garaa ufi keesaleti nami aka jiru ufi arga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.19",
            "verseOrgIds": [
              "PRO.27.19"
            ]
          }
        }
      ]
    },
