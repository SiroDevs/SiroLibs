          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato atini daalle butuchite d'aantele daalluma isaa dandeete keesaa imbaaftu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.22",
            "verseOrgIds": [
              "PRO.27.22"
