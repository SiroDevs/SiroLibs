          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami aka male daallae nama fuula imbeenneni, Anati gati si baasa jed'u, hori isaa aka qabdoti iraa fuud'u malani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.13",
            "verseOrgIds": [
              "PRO.27.13"
            ]
          }
        }
