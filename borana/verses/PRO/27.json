          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'ibiini ato keessumale taate ha si saaduti, ammo atini ufi insaadini.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.2",
            "verseOrgIds": [
              "PRO.27.2"
            ]
          }
        }
