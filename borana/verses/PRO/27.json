          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'ibi daalleeni namaatiini d'uftu maansafi d'akhaale ira namati ulfaata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.3",
            "verseOrgIds": [
              "PRO.27.3"
            ]
          }
        }
      ]
