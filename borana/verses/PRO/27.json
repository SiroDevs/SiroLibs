          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loonifi ree tante haga dandeetu aka dansa qorqorad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.23",
            "verseOrgIds": [
              "PRO.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi horiini waan bara tokofa d'abani. Hayyuleeni haga jiru jireenna intau. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.24",
            "verseOrgIds": [
              "PRO.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo fulla atini okhaya haamteefi buuyoni d'ibiini baateeni, duuba ammalle buuyo gaara ira jirtule ch'ufa haamani. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.25",
            "verseOrgIds": [
              "PRO.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini dandeete rifeensa hooliye tanteeti baddoni d'aate, beese atini ree tante gurgurraani argatele lafaani bitata. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.26",
            "verseOrgIds": [
              "PRO.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reeni ira hafte taani siifi worra keetifi dubra si hojatule ameesa taati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.27",
            "verseOrgIds": [
              "PRO.27.27"
            ]
          }
