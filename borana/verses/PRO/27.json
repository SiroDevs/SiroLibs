          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'araani namaa akuma boola ekhera jirti — ta haguma jirtu inguutamne.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.27.20",
            "verseOrgIds": [
              "PRO.27.20"
            ]
