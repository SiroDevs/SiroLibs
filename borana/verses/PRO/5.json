  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "PRO 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma kiyya, ch'aqasi, beekhaafi hubacha tiyya gula deemi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.1",
            "verseOrgIds": [
              "PRO.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba adaba dansa horatte, dubbini teetileeni aka atini woi beetu garsiifti. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.2",
            "verseOrgIds": [
              "PRO.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato afaani niiti nama d'ibi aka damma miaani d'ugooni isiileeni aka d'ad'a jiratellee ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.3",
            "verseOrgIds": [
              "PRO.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eege isiini had'aa qaraaru siti taate duani siti d'ufti. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.4",
            "verseOrgIds": [
              "PRO.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini awaalati si geesite boola keesa si buufti. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.5",
            "verseOrgIds": [
              "PRO.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini kara jireenna gula indeemtu, ato imbeenne iraa gorti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.6",
            "verseOrgIds": [
              "PRO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani tiyya, amma na ch'aqasa, dubbi tiyya iraa ingorina. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.7",
            "verseOrgIds": [
              "PRO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiti akana iraa fagaad'a balbala isiile dura imbahiina. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.8",
            "verseOrgIds": [
              "PRO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo baatani gurri isani bade, ato kaimaatu harka nama naasu inqamnetini hobaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.9",
            "verseOrgIds": [
              "PRO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, nami d'ibiini waan isani horatini ch'ufa guurate, hori keesani nami d'ibiini d'aala. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.10",
            "verseOrgIds": [
              "PRO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini yo nafi kanke d'umate dua ch'iiftu waan jettu, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.11",
            "verseOrgIds": [
              "PRO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini maafi qara woi barachu jibbe gorsa nama na qajeelchule dida? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.12",
            "verseOrgIds": [
              "PRO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini duri nama na barsiisu inch'aqamne yokhaani gorsa worraale ind'ageenne. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.13",
            "verseOrgIds": [
              "PRO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akami ato anini woma quba inqamne biyya keesaa gurri na bada? jetta.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.14",
            "verseOrgIds": [
              "PRO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niiti tante jabeesi, isuma ch'alla jaalad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.15",
            "verseOrgIds": [
              "PRO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleeni atini nad'eeni biyya iraa d'altu woma sii imbaatu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.16",
            "verseOrgIds": [
              "PRO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoolleeni atini d'alte suni si inqarqaartu, nama d'ibi qarqaarti. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.17",
            "verseOrgIds": [
              "PRO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi niiti atini fuute woliini gammada, intala fuute woliini qilit'ama — ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.18",
            "verseOrgIds": [
              "PRO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mid'aadu aka gugufto. Mid'aagumti isi ha si gammachiiftu; jaalalti isi ha si maraachitu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma kiyya, atini maanifi niiti nama d'ibi jaalate gula maratta? Atini mid'aaguma niiti nama d'ibi maafi halchita? ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.20",
            "verseOrgIds": [
              "PRO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan atini tolchitu ch'ufa AABBO Waaqi inarga, fulla atini deemtu ch'ufa inni inilaala. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.21",
            "verseOrgIds": [
              "PRO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dabi nama hama t'urura iti tahe, ch'ubbumani isaa isa qabdi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.22",
            "verseOrgIds": [
              "PRO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan obsa inqamneefi dua, daallumuma isaati boolati isa galcha.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.23",
            "verseOrgIds": [
              "PRO.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gorsa d'ibi",
          "type": "text"
        }
      ]
    }
  ],
