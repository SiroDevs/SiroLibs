              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dansaani AABBO Waaqa ira eeba argata, ammo inni nama waan hamtu namati malatu wollaala iti mura.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.2",
            "verseOrgIds": [
              "PRO.12.2"
            ]
