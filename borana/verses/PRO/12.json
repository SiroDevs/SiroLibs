        {
          "text": "Ch'ubbichi indua, daarale inhoratu, ammo nama d'ugaa worri isaa haguma jiru ch'ufa injira.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.7",
            "verseOrgIds": [
