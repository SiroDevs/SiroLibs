          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami hamani jireenna isaa keesa jajabaate ineju, ammo nami d'ugaa inchochou, jajabaateti eja.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.3",
            "verseOrgIds": [
              "PRO.12.3"
