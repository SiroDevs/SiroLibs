          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbini ch'ubbicha waan nama ijeesati, ammo dubbini d'ugaa lubbu namaa baafti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.6",
            "verseOrgIds": [
              "PRO.12.6"
            ]
          }
