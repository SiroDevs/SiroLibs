          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini dansaani gaad'a d'iirsaati, ammo niitiini hamtuni d'iirsaa inch'eere d'ukuba hama lafa keesati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.4",
