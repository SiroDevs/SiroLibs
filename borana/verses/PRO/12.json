              "type": "text"
            }
          ]
        },
        {
          "text": "Heregi nama d'ugaa kama d'ugaati, ammo heregi ch'ubbicha waan d'araati.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.12.5",
            "verseOrgIds": [
              "PRO.12.5"
