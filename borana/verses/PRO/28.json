          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayyaana isati ka AABBO Waaqa sodaatu, ammo nami mata jabaate wodidu inuma bada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.14",
            "verseOrgIds": [
              "PRO.28.14"
            ]
          }
        }
      ]
