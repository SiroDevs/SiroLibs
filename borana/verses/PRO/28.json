          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ch'ubbu ufi d'ossu woma inhoratu, ammo nama ch'ubbu ufi himate iraa deebiu Waaqi innahaafi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.13",
            "verseOrgIds": [
              "PRO.28.13"
            ]
          }
        }
      ]
