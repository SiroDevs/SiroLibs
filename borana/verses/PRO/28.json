          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami d'uga gula deemu waan hamtu jalaa baha, ammo nami ch'ubbu gula deemu diirama jige bada.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.18",
            "verseOrgIds": [
              "PRO.28.18"
            ]
          }
        }
