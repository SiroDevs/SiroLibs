          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.15",
            "verseOrgIds": [
              "PRO.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami daalleeni lafa mohatu nama dabse, irreeni nama bulcha, ammo nami daba didu bara heddu lafa fida.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.16",
            "verseOrgIds": [
              "PRO.28.16"
            ]
          }
        }
      ]
    },
