        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.11",
            "verseOrgIds": [
              "PRO.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami d'uga guddinna lafaani fidu argatu, nami ch'ufti ingammada, ammo yo nami hamaani lafa fidu nami ch'ufti ind'okhata.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.28.12",
            "verseOrgIds": [
              "PRO.28.12"
            ]
          }
        }
      ]
    },
    {
