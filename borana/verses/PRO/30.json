          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan afuri d'ibiti jira, ka yo yaatu nama mamsiiftu: ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.29",
            "verseOrgIds": [
              "PRO.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyeench'a, jaba bineensa ch'ufa ira, ka woma insodaanne; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.30",
            "verseOrgIds": [
              "PRO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "laleesa ree, korma luku, hayyu nama dura deemu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.31",
            "verseOrgIds": [
              "PRO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo atini qara daalloofte ufi kiyyibsifte waan hamtu malatte, afaani qabad'i waan suni heregi, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.32",
            "verseOrgIds": [
              "PRO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "yo atini aanani raafte, d'ad'a keesaa baafta. Yo atini nama funnani keesa d'ooftele inni infununa; ammalle yo atini dubbi kokhorsite nama dallansiifte, lolati d'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.33",
            "verseOrgIds": [
              "PRO.30.33"
            ]
