{
  "id": "PRO.7",
  "number": "7",
  "bookId": "PRO",
  "reference": "Mammaasa 7",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "PRO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilma kiyya, dubbi tiyya ch'aqasi, waan anini siti himu inded'ini. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.1",
            "verseOrgIds": [
              "PRO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seera kiyya jabeesi, duuba injiraata. Barsiisa tiyya akuma ila tante qorqoratu qorqorad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.2",
            "verseOrgIds": [
              "PRO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barsiisa tiyya jabeesi qaabad'i. Guyya ch'ufa qalbi keesa keeyad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.3",
            "verseOrgIds": [
              "PRO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaroomani, atini oboleeti tiyya jed'i hubachaleeni, jaala kiyya jaba jed'i. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.4",
            "verseOrgIds": [
              "PRO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaroomafi hubachaani tunini nad'eeni biyyaa, ta afaanuma ufitini si faraatu, ira si fageesiti.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Niiti ch'eera inqamne",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.5",
            "verseOrgIds": [
              "PRO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya toko ato anini qaa mana, Kiyyatini ala laalu, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.6",
            "verseOrgIds": [
              "PRO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "jara kaima heddu, ka argaa d'ageeti inqamne, arge, ammo worra suni keesa nama tokoti ka nama ch'ufa ira daalle jira. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.7",
            "verseOrgIds": [
              "PRO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni kara gula d'aatu mana niiti toko ta sharmut'omani gurra baafate, ta mani isii moga ejuuni bahe. Inni ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.8",
            "verseOrgIds": [
              "PRO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "galgala eegi lafti dukanoofte d'aatu mana isii bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.9",
            "verseOrgIds": [
              "PRO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isiini mala d'aate woyya aka sharmut'a hid'atte isani woldeete. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.10",
            "verseOrgIds": [
              "PRO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini mana keesa inteetu, guyya ch'ufa lalaba, ch'eera foko male, dira keesa deemti; ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.11",
            "verseOrgIds": [
              "PRO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "yo gari kara dira keesa ejiti, yo toko gabaya keesa ejite nama eeddi. Isiini kara ch'ufa gula marte nama barbaaddi. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.12",
            "verseOrgIds": [
              "PRO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini gurba kaaniti mamarate d'ungate, ila keesa laalte waan jette, ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.13",
            "verseOrgIds": [
              "PRO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini arra sorio qalad'e, foonile manaa qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.14",
            "verseOrgIds": [
              "PRO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi anini si barbaadu deema, amma sini bahe! ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.15",
            "verseOrgIds": [
              "PRO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini sire tiyya woyya barriti lafa Misiriti mid'aasanini afe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.16",
            "verseOrgIds": [
              "PRO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qayya qumbitifi qunch'e birresatifi hargeesa yayu iti naqe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.17",
            "verseOrgIds": [
              "PRO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kooti, halkani kana ch'ufa haga quumnuti woliini rafne wolti mamaranna. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.18",
            "verseOrgIds": [
              "PRO.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woma insodaatini, d'iirsi kiyyaleeni worra injiru, ya imaltu fago d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.19",
            "verseOrgIds": [
              "PRO.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PRO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni ya beese guddo fud'ate imaltu deeme, torbaani lama asi ingalu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.20",
            "verseOrgIds": [
              "PRO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba isiini mid'aagumafi dubbi dansaani isa ufiti d'araasifte, innileeni suni gula laafe gula bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.21",
            "verseOrgIds": [
              "PRO.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maro tokotu inni akuma looni qalma geesani kae isii gula deeme, akuma gugufto t'urura fulla ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.22",
            "verseOrgIds": [
              "PRO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "t'iyaani woraananiti deemtu deeme. Inni akuma simpirre t'urura seentu, ta aka lubbuuni isi gaargala keesa jirtu imbeenne, jira. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.23",
            "verseOrgIds": [
              "PRO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma tana ilmaani tiyya, na ch'aqasa, waan anini jed'ule qalbi keesa keyad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.24",
            "verseOrgIds": [
              "PRO.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niitiini akana tunini qalbi si fuute gula indedeemini. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.25",
            "verseOrgIds": [
              "PRO.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini qara d'iira heddu galafatte, nama muumme inqamne fit'e. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.26",
            "verseOrgIds": [
              "PRO.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami mana isii d'aqu seera nama boola ekhera deemu, karaani gabaabani duati nama geesu kana.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.7.27",
            "verseOrgIds": [
              "PRO.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka qarooma faarsani",
          "type": "text"
        }
      ]
    }
  ],
