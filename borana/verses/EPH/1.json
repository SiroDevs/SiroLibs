                  "text": "19.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maqaani kiyya Paulo; anini fed'i Waaqaatiini ergattu Kristo Yeso tahe. Gara gumi Waaqa ta Efeso keesa jirtu, ta jireenna ufitiini Kristo Yeso d'ugefate tatabe tana t'aafa.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.1",
