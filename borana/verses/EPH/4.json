  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EPH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini ka maro anini Aabbo hojad'uufi na hid'ani, isani kad'ad'a yaamicha Waaqi isani yaame gula yaa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.12+COL.3.13"
              },
              "items": [
                {
                  "text": "Kol 3.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ufi olimfuud'ina, laana yaa, waan ch'ufa obsa. Jaalala teesani wolqarqaarsaani agarsiisa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takaa tahiti Lubbuuni namaa kennitu jabeesa qorqorad'a, nagaya takaa isani tolchu suniini. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nafa tokofi Lubbu toko ch'allati jira, akuma abdiini toko, ta Waaqi iti isani yaame. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aabbo tokofi d'ugefacha tokofi batiso toko ch'allati jira; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqa toko ch'allati jira ka Abba nama ch'ufaa; inni waan ch'ufa ira jira, waan ch'ufa keesa hojate waan ch'ufa keesa jira.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nu nami ch'ufti yayu herega Kristo gula eeba arganne. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.68.18"
              },
              "items": [
                {
                  "text": "Far 68.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma t'aafiini jettu,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jireenna duritiifi jireenna haraa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maqa Aabbootiini anini waan kana jabeese jed'a: aka worra Waaqa imbeenne, ka qalbiini worraa woma imbaanne, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka qalbiini ammalle dukana keesa jirtu intahiina. Worri jireenna Waaqi kennu keesa qooda inqabu; wonti akanatiifi worri daalle woma imbeekhu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.18",
            "verseOrgIds": [
              "EPH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ch'eera inqabu huji dabati ufi kenne, waan ch'eera ka aka ch'ufa ka ira ufi ind'owine taha.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti isani waan Kristo barattani akasiiniti! ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.20",
            "verseOrgIds": [
              "EPH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani ya waan isaa d'ageetani, ammalle aka nama isa gula yau ya d'uga Yeso keesa jirtu barattani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.9"
              },
              "items": [
                {
                  "text": "Kol 3.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Tanaafi jireenna keesani dullacha duri, ka waan isani duri taatani isani tolche — jireenna duri ka d'araani hamtuuni balleesite baafad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaafi qalbi teesani hareesa tolchu malani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Uum 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.10"
              },
              "items": [
                {
                  "text": "Kol 3.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Jireenna hareesa aka woya fud'ad'a, ka fakeenna Waaqa gula mid'aasani, ammalle ka finna d'uga ka qajeelumafi qulqulloomaani mullatu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera jireenna guyya ch'ufa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EPH 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.16"
              },
              "items": [
                {
                  "text": "Zek 8.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iti deebitani inkiyyibiina duuba! Nami ch'ufti ha oboleesa ufiti d'uga dubbatuuti; wonti akanatiifi nuuni ch'ufti nafa Kristo keesati mita. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.4.4"
              },
              "items": [
                {
                  "text": "Far 4.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo dalantani, dalansuuni teesani daba keesa isani inseensisiini; dalansuuni aduuni isaniti ind'iini. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheet'ani qoomni inargatiini. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.27",
            "verseOrgIds": [
              "EPH.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami duri wo hatu ha hanna lakise hojatuuti, aka harka ufitiini ufi bulche hiyyeeyile qarqaaru. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.28",
            "verseOrgIds": [
              "EPH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasaa keesati dubbi hamtu injed'ina. Dubbi dansa, ta nama qarqaarte jabeesitu ch'alla jed'a, aka worri d'agayu eeba argatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.29",
            "verseOrgIds": [
              "EPH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lubbu Qulqullo Waaqa ilaalefachiisiina; Lubbuuni tunini beesisa Waaqa ka isani gubba jiru, ka aka guyyaani isani balchoomsani d'ufu agarsiisu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.30",
            "verseOrgIds": [
              "EPH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Garaa hameennafi, d'araafi dalansu ch'ufa lakisa. Iti deebitani woli loltani woli inarabsina! Ammalle wolinjibiina! ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.31",
            "verseOrgIds": [
              "EPH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.13"
              },
              "items": [
                {
                  "text": "Kol 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ammo arja taha, woli naha, woli araarama, akuma Waaqi maro Kristotiifi isani araarame.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.32",
            "verseOrgIds": [
              "EPH.4.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jireenna ifsa keesa",
          "type": "text"
        }
      ]
    }
  ],
