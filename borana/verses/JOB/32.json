            "sid": "JOB 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Ayubuni d'uga iraa bahu dide anini wollaala inqabu ufiini jed'eefi, jari sadeeni kaani iraa ch'allise. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo namichi toko, ka Elihu jed'ani, ka d'aatu eju, aka Ayubuni ufi d'ugeese Waaqa himate d'ageennaani, dallansu d'owachu dad'abe. (Elihuni ilma Barakeli, ka worra Buzi, balbalti isaa Ramu.) ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni jaalani Ayubu taani sadeenileeti dallane, waan worri dubbi isaa d'aareesu dad'abe, akasiini waan Waaqi wollaala qabu fakeesefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni waan worra kaani ch'ufa ira maand'atifi haga worri kaani dubbatu ch'ufa afaani qabate. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni aka jari kaani sadeeni dubbi Ayubu dad'abe arginaani dallane ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'e:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.6",
            "verseOrgIds": [
              "JOB.32.6"
            ]
          }
        }
