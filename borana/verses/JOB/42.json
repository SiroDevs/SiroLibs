        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayubuni eegi gaargala kaani keesaa bahe, ganna d'ibbafi afurtama tae, akhaakhufi ababoole ch'ufa arge, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
