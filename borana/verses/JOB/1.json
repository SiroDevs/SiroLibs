          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato inni tae dubbatu, nami d'ibiini qonqooni d'ufe waan jed'e, worri gosa Kaldayo, ka duuli worraa fulla sadi yau, d'ufe nu had'e, gaala ch'ufa fud'ate, ana male hojattu tante ch'ufa fit'e. Nami fiige ka oduuni si d'ufe anuma ch'alla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
