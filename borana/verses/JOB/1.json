          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato inni tae dubbatu, nami d'ibiini qonqooni d'ufe waan jed'e, Qaweeni Waaqa ya reefi nama isi tissule ch'ufa ira buute hobaafte nami fiige, ka odu sunini si d'ufe, anuma ch'alla.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
