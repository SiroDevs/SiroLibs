              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Sheet'ani waan jed'eeni, Mala keeti Ayubuni fayyuma si jaalata? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini isaafi worra isaatiifi waan inni qabu ch'ufa jabeesite intissine? Atini huji harka isaa ch'ufa eebifte, hori isaa lafa ira indabarsine? ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo atini waan inni qabu ch'ufa harka keetiini iraa fuute, mala keeti inni si inabaaru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
