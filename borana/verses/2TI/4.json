          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ufira isa eegi, inni guddo d'aamsa keenna dide.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
