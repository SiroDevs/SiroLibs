            }
          ]
        },
        {
          "text": " Iskandani, ka tumtu, waan hamtu na tolche; Aabbooni waan inni na tolche isa tolchiinna. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
