      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan kana qaabad'u! Guyyaani muumme gaargala hama qaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
              "2TI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ufo tahe, sabdae, ufi guddise, ufi saada; wolarabsani, worra ufiiti saalfachu didani, galata deebisu, didani, aada Waaqa lakisani; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "arja tahu didani, naasu lakisani, maqa wolt'ureesani, woldidani, wolhad'ani, waan dansa jibbani; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wolballeesu fed'ani, mata jabaatani, ufi guddisani, Waaqa ira gammada jaalatani; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.4",
            "verseOrgIds": [
              "2TI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nama aada Waaqa guutu ufi tolchani, ammo jabeenna isi didani. Jara akana kana ira fagaad'u. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
            "verseOrgIds": [
              "2TI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gari mana nad'eeni d'aqe, nad'eeni lalaaftu ta qara dabi iti ulfaate d'araa gosa ch'ufa gula yaatu fud'atani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.6",
            "verseOrgIds": [
              "2TI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nad'eeni tunini hojja ch'ufa wo barachu feeti, ammo haguma jirtu d'uga imbarattu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.7",
            "verseOrgIds": [
              "2TI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.11"
              },
              "items": [
                {
                  "text": "Bah 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma duri Yanefi Yambreni dubbi Musa didde, akasuma worri kunileeni d'ugaa dida — nama herega inqamne, ka d'ugefacha argachu dad'abe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti kunini garu ind'at'u, waan nami ch'ufti aka worri daalle arguufi akuma jari kaani duri tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "D'aamsa waan huji",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo atini ya barsiisa tiyyaafi adaba kiyyafi jireenna kiyya gula deemte; atini ya d'ugefacha tiyyaafi obsa kiyyafi jaalala tiyyaafi jabeenna kiyyafi, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.10",
            "verseOrgIds": [
              "2TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.14+ACT.13.15+ACT.13.16+ACT.13.17+ACT.13.18+ACT.13.19+ACT.13.20+ACT.13.21+ACT.13.22+ACT.13.23+ACT.13.24+ACT.13.25+ACT.13.26+ACT.13.27+ACT.13.28+ACT.13.29+ACT.13.30+ACT.13.31+ACT.13.32+ACT.13.33+ACT.13.34+ACT.13.35+ACT.13.36+ACT.13.37+ACT.13.38+ACT.13.39+ACT.13.40+ACT.13.41+ACT.13.42+ACT.13.43+ACT.13.44+ACT.13.45+ACT.13.46+ACT.13.47+ACT.13.48+ACT.13.49+ACT.13.50+ACT.13.51+ACT.13.52"
              },
              "items": [
                {
                  "text": "Huji 13.14-52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.1+ACT.14.2+ACT.14.3+ACT.14.4+ACT.14.5+ACT.14.6+ACT.14.7+ACT.14.8+ACT.14.9+ACT.14.10+ACT.14.11+ACT.14.12+ACT.14.13+ACT.14.14+ACT.14.15+ACT.14.16+ACT.14.17+ACT.14.18+ACT.14.19+ACT.14.20"
              },
              "items": [
                {
                  "text": "14.1-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " gaargala kiyyafi d'aanicha kiyyale agarte. Waan Antiokiafi Ikoniofi Listra keesati na tolchani quba qabda, gaargala hama anini argad'e ch'ufa! Ammo Aabbooni ya waan suni ch'ufa keesaa na baase. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.11",
            "verseOrgIds": [
              "2TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama Kristo Yeso woliini jireenna Waaqi fed'u keesa tau ch'ufti ingaargalchani; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.12",
            "verseOrgIds": [
              "2TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammo nama hamafi kiyyibaani ch'ufti ira hamaata, ufi sobani nama d'ibile sobani. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
              "2TI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo atini, d'uga si barsiisani aka dansa d'ugefatte keesa tai. Wonti akanatiifi atini nama si barsiise imbeeta, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.14",
            "verseOrgIds": [
              "2TI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle haga ijoolluma teetiti ya T'aafi Qulqullo, ta dandeete hubacha baafama, maro d'ugefacha Kristo Yesotiifi sii kennitu baratte. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akasitiifi t'aafiini ch'ufti hafuura Waaqaa qabdi ammalle wo baati, isi d'ugani barsiisani, wollaalaani gorsani, qajeelaani garsiisani, waan jireenna dansaatiini barsiisani, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "aka nami Waaqa ch'ufti qit'ae kurfo tae, huji dansa ch'ufa hojatu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.17",
            "verseOrgIds": [
              "2TI.3.17"
            ]
          }
        }
      ]
    }
