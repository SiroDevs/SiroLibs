          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee Ninawi, si keesaa nami hameenna mariate AABBO Waaqati malatu bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.11",
            "verseOrgIds": [
              "NAM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NAM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan worra Israelitini jed'u: Ato worri Ashuru jabaate yokhaani heddatele, worra balleesani lafaa d'abani. Gumi tiyya, ato qara isani gaargalchele, amma deebie isani ingaargalchu. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
              "NAM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini irre worri Ashuru isaniini dabsate ch'abse, haada worri isaniini hid'u kuta.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.13",
            "verseOrgIds": [
              "NAM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
