              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonathanini, ka oboleesa abba Daudi, malticha qaro, woi t'aafu beekhu. Isaafi Yehielini, ilmi Hakmoni, worra ilmaani hayyu barsiisu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.32",
            "verseOrgIds": [
              "1CH.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahithofelini nama mala hayyu d'au; Hushani, ka gosa Arki, jaala hayyu, ka isa gorsu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.33",
            "verseOrgIds": [
              "1CH.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi Ahithofelini due, Abiatharifi Yehoyadani, ilmi Benaiya, worra hayyu mala d'au tahani. Yoabuleeni gudda askarti hayyu ch'ufaati.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.34",
            "verseOrgIds": [
              "1CH.27.34"
            ]
          }
        }
      ]
