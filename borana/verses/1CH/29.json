          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni jaare fulla gahe, ka duroomafi ulfinna gudda qabu due, ilmi isaa Solomonini fulla isaa hayyu tahe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.28",
