                  "text": "28.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Wonti Sauloni duefi waan inni AABBO Waaqa durati wollaala tolcheefi. Inni dubbi AABBO Waaqa dide, gara nama ekheraani dubbatu d'aqe wogaafate, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "fulla inni sila AABBO Waaqa gaafatu. Tanaafi AABBO Waaqi isa ijeese, finna lafa suni Daudi ilma Yeseti kenne.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Daudini hayyu Israelitiifi ka Yuda tahe",
          "type": "text"
        }
      ]
