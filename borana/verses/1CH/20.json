                  "text": "1 Sam 17.4-7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle eegi sunile worri worra Filistini akasuma wolhad'ani, Elhanani ilma Yeiri, Lahuni oboleesa Goliathi, ka worra Gathi, ka someeti woraana isaa haga utuba geetu d'ae ijeese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
