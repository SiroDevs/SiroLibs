            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Haguma bara Simeonitifi haga bara hayyu Daudini lafa fide, worri d'aloota Simeoni kunini dira kana keesa taa: Beersheba, Molada, Hasar-Shuali, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.28",
            "verseOrgIds": [
              "1CH.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bilha, Ezemu, Toladi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.29",
            "verseOrgIds": [
              "1CH.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pethueli, Horma, Ziklagi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.30",
            "verseOrgIds": [
              "1CH.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beth-Markabothi, Hasar-Susimu, Beth-Biri, Shaar-Aimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.31",
            "verseOrgIds": [
              "1CH.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worri dira shani d'ibi keesa tae: Etamu, Aini, Rimoni, Tokeeni, Ashani; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.32",
            "verseOrgIds": [
              "1CH.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle ollowaani d'aatu jirtule ch'ufa keesafi haga dira Baalathi. Tunini lafa duri worri taufi odu worra isaani ta t'aafani jabeesani olkayani.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.33",
            "verseOrgIds": [
              "1CH.4.33"
            ]
          }
        }
      ]
    },
