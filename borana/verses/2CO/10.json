          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.24"
              },
              "items": [
                {
                  "text": "Yer 9.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ammo akuma t'aafiini jettu, Nami ufi guddisu fed'u, ha huji Aabbooni hojatefiini ufi guddisu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi nami, yo Waaqi waan isaa dansa heregu ch'alla dansa taha, yo inni waan ufi dansa hereguuniti.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Paulofi ergattu d'ara",
          "type": "text"
        }
      ]
    }
  ],
