            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababooti Daudi tana: Daudini ka Yese, Yeseni ka Obedi, Obediini ka Boazi, Boaziini ka Salmoni, Salmoniini ka Nahshoni, Nahshoniini ka Aminadabu, Aminadabuuni ka Ramu, Ramuuni ka Hesroni, Hesronini ka Perezi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18+RUT.4.19+RUT.4.20+RUT.4.21+RUT.4.22",
            "verseOrgIds": [
              "RUT.4.18",
              "RUT.4.19",
