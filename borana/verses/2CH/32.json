          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Hezekiani tolche ch'ufafi aka inni AABBO Waaqa hojatele ch'ufa, kitaaba Daayya Raaga Isaya, ilma Amozitifi Odu Hayyoota Yudatifi ta Israeli keesati t'aafaniti t'aafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiani due jennaani awaala hayyoota, gaara gubba, fulla ilmaani Daudi iti awaalaniti awaalani. Worri Yudatifi ka Yerusalemuleeni gaafa inni due guddo boheefi awaala mid'aase. Ilmi isaa Manaseeni fulla isaa hayyu tahe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
      ]
    },
