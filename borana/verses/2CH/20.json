        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan Yehoshefathini tolche ch'ufa, haguma geetunu, kitaaba Odu Yehu, ilma Hanani, ka Odu Hayyoota Israelile haga toko keesati t'aafaniti t'aafani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa toko hayyuuni Yuda Yehoshefathini, hayyu Israeli ka Ahazia jed'ani, Ka waan hamtu heddu duri tolche, goli woli tahani, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.35",
            "verseOrgIds": [
              "2CH.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "hobolo gugurdo bunaqa Esion-Geberiti mid'aafatani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.36",
            "verseOrgIds": [
              "2CH.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Eliezerini, ilmi Dodarahu, ka dira Morisha, waan Yehoshefathini jed'e, Waan atini goli Ahazia tateefi, waan atini jaarte kana AABBO Waaqi imballeesa. Duuba hobolooni sunini ch'ach'abt'e deemu dad'abdi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.37",
            "verseOrgIds": [
              "2CH.20.37"
            ]
          }
        }
      ]
