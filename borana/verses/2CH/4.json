            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle naabo qaaloleeni keesa ooltu jaarani, naabo alaale d'ibi jaarani. Balbala naabo suni ch'ufa sibiila diimani ch'okhani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.9",
            "verseOrgIds": [
              "2CH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haro gingiti taani gama ilaborutiini bitaa kayani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.10",
            "verseOrgIds": [
              "2CH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huramuni ammalle okoteefi baofi qori mid'aase. Duuba inni miha Mana Waaqa ka inni hayyu Solomonini si mid'aasa jed'e, ch'ufa hobaase: Utuba lama, waan aka sure lama ta mata utuba suni ira kayani; waan aka looti ka barreesani sure sunini ch'okhani; waan aka okhoku d'ibba afuri, ka sibiila diima iraa mid'aasani, fulla lama ch'ororsani waan aka sure lamaani suniti naqani; gaari kud'ani; qori kud'ani; haro gingiti; koromi kud'ani lama, ta harooni suni ira ejitu; okoteefi, baofi, moqa filfilicha. Huramuni, hogeesi guddaani, miha kana ch'ufa sibiila diima qulqulleesani iraa mid'aase, akuma hayyuuni Solomoni isaani jed'e, aka Mana Waaqa keesani hojatani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11+2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16",
            "verseOrgIds": [
              "2CH.4.11",
              "2CH.4.12",
              "2CH.4.13",
              "2CH.4.14",
              "2CH.4.15",
              "2CH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
