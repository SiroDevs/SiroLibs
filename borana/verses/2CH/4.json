            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hayyichi waan kana ch'ufa bale Yordani keesa, jiddu Sukothifi Sarethani, ta biyye faara qabduti mid'aasa jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.17",
            "verseOrgIds": [
              "2CH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mihi mid'aasani gudda, muumme inqamne, tanaafi nami ulfinna sibiila diima isaani mid'aasani haga beekhu injiru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.18",
            "verseOrgIds": [
              "2CH.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
