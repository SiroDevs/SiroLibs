              "type": "tag",
              "attrs": {
                "loc": "EXO.25.23+EXO.25.24+EXO.25.25+EXO.25.26+EXO.25.27+EXO.25.28+EXO.25.29+EXO.25.30"
              },
              "items": [
                {
                  "text": "Bah 25.23-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammalle waan ifseeni ira ejaanjitu kud'ani, aka mid'aasu malani gula worqiini mid'aasani, mesa kud'anile mid'aasani bada Mana Waaqaa suni keesa kayani, waan ifseeni ira ejaanjitu shanifi mesa shanile gama taka moga lachu naqani. Ammalle qori worqi ta d'ibba tokole mid'aasani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.7+2CH.4.8",
            "verseOrgIds": [
              "2CH.4.7",
              "2CH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
