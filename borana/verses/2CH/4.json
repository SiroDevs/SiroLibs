            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.11+2CH.4.12+2CH.4.13+2CH.4.14+2CH.4.15+2CH.4.16",
            "verseOrgIds": [
              "2CH.4.11",
              "2CH.4.12",
              "2CH.4.13",
              "2CH.4.14",
              "2CH.4.15",
