              "type": "tag",
              "attrs": {
                "loc": "1CH.15.25+1CH.15.26+1CH.15.27+1CH.15.28"
              },
              "items": [
                {
                  "text": "1 Od-dur 15.25-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Solomonini jaarole Israeli ta balbala gosa isaani ch'ufaa mataa Yerusalemuti ufiti yaame, aka Sanduqa Wold'aqisa AABBO Waaqa dira Daudi, ka Sioni jed'ani fuud'ani, Mana Waaqatini d'ufani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri ch'ufti guyya jila Hoosa wolti d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaaroleeni sunini ch'ufti wolgeete jennaani worri Lawi Sanduqa kaani olfuud'e ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Waaqati geese. Jennaani qaaloleefi worri Lawileeni Waaro Woyyumatiifi miha isii guure, Mana Waaqati geese. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba hayyu Solomonifi worri Israeli ch'ufti Sanduqa Wold'aqisa durati wolti bahani, loonifi ree hedu muumme inqamne sorio baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba qaaloleeni Sanduqa Wold'aqisa AABBO Waaqa Mana Waaqa olnat'e, Fulla Fulla Ch'ufa Ira Qulqullootiini d'ufte, akheekha waan koola ka lubbu qaba kaani jala keete. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kooli isii ka ballisani gubba Sanduqafi kalcho baataniini d'osse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama Fulla Fulla Ch'ufa Ira Qulqullo dura eju male, nami d'ibiini dandae fiit'e kalcho inargu. (Kalchooni sunini arrale achuma jirti.) ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.5"
              },
              "items": [
                {
                  "text": "Qab-Ser 10.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Sanduqa Wold'aqisa suni keesa d'akha hahafalicha lamaani Musani gaara Sinaiti keesa kaye, gaafa AABBO Waaqi worra Israeli lafa Misiriti baase, wold'aqisa woliini tolfate male wonti d'ibiini keesa injirtu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
