                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hayyu Solomonini huji ijaarsa Mana Waaqa ch'ufa hobaase jennaani Mana Waaqa keesa fulla woiti olkayani, waan abbaani isaa Daudini duri AABBO Waaqaa olkaye ch'ufa, achiti olkaye — qarsifi worqifi miha kaani ch'ufale.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Sanduqa Wold'aqisa Mana Waaqatini d'ufani",
          "type": "text"
        }
      ]
    },
    {
