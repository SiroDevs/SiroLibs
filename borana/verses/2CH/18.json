          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahabuni waan Yehoshefathini jed'e, Anini, inni waan hamtu male, dansa naa infagu sini injenne? Me, ilaali!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
