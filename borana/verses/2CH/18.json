          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo hayyichi waan jed'eeni, Hojja maqa AABBO Waaqatini naani dubbatu d'uga dubbad'u! Maro hagami siti himu male?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        }
