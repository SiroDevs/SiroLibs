            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.38"
              },
              "items": [
                {
                  "text": "Mat 5.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nama akasi sunii inahina: ka lubbu ijeese, ijeesa, ka ila basse ila bassa, ka ilkaani buqise, ilkaani buqisa, ka harka kute, harka kuta, ka miila kute, miila kuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.21",
            "verseOrgIds": [
              "DEU.19.21"
            ]
          }
        }
      ]
    },
