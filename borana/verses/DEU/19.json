              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daari lafa nama d'ibi, ta qara duri jaaroleeni mid'aasite, lafa AABBO Waaqi keesani isanii kennu keesati, imballeesina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.14",
            "verseOrgIds": [
              "DEU.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nama d'uga namaa tahu",
          "type": "text"
        }
      ]
    },
