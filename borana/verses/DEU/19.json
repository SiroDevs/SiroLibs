              },
              "items": [
                {
                  "text": "Yos 20.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "inahina nama nama ijeese kana Israeli keesaa balleesa, aka wonti ch'ufti isanii toltu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
            "verseOrgIds": [
              "DEU.19.13"
            ]
          }
        }
      ]
    },
