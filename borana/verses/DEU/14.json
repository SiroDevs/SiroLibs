              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani worra qulqullo ka AABBO Waaqa keesani; inni ya gosa ch'ufa ta lafa gubba jirtu keesaa isani fohate, gumi ufii isani tolfate.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bineensa qulqulloofi ka qulqullo intahini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan AABBO Waaqi infeene tokole inyaatina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.3",
            "verseOrgIds": [
              "DEU.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensi isani nyaachu maltani kana: looni hoolafi laleesa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.4",
            "verseOrgIds": [
              "DEU.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hiddi, saala, gadamsa, gugufto, bushaa ch'ufa — ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.5",
            "verseOrgIds": [
              "DEU.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bineensa qeench'i kaarru qabuufi ka alala deefatu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.6",
            "verseOrgIds": [
              "DEU.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo bineensa tokole inyaatina, ka qeench'i kaarru qabuufi ka alala deefatu male. Gaala, hillensafi bineensa d'ibi aka isaale inyaatina. Bineensa akasi suni aka waan qulqullo intahiniti herega; wonti akanatiifi bineensi kunini alala deefata, ammo qeench'i isaani kaarru inqabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.7",
            "verseOrgIds": [
              "DEU.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Booyye inyaatina, isiile aka waan qulqullo intahiniti herega; wonti akanatiifi qeench'i isii kaarru qaba, ammo alala indeefatu. Bineensa akana kana tokole inyaatina, yokhaani reefa isaanile intuqina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.8",
            "verseOrgIds": [
              "DEU.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qurt'umi gosa ch'ufa ta bisaani keesa galtu nyaad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.9",
            "verseOrgIds": [
              "DEU.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo waan bisaani keesa gala, ka qurt'umi intahini, inyaatina. Aka waan qulqullo intahiniti herega.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.10",
            "verseOrgIds": [
              "DEU.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simpirre qulqullo ch'ufa nyaad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.11",
            "verseOrgIds": [
              "DEU.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti koola qaba ka isani nyaachu himmaliini tana: risafa, urungufa, qorefa, rumichafa, akko abeerafa, haranqeesafa, rand'ufa, guchifa, simpirre bisaani ch'ufa, baabo alloonafa ammalle raarefa inyaatina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.12+DEU.14.13+DEU.14.14+DEU.14.15+DEU.14.16+DEU.14.17+DEU.14.18",
            "verseOrgIds": [
              "DEU.14.12",
              "DEU.14.13",
              "DEU.14.14",
              "DEU.14.15",
              "DEU.14.16",
              "DEU.14.17",
              "DEU.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
