              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan feetanini bitad'a — looni taanaani, ree taanaani, daad'ifi farsole taanaani — achiti AABBO Waaqa keesani dura, worra keesani woliini, nyaad'a quufa gammada.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.26",
            "verseOrgIds": [
              "DEU.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
