              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Law 27.30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.21"
              },
              "items": [
                {
                  "text": "Hen 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ganna ch'ufa waan oobruuni teesani baaftu kud'ani keesa toko naa baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.22",
            "verseOrgIds": [
              "DEU.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba fulla AABBO Waaqi keesani fohate isa iti kad'attani d'aqa, achiti isa duraa mid'aani, daad'i, d'ad'a, waan horiini goroomuma d'ale, ka loonitifi ka reele, kud'ani keesa toko nyaad'a. Waan kana tolcha, aka hojja ch'ufa AABBO Waaqa keesani sodaatani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.23",
            "verseOrgIds": [
              "DEU.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja karaani d'eerate, fullaani sunini isaani ira fago taate, qooda waan AABBO Waaqi isanii kenne sunini d'ufu dad'abdani, waan kana tolcha: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.24",
            "verseOrgIds": [
              "DEU.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qooda suni gurgura, beeseti deebisa, beese suni fud'ad'a, fulla AABBO Waaqi keesani fohate taani d'aqa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.25",
            "verseOrgIds": [
              "DEU.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 14:26"
          },
          "items": [
