        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani isani waan naani jettani, Nu yayu AABBO Waaqa durati ch'ubbu tolchine, ammo amma iyyaana, akuma AABBO Waaqi keenna nuni jed'e. Ammalle isaani nami ch'ufti lafa gaareeni suni koritini laaftu jettani mart'ifatani miha keesani ka lola fud'attani iti d'aabattani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        }
      ]
    },
    {
