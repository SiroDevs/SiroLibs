          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba AABBO Waaqi waan nu ch'ufaani jed'e. Ilmaani didiqo waan hamtufi waan dansa gargari imbeenneti lafa suni seena, ilmaani isani Nyaapati qaqabe jettani taani. Anini lafa suni worraa kenne, worrileeni duuba ind'aala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo isani dachaa, lafa aloo ta qajeela galaana Diimati iti d'aabad'a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
