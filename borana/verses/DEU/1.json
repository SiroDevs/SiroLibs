              },
              "items": [
                {
                  "text": "Ebr 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo ato anini waan kana ch'ufa isaniini jed'ele isani AABBO Waaqa d'ugefachu diddani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ato inni guyya ch'ufa isani dura deeme fulla isani iti qubatani isani garsiisele. Inni guyya aka baaldo dumansa isani dura deeme, halkani aka goola ibidaa isani dura deeme, kara isani garsiise.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
