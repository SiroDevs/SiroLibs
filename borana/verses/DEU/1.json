          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi keesani isani dura deeme, nyaapa isani dura had'a, akuma isani lafa Misiritiifi ta alooleti agartani kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
