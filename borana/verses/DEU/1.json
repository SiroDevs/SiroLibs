              },
              "items": [
                {
                  "text": "Huji 13.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Isani aka inni aka abbaani ilma baatu isani baate nagayumani armaani isaani baase ya argitani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
