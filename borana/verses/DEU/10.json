              "DEU.10.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.28"
              },
              "items": [
                {
                  "text": "Bah 34.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Anini akuma gaafa qara kaani guyyaafi halkani afurtama gaara ira tae. AABBO Waaqi ammalle na ch'aqase, badi qara isani balleesu fed'e lakise. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan nami jed'e, Beeni, worra kana dura deemi, aka worri lafa anini ababoota worraati kenne fud'atu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Waan Waaqi nama iraa fed'u",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma worra Israeli AABBO Waaqi maani isani iraa fed'a? Wonti inni isani iraa fed'u, aka isani AABBO Waaqa keesani sodaatani, kara isaa ch'ufa gula yaatani, isa jaalatani, AABBO Waaqa keesani garaafi onne teesani ch'ufaani hojattani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle aadaafi seera, ka anini AABBO Waaqi ara isanii kenne, guutani akanaani eeba argattani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gubbaleeni haguma geetunu ta AABBO Waaqa keesaniti: lafafi wonti isii keesa jiraleeni ch'ufti ka isaati, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo jaalalti AABBO Waaqa, ta inni ababoota teesani jaalate, guddo jabdu, tanaafi inni gosa d'ibi keesaa isani fohate haga arrale gumi ufi isani tolfate. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi deebitani mata injabaatiina armaa achi AABBO Waaqa d'agaya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
