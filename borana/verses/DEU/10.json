        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan naani jed'e, D'akha hahafalicha lamaani aka ka qara kaani boch'i sanduqa keesa nat'ule mukhaani mid'aasiifi, gaara gubbati natiini kooti, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini dubbuma d'akha hahafalicha atini ch'absite ka qara kaani irati t'aafe kanale irati t'aafa; duuba atini maro tana sanduqa keesa kayu malte.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini sanduqa mukha d'adachatiini mid'aase, d'akha hahafalicha lama, ka akuma d'akha qara kaani jiru boch'e, gaarani kore. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi d'akha hahafalicha kaani irati dubbuma duri inni d'akha qara kaani irati t'aafe, Seera kud'annaani ka inni gaafa ibida keesa isaniini dubbate, guyya isani fulla gaarati woltibaatani isani kenne, irati t'aafe. AABBO Waaqi d'akha hahafalicha suni naa kenne, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini gargale gaara iraa gabue. Jennaani akuma AABBO Waaqi naani jed'e, sanduqa anini mid'aase kaani keesa kaye arti asile artuma keesa jira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        }
      ]
    },
