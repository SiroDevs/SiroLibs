                "loc": "NUM.33.38"
              },
              "items": [
                {
                  "text": "33.38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Worri Israeli eellani worra Yakaniiti godaane Moserani bahe, artiti Harunini due, awaalani, jennaani ilmi isaa Eleazarini huji qaalluma iraa fuud'e. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Artilee kaani Gudgoda qubatani achii kaani Yorbatha lafa madda guddo qabdu qubatani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.5+NUM.3.6+NUM.3.7+NUM.3.8"
              },
              "items": [
                {
                  "text": "Hen 3.5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Gaafasi AABBO Waaqi worra gosa Lawi fohate, aka worri Sanduqa Wold'aqisa baate, huji qaallu isaa hojatte maqa isaatini namaa eebisu. Arrale hujiini worraa sunuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti gochiti Lawi qooda lafa aka gosa taani, inargatiinifi waan kana: Akuma AABBO Waaqi worraa kakhate, qoodi worraa huji qaallu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
