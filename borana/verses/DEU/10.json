                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.9"
              },
              "items": [
                {
                  "text": "Efs 6.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " AABBO Waaqi keesani Waaqa Waaqa ch'ufa ira jirufi jabeenna, jabeenna ch'ufa ira jiru. Inni gudda jaba ka nami sodaatu: ka nama gargari infillee yokhaani ka gumbo inyaanne. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inni haad'a hiyyeesatifi hiyyeeyile qorqorate dubbataafi: Inni keessuma teennale jaalate beelafi daara baasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi keessuma jaalad'a, isanileeni duri lafa Misiriti keessuma. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa keesani sodaad'a, isuma ch'alla kad'ad'a. Isa biraa indeemina, maqa isaa ch'allaani kakhad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaa faarsa, inni Waaqa keesani, isanileeni waan mama jabdu inni isani tolche ya iluma teesaniini agartani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
