                {
                  "text": "Qab-Ser 3.23-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyyuma suni AABBO Waaqi waan Musani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaara Nebo, ka fulla gareeni Abarimu, lafa Moabu keesa, dira Yeriko gama ilaboru; jiru d'aqi kori, lafa Kanaani, ta anini worra Israeliti kennu, aka dansaa daawad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini akuma oboleesi kanke Harunini gaara Hori irati due gaara suni irati doota; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "wonti akanatiifi isaani lachu gumi Israeli durati na ch'eersitani. Gaafa isani fulla bisaani Meriba jirtani, d'aatu dira Kadeshi, lafa aloo ta Sini keesati, gumi Israeli durati na saalfachu diddani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atini lafa anini worra Israeli kennu suni fago daawata, male, inseentu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Musani gosa Israeli toko tokooni eebise",
          "type": "text"
        }
      ]
    }
