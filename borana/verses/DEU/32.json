          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musani dubbi gosa Israeli barsiisu ch'ufa buufate jennaani ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jed'e, Dubbi anini isani arra barsiisu tana jabeesa, garaati qabad'a, ilmaani teesanile ch'ufa barsiisa, aka isiini dubbi seera kana ch'ufa jabeesite guutu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbini tunini dubbi tabaatiiniti, waan jireenna keesaniti. Yo jabeesitani guuttani, lafa galaana Yordanitini gama ta isaani amma iti qubachu geetani tana keesati, guyyaani keesani d'eerata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
    {
