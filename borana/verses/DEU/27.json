          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musani waan worra Israelitini jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
