          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Qab-Ser 11.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yos 8.33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Eegi isani galaana Yordani taakitani, gochiti tunini ha gaara Gerizimu gubba ejajiti, hojja guma Israeliti eebisani: Simeoni, Lawi, Yuda, Isakari, Yusufu, Benjamini, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle gochiti tunini d'ibiini ha gaara Ebali ira ejajitu. Hojja gumi Israeli abaarani, Reubeni, Gadi, Asheri, Zabuloni, Dani, Naftali, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "worri gosa Lawi ha qonqo olfud'ate dubbi tana gumiti lalabu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
