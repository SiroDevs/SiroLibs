    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musafi jaaroleeni Israeli waan biyyaani jette, Dubbi nu arra isaniti himnu tana ch'ufa ch'aqasa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.1",
            "verseOrgIds": [
              "DEU.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.30+JOS.8.31+JOS.8.32"
              },
              "items": [
                {
                  "text": "Yos 8.30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Guyya galaana Yordani taakitani lafa AABBO Waaqi keesani isanii kennu seentani, d'akhaye gugurdo old'ad'aaba, d'ooba, lumut'a, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.2",
            "verseOrgIds": [
              "DEU.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba dubbi seera kana ch'ufa irati t'aafa. Hojja isani lafa AABBO Waaqi keesani ababoota teesani kakhate ta aananifi dammi aka lola yau seentani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.3",
            "verseOrgIds": [
              "DEU.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle ka isani galaana Yordani taakitani gama jirtani, d'akhaye taani gaara Ebali ira old'ad'aaba, akuma anini arra isaniini jed'e gula, ammalle d'ooba, lumut'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.4",
            "verseOrgIds": [
              "DEU.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.25"
              },
              "items": [
                {
                  "text": "Bah 20.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Artiti waan sorio AABBO Waaqa keesani irati baasani d'akha taka nami sibiilani imboch'iniini jaara. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.5",
            "verseOrgIds": [
              "DEU.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti akanatiifi waan sorio irati AABBO Waaqa keesani baaftani d'akha boch'aniini mid'aasu himmalle. Achiti sorio gubani baasa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.6",
            "verseOrgIds": [
              "DEU.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle sorio wold'ageeti qala nyaad'a, AABBO Waaqa keesani durati gammada. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.7",
            "verseOrgIds": [
              "DEU.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'akhaye lumut'ani suni irati aka dansaa dubbi seera AABBO Waaqa ch'ufa t'aafa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Musafi qaaloleeni gosa Lawi waan gumi Israeli ch'ufaani jette, gumi Israeli, ch'allisa, ch'aqasa. Arra isani ya gumi AABBO Waaqa keesani taatani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi dubbi isaa ch'aqasa, seerafi aada isaa, ta anini arra isanii kennu, guuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka nama seera ch'abse abaarani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
