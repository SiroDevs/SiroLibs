              },
              "items": [
                {
                  "text": "Luk 10.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " AABBO Waaqa keesani garaafi onne teesani ch'ufaani aka jaba jaalad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.5",
            "verseOrgIds": [
              "DEU.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.18+DEU.11.19+DEU.11.20"
              },
              "items": [
                {
                  "text": "Qab-Ser 11.18-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dubbini anini arra isaniini jed'e tunini garaa keesani keesaa imbahini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.6",
            "verseOrgIds": [
              "DEU.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmaani teesani aka dansaa dubbi tana barsiisa. Worra keesa taanaani, ala taanaani, yo raftanifi yo kaatanile qaabsisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.7",
            "verseOrgIds": [
              "DEU.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka beesisa harkaafi addaleti hid'ad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.8",
            "verseOrgIds": [
              "DEU.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikhikha balbalaa manatifi ka fullole irati t'aafa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.9",
            "verseOrgIds": [
              "DEU.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gorsa nama Waaqa dide",
          "type": "text"
        }
      ]
    },
    {
