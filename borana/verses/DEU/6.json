            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ee Israeli, d'agaya! AABBO Waaqa keenna male waaqi d'ibiini injiru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.4",
            "verseOrgIds": [
              "DEU.6.4"
            ]
          }
        },
