                {
                  "text": "Qab-Ser 32.48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini gaafasi guddise Waaqa kad'ad'e waan jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa, gudda, anini imbeekha aka wonti atini na garsiiftu kunini iti keeyacha waan gugurdo nama mamsiisa, ka atini takaa tana tolchitu. Waaqi tokoleeni, ka waan guddo mama aka atini tolchite kana tolchu, gubbaafi lafale injiru! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqa, galaana Yordani na taakisiisi, aka anini lafa gaareeni ta wo baaftu, ta gama suni jirtu taanifi gaareeni Lebanonile, argu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
