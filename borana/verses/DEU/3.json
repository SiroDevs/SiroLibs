          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba nu bale dira Beth-Peori gamaa keesati hamne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.29",
            "verseOrgIds": [
              "DEU.3.29"
            ]
