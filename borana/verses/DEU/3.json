              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo maro teesanifi AABBO Waaqi nati dallanne, nale ch'aqasu dide, waan naani jed'e, Laki ya geete, waan suni deebite maqa ind'aini! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beeni, fit'e gaara Pisga d'aqi, mirga, bita, ilaborutifi ila adule laali. Waan atinu gartu ch'ufa aka dansaa laali, wonti akanatiifi ato wonti feetu d'uftele atini galaana Yordani intaakitu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshua, dubbi inni gula deemu male taani iti himi, garaafi herega isaa jabeesi; wonti akanatiifi inni lafa atini agarte taani biyya geese iti qubachiisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        }
      ]
    },
