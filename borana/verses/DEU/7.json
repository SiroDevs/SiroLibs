                "loc": "ACT.13.19"
              },
              "items": [
                {
                  "text": "Huji 13.19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja AABBO Waaqi keesani lafa isani fud'attani iti qubachu geetani tanaani isani d'ufe, inni gosa lafa suni keesa jirtu isani duraa baasa. Inni gosa torba gugurdo ta gosa teesani ira jirtuufi ta ammalle irre isani ira qabdu isani duraa baasa: gosa Hiti ta Girgashi ta Amori, ta Kanaani ta Perizi, ta Hivi ammalle ta Yebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hojja AABBO Waaqi keesani worra kana harka keesaniti kenne isani worra dabsattani. Worra ch'ufa haguma worri gahunu balleesuu maltani. Wold'at'ani golli woli intahina, diqole worraa innahina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woli infuud'ina, ilmaani teesani dubra worraa infuud'iini, ilmaani worraleeni dubra teesani infuud'iini; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "wonti akanatiifi yo akasi taatani worri ilmaani teesani AABBO Waaqa iraa gorse waaqa d'ibi kad'achiisa. Yo wonti sunini taate, AABBO Waaqi isaniti dallane maro tokotu isaani balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.3"
              },
              "items": [
                {
                  "text": "Qab-Ser 12.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Duuba waan isani taatani, fulla worra ta woyyu ch'ufa balleesa, d'akha woyyu ka worri old'ad'aabe ch'ufa ch'ach'absa, akheekha waaqa worra ka Asheri jed'ani ch'iraa balleesa, waan worri boch'e aka waaqa yaamatu ch'ufa gubba balleesa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.5"
              },
              "items": [
                {
                  "text": "Bah 19.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
