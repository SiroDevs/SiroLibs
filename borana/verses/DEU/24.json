            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja oobru teesani ta ejersa mid'aani isii guurattani, mid'aani isani iraa hafe iti dachaatani inguuratina: ka hafe sunini sagale keessumatifi, ilmaani hiyyeeyitifi nad'eeni hiyyeeyiti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja mid'aani zabibu guurattani, ka hafe iti dachaatani inguuratina; sagale keessumatifi ilmaani hiyyeeyitifi, nad'eeni hiyyeeyiti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
