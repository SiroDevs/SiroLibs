        },
        {
          "text": "Nama gosa d'ibitifi ilmaani hiyyeeyi indabsina, ammalle woya niiti hiyyeeti qabdo infud'atina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
