          },
          "items": [
            {
              "text": "\n        Law 13.1—14.54",
              "type": "text"
            }
          ]
        },
        {
          "text": "D'ukuba hama aka qomaat'a yo fuutani, waan qaaloleeni gosa Lawi tolcha isaniini jette tolcha, jabeesa; akuma anini worrani jed'e, jabaad'a tolcha ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
