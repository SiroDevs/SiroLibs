                  "text": "Mar 10.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo nami niiti fuud'e, waan infaakanne irati arge isi jibbe tatabe lakisuni iti kenne ufi jalaa baase isiini deemte; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ammalle yo isiini deemte niiti nama d'ibi taate, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ammalle nami sunileeni isi jibbe, tatabe lakisuni iti keenne, ufi jala baase, yokhaani yo nami isii fuud'e sunini due, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba d'iirsi isii ka qara kaani, ka isi ufi jalaa baase isiini akasi taate, deebie maro lameeso niiti intolfatini. Wonti akanatiifi, yo inni maro lameeso deebie fuud'e ya AABBO Waaqa durati waan hamtu tolche. Isani waan hamtu akana kana lafa AABBO Waaqi isanii kennu keesati tolchu himmalle.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Seera aka heddu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
