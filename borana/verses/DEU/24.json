              "items": [
                {
                  "text": "Hen 12.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "waan AABBO Waaqi keesani, gaafa isani lafa Misiri keesaa baatani, karaati Miriamu tolche qaabad'a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
