            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama woergiftani, d'akha daakhu qabdo ira infud'atina. Yo iraa fuutani ya worra suni waan worri sagaleeni mid'aafatu d'owaitani ijeeftani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
