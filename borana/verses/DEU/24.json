          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami d'io nad'eeni fuud'e, huji askarti yokhaani huji ala d'ibi, ta worra ira isa fageesitu, intolchini; isa ganna toko huji iti inkennina, ha worra keesa tae niiti isaa woliini gammadani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
