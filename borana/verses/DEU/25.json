            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja nami lama jaaroleti woli himate jaaroleeni dubbi qorte, toko d'ugaa murte, kaani wollaala iti murte, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "duuba namicha wollaala iti murani, yo inni ule male, jaarsi dubbi mure kaani ufi durati gadi ch'ibsise garaa lafati gombise nama d'iibiini, D'aana jed'a. Haguma wollaala isaa gula isa d'aanu malani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Kor 11.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Dandaani maro afurtama d'aanani, ammo hagasi iraa indabarsina; yo hagasi ira d'aantani, nama keesani ya nama ch'ufa durati ch'eersitani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.9"
              },
              "items": [
                {
                  "text": "1 Kor 9.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Tim 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Qotiyo hojja mid'aaniini d'aantani afaani inhid'ina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka oboleesi oboleesa d'aalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
