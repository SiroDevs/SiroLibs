          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.35+LEV.19.36"
              },
              "items": [
                {
                  "text": "Law 19.35-36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Subba keesani keesa, d'akha haga haga ka toko ulfa toko sabla, ka woini biimani, innaqina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana keesani keesale d'akha woini biimani, ka haga haga, ka toko gudda, ka kaani diqa, inqabaatiina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan biimitani ch'ufa d'uga gula biima aka lafa AABBO Waaqi keesani isanii kennu keesati guyyaani keesani d'eeratu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi nama waan hamtu tolche nama dabsu ch'ufa injibba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Worra gosa Amaleki hobaasa jed'ani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
