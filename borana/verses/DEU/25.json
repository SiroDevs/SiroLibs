                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.28"
              },
              "items": [
                {
                  "text": "Luk 20.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo oboleyaani lama, ta woliini teetu, toko ilma male due, niiti isaa nami ala d'ibiini infuud'iini; ha oboleesumani isaa sunini fuud'e niiti tolfate ilmaani iraa d'aluti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilmi qara isiini d'altu ka d'iirsa isii ka due taha, aka gosa Israeli keesa maqa isaa badu d'owani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7+RUT.4.8"
              },
              "items": [
                {
                  "text": "Rut 4.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ammo yo oboleesi nama due sunini niiti suni fuud'u infeene, isiini ha gaara jaarole d'at'e, oboleesi d'iirsa kiyya ya na fuud'e maqa d'iirsa kiyya gosa Israeli keesa badu d'owu didde jette himattu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba jaaroleeni dira suni ha isa yaamte gaafatu. Yo inni jaarolele irati anini isi infuud'u jed'e dide, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "niitiini oboleesi isaa ira due sunini ha jaarole dura d'ufte, kobe isaa toko faana baafte, hanch'ufa fuulati tufte waan jettuuni, Wonti namicha niiti oboleesa isaa d'aalu dide tolchani tana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba gosa Israeli keesa, worra isaa worra namicha kobe ira baasani kaani jed'ani yaamani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
    {
