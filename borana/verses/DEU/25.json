            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14"
              },
              "items": [
                {
                  "text": "Bah 17.8-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Qaabad'a, waan worri gosa Amaleki gaafa isani lafa Misiri keesaa baatani isani tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.17",
            "verseOrgIds": [
              "DEU.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri sunini Waaqa insodaanne, tanaafi worri dudda duubani, ka isani dad'abi injirre, isani had'e, nama yau dad'abe isani jalaa hafe fit'e. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.18",
            "verseOrgIds": [
              "DEU.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi duuba eegi AABBO Waaqi keesani lafa ch'ufa isanii kenne, nyaapa isaani d'aatu jiru ch'ufa isani dura baase, lafa nagaya tolche, jabaad'a, worra gosa Amaleki ch'ufa hobaasa, aka deebiani maqa worra nami lafa irati inqaabanne. Dubbi tana inded'ina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.19",
            "verseOrgIds": [
              "DEU.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mid'aani gaafa muransa Waaqa baasani",
          "type": "text"
        }
      ]
    }
