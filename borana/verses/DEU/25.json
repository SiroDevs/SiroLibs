            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo ato nami lama ka d'iira woldidu, niitiini toko d'iirsa kalchaa d'ufte namicha kaani nafa saala qabde, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "inahiinaafi harka iraa kuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
    },
