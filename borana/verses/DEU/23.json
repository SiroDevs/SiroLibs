            }
          ]
        },
        {
          "text": "Hojja AABBO Waaqa keesaniti kakhattani, hurrisa waan iti kakhatani suni baasa; wonti akanatiifi AABBO Waaqi keesani waan suni isani ira fed'a, yo isani guutu baattani wollaala isanii taati. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo AABBO Waaqati kakhachu baattani wollaala inqabdani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo fed'i teesani gula kakhattani, jabeesa guuta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
