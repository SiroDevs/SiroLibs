              "items": [
                {
                  "text": "Law 19.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa Israeli, d'iirafi nad'eeni taanaani fulla waaqa iti kad'ataniti sharmut'a intahini. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
            "verseOrgIds": [
              "DEU.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle beese kara sharmut'oma kanaani argatani Mana AABBO Waaqa keesani d'uftani, waan kakhatani Waaqaa baaftani tolchitani imbaasina. AABBO Waaqi sharmut'oma akana kana guddo jibba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.18",
            "verseOrgIds": [
              "DEU.23.18"
            ]
          }
        }
      ]
    },
