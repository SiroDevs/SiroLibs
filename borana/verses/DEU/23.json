            "sid": "DEU 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami kolaasaniifi ka nafa saala muratani ch'ufa ha gumi AABBO Waaqa keesaa kutaniiti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.1",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ch'abanafi ilmaani inni d'alu, haga d'aloota kud'anneeso, ha gumi AABBO Waaqa keesaa kutaniiti.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.2",
            "verseOrgIds": [
              "DEU.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
