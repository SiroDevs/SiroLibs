                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Qab-Ser 15.7-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hojja nama gosa teesani, beese taanaani, sagale taanaani waan d'ibile taanaani liqeesitanifi, haga liqeesitanifi suni male waan d'ibi iraa infud'atina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.19",
            "verseOrgIds": [
              "DEU.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nama gosa teesani intahini, yo iraa fud'attani womaaniti, ammo gosa teesani ta Israeli woma iraa infud'atina. Yo isani aada tana jabeesitani, AABBO Waaqi keesani, lafa isani fud'atani iti qubachu geetani keesati, waan isani tolchitani ch'ufa keesa isani eebisa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        }
      ]
    },
