          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hojja oobru zabibu, ta nama d'iibi, keesa yaatani, mid'aani haguma feetani nyaad'a, quufa, ammo tokoleeni ingalatina. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.24",
            "verseOrgIds": [
              "DEU.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle hojja oobru biilaa ta nama d'ibii, keesa yaatani, mid'aani haga feetani harkaani t'ururad'a nyaad'a ammo tokole hamtuni inhaamiina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.25",
            "verseOrgIds": [
              "DEU.23.25"
            ]
          }
        }
      ]
