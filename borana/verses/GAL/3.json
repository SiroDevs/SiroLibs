        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
