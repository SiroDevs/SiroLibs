              "GAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 3:10"
          },
          "items": [
            {
              "text": "10",
