              },
              "items": [
                {
                  "text": "Rum 4.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Akuma t'aafiini waan Abrahamu dubbatte waan jettu: Inni Waaqa d'ugefannaani maro d'ugefacha isaatiifi Waaqi d'uga heregeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.6",
            "verseOrgIds": [
              "GAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.16"
              },
              "items": [
                {
                  "text": "Rum 4.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Isani hubachu maltani aka worri d'ugefacha qabu ch'ufti d'aloota Abrahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.7",
            "verseOrgIds": [
              "GAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Uum 12.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " T'aafiini, aka Waaqi d'ugefachaani gosa d'ibi d'uga hereguufi duru argite, jennaani t'aafiini Odu Dansa duriyu Abrahamu barsiifte waan jette, Maro teetiifi Waaqi nama lafa jiru ch'ufa eebisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.8",
            "verseOrgIds": [
              "GAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamuni d'ugefateti eeba argate; tanaafi nama d'ugefatu ch'ufa akuma isaa eebisani.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
