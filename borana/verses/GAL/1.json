          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haga kana ch'ufa gumiini Kristiana ta Yudea keesa jirtu fuulale na imbeetu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
