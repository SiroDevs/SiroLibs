          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan biyyiti wolti hasoofte ch'alla beekhani: Namichi duri nu gaargalche kaani amma d'ugefacha duri balleesu fed'e taani tae barsiisa! jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
