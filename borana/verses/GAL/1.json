              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi suni anini lafa Shamutiifi ta Kilikia keesa deeme. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
