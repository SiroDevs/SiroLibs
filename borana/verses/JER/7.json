          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Yuda ya waan hamtu na durati tolche, worri waaqa isaani ka harkaani boch'ani, ka anini jibbu, mana kiyya keesa kaye akasiini t'ureese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.30",
            "verseOrgIds": [
              "JER.7.30"
            ]
          }
        },
