              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.7.29",
            "verseOrgIds": [
              "JER.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
