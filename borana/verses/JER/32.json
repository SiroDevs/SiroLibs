          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.1+2KI.25.2+2KI.25.3+2KI.25.4+2KI.25.5+2KI.25.6+2KI.25.7+2KI.25.8+2KI.25.9+2KI.25.10+2KI.25.11"
              },
              "items": [
                {
                  "text": "2 Hay 25.1-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.17+2CH.36.18+2CH.36.19+2CH.36.20+2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Od-dur 36.17-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini dira kana harka hayyu Babiloni ka Nebukadreza jed'anitifi duula isaati kenna. Worri dira kana dabsate, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibida iti kaye maneeni nami gubba isaati hit'aana Baali aarse, daad'i waaqa d'ibi d'ibaayu baasani akasiini na dallansisanile guba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haguma duriti worri Israelitiifi ka Yudaleeni waan tolchani ch'ufaani ya garaa na yake na dallansiise. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami dira kana haguma gaafa duri isa jaaraniti haga arrale yayu na hiifachise na dallansiise. Tanaafi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "maro worra Yudatifi ka Yerusalemutifi hayyootafi jaaroleefi qaaloleefi raagooti worraa hameenna tolchiteefi, anini dira suni fuula kiyya duraa balleesu fed'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri dudda nati garagale, ammalle ato anini guyya ch'ufa barsiisele, worri na ch'aqase woma naraa imbaranne. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
