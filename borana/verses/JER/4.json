            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, Isani, worri Israeli, yo deebiu feetani, nati deebia. Yo isani waaqa harkaani mid'aafatani, ka anini jibbu gadi gatani naraa goru diddani, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.1",
            "verseOrgIds": [
              "JER.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "d'uga qabdani aka maqa kiyyaani kad'attani. Duuba gochiti ch'ufti, Nuu eebisi nani jette na faarsiti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.2",
            "verseOrgIds": [
              "JER.4.2"
            ]
          }
        }
      ]
    },
    {
