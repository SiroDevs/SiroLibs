                  "text": "2 Hay 24.18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.11+2CH.36.12+2CH.36.13"
              },
              "items": [
                {
                  "text": "2 Od-dur 36.11-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Akuma Yosiani, ilmi Sedekia, hayyu Yuda taheeni, AABBO Waaqi waan nani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qaampara gogafi mukhaani mid'aafad'i, morma ira keeyad'i. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba gara hayyu Edomutifi ka Moabutifi ka Amonitifi ka Tirotifi ka Sidoni, jara worri gara Sedekia hayyu Yuda ka Yerusalemu jiruti ergeeni qonqo ergi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Qonqooni atini worraani, hayyoota keesaniti d'aama jettuuni tana: Wonti AABBO Waaqi guddaani, Waaqi Israeli, jed'u tana: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irreefi jabeenna kiyya guddaani anini lafafi namaafi bineensa lafa keesa jiru ch'ufa uume, lafa suni nama anini jaalad'u kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami gosa tana ch'ufa harka hojattu tiyya Nebukadreza hayyu Babiloniti kenne anuma, anini bineensa alalle ch'ufa isa jalati bulche. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gochiti ch'ufti isaafi ilma isaatifi akhaakhu isale jalati bulti, haga guyyaani lafti isaa baddu gahuti. Duuba gaafasi gochiti isaa gosa jabduufi hayyoota gugurdo jalati bulti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo lafafi gochiti toko isa jalati bulu didde, anini gosa suni woraanafi beelafi d'ukubaani balleesa, haga Nebukadrezani jabeenna ufitini gosa suni balleesuti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi raagoota teesanifi nama wo himuufi nama oobju qabuufi nama ekhera wo gaafatufi falfatu, hayyu Babiloni jalati imbulina isaniini jettule inch'aqasina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri isani sobe aka boojiani lafa teesani ira isani fageesani isani tolcha. Anini lafa teesani keesaa isani baase, duuba akasiini isani balleesani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo yo gochiti tokoleeni ee jette hayyu Babiloni jalati bulte, Anini gosa suni lafa isaani keesati lakise, Worri oobru qotate achuma taa. Nami dubbi tana jed'e ana, AABBO Waaqa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini woma suni Sedekia hayyu Yudati hime waan jed'e. Ee jed'aa, hayyu Babilonitifi nama isa ch'ufa jalati bula, duuba injiraattani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siifi worri kanke maafi woraana yokhaani beela yokhaani d'ukubaani dootani? Wonti AABBO Waaqi gosa ee jette hayyu Babiloni jalati bulu diddu tolchu suni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raagoota, hayyu Babiloni jalati imbulina jettu, inch'aqasina. Worri isani sobuu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqumati, Anini raagoota suni inergine, worri maqa kiyyaani waan d'ara faguu jira jed'a. Tanaafi inni isani gusse, isanifi raagoota waan d'ara kana isaniti himtu tanale ijeesani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini waan qaaloleefi gumi ch'ufaani jed'e, AABBO Waaqi waan jed'u, raagoota, miha Mana Waaqa ka boojiani lafa Babiloni geesani d'iotu indeebisani jettu, inch'aqasina. Worri isaniti kiyyibuu jira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worra inch'aqasina, hayyu Babiloni jalati bula, injiraattani! Diri kunini maafi bade ona taha? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo worri d'uguma raaga tahe dubbi AABBO Waaqatini dubbate, worri ha ana, AABBO Waaqa gudda gaafatuti, aka miha Mana Waaqa keesati hafufi miha d'ibi ka mana hayyu keesa jirule Babiloni ingeesine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Gaafa hayyichi Nebukadrezani Yehoiakini, ilma Yehoiakimu hayyu Yudatifi jaarole Yudatifi ta Yerusalemu boojie lafa Babiloni geese, inni utuba Mana Waaqatifi haro sibiila diimatifi gaarifi miha Mana Waaqa d'ibile achumati hambise.)",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19+JER.27.20",
            "verseOrgIds": [
              "JER.27.19",
              "JER.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19+JER.27.20",
            "verseOrgIds": [
              "JER.27.19",
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waan miha suni ka Mana Waaqatifi mana hayyu ka Yerusalemuti hafe ka anini, AABBO Waaqa guddaani Israeli jed'u, ch'aqasi: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miha suni lafa Babiloni geesani, haga anini barbaada d'ufuti achumati lakisani. Duuba eegi suni anini guure, fulla tanati deebisa. Nami dubbi tana jed'e ana, AABBO Waaqa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiafi raaga Hanania",
          "type": "text"
        }
      ]
    }
  ],
