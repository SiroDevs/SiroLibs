        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaarole gumi tiyya tissitu, iyya, boha! Boha, biyye keesa gangalad'a. Guyyaani isani qaqalani ya gahe akuma Elemiye gagabbo isani qaqalani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fullaani isani baqattani iti baatani injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isani bootani, gaargala keesa arrifattani, waan AABBO Waaqi dallansu ufi keesa gosa teesani balleese lafa teesani ta nagaya qabdu ona tolcheefi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36+JER.25.37",
            "verseOrgIds": [
              "JER.25.36",
              "JER.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi yayu gumi isa lakise akuma nyeench'i goda ufi lakisu. Maro woraana nyaapatifi dallansu hamtu AABBO Waaqale lafti yayu badde aloo taate.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
    },
