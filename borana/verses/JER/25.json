        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan nani jed'e, Waan atini worraani jettu, AABBO Waaqi guddaani, Waaqi Israeli, waan jed'u: D'uga, machaa, diddifad'a, woraana anini isaniti erguuni hobaa, haguma jirtani inkaina. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
