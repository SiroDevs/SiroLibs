                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ganna afreeso ka Yehoiakimuni, ilmi Yosia, hayyu Yuda tahe, qonqooni waan worra Yuda dubbatu AABBO Waaqa iraa nati d'ufte. (Gaafasi ganna qara ka Nebukadrezani hayyu Babiloni tahe.) ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani anini waan worra Yerusalemutifi ka Yudatini jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganna diddami sadi haguma ganna kud'ani sadeeso ka Yosiani, ilmi Amoni, hayyu Yuda tahe asi haga arrale Waaqi nani dubbachu illakimne, aninileeni maro ch'ufa dubbi suni ya isaniti hime; ammo isani ch'aqasu diddani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato AABBO Waaqi raagoota hojattu isaa isaniti bara ch'ufa ergele, isani inch'aqamne yokhaani dubbi suni womatu indarre. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri waan jed'e, Isani nami ch'ufti kara hama kanafi waan hamtu tahuti, jirtani kana iraa deebia, duuba akanaani lafa AABBO Waaqi isanifi ababoota teesani haga jiru jireenna d'aalaa kenne keesa teetani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqoota d'ibi gula yaatani hojattani inkad'atiina, waan harkaani boch'atani kad'attani AABBO Waaqa indallansisina. Yo isani akasi taatani Waaqi woma isani intolchu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo AABBO Waaqi waan jed'u, Isani na ch'aqasu diddani, waan harkaani boch'ani kad'attanini na dallansiiftani, duuba akanaani badi ufitini d'uftani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tanaafi AABBO Waaqi guddaani waan jed'u, Waan isani dubbi tiyya ch'aqasu diddanifi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "anini gosa mirga teetu ch'ufafi hojatu tiyya Nebukadreza hayyu Babiloni yaame, lafa tanaafi nama isi keesa taufi lafa d'aatu jirtu ch'ufa haasisa. Anini gosa Yuda tanaafi gosa worra d'aatu teetule balleese lafa worrale haga jiru jireenna onse waan nami hojja qaabatu ch'ufa iraa rifatu tolcha. Nami dubbi tana jed'e ana, AABBO Waaqa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer 7.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
