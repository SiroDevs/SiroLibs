          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo worri ana, AABBO Waaqa isaaniti hojate, nama d'aloota Daudi ka anini hayyu tolchule hojata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
