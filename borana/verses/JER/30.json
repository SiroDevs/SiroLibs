          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani waan jed'u: Hojja guyyaani suni d'ufu, anini qaampara morma isaaniti jiru ch'abse sansalata iraa baasa, duuba worri ituma deebie tisse gosa d'ibi intahu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
