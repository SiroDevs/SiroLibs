                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tanaafi AABBO Waaqi waan Yehoiakimu, ilma Yosia, ka hayyu Yuda, akana jed'a:",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
