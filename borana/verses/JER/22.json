        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini waan jed'e, Namichi Yehoiakini jed'ani kunini, ya okote faara, ta nami infeene, ta ch'abt'e gatani, tahe? Wonti isaafi ilmaani isaa boojiani lafa worri waan isii imbeenne geesanifi tana?",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        }
      ]
    },
    {
