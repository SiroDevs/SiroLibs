                "loc": "2KI.23.10"
              },
              "items": [
                {
                  "text": "2 Hay 23.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31+JER.7.32"
              },
              "items": [
                {
                  "text": "Yer 7.30-32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.34+JER.32.35"
              },
              "items": [
                {
                  "text": "32.34-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "fullo ch'ach'aba Faaratini dira keesa baha bale Hinomu d'aqa. Achiti dubbi anini siti himu tana biyyati himi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.2",
            "verseOrgIds": [
              "JER.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "waan jettuuni, Dubbi AABBO Waaqa d'agaya, hayyoota Yudatifi worra Yerusalemu dubbi AABBO Waaqi guddaani, Waaqi Israeli, jed'u ch'aqasa. Anini badi hamtu lafa tanatini d'ufa, ta nami d'agaye ch'ufti rifate maadefate, akanumati afaani qabatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.3",
            "verseOrgIds": [
              "JER.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonti anini akasi tolchufi waan worri kunini na lakise, waaqa d'araati sorio baase, waaqa d'ibi ka worraafi abbooti worraatifi hayyooti Yuda haga d'alate waan isaa imbeenne, sorio baasani, akanaani lafa tana t'ureesani. Worri yayu lafa tana d'iiga nama woma iyyakiniti balleese. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.4",
            "verseOrgIds": [
              "JER.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.21"
              },
              "items": [
                {
                  "text": "Law 18.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Fulla sorio irati qalani waaqa Baali jed'ani jaare, ilmaani isaani arti irati gube sorio baase. Anini waan kana tolcha injenne, yokhaani inherennele. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.5",
            "verseOrgIds": [
              "JER.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba guyyaani ind'ufa ka fulla tanaani deebiani Tofethi yokhaani Bale Hinomu injenne, ammo Bale Qalma jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.6",
            "verseOrgIds": [
              "JER.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fulla tanati anini mala worra Yudatifi ka Yerusalemu balleese, harka nyaapa keesa buuse, nyaapi sunini worra had'e dabsate, aninileeni reefa worraa allaatifi bineensa ala nyaachisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.7",
            "verseOrgIds": [
              "JER.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini dira kana aka takaa inargini balleese, duuba nami d'aatu bahe dabru ch'ufti rifate maadefate afaani qabata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.8",
            "verseOrgIds": [
              "JER.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyaapi dira marse, nama keesa jiru hobaasu fed'a. Duuba worri dira suni keesa jiru maro gaargala sunitifi fooni woli nyaate ilmaani ufile nyaata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.9",
            "verseOrgIds": [
              "JER.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi, ato jari si woliini jiru sunini argu, okote suni ch'absi naani jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.10",
            "verseOrgIds": [
              "JER.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba waan worraani jettu, AABBO Waaqi guddaani waan jed'u, Anini gumi tanaafi dira kana, akuma okote faara ta eegi ch'absani dandaani imid'aasine, ch'ach'absa. Tofethi keesaleti woli awaalani, wonti akanatiifi fullaani worra iti awaalani d'ibiini injirtu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.11",
            "verseOrgIds": [
              "JER.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'u, anini dira kanafi nama keesa taule akuma Tofethi tolcha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.12",
            "verseOrgIds": [
              "JER.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maneeni Yerusalemutifi ta hayyoota Yudatifi yokhaani maneeni gubba isiiti urjii hit'aana aarsanifi daad'iini waaqa d'ibii buusanileeni ch'ufti akuma Tofethi t'uroofti.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.13",
            "verseOrgIds": [
              "JER.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yeremiani fulla AABBO Waaqi iti fagi jed'eeni, ta Tofethi jed'ani bahe, d'aqe naabo Mana Waaqa keesa eje, waan biyyaani jed'e, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.14",
            "verseOrgIds": [
              "JER.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi guddaani, Waaqi Israeli, waan jed'e; Anini dira kanafi ollowaani d'aatu jirtu ch'ufa gaargala anini ind'ufaani jed'eeni ch'ufa itiini d'ufa; wonti akanatiifi worri yayu mata jabaate, dubbi tiyya ch'aqasu dide.",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.15",
            "verseOrgIds": [
              "JER.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yeremiafi qaallichi Pashuri jed'ani wol d'abani",
          "type": "text"
        }
      ]
    }
  ],
