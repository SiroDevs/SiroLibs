            }
          ]
        },
        {
          "text": "AABBO Waaqi waan nani jed'e, Beeni, okote faara nama faara kuuch'u ira bitad'i, duuba jaarole gumitifi qaalole gugurdo yaami, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.19.1",
            "verseOrgIds": [
              "JER.19.1"
            ]
          }
        },
        {
