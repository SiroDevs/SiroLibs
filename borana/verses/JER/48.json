                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wonti moabu ka AABBO Waaqi guddaani dubbate tana:",
          "type": "text",
          "attrs": {
            "verseId": "JER.48.1",
            "verseOrgIds": [
              "JER.48.1"
            ]
