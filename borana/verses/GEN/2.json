        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.20",
            "verseOrgIds": [
              "GEN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi aka jaba isa rafise, duuba ato inni rafu, ch'inaacha isaa toko keesaa fuud'e, fulla suni akuma duriti deebise. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba ch'inaacha keesaa fuud'ani kaani nama uwa tolche namichatiini d'ufe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
            "verseOrgIds": [
              "GEN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani namichi waan jed'e,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.23",
            "verseOrgIds": [
              "GEN.2.23"
            ]
          }
        }
      ]
    },
    {
