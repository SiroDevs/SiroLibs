                }
              ]
            }
          ]
        },
        {
          "text": "Eegi nami hore heddate dubrale d'ale, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.1",
            "verseOrgIds": [
              "GEN.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmaani Waaqa toko aka dubarti namaa mid'aadu agarte jennaani ta feetu fuute. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.2",
            "verseOrgIds": [
              "GEN.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan jed'e, Lubbuuni tiyya ta nama jiraachiiftu haga jirtu nama keesa inteetu; wonti akanatiifi nami foonuma, armaa achi ganna d'ibbafi diddama indabru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.33"
              },
              "items": [
                {
                  "text": "Hen 13.33",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaafasifi eegi sunile worra gugurda toko lafa jira, ka haga woi gagahu, ka dubarti namaatiifi ilmaani Waaqaa d'alte. Worri worra jajaba duri, ka lafa keesati gurra qabu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        }
      ]
