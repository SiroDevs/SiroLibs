                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan jed'e, Namichi kunini ya akuma keenna tahe waan hamtufi dansa gargari hubate. Tanaafi inni amma tana harka d'eerefate mid'aani mukha jireennaa buqise nyaate haga jiru jireenna jiraachuuni himmalle. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
