            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni Yuda ufi dura erge Yusufuuni, Lafa Gosheniti wolargina jed'e. Worri artini bahe ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "jennaani Yusufuuni gaari ufii yaabate lafa Gosheni abba yoyifachu d'aqe. Wolarginaani Yusufuuni abbaati mamarate guddo bohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni waan Yusufuuni jed'e, Amma yo due womaniti, fuula ke si arge, aka atini jirtu ya beekhe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        }
      ]
    },
