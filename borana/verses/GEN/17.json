      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ganni Abramu sagaltami sagali geennaani AABBO Waaqi isati mullate waan jed'eeni, Anini Waaqa Gudda. Na ch'aqasi, waan hamtu intolchini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaafi sii wold'aqisa woliini tolfanne ilmaani heddu sii kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abramuuni Waaqa dura gajed'e, Waaqi waan jed'eeni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini wold'aqisa si woliini tolfad'e, abba gosa heddu taata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.17"
              },
              "items": [
                {
                  "text": "Rum 4.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Arraa achi maqaani kanke Abramuniti ammo Abrahamu siini jed'ani, wonti akanatiifi anini ya abba gosa heddu si tolche. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anini si daraarse ilmaani tante gosa heddu sii tolche, ta garileeni hayyu taati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
