  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "GEN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani AABBO Waaqi waan Nuhuuni jed'e, Beena, siifi worri kanke ch'ufti hobolo seena, ani layu arge, nama lafa ke jiru ch'ufa keesa sii ch'allati nama d'ugaati. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa nami nyaatu keesa, kormafi d'alale torba torba fuud'i, ammo bineensa nami inyaanne, kormafi d'ala, toko toko fuud'i. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle simpirreefi allaati gosa ch'ufa keesa, kormafi d'altu torba torba fuud'i. Wonti atini akasi tolchitufi, aka bineensi kunini ch'ufti bahe taka tana d'alu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi torbaani toko bokaya jabaa rooba, ka halkanifi guyya afurtama garagari inch'inne, aka waan lubbu qaba, ka anini mid'aase ch'ufa, lafa iraa balleesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuhuuni, akuma Waaqi jed'eeni, waan ch'ufa tolche guute.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaafa lolaani fach'ae lafa fud'ate ganni Nuhu d'ibba jaa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.38+MAT.24.39"
              },
              "items": [
                {
                  "text": "Mat 24.38-39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.27"
              },
              "items": [
                {
                  "text": "Luk 17.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Duuba isa, niiti isaati, ilmaani worraatifi nad'eeni worraleeni aka fach'aa bisaani duraa bahani hobolo duudani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa nami nyaatufi ka nami inyaannele, simpirreefi bineensa garaani lafa ira lohule ch'ufa keesa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "lama lamaani, d'alafi kormi, Nuhu woliini hobolo duudani, akuma Waaqi jed'eeni kaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegi bulti torba lolaani fach'ae bisaani lafa fud'atani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
