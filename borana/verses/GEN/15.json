            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.13"
              },
              "items": [
                {
                  "text": "Ayu 4.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.4.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aduuni d'iu geennaani hiribi guddaani Abramu qabate, hiriba suni keesa inni guddo nahe rifate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
