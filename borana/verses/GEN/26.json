              "type": "text"
            }
          ]
        },
        {
          "text": "Abimelekiini Gerari bahe, nama isaa mala d'au, ka Ahuzathi jed'anifi gudda askarti isaa, ka Fikoli jed'ani, woliini Isaaqo argu d'aqani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
            "verseOrgIds": [
              "GEN.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaqooni waan jed'eeni, Isani amma maafi na argu d'uftani, ka duri na jibbitani lafa teesani keesaa na haatani?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
            "verseOrgIds": [
              "GEN.26.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
