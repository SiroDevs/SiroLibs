              "type": "text"
            }
          ]
        },
        {
          "text": "Esauuni ganna afurtamati dubra gosa Hiti lama fuud'e: toko Yudithi, intala Beeri, taani Basemathi, intala Eloni jed'ani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.34",
