          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiini lamaani Isaaqofi Rebeka jireenna yakite.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.35",
