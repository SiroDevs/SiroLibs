          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi aka Lea jibbani arginaani naheefi ilma kenneefi, ammo Raheliini ilmaani male teete. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leani garaachoofte ilma deete waan jette. AABBO Waaqi ya gaargala kiyya arge naa nahe, amma d'iirsi kiyyaleeni na jaalata; tanaafi gurba maqa Reubeni baafteefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle garaachoofte ilma d'ibi deete waan jette, AABBO Waaqi ya aka na jibbani arge ilmaani d'ibile naa kenne; tanaafi maqa isaa Simeoni baafte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle garaachoofte ilma d'ibile deete waan jette, Amma d'iirsi kiyya naraa imbahu, waan anini ilmaani sadi d'aleefi; tanaafi isiini maqa isaa Lawi baafte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eegele garaachoofte ilma deete, Amma anini maqa AABBO Waaqaa faarsa jette, maqa Yuda baafte. Duuba suni d'alte jennaani jidduti deemte.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
