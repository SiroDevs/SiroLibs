              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamuuni ganna d'ibbafi sodoma gahe jennaani ilma waan ch'ufaani isa fakaatu d'ale maqa Sethi baaseefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
