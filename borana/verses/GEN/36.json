          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri duri lafa Edomu keesa tau gosa gosati gargari qoodame. Gochiti tunini ilmaani Seiri, ka gosa Hori, iraa horte: Lotani, Shobali, Sibeoni, Ana, Dishoni, Eseri ammalle Dishani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.20+GEN.36.21",
            "verseOrgIds": [
              "GEN.36.20",
              "GEN.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
