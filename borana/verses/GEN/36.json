          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sibeoniini ilmaani d'iira lama qaba, Ayafi Ana. (Anaani kunini ka madda bisaani owitu yaatu arge, ato harre abba isaa tissu.) ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
              "GEN.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaani abba Dishoni, ka balbalti Hemdani, Eshbani, Ithrani ammalle Kerani iraa horte. Analeeni intala dubra, ta Oholibama jed'ani, qaba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.25+GEN.36.26",
            "verseOrgIds": [
              "GEN.36.25",
              "GEN.36.26"
            ]
          }
        }
