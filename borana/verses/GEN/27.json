              "items": [
                {
                  "text": "Ebr 11.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani Isaaqooni waan jed'eeni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
          }
        }
