            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esauuni abba sobate waan jed'eeni, Eebiti tante suni ch'allaa, aabbo? Nale eebisi jed'e bohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        },
        {
