    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaqooni jaare ila d'abe jennaani ilma isaa ka angafa Esau yaame waan jed'eeni, Gurba! Jennaani inni, Ya jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.1",
            "verseOrgIds": [
              "GEN.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaqooni waan jed'eeni, Anini ya jaare, guyya kiyya imbeekhu, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.2",
            "verseOrgIds": [
              "GEN.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "guubefi t'iya tante fud'ad'i, adamo d'aqi, bineensa naa ijeesi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.3",
            "verseOrgIds": [
              "GEN.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagale miooftu anini fed'u d'aabi naa kootiini, aka anini nyaad'e, ato induiinu si eebisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.4",
            "verseOrgIds": [
              "GEN.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rebekaani waan Isaaqooni Esauuni jed'e ch'ufa d'ageete, Esauuni adamo deemnaani ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.5",
            "verseOrgIds": [
              "GEN.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yaamte waan jetteeni, Anini reefuma tana waan abbe Esauuni jed'e d'agaye: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.6",
            "verseOrgIds": [
              "GEN.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bineensa ijeesi, naa kootiini, sagale miooftu naa d'aabi, aka anini nyaad'e, AABBO Waaqa durati, ato induiini si eebisu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.7",
            "verseOrgIds": [
              "GEN.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma, gurba kiyya, na ch'aqasi, waan anini siini jed'u ch'ufa guuti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.8",
            "verseOrgIds": [
              "GEN.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gara ree d'aqi, kaarata laleesa gagabba lama fuud'i, aka anini sagale miooftu abbe guddo jaalatu d'aabuufi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.9",
            "verseOrgIds": [
              "GEN.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba abbeeti geesi, aka inni nyaate, ato induiinu si eebisu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.10",
            "verseOrgIds": [
              "GEN.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yakobooni waan haad'aani jed'e, Atini imbeeta, nafi Esauu dabassicha, kiyya ammo qulqullicha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.11",
            "verseOrgIds": [
              "GEN.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hegeri aabbooni na qabate, aka anini isa sobe beekate, fulla eeba anini abaarsa ufitiini d'ufa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.12",
            "verseOrgIds": [
              "GEN.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haati waan jetteeni, Abaarsi suni ha na qabatuuti, waanuma anini siini jed'e guuti, beeni, kaarata suniini kooti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.13",
            "verseOrgIds": [
              "GEN.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba inni d'aqe kaarata kaani fuud'e isiitiini d'ufe, isiini sagale miooftu abbaani jaalatu d'aabdeefi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.14",
            "verseOrgIds": [
              "GEN.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Woya Esau ta ch'ufa ira dansa mana isiiti fuute Yakobo much'a maand'ichati keete. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.15",
            "verseOrgIds": [
              "GEN.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba goga kaaroota sunile fuute harkaafi fulla morma ta rifeensa inqamneti keete. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.16",
            "verseOrgIds": [
              "GEN.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sagale miooftu d'aabdeefi qit'a Yakoboo kennite.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.17",
            "verseOrgIds": [
              "GEN.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Yakobooni gara abba d'aqe, Aabbo jed'e. Abbaani owaate waan jed'e, Atini eenu kana, ilma kiyya? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.18",
            "verseOrgIds": [
              "GEN.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni waan jed'eeni, Anini angafa kanke Esau; ya waan atini naani jette guute, kai, fooni bineensa anini galeeni kana nyaad'i, na eebisi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.19",
            "verseOrgIds": [
              "GEN.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaqooni waan jed'eeni, Atini akami akana yoosu agarte, ilma kiyya? Yakobooni waan jed'eeni, AABBO Waaqi kanke, na qarqaare naa baase.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.20",
            "verseOrgIds": [
              "GEN.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Isaaqooni waan Yakobooni jed'e, Me gadi hiiqi, si qaqabad'e laala, aka atini d'uguma Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.21",
            "verseOrgIds": [
              "GEN.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yakobooni abbaati hiiqe, abbaani qaqabate waan jed'eeni, Qonqooni qonqo Yakobooti, ammo harki ka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo inni Yakobo hubachu dad'abe, waan harki isaa dabassa aka ka Esau qabuufi isa eebise. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo ammalle gaafate waan jed'e, Atini d'uguma Esau? Inni, Ee jed'eeni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Isaaqooni waan jed'e, Fooniini na kooti, aka anini sagale harka kanketi nyaad'e si eebisu. Yakobooni foonifi daad'i inni d'ugu d'ufeeniifi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani abbaani waan jed'eeni, Nati hiiqi, na d'ungad'u, ilma kiyya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.20"
              },
              "items": [
                {
                  "text": "Ebr 11.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Inni ind'ungata iti gadihiiqe jennaani Isaaqooni urgaa woya isaa suufe eebiseefi waan jed'e, Fooleeni gurba kiyya aka foole oobru AABBO Waaqi eebiseefi urgoofti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waaqi sii roobe, oobru sii eebise, mid'aanifi daad'i guddo sii kenninna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
