          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaaqooni waan jed'eeni, Anini isa yayu moticha kanke tolche, oboleyaani isaa ch'ufa hojattu isaa tolche. Anini isaa mid'aanifi daad'ile ya kenneefi, amma woma inhamne, maani sii tolcha, ilma kiyya?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
