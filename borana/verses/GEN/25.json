              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobooni waan jed'eeni, Hojja atini angafooma kanke naa gurgurte, sii kenna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
