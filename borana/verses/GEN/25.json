      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyyaani ala hobae jennaani Rebekaani ijoolle lakoole lama d'alte. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka qara d'alate diima d'iiga, nafi dabassa, tanaafi maqa Esau baasanifi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka lameeso hirba Esauti qanch'oorfate d'alate, tanaafi maqa isaa Yakobo baasani. Gaafa ijoolleeni tuni lamaani d'alatte, ganni Isaaqo jaatama.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Esauuni angafooma isaa gurgurate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
