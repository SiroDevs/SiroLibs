                {
                  "text": "Rum 9.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "AABBO Waaqi waan jed'eeni,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
