              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guyya toko ato Yakobooni sagale d'aabachu jiru, Esauuni, ka beela qabu, adamo gale ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
