            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Reubenitifi ka Gadileeni waan jed'e, fullaani sorio Waaqaa baasani tunini ha d'uga nu taatu, aka AABBOONI d'uguma Waaqa d'ugaa. Duuba fulla suni maqa iti baasani d'uga jed'aniini.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        }
