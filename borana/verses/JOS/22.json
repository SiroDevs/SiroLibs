          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani Finehasifi jaaroleeni taani worra gosa Reubenitifi ka Gadile, lafa Gileaditi lakisani biraa deemani, lafa kanaaniti gara worra Israeli galani, dubbi suni ch'ufa iti himani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Worri Israeli dubbi suni quufe Waaqa faarse, deebie aka lafa worri Reubenitifi ka Gadi keesa qubate had'e balleesu maqa ind'oomne. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
