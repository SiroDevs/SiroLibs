                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.5"
              },
              "items": [
                {
                  "text": "Qab-Ser 2.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Isaaqolee Yakoboofi Esau kenne. Esau, lafa Edomu ta gaareeni d'aala kenneefi, ammo ababooni keesani Yakobooni, ilmaani isaa woliini lafa Misiri d'aqe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Bah 3.1—12.4",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eegi suni anini Musafi Haruni erge, lafa Misiri gaargala gudda iti buuse keesaa isani baase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.1+EXO.14.2+EXO.14.3+EXO.14.4+EXO.14.5+EXO.14.6+EXO.14.7+EXO.14.8+EXO.14.9+EXO.14.10+EXO.14.11+EXO.14.12+EXO.14.13+EXO.14.14+EXO.14.15+EXO.14.16+EXO.14.17+EXO.14.18+EXO.14.19+EXO.14.20+EXO.14.21+EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29+EXO.14.30+EXO.14.31"
              },
              "items": [
                {
                  "text": "Bah 14.1-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini ababoota teesani lafa Misiri keesaa baamnaani worri Misiri gaari fardi hirkisufi worra farda yaabatuuni reebe galaana Diimani bahe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani ababooti teesani AABBO Waaqati boonnani inni jiddu worraatifi worra Misiri dukana kaye, bisaani galaana worra Misiri ira deebise. Isanileeni waan suni ya argitani. Isani lafa aloo ta gamooji ganna heddu teetani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Hen 21.21-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Jennaani anini lafa Amori worra galaana Yordani gama ilaboru tautiini isani d'ufe. Worri isani had'e ammo anini worra harka keesaniti kenne; duuba anini isani durati worra, balleese, lafa worraa fud'attani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.8",
            "verseOrgIds": [
              "JOS.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Hen 22.1—24.25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jennaani hayyuuni Moabu Balakini, ilmi Sipori, kae isani had'e. Inni qonqo gara Balamu ilma Beori erge, kooti worra kana abaari jed'e. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.9",
            "verseOrgIds": [
              "JOS.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo anini Balamu ch'aqasu dide, tanaafi inni isani eebise akanaani harka Balaki keesaa isani baase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.10",
            "verseOrgIds": [
              "JOS.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yos 3.14-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.1+JOS.6.2+JOS.6.3+JOS.6.4+JOS.6.5+JOS.6.6+JOS.6.7+JOS.6.8+JOS.6.9+JOS.6.10+JOS.6.11+JOS.6.12+JOS.6.13+JOS.6.14+JOS.6.15+JOS.6.16+JOS.6.17+JOS.6.18+JOS.6.19+JOS.6.20+JOS.6.21"
              },
              "items": [
                {
                  "text": "6.1-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Duuba isani galaana Yordani taakinaani, dira Yeriko d'uftani, worri Yerikoleeni isani had'e akasuma worri gosa Amori, ka Perezi ka Kanaani, ka Hiti ka Girgashi, ka Hivi, ka Yebusileeni isani had'e. Ammo anini worra ch'ufa harka keesaniti kenne, isani worra dabsatani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Bah 23.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.20"
              },
              "items": [
                {
                  "text": "Qab-Ser 7.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aka soonsi nama rifachiisu anini worra isani dura rifachiise, hayyoota Amori lamaani isani duraa gusse ka isani t'iyaafi guube teesaniini woma intolchine. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.10+DEU.6.11"
              },
              "items": [
                {
                  "text": "Qab-Ser 6.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Anini lafa isani inqotatini yokhaani dira isani injaaratini isanii kenne, amma tana isani lafafi dira suni keesa teetani, mid'aani zabibutifi mid'aani ejersa, ka isani taka inoobrini nyaattani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duuba Yoshuani ammalle waan jed'eeni, AABBO Waaqa sodaad'a d'ugaafi garaa tokooni isa hojad'a. Waaqoota d'ara ka ababooti teesani duri galaana Frati gammafi lafa Misiri keesati kad'atte d'id'imati d'aa, AABBO Waaqa ch'alla hojad'a. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.14",
            "verseOrgIds": [
              "JOS.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo isani AABBO Waaqa hojachu diddani arra ka hojattani fohad'a, yokhaani waaqoota d'ara ka ababooti teesani duri lafa galaani Frati gama kad'atte, yokhaani waaqoota d'ara ka worra Amori, ka amma isani lafa worra keesa teetani: Ammo anaafi worri kiyya gama keennani AABBO Waaqa hojanna. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.15",
            "verseOrgIds": [
              "JOS.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biyyitileeni waan jetteeni, Waaqi nuu didinna aka nu AABBO Waaqa lakimne waaqa d'ibi hojannu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.16",
            "verseOrgIds": [
              "JOS.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi keenna nuufi ababoota teenna tissooma lafa Misiri keesaa nu baase, nuleeni waan mama ka inni tolche ila teennaani argine. Ammalle gaafa nu lafa gosa heddu tana keesa godaanele inni godanna keesa aka heddu nu qorqorate. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.17",
            "verseOrgIds": [
              "JOS.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammalle worra Amori ch'ufa, ka lafa suni keesa taele, AABBO Waaqi nu duraa gusse, tanaafi nuleeni AABBO Waaqa hojanna, inni Waaqa keenna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ammo Yoshuani waan biyyaani jed'e, Isani dandeetani AABBO Waaqa inhojattani; inni Waaqa qulqullo, daba keesanile isani inaraaramu. Hojja waaqa d'ibi isa biraani kad'attani, inni dandae inoobsu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yo isani isa lakiftani waaqoota gosa d'ibiti hojattani, inni isaniti gaargale wo isani tolche isani balleesa, ato duri isaniti dansa sa tahelee.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
