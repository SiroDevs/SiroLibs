          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lafa worri Israeli argatte keesa dira afurtami saddeetitifi lafa d'aatu ta hori iti tissanille gosa Lawiti kennani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41+JOS.21.42",
            "verseOrgIds": [
              "JOS.21.41",
              "JOS.21.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka worra Israeli lafa kennanifi fud'ate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
