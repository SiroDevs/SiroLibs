            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 21:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanaani AABBO Waaqi lafa ababoota Israeliti inkenna jed'e kakhate worra Israeliti kenne. Worri lafa suni fud'ate jennaani qubate keesa tae. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi akuma ababoota worrati kakhate, lafa suni ch'ufa keesa nagaya kenne. Nyaapi worra tokoleeni taka worra dura inejine; wonti akanatiifi AABBO Waaqati nyaapa worra ch'ufa harka worrati kenne. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "AABBO Waaqi kakhu inni worra Israeliti kakhate ch'ufa tokole inhambimne ch'ufa guuteefi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yoshuani gosa Israeli ta ilaboru ufi iraa galche",
          "type": "text"
        }
      ]
