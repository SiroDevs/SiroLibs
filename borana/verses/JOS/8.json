            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "27.11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Worri Israeli, jaarole, gugurda worraati, jaallaboota worraati, keessuma, ch'ufti Sanduqa Wold'aqisa AABBO Waaqa gama gama ejaanjani fuula qaalole Lawi ta Sanduqani yaatuti deefatani. Worri hagi gari dudda gaara Gerezimuti deefate, ka garileeni gaara Ebaliti deefate ejaanje. Jennaani akuma hojattuuni AABBO Waaqa Musani tolcha jed'eeni worri worra Israeli eebise. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoshuani duuba Seera kana ch'ufa, eebaafi abaarsale woliini, akuma kitaaba Seera keesati t'aafani, soome. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dubbi Musani jed'e ch'ufa Yoshuani gumi artiti wolti baate soome. Gumi suni keesa nad'eenifi ijoolleefi worra gosa d'ibi ka worra Israeli keesa godaanuti jira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
