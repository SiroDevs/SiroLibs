                  "text": "Bah 20.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "akuma hojattuuni AABBO Waaqa Musani worra Israelitini jed'e, aka kitaaba Seera Musa keesati t'aafani: fulla suni d'akha sibiilani imboch'iniini mid'aasani, irati hori gubani. Sorio AABBO Waaqa baasanifi, sorio d'ibi ta wold'ageetile irati baasani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arti ka worri Israeli ch'ufti argu, Yoshuani Seera Musani t'aafe kaani iraa d'akha d'ibiti deebise. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
