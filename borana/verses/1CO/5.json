              "items": [
                {
                  "text": "17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Anini nama ala wollaala iti muru himmalle. Waaqati worra qora. Ammo isani nama gumi teesani wollaala iti muru himmalle? Akuma t'aafiini jettu, Nama akana hama kana gumi teesani keesa baasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12+1CO.5.13",
            "verseOrgIds": [
              "1CO.5.12",
              "1CO.5.13"
            ]
          }
        }
      ]
    },
    {
