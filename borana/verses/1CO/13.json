          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ato anini dandae afaani gosa ch'ufatiifi afaani malaikale dubbad'e, ammo jaalala inqamne, dubbini tiyya iyana bilbilatiifi qonqo dibele fakaatti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.13.1",
            "verseOrgIds": [
              "1CO.13.1"
            ]
          }
        },
        {
