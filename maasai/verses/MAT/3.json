              "items": [
                {
                  "text": "2 Int 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neishopito apa ninye Yohana enkila oo lpapit le ntames, o enkeene te mpolos enye; ore endaa enye na lmaat o naishi e ong'ata. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.4",
            "verseOrgIds": [
              "MAT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuo apa enetii ninye ina kata Yerusalem o Yudea pooki o lkirinen pooki le Yordan; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.5",
            "verseOrgIds": [
              "MAT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "neibatisai pooki to lkeju le Yordan eirridu ng'ok enye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.6",
            "verseOrgIds": [
              "MAT.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
