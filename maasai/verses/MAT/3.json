                  "text": "Lk 9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " naa ng'ura, nepuku oltoilo te shumata nejo, “Enkerai ai ena nanyor, natishipe te ninye.”",
          "type": "text",
          "attrs": {
