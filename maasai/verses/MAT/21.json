              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening ilapolosak kituaak o Lfarisayo kuna kitanyaanyukot, neyiolou aajo ninche eipirta. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.45",
