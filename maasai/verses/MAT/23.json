              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Woi Yerusalem, Yerusalem naar iloibonok le Nkai, nenang too soito lelo ooirriwakini ninye! Ai katitin aja atonyuaa ajo aiturrur inkera inono anaa enkuku naiturrur inkuoo enyena too naipuko enyena, nitanyaita! ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.37",
            "verseOrgIds": [
              "MAT.23.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 23:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neina enkaji inyi natung'eikiaki eliyio. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.38",
            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
