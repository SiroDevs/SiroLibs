                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Ee kake ayia! Ilasirak olfarisayo! Amu itiuu intae anaa nkuraren naaelieki enturoto meiborra, nedoli anaa ai sidain ti oriong kake ore atua eiputa loik loo lmeneng'a o loirerioni pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa neijia sii itiuwu intae, edoli intae ti oriong aaijo irara supati kake ore ti atua, nebore esunkureisho o enkarruoisho.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.28",
            "verseOrgIds": [
              "MAT.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
