                "loc": "GEN.4.8"
              },
              "items": [
                {
                  "text": "Enk 4.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.24.20+2CH.24.21"
              },
              "items": [
                {
                  "text": "2 Int 24.20-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " pee etum ainepu intae osarge loo ltung'ana le Nkai oibukori te nkop ebaiki osarge le Abel lemeeta entiyoto, o metabaiki osarge le Sakaria le Barakia litaara intae te rishata ewueji sinyati o olperere lo lasar. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esipa ajoki intae, kepuonu kuna baa pooki shumata kulo tung'ana le na kata.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.36",
            "verseOrgIds": [
              "MAT.23.36"
            ]
          }
        }
      ]
