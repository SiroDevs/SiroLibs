              "items": [
                {
                  "text": "Lk 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naishoi oo lasuriaa o nturbubuani, kaji inkoko pee ilanyilanya enkiguana o lmoti le nkima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        }
