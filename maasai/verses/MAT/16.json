          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naajoki nanu iyie, ira Petero naa te nchumata ena soit ashet enkanisa ai; nemegilu ae kata ltimito le nemeneng'a. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
