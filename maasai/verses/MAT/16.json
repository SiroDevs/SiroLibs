              "items": [
                {
                  "text": "Yhn 12.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore pooki tung'ani ojo aitajeu enkishui enye neiminie, ore pooki oiturraa enkishui enye te nkaraki nanu, neitoki atum. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.25",
            "verseOrgIds": [
              "MAT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kaa dupoto etum oltung'ani te netum enkop pooki, neiturraa enkishui enye? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
          }
        },
        {
