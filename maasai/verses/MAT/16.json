              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neiteru Yesu te ina kata aibalakinye looiteng'eni lenyena inchere meeta kata nemelo Yerusalem meisilisili too mbaa kumok ilpayiani o lapolosak kituaak, o laiteng'enak loo nkitanapat neari metua, neitopiuni te nkolong e uni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.21",
            "verseOrgIds": [
              "MAT.16.21"
            ]
          }
        }
