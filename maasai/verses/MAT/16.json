          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neibelekenyakino Petero ajoki, “Shomo oriong ai shetani, amu aikirror; amu mme imbaa e Nkai idamu kake noo ltung'ana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
