              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitanap ilooiteng'eni lenyena pee meliki oltung'ani nchere ninye Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.20",
            "verseOrgIds": [
              "MAT.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eibalakinye Yesu ilooiteng'eni lenyena enkeeya o empiunoto enye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
