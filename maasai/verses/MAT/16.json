              "items": [
                {
                  "text": "Mat 18.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.23"
              },
              "items": [
                {
                  "text": "Yhn 20.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naa kaaisho iyie ilboleta le nkitoria e shumata ore eniyooki aen te nkop, neaku eidipaki aateen te shumata; ore enilak te nkop eidipaki aatalak te shumata.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        }
