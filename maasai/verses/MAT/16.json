          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee elo Yesu enkalo e Kaisari e Filipi neikilikuan ilooiteng'eni lenyena ajoki, “Kejo iltung'ana ae ng'ae Enkerai e Tung'ani?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.13",
            "verseOrgIds": [
              "MAT.16.13"
            ]
          }
        }
      ]
    },
    {
