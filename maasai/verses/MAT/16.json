              "items": [
                {
                  "text": "Lk 9.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejoki, “Ejo kulikae Yohana Olaibatisani; nejo kulikae Eliya; nejo kulikae Yeremia, anaa obo loo loibonok le Nkai.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.14",
            "verseOrgIds": [
              "MAT.16.14"
            ]
          }
        }
      ]
    },
    {
