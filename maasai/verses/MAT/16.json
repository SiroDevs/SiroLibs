              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Newaliki Simon Petero ajoki, “Ira Iyie Kristo, Enkerai e Nkai naishu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.16",
            "verseOrgIds": [
              "MAT.16.16"
            ]
          }
