          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerik Petero enkilepata nekurraki ajoki, “Mikintapaasha Enkai, Lo Kitok, mikitalama nena.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.22",
            "verseOrgIds": [
              "MAT.16.22"
            ]
