              "items": [
                {
                  "text": "Irm 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu kelotu Enkerai e Tung'ani te nkitoo e Menye te nebo o lmalaika lenyena; nelaaki pooki tung'ani te ina kata aitorisioki inaataasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.27",
            "verseOrgIds": [
              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esipa ajoki intae, etii kulikae ooitashe te ne, lemeinyorrinyor keeya katukul metaba anaa nedol Enkerai e Tung'ani elotu te nkitoria enye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
