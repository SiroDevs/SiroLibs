                  "text": "Lk 13.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Entanang'aki ilo sinka le meeta tipat enaimin e auluo; neaku enkishirata o eonyoto oo lala.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.30",
