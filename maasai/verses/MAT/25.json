      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkiguana nabayie naiguanareki loreren",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
