          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu ilooiteng'eni lenyena, “Esipa ajoki intae nchere egol pee ejing olkarsis enkitoria e keper. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitoki ajoki intae, kelelek te ntames eim enaudoto o ltidu alang olkarsis ejing enkitoria e keper.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        }
      ]
