          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore pooki ng'ae otung'uayie inkajijik, anaa lalashera, anaa nkanashera, anaa menye anaa ng'otonye, anaa nkera, anaa nkurman te nkaraki enkarna ai naa ketum ninche enaalus enkishui nemeish. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
