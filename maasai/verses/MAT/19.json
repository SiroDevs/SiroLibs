          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ilo barnoti ninye, “Aidipa aibung'a nena pooki: ainyoo ae naatong'orikia?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        }
      ]
