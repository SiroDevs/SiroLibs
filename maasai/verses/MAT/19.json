          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nekurraki Yesu nkonyek nejoki ninche, “Meidimayu ina too ltung'ana, kake eidimayu pooki te Nkai.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
