              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaliki Petero te ina kata ajoki, “Ng'ura kitung'aitie iyiook pooki toki, nikisuj iyie, ainyoo naa kenya kitum?”",
          "type": "text",
          "attrs": {
