              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening ilo barnoti ilo rorei, nelo eisinanuo amu eata masaa kumok.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
