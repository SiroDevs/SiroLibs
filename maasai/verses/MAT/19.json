          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu, “Te naa iyieu niaku bayaroti, shomo timira masaa pooki niaata, inchoo ilaisinak, neaku iata olchumati te shumata, nikilotu asuj.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
