              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee ening ilooiteng'eni lenyena neing'asia oleng nejo, “Aing'ae naa oidim atajeu?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
