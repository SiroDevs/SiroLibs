              "2SA.9.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.15+1SA.20.16+1SA.20.17"
              },
              "items": [
                {
                  "text": "1 Sam 20.15-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nejo Daudi, “Keton etii oltung'ani obo otelekua te nkaji e Saul, pee atum nanu aitoduaa ninye esupatisho te nkaraki Yonatan?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netii apa osinka le nkaji e Saul oji Siba, neipotu ninche ninye enetii Daudi; nejoki olaiguanani ninye, “Ira iyie Siba?” Nejo ninye, “Ore osinka lino naa ninye ilo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.4"
              },
              "items": [
                {
                  "text": "2 Sam 4.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nejo olaiguanani, “Aimeton etii likae obo le nkaji e Saul, pee atum nanu aitoduaa ninye esupatisho e Nkai?” Nejoki Siba olaiguanani, “Eton etii olayioni le Yonatan; olmaima ninye tarrushi nkejek enyena.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki olaiguanani ninye, “Koree ninye?” Nejoki Siba olaiguanani, “Etii atua enkaji e Makir olayioni le Amiel te Lo-debar.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaae neirriwaa olaiguanani meyauni ninye aaitung'uaa enkaji e Makir ole Amiel, te Lo-debar. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nelotu Mefiboshet, olayioni le Yonatan ole Saul enetii Daudi, nebatata te nkomom enye neserem. Nejo Daudi, “Mefiboshet!” Newal ninye, “Ng'ura, osinka lino.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Daudi ninye, “Miureisho; amu kaaitodol nanu esupatisho te nkaraki papaai lino Yonatan, naa kaashukoki iyie enkop pooki e Saul papaai lino; nidaa iyie te mesa ai anaake.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neserem ninye, nejo, “Kainyoo ninye osinka lino, metaa ing'or iyie oldia otua anaa nanu?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipotu olaiguanani Siba, ilo sinka le Saul, nejoki ninye, “Ore nena pooki apa naara ine Saul o ne nkaji enye pooki aishoo nanu olayioni lo lkitok lino. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iyie o layiok linono o sinkan linono niturokiki ninye enkurma niyauu atua nena nintayuyu, pee etum olayioni lo lkitok lino endaa nanya; kake ore Mefiboshet olayioni lo lkitok lino nedaa anaake te mesa ai.” Neeta apa Siba ilayiok tomon o imiet o sinkan tikitam. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Siba olaiguanani, “Ore te risioroto e nena pooki, naaitanap olkitok lai olaiguanani osinka lenye, neaku ina eas osinka lino.” Neaku etadee Mefiboshet te mesa e Daudi, anaa obo loo layiok lo laiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeta apa mefiboshet olayioni oti oji enkarna Mika. Ore pooki ootobiko te nkaji e Siba neaku isinkan le Mefiboshet. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku etobiko Mefiboshet te Yerusalem; amu kedaa apa ninye anaake te mesa o laiguanani. Naa olmaima apa too nkejek enyena pokira are.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
