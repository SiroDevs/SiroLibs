              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neishiraki Ahimaas olaiguanani ajo, “Eseriani.” Neirrugo ninye te dukuya olaiguanani nebaiki enkomom enye enkop, nejo, “Meisisi Olaitoriani Enkai ino, laa ninye oishooyie lelo tung'ana ootekepari aarare olkitok lai olaiguanani!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo olaiguanani, “Eisidain mbaa ti alo ilo barnoti Absalom?” Newalu Ahimaas ejo, “Ore pee eirriwaa Yoab osinka lino, nadol enking'oling'ol sapuk, kake mayiolo nanu ajo kainyoo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo olaiguanani, “Mbelekenyau, ntasho tene.” Neaku eitasho ninye te mbata, neitashe aitirring'a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
