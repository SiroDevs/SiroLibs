        },
        {
          "text": "naa kerupi enkarna ino ntarasi, eji, ‘Olaitoriani loo lororani ninye Enkai oo Siraeli,’ ore enkaji o sinka lino Daudi neitubulari te dukuya iyie. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
