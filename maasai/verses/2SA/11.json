              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.20.1"
              },
              "items": [
                {
                  "text": "1 Ilai 20.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore te nkiterunoto o lari, ina kata apa napuoie ilaiguanak olarrabal, neirriwaa Daudi Yoab, o sinkan lenyena te nebo ninye, o Israel pooki, neitalaku ninche elap too ltung'ana le Amoni neman aamuat Raba. Kake etotona Daudi te Yerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.1",
            "verseOrgIds": [
              "2SA.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nabo olong, etigile enkolong, ore pee edumunye Daudi te ndapash enye, neloolo ninye te nchumata oltapeet le nkaji o laiguanani, nedol ninye te nchumata olperere enkitok eitukuo; naa eisidai ina kitok oleng. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.2",
            "verseOrgIds": [
              "2SA.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaa Daudi olkilikuai aikilikuanu ina kitok. Nejo obo, “Aime Betsheba ena, entito e Eliam, enkitok e Uria Olhiti?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.3",
            "verseOrgIds": [
              "2SA.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eirriwayie Daudi ilkiliku, neya ninye; nelotu ninye enetii, neboitare ninye ninye. (Naa keitobira apa ninye kewan te nkiduruk enye.) Neitoki ashuko alo enkaji enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.4",
            "verseOrgIds": [
              "2SA.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenutayu ina kitok; neirriwaa ninye olkilikuai nejoki Daudi, “Atunute.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.5",
            "verseOrgIds": [
              "2SA.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaki Daudi Yoab olomoni, ejo, “Irriwakaki nanu Uria loo Lhiti.” Neirriwaa Yoab Uria enetii Daudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.6",
            "verseOrgIds": [
              "2SA.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee elotu Uria enetii ninye, neikilikuanu Daudi enaasita Yoab o eneikununo iltung'ana, o eneikunari olarrabal. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.7",
            "verseOrgIds": [
              "2SA.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Daudi Uria, “Tadoi shomo enkaji ino, pee intuku nkejek inono.” Neipang Uria alo te nkaji o laiguanani, nesujaa ninye enkishooroto naing'uaa olaiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.8",
            "verseOrgIds": [
              "2SA.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eirure Uria te kutukaji e nkaji o laiguanani te nebo isinkan pooki lo lkitok lenye, neitu elo enkaji enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.9",
            "verseOrgIds": [
              "2SA.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee ejoki ninche Daudi, “Eitu edoyio Uria alo enkaji enye,” nejoki Daudi Uria, “Keitu iyie ilotu aing'uaa enkop naado kainyoo pee eitu idoyio alo enkaji ino?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.10",
            "verseOrgIds": [
              "2SA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Uria Daudi, “Ore osanduku le Nkai, e Israel o Yuda nebikito too lng'oborri; ore olkitok lai Yoab o sinkan lo lkitok lai netii ilng'oborri ti ong'ata naisiaja; kalo naa nanu enkaji ai, adaa naokisho, nairrag te nebo enkitok ai? Anaa eninchu, o anaa enaishu oltau lino, maas nanu ena bae.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.11",
            "verseOrgIds": [
              "2SA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Daudi ajoki Uria, “Totona ake sii taata tene, ore taaisere naaisho iyie shomo.” Neaku etotona Uria te Yerusalem ina olong o pee ekenyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.12",
            "verseOrgIds": [
              "2SA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoomon Daudi ninye, nedaa ninye te dukuya ninye neokisho, neaku eitemera ninye; ore te nteipa neipang ninye alo airrag te ndapash enye te nebo isinkan lo lkitok lenye, kake eitu ninye edoyio alo enkaji enye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.13",
            "verseOrgIds": [
              "2SA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore tadekenya neigeroki Daudi Yoab empalai, neirriwaa te nkaina e Uria. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.14",
            "verseOrgIds": [
              "2SA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ti atua empalai neiger ajo, “Tipika Uria enkomom o larrabal ogol, paa intokiki aaitiakunye aaing'uaa ninye, pee etumi aatar metua. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.15",
            "verseOrgIds": [
              "2SA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore emanita Yoab enkanasa neisho ninye Uria ewueji neyiolo ajo ketii iltung'ana oopi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.16",
            "verseOrgIds": [
              "2SA.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neipang'u iltung'ana le nkanasa aapuonu aarare Yoab, ore embata oo ltung'ana le Daudi ti atua iltung'ana neurori. Ore Uria ilo Hiti nesesekuani sii ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.17",
            "verseOrgIds": [
              "2SA.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaa Yoab olkilikuai aliki Daudi ilomon pooki lo larrabal. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.18",
            "verseOrgIds": [
              "2SA.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitanap ninye ilo kilikuai, ejo, Ore ake pee indip ainosaki ilomon pooki lo larrabal olaiguanani, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.19",
            "verseOrgIds": [
              "2SA.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ake pee eilep, engoro o laiguanani, ore ake pee kijoki iyie, ‘Kainyoo intae pee ishomo aataaniki enkang oleng to larrabal? Keitu intae iyiolouu aajo kengorisho te suntai. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.20",
            "verseOrgIds": [
              "2SA.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.53"
              },
              "items": [
                {
                  "text": "Ilari 9.53",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kaing'ae apa natara Abimelek olayioni le Yerubeshet metua? Aime enkitok natanang'ua osoit oidong'ishoreki aitadoiki te suntai, neaku etua ninye te Tebes. Kainyoo intae pee ishomo oleng aanyikaki esuntai?’ Nijo iyie, ‘Ore sii osinka lino Uria Olhiti etua sii ninye.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.21",
            "verseOrgIds": [
              "2SA.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaae nelo ilo kilikuai, nelotu neliki Daudi nena pooki naairriwua Yoab ninye metoliki. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.22",
            "verseOrgIds": [
              "2SA.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki ilo tung'ani lo lkilikuai Daudi, “Enotokitio iyiook iltung'ana, neipang'u aapuonu aarare iyiook ti ong'ata; kake kiterewa aashukoki enejing'ieki kishomi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.23",
            "verseOrgIds": [
              "2SA.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neng'or iltung'ana loo mbaa isinkan linono te suntai; netuata embata oo sinkan lo laiguanani; ore osinka lino Uria Olhiti netua sii ninye.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.24",
            "verseOrgIds": [
              "2SA.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Daudi ilo kilikuai, “Nji iyie shomo tiaaki Yoab, ‘Mincho iyie ena bae kintanyamal, amu ear olalem obo taata near taata olikae; ntirrisha erasakinoto ino, enkanasa nimbung ninye.’ Nintagol ninye oshoke.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.11.25",
            "verseOrgIds": [
              "2SA.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
