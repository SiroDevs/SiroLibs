                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.2"
              },
              "items": [
                {
                  "text": "Isa 62.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.15"
              },
              "items": [
                {
                  "text": "65.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Oloata enkiok inchoo ening enajoki, Enkiyang'et nena sirito. Ore ilo omirisho naa kaisho ninye eoroti e mana naisudoro, naisho osoit oibor, osirakino enkarna enye ng'ejuk, nemeyiolo likae tung'ani meteleku ilo ake ong'amu.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.17",
            "verseOrgIds": [
              "REV.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olkilikuai oirriwakaki Tiatira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 2:17"
          },
          "items": [
