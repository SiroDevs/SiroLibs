                "loc": "GEN.2.9"
              },
              "items": [
                {
                  "text": "Enk 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Emb 22.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.13"
              },
              "items": [
                {
                  "text": "Esek 28.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.8"
              },
              "items": [
                {
                  "text": "31.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore oloata enkiok inchoo ening enajoki Enkiyang'et nena sirito. Ore ilo omirisho naisho meinosa ilng'anayio te ilo shani le mpuaan natii atua emparadiso e Enkai.’",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
            "verseOrgIds": [
              "REV.2.7"
            ]
          }
        }
      ]
    },
