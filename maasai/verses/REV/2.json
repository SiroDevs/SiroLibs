                  "text": "22.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Naa ore olmalaika le sirit natii atua Smirna tisiraki nchere, ‘Irorei le ilo le Nkiterunoto o le nkiting'oto, otua apa, nenyaaka apiu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.8",
            "verseOrgIds": [
              "REV.2.8"
            ]
          }
        }
