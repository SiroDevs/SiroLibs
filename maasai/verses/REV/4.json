              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.22"
              },
              "items": [
                {
                  "text": "Esek 1.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.5+EZK.1.6+EZK.1.7+EZK.1.8+EZK.1.9+EZK.1.10"
