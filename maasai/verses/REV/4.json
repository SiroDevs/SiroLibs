                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nepukunye ilo orika le nkitoo inkiwuang'at naaimerlel o ndarat o enkikurrukur. Ore te dukuya ilo orika le nkitoo neyupuyup ilkilang'ilang'eta oopishana le nkima, naa ninche inkiyang'eta naapishana e Enkai. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.5",
            "verseOrgIds": [
              "REV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 4:6"
          },
          "items": [
