        "style": "s1"
      },
      "items": [
        {
          "text": "Eseremare te keper",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
