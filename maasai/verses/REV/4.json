              },
              "items": [
                {
                  "text": "Isa 6.2-3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore nena ng'uesi ong'uan naaishu neeta ake nabo inaipuko ile, nebore ninche nkonyek pooki wueji, oriong o atua. Ore dama o kewarie nemegira ae kata meranyisho ejo,",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
