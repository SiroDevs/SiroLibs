          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neosh olmalaika li aare entarumpeta enye. Ore enkito toki naaijo oldoinyo nayupuyup te nkima nenang'akini atua enaiposha. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku ematua e uni e naiposha osarge, neye ematua e uni oo ng'uesi naaishu naatii atua enaiposha, nemuti ematua e uni oo melin.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
