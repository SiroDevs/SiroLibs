              },
              "items": [
                {
                  "text": "Yer 9.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neji enkarna e ilo akira enduaran, neitaduari neye ematua e uni e nkare iltung'ana kumok te ina are, amu eitaduaraki.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
