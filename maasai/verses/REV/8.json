                  "text": "Isa 14.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neosh olmalaika li okuni entarumpeta enye, nedou olakira sapuk oing'uaa shumata eyupuyup anaa olkilang'ilang'et, nedoiki ninye ematua e uni oo lkejek, o enoo nkonyek oo nkariak. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
