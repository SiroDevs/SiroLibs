        },
        {
          "text": " Neosh ilo malaika le dukuya entarumpeta enye, neshau enchan oo soito o enkima, nashulare osarge; nedoiki enkop; nepejori ematua e uni e nkop, nepejori ematua e uni oo lkeek, nepejori nkujit pooki naanyori.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
