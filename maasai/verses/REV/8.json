              "items": [
                {
                  "text": "3.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neosh olmalaika li oong'uan entarumpeta enye, ore ematua e uni e nkolong neari, o ematua e uni o lapa, o ematua e uni oo lakir, neaku eitomisimisoki ematua e uni e wang'an enye. Nemitikini ematua e uni e ndama ewang'u naa neijia etiu ematua e uni enkewarie. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naitoki aing'orisho naning olkurragos oishirita to ltoilo sapuk eipirri te mpolos o loing'ang'e nejo, “Wooi, Wooi, Wooi, ninche lelo oomanya enkop, te nkaraki enkorui e nena tarumpetani netaa keosh ilmalaika okuni.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
