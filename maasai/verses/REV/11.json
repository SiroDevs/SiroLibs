            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.18"
              },
              "items": [
                {
                  "text": "Ena 15.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
