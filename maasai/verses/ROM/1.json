          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ilmoda lemedamisho, ilemeisiligayu, ilooiba ilkulenye, ilemeeta olng'ur. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore hoo neyiolo enatundung'o Enkai ajo ore lelo ooas nena neiririkino keeya, neme ake duoo keas ninche kake kening'okino o lelo ooas.",
          "type": "text",
