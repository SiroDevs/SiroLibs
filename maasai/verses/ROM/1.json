              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ore amu eitu edol ninche aajo keishiaakino neyanyit Enkai, neing'uaa Enkai ninche metaa, keriata indamunot enye netum olkuaak torrono. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iloobore empukunoto ake pooki e nkarruoisho, o entorroni, o ing'uarrat, ilaa ntorrok ake edol, iloobore olom, o ilooitayu loikop enchankar, olosek torrono, esayiet, enkurrare, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "o enkisuro, ilooiba Enkai, ilooilash, iloonya kutukie, ilooipiru ntorrok, iloogolong'aki ntoiwuo, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
