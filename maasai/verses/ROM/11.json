            "sid": "ROM 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore pee miaakuku iloo wuasa te ng'eno inyi, ayieu niyiolouu ena naisudoro, ilalashera laainei, nchere einepua engoloto ae shoto e Israel, o metaba anaa neiputayu esiana oo Loreren oopuonu, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.25",
            "verseOrgIds": [
              "ROM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.20"
              },
              "items": [
                {
                  "text": "Isa 59.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " neaku keitajeuni kenyake Israeli pooki; anaa enatisiraki aajo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.26",
            "verseOrgIds": [
              "ROM.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
