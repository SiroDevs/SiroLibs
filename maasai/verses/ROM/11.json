              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ti alo ororei supat ilmang'ati le Nkai ninche, naa enkaraki intae; kake ore te nkalo e ngelunoto nenyorri te nkaraki lekua loo menye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.28",
            "verseOrgIds": [
              "ROM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu meibelekenyayu nkishorunot aashu engelunoto e Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.29",
            "verseOrgIds": [
              "ROM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore anaa enapa nining'ining'i intae Enkai nitang'amutua olng'ur lenye te nkaraki natagolong'utua ninche, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.30",
            "verseOrgIds": [
              "ROM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "neijia sii taata etiu ore te nkaraki engolong'u enye neing'urrieki intae naa, keyookini aaing'urrie sii ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
              "ROM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu eteenikia Enkai ltung'ana pooki engolong'u pee etum aing'urrie pooki.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.32",
            "verseOrgIds": [
              "ROM.11.32"
            ]
          }
        }
      ]
