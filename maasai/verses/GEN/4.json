            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Tenaa keitalaki elap Kain kat naapishana, nesipa ajo ore Lamek naa katitin ntomoni naapishana kat naapishana.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.24",
