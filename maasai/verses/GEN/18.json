              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Abraham ajo, “Oi mincho Olaitoriani egoro naa kairo. Oo tenaa tomoni oni etumi te ine?” Newal ninye, “Maas nanu ina tenatum tomoni uni te ine.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        },
        {
          "name": "verse",
