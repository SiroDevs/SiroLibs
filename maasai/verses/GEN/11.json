        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nerik Tera Abram olayioni lenye, o Lot olayioni le Haran olayioni lo layioni lenye, o Sarai, enkitok olayioni lenye Abram, nepuku aing'uaa pooki Uri oo Lkaldayo aapuo enkop e Kanaan. Ore peyie ebau Haran, eetuo aitaa ine emanyisho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore inkolong'i e Tera naa ilarin iip are o imiet neye ninye te Haran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
