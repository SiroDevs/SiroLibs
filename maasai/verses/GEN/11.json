            }
          ]
        },
        {
          "text": "Enyaaka Serug abik ilarin iip are eidipaki aatoiu Nahor, neeta apa kulikae ayiok o ntoyie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.23",
