              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyaaka Peleg abik ilarin iip are o naaudo eidipaki aatoiu Reu, neeta apa kulikae ayiok o ntoyie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.19",
