              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iyie nakerai e tung'ani, ing'ura eikipiki iyie inkeenta, naa aikienieki iyie metaa mintoki alo tenebo iltung'ana; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
