              "type": "text"
            }
          ]
        },
        {
          "text": "naa kaiterep olng'ejep lino enoret ino, metaa iaku olemeidim airoro aikoo ninche; amu enkaji kiserut ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
