              "HOS.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.1+GEN.29.2+GEN.29.3+GEN.29.4+GEN.29.5+GEN.29.6+GEN.29.7+GEN.29.8+GEN.29.9+GEN.29.10+GEN.29.11+GEN.29.12+GEN.29.13+GEN.29.14+GEN.29.15+GEN.29.16+GEN.29.17+GEN.29.18+GEN.29.19+GEN.29.20"
              },
              "items": [
                {
                  "text": "Enk 29.1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " (Eisikaka apa Yakobo enkop e Aram, ore teine neisiaisho Israel te nkaraki enkitok, naa ore te nkaraki enkitok neirrita nkerra.) ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.50+EXO.12.51"
              },
              "items": [
                {
                  "text": "Ena 12.50-51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " To loiboni le Nkai eilepunye Olaitoriani Israel aitung'uaa Misiri; naa to loiboni le Nkai eitagolieki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eyaua Efraim embae naitagorisho oleng; neaku ore Olaitoriani lenye, keing'uaa ina kitarrurroto o sarge te shumata ninye, nerrinyoki ninye ina kurruna enye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
            "verseOrgIds": [
              "HOS.12.14"
            ]
          }
        }
      ]
    }
