            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Eiroroki intae sirito e Asia. Ore Akuila o Priska, te nebo esirit natii enkaji enye neirriwaki intae enkirorokino ti atua Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.19",
            "verseOrgIds": [
              "1CO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eiroroki intae ilalashera pooki. Erorokinoto te ng'ututata nasinya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.20",
            "verseOrgIds": [
              "1CO.16.20"
            ]
          }
        }
      ]
    },
    {
