                  "text": "1 Ilkor 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ilalashera laainei, iyiololo intae enkaji e Stefana ninche naaitera aaibelekenyakino Enkai te Akaia netasheikinote aaisiaai isinyat. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.15",
            "verseOrgIds": [
              "1CO.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisisaki intae ajoki entonyorrai erikore oo ltung'ana leeijo lelo, o ene pooki ng'ae oisiaaisho te nebo intae, o sinka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
              "1CO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atishipe naleng etabawua Stefana, o Fortunatu o Akaika, amu erishata inyi nimitii etijing'a ninche ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu aayeng'iyeng'ie embaunoto enye ndamunot naa neijia itiuu sii intae. Entayioloito ake tipat oo ltung'ana laaijo kulo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
    },
    {
