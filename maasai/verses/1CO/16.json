              "items": [
                {
                  "text": "Iat 19.8-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kang'as abik te Efeso o metabau Pentekoste; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.8",
            "verseOrgIds": [
              "1CO.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "aatabolokoki empaash e siaai nadupa, naa kumok ilmang'ati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.17"
              },
              "items": [
                {
                  "text": "1 Ilkor 4.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore te nelotu Timoteo, entodol ake pee meaku ketum ae toki naure etii te nebo intae, amu esiaai o Laitoriani easita anaa nanu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "neaku emincho ake etumi oltung'ani omenaa ninye. Entaretoi meshomo te seriani pee elotu enatii. Amu aanyita nanu neanyita sii lalashera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
