              "items": [
                {
                  "text": "Irm 15.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ore ti alo esotore naishori isinyat enkona sii intae anaa ina naitanapa isirito e Galatia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore te nkolong e nkiterata e wiki ninchosho eitengel pooki tung'ani enkiti toki anaa enatudupe; paa te nalotu nemeitokini aata esotore. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entegelu kulikae linyi, ore pee abau, nairriwaa ninche naisho mpala mewaita ina kishorunoto inyi Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa te neishiakino nalo sii nanu, nikiriamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbaa naajo Paulo pee eas",
          "type": "text"
        }
      ]
    },
    {
