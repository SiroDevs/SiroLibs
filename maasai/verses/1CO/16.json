            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kalotu ina alo atang'asa aimaa Makedonia amu kayieu naimaa Makedonia; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebaiki nang'as aton te nebo aashu abik te nebo intae te nkata e enkijape, paa intae likipuonunu aaitobiraa te nene wuejitin pooki nalo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu mayieu taata neaku kalotu ake aimaa intae, kaisilig ajo kabik te nebo intae te nkata naje, te neishoru Olaitoriani.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
