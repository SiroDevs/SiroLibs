          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkiyang'et e lelo ooata olkilikuai le Nkai ninche ooitore; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.32",
            "verseOrgIds": [
              "1CO.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
