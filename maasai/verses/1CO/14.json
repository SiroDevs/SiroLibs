          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enchoo ng'oruo egira ti atua ntumoritin, amu meishoro meiroro. Ele kerreti esujita sirito pooki oo ltung'ana le Nkai. Enchoo ninche eigara olorere, amu neijia sii ninye ejo Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.34",
            "verseOrgIds": [
              "1CO.14.34"
            ]
          }
        },
