          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "amu ore Enkai, mme Enkai e ng'uyan kake ene seriani anaa enatiu too sirito pooki oo sinyat.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.33",
            "verseOrgIds": [
              "1CO.14.33"
            ]
          }
        }
