    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naboisho ti atua sesen",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore naa nanu olora oloena te nkaraki Olaitoriani, asai intae entobik te nkishon naishiaakino ina kipototo naipotoki intae, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.1",
            "verseOrgIds": [
              "EPH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.12+COL.3.13"
              },
              "items": [
                {
                  "text": "Ilkol 3.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " te nkanyit pooki o te mborron, te nebo eng'iriata iretokinono olikae o likae ti atua enyorrata, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyuaakiki aata naboisho e Nkiyang'et ti atua eenata e seriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.3",
            "verseOrgIds": [
              "EPH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eetae osesen obo o Enkiyang'et nabo anaa ina ake naipotokoki intae ilo siligi obo le ina kipototo inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "obo Olaitoriani, nabo enkirukoto, nabo enkibatisa, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo Enkai naa Papa lang iyiook pooki, laa ninye otii shumata pooki neim atua pooki netii atua pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.6",
            "verseOrgIds": [
              "EPH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eishooki ake oltung'ani pooki te iyiook, empiris te risioroto e enkishorunoto e Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.68.18"
              },
              "items": [
                {
                  "text": "Olke 68.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ina pee etejoki,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.8",
            "verseOrgIds": [
              "EPH.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ore pee eji “eilepa” kaa ae naji neme nchere etadoyie sii apa alo wuejitin e abori enkop? ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.9",
            "verseOrgIds": [
              "EPH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilo ake otadoyie onyaaka sii ailep agiroo shumata pooki, pee etum ninye aiputa pooki toki). ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.10",
            "verseOrgIds": [
              "EPH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore nena kishorunot enyena naa ketejo pee eaku kulikae ilkipaareta, neaku kulikae iloibonok le Nkai, neaku kulikae ilalikiorok, neaku kulikae ilairritak o laiteng'enak, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.11",
            "verseOrgIds": [
              "EPH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "peyie erreteni lelo sinyat, te nkaraki ina siaai e ramatare, ene nchetata o sesen le Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.12",
            "verseOrgIds": [
              "EPH.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "o metabaiki pooki naboisho naimu enkirukoto o eyiolounoto e ilo Inoti le Nkai, nikiaku iltung'ana ootubulutua aamitunye, aabaiki entemet e mbotoro nalulung'a e Kristo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.13",
            "verseOrgIds": [
              "EPH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee mikintoki aaku nkera, naanang'ari idie o idie to lkutati ake pooki le nkiteng'enare, o losek loo ltung'ana ti atua esunkureisho o losekin le lejare. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.14",
            "verseOrgIds": [
              "EPH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enatii, emairoro esipata ti atua enyorrata, nikibulu too nkoitoi pooki aabulaki atua ilo ora elukunya ang; aabulaki atua Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.15",
            "verseOrgIds": [
              "EPH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.19"
              },
              "items": [
                {
                  "text": "Ilkol 2.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " olaa ti atua ninye eruba osesen pooki, neidikidikokino atua ninye pooki rubata naishoro, easisho nena rubat pooki aaitobiraki, neitubulu osesen neitubulu kewan ti atua enyorrata.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkishui ng'ejuk ti atua Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.16",
            "verseOrgIds": [
              "EPH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Najo taata ena naishakenoki ti atua Olaitoriani nchere emintoki ake aaisho orrekie le nkishon inyi etiu anaa enatiu oloo loreren, too ndamunot enye e pesho; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.17",
            "verseOrgIds": [
              "EPH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "eitomisimisoki ening'unoto enye; neaku ina kishui naishoru Enkai eneeiking'a te ninche, te nkaraki nemeyiolo toki; te nkaraki engolon oo ltauja lenye; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.18",
            "verseOrgIds": [
              "EPH.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "eikaolote ninche neishooitie ate aaisho iloirerioni, netum enkului e pooki bae naiduruk. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neme nena eiteng'enieki intae ti atua Kristo! ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.20",
            "verseOrgIds": [
              "EPH.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ajo sii indipa aatoning imbaa enyena naaiteng'enieki intae ti atua ninye, anaa enatiu esipata tiatua Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EPH 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.9"
              },
              "items": [
                {
                  "text": "Ilkol 3.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Entuburukushu enkewan inyi musana, e napa kishon inyi musana narruoyo enkaraki ng'uarrat naalejisho, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
            "verseOrgIds": [
              "EPH.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "naa enchoo eitang'ejuki indamunot inyi, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.23",
            "verseOrgIds": [
              "EPH.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Enk 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.10"
              },
              "items": [
                {
                  "text": "Ilkol 3.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " enchopo enkewan ng'ejuk, naitayioki enyaanyukie Enkai ti atua esupatisho nasipa o te sinyatisho.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.24",
            "verseOrgIds": [
              "EPH.4.24"
            ]
          }
        }
      ]
    },
