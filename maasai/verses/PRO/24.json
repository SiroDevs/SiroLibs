          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PRO 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enkerai ai turia Olaitoriani o laiguanani, nimigolong'aki hoo obo lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.21",
            "verseOrgIds": [
              "PRO.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kedumunye emutata te ninche asieku, naa aing'ae oyiolo emutata nalotu eing'uaa pokira?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulie kirorot eng'eno",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PRO 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.22",
            "verseOrgIds": [
              "PRO.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PRO 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore sii kuna naa nkirorot o lang'eni: ore olkep te nkiguana nemesidai. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.23",
            "verseOrgIds": [
              "PRO.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo ojoki oltung'ani torrono inchere, “Miata iyie entioto,” naa kedek iloreren ninye, neibayu iloshon ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.24",
            "verseOrgIds": [
              "PRO.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ore ilo oisikong oltorrono naa ketum enchipai, naa kelotu emayianata sidai shumata ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.25",
            "verseOrgIds": [
              "PRO.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo oishoru ewalata nasipa, neng'utut inkonito enkutuk. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.26",
            "verseOrgIds": [
              "PRO.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intobira esiaai ino tiauluo niyau pooki toki niyieu enkurma ore pee indip ina nitum taa aitesheta enkaji. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.27",
            "verseOrgIds": [
              "PRO.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miaku olchakeni oarare olelatia ino miata eniporoki, nimilejisho te nkutuk ino. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.28",
            "verseOrgIds": [
              "PRO.24.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PRO 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mijo taa ake, “Ekaitaas ninye ina naaitaasa nanu, Ekalaaki ilo tung'ani ina naaitaasa.” ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.29",
            "verseOrgIds": [
              "PRO.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashomo nanu agiroo olokeri lo ltashalai, embata enkurma oo sabibu oltung'ani lemeeta endamunoto. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.30",
            "verseOrgIds": [
              "PRO.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa ng'ura, etubulakita ninye ilkiku; ore enkop nebore entamejoi; ore esuntai enye o soit neturori. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.31",
            "verseOrgIds": [
              "PRO.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "PRO 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ina pee aing'or natemaa ayiolou; aing'ura nang'amu enkiteng'enare. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.32",
            "verseOrgIds": [
              "PRO.24.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "PRO 24:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.10+PRO.6.11"
              },
              "items": [
                {
                  "text": "Ndung 6.10-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kang'as airura penyo, kang'as aimug penyo. Kang'as anunuk inkaik penyo ayeng'iyeng'a. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.33",
            "verseOrgIds": [
              "PRO.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "PRO 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikijing'aki osina iyie o esumash anaa olaisimani, nikijing'aki osina anaa oltung'ani otanape.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.34",
            "verseOrgIds": [
              "PRO.24.34"
            ]
          }
        }
      ]
    }
  ],
