          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ming'uar lelo tung'ana torrok, niming'uar aitaa ninche encholiek. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.1",
            "verseOrgIds": [
              "PRO.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore indamunot enye neipiru olarrabal neiro too nkutukie enye imbaa enkarruoisho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "-20-",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.2",
            "verseOrgIds": [
              "PRO.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ng'eno eshetuni enkaji naa te ning'unoto eitasheyieki. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.3",
            "verseOrgIds": [
              "PRO.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te ng'eno eiputi ilgilat pooki, too ntokitin pooki sidain naagol enkinyang'a",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "-21-",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.4",
            "verseOrgIds": [
              "PRO.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltung'ani ng'en naa kegol alang oltung'ani ogol, naa neijia etiu ilo oota eng'eno elang ilo oota eng'olon. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.5",
            "verseOrgIds": [
              "PRO.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu te rikoto e ng'eno indim aipiru enjore, naa tiatua enkumoi oo lautarok etumi enkishuroto.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "-22-",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.6",
            "verseOrgIds": [
              "PRO.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eng'eno nagut naa kelakuaniki oleng olmodai, mebol ninye enkutuk enye te kishomi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.24.7",
            "verseOrgIds": [
              "PRO.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
