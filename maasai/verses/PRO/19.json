              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etii nkitobirat kumok endukuya e tung'ani, kake ina nayieu Olaitoriani ninye ake naitashe aaku.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.21",
