      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.17",
            "verseOrgIds": [
              "PRO.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intamio tuutai enkerai ino eton eetae osiligi; mincho oltau lino ejing errorroto enye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.19.18",
            "verseOrgIds": [
              "PRO.19.18"
            ]
          }
        }
      ]
    },
    {
