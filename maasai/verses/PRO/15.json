              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enemeneng'a o Abadon neibala te dukuya Olaitoriani, kebaa eibala oleng iltauja loo ltung'ana! Abadon: Etii ewueji oo rorei lemeibala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
