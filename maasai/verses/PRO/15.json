            "number": "4",
            "style": "v",
            "sid": "PRO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore irorei le mborron naa olchani le nkishui, kake ore irorei le ntorroni negil oltau.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
