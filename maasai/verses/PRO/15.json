              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oltau leilo oota endamunoto e ning'unoto neing'oru eng'eno, kake ore inkutukie oo lmoda neitoti ate too nemodai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
