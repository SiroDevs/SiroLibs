          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olasar leilo torrono naa olminong to Laitoriani, kake ore enkomono eilo oitashe too sipat naa enchipai enye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
