        },
        {
          "text": "Ore enkoitoi eilo torrono naa olminong to Laitoriani, kake enyor ninye ilo osuj aing'oru esupatisho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
