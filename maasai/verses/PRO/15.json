          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ewalata e mborron nerriny engoro napi, kake ore ororei le nkisikong' neinyeyie engoro.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
