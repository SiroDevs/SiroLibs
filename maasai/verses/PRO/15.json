            "number": "2",
            "style": "v",
            "sid": "PRO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olng'ejep lo lng'en neitubulaa eng'eno, kake ore inkutukie oo lmoda nebuku ine modai.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
