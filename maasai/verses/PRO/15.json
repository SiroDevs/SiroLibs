              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkutuk oltung'ani ng'en neitubulaa eng'eno, nemeneija etiu indamunot oo lmoda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
