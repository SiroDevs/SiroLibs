              },
              "items": [
                {
                  "text": "Fil 24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Eiroroki intae esirit natii atua Babilion nageluno sii ninye anaa intae, neijia etiu enkerai ai Marko. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erorokinoto intae maate te ng'ututata e nyorrata, Metijing'a osotua intae pooki ootii atua Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
            "verseOrgIds": [
              "1PE.5.14"
            ]
          }
        }
