    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ntare e Nkai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku airorie ilpayiani ootii atua intae, ara sii nanu olpayian anaa ninche nara shakeni loo nkisilisilot e Kristo Nang'arie enkitoo napuoi aabolu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.1",
            "verseOrgIds": [
              "1PE.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.15+JHN.21.16+JHN.21.17"
              },
              "items": [
                {
                  "text": "Yhn 21.15-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Taramata ntare e Enkai niking'orieki, neme te arakinoto kake te nyorrata ino, neme te dupoto e nkurruna kake te yieunoto ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "neme anaa ilaitoriak ooimagarraki lelo ooishooki intae entaramat, kake aaku enkitanyaanyukoto naduaaya intare. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
            "verseOrgIds": [
              "1PE.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pee te neboluni ilo Shekut kitok, neishori intae enkopiyia e nkitoo e nkisisa nemeibil emua.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.4",
            "verseOrgIds": [
              "1PE.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
