                "loc": "ACT.15.40"
              },
              "items": [
                {
                  "text": "40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Te Silvano, olalashe laaijo nanu eisiligayu, atisiraka intae ena kiti palai, pee aruj intae naishakenoki intae inchere empiris e Enkai ena nasipa. Entasho emiwuatiwuata ti atua Ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
