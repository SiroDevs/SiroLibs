            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.9"
              },
              "items": [
                {
                  "text": "Ilaw 18.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Enkig 27.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Teneyam oltung'ani enkanashe enye, ina nang'arie menye, aashu enkanashe nangarie kina, nelo ninye aboitare nedol olee emasipaisho enye nedol entito emasipaisho olee naa embae e sulare ina, naa keiwuang'ieki ninche te dukuya nkera olorere lenye; etaboluo ninye nkilani enkanashe enye, naa kenap ninye entorroni enye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Ilaw 18.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Teneboitare olee enkitok eata emuoyian enye, nebolu nkilani enyena, netusula ninye erukunoto enye, neitalioo ninye erukunoto osarge lenye; ore ninche pokira are naa keiwuang'ieki tiatua iltung'ana lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
