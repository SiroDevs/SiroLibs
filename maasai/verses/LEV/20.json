    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkitalaata te nkaraki engolon e nkong'u",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Olaitoriani Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiaaki iltung'ana le Israel ore pooki tung'ani loo ltung'ana le Israel aashu o le lelo omon ooidurrakita aamany atua Israel, oishooyo nabo oo nkera enyena aaisho Molek neari metua; ore iltung'ana lena kop near ninye too soito. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.2",
            "verseOrgIds": [
              "LEV.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu kewan oibelekenyakino aipirakinore ilo tung'ani naiwuang'ie nanu ninye tiatua iltung'ana lenyena, enkaraki naishooyie nabo oo nkera enyena aisho Molek, nepik enkaji ai entioto neisarkionie enkarna ai sinyati. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa teneisudoo iltung'ana leina kop ilo tung'ani ina kata eishooyo nabo oo nkera enyena aisho Molek, neany ear ninye metua, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "naibelekenyakino nanu aarare ilo tung'ani naarare olmarei lenye, naitayu nanu ninche aiwuang'ie tiatua iltung'ana lenye, ninye o lelo pooki oosujita ninye te nkiborra oo nkonyek e sujata e Molek.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teneibelekenyakino oltung'ani ltung'ana oirorie iloiriruani o lasakutok, aiborrie onyek te ninche, naibelekenyakino nanu ilo tung'ani aarare naitayu nanu ninye aiwuang'ie tiatua iltung'ana lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.6",
            "verseOrgIds": [
              "LEV.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entisinya naa ate niakuku sinyat, amu ara nanu Olaitoriani Enkai inyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embung'a nkiguanat aainei, niasiasa ninche, Ara nanu Olaitoriani oitisiny intae. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.17"
              },
              "items": [
                {
                  "text": "Ena 21.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.4"
              },
              "items": [
                {
                  "text": "Mat 15.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.10"
              },
              "items": [
                {
                  "text": "Mk 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu ore pooki ng'ae odek menye aashu ng'otonye neari metua; etedia ninye menye aashu ng'otonye, neaku ore osarge lenye shumata ninye etii.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
