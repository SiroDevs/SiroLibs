            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.1+LEV.3.2+LEV.3.3+LEV.3.4+LEV.3.5+LEV.3.6+LEV.3.7+LEV.3.8+LEV.3.9+LEV.3.10+LEV.3.11"
              },
              "items": [
                {
                  "text": "Ilaw 3.1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nepolos sii olkiteng o lmeregesh, ilo asar le seriani te nkaraki iltung'ana neyaki ilayiok le Aron ninye osarge neisuaaki enchumata olperere lo lasar aitaman, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.18",
            "verseOrgIds": [
              "LEV.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore enkurriny eilo kiteng o eno lmeregesh, o eilata o lkidong'oe leilo meregesh, oina kurriny naimulumul isorri enkoshoke, o lairakuj, o lkina le moinyua; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.19",
            "verseOrgIds": [
              "LEV.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "neiteleiki ninche ina kurriny enchumata oo luikuluaa, nepejoo ninye ina kurriny te nchumata olperere lo lasar, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.20",
            "verseOrgIds": [
              "LEV.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ore lelo oikuluaa o emuro e tatene eyuko Aron anaa olasar oyuki te dukuya Olaitoriani; anaa enaitanapishe Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        }
      ]
    },
