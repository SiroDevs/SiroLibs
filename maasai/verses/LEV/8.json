          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Musa aya embata eina ilata naputishoreki o embata eilo sarge otii enchumata olperere lo lasar, neisuaaki Aron o lkilani lenyena, o layiok lenyena sii o lkilani loo layiok lenyena, neaku eitisinya ninye Aron o lkilani lenyena, o layiok lenyena o lkilani loo layiok lenyena, tenebo ninye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.8.30",
            "verseOrgIds": [
              "LEV.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
