          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena ninye enkitanapata o lasar opejori, olasar le ntapa, olasar le ng'oki, o lasar le nkitarruorroto, o le nkitisinyata o lasarri le seriani, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
