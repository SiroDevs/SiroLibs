              },
              "items": [
                {
                  "text": "Enkig 12.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Niminosinoso sii osarge tukul, aa olemotonyi aashu aa oleng'ues, te pooki wueji nimanyimanya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore oloba anaa oloinos pooki sarge, neiwuang'ieki ilo tung'ani too ltung'ana lenyena.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
            "verseOrgIds": [
              "LEV.7.27"
            ]
          }
        }
      ]
    },
