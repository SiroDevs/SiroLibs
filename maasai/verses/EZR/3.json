    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebuaku iltung'ana pooki te mbuakunoto sapuk, ina kata eisis Olaitoriani enkaraki naiteruaki olkitamanyunoto le nkaji o Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ilapolosak kumok o Lawi o lukuny oo nkajijik oo loo menye, ilpayiani kituaak apa ootoduaa enkaji e dukuya neyietu aaishir ina kata pee edol olkitamanyunoto lena aji eshetuni, hoo netabuakutua ilkumok te nchipai; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "neaku meidim iltung'ana aaitirisha oltoilo le mbuakunoto e nchipai o ltoilo lo lkiyio loo ltung'ana; amu etabuakutua apa lelo tung'ana te mbuakunoto sapuk oleng, nening'ori ina buakunoto te nelakua.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
