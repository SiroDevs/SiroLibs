                }
              ]
            }
          ]
        },
        {
          "text": " nerany ninche eirukokino, eisis neisho enashe Olaitoriani, ejo,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
