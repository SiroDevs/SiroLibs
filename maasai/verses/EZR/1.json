              },
              "items": [
                {
                  "text": "29.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore to lari le dukuya le nkitoria e Sairos olaiguanani le Parsia, pee etumi aaitabai ororei lo Laitoriani te nkutuk e Yeremia, neputu Olaitoriani oltau le Sairos olaiguanani le Parsia, pee eibalunye enkitanapata te nkitoria enye pooki, neiger sii aajo,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
