              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neliki Musa Aron irorei pooki lo Laitoriani laa ninche eirriunye ninye, o nkitoduaat pooki naaitanapa ninye metaasa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.28",
            "verseOrgIds": [
              "EXO.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
