              "text": "entua",
              "type": "text"
            },
            {
              "text": "enkitok nanuta",
              "type": "text"
            }
          ]
        },
        {
          "text": " olbae o metapololoyu, nemetii ae torroni natusuja, ore ilo otipika ninye olbae neitalaki te risioroto e nkitalakunoto naitalak ninye olpayian le ina kitok; nelak anaa enanyorraa iladung'ok le nkiguana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
