              "type": "text"
            }
          ]
        },
        {
          "text": "“Te neing'uaa oltung'ani engumoto menuka arashu te netur oltung'ani engumoto nemenuk, nedoiki olkiteng arashu osikiria atua, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
