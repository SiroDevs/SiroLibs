              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Te near olkiteng orrindik metua, olee arashu enkitok, neisho olopeny olkitok le ilo rrindiki shekeli tomoni uni e nkosholai. Neari ilo kiteng too soito metua.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.32",
            "verseOrgIds": [
              "EXO.21.32"
