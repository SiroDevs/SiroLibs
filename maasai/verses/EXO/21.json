          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitobir olopeny ina gumoto neisho impisai olopeny o lkiteng o sikiria neaku ina natua enenye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
