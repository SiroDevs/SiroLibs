              "attrs": {
                "loc": "JOS.20.1+JOS.20.2+JOS.20.3+JOS.20.4+JOS.20.5+JOS.20.6+JOS.20.7+JOS.20.8+JOS.20.9"
              },
              "items": [
                {
                  "text": "Yosh 20.1-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kake te neitu eirrag arreshu ninye, kake Enkai ake natorikoyie metabatatakinoyu inkaik enyena, naa kegelaki intae ewueji naa ninye eisikaki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake te neotiki oltung'ani aitirraki olikae pee ear metua, ewaita intae ninye aaitung'uaa olperere lai pee eye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
    },
