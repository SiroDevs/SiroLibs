          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Te neishankarra iltung'ana neosh obo olikae to soit arashu te nkaina neitu eye oltung'ani eirraga te rruat, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore pee edumunye ilo nelo te ntirma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21.19",
              "type": "text"
            },
            {
              "text": "ntirma",
              "type": "text"
            },
            {
              "text": "enchata naibung oltung'ani airishakino elo",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ore ilo otoosho ninye nelakuni; kake elak ina kata naiturrayie neing'or ninye o meishiu alaari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
