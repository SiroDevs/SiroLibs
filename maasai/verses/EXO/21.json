              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Te neosh oltung'ani enkong'u o rrindik lenye, olee arashu enkitok, neitarruoo, neisho ninye ilo rrindik meshomo te nkaraki enkong'u. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te neitayu olalae lo rrindik lenye, olee arashu enkitok, nelo ilo rrindik te nkaraki olalae.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
