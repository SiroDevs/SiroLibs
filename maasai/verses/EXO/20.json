            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mimpot aasishore enkarna o Laitoriani Enkai ino pesho amu meikenaa Olaitoriani ajo meeta enkitarruoroto ilo oipot enkarna enye pesho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.7",
