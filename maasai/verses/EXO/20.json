                  "text": "Ilaw 23.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Too nkolong'i ile taasisho, nias isiaaitin inono pooki; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.9",
            "verseOrgIds": [
              "EXO.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake ore te nkolong e naapishana naa sabato to Laitoriani Enkai ino; ore te ina olong nimiaas hoo ae siaai, iyie arashu olayioni lino, arashu entito ino, o sinka lino lee, arashu esinka ino, arashu inkishu inono, arashu olomoni otii atua enkang ino. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.10",
            "verseOrgIds": [
              "EXO.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.1+GEN.2.2+GEN.2.3"
