              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "27.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mintobiraki kewan enkitanyaanyukoto nagueta, arashu ae nanyaanyukie ae toki te shumata te keper arashu enatii abori enkop, arashu enatii atua tiabori enkop. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.4",
            "verseOrgIds": [
              "EXO.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6+EXO.34.7"
              },
              "items": [
                {
                  "text": "Ena 34.6-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.18"
              },
              "items": [
                {
                  "text": "Enki 14.18",
