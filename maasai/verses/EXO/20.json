              },
              "items": [
                {
                  "text": "Ena 31.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu too nkolong'i ile eitobira Olaitoriani shumata o enkop, o enaiposha, o nena pooki naatii atua ninche, neyeng'iyeng'a te nkolong e naapishana. Metaa etamayiana Olaitoriani enkolong e naapishana neitaa sinyati.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
          }
        }
