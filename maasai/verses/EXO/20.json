                  "text": "13.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ming'uar enkaji e ilo le latia ino; ming'uar enkitok e ilo le latia ino, arashu osinka lenye, arashu esinka enye, arashu olkiteng lenye, arashu osikiria lenye, arashu hoo ae toki ole latia ino.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.17",
            "verseOrgIds": [
              "EXO.20.17"
            ]
          }
        }
      ]
    },
    {
