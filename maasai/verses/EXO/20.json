                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.9+DEU.7.10"
              },
              "items": [
                {
                  "text": "Enkig 7.9-10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mirrugokino ninche arashu isiaai ninche; amu ore nanu Olaitoriani Enkai ino ara Enkai olom, naitusuj nkera nkitarruorrot oo loo menye o metabaiki eishoi e uni o eni ong'uan e lelo laaiba nanu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kake kaitodolu enyorrata nauno too nkalifuni e lelo laanyor nanu neibung nkitanapat aainei.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
