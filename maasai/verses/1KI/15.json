          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neeta apa Asa olarrabal, o Baasha ilo aiguanani loo Siraeli too nkolong'i enye pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
            "verseOrgIds": [
              "1KI.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore to lari liokuni le nkitoria e Asa olaiguanani le Yuda, neiteru Baasha olayioni le Ahija aitore Israel pooki te Tisra, neitoreisho ilarin tikitam oong'uan. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
            "verseOrgIds": [
              "1KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neas ninye intorrok too nkonyek Olaitoriani, neibung orrekie le Yeroboam teina ng'oki natorikoko Israeli metaasa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        }
      ]
