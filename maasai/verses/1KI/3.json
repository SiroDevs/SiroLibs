  "copyright": "PUBLIC DOMAIN",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1KI 3"
      },
      "items": [
