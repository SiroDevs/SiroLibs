          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
