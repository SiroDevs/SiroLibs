                "loc": "COL.1.7"
              },
              "items": [
                {
                  "text": "Ilkol 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "4.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kirriwaki enkirorokino Epafras, ilo o ena te nebo nanu te nkaraki Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHM.1.23",
            "verseOrgIds": [
              "PHM.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
