          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eton eirorita ilo, nejing'u likae nejo, “Eitayutuo Ilkaldayo iltimito okuni, nepuonu aarare iyiook aaikonyaa intamesin nereu, near isinkan te nepi olalem; metaa nanu ake oisikua peyie aalotu aliki.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        }
      ]
    },
