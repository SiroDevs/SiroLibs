          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore eton eiro eitu eishu, nelotu likae nejo, “Etadowuo enkima Enkai te shumata nepejoo intare te nebo isinkan, neidakie ninche; neaku nanu ake oisikua peyie aalotu aliki.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
      ]
