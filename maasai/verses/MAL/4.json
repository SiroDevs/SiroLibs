                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ng'ura, kairriwaki nanu intae Eliya oloiboni le Nkai eton eitu elotu ina olong torrono o Laitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
            "verseOrgIds": [
              "MAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa keibelekenyaki ninye iltauja loo menye inkera enye, neibelekenyaki sii iltauja loo nkera iloo menye, malotu ake aosh enkop to ldeket.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.6",
            "verseOrgIds": [
              "MAL.4.6"
            ]
          }
        }
