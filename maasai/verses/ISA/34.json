              "type": "text"
            }
          ]
        },
        {
          "text": "ore too ishoritin naa kepuo ninche aamany ina kop.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.17",
            "verseOrgIds": [
              "ISA.34.17"
            ]
          }
        }
      ]
