              "items": [
                {
                  "text": "1 Tim 5.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mien olkiteng enkutuk eidong'ito entapa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.4",
            "verseOrgIds": [
              "DEU.25.4"
            ]
