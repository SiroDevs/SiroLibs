                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.28"
              },
              "items": [
                {
                  "text": "Lk 20.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tenetoni ilalashera tenebo, neye obo lenye meeta olayioni, ore ina kitok eilo otua, meyami teboo ilo marei oltung'ani leeiking'a; ore olalashe olmoruo lenye nchoo elo ayiolou, neya ninye aitaa enkitok enye, neitaas ninye enaishiakino neitaas enkitok olalashe lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore olayioni ong'as aiu neya enkarna eilo alashe lenye otua, pee meiwuang'ieki enkarna enye tiatua Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7+RUT.4.8"
              },
              "items": [
                {
                  "text": "Ru 4.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naa tenemeyieu ilo lee neyam enkitok o lalashe lenye, nelo ina kitok o lalashe lenye auluo enetii ilpayiani, nejoki, ‘Etanya olalashe lo lmoruo lai eun enkarna o lalashe lenye te Israel; meas ninye esiaai o lalashe lenye te nanu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo payiani leina anasa enye, neipotu ninye, neirorie ninye: naa teneuno, ejo, ‘Mayieu nanu naya ninye’, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelo naa ina kitok o lalashe lenye enetii ninye teine netii lelo payiani, neitayu enamuke enye te nkeju enye, nenotaki enkomom enye; newaliki ajoki, ‘Ena emookini aaitaas olee le meshet enkaji o lalashe lenye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore enkarna enkaji enye kemookini aajo te Israel, enkaji e ilo oitayioki enamuke te nkeju enye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
