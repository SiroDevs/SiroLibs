            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Teneishankarra iltung'ana, nepuonu kotini, nedung ilarishak enkiguana te ninche, nepali ilo asipani neiguanareki ilo arruoni, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "tenelo neaku eoshoto naishiakino ilo tung'ani, neisho oladung'oni le nkiguana ilo tung'ani meirraga te nkop neari te dukuya ninye ioshot naairirikino enkitarruoroto enye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Ilkor 11.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Amu eidimi aishoo ninye ioshot artam kake meitulusi; amu tenelo likae tung'ani aponiki ninye ioshot naalang kuna, netemenayioki naa ilo alashe lino too nkonyek inono.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
