      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enaitaasi olalashe otua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
