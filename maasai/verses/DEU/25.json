            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.35+LEV.19.36"
              },
              "items": [
                {
                  "text": "Ilaw 19.35-36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mipik olbene lino mpukunot are oo soito ootemieki enkiroishi, o sapuk o enkiti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mipik enkaji ino mpukunot are e ntemeta enalala o enkiti. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Entemet nabore nesipa ninye taasishore naa entemet nalulung'a ninye taasishore; pee etum nkolong'i inono aatoponari teina kop nikincho Olaitoriani Enkai ino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore lelo pooki oas mbaa naijo kuna, lelo pooki oasisho te lejare naa entoki olminong to Laitoriani Enkai ino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.16",
            "verseOrgIds": [
              "DEU.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enkitanapata naarieki ile Amaleki metuata",
          "type": "text"
        }
      ]
    },
