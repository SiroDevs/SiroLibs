          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitoki Musa airorie ilo orere ina olong ake, ejo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.11",
            "verseOrgIds": [
              "DEU.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.29"
              },
              "items": [
                {
                  "text": "Enkig 11.29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yosh 8.33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Tenindipidipi aatalang olkeju le Yordan nchoo kulo eitashe to ldoinyo le Gerisim, pee emayian olorere. Simion, o Lawi, o Yuda, o Isaakar, o Yosef, o Benchamen. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.12",
            "verseOrgIds": [
              "DEU.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa nchoo kulo eitashe te nchumata oldoinyo le Ebal teina siai: Ruben, o Gad, o Asheri, o Sebulon, o Dan, o Naftali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.13",
            "verseOrgIds": [
              "DEU.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neibalunye Ilawi too ltung'ana pooki le Israel to ltoilo sapuk aajo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.14",
            "verseOrgIds": [
              "DEU.27.14"
            ]
          }
        }
      ]
    },
