          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.24",
            "verseOrgIds": [
              "NUM.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Balaam adumunye nelo ewueji enye; nelo sii Balak te nkoitoi enye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.25",
            "verseOrgIds": [
              "NUM.24.25"
            ]
          }
        }
      ]
    }
