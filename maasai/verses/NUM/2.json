          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ore te nkalo e moikuape naa enkereri oo lng'oborri le Dan too lturrurri lenye, ore olarikoni loo ltung'ana le Dan naa Ahi-eser olayioni le Amishadai, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.25",
            "verseOrgIds": [
              "NUM.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
