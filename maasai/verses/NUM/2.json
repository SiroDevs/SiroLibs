          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki asuju olosho le Naftali, ore olarikoni loo ltung'ana le Naftali naa Ahira olayioni le Enan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.29",
            "verseOrgIds": [
              "NUM.2.29"
            ]
          }
        },
