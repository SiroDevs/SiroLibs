        "style": "s1"
      },
      "items": [
        {
          "text": "Entonata oo loshon too lng'oborri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
