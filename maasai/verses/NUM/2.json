          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo oosujaki ninche too lng'oborri naa olosho le Asheri, ore olarikoni loo ltung'ana le Asheri naa Pagiel olayioni le Okran, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
