          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Neitokini aaitusuj olng'obor le ntumo, nepiki ilo ng'obor loo Lawi empolos oo lng'oborri; ore anaa enamanyisho ninche nchoo eiko neijia, aapik ake olng'obor erishata enye, enanka ake o enanka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.17",
            "verseOrgIds": [
              "NUM.2.17"
            ]
          }
        }
      ]
