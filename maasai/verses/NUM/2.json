          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore esiana o lorora lenye anaa enaikenaki naa nkalifuni ntomoni ile o are o iip naapishana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        },
        {
