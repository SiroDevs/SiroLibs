          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ilo pisiai leina rubata e le lelo apa ooshomo enjore, ore esiana enye naa nkerra nkalifuni iip uni o tomoni uni o opishana o iip imiet, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
