              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ltung'ana nkalifuni tomon o ile. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.46",
            "verseOrgIds": [
              "NUM.31.46"
            ]
          }
        },
        {
          "name": "verse",
