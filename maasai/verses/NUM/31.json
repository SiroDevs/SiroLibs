              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "o sirkon nkalifuni tomoni uni o iip imiet, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.45",
            "verseOrgIds": [
              "NUM.31.45"
            ]
          }
