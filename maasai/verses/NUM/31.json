          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore apa olpisiai le nena teina umata naa nkerra nkalifuni iip uni o tomoni uni o opishana o iip imiet, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
