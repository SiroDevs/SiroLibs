          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore inaaing'uaa ilo pisiai loo ltung'ana le Israel neya Musa nabo te pooki onom, aa too ltung'ana o too nchoo, neisho ninche lelo le Lawi ooing'or olng'obor lo Laitoriani; anaa enaitanapa Olaitoriani Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.47",
            "verseOrgIds": [
              "NUM.31.47"
            ]
          }
        }
      ]
