          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ltung'ana nkalifuni tomoni uni o are, o nkituaak neitu ai kata eboitare olee. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
