              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki ninche aadumunye te Esion-geber nepuo aaun ilng'oborri tiong'ata e Sin (aa taa Kadesh ina). ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.36",
            "verseOrgIds": [
