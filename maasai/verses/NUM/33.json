              ]
            }
          ]
        },
        {
          "text": " Ore Aron ilo apolosani neilep alo enchumata o ldoinyo le Hor anaa enaitanapa Olaitoriani, nelo aye te ine, to lari li artam eidipa iltung'ana le Israel aatupuku te nkop e Misiri, te nkolong e dukuya o lapa le imiet. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.38",
            "verseOrgIds": [
              "NUM.33.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
