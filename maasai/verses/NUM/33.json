          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Olaitoriani Musa te nena kisiajat e Moab te mbata e Yordan eipirare Yeriko, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.50",
            "verseOrgIds": [
              "NUM.33.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 33:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tiaki iltung'ana le Israel, Ti nilang'ilang'a Yordan aapuo enkop e Kanaan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.51",
            "verseOrgIds": [
              "NUM.33.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "NUM 33:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipuopuo naa aaraa lelo pooki oomanya ina kop aaiwuang'ie te dukuya intae nindaikiekie nena kitanyaanyukot enye oo soito, nindaikiekie nena kitanyaanyukot enye naaipurjuno, nigiligili nene wuejitin neeika naaitainyeki lasarri pooki; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.52",
            "verseOrgIds": [
              "NUM.33.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "NUM 33:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyaya ina kop aaitaa eninyi nimanyimanya, amu aishoo nanu intae ina kop pee iyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.53",
            "verseOrgIds": [
              "NUM.33.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.54+NUM.26.55+NUM.26.56"
              },
              "items": [
                {
                  "text": "Enki 26.54-56",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ijung'ujung'u intae ina kop te oshoto e nkukuo te risioroto oo lmareita linyi; ore olosho kitok neishori enjung'ore kitok, ore olosho oti neishori enjung'ore kiti; anaa ake enadoiki enkukuo oltung'ani, neaku ina enenye; nijung'ujung'u te risioroto oo loshon loo loo papaai linyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake ti nimiaraa lelo oomaaya ina kop aaiwang'ie te dukuya intae ore lelo lilekuku netiu anaa iltidii too nkonyek inyi o lkiku too matuan inyi, naa kepuo ninche aaitanyamal intae te ina kop nipuopuo aamany. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naa kalo nanu aitaas intae ina duoo natadamua pee aitaas ninche.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
    }
