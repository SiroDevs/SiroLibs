        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Entoomonoki iyiook",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilalashera ore enabayie entoomokie iyiook, pee esioki ororei lo Laitoriani aidapasha nemirisho anaa enaikunaki ti atua intae, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.1",
            "verseOrgIds": [
              "2TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee eitajeuni iyiook too ltung'ana arruok naa torrok; amu ime pooki ooata enkirukoto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.2",
            "verseOrgIds": [
              "2TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eisiligayu Olaitoriani naa keitagol ninye intae nerrip intae te ntorroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.3",
            "verseOrgIds": [
              "2TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aikiaata enkitieunoto ti atua Olaitoriani ti alo intae inchere iasitata naa imookiki aas imbaa nikintanap intae. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.4",
            "verseOrgIds": [
              "2TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metuutai Olaitoriani iltauja aitorioki enyorrata e Enkai o enkitashoto nemeiwuatiwuata e Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Easata e siaai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.5",
            "verseOrgIds": [
              "2TH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intae ilalashera kintanap taata te nkarna o Laitoriani lang Yesu Kristo inchere entalam olalashe pooki oton te nturuaisho lemesuj ilo kerreti litang'amutua te iyiook. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.6",
            "verseOrgIds": [
              "2TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu iyiololo intae maate eninkoko te niduaayaya iyiook, amu ore apa kiboitare intae neitu kitoni pesho, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.7",
            "verseOrgIds": [
              "2TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "neitu kinya endaa o ltung'ani hoo obo eitu kilak kake kinaurita nikisiaaisho, aasisho kewarie o dama, pee mikiaaku ake olola le likae obo linyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.8",
            "verseOrgIds": [
              "2TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neme enkaraki naa esipata mikiaata kake pee kincho iyiook intae to lkuaak lang enkitanyaanyukoto niduaayaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.9",
            "verseOrgIds": [
              "2TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore doi ninye ina kata kiboitare intae nikinchoo intae ena kitanapata: Te nemeasisho oltung'ani emincho enya endaa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.10",
            "verseOrgIds": [
              "2TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu kining ake inchere etii kulikae linyi ootoni ti atua enturuaisho neitanyamaluo too siaaitin e kulikae nemeeta esiaai naas. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.11",
            "verseOrgIds": [
              "2TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kintanap iltung'ana anaa lelo nikinkok te nkarna o Laitoriani Yesu Kristo metaasa esiaai enye te ngira nenya endaa naisiaayu oopeny. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.12",
            "verseOrgIds": [
              "2TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ilalashera eminauru te asata oo supati.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.13",
            "verseOrgIds": [
              "2TH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Te neany oltung'ani ening enikiliki iyiook intae te na palai, entayiolo ilo tung'ani, nimintokiki aata eniporokiki ninye, pee ekurru ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.14",
            "verseOrgIds": [
              "2TH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eming'or ninye anaa olmang'atinta, kake enkoo anaa olalashe.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Irorei oo bayie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.15",
            "verseOrgIds": [
              "2TH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore taata Olaitoriani le seriani meishoo ninye intae makewan eseriani inkatitin pooki ti tua nkoitoi pooki, metaa Olaitoriani te nebo intae pooki.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanu Paulo oigero ena kirorokino te nkaina ai makewan. Ele olilmonekie le mpalai ai pooki, neijia oshiaake aiko te naiger. ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metaa empiris o Laitoriani lang Yesu Kristo te nebo intae pooki.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.18",
            "verseOrgIds": [
              "2TH.3.18"
            ]
          }
        }
      ]
    }
  ],
