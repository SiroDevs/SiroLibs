            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.8",
            "verseOrgIds": [
              "JON.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kake ore nanu to ltoilo le nkishoroto e nashe naa kaapolosaki iyie olasar; ore ina nainosie olmumai kalak nanu. Eno Laitoriani enkordunoto!” ",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.9",
            "verseOrgIds": [
              "JON.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirorie Olaitoriani osinkirri, nelopu Yona te nkop natoyio.",
          "type": "text",
          "attrs": {
            "verseId": "JON.2.10",
            "verseOrgIds": [
              "JON.2.10"
            ]
          }
        }
