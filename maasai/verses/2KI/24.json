                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore apa aa olaiguanani Yehoiakim, neilepu Nebukadnesa, alotu neaku Yehoiakin osinka lenye ilarin okuni. Neitoki ninye aibelekenya agilunore ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaki Olaitoriani metigilunore ninye ilwuampan loo ltung'ana loo Lkaldayo o too ltung'ana le Moab o loo ltung'ana le Amori, neirriwaki ninche meshomo aarasaki Yuda neidaikie ninye, te risioroto o rorei lo Laitoriani, apa oiroro aimunye isinkan lenyena, lelo oibonok le Nkai. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eewuo ena bae shumata Yuda te nkitanapata o Laitoriani, pee eiwuang'ie ninche too nkonyek enyena, tenkaraki ing'ok e Manase, te risioroto e nena pooki apa naataasa ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tenkaraki sii ilo sarge lemeeta entioto apa oibukoyie ninye, amu eiputa apa ninye Yerusalem, osarge lemeeta entioto, neaku meidim Olaitoriani ataapalaki ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa nkulie kiaasin e Yehoiakim, o nena pooki naataasa ninye, neigeroki tiatua embuku oo ntepen oo laiguanak le Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eirure Yehoiakim etua anaa apa loo menye, neitoreisho Yehoiakim olayioni lenye te rishata enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eitu eitoki olaiguanani le Misiri aipang'u te nkop enye, amu eewa olaiguanani le Babilon nena pooki apa naara ino laiguanani le Misiri ebaiki oerata le Misiri o metabaiki olkeju le Frati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olaiguanani Yehoiakin le Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oloo larin tomon o isiet apa Yehoiakin pee eiteru aitoreisho, neitoreisho ninye ilapaitin okuni te Yerusalem. Ore apa enkarna e ng'otonye naa keji Nabusta, entito e Elnatan. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neas ninye mbaa torrok too nkonyek o Laitoriani, te risioroto e nena pooki apa naataasa loo papaai lenye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore apa teina kata neilepu isinkan le Nebukadnesa olaiguanani le Babilon aapuonu Yerusalem, neibung'i ina anasa aang'adu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Nebukadnesa, olaiguanani le Babilon nelotu ina anasa ina kata etang'adutua isinkan lenyena; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.24+JER.22.25+JER.22.26+JER.22.27+JER.22.28+JER.22.29+JER.22.30"
              },
              "items": [
                {
                  "text": "Yer 22.24-30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.1+JER.24.2+JER.24.3+JER.24.4+JER.24.5+JER.24.6+JER.24.7+JER.24.8+JER.24.9+JER.24.10"
              },
              "items": [
                {
                  "text": "24.1-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.1+JER.29.2"
              },
              "items": [
                {
                  "text": "29.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ore Yehoiakin olaiguanani le Yuda, neitarasaki kewan olaiguanani le Babilon, kewan enye, o ng'otonye o sinkan lenyena, o lkituaak lenyena, o sinkan le nkaji enye e nkitoo. Neen olaiguanani le Babilon ninye, neya ninye, to lari le isiet le nkitoria enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nenap ninye aya lelo shumat pooki le nkaji o Laitoriani o lchumat le nkaji o laiguanani, nedung aitaa mbelibelat imasaa pooki e sahabu naatii atua enkaji o Laitoriani, apa naaitobira Solomon olaiguanani loo Siraeli, anaa apa enatolimuo Olaitoriani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etanapa ninye aya Yerusalem pooki, o lkituaak pooki o ltung'ana pooki magil yiolot, iltung'ana nkalifuni tomon ooibung'aki, o ltung'ana pooki arriyiak te nguetare, o too sekenke. Meetae hoo obo otelekua, meteleku ake lelo tung'ana ake aisinak oleng leina kop. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12"
              },
              "items": [
                {
                  "text": "Esek 17.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neya ninye Yehoiakin Babilon; o ng'otonye olaiguanani, o nkituaak o laiguanani, o lkituaak lenyena o ltung'ana kituaak leina kop. Eewa ninye te araroto aitung'uaa Yerusalem nerik Babilon. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neyau olaiguanani le Babilon lelo yarunot Babilon, lelo tung'ana pooki yiolot, nkalifuni naapishana, o ltung'ana arriyiak te nguetare, o loo sekenke, iltung'ana enkalifu nabo, ore lelo pooki naa iltung'ana oogol neishiaakino to olarrabal. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.1"
              },
              "items": [
                {
                  "text": "Yer 37.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.13"
              },
              "items": [
                {
                  "text": "Esek 17.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitoki olaiguanani le Babilon aitaa Matania olenkapu le Yehoiakin, olaiguanani te rishata enye, neibelekeny enkarna enye ajo Sedekia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sedekia olaiguanani le Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
