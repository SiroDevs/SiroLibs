          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.20",
            "verseOrgIds": [
              "2KI.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oloo larin oopishana apa Yehoash pee eiteru aitoreisho.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.11.21",
            "verseOrgIds": [
              "2KI.11.21"
            ]
          }
        }
      ]
    }
