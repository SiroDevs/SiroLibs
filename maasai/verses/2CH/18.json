  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2CH 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eikoo oloiboni le Nkai oji Mikaia Ahab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eeta Yehoshafat enkarsisisho sapuk o enkanyit neitobir olning'o tenkaraki enkiyama o ltung'ana le Ahab, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.1",
            "verseOrgIds": [
              "2CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore te siadi ilkuti arin nedoyio alo enetii Ahab te Samaria. Neyiang'aki Ahab ninye nkerra kumok o lmong'i tenebo lelo tung'ana apa ootii tenebo ninye, neilejilej ninye pee epuo aagilunore Ramot-Gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.2",
            "verseOrgIds": [
              "2CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Ahab, ilo aiguanani loo Siraeli Yehoshafat olaiguanani le Yuda, “Eilo iyie tenebo nanu Ramot-gilead?” Newal ninye ajo, “Atiu nanu anaa enitiu iyie, netiu iltung'ana laainei anaa iltung'ana linono. Kiaku iyiook tenebo iyie to larrabal.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Yehoshafat ajoki olaiguanani loo Siraeli, “Tang'asa nkilikuanishore ororei lo Laitoriani.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.4",
            "verseOrgIds": [
              "2CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki olaiguanani loo Siraeli aiturrurr iloibonok le Nkai tenebo, iltung'ana iip ong'uan, nejoki ninche, “Aikipuo iyiook olarrabal aagilunore Ramot-Gilead, anaa aimikipuo?” Nejoki ninche, enchom, amu keishoru Enkai apik nkaik o laiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etejo ninye Yehoshafat, “Aimeetae likae oiboni le Nkai likinkilikuanishore?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki olaiguanani loo Siraeli Yehosafat, “Eton etii oltung'ani obo likindim iyiook aaikilikuanishore tialo Olaitoriani, Mikaia olayioni le Imala; kake manyor nanu ninye, amu meibonu aikata isupati tialo nanu, ntorrok ake eibonu.” Nejo Yehoshafat, mincho olaiguanani ejo neijia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki olaiguanani loo Siraeli aipotu olkitok obo, nejoki, “Iyau nabo kata Mikaia olayioni le Imala.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ina kata netonita olaiguanani loo Siraeli o Yehoshafat, olaiguanani le Yuda too lorikan le nkitoo, neishopo ilkilani lenye, netonita ninche te wueji neituutishoreki, te mpolos e kishomi e Samaria; neibonisho iloibonok pooki te dukuya ninche. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.9",
            "verseOrgIds": [
              "2CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore Sedekia olayioni le Kenaana neitobiraki kewan imowuarak e sekenkei, nejo, “Nji ejo Olaitoriani, ‘Te kuna ilo iyie arrumoo ile Siria o metaba anaa neidak ninche.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
              "2CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore iloibonok pooki neibonu ina, nejo, “Ilepa shomo Ramot-gilead pee ilo amirisho; aikincho iyie Olaitoriani apik enkaina o laiguanani.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore lelo kulikae apa ooshomo aaipotu Mikaia nejoki ninye, “Ng'ura ore irorei loo loibonok le Nkai pooki neimaki embae nabo supat tialo olaiguanani; nchoo orerei lino etiu anaa orerei le obo lenye, niro te supatisho.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etejo Mikaia, “Ore anaa enaishu Olaitoriani, ore ina najo Enkai ai ina nanu airo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee ebau enetii olaiguanani, nejoki olaiguanani ninye, “Mikaia, eikipuo iyiook Ramot-gilead, olarrabal anaa aikipal?” Newalu ninye ajo, “Ilepa shomo timirisho; kepiki ninche enkaina ino.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake etiaka olaiguanani ninye, “Aikatitin aja aasai nanu pee iro esipata ake te nkarna o Laitoriani?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.17"
              },
              "items": [
                {
                  "text": "Enki 27.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.5"
              },
              "items": [
                {
                  "text": "Esek 34.5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.36"
              },
              "items": [
                {
                  "text": "Mat 9.36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.34"
              },
              "items": [
                {
                  "text": "Mk 6.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Neitoki ninye ajo, “Atoduaa nanu Isiraeli pooki eidapashakinote ildoinyio anaa nkerra nemeeta olchekut; netejo Olaitoriani, ‘Meeta kulo olaitasheikinoni; nchoo pooki ng'ae errinyo alo enkang enye te seriani.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki olaiguanani loo Siraeli ajoki Yehoshafat, “Keitu nanu aajoki iyie nchere meibonu ninye esidai tialo nanu, kake entorroni ake eibonu?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Mikaia, “Toning'o naa orerei lo Laitoriani: Atoduaa nanu Olaitoriani etonita to lorika lenye le nkitoo, ore olorora pooki le shumata, neitashe te nkaina enye e tatene, o te ne kedienye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Olaitoriani, ‘Aing'ae olo alej Ahab olaiguanani loo Siraeli, pee etum ninye ashomo atabatatayu te Ramot-gilead?’ Nejo obo embae nabo, nejo olikae enkae. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki alotu enkiyang'et neitashe te dukuya Olaitoriani, ejo, ‘Kalo nanu alej ninye.’ Nejoki Olaitoriani, ‘Tia oitoi?’ ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo ninye, ‘Kalo nanu, naaku oltau le lejare too nkutukie oo loibonok lenyena.’ Nejo ninye ilo iyie alej ninye, naa ndimu ninye, shomo naa taasa ina. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore naa taata etipika Olaitoriani enkiyang'et e lejare nkutukie e kulo oibonok linono; eiroro entorroni tialo iyie.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitoki Sedekia olayioni le Kenaana anyiku neosh Mikaia eseder, nejoki, “Kaji eimua enkiyang'et o Laitoriani pee epuku te nanu nikilotu airorie iyie?” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Mikaia, “Ng'ura, ilo iyie adol teina olong, tinilo iyie olgilata liatua aisudori.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo ilo aiguanani loo Siraeli, “Embung'a Mikaia, nirrinyirrinyi ninye aaya enetii Amon ilo balusui le nkanasa, o enetii Yoash ilo ayioni lo laiguanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilo ajo, ‘Nji ejo olaiguanani, Entipik ena tung'ani atua korokoroni, ninchosho ninye meinosa imukateni naatoito neok enkare, o metaba anaa nashukunye te seriani.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejo Mikaia, “Tenitushukunye iyie te seriani, neitu nanu aairorie Olaitoriani”, neitoki ninye ajo, “Entoning intae lo orere pooki!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Keeya e Ahab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neaku eshomo olaiguanani loo Siraeli; o Yehoshafat olaiguanani le Yuda Ramot-gilead. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki olaiguanani loo Siraeli Yehoshafat, “Kaibelekeny nanu enkishopo ai nalo olarrabal, kake inchopo iyie ilkilani linono le nkitoo.” Neibelekeny olaiguanani loo Siraeli enkishopo enye nepuo ninche olarrabal. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neitanapa apa olaiguanani le Siria ilkituaak loo ngarrin enyena oo mbartan, ajoki, “Emiarare ake oloti anaa olkitok, kake olaiguanani loo Siraeli ake entaarare.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ore ake pee edol lelo kituaak loo ngarrin oo mbartan Yehoshafat nejo ninche, “Olaiguanani loo Siraeli ilo.” Neibelekenya ninche aarare ninye; neyietu Yehoshafat abuaku, neretu Olaitoriani ninye. Neboinaa Enkai ninche aitung'uaa ninye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu etoduaa ake lelo kituaak loo ngarrin oo mbartan aajo mme olaiguanani loo Siraeli ilo nerrinyo te sujata enye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kake eteyietuo oltung'ani obo enkawuo enye nengoroo embae, neng'or olaiguanani loo Siraeli eripata enkila enye esekenkei, to lgoo; ore enkaraki ina nejoki ninye olarewani lenye le ngarri e mbarta, “Mbelekenyayu ntung'uayioki nanu olarrabal, amu aatipikaki nanu olbae.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirowuaju oleng olarrabal ina olong, neigarakino olaiguanani loo Siraeli eng'arri enye embarta aing'or ile Siria o metaa teipa. Ore ake pee edoyio enkolong neye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
