        },
        {
          "text": " Oloo larin tikitam oobo apa Sedekia pee eiteru aitoreisho, neitoreisho ninye ilarin tomon oobo te Yerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
