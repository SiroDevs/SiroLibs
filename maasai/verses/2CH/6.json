          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tenelotu olameyu enkop anaa olmeitai, anaa erruoyo ndaiki naatii nkurman, anaa tenelotu olmaati, anaa enkurto; teneng'adu ilmang'ati lenye ninche te nabo ake ninye oo nkanas enye; o pooki meitai anaa pooki muoyian; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ore ake enkomono pooki o esayiata naomon oltung'ani obo anaa iltung'ana pooki loo Siraeli, eyiolo ake oltung'ani eoshoto enye o sina lenye, neitorioo nkaik aaing'orie ena aji; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "toning'o naa iyie te keper, teina manyisho ino, nipalaki, ore ake pooki tau liyiolo iyie nilaaki te risioroto oo nkoitoi enyena (Amu iyie ake openy oyiolo iltauja loo nkera e tung'ana); ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "pee kitum ninche aatureita iyie, nepuo too nkoitoi inono, nkolong'i pooki naaishu teina kop apa ninchoo iloo menye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
