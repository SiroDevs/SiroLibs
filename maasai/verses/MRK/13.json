                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nesulunye ilakir te keper, neikirikirieki engolon o loing'ang'e. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.25",
            "verseOrgIds": [
