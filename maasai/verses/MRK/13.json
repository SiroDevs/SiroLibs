            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Enteng'ena ate te nkitanyaanyukoto o lng'aboli; laa ore ake pee enanau ilng'osil neiturumisho mbenek, niyiolouu aajo etinyikua olari. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.28",
            "verseOrgIds": [
              "MRK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neijia naa etiu, ti nidolidolo nena baa etabautua, niyiolouu aajo etataana ninye, auluo etii. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.29",
            "verseOrgIds": [
              "MRK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esipa ajoki intae, meishari ena ishoi eitu eitabari kuna baa pooki. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.30",
            "verseOrgIds": [
              "MRK.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keishari shumata o enkop, kake meishari irorei laainei.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.31",
            "verseOrgIds": [
              "MRK.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Meyioloi ina olong aashu ina saa",
          "type": "text"
        }
      ]
    },
    {
