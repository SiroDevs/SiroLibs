                  "text": "Emb 1.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nedoluni ina kata Enkerai e Tung'ani elotu too nkatampo te ngolon sapuk o te nkitoo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.26",
            "verseOrgIds": [
              "MRK.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neirriwaa te ina kata ilmalaika, meiturrurro lelo gelunot lenyena aaitung'uaa ilubot pokira ong'uan, neitung'uaa ineeiting'ie enkop o neeiting'ie keper.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.27",
            "verseOrgIds": [
              "MRK.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Entuutarie ate olng'aboli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
