              "items": [
                {
                  "text": "Olke 2.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neaku ore sii ninye Kristo eitu eilepie kewan meitaae olapolosani kitok, kake ketegeluaki ilo otiaaka ninye, “Ira iyie Oinoti lai taata aatoiwuo iyie,” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.4"
              },
              "items": [
                {
                  "text": "Olke 110.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " anaa pee ejo te dikae wueji, “Ira iyie olapolosani ntarasi, to lkerreti le Melkisedek.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.6",
            "verseOrgIds": [
              "HEB.5.6"
            ]
          }
        }
      ]
