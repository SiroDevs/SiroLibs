      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ore olapolosani ake pooki ogeluni ti atua olorere negeluni metaasisho te nkaraki olorere tiaalo Enkai, neitayu nkishorot o lasarri te nkaraki ng'ok. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.1",
            "verseOrgIds": [
              "HEB.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neidim ninye ataretu te mborron ilmoda o lwushuush, enapita ninye makewan enchalan enye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.2",
            "verseOrgIds": [
              "HEB.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.7"
              },
              "items": [
                {
                  "text": "Ilaw 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ore te nkaraki ena meeta nchere meng'as aitayu olasar loo ng'ok enyena makewan neitayu sii noo ilkulikae tung'ana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.3",
            "verseOrgIds": [
              "HEB.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.1"
              },
              "items": [
                {
                  "text": "Ena 28.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nemeetae oloisho kewan ina kitoo, kake Enkai naipot, anaa apa pee eipot Aron.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.4",
            "verseOrgIds": [
              "HEB.5.4"
            ]
          }
        }
      ]
    },
