              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaliki Tomas ajoki, “Olaitoriani lai naa Enkai ai!” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.28",
            "verseOrgIds": [
              "JHN.20.28"
            ]
          }
        },
        {
