          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nejoki Yesu ninye, “Iruko iyie te nkaraki nikitoduaa nanu? Emayiani lelo leitu edol neiruko.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.29",
            "verseOrgIds": [
