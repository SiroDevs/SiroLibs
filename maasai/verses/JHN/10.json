              "items": [
                {
                  "text": "Yhn 1.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Neitoki alo lido kekun le Yordan ewueji neibatisishore apa Yohana te nkiterunoto; neton te ine. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.40",
            "verseOrgIds": [
              "JHN.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nepuo ilkumok enetii ninye; nejo, “Eitu eas Yohana olmonekie kake ore pooki natejo Yohana eimaki ele tung'ani kesipa.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.41",
            "verseOrgIds": [
              "JHN.10.41"
            ]
          }
        }
      ]
    },
