              "items": [
                {
                  "text": "Yer 7.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Arigisha ati “Mbese ntimuzi ko byanditswe ngo ‘Inzu yanjye izitwa inzu yo gusengerwamo n'amahanga yose’? Ariko mwebwe mwayihinduye isenga y'abambuzi.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
