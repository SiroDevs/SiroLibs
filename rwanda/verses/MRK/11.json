          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatambyi bakuru n'abanditsi babyumvise bashaka uko bamwica, ariko baramutinya kuko abantu bose batangazwaga no kwigisha kwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        }
      ]
