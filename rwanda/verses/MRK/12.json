          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntihagira undi wongera gutinyuka kugira icyo amubaza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.34",
