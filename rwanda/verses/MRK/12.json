              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo Yesu yigishirizaga mu rusengero arababaza ati “Ni iki gituma abanditsi bavuga ko Kristo ari mwene Dawidi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dawidi ubwe yabwirijwe n'Umwuka Wera aravuga ati",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
