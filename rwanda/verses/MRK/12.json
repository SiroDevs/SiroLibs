            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwo mwanditsi aramubwira ati “Ni koko mwigisha, uvuze ukuri yuko Imana ari imwe, nta yindi keretse yo yonyine. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.32",
