                {
                  "text": "Guteg 6.4-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Yesu aramusubiza ati “Iry'imbere ni iri ngo ‘Umva Isirayeli, Uwiteka Imana yacu ni we Mwami wenyine. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.29",
            "verseOrgIds": [
              "MRK.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ukundishe Uwiteka Imana yawe umutima wawe wose, n'ubugingo bwawe bwose, n'ubwenge bwawe bwose n'imbaraga zawe zose.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.30",
            "verseOrgIds": [
              "MRK.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Lewi 19.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Irya kabiri ngiri: ‘Ukunde mugenzi wawe nk'uko wikunda.’ Nta rindi tegeko rirusha ayo gukomera.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.31",
            "verseOrgIds": [
              "MRK.12.31"
            ]
          }
        }
      ]
