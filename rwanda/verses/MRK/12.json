        {
          "text": "Yicara yerekeye isanduku y'amaturo, areba abantu batura amakuta bayashyiramo, abatunzi benshi bashyiramo menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.41",
