          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.6"
              },
              "items": [
                {
                  "text": "Hos 6.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi no kuyikundisha umutima wawe wose, n'ubugingo bwawe bwose, n'imbaraga zawe zose, kandi no gukunda mugenzi wawe nk'uko wikunda, biruta ibitambo byose byokeje n'ibitokeje.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.33",
            "verseOrgIds": [
              "MRK.12.33"
            ]
          }
        }
