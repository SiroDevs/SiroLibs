              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umupfakazi wari umukene araza atura amasenga abiri, ari yo kuta. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.42",
            "verseOrgIds": [
