              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko hazaduka abiyita Kristo n'abahanuzi b'ibinyoma bakora ibimenyetso n'ibitangaza, kugira ngo babone uko bayobya n'intore niba bishoboka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.22",
            "verseOrgIds": [
