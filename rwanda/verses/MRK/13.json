                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
                  "text": "12.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ariko nimubona ikizira kirimbura kigeze aho kidakwiriye, (usoma abyitondere), icyo gihe abazaba bari i Yudaya bazahungire ku misozi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.14",
            "verseOrgIds": [
              "MRK.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.31"
              },
              "items": [
                {
                  "text": "Luka 17.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " n'uzaba ari hejuru y'inzu ye kuzamanuka, ngo yinjire mu nzu ye ngo agire icyo akuramo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.15",
            "verseOrgIds": [
              "MRK.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'uzaba ari mu murima ye kuzasubira imuhira ngo azane umwenda we.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.16",
            "verseOrgIds": [
              "MRK.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abazaba batwite n'abonsa muri iyo minsi bazabona ishyano! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.17",
            "verseOrgIds": [
              "MRK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko musenge kugira ngo bitazabaho mu mezi y'imbeho, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.18",
            "verseOrgIds": [
              "MRK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.1"
              },
              "items": [
                {
                  "text": "Dan 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.14"
              },
              "items": [
                {
                  "text": "Ibyak 7.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko muri iyo minsi hazabaho umubabaro mwinshi utigeze kubaho, uhereye mu itangiriro ubwo Imana yaremaga ukageza none, kandi ntuzongera kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.19",
            "verseOrgIds": [
              "MRK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyaba Umwami Imana itagabanyije iyo minsi, ntihajyaga kuzarokoka umuntu n'umwe, ariko ku bw'intore yatoranyije yayigabanyijeho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.20",
            "verseOrgIds": [
              "MRK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icyo gihe umuntu nababwira ati ‘Dore Kristo ari hano’, cyangwa ati ‘Dore ari hariya’ ntimuzabyemere, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.21",
            "verseOrgIds": [
              "MRK.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 13:22"
          },
