            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabahamagara abacira imigani ati “Satani abasha ate kwirukana Satani? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.23",
            "verseOrgIds": [
              "MRK.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ubwami bwigabanyije ubwabwo, ubwo bwami ntibubasha kugumaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.24",
            "verseOrgIds": [
              "MRK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzu iyo yigabanyije ubwayo ntibasha kugumaho, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.25",
            "verseOrgIds": [
              "MRK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cyangwa Satani iyo yihagurukiye akīgabanya, ntabasha kugumaho ashiraho.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.26",
            "verseOrgIds": [
              "MRK.3.26"
            ]
          }
        }
      ]
    },
