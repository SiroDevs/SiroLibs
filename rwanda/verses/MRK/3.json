          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi nta muntu wabasha kwinjira mu nzu y'umunyamaboko, ngo amusahure ibintu atabanje kumuboha, kuko ari bwo yabona uko asahura inzu ye.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.27",
            "verseOrgIds": [
              "MRK.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
