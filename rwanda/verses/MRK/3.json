            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.34"
              },
              "items": [
                {
                  "text": "Mat 9.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.25"
              },
              "items": [
                {
                  "text": "10.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi abanditsi bavuye i Yerusalemu na bo bati “Afite Belizebuli”, kandi bati “Umukuru w'abadayimoni ni we umuha kwirukana abadayimoni.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        }
      ]
