            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese kuri mwe ni ho ijambo ry'Imana ryaturutse? Cyangwa se ryageze kuri mwe mwenyine?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.36",
