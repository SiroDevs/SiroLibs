              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira umuntu wibwira ko ari umuhanuzi cyangwa ko afite Umwuka, amenye ibyo mbandikiye yuko ari itegeko ry'Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.37",
