          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nibagira icyo bashaka kumenya babibarize abagabo babo imuhira, kuko biteye isoni ko umugore avugira mu iteraniro.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.35",
            "verseOrgIds": [
              "1CO.14.35"
            ]
          }
        }
      ]
