    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abisirayeli batubereye akabarore ko kuturinda gukora ibibi",
          "type": "text"
        }
      ]
    },
