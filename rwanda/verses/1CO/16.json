                  "text": "Ibyak 19.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nzabasūra nyuze i Makedoniya kuko ngambiriye kuzajya muri icyo gihugu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ahari nzamarana namwe iminsi ndetse ahari nzahamara n'igihe cy'imbeho, kugira ngo mumperekeze aho nzajya hose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinshaka kubakubita urubandu none mpita, ahubwo niringiye kuzamarana namwe iminsi, Umwami wacu nankundira.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        }
      ]
    },
