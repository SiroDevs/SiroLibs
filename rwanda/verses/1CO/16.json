          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishimiye yuko Sitefana na Forutunato na Akayiku baje, bamaze urukumbuzi nari mfitiye mwebwe ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.17",
            "verseOrgIds": [
              "1CO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko baruhuye umutima wanjye n'uwanyu, nuko mwemere abameze batyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.18",
            "verseOrgIds": [
              "1CO.16.18"
            ]
          }
        }
      ]
