                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Niba Timoteyo azaza muzamwemere kugira ngo abane namwe adatinya, kuko akora umurimo w'Umwami wacu nkanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.10",
            "verseOrgIds": [
              "1CO.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntihazagire umuhinyura, ahubwo mumuherekeze mumusezerere amahoro, kugira ngo ansange kuko mutegereza ko azazana na bene Data.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.11",
            "verseOrgIds": [
              "1CO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
