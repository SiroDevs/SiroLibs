          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nugururiwe irembo rinini rijya mu mirimo ikomeye kandi abandwanya bakaba benshi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
              "1CO.16.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "kandi . . . benshi:",
              "type": "text"
            },
            {
              "text": "cyangwa, nyamara abandwanya baracyari benshi.",
              "type": "text"
            }
          ]
        }
      ]
    },
