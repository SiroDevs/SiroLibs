              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.25+ROM.15.26"
              },
              "items": [
                {
                  "text": "Rom 15.25-26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ibyerekeye ku byo gusonzoranyiriza abera impiya nk'uko nategetse amatorero y'i Galatiya, abe ari ko namwe mukora. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.1",
            "verseOrgIds": [
              "1CO.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku wa mbere w'iminsi irindi hose, umuntu wese muri mwe abike iwe ibimushobokera nk'uko atunze, kugira ngo ubwo nzaza ataba ari ho impiya zisonzoranywa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.2",
            "verseOrgIds": [
              "1CO.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ubwo nzasohora abo muzashima nzabatuma mbahaye inzandiko, kugira ngo abe ari bo bajyana iby'ubuntu bwanyu i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.3",
            "verseOrgIds": [
              "1CO.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi niba nanjye nzaba nkwiriye kugenda tuzajyana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.4",
            "verseOrgIds": [
              "1CO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Inama za Pawulo n'intashyo ze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
