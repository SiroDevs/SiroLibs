          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undi mutwe w'abagenda bashīma bajya kubasanganira, nanjye nari mbakurikiye ndi kumwe n'igice cy'abantu, tugenda ku nkike haruguru y'umunara w'itanura tugera ku nkike ngari. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze tunyura hejuru y'irembo rya Efurayimu no ku irembo rya kera, tunyura ku irembo ry'amafi no ku munara wa Hananēli no ku wa Hameya, tugera ku irembo ry'intama. Baherako bahagarara ku irembo ry'abakumirizi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
