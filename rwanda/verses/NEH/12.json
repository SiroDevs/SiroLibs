          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze imitwe yombi ihagarara mu nzu y'Imana irahayishimira, nanjye nari kumwe n'igice cy'abatware ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abatambyi: Eliyakimu na Māseya na Miniyamini na Mikaya, na Eliyowenayi na Zekariya na Hananiya bafite amakondera, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Māseya na Shemaya na Eleyazari na Uzi, na Yehohanani na Malikiya na Elamu na Ezeri. Abaririmbyi baririmba ijwi rirenga, Yezerahiya ari we mutware wabo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        }
      ]
    },
