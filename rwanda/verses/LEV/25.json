            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abane na we ameze nk'umukozi ukorera ibihembo by'umwaka, ntakamutwarize igitugu imbere yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        },
        {
          "name": "verse",
