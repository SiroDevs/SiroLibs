                "loc": "DEU.15.7+DEU.15.8"
              },
              "items": [
                {
                  "text": "Guteg 15.7-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Mwene wanyu nakena akananirizwa gukora n'intege nke imbere yawe, ujye umufasha, mubane nk'umunyamahanga n'umusuhuke ugusuhukiyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukamwake inyungu cyangwa ibirenze, ahubwo utinye Imana yawe, kugira ngo mwene wanyu abone uko abana nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.24"
              },
              "items": [
                {
                  "text": "Kuva 22.24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.20+DEU.23.21"
              },
              "items": [
                {
                  "text": "Guteg 23.20-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntukamuguririze ifeza zawe kumwaka inyungu, cyangwa ibyokurya byawe ngo uzamwake ibirenze. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi Uwiteka Imana yanyu, yabakuriye mu gihugu cya Egiputa kubaha igihugu cy'i Kanāni, nkababera Imana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
