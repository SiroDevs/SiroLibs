            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi inyamaswa yose cyangwa itungo ryose mwemererwa kurya nigipfa, ukoze ku ntumbi yacyo azaba ahumanye ageze nimugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriye ku ntumbi yacyo amese imyenda ye abe ahumanye ageze nimugoroba, kandi n'uteruye intumbi yacyo amese imyenda ye, abe ahumanye ageze nimugoroba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi igikururuka hasi cyose, gikurura inda cyangwa kigenza amaguru magufi, ni ikizira ntikikaribwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.41",
            "verseOrgIds": [
              "LEV.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igikurura inda cyose, n'ikigenza amaguru ane magufi cyose, n'ikigenza amaguru menshi cyose, ibikururuka hasi byose ntimukabirye kuko bizira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.42",
            "verseOrgIds": [
              "LEV.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukiyandavurishe igikururuka cyose gikurura inda cyangwa kigenza amaguru magufi, ntimukabyihumanishe ngo bibanduze. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.43",
            "verseOrgIds": [
              "LEV.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.2"
              },
              "items": [
                {
                  "text": "Lewi 19.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.1.16"
              },
              "items": [
                {
                  "text": "1 Pet 1.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko ndi Uwiteka Imana yanyu, abe ari cyo gituma mwiyeza mube abera kuko ndi uwera, kandi ntimukiyandurishe igikururuka hasi cy'uburyo bwose gikurura inda cyangwa kigenza amaguru magufi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
              "LEV.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ndi Uwiteka wabakuriye mu gihugu cya Egiputa kuba Imana yanyu, abe ari cyo gituma muba abera, kuko ndi uwera.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.45",
            "verseOrgIds": [
              "LEV.11.45"
            ]
          }
        }
      ]
