          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "yo gutandukanya igihumanya n'ikidahumanya, n'igifite ubugingo cyaribwa n'ikitaribwa.”",
          "type": "text",
          "attrs": {
