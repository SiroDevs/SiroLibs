          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ayo ni yo mategeko y'inyamaswa n'amatungo, n'ibisiga n'inyoni n'ibifite ubugingo byose byiyogesha mu mazi, n'ibibaho byose bikururuka hasi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
