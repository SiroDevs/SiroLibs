            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "wabakuriye mu gihugu cya Egiputa kuba Imana yanyu. Ndi Uwiteka.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
