          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariko niba umutambyi asuzumye, akabona uwo muze utakwiriye muri uwo mwenda mu budodo butambitse cyangwa mu buhagaritse, cyangwa mu kintu cyose cyaremwe mu ruhu, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.53",
            "verseOrgIds": [
              "LEV.13.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
