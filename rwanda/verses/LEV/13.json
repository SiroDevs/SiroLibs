          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "ategeke ko bamesa icyo uwo muze wafashe, agikingirane kimare indi minsi irindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.54",
            "verseOrgIds": [
              "LEV.13.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 13:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umutambyi azasuzume icyo uwo muze wafashe cyaramaze kumeswa, nabona uwo muze utahinduye irindi bara kandi utagikwiriyemo, kizaba gihumanye uzagitwike. Uzaba ari umuze ukirya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ukirya:",
              "type": "text"
            },
            {
              "text": "cyangwa, wagitinzeho.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", naho cyaba gipfutse imbere cyangwa inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.55",
            "verseOrgIds": [
              "LEV.13.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 13:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niba uwo mutambyi asuzumye icyo wafashe, akabona utakigaragara cyane, cyarameshwe, ahatanyure ahakure muri uwo mwenda cyangwa muri urwo ruhu, cyangwa muri ubwo budodo butambitse cyangwa mu buhagaritse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.56",
            "verseOrgIds": [
              "LEV.13.56"
            ]
          }
