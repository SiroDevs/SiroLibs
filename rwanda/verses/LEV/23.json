        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Abisirayeli uti: Umunsi wa cumi n'itanu w'uko kwezi kwa karindwi, abe ari ho mutangirira kuziririza Uwiteka iminsi mikuru irindwi y'ingando. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.34",
            "verseOrgIds": [
              "LEV.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku munsi uyitangira hajye habaho guterana kwera, ntihakagire umurimo w'ubugaragu muwukoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.35",
            "verseOrgIds": [
              "LEV.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumare iminsi irindwi mujya mutambira Uwiteka ibitambo bikongorwa n'umuriro, uwa munani ujye ubabera uwo guterana kwera, muwutambireho Uwiteka ibitambo bikongorwa n'umuriro, ube uwo guterana mwitonze. Ntimukagire umurimo w'ubugaragu muwukoraho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.36",
            "verseOrgIds": [
              "LEV.23.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
