                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.9+DEU.16.10+DEU.16.11+DEU.16.12"
              },
              "items": [
                {
                  "text": "Guteg 16.9-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Kandi mujye mubara iminsi muhereye kuri uwo munsi wa mbere w'isabato, ku munsi mwazaniyeho umuganda w'ituro ryo kuzunguzwa, mubare iminsi y'amasabato arindwi itagabanije. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.15",
            "verseOrgIds": [
              "LEV.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubare iminsi mirongo itanu igeze ku munsi wa mbere w'isabato ya karindwi, maze muganurire Uwiteka ituro ry'umuganura wundi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.16",
            "verseOrgIds": [
              "LEV.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu buturo bwanyu mukuremo imitsima ibiri yo kuba ituro rijungujwe, ibe iy'ibice bya cumi bibiri bya efa y'ifu y'ingezi yotsanywa umusemburo, kugira ngo iganurirwe Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.17",
            "verseOrgIds": [
              "LEV.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumurikane n'iyo mitsima abana b'intama barindwi badafite inenge bataramara umwaka, n'ikimasa cy'umusore n'amasekurume y'intama abiri, bibe ibitambo byoserezwa Uwiteka bitambanwe n'ituro ry'ifu n'iry'ibyokunywa yo kuri byo, bibe ibitambo bikongorwa n'umuriro by'umubabwe uhumurira Uwiteka neza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.18",
            "verseOrgIds": [
              "LEV.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mutambe n'isekurume y'ihene ho igitambo gitambirwa ibyaha, n'amasekurume y'intama abiri ataramara umwaka, ho ibitambo by'uko muri amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.19",
            "verseOrgIds": [
              "LEV.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutambyi azizunguzanye na ya mitsima y'umuganura na ba bana b'intama bombi, bibe ituro rijungurijwe imbere y'Uwiteka, byerezwe Uwiteka, bibe iby'umutambyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.20",
            "verseOrgIds": [
              "LEV.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
