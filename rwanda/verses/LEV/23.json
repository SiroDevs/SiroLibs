                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mu kwezi kwa mbere, ku munsi wako wa cumi n'ine nimugoroba, hajye habaho Pasika y'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.5",
            "verseOrgIds": [
              "LEV.23.5"
            ]
          }
        },
        {
