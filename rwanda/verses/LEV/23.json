          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iyi ni yo minsi mikuru y'Uwiteka, n'iyo guterana kwera mukwiriye kujya muranga mu bihe byayo byategetswe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.4",
            "verseOrgIds": [
              "LEV.23.4"
            ]
          }
        }
