            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3+DEU.16.4+DEU.16.5+DEU.16.6+DEU.16.7+DEU.16.8"
              },
              "items": [
                {
                  "text": "Guteg 16.3-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ku munsi w'uko kwezi wa cumi n'itanu hatangiriraho iminsi mikuru y'imitsima itasembuwe, muzamara iminsi irindwi muyirya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.6",
            "verseOrgIds": [
              "LEV.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku munsi uyitangira mujye muteranira kuba iteraniro ryera, ntimukagire umurimo w'ubugaragu muwukoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.7",
            "verseOrgIds": [
              "LEV.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri iyo minsi uko ari irindwi mujye mutambira Uwiteka ibitambo bikongorwa n'umuriro, uwa karindwi ni uwo guterana kwera, ntimukagire umurimo w'ubugaragu muwukoraho.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.8",
            "verseOrgIds": [
              "LEV.23.8"
            ]
          }
        }
      ]
    },
