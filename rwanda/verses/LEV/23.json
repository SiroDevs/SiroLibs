                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu minsi itandatu abe ari mo imirimo ijya ikorwa, ariko uwa karindwi ni isabato yo kuruhuka, n'uwo guterana kwera ntimukagire umurimo wose muwukoraho. Ni isabato y'Uwiteka yo kuziririzwa mu buturo bwanyu bwose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.3",
            "verseOrgIds": [
              "LEV.23.3"
            ]
          }
        }
      ]
