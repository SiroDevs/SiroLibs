              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.23.33",
            "verseOrgIds": [
              "LEV.23.33"
            ]
