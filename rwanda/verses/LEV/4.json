          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "icyaha yakoze nakimenyeshwa, azane umwagazi w'ihene udafite inenge ho igitambo cyo gutambirwa icyaha yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.28",
