          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo ni yo mategeko n'amateka n'ibyategetswe, Uwiteka yashyize hagati ye n'Abisirayeli, abitegekeye ku musozi wa Sinayi mu kanwa ka Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
