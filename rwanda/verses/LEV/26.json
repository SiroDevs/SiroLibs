              },
              "items": [
                {
                  "text": "27.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ntimukareme ibigirwamana by'ubusa, ntimugashinge igishushanyo kibajwe cyangwa inkingi y'amabuye, kandi ikibuye cyabajweho ibishushanyo ntimukagishyirire mu gihugu cyanyu, kugira ngo mwikubite imbere yacyo, kuko ndi Uwiteka Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujye muziririza amasabato yanjye, mwubahe Ahera hanjye. Ndi Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyo Imana isezeranya Abisirayeli nibayumvira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
