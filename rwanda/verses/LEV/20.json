            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.9"
              },
              "items": [
                {
                  "text": "Lewi 18.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.22"
              },
              "items": [
                {
                  "text": "Guteg 27.22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Umuntu niyenda mushiki we basangiye se cyangwa nyina bakarebana ubwambure, kizaba igihemu giteye isoni. Bazakurirweho mu maso y'abo mu bwoko bwabo kuko yambitse ubusa mushiki we, azagibwaho no gukiranirwa kwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.17",
            "verseOrgIds": [
              "LEV.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.19"
              },
              "items": [
                {
                  "text": "Lewi 18.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umuntu naryamana n'umugore uri mu muhango w'abakobwa akamwambika ubusa, azaba yambitse ubusa isōko ye, na we azaba yiyambitse ubusa isōko y'amaraso ye, bombi bazakurwe mu bwoko bwabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        }
      ]
    },
