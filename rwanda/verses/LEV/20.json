              "LEV.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umushitsi cyangwa umushitsikazi, n'umupfumu cyangwa umupfumukazi ntibakabure kwicwa, babicishe amabuye. Urubanza rw'amaraso ye ni we ruzahama.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.27",
            "verseOrgIds": [
              "LEV.20.27"
            ]
          }
        }
      ]
