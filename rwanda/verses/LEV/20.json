                "loc": "MRK.7.10"
              },
              "items": [
                {
                  "text": "Mar 7.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Umuntu wese uvuma se cyangwa nyina ntakabure kwicwa, kuko avumye se cyangwa nyina, urubanza rw'amaraso ye ni we ruzahama.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.9",
            "verseOrgIds": [
              "LEV.20.9"
            ]
          }
        }
      ]
    },
    {
