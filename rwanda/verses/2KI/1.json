            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Baramusubiza bati “Ni umugabo w'impwempwe nyinshi kandi yari akenyeje umushumi w'uruhu.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
