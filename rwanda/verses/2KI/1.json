          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aherako amutumaho umutware utwara ingabo mirongo itanu ari kumwe n'ingabo ze. Arazamuka amusanga aho yari yicaye mu mpinga y'umusozi aramubwira ati “Yewe muntu w'Imana, umwami aradutumye ngo ‘Manuka umwitabe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
