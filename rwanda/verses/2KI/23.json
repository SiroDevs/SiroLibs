              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatambyi bo mu ngoro ntibarakazamuka ngo bajye ku cyotero cy'Uwiteka i Yerusalemu, ahubwo bajyaga basangira na bene wabo imitsima idasembuwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
