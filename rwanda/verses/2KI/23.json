              "items": [
                {
                  "text": "1 Abami 12.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi igicaniro cy'i Beteli n'ingoro Yerobowamu mwene Nebati yubatse, ari we woheje Abisirayeli ngo bacumure, icyo gicaniro n'iyo ngoro arabisenya atwika iyo ngoro, arabisiribanga biba umuyonga, atwika n'igishushanyo cya Ashera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Abami 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yosiya ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "text": ", arakebuka abona ibituro byari ku musozi. Yohereza abantu bataburura amagufwa muri ibyo bituro, ayatwikira kuri icyo gicaniro aracyangiza, nk'uko ijambo ry'Uwiteka ryari riri wa muntu w'Imana yari yaravuze. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.30+1KI.13.31+1KI.13.32"
              },
              "items": [
                {
                  "text": "1 Abami 13.30-32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yosiya aravuga ati “Kiriya gishushanyo ndeba ni rwibutso ki?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
