          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagezeyo, abana b'abahanuzi b'i Yeriko basanga Elisa, baramubaza bati “Aho uzi ko uyu munsi Uwiteka agiye kugukuraho shobuja?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
