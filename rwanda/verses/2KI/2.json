              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramuhata kugeza aho bamurembereje, arabemerera ati “Nimubohereze.” Nuko boherezayo abagabo mirongo itanu bamara iminsi itatu bamushaka, baramubura. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baragaruka basanga agitinze i Yeriko arababwira ati “Sinababujije kugenda?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Elisa ahumanura amazi",
          "type": "text"
        }
      ]
    },
    {
