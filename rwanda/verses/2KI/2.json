          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we aramusubiza ati “Nkurahiye Uwiteka uhoraho n'ubugingo bwawe, sinsigara.” Nuko bajya i Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
