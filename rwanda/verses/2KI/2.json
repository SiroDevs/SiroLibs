            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya arongera aramubwira ati “Elisa, ndakwinginze sigara hano, kuko Uwiteka antumye i Yeriko.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
