              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye abanyamudugudu baho babwira Elisa bati “Dore uyu mudugudu uburyo uri heza nk'uko ubireba databuja, ariko amazi yaho ni mabi kandi muri iki gihugu imyaka irarumba.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
