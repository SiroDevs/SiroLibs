            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.23+1KI.7.24+1KI.7.25+1KI.7.26+1KI.7.27+1KI.7.28+1KI.7.29+1KI.7.30+1KI.7.31+1KI.7.32+1KI.7.33+1KI.7.34+1KI.7.35+1KI.7.36+1KI.7.37+1KI.7.38+1KI.7.39"
              },
              "items": [
                {
                  "text": "1 Abami 7.23-39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.2+2CH.4.3+2CH.4.4+2CH.4.5+2CH.4.6"
              },
              "items": [
                {
                  "text": "2 Ngoma 4.2-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze Umwami Ahazi atemaho ibisate by'ibitereko, avanaho n'igikarabiro. Kandi akuraho igikarabiro kidendeje cyari giteretse ku bishushanyo by'inka byakozwe mu miringa, agitereka ku mabuye ashashwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ibaraza ry'isabato risakawe ryari ryubatswe ku nzu y'Uwiteka, n'irembo ryo ku gikari ry'umwami ubwe, arabihindura ku bw'umwami wa Ashuri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko indi mirimo Ahazi yakoze, mbese ntiyanditswe mu gitabo cy'ibyo ku ngoma z'abami b'Abayuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Yes 14.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Hanyuma Ahazi aratanga asanga ba sekuruza, bamuhamba hamwe na bo mu mudugudu wa Dawidi, maze umuhungu we Hezekiya yima ingoma ye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
