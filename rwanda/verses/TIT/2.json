                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " watwitangiriye kugira ngo aducungure mu bugome bwose, kandi yuhagirire abantu kugira ngo babe ubwoko bwe bwite, bugira ishyaka ry'imirimo myiza.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.14",
            "verseOrgIds": [
              "TIT.2.14"
            ]
          }
        }
