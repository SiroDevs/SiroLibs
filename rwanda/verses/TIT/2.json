    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imibereho ikwiriye aba Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko wowe ho uvuge ibihuye n'inyigisho nzima. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.1",
            "verseOrgIds": [
              "TIT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhugure abasaza kugira ngo be gukunda ibisindisha, bitonde, badashayisha, babe bazima mu byo kwizera n'urukundo no kwihangana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.2",
            "verseOrgIds": [
              "TIT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abakecuru ni uko ubabwire bifate nk'uko bikwiriye abera batabeshyera abandi, badatwarwa umutima n'inzoga nyinshi, bigisha ibyiza ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.3",
            "verseOrgIds": [
              "TIT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo batoze abagore bato gukunda abagabo babo n'abana babo, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.4",
            "verseOrgIds": [
              "TIT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kudashayisha, no kwirinda gusambana, no kwita ku by'ingo zabo, no kugira neza, bagandukira abagabo babo kugira ngo ijambo ry'Imana ridatukwa.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.5",
            "verseOrgIds": [
              "TIT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abasore ni uko ubahugure kudashayisha, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.6",
            "verseOrgIds": [
              "TIT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "wiyerekane muri byose nk'icyitegererezo cy'imirimo myiza, kandi mu iyigisha ryawe ugaragaze uko uboneye udapfa gutera waraza, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.7",
            "verseOrgIds": [
              "TIT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ijambo ryawe ribe rizima ritariho umugayo, kugira ngo umuntu uri mu ruhande rw'ababisha amware atabonye ikibi yakuvuga.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.8",
            "verseOrgIds": [
              "TIT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hugura abagaragu b'imbata kugira ngo bagandukire ba shebuja, babanezeze muri byose batajya impaka, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.9",
            "verseOrgIds": [
              "TIT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "batiba, ahubwo bakiranuke neza rwose kugira ngo muri byose bizihize inyigisho z'Imana Umukiza wacu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubuntu bukiza bugaragarira abantu bose ubwo ari bwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.10",
            "verseOrgIds": [
              "TIT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ubuntu bw'Imana buzanira abantu bose agakiza bwabonetse, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.11",
            "verseOrgIds": [
              "TIT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "butwigisha kureka kutubaha Imana n'irari ry'iby'isi, bukatwigisha kujya twirinda, dukiranuka, twubaha Imana mu gihe cya none ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "dutegereje ibyiringiro by'umugisha, ari byo kuzaboneka k'ubwiza bwa Yesu Kristo, ari we Mana yacu ikomeye n'Umukiza ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
