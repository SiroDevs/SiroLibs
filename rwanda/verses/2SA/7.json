          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko none Uwiteka Mana, ijambo uvuze ku mugaragu wawe no ku nzu ye urikomeze iminsi yose, kandi uzasohoze ibyo uvuze. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze izina ryawe rihimbazwe iteka ryose, bavuge bati ‘Uwiteka Nyiringabo ni we Mana ya Isirayeli’, kandi inzu y'umugaragu wawe Dawidi izakomezwe imbere yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Uwiteka Nyiringabo Mana ya Isirayeli, uhishuriye umugaragu wawe ukavuga ngo uzamwubakira inzu, ni cyo gitumye umugaragu wawe nubahuka mu mutima wanjye kugusenga iri sengesho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        }
      ]
    },
