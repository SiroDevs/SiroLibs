        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“None Nyagasani Mana, ni wowe Mana, n'amagambo yawe ni ay'ukuri, kandi usezeranije umugaragu wawe iryo jambo ryiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none emera guha umugisha inzu y'umugaragu wawe, irame imbere yawe iminsi yose, kuko ari wowe ubivuze Nyagasani Mana, kandi umugisha utanga ujye uba umugisha inzu y'umugaragu wawe ihabwa iteka ryose.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
