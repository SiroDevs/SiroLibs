          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bose basubiza Abisirayeli bati “Ni uko umwami agira icyo apfana natwe. None bibarakarije iki? Hari ubwo twatunzwe n'umwami, cyangwa se hari impano yose yaduhaye?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.43",
            "verseOrgIds": [
              "2SA.19.43"
            ]
          }
        }
      ]
