          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "2SA 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli basubiza Abayuda bati “Ni twe bice cumi by'umwami, kandi rero Dawidi akwiriye kubaho ku bwacu kuruta mwebwe. Ni iki cyatumye mudusuzugura, ntimubanze kutugisha inama yo kugarura umwami wacu?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.44",
            "verseOrgIds": [
              "2SA.19.44"
            ]
          }
