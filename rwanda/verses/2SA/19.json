              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Abisirayeli bose basanga umwami baramubaza bati “Mwami Dawidi, ni iki gitumye bene wacu b'Abayuda bakuzana rwihishwa, bakakwambutsanya Yorodani n'abo mu rugo rwawe n'abantu bawe bose?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.19.42",
            "verseOrgIds": [
              "2SA.19.42"
            ]
          }
        }
