              "type": "text"
            }
          ]
        },
        {
          "text": " Bukeye Dawidi arabaza ati “Mbese hari uwasigaye wo mu muryango wa Sawuli, ngo mugirire neza ku bwa Yonatani?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu nzu ya Sawuli hariho umugaragu we witwaga Siba, baramuhamagara ngo yitabe Dawidi. Umwami aramubaza ati “Mbese ni wowe Siba?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ati “Ni jye umugaragu wawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
