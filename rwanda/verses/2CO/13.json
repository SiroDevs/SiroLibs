                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore none ubu ni ubwa gatatu nzaza iwanyu. Mu kanwa k'abagabo babiri cyangwa batatu ijambo ryose rizahamywa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabivuze kera ubwo nabasuraga ubwa kabiri, na none nubwo ntahari ni ko nkibivuga bitaraba, mbwira abacumuye kera n'abandi bose yuko ningaruka ntazabababarira, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mushaka ikimenyetso cyo kugaragaza yuko Kristo avugira muri jye, Kristo utari umunyantege nke kuri mwe, ahubwo agira ububasha hagati yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko intege nke zateye ko abambwa, ariko none ariho ku bw'imbaraga z'Imana izerekanira muri mwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaho nimwisuzume ubwanyu, mumenye yuko mukiri mu byo twizera kandi mwigerageze. Mbese ntimwimenya kandi ntimuzi yuko Yesu Kristo ari muri mwe? Keretse ahari mubaye abagawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niringiye yuko muzamenya ko twebweho tutari abagawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.6",
            "verseOrgIds": [
              "2CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndasaba Imana kugira ngo mutagira ikibi mukora, icyakora si ukugira ngo duse n'abemewe, ahubwo ni ukugira ngo mukore neza nubwo twasa n'abagawa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.7",
            "verseOrgIds": [
              "2CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nta cyo dushobora gukora ngo turwanye ukuri, keretse kukurwanira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Turishima iyo tugize intege nke namwe mukagira imbaraga, kandi icyo dusabira ni iki: ni uko mutunganywa rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitumye nandika ibyo ntari kumwe namwe, ni ukugira ngo nimpaba ne kuzaca imanza z'imbabazi nke, kuko nahawe ubutware n'Umwami wacu bwo kubaka, atari ubwo gusenya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye bene Data, murabeho. Mutungane rwose, muhugurike muhuze imitima",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "muhuze imitima:",
              "type": "text"
            },
            {
              "text": "cyangwa, muhumure.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mubane n'amahoro kandi Imana y'urukundo n'amahoro izabana namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutashyanishe guhoberana kwera.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abera bose barabatashya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu bw'Umwami wacu Yesu Kristo, n'urukundo rw'Imana, no kubana n'Umwuka Wera bibane namwe mwese.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
            "verseOrgIds": [
              "2CO.13.14"
            ]
          }
        }
      ]
    }
  ],
