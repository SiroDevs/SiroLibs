          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niba binkwiriye kwirata, nzajya nirata iby'intege nke zanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
