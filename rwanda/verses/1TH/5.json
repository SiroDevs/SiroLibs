              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bene Data, iby'ibihe n'iminsi ntimugomba kubyandikirwa, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.1",
            "verseOrgIds": [
              "1TH.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.43"
              },
              "items": [
                {
                  "text": "Mat 24.43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.39"
              },
              "items": [
                {
                  "text": "Luka 12.39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.3.10"
              },
              "items": [
                {
                  "text": "2 Pet 3.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko ubwanyu muzi neza yuko umunsi w'Umwami wacu uzaza nk'uko umujura aza nijoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.2",
            "verseOrgIds": [
              "1TH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo bazaba bavuga bati “Ni amahoro nta kibi kiriho”, ni bwo kurimbuka kuzabatungura nk'uko ibise bitungura umugore utwite, kandi ntibazabasha kubikira na hato. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.3",
            "verseOrgIds": [
              "1TH.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwebweho bene Data, ntimuri mu mwijima ngo uwo munsi ubatungure nk'umujura, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.4",
            "verseOrgIds": [
              "1TH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mwese muri abana b'umucyo n'abana b'amanywa. Ntituri ab'ijoro cyangwa ab'umwijima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.5",
            "verseOrgIds": [
              "1TH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero twe gusinzira nk'abandi ahubwo tube maso, twirinde ibisindisha ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.6",
            "verseOrgIds": [
              "1TH.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko abasinzira basinzira nijoro, n'abasinda bagasinda nijoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.7",
            "verseOrgIds": [
              "1TH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.17"
              },
              "items": [
                {
                  "text": "Yes 59.17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Ef 6.13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko twebweho ubwo turi ab'amanywa, twirinde ibisindisha twambaye kwizera n'urukundo nk'icyuma gikingira igituza, kandi twambaye ibyiringiro byo kuzabona agakiza nk'ingofero. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.8",
            "verseOrgIds": [
              "1TH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Imana itatugeneye umujinya, ahubwo yatugeneye guheshwa agakiza n'Umwami wacu Yesu Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.9",
            "verseOrgIds": [
              "1TH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadupfiriye, kugira ngo nituba turi maso cyangwa nituba dusinziriye, tuzabaneho na we. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.10",
            "verseOrgIds": [
              "1TH.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero muhumurizanye kandi muhugurane nk'uko musanzwe mubikora.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.11",
            "verseOrgIds": [
              "1TH.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indunduro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
