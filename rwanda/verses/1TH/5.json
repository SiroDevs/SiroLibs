              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana y'amahoro ibeze rwose, kandi mwebwe ubwanyu n'umwuka wanyu, n'ubugingo n'umubiri byose birarindwe, bitazabaho umugayo ubwo Umwami wacu Yesu Kristo azaza. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.23",
            "verseOrgIds": [
              "1TH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1TH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibahamagara ni iyo kwizerwa, no kubikora izabikora.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.24",
            "verseOrgIds": [
              "1TH.5.24"
            ]
          }
        }
      ]
    },
