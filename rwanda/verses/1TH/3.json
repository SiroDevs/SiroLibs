                {
                  "text": "Ibyak 17.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko rero tubonye yuko tutagishoboye kwiyumanganya, twibwira ko ibyiza ari uko twasigara muri Atenayi twenyine. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko dutuma Timoteyo mwene Data, umukozi w'Imana wo kubwiriza ubutumwa bwiza bwa Kristo ngo abe ari we ubakomeza, no kubahugura ku byo kwizera kwanyu ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo hatagira umuntu muri mwe unyeganyezwa n'aya makuba, kuko ubwanyu muzi yuko ari cyo twashyiriweho. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.3",
            "verseOrgIds": [
              "1TH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse ubwo twari kumwe namwe mbere twababwiye yuko tugiye kubabazwa, kandi ni ko byabaye namwe murabizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.4",
            "verseOrgIds": [
              "1TH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye mbatumaho mbonye ko ntakibashije kwiyumanganya, kugira ngo menye ibyo kwizera kwanyu yuko yenda umushukanyi yaba yarabashutse, natwe tukaba twarakoreye ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.5",
            "verseOrgIds": [
              "1TH.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
