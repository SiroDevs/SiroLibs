              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "text": " mutangaho ibice by'ifeza cumi na bitanu, na homeru imwe n'igice bya sayiri, maze ndamubwira nti ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uzamara iwanjye iminsi myinshi, ntuzagira ubumaraya, kandi ntuzaba umugore w'undi mugabo, nanjye ni ko nzakumerera.” ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Abisirayeli bazamara iminsi myinshi badafite umwami cyangwa igikomangoma, cyangwa igitambo habe n'inkingi, cyangwa efodi na terafimu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Abisirayeli bazagaruka bashaka Uwiteka Imana yabo n'umwami wabo Dawidi. Bazasanga Uwiteka n'ineza ye mu minsi y'imperuka, bamushaka bamwubashye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
