          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo sezerano yadusezeranije: ni ubugingo buhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.25",
            "verseOrgIds": [
              "1JN.2.25"
            ]
          }
        },
