          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mureke icyo mwumvise uhereye mbere na mbere kigume muri mwe, kuko icyo mwumvise uhereye mbere na mbere nikiguma muri mwe, namwe muzaguma muri uwo Mwana no muri Se.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.24",
            "verseOrgIds": [
              "1JN.2.24"
            ]
          }
        }
