        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubuhakanyi bwo mu minsi y'imperuka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TI 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Umwuka avuga yeruye ati “Mu bihe bizaza bamwe bazagwa bave mu byizerwa, bīte ku myuka iyobya n'inyigisho z'abadayimoni” ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.1",
            "verseOrgIds": [
              "1TI.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayobejwe n'uburyarya bw'abigisha b'abanyabinyoma, bafite inkovu z'ibyaha mu mitima yabo nk'iz'ubushye, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.2",
            "verseOrgIds": [
              "1TI.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TI 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "babuza kurongorana baziririza ibyo kurya Imana yaremye kugira ngo abizera bakamenya ukuri babirye bashima, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ibyo Imana yaremye byose ari byiza, ntiharimo icyo gutabwa iyo cyakiranywe ishimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.4",
            "verseOrgIds": [
              "1TI.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko cyezwa n'ijambo ry'Imana no gusenga.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyo gukiranukira gukora umurimo w'Imana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TI 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.5",
            "verseOrgIds": [
              "1TI.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TI 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwibutsa bene Data ibyo, uzaba ubaye umugabura mwiza w'ibya Kristo Yesu utunzwe n'amagambo yo kwizera n'inyigisho nziza wakurikije. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.6",
            "verseOrgIds": [
              "1TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TI 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko imigani itari iy'Imana n'iy'abakecuru ntukayemere, ahubwo witoze kubaha Imana ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.7",
            "verseOrgIds": [
              "1TI.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TI 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko kwitoza k'umubiri kugira umumaro kuri bike, naho kubaha Imana kukagira umumaro kuri byose, kuko gufite isezerano ry'ubugingo bwa none n'ubuzaza na bwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.8",
            "verseOrgIds": [
              "1TI.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo jambo ni iryo kwizerwa kandi rikwiriye kwemerwa rwose, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.9",
            "verseOrgIds": [
              "1TI.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko igituma tugoka tukarwana ari uko twiringiye Imana ihoraho, ari yo Mukiza w'abantu bose ariko cyane cyane w'abizera. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye utegeka ibyo kandi ubyigishe.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.11",
            "verseOrgIds": [
              "1TI.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.11",
            "verseOrgIds": [
              "1TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire uhinyura ubusore bwawe, ahubwo ube icyitegererezo cy'abizera ku byo uvuga, no ku ngeso zawe no ku rukundo, no ku kwizera no ku mutima uboneye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugeza aho nzazira, ujye ugira umwete wo gusoma no guhugura no kwigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukirengagize impano ikurimo, iyo waheshejwe n'ibyahanuwe ubwo warambikwagaho ibiganza by'abakuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.14",
            "verseOrgIds": [
              "1TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo ujye ubizirikana kandi abe ari byo uhugukiramo, kugira ngo kujya mbere kwawe kugaragarire bose. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.15",
            "verseOrgIds": [
              "1TI.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TI 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wirinde ku bwawe no ku nyigisho wigisha. Uzikomeze kuko nugira utyo uzikizanya n'abakumva.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.16",
            "verseOrgIds": [
              "1TI.4.16"
            ]
          }
        }
      ]
    }
  ],
