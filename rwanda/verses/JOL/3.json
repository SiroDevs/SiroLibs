              "type": "text"
            }
          ]
        },
        {
          "text": "“Nzashyira amahano mu ijuru no mu isi: amaraso n'umuriro n'umwotsi ucumba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.3",
            "verseOrgIds": [
              "JOL.3.3"
            ]
