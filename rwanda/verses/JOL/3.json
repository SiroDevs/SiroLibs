                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Hanyuma y'ibyo, nzasuka Umwuka wanjye ku bantu bose, abahungu banyu n'abakobwa banyu bazahanura, abakambwe banyu bazarota, n'abasore banyu bazerekwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.1-5:",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, iki gice ni 2.28-32, naho ubundi ni igice cya gatatu nk'uko biri mu Ruheburayo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.1",
            "verseOrgIds": [
              "JOL.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOL 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse n'abagaragu banjye n'abaja banjye nzabasukira ku Mwuka wanjye muri iyo minsi.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.2",
            "verseOrgIds": [
              "JOL.3.2"
            ]
          }
        }
      ]
    },
    {
