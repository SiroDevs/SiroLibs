              },
              "items": [
                {
                  "text": "Ibyah 6.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Izuba rizahinduka umwijima, n'ukwezi kuzahinduka amaraso, uwo munsi mukuru w'Uwiteka uteye ubwoba utaraza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
