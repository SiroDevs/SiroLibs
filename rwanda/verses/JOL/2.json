              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nzabashumbusha imyaka inzige zariye, n'iyariwe n'uburima n'ubuzikira na kagungu, za ngabo zanjye zikomeye nabateje. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.25",
            "verseOrgIds": [
              "JOL.2.25"
            ]
          }
        },
        {
          "name": "verse",
