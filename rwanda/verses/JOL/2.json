            "sid": "JOL 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzarya muhage, muhimbaze izina ry'Uwiteka Imana yanyu kuko yabakoreye ibitangaza, kandi ubwoko bwanjye ntibuzongera gukorwa n'isoni ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.2.26",
            "verseOrgIds": [
              "JOL.2.26"
            ]
          }
        },
        {
