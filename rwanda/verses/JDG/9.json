              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ba Isirayeli babonye yuko Abimeleki apfuye barataha, umuntu wese ajya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
