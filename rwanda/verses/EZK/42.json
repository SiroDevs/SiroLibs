        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze amvanayo anjyana mu rugo rw'inyuma aherekeye ikasikazi, angeza mu kumba kari imbere y'umwanya uciye hagati, kerekeye ku nzu iri aherekeye ikasikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruhande rwarimo urugi rw'aherekeye ikasikazi, uburebure bw'umurambararo bwarwo bwari mikono ijana, ubugari bwarwo ari mikono mirongo itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwari rwerekeye ahari mikono makumyabiri y'urugo rw'imbere, kandi rwerekeye no ku mbuga ishashweho amabuye y'urugo rw'inyuma, aho amabaraza y'utwumba twari tugerekeranye dutatu dutatu yari ari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere y'utwo twumba hari inzira ifite ubugari bwa mikono cumi n'akayira ka mukono umwe, kandi imiryango yatwo yari yerekeye ikasikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utwumba two hejuru twari duto ku two hasi n'utwo hagati, kuko twatubijwe n'amabaraza yatwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko twari tugerekeranije dutatu dutatu, ariko tudafite inkingi nk'inkingi za za ngo, ni cyo cyatumaga uhereye hasi utwumba two hejuru tuba duto ku two hasi no ku two hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusika rw'utwumba rwaheraga inyuma ku rugo rw'inyuma ruri imbere y'utwumba, uburebure bwarwo bwari mikono mirongo itanu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uburebure bw'umurambararo bw'utwumba tw'aherekeye mu rugo rw'inyuma bwari mikono mirongo itanu, ariko imbere y'urusengero ho hari mikono ijana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munsi y'utwo twumba hari irembo ryerekeye iburasirazuba, ryanyurwagamo n'abaturuka mu rugo rw'inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mubyimba w'urusika rw'urugo rw'aherekeye iburasirazuba, na ho hari utwumba twari imbere y'umwanya uciye hagati, twerekeye ku nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzira yari imbere yatwo yasaga n'inzira yari ku twumba tw'aherekeye ikasikazi, twose twanganaga mu burebure no mu bugari. Imiryango yatwo n'uko twaringanijwe n'inzugi zatwo, byose byarasaga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzugi z'utwumba tw'aherekeye ikusi na zo ni ko zari zimeze, ku mutwe w'inzira hari urugi, ari yo nzira yari iri imbere y'urusika rw'aherekeye iburasirazuba, ahanyurwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze arambwira ati “Utwumba tw'aherekeye ikasikazi n'utw'aherekeye ikusi, turi imbere y'umwanya uciye hagati ni two twumba twera, aho abatambyi begera Uwiteka bazarira ibintu byera. Ni ho bazatereka ibintu byera cyane n'ituro ry'ifu, n'igitambo cy'ibyaha n'igitambo cyo gukuraho urubanza, kuko ari ahantu hera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatambyi nbinjira, ntibazasohoka ngo bave ahera bajye mu rugo rw'inyuma bambaye imyambaro yabo bambara bakorera Imana, ahubwo bazaba ari ho bayibika kuko ari iyera, maze bambare indi myambaro babone kwegera ibya rubanda.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko arangije kugera inzu iri imbere, anjyana mu nzira iri ku irembo ry'aherekeye iburasirazuba, agera urugo impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageresha uruhande rw'aherekeye iburasirazuba urubingo rugereshwa, ruba imbingo magana atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ageresha uruhande rw'aherekeye ikasikazi urubingo rugereshwa, ruba imbingo magana atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageresha uruhande rw'aherekeye ikusi urubingo rugereshwa, ruba imbingo magana atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahindukirira mu ruhande rw'aherekeye iburengerazuba, ahageresha urubingo rugereshwa haba imbingo magana atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agera impande enye z'inkike izengurutse inzu, uburebure bwayo buba imbingo magana atanu, n'ubugari bwayo yandi atanu. Iyo nkike yari iyo gutandukanya ibyera n'ibya rubanda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
