          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.20",
            "verseOrgIds": [
              "EZK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ariko abana babo na bo barangomeye ntibagendera mu mategeko yanjye, n'amateka yanjye ntibayakomeza ngo bayakurikize kandi ari yo abeshaho uyakomeje, n'amasabato yanjye barayaziruye. Maze mvuga yuko nzabasukaho uburakari bwanjye, nkabamariraho umujinya wanjye bari mu butayu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.21",
            "verseOrgIds": [
              "EZK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nageruye ukuboko kwanjye ngirira izina ryanjye, kugira ngo ridasuzugurirwa imbere y'abanyamahanga, abo nabakuye imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.22",
            "verseOrgIds": [
              "EZK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nongeye kubarahirira mu butayu yuko nzabatataniriza mu mahanga, nkabateragana mu bihugu ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.23",
            "verseOrgIds": [
              "EZK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko batakomeje amateka yanjye, ahubwo amategeko yanjye barayanze bazirura n'amasabato yanjye, kandi amaso yabo akurikirana ibigirwamana bya ba se.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.24",
            "verseOrgIds": [
              "EZK.20.24"
            ]
          }
        }
      ]
    },
