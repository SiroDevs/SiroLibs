            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.24",
            "verseOrgIds": [
              "EZK.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Nuko mbaha amategeko atababonereye n'amateka atababeshaho, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.25",
            "verseOrgIds": [
              "EZK.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mbandurisha amaturo yabo, kuko bacishije impfura zabo zose mu muriro, kugira ngo mbahindure ingegera babone kumenya yuko ari jye Uwiteka.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.26",
            "verseOrgIds": [
              "EZK.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.26",
            "verseOrgIds": [
              "EZK.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko rero mwana w'umuntu, uvugane n'ab'inzu ya Isirayeli, ubabwire uti ‘Uku ni ko Umwami Uwiteka avuga ngo: Ba so barantutse ubwo bancumuyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.27",
            "verseOrgIds": [
              "EZK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko maze kubageza mu gihugu, icyo narahiriye kubaha, babonye umusozi muremure wose n'igiti gitoshye cyose, baherako bahatambirira ibitambo byabo kandi baba ari ho baturira ituro ryabo rindakaza, bahosereza n'imibavu yabo kandi bahasukira n'amaturo yabo y'ibyokunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.28",
            "verseOrgIds": [
              "EZK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndababaza nti: Impamvu z'izo ngoro mujyamo ni iki? Ni cyo cyatumye izina ryazo ryitwa Bama",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.29",
            "verseOrgIds": [
              "EZK.20.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Bama",
              "type": "text"
            },
            {
              "text": "mu Ruheburayo risobanurwa ngo, urusengero rwo ku kanunga.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kugeza n'ubu.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.29",
            "verseOrgIds": [
              "EZK.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.29",
            "verseOrgIds": [
              "EZK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko rero ubwire ab'inzu ya Isirayeli uti ‘Uku ni ko Umwami Uwiteka avuga ngo mbese muriyanduza nk'uko ba so bagenje, mugasambana mukurikije ibizira byabo? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.30",
            "verseOrgIds": [
              "EZK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko iyo mutura amaturo yanyu mucisha n'abahungu banyu mu muriro, muba mwiyandurisha ibigirwamana byanyu byose kugeza na n'ubu. Mbese nahanuzwa namwe, mwa b'inzu ya Isirayeli mwe? Ndirahiye yuko ntazahanuzwa namwe. Ni ko Umwami Uwiteka avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.31",
            "verseOrgIds": [
              "EZK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu byo mwibwira nta na kimwe kizaba, ubwo muvuga muti “Tuzamera nk'abanyamahanga, tube nk'imiryango yo mu bindi bihugu, dukorere ibishushanyo bibajwe mu biti no mu mabuye.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.32",
            "verseOrgIds": [
              "EZK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Uwiteka aravuga ngo: Ndirahiye ko ngiye kubabera umwami mbategekesheje amaboko akomeye kandi arambuye, n'uburakari busesuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.33",
            "verseOrgIds": [
              "EZK.20.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzabakura mu mahanga, mbateranirize hamwe mbakuze mu bihugu mwatataniyemo n'amaboko akomeye kandi arambuye, n'uburakari busesuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.34",
            "verseOrgIds": [
              "EZK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzabajyana mu butayu bw'abanyamahanga, ari ho nzababuranyiriza duhanganye amaso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.35",
            "verseOrgIds": [
              "EZK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'uko naburanije ba sogokuruza banyu mu butayu bwo mu gihugu cya Egiputa, ni ko nzababuranya. Byavuzwe n'Umwami Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.36",
            "verseOrgIds": [
              "EZK.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.36",
            "verseOrgIds": [
              "EZK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Kandi nzabacisha munsi y'inkoni yanjye, maze mbazane mu ndahiro y'isezerano, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.37",
            "verseOrgIds": [
              "EZK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko nzabakuramo abagome n'abancumuyeho mbakure mu gihugu batuyemo, kandi ntibazinjira mu gihugu cya Isirayeli. Namwe muzamenya yuko ndi Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.38",
            "verseOrgIds": [
              "EZK.20.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.38",
            "verseOrgIds": [
              "EZK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Yemwe ab'inzu ya Isirayeli mwe, uku ni ko Umwami Uwiteka avuga ngo: Nimugende, umuntu wese akorere ibigirwamana bye, ariko hanyuma muzanyumvira, kandi izina ryanjye ryera ntabwo muzongera kuryandurisha amaturo yanyu n'ibigirwamana byanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.39",
            "verseOrgIds": [
              "EZK.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Uwiteka aravuga ngo: Ku musozi wanjye wera, ku musozi w'impinga ya Isirayeli, ni ho ab'inzu ya Isirayeli bose n'abari mu gihugu bose bazankorera. Aho ni ho nzabakirira neza, kandi ni ho nzabakira amaturo, n'umuganura w'amaturo yanyu hamwe n'ibintu byanyu byera byose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.40",
            "verseOrgIds": [
              "EZK.20.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzabakira nk'ibihumura neza ubwo nzabakura mu banyamahanga, nkabakoranya mbavanye mu bihugu mwatataniyemo, kandi nziyerekanira muri mwe imbere y'abanyamahanga ko ndi Uwera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.41",
            "verseOrgIds": [
              "EZK.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe muzamenya yuko ndi Uwiteka, igihe nzabajyana mu gihugu cya Isirayeli, mu gihugu narahiriye guha ba sogokuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.42",
            "verseOrgIds": [
              "EZK.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho muzibukira inzira zanyu n'imirimo yanyu yose, iyo mwiyandurishije, kandi muzizinukwa ku bw'ibibi byose mwakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.43",
            "verseOrgIds": [
              "EZK.20.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 20:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzamenya yuko ndi Uwiteka nimara kubagenza ntyo ngirira izina ryanjye, kuko ntakurikije ingeso zanyu mbi, cyangwa imirimo yanyu yahumanye, mwa b'inzu ya Isirayeli mwe. Byavuzwe n'Umwami Uwiteka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.20.44",
            "verseOrgIds": [
              "EZK.20.44"
            ]
          }
        }
      ]
    }
