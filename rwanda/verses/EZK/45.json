            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.36"
              },
              "items": [
                {
                  "text": "Lewi 19.36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “ ‘Mugire iminzani itunganye na efa itunganye, n'incuro y'intango itunganye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        }
