              "EZK.11.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.2+EZK.43.3+EZK.43.4+EZK.43.5"
              },
              "items": [
                {
                  "text": "Ezek 43.2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maze abakerubi barambura amababa yabo, n'inziga zari iruhande rwabo; kandi ubwiza bw'Imana ya Isirayeli buri hejuru yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ubwiza bw'Uwiteka burazamuka buva mu murwa hagati, buhagarara ku musozi uri mu ruhande rw'iburasirazuba rw'umurwa. ",
          "type": "text",
