          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko rero mwana w'umuntu, dore bazagushyiraho iminyururu bayikuboheshe, kandi ntuzabasha gusohoka ngo ujye muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.25",
            "verseOrgIds": [
              "EZK.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzatuma ururimi rwawe rufatana n'urusenge rw'akanwa kawe, maze ube ikiragi we kubabera imbuzi, kuko abo ari inzu y'abagome. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.26",
            "verseOrgIds": [
              "EZK.3.26"
            ]
          }
        },
        {
