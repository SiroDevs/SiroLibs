              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka anyinjiramo anshingisha ibirenge byanjye, maze avugana nanjye arambwira ati “Genda wikingiranire mu nzu yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.24",
            "verseOrgIds": [
              "EZK.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
