            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma anjyana ku irembo, ari ryo ryerekeye iburasirazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.1",
            "verseOrgIds": [
              "EZK.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.3+EZK.10.4"
              },
              "items": [
                {
                  "text": "Ezek 10.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.10.18+EZK.10.19"
              },
              "items": [
                {
