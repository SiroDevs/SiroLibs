              "items": [
                {
                  "text": "11.22-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.15"
              },
              "items": [
                {
                  "text": "Ibyah 1.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze mbona ubwiza bw'Imana ya Isirayeli buje buturuka mu nzira y'iburasirazuba, ijwi ryayo rimeze nko guhorera kw'amazi menshi, maze isi imurikirwa n'ubwiza bwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwari bumeze nk'ibyo neretswe nabonye, igihe nazanwaga no kurimbura umurwa. Ibyo neretswe byari bimeze nk'icyo neretswe nabonye ku mugezi wa Kebari, maze ngwa nubamye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ubwiza bw'Uwiteka bwinjira mu rusengero, buturutse mu nzira iri ku irembo ry'aherekeye iburasirazuba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka aranterura anjyana mu rugo rw'imbere, ndebye mbona ubwiza bw'Uwiteka bwuzuye urusengero. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze numva uvugana nanjye ari mu rusengero, nuko umuntu ampagarara iruhande. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambwira ati “Mwana w'umuntu, aha hantu ni ah'intebe y'ubwami yanjye, ni n'ahantu h'ubworo bw'ibirenge byanjye, ni ho nzaba iteka ryose mbe hagati y'Abisirayeli. Kandi ab'inzu ya Isirayeli ntibazongera kwanduza izina ryanjye ukundi, ari bo cyangwa abami babo, ngo baryandurishe ubusambanyi bwabo cyangwa intumbi z'abami babo bari mu ngoro zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bashyize inkomanizo zabo hamwe n'inkomanizo zanjye, n'inkingi zabo hamwe n'inkingi zanjye hagati yanjye na bo hakaba urusika gusa, bakandurisha izina ryanjye ryera ibizira byabo, ibyo bakoraga, ni cyo cyatumye mbarimbura ndakaye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneho nibamvane imbere ubusambanyi bwabo n'intumbi z'abami babo babite kure, mbone kuba muri bo iteka ryose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko rero mwana w'umuntu, ereka ab'inzu ya Isirayeli uru rusengero kugira ngo bakozwe isoni n'ibicumuro byabo, barugere bakurikije igishushanyo cyarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakozwe isoni n'ibyo bakoze byose, ubamenyeshe uko urusengero rusa n'uko ruringanijwe, n'ahasohokerwa harwo n'ahinjirirwa harwo, n'imigabane yarwo yose n'ingero zarwo zose, n'amateka yarwo yose n'amategeko yarwo yose, ubyandike imbere yabo kugira ngo bajye bibuka uko rusa kose n'amateka yarwo yose ngo babone kubikurikiza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo tegeko ry'urusengero: mu mpinga y'umusozi aho ingabano zarwo zose ziyikikije zigarukira ni ahera cyane. Dore iryo ni ryo tegeko ry'urusengero.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
