          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iruhande rw'ibikingi by'amarembo hari akumba gafite umuryango, aho ni ho buhagiriraga ibitambo byoswa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.38",
            "verseOrgIds": [
