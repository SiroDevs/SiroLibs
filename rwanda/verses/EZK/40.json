          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze anjyana ku irembo ry'aherekeye ikasikazi, arigera nk'uko izo ngero zari ziri, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
              "EZK.40.35"
            ]
          }
        },
        {
