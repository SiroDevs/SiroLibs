          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze anjyana mu rugo rw'imbere aherekeye iburasirazuba, nuko agera irembo nk'uko izo ngero zari ziri, ",
          "type": "text",
          "attrs": {
