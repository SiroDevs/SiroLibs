            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.22"
              },
              "items": [
                {
                  "text": "Ef 5.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.18"
              },
              "items": [
                {
                  "text": "Kolo 3.18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namwe bagore ni uko mugandukire abagabo banyu, kugira ngo nubwo abagabo bamwe batumvira ijambo ry'Imana bareshywe n'ingeso nziza z'abagore babo, nubwo baba ari nta jambo bavuze ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.1",
            "verseOrgIds": [
              "1PE.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "babonye ingeso zanyu zitunganye zifatanije no kūbaha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.2",
            "verseOrgIds": [
              "1PE.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tim 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Umurimbo wanyu we kuba uw'inyuma, uwo kuboha umusatsi cyangwa uwo kwambara izahabu cyangwa uwo gukānisha imyenda, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo ube uw'imbere uhishwe mu mutima, umurimbo utangirika w'umwuka ufite ubugwaneza n'amahoro ari wo w'igiciro cyinshi mu maso y'Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore bera ba kera biringiraga Imana, ni ko birimbishaga bagandukira abagabo babo, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Itang 18.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " nk'uko Sara yumviraga Aburahamu akamwita umutware we. Namwe muri abana b'uwo, niba mukora neza ntimugire ubwoba bubahamura.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.25"
              },
              "items": [
                {
                  "text": "Ef 5.25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.19"
              },
              "items": [
                {
                  "text": "Kolo 3.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namwe bagabo ni uko; mubane n'abagore banyu, mwerekane ubwenge mu byo mubagirira kuko bameze nk'inzabya zidahwanije namwe gukomera, kandi mubūbahe nk'abaraganwa namwe ubuntu bw'ubugingo, kugira ngo amasengesho yanyu ye kugira inkomyi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urukundo rwa kivandimwe no kwihanganira akarengane",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.7",
            "verseOrgIds": [
              "1PE.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye, mwese muhuze imitima, mubabarane kandi mukundane nk'abavandimwe, mugirirane imbabazi mwicisha bugufi mu mitima. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukiture umuntu inabi yabagiriye cyangwa igitutsi yabatutse, ahubwo mumwiture kumusabira umugisha kuko ari byo mwahamagariwe, kugira ngo namwe muragwe umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.13+PSA.34.14+PSA.34.15+PSA.34.16+PSA.34.17"
              },
              "items": [
                {
                  "text": "Zab 34.13-17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko byanditswe ngo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.12",
            "verseOrgIds": [
              "1PE.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ni nde uzabagirira nabi nimugira ishyaka ry'ibyiza? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.10"
              },
              "items": [
                {
                  "text": "Mat 5.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12+ISA.8.13"
              },
              "items": [
                {
                  "text": "Yes 8.12-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Icyakora, nubwo mwababazwa babahōra gukiranuka, mwaba muhiriwe. Ntimugatinye ibyo babatinyisha kandi ntimugahagarike imitima, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo mwubahe Kristo mu mitima yanyu ko ari we Mwami, kandi mube mwiteguye iteka gusubiza umuntu wese ubabajije impamvu z'ibyiringiro mufite, ariko mufite ubugwaneza, mwubaha ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mufite imitima itabacira urubanza, kugira ngo nubwo",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "nubwo:",
              "type": "text"
            },
            {
              "text": "cyangwa, no ku byo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " babasebya batuka ingeso zanyu nziza zo muri Kristo bamware. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyiza ni uko mwababazwa babahōra gukora ibyiza niba ari byo Imana ishaka, kuruta ko mwababazwa babahōra gukora ibibi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.17",
            "verseOrgIds": [
              "1PE.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko na Kristo yababarijwe ibyaha by'abantu rimwe, umukiranutsi ababarizwa abakiranirwa kugira ngo atuyobore ku Mana amaze kwicwa mu buryo bw'umubiri, ariko ahinduwe muzima mu buryo bw'umwuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.18",
            "verseOrgIds": [
              "1PE.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wo yabwiririshije imyuka yo mu nzu y'imbohe, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.19",
            "verseOrgIds": [
              "1PE.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Itang 6.1—7.24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ya yindi itumviraga Imana kera, ubwo kwihangana kwayo kwategerezaga mu minsi ya Nowa inkuge ikibāzwa. Muri yo bake bararokotse ndetse ni umunani, bakijijwe n'amazi.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "bakijijwe n'amazi:",
              "type": "text"
            },
            {
              "text": "cyangwa, bakirijwe mu mazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.20",
            "verseOrgIds": [
              "1PE.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na n'ubu amazi ni yo akibakiza namwe mu buryo bw'igishushanyo cyo kubatizwa, icyakora si uko akuraho ico ryo ku mubiri, ahubwo ni isezerano ku Mana ry'umutima uticīra urubanza, ribakirisha kuzuka kwa Yesu Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.21",
            "verseOrgIds": [
              "1PE.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "uri iburyo bw'Imana, kuko yagiye mu ijuru amaze guhabwa gutwara abamarayika n'abafite ubutware n'imbaraga.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.22",
            "verseOrgIds": [
              "1PE.3.22"
            ]
          }
        }
      ]
    }
  ],
