              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabazamura abajyana iwe arabagaburira, yishimana cyane n'abo mu rugo rwe bose kuko yizeye Imana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
