          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamubwira ijambo ry'Umwami Yesu n'abo mu rugo rwe bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
