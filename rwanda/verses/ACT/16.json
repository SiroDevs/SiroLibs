              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Izere Umwami Yesu, urakira ubwawe n'abo mu rugo rwawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
