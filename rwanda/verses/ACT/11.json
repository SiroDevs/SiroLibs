              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abigishwa bagambirira koherereza bene Data batuye i Yudaya imfashanyo, umuntu wese akurikije ubutunzi bwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.29",
