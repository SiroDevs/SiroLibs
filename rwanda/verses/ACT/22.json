            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutware w'ingabo araza aramubaza ati “Mbwira, mbese uri Umuroma koko?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
