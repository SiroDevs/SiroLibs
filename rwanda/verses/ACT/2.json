              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iminsi yose bakomezaga kujya mu rusengero n'umutima uhuye, n'iwabo bakamanyagura umutsima bakarya bishimye, bafite imitima itishāma ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.46",
            "verseOrgIds": [
              "ACT.2.46"
            ]
          }
        },
        {
