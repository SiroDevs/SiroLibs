              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bagira ubwoba, nuko intumwa zikora ibitangaza n'ibimenyetso byinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.43",
            "verseOrgIds": [
