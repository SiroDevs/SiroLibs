                  "text": "Ibyak 4.32-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abizeye bose babaga hamwe bagasangira ibyabo byose, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.44",
            "verseOrgIds": [
              "ACT.2.44"
            ]
          }
        },
