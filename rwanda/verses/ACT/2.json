          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero arabasubiza ati “Nimwihane, umuntu wese muri mwe abatizwe mu izina rya Yesu Kristo ngo mubone kubabarirwa ibyaha byanyu, kandi namwe muzahabwa iyi mpano y'Umwuka Wera, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.38",
            "verseOrgIds": [
              "ACT.2.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 2:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko isezerano ari iryanyu n'abana banyu n'abari kure bose, abazahamagarwa n'Umwami Imana yacu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.39",
            "verseOrgIds": [
              "ACT.2.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
