          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu bumvise ibyo bibacumita mu mitima, nuko babaza Petero n'izindi ntumwa bati “Bagabo bene Data, mbese tugire dute?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.37",
            "verseOrgIds": [
              "ACT.2.37"
            ]
          }
        }
      ]
