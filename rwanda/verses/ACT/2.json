          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "bahimbaza Imana, bashimwa n'abantu bose, kandi uko bukeye Umwami Imana ikabongerera abakizwa.",
          "type": "text",
