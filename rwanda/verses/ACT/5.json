              "ACT.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwumvira, nuko bahamagara intumwa barazikubita, bazibuza kwigisha mu izina rya Yesu maze barazirekura. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.40",
            "verseOrgIds": [
              "ACT.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziva imbere y'abanyarukiko zinejejwe n'uko zemerewe gukorwa n'isoni bazihora iryo zina. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.41",
            "verseOrgIds": [
              "ACT.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntizasiba kwigisha no kuvuga ubutumwa bwiza bwa Yesu Kristo iminsi yose mu rusengero n'iwabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.42",
            "verseOrgIds": [
              "ACT.5.42"
            ]
          }
        }
      ]
