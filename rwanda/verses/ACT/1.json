        },
        {
          "text": "abe intumwa, ahabwe uyu murimo Yuda yataye akajya ahe.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
