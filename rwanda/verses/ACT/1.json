              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Tewofilo we:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
            "verseOrgIds": [
              "ACT.1.1"
            ]
          }
        }
      ]
