        },
        {
          "text": "Bahitamo babiri, umwe ni Yosefu witwaga Barisaba, uwo bahimbye Yusito, undi ni Matiyasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
