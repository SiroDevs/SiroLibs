          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barasenga bati “Mwami Mana, umenya imitima y'abantu bose, werekane uwo utoranije muri aba bombi ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
