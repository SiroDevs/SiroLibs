                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pawulo ati “Bene Data, sinari nzi ko ari we mutambyi mukuru, kuko byanditswe ngo ‘Ntukavuge nabi umutware w'ubwoko bwawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
