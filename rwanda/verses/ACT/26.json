              "ACT.26.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.1+ACT.9.2+ACT.9.3+ACT.9.4+ACT.9.5+ACT.9.6+ACT.9.7+ACT.9.8+ACT.9.9+ACT.9.10+ACT.9.11+ACT.9.12+ACT.9.13+ACT.9.14+ACT.9.15+ACT.9.16+ACT.9.17+ACT.9.18+ACT.9.19"
              },
              "items": [
                {
                  "text": "Ibyak 9.1-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.6+ACT.22.7+ACT.22.8+ACT.22.9+ACT.22.10+ACT.22.11+ACT.22.12+ACT.22.13+ACT.22.14+ACT.22.15+ACT.22.16"
              },
              "items": [
                {
                  "text": "22.6-16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Ngikora ibyo, njya i Damasiko mpawe ubutware ntegetswe n'abatambyi bakuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.12",
            "verseOrgIds": [
              "ACT.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkigenda ku manywa y'ihangu, Mwami, mbona umucyo uvuye mu ijuru urusha uw'izuba, unsangana n'abo tugendana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.13",
            "verseOrgIds": [
              "ACT.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twese twikubita hasi, numva ijwi rimbwira mu Ruheburayo riti ‘Sawuli, Sawuli, undenganiriza iki? Biragukomereye gutera imigeri ku mihunda.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.14",
            "verseOrgIds": [
              "ACT.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanjye ndabaza nti ‘Uri nde, Mwami?’ Umwami aransubiza ati ‘Ndi Yesu uwo urenganya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.15",
            "verseOrgIds": [
              "ACT.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko haguruka uhagarare, kuko igitumye nkubonekera ari ukugira ngo ngutoranye nkugire umukozi wanjye, n'umugabo wo guhamya ibyo ubonye n'ibyo nzakubonekerana, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngukize ab'ubwoko bwanyu n'abanyamahanga ari bo ngutumyeho, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo ubahumure amaso na bo bahindukire bave mu mwijima bajye mu mucyo, bave no mu butware bwa Satani bajye ku Mana, bahereko bababarirwe ibyaha byabo baraganwe n'abejejwe no kunyizera.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.18",
            "verseOrgIds": [
              "ACT.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwami Agiripa, mperako sinanga kumvira ibyo neretswe byavuye mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.19",
            "verseOrgIds": [
              "ACT.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.20"
              },
              "items": [
                {
                  "text": "Ibyak 9.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.28+ACT.9.29"
              },
              "items": [
                {
                  "text": "28-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ahubwo mbanza ab'i Damasiko, maze mbwira ab'i Yerusalemu n'abo mu gihugu cyose cy'i Yudaya n'abanyamahanga, mbabwiriza kwihana no guhindukirira Imana bakora imirimo ikwiriye abihannye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye Abayuda bamfatira mu rusengero, bakagerageza kunyica. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mbona gutabarwa kwavuye ku Mana, na n'ubu ndacyariho mpamiriza aboroheje n'abakomeye. Icyakora nta cyo mvuga keretse ibyo abahanuzi na Mose bavuze ko bizaba ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.6"
              },
              "items": [
                {
                  "text": "Yes 42.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
