            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.18",
            "verseOrgIds": [
              "ACT.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni cyo gitumye ku bwanjye ntegeka ko tureka kurushya abo mu banyamahanga bahindukirira Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.19",
            "verseOrgIds": [
              "ACT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.15+EXO.34.16+EXO.34.17"
              },
              "items": [
                {
                  "text": "Kuva 34.15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.10+LEV.17.11+LEV.17.12+LEV.17.13+LEV.17.14+LEV.17.15+LEV.17.16"
              },
              "items": [
                {
                  "text": "Lewi 17.10-16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.6+LEV.18.7+LEV.18.8+LEV.18.9+LEV.18.10+LEV.18.11+LEV.18.12+LEV.18.13+LEV.18.14+LEV.18.15+LEV.18.16+LEV.18.17+LEV.18.18+LEV.18.19+LEV.18.20+LEV.18.21+LEV.18.22+LEV.18.23"
              },
              "items": [
                {
                  "text": "18.6-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ahubwo tubandikire ngo bareke ibihumanya by'ibishushanyo bisengwa, no gusambana, n'ibinizwe, n'amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.20",
            "verseOrgIds": [
              "ACT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uhereye kera kose Mose afite mu midugudu yose ababwiriza ibye, bisomerwa mu masinagogi ku masabato yose.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urwandiko Itorero ryandikiye abanyamahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze intumwa n'abakuru hamwe n'ab'Itorero bose bashima gutoranya abagabo muri bo: ni Yuda witwaga Barisaba na Sila, abantu bakomeye muri bene Data ngo babatumane na Pawulo na Barinaba muri Antiyokiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bandika urwandiko bararubaha, rwanditsemo ngo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Intumwa na bene Data bakuru turabatashya, bene Data bo mu banyamahanga bari muri Antiyokiya n'i Siriya n'i Kilikiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko twumvise yuko abantu bavuye muri twe bababwiye amagambo yo guhagarika imitima yanyu, no kuyitera gushidikanya kandi tutabibategetse, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "twashimye guhuza inama yo gutoranya aba bagabo no kubabatumanaho, n'abo dukunda Barinaba na Pawulo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu bahaze amagara yabo ku bw'izina ry'Umwami wacu Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko dutumye Yuda na Sila, na bo ubwabo bazababwira n'ururimi bimwe n'ibi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwuka Wera hamwe natwe, twashimye kutabīkoreza undi mutwaro wose keretse ibi bikwiriye: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kwirinda inyama zaterekerejwe ibishushanyo bisengwa, n'amaraso, n'ibinizwe, no gusambana. Ibyo nimubyirinda muzaba mukoze neza. Nuko murabeho.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bajyana urwandiko muri Antiyokiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bamaze gusezererwa baramanuka bajya muri Antiyokiya, bateranya Itorero babaha urwandiko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barusomye bishimira uko guhugurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda na Sila kuko na bo bari abahanuzi, bahugūza bene Data amagambo menshi barabakomeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze iminsi bene Data babasezerera amahoro, ngo basubire ku babatumye. [ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Sila we ashima gusigarayo.] ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo na Barinaba na bo baguma muri Antiyokiya, bigisha abantu bababwira ijambo ry'Umwami Yesu, bafatanyije n'abandi benshi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Urugendo rwa kabiri rwa Pawulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize iminsi Pawulo abwira Barinaba ati “Dusubire tugenderere bene Data bo mu midugudu yose, aho twavuze ijambo ry'Umwami Yesu tumenye uko bameze.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barinaba ashaka kujyana na Yohana witwaga Mariko, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.13"
              },
              "items": [
                {
                  "text": "Ibyak 13.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ariko Pawulo ntiyashima kumujyana, kuko yabahanye i Pamfiliya ntajyane na bo mu murimo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bagira intonganya nyinshi bituma batandukana, Barinaba ajyana Mariko atsukiraho, arambuka afata i Kupuro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo na we atoranya Sila, avayo bene Data bamaze kumuragiza ubuntu bw'Umwami Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyura i Siriya n'i Kilikiya, akomeza amatorero.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
