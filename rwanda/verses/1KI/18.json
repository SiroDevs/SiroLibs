              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.39",
            "verseOrgIds": [
              "1KI.18.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Eliya arababwira ati “Nimufate abahanuzi ba Bāli, ntihasimbuke n'umwe.” Barabafata. Eliya arabamanukana abagejeje ku kagezi Kishoni, abicirayo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 18:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.40",
            "verseOrgIds": [
              "1KI.18.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 18:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Eliya abwira Ahabu ati “Haguruka ufungure kuko numva haza kugwa imvura y'impangukano.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.18.41",
            "verseOrgIds": [
              "1KI.18.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
