              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo yarushaga abami bo mu isi bose ubutunzi n'ubwenge. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.23",
            "verseOrgIds": [
              "1KI.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo mu isi bose bashakaga kureba Salomo, ngo bumve ubwenge bwe Imana yashyize mu mutima we. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.24",
            "verseOrgIds": [
              "1KI.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwazaga wese yazanaga ituro rye, ari ibintu by'ifeza cyangwa iby'izahabu, n'imyambaro n'intwaro zo kurwanisha, n'imibavu n'amafarashi n'inyumbu. Ni ko byagendaga uko umwaka utashye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.25",
            "verseOrgIds": [
              "1KI.10.25"
            ]
          }
        }
      ]
    },
