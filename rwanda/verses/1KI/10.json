                  "text": "1 Abami 5.6",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi Salomo yateranije amagare n'abagendera ku mafarashi. Yari afite amagare igihumbi na magana ane n'abagendera ku mafarashi inzovu imwe n'ibihumbi bibiri, abashyira mu midugudu icyurwamo amagare n'i Yerusalemu mu murwa w'umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami atuma i Yerusalemu hagira ifeza ingana n'amabuye ubwinshi, n'ibiti by'imyerezi atuma binganya n'imivumu yo mu bibaya ubwinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Guteg 17.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi amafarashi Salomo yatungaga bayakuraga muri Egiputa. Abatunzi b'umwami bayaguraga ari amashyo, ishyo ryose riciriwe igiciro cyaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku igare rimwe ryazamukaga rivuye muri Egiputa, batangaga shekeli z'ifeza magana atandatu, ku ifarashi batangaga ijana na mirongo itanu. Kandi uko abatunzi babizanaga, bimwe abami bose b'Abaheti n'ab'Abasiriya barabiguraga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
      ]
