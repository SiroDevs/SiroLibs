            "verseId": "1KI.12.15",
            "verseOrgIds": [
              "1KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 12:16"
          },
          "items": [
