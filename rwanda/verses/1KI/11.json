            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.9.29+2CH.9.30+2CH.9.31"
              },
              "items": [
                {
                  "text": "2 Ngoma 9.29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Indi mirimo ya Salomo n'ibyo yakoze byose n'iby'ubwenge bwe, mbese ntibyanditswe mu gitabo cy'ibyakozwe na Salomo? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.41",
            "verseOrgIds": [
              "1KI.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko igihe cyose Salomo yamaze i Yerusalemu ategeka Abisirayeli bose, cyari imyaka mirongo ine. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.42",
            "verseOrgIds": [
              "1KI.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo aratanga asanga ba sekuruza, bamuhamba mu mudugudu wa se Dawidi, maze umuhungu we Rehobowamu yima ingoma ye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.11.43",
            "verseOrgIds": [
              "1KI.11.43"
            ]
          }
        }
      ]
    }
