          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.9",
            "verseOrgIds": [
              "ZEC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaza marayika twavuganaga nti “Iriya ndengo barayijyana he?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.10",
            "verseOrgIds": [
              "ZEC.5.10"
            ]
          }
        }
