          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aransubiza ati “Bagiye kubakira uwo mugore inzu mu gihugu cy'i Shinari, niyuzura azashyirwa ukwe muri icyo gihugu.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.5.11",
