          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry'Uwiteka ryongera kunzaho riti ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.8",
            "verseOrgIds": [
              "ZEC.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Amaboko ya Zerubabeli ni yo yashyizeho urufatiro rw'iyi nzu, kandi amaboko ye ni yo azayuzuza, maze muzamenye yuko Uwiteka Nyiringabo ari we wabantumyeho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.9",
            "verseOrgIds": [
              "ZEC.4.9"
            ]
          }
        }
      ]
    },
