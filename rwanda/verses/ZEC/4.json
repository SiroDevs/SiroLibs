          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nongera kumubaza ubwa kabiri nti “Ariya mashami y'imyelayo abiri, ari impande zombi z'imibirikira y'izahabu uko ari ibiri, akīkamuramo amavuta asa n'izahabu asobanurwa ate?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.12",
            "verseOrgIds": [
              "ZEC.4.12"
            ]
          }
        }
