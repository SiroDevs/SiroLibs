              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyatumye avuga atyo ni ukwerekana urupfu azubahisha Imana. Amaze kuvuga atyo aramubwira ati “Nkurikira.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.19",
