          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramusubiza ati “Niba nshaka ko agumaho kugeza aho nzazira, upfa iki? Nkurikira.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
