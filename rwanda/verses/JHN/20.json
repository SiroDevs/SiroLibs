          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuzuka kwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku wa mbere w'iminsi irindwi, mu rubungabungo hatarabona Mariya Magadalena aza ku gituro, asanga igitare gikuwe ku gituro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.1",
            "verseOrgIds": [
              "JHN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arirukanka asanga Simoni Petero na wa mwigishwa wundi Yesu yakundaga arababwira ati “Bakuye Umwami Yesu mu gituro, kandi ntituzi aho bamushyize.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero asohokana na wa mwigishwa wundi bajya ku gituro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.3",
            "verseOrgIds": [
              "JHN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bombi birukira icyarimwe, ariko uwo mwigishwa asiga Petero aba ari we ubanza kugera ku gituro. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.4",
            "verseOrgIds": [
              "JHN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arunama arungurukamo, abona imyenda y'ibitare ishyizwe hasi ariko ntiyinjiramo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.5",
            "verseOrgIds": [
              "JHN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Simoni Petero na we aza amukurikiye, yinjira mu gituro abona imyenda y'ibitare ishyizwe hasi, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.6",
            "verseOrgIds": [
              "JHN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'igitambaro cyari mu mutwe we kidashyizwe hamwe n'imyenda y'ibitare, ahubwo cyari kizinze kiri ukwacyo hirya. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.7",
            "verseOrgIds": [
              "JHN.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye na wa mwigishwa wundi wabanje kugera ku gituro na we yinjira. Abibonye yizera ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bari bataramenya ibyanditswe ko akwiriye kuzuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.9",
            "verseOrgIds": [
              "JHN.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abigishwa basubirayo bajya iwabo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yiyereka Mariya Magadalena",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Mariya yari ahagaze ku gituro arira. Akirira arunama arunguruka mu gituro, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.11",
            "verseOrgIds": [
              "JHN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abona abamarayika babiri bambaye imyenda yera bicaye, umwe ku musego n'undi ku mirambizo, aho intumbi ya Yesu yari yarashyizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.12",
            "verseOrgIds": [
              "JHN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramubaza bati “Mugore, urarizwa n'iki?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Ni uko bakuyemo Umwami wanjye, nanjye sinzi aho bamushyize.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvuga atyo arakebuka, abona Yesu ahagaze ariko ntiyamenya ko ari we. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.14",
            "verseOrgIds": [
              "JHN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubaza ati “Mugore, urarizwa n'iki? Urashaka nde?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yibwira ko ari umurinzi w'agashyamba aramubwira ati “Mutware, niba ari wowe umujyanye ahandi, mbwira aho umushyize nanjye mukureyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubwira ati “Mariya.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arahindukira amwitaba mu Ruheburayo ati “Rabuni” (risobanurwa ngo “Databuja.”)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubwira ati “Ntunkoreho kuko ntarazamuka ngo njye kwa Data, ahubwo jya kubwira bene Data yuko nzamutse ngiye kwa Data ari we So, kandi ku Mana yanjye ari yo Mana yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariya Magadalena aragenda, abarira abigishwa inkuru ati “Nabonye Umwami”, kandi abatekerereza ibyo yamubwiye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yiyereka abigishwa be Toma adahari",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko kuri uwo munsi bugorobye, ari wo wa mbere w'iminsi irindwi, abigishwa bari bateraniye mu nzu, inzugi zikinze kuko batinyaga Abayuda. Yesu araza ahagarara hagati yabo arababwira ati “Amahoro abe muri mwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.19",
            "verseOrgIds": [
              "JHN.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvuga atyo abereka ibiganza bye n'urubavu rwe. Abigishwa babonye Umwami baranezerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.20",
            "verseOrgIds": [
              "JHN.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yongera kubabwira ati “Amahoro abe muri mwe. Uko Data yantumye ni ko nanjye mbatumye.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.21",
            "verseOrgIds": [
              "JHN.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvuga atyo abahumekeraho ati “Nimwakire Umwuka Wera. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
              "JHN.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
