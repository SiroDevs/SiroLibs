              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko azuwe abigishwa be bibuka ko yabivuze, bemera ibyanditswe na rya jambo Yesu yari yaravuze.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
