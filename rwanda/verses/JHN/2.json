                  "text": "Zab 69.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abigishwa be bibuka uko byanditswe ngo “Ishyaka ry'inzu yawe rirandya.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
