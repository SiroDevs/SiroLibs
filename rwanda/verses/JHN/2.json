          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati “Nimukureho bino, mureke guhindura inzu ya Data iguriro.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
