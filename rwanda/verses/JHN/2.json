              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pasika y'Abayuda yenda gusohora, Yesu ajya i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ageze mu rusengero asangamo abahatundira inka n'intama n'inuma, n'abandi bicaye bavunja ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abohekanya imigozi ayigira nk'ikiboko, bose abirukana n'intama n'inka mu rusengero, amena ifeza z'abaguraga inuma ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
