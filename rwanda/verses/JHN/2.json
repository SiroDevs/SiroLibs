          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo ni cyo kimenyetso cya mbere Yesu yakoreye i Kana y'i Galilaya, yerekana icyubahiro cye, abigishwa be baramwizera.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
      ]
    },
