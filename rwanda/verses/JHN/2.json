            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hanyuma y'ibyo aramanuka ajya i Kaperinawumu, ari kumwe na nyina na bene se n'abigishwa be, ariko ntibamarayo iminsi myinshi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
