          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabasubiza ati “None murizeye? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.31",
            "verseOrgIds": [
              "JHN.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore igihe kirenda gusohora ndetse kirasohoye, ubwo muri butatane umuntu wese ukwe, mukansiga jyenyine. Ariko sindi jyenyine, kuko Data ari kumwe nanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.32",
            "verseOrgIds": [
              "JHN.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo mbibabwiriye kugira ngo mugire amahoro muri jye. Mu isi mugira umubabaro, ariko nimuhumure nanesheje isi.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.33",
            "verseOrgIds": [
              "JHN.16.33"
            ]
          }
        }
