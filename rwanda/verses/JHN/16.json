              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa baravuga bati “Dore noneho ureruye, nta mugani uduciriye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
            "verseOrgIds": [
              "JHN.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu tuzi yuko uzi byose kandi ko utagomba ko umuntu wese agira icyo akubaza, ni cyo gituma twizera ko wavuye ku Mana.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
              "JHN.16.30"
            ]
          }
        }
