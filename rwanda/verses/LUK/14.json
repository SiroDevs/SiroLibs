            }
          ]
        },
        {
          "text": "Abantu benshi bajyanaga na we, arahindukira arababwira ati ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
