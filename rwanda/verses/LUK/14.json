              "items": [
                {
                  "text": "Luka 9.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Utikorera umusaraba we ngo ankurikire, ntashobora kuba umwigishwa wanjye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
