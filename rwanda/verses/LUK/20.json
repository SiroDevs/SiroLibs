      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ababwira kwirinda abanditsi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
