              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abasadukayo bamwe bahakanaga yuko ari nta wuzuka, baza aho ari baramubaza bati ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
            "verseOrgIds": [
              "LUK.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Guteg 25.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Mwigisha, Mose yatwandikiye yuko mwene se w'umuntu napfa afite umugore batarabyarana, mwene se azahungure uwo mugore acikure mwene se. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.28",
            "verseOrgIds": [
              "LUK.20.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko habayeho abavandimwe barindwi: uwa mbere arongora umugeni apfa batarabyarana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.29",
            "verseOrgIds": [
              "LUK.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'uwa kabiri ni uko, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.30",
            "verseOrgIds": [
              "LUK.20.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'uwa gatatu aramuhungura, nuko bose uko ari barindwi bapfa batyo badasize abana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.31",
            "verseOrgIds": [
              "LUK.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma wa mugore na we arapfa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.32",
            "verseOrgIds": [
              "LUK.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "None se mu izuka azaba ari muka nde muri bose, ko bose uko ari barindwi bamugize umugore?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.33",
            "verseOrgIds": [
              "LUK.20.33"
            ]
          }
        }
      ]
    },
    {
