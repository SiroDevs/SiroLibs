          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ayo magambo ashubirije imbere y'abantu ntibashobora kubona ijambo na rimwe ryatuma bamurega, batangarira ibyo abashubije baraceceka.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.26",
            "verseOrgIds": [
              "LUK.20.26"
            ]
          }
        }
