              "type": "text"
            }
          ]
        },
        {
          "text": "Arababwira ati “Nuko rero ibya Kayisari mubihe Kayisari, iby'Imana mubihe Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.25",
            "verseOrgIds": [
