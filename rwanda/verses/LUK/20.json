                  "text": "Zab 118.22",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arabitegereza arababwira ati “None se ibi byanditswe ni ibiki ngo",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.17",
            "verseOrgIds": [
              "LUK.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abafarisayo bamugerageresha iby'umusoro",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.18",
            "verseOrgIds": [
              "LUK.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya abanditsi n'abatambyi bakuru bashaka kumufata, kuko bamenye yuko ari bo yaciriyeho uwo mugani, ariko batinya rubanda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramugenza, batuma abatasi bigize nk'abakiranutsi ngo bakūre impamvu mu byo avuga, bahereko babone uko bamushyīra Umutegeka, na we amucire urubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.20",
            "verseOrgIds": [
              "LUK.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramubaza bati “Mwigisha, tuzi yuko uvuga neza, kandi ukigisha ibitunganye ntiwite ku cyubahiro cy'abantu, ahubwo wigisha inzira y'Imana by'ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.21",
            "verseOrgIds": [
              "LUK.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese amategeko yemera ko duha Kayisari umusoro, cyangwa ntiyemera?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.22",
            "verseOrgIds": [
              "LUK.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko amenye uburiganya bwabo arababwira ati ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nimunyereke idenariyo.” Ati “Ishusho n'izina biyiriho ni ibya nde?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.24",
            "verseOrgIds": [
              "LUK.20.24"
            ]
          }
        }
