              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza ati “Bavuga bate yuko Kristo ari mwene Dawidi, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.41",
            "verseOrgIds": [
              "LUK.20.41"
            ]
          }
        },
        {
