              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabasubiza ati “Abana b'iyi si bararongora, bagashyingirwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.34",
            "verseOrgIds": [
              "LUK.20.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko abemerewe kuzagera muri ya si yindi, bakaba bakwiriye no kugera ku kuzuka mu bapfuye, ntibazarongora kandi ntibazashyingirwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.35",
            "verseOrgIds": [
              "LUK.20.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntibazaba bagishobora gupfa kuko bazamera nk'abamarayika, bakaba ari abana b'Imana kuko ari abana b'umuzuko. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.36",
            "verseOrgIds": [
              "LUK.20.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "Kuva 3.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko ibyemeza yuko abapfuye bazuka, Mose na we yabigaragarije ku byabereye kuri cya Gihuru, ubwo yitaga Uwiteka Imana ya Aburahamu n'Imana ya Isaka n'Imana ya Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero Imana si Imana y'abapfuye, ahubwo ni iy'abazima kuko bose kuri yo ari bazima.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        }
      ]
    },
