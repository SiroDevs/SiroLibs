          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwene Matati, mwene Lewi, mwene Meluki, mwene Yanayi, mwene Yosefu; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.24",
