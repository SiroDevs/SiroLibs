            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.29"
              },
              "items": [
                {
                  "text": "Luka 7.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " N'abakoresha b'ikoro na bo baje ngo babatizwe baramubaza bati “Mwigisha, tugire dute?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.12",
            "verseOrgIds": [
              "LUK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Ntimukake abantu ibiruta ibyo mwategetswe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.13",
            "verseOrgIds": [
              "LUK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abasirikare na bo baramubaza bati “Natwe tugire dute?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Ntimukagire umuntu muhongesha cyangwa ngo mumurege ibinyoma, kandi ibihembo byanyu bibanyure.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yohana abwira abantu ibya Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.14",
            "verseOrgIds": [
              "LUK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abo bantu bagira amatsiko, bose bibwira yuko ahari none Yohana yaba ari we Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.15",
            "verseOrgIds": [
              "LUK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yohana abasubiza bose ati “Ni koko jyeweho ndababatirisha amazi ariko hazaza undusha ubushobozi, ndetse ntibikwiriye ko napfundura udushumi tw'inkweto ze. Uwo ni we uzababatirisha Umwuka Wera n'umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.16",
            "verseOrgIds": [
              "LUK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intara ye iri mu kuboko kwe, kandi azeza imbuga ye cyane, amasaka ayahunike mu kigega cye naho umurama azawucanisha umuriro utazima.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.17",
            "verseOrgIds": [
              "LUK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akomeza kubwiriza abantu ubutumwa bwiza, kandi abahuguza byinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.18",
            "verseOrgIds": [
              "LUK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.3+MAT.14.4"
              },
              "items": [
                {
                  "text": "Mat 14.3-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.17+MRK.6.18"
              },
              "items": [
                {
                  "text": "Mar 6.17-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko muri icyo gihe, Umwami Herode acyashywe na Yohana ku bwa Herodiya muka mwene se, no ku bw'ibindi bibi yari yarakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.19",
            "verseOrgIds": [
              "LUK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuri ibyo byose yongeraho iki: afata Yohana amushyira mu nzu y'imbohe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.3.20",
            "verseOrgIds": [
              "LUK.3.20"
            ]
          }
        }
      ]
