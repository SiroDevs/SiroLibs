                "loc": "LUK.1.31"
              },
              "items": [
                {
                  "text": "Luka 1.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko iminsi munani ishize arakebwa bamwita Yesu, rya zina ryari ryaravuzwe na marayika, nyina atarasama inda ye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
            "verseOrgIds": [
              "LUK.2.21"
            ]
