              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.2"
              },
              "items": [
                {
                  "text": "Kuva 12.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " (nk'uko byanditswe mu mategeko y'Umwami ngo “Umuhungu wese w'uburiza azitwa uwera ku Uwiteka”), ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "batamba n'igitambo nk'uko byavuzwe mu mategeko y'Umwami ngo “Intungura ebyiri cyangwa ibyana by'inuma bibiri.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        }
      ]
    },
    {
