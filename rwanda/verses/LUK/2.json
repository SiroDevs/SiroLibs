          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amanukana na bo ajya i Nazareti, agahora abumvira. Ibyo byose nyina abibika mu mutima we. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
