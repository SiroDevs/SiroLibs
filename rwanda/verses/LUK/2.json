            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iminsi yo kwezwa kwabo ishize, bakurikije amategeko ya Mose, bamujyana i Yerusalemu ngo bamumurikire Umwami Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
