          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Mwanshakiraga iki? Ntimuzi yuko binkwiriye kuba mu rugo rwa Data?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibasobanukirwa n'iryo jambo ababwiye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        }
      ]
    },
