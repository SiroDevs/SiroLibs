            }
          ]
        },
        {
          "text": "Nuko uwo mwana arakura, agwiza imbaraga, yuzuzwa ubwenge kandi ubuntu bw'Imana bwari muri we.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
