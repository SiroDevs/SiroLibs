          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yihererana n'abo cumi na babiri arababwira ati “Dore turazamuka tujye i Yerusalemu, kandi ibyanditswe n'abahanuzi byose bizasohora ku Mwana w'umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.31",
            "verseOrgIds": [
              "LUK.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azagambanirwa mu bapagani, azashinyagurirwa, bazamukoza isoni bamucire amacandwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.32",
            "verseOrgIds": [
              "LUK.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nibamara kumukubita imikoba bazamwica, maze ku munsi wa gatatu azazuka.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.33",
            "verseOrgIds": [
              "LUK.18.33"
            ]
          }
        }
