          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababwira ati “Ndababwira ukuri yuko ari nta muntu wasize inzu ye cyangwa umugore, cyangwa bene se cyangwa ababyeyi cyangwa abana ku bw'ubwami bw'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.18.29",
            "verseOrgIds": [
              "LUK.18.29"
            ]
          }
        },
