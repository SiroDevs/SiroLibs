            "sid": "GEN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.7",
            "verseOrgIds": [
              "GEN.4.7"
            ]
          }
        },
        {
