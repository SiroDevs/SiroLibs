          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uwiteka Imana ibwira uwo mugore iti “Kugwiza nzagwiza cyane umubabaro wawe ufite inda: uzajya ubyara abana ubabara, kwifuza kwawe kuzaherēra ku mugabo wawe, na we azagutwara.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.16",
            "verseOrgIds": [
              "GEN.3.16"
            ]
          }
        }
      ]
    },
