                  "text": "1 Tim 2.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka Imana ibaza uwo mugore iti “Icyo wakoze icyo ni iki?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
