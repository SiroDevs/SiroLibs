        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabo yita umugore we Eva,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Eva",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Ufite ubugingo. Mu Ruheburayo ni Hawa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko ari we nyina w'abafite ubugingo bose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Imana iremera Adamu n'umugore we imyambaro y'impu, irayibambika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana ikūra Adamu muri Edeni",
          "type": "text"
        }
      ]
    },
