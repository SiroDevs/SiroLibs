                {
                  "text": "Ibyah 22.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwiteka Imana iravuga iti “Dore uyu muntu ahindutse nk'imwe yo muri twe ku byo kumenya icyiza n'ikibi, noneho atarambura ukuboko agasoroma no ku giti cy'ubugingo, akarya akarama iteka ryose.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye Uwiteka Imana imwirukana muri ya ngobyi muri Edeni, kugira ngo ahinge ubutaka yavuyemo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko yirukana uwo muntu, kandi mu ruhande rw'iyo ngobyi yo muri Edeni rwerekeye iburasirazuba, ishyiraho Abakerubi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Abakerubi",
              "type": "text"
            },
            {
              "text": "ni umutwe umwe w'abamarayika.",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'inkota yaka umuriro, izenguruka impande zose, ngo ibuze inzira ijya kuri cya giti cy'ubugingo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
