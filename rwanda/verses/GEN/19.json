              },
              "items": [
                {
                  "text": "Yuda 7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze Uwiteka agusha kuri Sodomu n'i Gomora amazuku n'umuriro, bivuye ku Uwiteka mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
