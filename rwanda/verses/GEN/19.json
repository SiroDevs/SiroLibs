              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.32"
              },
              "items": [
                {
                  "text": "Luka 17.32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko muka Loti arakebuka, areba inyuma amukurikiye, ahinduka inkingi y'umunyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
