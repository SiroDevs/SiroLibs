          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti agera i Sowari izuba rirashe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
            ]
