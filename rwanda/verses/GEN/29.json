    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo ajya kwa Labani, atendera Rasheli imyaka irindwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo akomeza urugendo, agera mu gihugu cy'abanyaburasirazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.1",
            "verseOrgIds": [
              "GEN.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abona iriba riri mu gasozi, ririho imikumbi y'intama itatu ziryamye, kuko kuri iryo riba buhiriraga imikumbi kandi igitare kigomeye amazi cyari kinini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.2",
            "verseOrgIds": [
              "GEN.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho imikumbi yose yateraniraga, bagatembagaza cya gitare, bakagikura ku munwa w'iriba, bakuhira intama, bakagisubiza ku munwa w'iriba aho gihora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.3",
            "verseOrgIds": [
              "GEN.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo abaza abungeri ati “Bene data murava he?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Turi Abanyaharani.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.4",
            "verseOrgIds": [
              "GEN.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza ati “Muzi Labani mwene Nahori?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Turamuzi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.5",
            "verseOrgIds": [
              "GEN.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza ati “Araho?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Araho kandi dore umukobwa we Rasheli azanye intama.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.6",
            "verseOrgIds": [
              "GEN.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababwira ati “Dore ntiburīra, igihe cy'amahindūra ntikirasohora, mwuhire intama mugende muziragire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.7",
            "verseOrgIds": [
              "GEN.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Ntitubibasha imikumbi yose itaraterana, bagatembagaza igitare bakagikura ku munwa w'iriba, ni bwo turi bubone kuhira intama.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.8",
            "verseOrgIds": [
              "GEN.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akivugana na bo Rasheli azana intama za se, kuko ari we uziragira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo abonye Rasheli mwene Labani nyirarume, n'intama za Labani nyirarume, yegera iriba, atembagaza cya gitare, agikura ku munwa w'iriba, yuhira umukumbi wa Labani nyirarume. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo asoma Rasheli, araturika ararira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo abwira Rasheli yuko ari mwene wabo wa se, ko ari mwene Rebeka, arirukanka abibwira se.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Labani yumvise inkuru ya Yakobo mwishywa we, arirukanka aramusanganira, aramuhobera aramusoma, amujyana iwe. Abwira Labani ibyabaye byose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.13",
            "verseOrgIds": [
              "GEN.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani aramubwira ati “Ni ukuri uri amaraso yanjye n'ubura bwanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "amaraso . . . bwanjye:",
              "type": "text"
            },
            {
              "text": "mu Ruheburayo ni igufwa ryanjye n'umubiri wanjye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abana na we ukwezi kumwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.14",
            "verseOrgIds": [
              "GEN.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani abaza Yakobo ati “Kuko uri mwene wacu, ni cyo gituma unkorera ku busa? Urashaka ko nzaguhemba iki?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.15",
            "verseOrgIds": [
              "GEN.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Labani yari afite abakobwa babiri: umukuru yitwaga Leya, umuto yitwaga Rasheli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.16",
            "verseOrgIds": [
              "GEN.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya yari afite amaso atabengerana, ariko Rasheli yari mwiza wese, no mu maso ari heza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.17",
            "verseOrgIds": [
              "GEN.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo abenguka Rasheli asubiza Labani ati “Ndagutendera imyaka irindwi, uzanshyingire Rasheli umukobwa wawe muto.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.18",
            "verseOrgIds": [
              "GEN.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani aramusubiza ati “Kumuguha biruta kumuha undi muntu wese, gumana nanjye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.19",
            "verseOrgIds": [
              "GEN.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo atendera imyaka irindwi kugira ngo ahabwe Rasheli, imuhwanira n'iminsi mike ku bw'urukundo amukunze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Labani arabanza amushyingira Leya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.20",
            "verseOrgIds": [
              "GEN.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo atebutsa kuri Labani ati “Nshyingira umugeni wanjye, murongore kuko ndangije iminsi yanjye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.21",
            "verseOrgIds": [
              "GEN.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani atora abakwe baho bose, arabatekera arabagaburira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.22",
            "verseOrgIds": [
              "GEN.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimugoroba azana Leya umukobwa we aramumushyingira, aramurongora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.23",
            "verseOrgIds": [
              "GEN.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani atanga Zilupa umuja we, amuha umukobwa we Leya ho indongoranyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.24",
            "verseOrgIds": [
              "GEN.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gitondo Yakobo abona ari Leya. Abaza Labani ati “Wangize ibiki? Rasheli si we natendeye? Ni iki gitumye undiganya utyo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.25",
            "verseOrgIds": [
              "GEN.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani aramusubiza ati “Iwacu ntibagenza batyo, gushyingira umuto basize umukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.26",
            "verseOrgIds": [
              "GEN.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mara iminsi irindwi y'uwo, tubone kugushyingirira n'uriya iyindi myaka irindwi uzatenda.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo atendera Rasheli indi myaka irindwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.27",
            "verseOrgIds": [
              "GEN.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo abigenza atyo amara iminsi irindwi ya Leya, Labani amushyingira Rasheli umukobwa we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.28",
            "verseOrgIds": [
              "GEN.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Labani atanga Biluha umuja we, amuha Rasheli umukobwa we ho indongoranyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.29",
            "verseOrgIds": [
              "GEN.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo arongora na Rasheli, akundwakaza Rasheli, anyungwakaza Leya, atenda kuri Labani indi myaka irindwi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.30",
            "verseOrgIds": [
              "GEN.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abona ko Leya anyungwakaye azibūra inda ye, ariko Rasheli yari ingumba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.31",
            "verseOrgIds": [
              "GEN.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leya asama inda abyara umuhungu, amwita Rubeni ati “Ni uko Uwiteka yabonye umubabaro wanjye, noneho umugabo wanjye azankunda.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.32",
            "verseOrgIds": [
              "GEN.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asama indi nda abyara umuhungu ati “Kuko Uwiteka yumvise nywungwakaye, ni cyo gitumye anyongera n'uyu.” Amwita Simiyoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Simiyoni",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Kumva.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.33",
            "verseOrgIds": [
              "GEN.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asama indi nda abyara umuhungu ati “Noneho ndafatana n'umugabo wanjye, kuko twabyaranye abahungu batatu.” Ni cyo cyatumye yitwa Lewi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Lewi",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Gufatanywa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.34",
            "verseOrgIds": [
              "GEN.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asama indi nda abyara umuhungu ati “Ubu ndashima Uwiteka.” Ni cyo cyatumye amwita Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Yuda",
              "type": "text"
            },
            {
              "text": "risobanurwa ngo Ushimirwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Aba arekeye aho kubyara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.35",
            "verseOrgIds": [
              "GEN.29.35"
            ]
          }
        }
      ]
    }
