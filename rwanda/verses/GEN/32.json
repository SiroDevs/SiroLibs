          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abonye yuko atamutsinze, akora ku mutsi wo ku nyonga y'itako rye, umutsi wo ku nyonga y'itako rya Yakobo urareguka bagikirana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
