          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izuba rirasa akirenga Penuweli, acumbagizwa n'ikibero cye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
