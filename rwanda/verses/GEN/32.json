              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yita aho hantu Penuweli ati “Ndebesheje Imana amaso, sinapfa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
