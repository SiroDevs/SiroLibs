              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza umugabo aramukiranya, bageza mu museke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.25"
            ]
