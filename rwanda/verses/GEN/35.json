              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba Leya ni Rubeni imfura ya Yakobo, na Simiyoni na Lewi na Yuda na Isakari na Zebuluni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
