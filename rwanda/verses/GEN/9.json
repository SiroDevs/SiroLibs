                "loc": "GEN.1.28"
              },
              "items": [
                {
                  "text": "Itang 1.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imana iha umugisha Nowa n'abana be, irababwira iti “Mwororoke, mugwire, mwuzure isi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.1",
            "verseOrgIds": [
              "GEN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyamaswa zo mu isi zose n'inyoni n'ibisiga byo mu kirere byose bizabagirira ubwoba, bizabatinya. Murabihawe byo n'ibyuzuye ku butaka byose, n'amafi yo mu nyanja yose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyigenza byose bifite ubugingo bizaba ibyokurya byanyu, mbibahaye byose nk'uko nabahaye ibimera bibisi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.3",
            "verseOrgIds": [
              "GEN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.26+LEV.7.27"
              },
              "items": [
                {
                  "text": "Lewi 7.26-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.10+LEV.17.11+LEV.17.12+LEV.17.13+LEV.17.14"
              },
              "items": [
                {
                  "text": "17.10-14",
