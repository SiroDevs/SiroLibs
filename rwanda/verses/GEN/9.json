              },
              "items": [
                {
                  "text": "15.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko ntimukaryane inyama n'ubugingo bwayo, ni bwo maraso yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.4",
            "verseOrgIds": [
              "GEN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi amaraso yanyu, amaraso y'ubugingo bwanyu, sinzabura kuyahorera. Nzayahorera inyamaswa zose kandi umuntu na we nzamuhorera ubugingo bw'umuntu, nzabuhorera undi muntu wese. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.26"
              },
              "items": [
                {
                  "text": "Itang 1.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13"
              },
              "items": [
                {
                  "text": "Kuva 20.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uvushije amaraso y'umuntu, amaraso ye azavushwa n'abantu, kuko Imana yaremye umuntu afite ishusho yayo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        }
      ]
    },
