            }
          ]
        },
        {
          "text": "Baramusubiza bati “Udukijije urupfu, tukugirireho umugisha databuja, natwe tuzaba imbata za Farawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.25",
            "verseOrgIds": [
              "GEN.47.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 47:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yandikisha iryo tegeko, riba itegeko ridakuka mu gihugu cya Egiputa na bugingo n'ubu, yuko Farawo ahabwa igice cya gatanu. Ubutaka bw'abatambyi ni bwo bwonyine butabaye ubwa Farawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        }
      ]
    },
