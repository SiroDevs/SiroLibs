          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli batura mu gihugu cya Egiputa, mu gihugu cy'i Gosheni, baronkerayo ibintu, barororoka, bagwira cyane.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.27",
            "verseOrgIds": [
              "GEN.47.27"
            ]
          }
        }
      ]
    },
    {
