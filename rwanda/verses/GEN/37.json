        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.35",
            "verseOrgIds": [
              "GEN.37.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 37:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba Bamidiyani bajyana Yosefu muri Egiputa, bamugurirayo na Potifari, umutware wa Farawo, watwaraga abamurinda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
        }
