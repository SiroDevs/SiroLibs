        "style": "s1"
      },
      "items": [
        {
          "text": "Uwiteka yohereza Aburamu i Kanāni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
