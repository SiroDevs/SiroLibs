            "number": "1",
            "style": "v",
            "sid": "GEN 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara yaramye imyaka ijana na makumyabiri n'irindwi, iyo ni yo myaka Sara yaramye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.1",
            "verseOrgIds": [
              "GEN.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara apfira i Kiriyataruba (ari ho Heburoni) mu gihugu cy'i Kanāni, Aburahamu aza kuborogera Sara, amuririra.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.23.2",
            "verseOrgIds": [
              "GEN.23.2"
            ]
          }
        }
      ]
    },
    {
