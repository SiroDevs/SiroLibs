              },
              "items": [
                {
                  "text": "Mar 10.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " umugabo n'umugore ni ko yabaremye, ibaha umugisha ibita Umuntu, ku munsi baremeweho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        },
        {
          "name": "verse",
