                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.26"
              },
              "items": [
                {
                  "text": "Luka 17.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.20"
              },
              "items": [
                {
                  "text": "1 Pet 3.20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi Uwiteka abona yuko ingeso z'abantu zari mbi cyane mu isi, kandi ko kwibwira kose imitima yabo itekereza ari kubi gusa iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka yicuza yuko yaremye abantu mu isi, bimutera agahinda mu mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.6",
            "verseOrgIds": [
              "GEN.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aravuga ati “Nzarimbura abantu naremye, mbatsembe mu isi uhereye ku muntu n'inyamaswa n'amatungo n'ibikururuka n'inyoni n'ibisiga byo mu kirere, kuko nicujije yuko nabiremye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.7",
            "verseOrgIds": [
              "GEN.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Nowa agirira umugisha ku Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.8",
            "verseOrgIds": [
              "GEN.6.8"
            ]
          }
        }
      ]
    },
    {
