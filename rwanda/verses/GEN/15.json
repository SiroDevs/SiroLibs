              "attrs": {
                "loc": "JOB.4.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ku kirengarenga Aburamu asinzira ubuticura, ubwoba butewe n'umwijima w'icuraburindi buramufata. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.12",
            "verseOrgIds": [
              "GEN.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
