            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo bibabaza Yona cyane ararakara, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Kuva 34.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " asenga Uwiteka ati “Uwiteka, si icyo navugaga nkiri iwacu? Ni cyo cyatumye nshoka mpungira i Tarushishi, kuko namenye ko uri Imana igira ubuntu n'imbabazi, itinda kurakara, ifite kugira neza kwinshi kandi yibuza kugira nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.4"
              },
              "items": [
                {
                  "text": "1 Abami 19.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " None rero Uwiteka, ndakwinginze unyice kuko gupfa bindutiye kubaho.”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
