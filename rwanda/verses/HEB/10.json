                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.36.25"
              },
              "items": [
                {
                  "text": "Ezek 36.25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " twegere dufite imitima y'ukuri twizera rwose tudashidikanya, imitima yacu iminjiriweho gukurwamo kwimenyaho ibibi, n'imibiri yacu yuhagijwe amazi meza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.22",
            "verseOrgIds": [
              "HEB.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dukomeze kwatura ibyiringiro byacu tutanyeganyega, kuko uwasezeranije ari uwo kwizerwa, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.23",
            "verseOrgIds": [
              "HEB.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi tujye tuzirikana ubwacu kugira ngo duterane ishyaka ryo gukundana n'iry'imirimo myiza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.24",
            "verseOrgIds": [
              "HEB.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twe kwirengagiza guteranira hamwe nk'uko bamwe bajya bagira, ahubwo duhugurane kandi uko mubonye urya munsi wegera, mube ari ko murushaho kugenza mutyo.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.25",
            "verseOrgIds": [
              "HEB.10.25"
            ]
          }
        }
      ]
    },
