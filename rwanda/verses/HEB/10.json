          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niba dukora ibyaha nkana tumaze kumenya ukuri, ntihaba hagisigaye igitambo cy'ibyaha ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.26",
            "verseOrgIds": [
              "HEB.10.26"
            ]
          }
