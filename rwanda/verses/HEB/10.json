          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bene Data, ubwo dufite ubushizi bw'ubwoba bwo kwinjizwa Ahera cyane n'amaraso ya Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.19",
            "verseOrgIds": [
              "HEB.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "tunyuze mu nzira yaduciriye nshya kandi y'ubugingo, inyura mu mwenda ukinze ari wo mubiri we, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.20",
            "verseOrgIds": [
              "HEB.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ubwo dufite umutambyi ukomeye utwara inzu y'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.21",
            "verseOrgIds": [
              "HEB.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
