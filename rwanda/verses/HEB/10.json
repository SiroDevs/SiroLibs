                  "text": "Yes 26.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " keretse gutegerezanya ubwoba gucirwa ho iteka, no gutegereza umuriro w'inkazi uzarya abanzi b'Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.27",
