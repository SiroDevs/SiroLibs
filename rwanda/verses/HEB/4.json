                "loc": "JOS.22.4"
              },
              "items": [
                {
                  "text": "Yos 22.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iyo Yosuwa abaruhura, Imana ntiyajyaga kuvuga hanyuma iby'undi munsi. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.8",
            "verseOrgIds": [
              "HEB.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, ku bw'ibyo haracyariho uburuhukiro bw'isabato bubikiwe abantu b'Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.9",
            "verseOrgIds": [
              "HEB.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.2"
              },
              "items": [
                {
                  "text": "Itang 2.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko uwinjiye mu buruhukiro bwayo na we aba aruhutse imirimo ye nk'uko Imana yaruhutse iyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.10",
            "verseOrgIds": [
              "HEB.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tugire umwete wo kwinjira muri ubwo buruhukiro, kugira ngo hatagira umuntu ugwa akurikije icyitegererezo cya ba bandi cyo kutumvira.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.11",
            "verseOrgIds": [
              "HEB.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ijambo ry'Imana ari rizima, rifite imbaraga kandi rikagira ubugi buruta ubw'inkota zose, rigahinguranya ndetse kugeza ubwo rigabanya ubugingo n'umwuka, rikagabanya ingingo n'umusokōro kandi rikabangukira kugenzura ibyo umutima wibwira ukagambirira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta cyaremwe kitagaragara imbere yayo, ahubwo byose bitwikuruwe nk'ibyambaye ubusa mu maso y'Izatubaza ibyo twakoze.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo ni umutambyi mukuru uruta abatambyi bakuru bo mu isezerano rya kera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ubwo dufite umutambyi mukuru ukomeye wagiye mu ijuru, ari we Yesu Umwana w'Imana, dukomeze ibyo twizera tukabyatura. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.14",
            "verseOrgIds": [
              "HEB.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko tudafite umutambyi mukuru utabasha kubabarana natwe mu ntege nke zacu, ahubwo yageragejwe uburyo bwose nkatwe, keretse yuko atigeze akora icyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.15",
            "verseOrgIds": [
              "HEB.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, twegere intebe y'ubuntu tudatinya, kugira ngo tubabarirwe tubone ubuntu bwo kudutabara mu gihe gikwiriye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.16",
            "verseOrgIds": [
              "HEB.4.16"
            ]
          }
        }
      ]
    }
