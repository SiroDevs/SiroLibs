              },
              "items": [
                {
                  "text": "Zab 95.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Naho twebwe ubwo twizeye twinjira muri ubwo buruhukiro, (ubwo yavuze iti",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.3",
            "verseOrgIds": [
              "HEB.4.3"
            ]
          }
        }
      ]
    },
