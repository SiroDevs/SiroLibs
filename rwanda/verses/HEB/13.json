              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukomeze gukundana urukundo rwa kivandimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.1",
            "verseOrgIds": [
              "HEB.13.1"
            ]
