            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.16",
            "verseOrgIds": [
              "HEB.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwumvire ababayobora mubagandukire, kuko ari bo baba maso barinda imitima yanyu nk'abazabibazwa. Nuko rero, mubumvire kugira ngo babikore banezerewe kandi batagononwa, kuko kubikorana akangononwa kutagira icyo kumarira mwebwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.17",
            "verseOrgIds": [
              "HEB.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudusabire kuko twiringiye yuko tudafite umutima wicira urubanza, tukaba dushaka kugira ingeso nziza muri byose. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.18",
            "verseOrgIds": [
              "HEB.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ndiyongeza kubahugura kudusabira, kugira ngo ntebutswe vuba kubagarurirwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.19",
            "verseOrgIds": [
              "HEB.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Imana nyir'amahoro, yazuye Umutahiza w'intama ari we Mwami wacu Yesu, imuzurishije amaraso y'isezerano ry'iteka ryose, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.20",
            "verseOrgIds": [
              "HEB.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibatunganye rwose mu byiza byose kugira ngo mukore ibyo ishaka, ikorera muri mwe ibishimwa imbere yayo ku bwa Yesu Kristo, icyubahiro kibe icye iteka ryose. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.21",
            "verseOrgIds": [
              "HEB.13.21"
            ]
          }
        }
      ]
    },
