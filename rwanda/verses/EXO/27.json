        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.1+LEV.24.2+LEV.24.3+LEV.24.4"
              },
              "items": [
                {
                  "text": "Lewi 24.1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kandi uzategeke Abisirayeli bakuzanire amavuta aboneye ya elayo zasekuwe ya cya gitereko, kugira ngo bitume iryo tabaza rihora ryaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.20",
            "verseOrgIds": [
              "EXO.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ihema ry'ibonaniro inyuma ya wa mwenda ukingiriza Ibihamya, abe ari ho Aroni n'abana be bazajya baritunganiriza kugira ngo ryakire imbere y'Uwiteka, rihere nimugoroba rigeze mu gitondo. Mu bihe by'Abisirayeli byose rizabe itegeko ridakuka bakwiriye kujya bitondera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.27.21",
            "verseOrgIds": [
              "EXO.27.21"
            ]
          }
        }
      ]
    }
