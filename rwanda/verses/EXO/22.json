            "caller": "#"
          },
          "items": [
            {
              "text": "Imana:",
              "type": "text"
            },
            {
              "text": "cyangwa, abacamanza.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ntukavume umutware w'ubwoko bwanyu.",
          "type": "text",
          "attrs": {
