              "type": "text"
            }
          ]
        },
        {
          "text": "“Ntugatinde kuntura ku byuzuye ibigega byawe, no ku mazi y'imbuto z'ibiti byawe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
