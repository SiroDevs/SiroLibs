                }
              ]
            }
          ]
        },
        {
          "text": " “Umusuhuke w'umunyamahanga ntukamugirire nabi, ntukamuhate kuko namwe mwari abasuhuke mu gihugu cya Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire umupfakazi cyangwa impfubyi mubabaza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nugira icyo ubababaza na gato bakantakira, sinzabura kumva gutaka kwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "uburakari bwanjye bukagurumana nkabicisha inkota, abagore banyu namwe bakaba abapfakazi, abana banyu bakaba impfubyi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        }
