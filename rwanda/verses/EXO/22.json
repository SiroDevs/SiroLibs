              "items": [
                {
                  "text": "Guteg 24.10-13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Niwaka umwenda wa mugenzi wawe ho ingwate, izuba ntirikarenge utawumushubije ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
