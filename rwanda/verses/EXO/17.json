                "loc": "1SA.15.2+1SA.15.3+1SA.15.4+1SA.15.5+1SA.15.6+1SA.15.7+1SA.15.8+1SA.15.9"
              },
              "items": [
                {
                  "text": "1 Sam 15.2-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka abwira Mose ati “Andika ibi mu gitabo bibe urwibutso, ubibwire Yosuwa yuko nzakuraho rwose kwibukwa kw'Abamaleki, bakibagirana mu bo munsi y'ijuru bose.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.14",
            "verseOrgIds": [
              "EXO.17.14"
            ]
