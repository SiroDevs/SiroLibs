              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kavukire n'umunyamahanga ubasuhukiyemo bazasangire itegeko.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.49",
            "verseOrgIds": [
