              "items": [
                {
                  "text": "Gal 3.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Imyaka Abisirayeli bamaze mu rusuhuko rwa Egiputa, yari magana ane na mirongo itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo myaka uko ari magana ane na mirongo itatu ishize hatabuzeho umunsi, hadasāzeho umunsi, ingabo z'Uwiteka zose ziva mu gihugu cya Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo joro ni iryo kuziriririzwa Uwiteka cyane, kuko yabakuye mu gihugu cya Egiputa Iryo ni rya joro ry'Uwiteka, Abisirayeli bose bakwiriye kujya baziririza cyane mu bihe byabo byose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Andi mategeko ya Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
