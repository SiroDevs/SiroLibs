            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose na Aroni ati “Iri ni ryo tegeko kuri Pasika: ntihakagire umunyamahanga urya ku byayo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.43",
            "verseOrgIds": [
              "EXO.12.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EXO 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko umugurano w'umuntu wese yaguze ifeza, nibamara kumukeba abone kubiryaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.44",
            "verseOrgIds": [
              "EXO.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EXO 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusuhuke w'umunyamahanga n'umugaragu ukorera ibihembo, ntibakabiryeho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.45",
            "verseOrgIds": [
              "EXO.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EXO 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Kub 9.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.36"
              },
              "items": [
                {
                  "text": "Yoh 19.36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bye gukurwa mu nzu ngo bijyanwe mu yindi. Ntugasohokane n'intongo y'iyo nyama, kandi ntimukavuneho igufwa na rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.46",
