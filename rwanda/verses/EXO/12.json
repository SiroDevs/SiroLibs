              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Abisirayeli bose bakoze, uko Uwiteka yategetse Mose na Aroni ni ko bakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
