  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "EXO 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isanduku yera n'iby'ahera bindi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besalēli abaza isanduku yera mu mushita, uburebure bwayo bw'umurambararo buba mikono ibiri n'igice, ubugari bwayo buba mukono umwe n'igice, uburebure bwayo bw'igihagararo buba mukono umwe n'igice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.1",
            "verseOrgIds": [
              "EXO.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayiyagirizaho izahabu nziza imbere n'inyuma, ayigotesha umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.2",
            "verseOrgIds": [
              "EXO.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayitekera izahabu zivamo ibifunga bine, abishyira ku nkokora zayo zo hepfo uko ari enye, ibifunga bibiri biba mu rubavu rumwe, ibindi bibiri biba mu rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.3",
            "verseOrgIds": [
              "EXO.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāza imijisho mu mushita ayiyagirizaho izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.4",
            "verseOrgIds": [
              "EXO.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashyira iyo mijisho mu bifunga byo mu mbavu z'iyo sanduku, ngo bajye bayiremērwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.5",
            "verseOrgIds": [
              "EXO.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi acura intebe y'ihongerero mu izahabu nziza, uburebure bwayo buba mikono ibiri n'igice, ubugari bwayo buba mukono umwe n'igice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.6",
            "verseOrgIds": [
              "EXO.37.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi arema abakerubi babiri mu izahabu, abarema mu izahabu icuzwe, abarema mu mitwe yombi y'iyo ntebe y'ihongerero. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.7",
            "verseOrgIds": [
              "EXO.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arema igishushanyo cy'umukerubi, kimwe mu mutwe umwe n'ikindi mu wundi, abicurana n'intebe y'ihongerero mu mitwe yayo yombi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.8",
            "verseOrgIds": [
              "EXO.37.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bishushanyo by'abakerubi bitanda amababa yabyo hejuru, ngo biyakingirishe iyo ntebe y'ihongerero, birerekerana bireba iyo ntebe y'ihongerero.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.9",
            "verseOrgIds": [
              "EXO.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abāza ameza amwe mu mushita, uburebure bwayo bw'umurambararo buba mikono ibiri, ubugari bwayo buba mukono umwe, uburebure bw'igihagararo buba mukono umwe n'igice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.10",
            "verseOrgIds": [
              "EXO.37.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayayagirizaho izahabu nziza, ayagotesha umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.11",
            "verseOrgIds": [
              "EXO.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayabāriza igikomeza amaguru kiyagose, ubugari bwacyo buba igice cya mukono, akigotesha umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.12",
            "verseOrgIds": [
              "EXO.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayatekera izahabu zivamo ibifunga bine, abishyira ku nkokora uko ari enye ziri ku maguru yayo uko ari ane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.13",
            "verseOrgIds": [
              "EXO.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo bifunga biba hafi y'igikomeza amaguru, biba ibyo gushyirwamo imijisho yo kuremerezwa ameza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.14",
            "verseOrgIds": [
              "EXO.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāza imijisho mu mushita ayiyagirizaho izahabu, ngo abe ari yo ijya iremerezwa ayo meza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.15",
            "verseOrgIds": [
              "EXO.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acura ibintu byo kuba kuri yo: amasahani n'udukombe byo kuri yo, n'imperezo n'ibikombe byo kuri yo byo gusukisha amaturo y'ibyokunywa, abicura mu izahabu nziza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igitereko cy'amatabaza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.16",
            "verseOrgIds": [
              "EXO.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi arema igitereko cy'amatabaza mu izahabu nziza, akirema mu izahabu icuzwe, indiba yacyo n'umubyimba wacyo, kandi ibikombe n'ibibumbabumbye n'uburabyo byo kuri cyo, bicuranwa na cyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi gishamika amashami atandatu, amashami atatu y'icyo gitereko ashamika mu rubavu rumwe, n'ayandi atatu mu rundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishami rimwe rigira ibikombe bitatu bisa n'uburabyo bw'indōzi, cyose gifatanye n'ikibumbabumbye n'ururabyo, n'iryo ku rundi rubavu rigira ibikombe bitatu bisa n'uburabyo bw'indōzi, cyose gifatanye n'ikibumbabumbye n'ururabyo. Amashami yose uko ari atandatu ashamitse kuri icyo gitereko, aba ari ko amera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubyimba wacyo ugira ibikombe bine bisa n'uburabyo bw'indōzi, n'ibibumbabumbye n'uburabyo bifatanye na byo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibumbabumbye kiba munsi y'amashami abiri acuranywe na cyo, n'ikindi kiba munsi y'andi mashami abiri acuranywe na cyo, n'ikindi kiba munsi y'andi mashami abiri acuranywe na cyo, uko amashami ashamitse kuri icyo gitereko ari atandatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibibumbabumbye byacyo n'amashami yacyo acuranwa na cyo, cyose gicurirwa hamwe mu izahabu nziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acura amatabaza yacyo arindwi n'icyuma cyacyo cyo gukuraho ibishirira, n'udusahani two kubishyiraho. Ibyo byose abicura mu izahabu nziza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gitereko n'ibintu byacyo byose, abirema mu italanto y'izahabu nziza.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igicaniro cyo koserezaho imibavu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abāza igicaniro cyo koserezaho imibavu mu mushita, uburebure bwacyo bw'umurambararo buba mukono umwe, n'ubugari bwacyo buba mukono umwe, kingana impande zose. Uburebure bw'igihagararo buba mikono ibiri, akibāzanya n'amahembe yacyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.25",
            "verseOrgIds": [
              "EXO.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiyagirizaho izahabu nziza hejuru yacyo, no mu mbavu zacyo impande zose no ku mahembe yacyo, kandi akigotesha umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.26",
            "verseOrgIds": [
              "EXO.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agicurira ibifunga bibiri mu izahabu, abishyira munsi y'umuguno wacyo ku mbavu zacyo zombi, biba ibyo gusesekwamo imijisho ikiremerezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.27",
            "verseOrgIds": [
              "EXO.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mijisho ayibāza mu mushita, ayiyagirizaho izahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.28",
            "verseOrgIds": [
              "EXO.37.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
