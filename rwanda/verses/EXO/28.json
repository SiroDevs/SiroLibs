        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.28",
            "verseOrgIds": [
              "EXO.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
