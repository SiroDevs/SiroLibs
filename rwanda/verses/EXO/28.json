                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi uzashyire Urimu na Tumimu imbere muri uwo mwambaro wo ku gituza zo kūngurisha inama, bibe ku mutima wa Aroni uko yinjiye imbere y'Uwiteka. Aroni azajye yambara ku mutima we ibyūngurisha inama",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.30",
            "verseOrgIds": [
              "EXO.28.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ibyungurisha inama:",
              "type": "text"
            },
            {
              "text": "cyangwa, ibicisha imanza; ariko reba Kub 27.21.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z'Abisirayeli, abijyane imbere y'Uwiteka ubudasiba.",
          "type": "text",
