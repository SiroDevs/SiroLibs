          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi uzacure igisate mu izahabu nziza, maze nk'uko bakeba ku ibuye rishyiraho ikimenyetso, ucyandikisheho gukeba aya magambo ngo: YEREJWE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "YEREJWE",
              "type": "text"
            },
            {
              "text": "cyangwa KWERERA.",
              "type": "text"
            }
          ]
        },
        {
          "text": " UWITEKA. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
            "verseOrgIds": [
              "EXO.28.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 28:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugifatanye n'agashumi kaboheshejwe ubudodo bw'umukara wa kabayonga, gitamirizwe kuri cya gitambaro kizinze cyo mu mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.37",
            "verseOrgIds": [
              "EXO.28.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 28:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gisate kibe mu ruhanga rwa Aroni, agibweho no gukiranirwa ko mu byera Abisirayeli bazeza iyo batura amaturo yabo yose yera, gihore kiba mu ruhanga rwe iteka, kugira ngo bemerwe n'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.38",
            "verseOrgIds": [
              "EXO.28.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
