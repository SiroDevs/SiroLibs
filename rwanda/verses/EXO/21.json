                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi umuntu natubīkīra undi, Imana igatuma amugwa mu maboko, nzagutegekera aho azahungira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu natera mugenzi we abyitumye ngo amwicishe uburiganya, umukure ku gicaniro cyanjye ahōrwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
      ]
