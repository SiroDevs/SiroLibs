          ]
        },
        {
          "text": " ijisho rihorerwa irindi, iryinyo rihorerwa irindi, ikiganza gihorerwa ikindi, ikirenge gihorerwa ikindi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
