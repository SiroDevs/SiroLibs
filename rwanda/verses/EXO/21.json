          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Inka y'umuntu niyica iy'undi igapfa, iyayishe bayigure bagabane ibiguzi byayo, kandi n'intumbi na yo bayigabane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
              "EXO.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cyangwa nibimenyekana yuko iyo nka yari isanzwe yica, nyirayo ntayirinde, ntazabure kurihaho indi, intumbi ikaba iye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.36",
            "verseOrgIds": [
              "EXO.21.36"
            ]
          }
        }
      ]
    },
