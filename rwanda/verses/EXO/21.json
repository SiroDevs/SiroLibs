          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu nakubita inkoni umugurano we w'umugabo cyangwa w'umugore akamukumbanya, ntazabure guhanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.20",
            "verseOrgIds": [
              "EXO.21.20"
            ]
