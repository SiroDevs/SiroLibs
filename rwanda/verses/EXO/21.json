          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi abantu nibarwana bakababaza umugore utwite, akavanamo inda ariko ntagire ikindi aba, ntazabure kuriha icyo umugabo w'uwo mugore amurihishije cyose, azarihe nk'uko abacamanza bategetse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.22",
            "verseOrgIds": [
              "EXO.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nihagira ikindi aba, uzategeke ko ubugingo buhorerwa ubundi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
            "verseOrgIds": [
              "EXO.21.23"
            ]
