              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu niyiba inka cyangwa intama, akayibaga cyangwa akayigura, inka ayiriheho eshanu, intama ayiriheho enye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.37",
