              "EXO.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko kuri uwo munsi Uwiteka yakijije Abisirayeli Abanyegiputa, Abisirayeli babona intumbi z'Abanyegiputa ku nkombe y'inyanja. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli babona ibikomeye Uwiteka yakoresheje imbaraga ze ku Banyegiputa, ubwo bwoko butinya Uwiteka kandi bizera Uwiteka n'umugaragu we Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.31",
            "verseOrgIds": [
              "EXO.14.31"
            ]
          }
        }
