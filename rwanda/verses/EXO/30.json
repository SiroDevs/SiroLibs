                {
                  "text": "Kuva 37.25-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kandi uzabāze igicaniro cyo koserezaho imibavu, ukibāze mu mushita. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburebure bwacyo bw'umurambararo bube mukono umwe, n'ubugari bwacyo bube mukono umwe kingane impande zose, uburebure bwacyo bw'igihagararo bube mikono ibiri, ukibāzanye n'amahembe yacyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukiyagirizeho izahabu nziza hejuru yacyo, no mu mbavu zacyo impande zose no ku mahembe yacyo, kandi uzakigoteshe umuguno w'izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugicurire ibifunga bibiri mu izahabu, ubishyire munsi y'umuguno wacyo ku mbavu zacyo zombi, ku mpande zacyo zombi abe ari ho ubishyira, bibe ibyo gusesekwamo imijisho ikiremerezwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mijisho uyibāze mu mushita, uyiyagirizeho izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucyegereze umwenda ukingiriza ya sanduku y'Ibihamya, kibe imbere y'intebe y'ihongerero iri hejuru y'ibyo Bihamya, aho nzajya mbonanira nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni ajye acyoserezaho imibavu y'ikivange uko bukeye mu gitondo, uko agiye gutunganya ya matabaza ajye ayosa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nimugoroba uko Aroni agiye gukongeza ayo matabaza, ajye ayosa ibe imibavu itavaho, iri imbere y'Uwiteka mu bihe byanyu byose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukacyoserezeho imibavu iciye ukundi, ntimukagitambireho igitambo cyoswa kitagabanijwe cyangwa ituro ry'ifu, ntimukagisukeho ituro ry'ibyokunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni ahongerere ku mahembe yacyo impongano rimwe uko umwaka utashye, amaraso y'igitambo gitambirwa ibyaha cy'impongano abe ari yo ahongerera icyo gicaniro rimwe uko umwaka utashye, mu bihe byanyu byose. Icyo gicaniro ni icyera cyane cyerejwe Uwiteka.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
