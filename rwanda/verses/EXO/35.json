              },
              "items": [
                {
                  "text": "Guteg",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " mu minsi itandatu imirimo ijye ikorwa, ariko uwa karindwi ujye ubabera umunsi wera, isabato yo kuruhuka yerejwe Uwiteka, ugira umurimo wose awukoraho azicwe. 15.12-14 ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.2",
            "verseOrgIds": [
              "EXO.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimugacane umuriro mu buturo bwanyu bwose ku munsi w'isabato.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.35.3",
            "verseOrgIds": [
              "EXO.35.3"
            ]
          }
        }
