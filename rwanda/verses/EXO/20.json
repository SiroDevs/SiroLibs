            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati “Uku abe ari ko ubwira Abisirayeli, uti ‘Ubwanyu mwiboneye ko mbabwiye ndi mu ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.22",
            "verseOrgIds": [
              "EXO.20.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukareme izindi mana ngo muzibangikanye nanjye, imana z'ifeza cyangwa imana z'izahabu ntimukazicurire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.23",
            "verseOrgIds": [
              "EXO.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undundire igicaniro cy'ibitaka, ugitambireho ibitambo byawe byoswa n'ibitambo by'uko uri amahoro, intama zawe n'inka zawe. Aho nzibukiriza izina ryanjye hose, nzaza aho uri nguhe umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.24",
            "verseOrgIds": [
              "EXO.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.5+DEU.27.6+DEU.27.7"
              },
              "items": [
                {
                  "text": "Guteg 27.5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.31"
              },
              "items": [
                {
                  "text": "Yos 8.31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi nunyubakira igicaniro cy'amabuye, ntuzacyubakishe amabuye abajwe, kuko nukimanikaho icyuma cyawe uzaba ugihumanije. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.25",
            "verseOrgIds": [
              "EXO.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntugashyire urwuririro rw'amabuye ku gicaniro cyanjye ngo ucyurire, kugira ngo ubwambure bwawe butakigaragariraho.’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.26",
            "verseOrgIds": [
              "EXO.20.26"
            ]
          }
        }
      ]
