              "items": [
                {
                  "text": "Heb 12.18-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abantu bose bumva za nkuba zikubita, babona ya mirabyo irabya, bumva ijwi rya rya hembe, babona wa musozi ucumba umwotsi, babibonye bahinda imishyitsi, bahagarara kure. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.18",
            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babwira Mose bati “Ba ari wowe utubwira ni ho turi bwumve, ariko Imana ye kutubwira tudapfa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abwira abantu ati “Nimuhumure kuko Imana izanywe no kubagerageza, no kugira ngo gutera ubwoba kwayo guhore imbere yanyu mudakora ibyaha.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bahagarara kure. Mose yigira hafi y'umwijima w'icuraburindi Imana irimo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.21",
            "verseOrgIds": [
              "EXO.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
