                }
              ]
            }
          ]
        },
        {
          "text": " Luka ni we wenyine ukiri kumwe nanjye. Shaka Mariko umuzane, kuko angirira umumaro wo kunkorera. Kolo 4.10 ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
