              "items": [
                {
                  "text": "Rom 2.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Alekizanderi, umucuzi w'imiringa yangiriye inabi nyinshi. Umwami wacu azamwitura ibikwiriye ibyo yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe umwirinde, kuko yarwanije amagambo yacu cyane.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.15",
            "verseOrgIds": [
              "2TI.4.15"
            ]
          }
        }
      ]
    },
