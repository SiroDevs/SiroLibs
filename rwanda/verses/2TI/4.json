                {
                  "text": "Kolo 4.7-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko Tukiko namaze kumwohereza muri Efeso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
