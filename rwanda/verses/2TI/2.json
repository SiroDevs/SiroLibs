  "bookId": "2TI",
  "reference": "2 Timoteyo 2",
  "copyright": "PUBLIC DOMAIN",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2TI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pawulo ahugurira Timoteyo kwitanga amaramaje",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2TI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero mwana wanjye, ukomerere mu buntu bubonerwa muri Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.1",
            "verseOrgIds": [
              "2TI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ibyo wanyumvanye imbere y'abahamya benshi, ubimenyeshe abantu bo kwizerwa bazashobora kubyigisha abandi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.2",
            "verseOrgIds": [
              "2TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye ufatanya nanjye kwihanganira imibabaro, nk'uko bikwiriye umusirikare mwiza wa Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.3",
            "verseOrgIds": [
              "2TI.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta waba umusirikare kandi ngo yishyire mu by'ubu bugingo, ngo abe akinejeje uwamwandikiye ubusirikare. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.4",
            "verseOrgIds": [
              "2TI.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2TI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iyo umuntu ashatse kurushanwa mu mikino ntahabwa ikamba, keretse arushanijwe nk'uko bitegetswe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.5",
            "verseOrgIds": [
              "2TI.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2TI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhinzi uhinga ni we ukwiriye kubanza kwenda ku mbuto. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.6",
            "verseOrgIds": [
              "2TI.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zirikana ibyo mvuze, kuko Umwami wacu azaguha ubwenge muri byose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2TI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.7",
            "verseOrgIds": [
              "2TI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2TI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye wibuka Yesu Kristo wakomotse mu rubyaro rwa Dawidi, akazuka mu bapfuye nk'uko ubutumwa nahawe buvuga, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubwo ndenganyirizwa ndetse nkaboheshwa iminyururu nk'umugome, nyamara ijambo ry'Imana ryo ntiribohwa n'iminyururu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
              "2TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2TI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma nihanganira byose ku bw'intore z'Imana, kugira ngo na zo zibone agakiza kabonerwa muri Kristo Yesu gafatanije n'ubwiza buhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri jambo ni iryo kwizerwa ngo “Niba twarapfanye na we tuzabanaho na we, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.33"
              },
              "items": [
                {
                  "text": "Mat 10.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.9"
              },
              "items": [
                {
                  "text": "Luka 12.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kandi nitwihangana tuzīmana na we, naho nitumwihakana na we azatwihakana, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.12",
            "verseOrgIds": [
              "2TI.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nubwo tutizera we ahora ari uwo kwizerwa, kuko atabasha kwivuguruza.”",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ari . . . kwivuguruza:",
              "type": "text"
            },
            {
              "text": "cyangwa, we ahora yizera, kuko atabasha kwiyihakana ubwe.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyerekeye kwirinda impaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.13",
            "verseOrgIds": [
              "2TI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye ubibutsa ibyo, ubihanangiririze imbere y'Imana ko bareka kurwanira amagambo kuko ari nta cyo bimaze, ahubwo bigusha abumva. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.14",
            "verseOrgIds": [
              "2TI.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2TI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ujye ugira umwete wo kwishyira Imana nk'ushimwa, umukozi udakwiriye kugira ipfunwe, ukwiriranya neza ijambo ry'ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko amagambo y'amanjwe atari ay'Imana uyazibukire, kuko abayavuga bazarushaho gushayisha,",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "abayavuga . . . gushayisha:",
              "type": "text"
            },
            {
              "text": "cyangwa, ayobya abantu, bakarushaho kutubaha Imana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.16",
            "verseOrgIds": [
              "2TI.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ijambo ryabo rizaryana nk'igisebe cy'umufunzo. Muri abo ni Humenayo na Fileto, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.17",
            "verseOrgIds": [
              "2TI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2TI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bayobye bakava mu kuri bavuga ko umuzuko wamaze kubaho, bakubika kwizera kwa bamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.18",
            "verseOrgIds": [
              "2TI.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.5"
              },
              "items": [
                {
                  "text": "Kub 16.5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nyamara urufatiro rukomeye rw'Imana ruracyahagaze, rwanditsweho iki kimenyetso ngo “Uwiteka azi abe”, kandi ngo “Umuntu wese uvuga izina ry'Uwiteka ave mu bidatunganye.”",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.19",
            "verseOrgIds": [
              "2TI.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nzu y'inyumba ntihabamo ibintu by'izahabu n'iby'ifeza gusa, ahubwo habamo n'iby'ibiti n'iby'ibumba, kandi bimwe babikoresha iby'icyubahiro, naho ibindi bakabikoresha ibiteye isoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.20",
            "verseOrgIds": [
              "2TI.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero umuntu niyiyeza akitandukanya n'ibidatunganye, azaba abaye ikintu cyo gukoreshwa iby'icyubahiro cyejejwe, kigirira nyiracyo umumaro kandi cyatunganirijwe imirimo myiza yose.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.21",
            "verseOrgIds": [
              "2TI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uhunge irari rya gisore, ahubwo ukurikize gukiranuka no kwizera n'urukundo n'amahoro, ufatanije n'abambaza Umwami wacu bafite imitima iboneye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.22",
            "verseOrgIds": [
              "2TI.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2TI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamara ibibazo by'ubupfu n'iby'abaswa ntukabyemere, uzi nawe ko bibyara amahane. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.23",
            "verseOrgIds": [
              "2TI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2TI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umugaragu w'Umwami wacu ntakwiriye kuba umunyamahane, ahubwo akwiriye kugira ineza kuri bose, agakunda kwigisha, akihangana, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.24",
            "verseOrgIds": [
              "2TI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2TI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "agahanisha ubugwaneza abamugisha impaka ngo ahari nibishoboka, Imana ibahe kwihana ngo bamenye ukuri, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.25",
            "verseOrgIds": [
              "2TI.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2TI 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "basinduke bave mu mutego wa Satani wabafashe mpiri",
