          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabane w'abatabarutse wari intama uduhumbi dutatu n'inzovu eshatu n'ibihumbi birindwi na magana atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.36",
            "verseOrgIds": [
              "NUM.31.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intore z'Uwiteka batoye ku ntama ziba magana atandatu na mirongo irindwi n'eshanu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
            "verseOrgIds": [
              "NUM.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inka zari inzovu eshatu n'ibihumbi bitandatu, intore z'Uwiteka zo kuri zo zari mirongo irindwi n'ebyiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
              "NUM.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indogobe zari inzovu eshatu na magana atanu, intore z'Uwiteka zo kuri zo zari mirongo itandatu n'imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
            "verseOrgIds": [
              "NUM.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bari inzovu n'ibihumbi bitandatu, intore z'Uwiteka zo kuri bo zari abantu mirongo itatu na babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
              "NUM.31.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 31:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aha Eleyazari umutambyi izo ntore. Ni zo turo ryo kwerererezwa Uwiteka uko Uwiteka yategetse Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.41",
            "verseOrgIds": [
              "NUM.31.41"
            ]
          }
        }
