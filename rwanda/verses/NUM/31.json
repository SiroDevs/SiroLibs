            }
          ]
        },
        {
          "text": "uwo mugabane w'iteraniro wari intama uduhumbi dutatu n'inzovu eshatu n'ibihumbi birindwi na magana atanu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.43",
