          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi umubare wose w'abantu wari inzovu eshatu n'ibihumbi bibiri, ari abakobwa batigeze kuryamana n'abagabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.35",
            "verseOrgIds": [
              "NUM.31.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
