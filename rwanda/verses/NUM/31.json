          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iminyago batabazemo isahu yasahuwe n'abarasanyi, yari intama uduhumbi dutandatu n'inzovu ndwi n'ibihumbi bitanu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.32",
            "verseOrgIds": [
              "NUM.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
