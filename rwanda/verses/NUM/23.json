              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balāmu abwira Balaki ati “Nyubakishiriza hano ibicaniro birindwi, unyitegurire hano amapfizi arindwi n'amasekurume y'intama arindwi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
              "NUM.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaki abigenza uko Balāmu amubwiye. Balaki na Balāmu batambira ku gicaniro cyose impfizi n'isekurume y'intama. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.2",
            "verseOrgIds": [
              "NUM.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balāmu abwira Balaki ati “Hagarara iruhande rw'ibitambo byawe byoshejwe nanjye ngende, ahari Uwiteka araza ansanganire; icyo ambwira ndakikubwira.” Ajya mu mpinga y'ibiharabuge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana isanganira Balāmu arayibwira ati “Niteguye ibicaniro birindwi, ntambira ku gicaniro cyose impfizi n'isekurume y'intama.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.4",
            "verseOrgIds": [
              "NUM.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka ashyira ijambo mu kanwa ka Balāmu aramubwira ati “Subira kuri Balaki uvuga utya.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.5",
            "verseOrgIds": [
              "NUM.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amusubiraho asanga ahagararanye n'abatware b'i Mowabu bose, iruhande rw'ibitambo bye byoshejwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.6",
            "verseOrgIds": [
              "NUM.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
