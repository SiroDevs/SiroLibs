          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Balāmu abwira Balaki ati “Sinakubwiye nti ‘Icyo Uwiteka avuga cyose ni cyo nkwiriye gukora’? ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.26",
            "verseOrgIds": [
              "NUM.23.26"
            ]
          }
        }
      ]
