          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bagabo Mose yatumye gutata icyo gihugu, bakagaruka bakabara inkuru y'incamugongo yacyo, bigatuma iteraniro ryose rimwitotombera, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36",
            "verseOrgIds": [
              "NUM.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo bagabo babaze inkuru y'incamugongo y'icyo gihugu, bicirwa na mugiga imbere y'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yosuwa mwene Nuni na Kalebu mwene Yefune, aba ari bo barokoka mu bagiye gutata icyo gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
