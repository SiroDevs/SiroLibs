          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bo barabisuzugura, barazamuka ngo bajye mu mpinga y'umusozi, ariko isanduku y'Isezerano ry'Uwiteka, na Mose, ntibava aho babambye amahema. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abamaleki bamanukana n'Abanyakanāni batuye kuri uwo musozi, barabanesha baraboreza, babageza i Horuma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
