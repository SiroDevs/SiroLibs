                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.1",
            "verseOrgIds": [
              "NUM.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Aroni uti ‘Nushyira ya matabaza ku gitereko cyayo, ajye amurikira imbere yacyo uko ari arindwi.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.2",
            "verseOrgIds": [
              "NUM.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni abigenza atyo, ashyira ayo matabaza ku gitereko uburyo butuma amurikira imbere yacyo, uko Uwiteka yategetse Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.3",
            "verseOrgIds": [
              "NUM.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko kuremwa kw'icyo gitereko cyaremwe mu izahabu icuzwe: uhereye ku ndiba yacyo n'uburabyo bwo kuri cyo cyaremwe mu izahabu icuzwe. Uko icyitegererezo cyari kiri Uwiteka yeretse Mose, aba ari ko Mose akiremesha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.4",
            "verseOrgIds": [
              "NUM.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.5",
            "verseOrgIds": [
              "NUM.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Robanura Abalewi mu Bisirayeli ubahumanure. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.6",
            "verseOrgIds": [
              "NUM.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubagenzereze utya kugira ngo ubahumanure: ubamisheho amazi y'impongano y'ibyaha, biyogosheshe umubiri wose, bamese imyenda yabo bihumanure. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.7",
            "verseOrgIds": [
              "NUM.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bende ikimasa cy'umusore, n'ituro ryo guturanwa na cyo ry'ifu y'ingezi yavuganywe n'amavuta ya elayo, wende n'ikimasa cy'umusore kindi ho igitambo cyo gutambirwa ibyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.8",
            "verseOrgIds": [
              "NUM.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umurike Abalewi imbere y'ihema ry'ibonaniro, uteranye iteraniro ry'Abisirayeli ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.9",
            "verseOrgIds": [
              "NUM.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umurike Abalewi imbere y'Uwiteka, Abisirayeli babarambikeho ibiganza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.10",
            "verseOrgIds": [
              "NUM.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni azungurize Abalewi imbere y'Uwiteka babe ituro rijungujwe, babe mu cyimbo cy'Abisirayeli,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "babe . . . Abisirayeli:",
              "type": "text"
            },
            {
              "text": "cyangwa, rituwe n'Abisirayeli.",
              "type": "text"
            }
          ]
        },
        {
          "text": " babe abo gukora umurimo w'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.11",
            "verseOrgIds": [
              "NUM.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewi barambike ibiganza mu mpanga z'ibyo bimasa: utambire Uwiteka kimwe ho igitambo gitambirwa ibyaha, n'ikindi ho igitambo cyoswa, ubihongerere Abalewi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.12",
            "verseOrgIds": [
              "NUM.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ushyire Abalewi imbere ya Aroni n'abana be, ubazunguze babe ituro rijungurijwe Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.13",
            "verseOrgIds": [
              "NUM.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko abe ari ko utandukanya Abalewi n'Abisirayeli bandi, Abalewi babe abanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.14",
            "verseOrgIds": [
              "NUM.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abalewi babone kwinjirira gukora imirimo yo mu ihema ry'ibonaniro. Ubahumanure, ubazunguze babe ituro rijungujwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.15",
            "verseOrgIds": [
              "NUM.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mbahawe rwose mu Bisirayeli, mbītoreye gusubira mu cyimbo cy'abana b'uburiza bose, imfura z'Abisirayeli zose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.16",
            "verseOrgIds": [
              "NUM.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.2"
              },
              "items": [
                {
                  "text": "Kuva 13.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko uburiza bw'Abisirayeli bwose ari ubwanjye, ubw'abantu n'ubw'amatungo, nabwiyereje kuri wa munsi niciragaho uburiza bwo mu gihugu cya Egiputa bwose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.17",
            "verseOrgIds": [
              "NUM.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ntoye Abalewi mu cyimbo cy'imfura z'Abisirayeli zose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.18",
            "verseOrgIds": [
              "NUM.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nahereye Aroni n'abana be Abalewi kugira ngo babe ababo mu Bisirayeli, bakorere mu ihema ry'ibonaniro imirimo ikwiriye Abisirayeli, bahongerere Abisirayeli kugira ngo Abisirayeli badaterwa n'umuze, nibigira hafi y'Ahera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.19",
            "verseOrgIds": [
              "NUM.8.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Mose na Aroni n'iteraniro ry'Abisirayeli ryose bagenza Abalewi. Uko Uwiteka yategetse Mose ku by'Abalewi kose, abe ari ko Abisirayeli babagenza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalewi bihumanure ibyaha, bamese imyenda yabo, Aroni abazungurize imbere y'Uwiteka babe ituro rijungujwe, Aroni abahongererere kubahumanura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abalewi babona kwinjira gukora imirimo yabo yo mu ihema ry'ibonaniro imbere ya Aroni n'abana be. Uko Uwiteka yategetse Mose ku by'Abalewi, abe ari ko babagenza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
