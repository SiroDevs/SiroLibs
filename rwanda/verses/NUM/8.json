          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ibi ni byo nkubwira ku Balewi: abamaze imyaka y'ubukuru makumyabiri n'itanu cyangwa isāga binjire mu bugaragu bw'ihema ry'ibonaniro, bajye barikoreramo imirimo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.24",
            "verseOrgIds": [
              "NUM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamara imyaka y'ubukuru mirongo itanu, bave muri ubwo bugaragu be kugumya gukora imirimo iruhije. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.25",
            "verseOrgIds": [
              "NUM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bajye bafasha bene wabo mu ihema ry'ibonaniro kurinda ibyo barindishijwe, be gukora imirimo iruhije. Uko abe ari ko ugenza Abalewi ku by'imirimo yabo.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.26",
            "verseOrgIds": [
              "NUM.8.26"
            ]
          }
        }
      ]
    }
