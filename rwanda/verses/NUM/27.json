              },
              "items": [
                {
                  "text": "Mar 6.34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " wo kubajya imbere ava mu rugo akabāhura, no kubajya imbere arugarukamo akabacyura, kugira ngo iteraniro ry'Uwiteka ritamera nk'intama zitagira umwungeri.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uwiteka aha Yosuwa ubutware bwa Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
