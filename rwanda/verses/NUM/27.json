                "loc": "EXO.24.13"
              },
              "items": [
                {
                  "text": "Kuva 24.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwiteka abwira Mose ati “Jyana Yosuwa mwene Nuni, umuntu urimo Umwuka, umurambikeho ikiganza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umushyire imbere ya Eleyazari umutambyi n'iteraniro ryose, umwihanangirize mu maso yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umuhe ku cyubahiro cyawe, kugira ngo iteraniro ry'Abisirayeli ryose rijye rimwumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.30"
              },
              "items": [
                {
                  "text": "Kuva 28.30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.41"
              },
              "items": [
                {
                  "text": "1 Sam 14.41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.6"
              },
              "items": [
                {
                  "text": "28.6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ajye ahagarara imbere ya Eleyazari umutambyi, na we ajye imbere yanjye amumbarishirize kungura inama kwa Urimu. Eleyazari azabe ari we ujya ategeka kwahuka kwabo no gucyurwa kwabo, kwa Yosuwa n'Abisirayeli bose, iteraniro ryabo ryose.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abigenza uko Uwiteka yamutegetse: ajyana Yosuwa amushyira imbere ya Eleyazari umutambyi n'iteraniro ryose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
