            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.23+DEU.3.24+DEU.3.25+DEU.3.26+DEU.3.27"
              },
              "items": [
                {
                  "text": "Guteg 3.23-27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.48+DEU.32.49+DEU.32.50+DEU.32.51+DEU.32.52"
              },
              "items": [
                {
                  "text": "32.48-52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka abwira Mose ati “Uzazamuke uyu musozi wa Abarimu, witēgere igihugu nahaye Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numara kucyitēgera nawe uzapfa, usange ubwoko bwawe nk'uko Aroni mwene so yabusanze, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mwagomereye itegeko ryanjye mu butayu bwa Zini, ubwo iteraniro ryitonganyaga, ntimwerekanire kwera kwanjye ku mazi mu maso yaryo.” Ayo ni yo mazi y'i Meriba y'i Kadeshi yo mu butayu bwa Zini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
