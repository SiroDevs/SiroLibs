          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleyazari mwene Aroni abe umutware utwara abatware b'Abalewi, ajye akoresha abarindishijwe iby'Ahera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
