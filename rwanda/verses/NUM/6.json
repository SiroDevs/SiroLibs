            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Iryo ni ryo tegeko ry'uhiga umuhigo w'ubunaziri, n'iry'amaturo aturira Uwiteka ubunaziri bwe, utabariyeho ibyo yabasha gutura adategetswe. Umuhigo yahize awuhigure uko itegeko ry'ubunaziri bwe ritegeka.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umugisha abatambyi basabiraga Abisirayeli",
          "type": "text"
        }
      ]
    },
