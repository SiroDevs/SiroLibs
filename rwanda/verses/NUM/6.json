        "style": "s1"
      },
      "items": [
        {
          "text": "Itegeko ry'Abanaziri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
