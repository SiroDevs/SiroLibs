          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gitondo Balaki ajyana Balāmu, amuzamura umusozi witwa Bamotibāli, yitegera impera imwe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.41",
            "verseOrgIds": [
              "NUM.22.41"
            ]
          }
