          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo bajya bahamagarwa mu iteraniro, ni bo batware b'imiryango ya ba sekuruza, ni bo bategeka b'ibihumbi by'Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.16",
            "verseOrgIds": [
              "NUM.1.16"
            ]
          }
        }
      ]
