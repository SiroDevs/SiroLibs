          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Uwiteka yabwiye Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.48",
            "verseOrgIds": [
              "NUM.1.48"
            ]
          }
        },
        {
