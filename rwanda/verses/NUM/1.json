            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni bajyana abo bantu bavuzwe amazina, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.17",
            "verseOrgIds": [
              "NUM.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "bateranya iteraniro ryose ku munsi wa mbere w'ukwezi kwa kabiri. Amavuko y'abantu yandikwa nk'uko imiryango yabo iri, nk'uko amazu ya ba sekuru ari, babara amazina yabo umwe umwe y'abamaze imyaka makumyabiri n'isāga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.18",
            "verseOrgIds": [
              "NUM.1.18"
            ]
          }
        },
        {
          "name": "verse",
