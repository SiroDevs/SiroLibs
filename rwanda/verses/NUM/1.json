            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Aya ni yo mazina y'abantu bakwiriye guhagararana namwe:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5",
            "verseOrgIds": [
              "NUM.1.5"
