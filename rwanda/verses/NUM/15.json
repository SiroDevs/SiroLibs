          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.37",
            "verseOrgIds": [
              "NUM.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.22.12"
              },
              "items": [
                {
                  "text": "Guteg 22.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Bwira Abisirayeli batere inshunda ku misozo y'imyenda yabo, bagumye kubikora mu bihe byabo byose, kandi badode ku nshunda zo ku musozo wose agashumi k'umukara wa kabayonga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.38",
            "verseOrgIds": [
              "NUM.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo nshunda muzambarire kugira ngo muzitegereze, mwibuke amategeko y'Uwiteka yose muyitondere, mwe gukurikiza kwifuza kw'imitima yanyu n'ukw'amaso yanyu, bikunda kubavusha mu isezerano, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.39",
            "verseOrgIds": [
              "NUM.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mwibuke mwitondere amategeko yanjye yose, mubere Imana yanyu abera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.40",
            "verseOrgIds": [
              "NUM.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi Uwiteka Imana yanyu yabakuriye mu gihugu cya Egiputa kuba Imana yanyu. Ndi Uwiteka Imana yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.41",
            "verseOrgIds": [
              "NUM.15.41"
            ]
          }
        }
      ]
