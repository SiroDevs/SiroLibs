          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mirimo yabo, Abagerushoni bajye bategekwa na Aroni n'abana be, ku byo baremērwa byose, no ku mirimo bakora yose, mubarindishe ibyo bakwiriye kuremērwa byose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
