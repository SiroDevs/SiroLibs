              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka abwira Mose ati ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.21",
            "verseOrgIds": [
              "NUM.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bara umubare w'Abagerushoni na bo nk'uko amazu ya ba sekuru ari, nk'uko imiryango yabo iri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.22",
            "verseOrgIds": [
              "NUM.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubare abasāgije imyaka y'ubukuru mirongo itatu batarasāza mirongo itanu, abakwiriye gukora umurimo wo mu ihema ry'ibonaniro bose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.23",
            "verseOrgIds": [
              "NUM.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi abe ari yo mirimo imiryango y'Abagerushoni bakwiriye gukora, n'ibyo bakwiriye kuremērwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bajye baremērwa ibikombate bisakara ubuturo bwera, n'ihema ry'ibonaniro n'ikirisakara, n'igicirane cy'impu za tahashi gisakara hejuru y'icyo, n'umwenda ukinga umuryango w'ihema ry'ibonaniro, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'imyenda ikinzwe y'urugo rw'ubwo buturo, n'umwenda ukinga irembo ry'urwo rugo rugota ubuturo n'igicaniro, n'imigozi yabyo n'ibintu byose bifatanye na byo, kandi bajye bakora imirimo yabyo yose. ",
          "type": "text",
          "attrs": {
