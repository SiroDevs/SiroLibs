              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.16",
            "verseOrgIds": [
              "JAS.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uzi gukora neza ntabikore, bimubereye icyaha.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.17",
            "verseOrgIds": [
              "JAS.4.17"
            ]
          }
        }
      ]
