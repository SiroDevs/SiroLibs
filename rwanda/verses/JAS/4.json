        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.27.1"
              },
              "items": [
                {
                  "text": "Imig 27.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nimwumve yemwe abavuga muti “Uyu munsi cyangwa ejo tuzajya mu mudugudu w'inaka tumareyo umwaka, dutunde tubone indamu”, ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.13",
            "verseOrgIds": [
              "JAS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyamara mutazi ibizaba ejo. Mbese ubugingo bwanyu ni iki? Muri igihu kiboneka umwanya muto kigaherako kigatamūka. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.14",
            "verseOrgIds": [
              "JAS.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo ibyo mwari mukwiriye kuvuga ni ibi, ngo “Umwami Imana nibishaka tuzarama, kandi tuzakora dutya na dutya.” ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.15",
            "verseOrgIds": [
              "JAS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko dore mwiratana ibyo mudashobora kwigezaho, bene iyo myirato yose ni mibi.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.16",
            "verseOrgIds": [
              "JAS.4.16"
            ]
          }
        }
      ]
    },
