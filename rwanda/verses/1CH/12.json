          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basibirayo gatatu bari kumwe na Dawidi barya banywa, kuko bene wabo bari babahishiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.40",
            "verseOrgIds": [
              "1CH.12.40"
            ]
          }
