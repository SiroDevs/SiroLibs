          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo ngabo zose z'abantu babashaga kwirema inteko, bazanywe i Heburoni bafite umutima utunganye no kwimika Dawidi ngo abe umwami wa Isirayeli yose, kandi n'abandi Bisirayeli bose bari bahuje umutima wo kwimika Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
            "verseOrgIds": [
              "1CH.12.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
