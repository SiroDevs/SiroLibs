              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abana ba Ketura inshoreke ya Aburahamu yabyaye Zimurani na Yokishani, na Medani na Midiyani, na Yishibaki na Shuwa. Kandi abahungu ba Yokishani ni Sheba na Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.32",
            "verseOrgIds": [
              "1CH.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahungu ba Midiyani ni Efa na Eferi, na Hanoki na Abida na Eluda. Abo bose bari abahungu ba Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.1.33",
            "verseOrgIds": [
              "1CH.1.33"
            ]
          }
        }
      ]
    },
