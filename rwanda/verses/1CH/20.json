        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.7",
            "verseOrgIds": [
              "1CH.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo babyawe na cya gihanda cy'i Gati, batsembwa na Dawidi n'abagaragu be.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.8",
            "verseOrgIds": [
              "1CH.20.8"
            ]
