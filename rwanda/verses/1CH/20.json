                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bukeye hongera kuba intambara y'Abafilisitiya. Eluhanani mwene Yayiri yica Lahumi murumuna wa Goliyati w'Umugiti, uruti rw'icumu rye rwari rumeze nk'igiti kiboherwaho imyenda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.5",
            "verseOrgIds": [
              "1CH.20.5"
            ]
          }
        }
