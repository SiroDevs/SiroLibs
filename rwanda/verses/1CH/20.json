            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hanyuma y'ibyo habaho intambara y'Abafilisitiya i Gezeri. Muri iyo ntambara Sibekayi w'Umuhusha yica Sipayi wo mu bana b'igihanda, maze baraneshwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
