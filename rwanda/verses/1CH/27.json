          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maharayi w'Umunyanetofa w'Abazera, ni we wari umutware wa cumi wo mu kwezi kwa cumi. Mu gihe cye harimo abantu inzovu ebyiri n'ibihumbi bine.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.13",
            "verseOrgIds": [
              "1CH.27.13"
            ]
          }
        }
