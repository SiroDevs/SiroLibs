          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benaya w'Umunyapiratoni w'Abefurayimu, ni we wari umutware wa cumi n'umwe wo mu kwezi kwa cumi na kumwe. Mu gihe cye harimo abantu inzovu ebyiri n'ibihumbi bine.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.14",
            "verseOrgIds": [
              "1CH.27.14"
            ]
