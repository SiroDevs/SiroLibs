          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heludayi w'Umunyanetofa mwene Otiniyeli, ni we wari umutware wa cumi na babiri wo mu kwezi kwa cumi na babiri. Mu gihe cye harimo abantu inzovu ebyiri n'ibihumbi bine.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.15",
            "verseOrgIds": [
              "1CH.27.15"
            ]
