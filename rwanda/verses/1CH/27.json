          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiturayi w'i Sharoni ni we wari umutahira w'amashyo yarishirizaga i Sharoni, kandi Shafati mwene Adulayi ni we wari umutahira w'amashyo yo mu mibande.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.29",
            "verseOrgIds": [
              "1CH.27.29"
            ]
          }
        }
      ]
