          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obili w'Umwishimayeli ni we wari umutware w'ingamiya, na Yedeya w'Umunyameronoti ni we wari umutware w'indogobe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.30",
            "verseOrgIds": [
              "1CH.27.30"
            ]
          }
        }
      ]
