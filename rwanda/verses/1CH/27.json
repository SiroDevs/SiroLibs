          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyezeri w'Umunyanatoti w'Ababenyamini, ni we wari umutware wa cyenda wo mu kwezi kwa cyenda. Mu gihe cye harimo abantu inzovu ebyiri n'ibihumbi bine.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.12",
            "verseOrgIds": [
              "1CH.27.12"
            ]
          }
        }
