          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bālihanani w'i Gederi ni we wari umutware w'imyelayo n'imishishima yo mu kibaya, na Yowasi ni we wari umutware w'ububiko bw'amavuta.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.27.28",
            "verseOrgIds": [
              "1CH.27.28"
            ]
          }
