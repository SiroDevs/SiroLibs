              "items": [
                {
                  "text": "1 Abami 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko Salomo yicara ku ntebe y'ubwami y'Uwiteka, ari umwami mu cyimbo cya se Dawidi, agubwa neza. Abisirayeli bose baramwumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.23",
            "verseOrgIds": [
              "1CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatware bose n'abagabo b'abanyambaraga, n'abana b'Umwami Dawidi bose bayoboka Umwami Salomo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.24",
            "verseOrgIds": [
              "1CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka yogeza Salomo cyane imbere y'Abisirayeli bose, amuha icyubahiro cy'ubwami kitari cyabaye ku mwami wese wamubanjirije mu Bisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.29.25",
            "verseOrgIds": [
              "1CH.29.25"
            ]
          }
        }
      ]
    },
    {
