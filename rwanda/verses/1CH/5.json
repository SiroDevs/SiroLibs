          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleyazari abyara Finehasi, Finehasi abyara Abishuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.30",
            "verseOrgIds": [
              "1CH.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishuwa abyara Buki, Buki abyara Uzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.31",
            "verseOrgIds": [
              "1CH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzi abyara Zerahiya, Zerahiya abyara Merayoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.32",
            "verseOrgIds": [
              "1CH.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Merayoti abyara Amariya, Amariya abyara Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.33",
            "verseOrgIds": [
              "1CH.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubu abyara Sadoki, Sadoki abyara Ahimāzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.34",
            "verseOrgIds": [
              "1CH.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimāzi abyara Azariya, Azariya abyara Yohanani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.35",
            "verseOrgIds": [
              "1CH.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohanani abyara Azariya, (ari we wakoraga umurimo w'ubutambyi mu nzu Salomo yubatse i Yerusalemu). ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.36",
            "verseOrgIds": [
              "1CH.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya abyara Amariya, Amariya abyara Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.37",
            "verseOrgIds": [
              "1CH.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitubu abyara Sadoki, Sadoki abyara Shalumu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.38",
            "verseOrgIds": [
              "1CH.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu abyara Hilukiya, Hilukiya abyara Azariya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.39",
            "verseOrgIds": [
              "1CH.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya abyara Seraya, Seraya abyara Yehosadaki. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.40",
            "verseOrgIds": [
              "1CH.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehosadaki yajyagiye ari umunyagano, ubwo Uwiteka yanyagishaga Abayuda n'ab'i Yerusalemu Nebukadinezari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.41",
            "verseOrgIds": [
              "1CH.5.41"
            ]
          }
        }
