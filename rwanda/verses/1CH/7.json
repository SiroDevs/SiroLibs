              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu we yari Refa na Reshefu na Tela umuhungu we, mwene Tela ni Tahani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
