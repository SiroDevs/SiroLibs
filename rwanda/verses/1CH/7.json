          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kandi umukobwa we yitwaga Shēra, ari we wubatse i Betihoroni yo hepfo n'iyo haruguru, na Uzenishēra).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
