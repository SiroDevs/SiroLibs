          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi no ku ngabano z'Abamanase: i Betisheyani n'imidugudu yaho, n'i Tānaki n'imidugudu yaho, n'i Megido n'imidugudu yaho, n'i Dori n'imidugudu yaho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
