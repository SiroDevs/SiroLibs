    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, umuntu niyadukwaho n'icyaha",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "niyadukwaho n'icyaha:",
              "type": "text"
            },
            {
              "text": "cyangwa, nafatirwa mu cyaha.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", mwebwe ab'Umwuka mugaruze uwo muntu umwuka w'ubugwaneza, ariko umuntu wese yirinde kugira ngo na we adashukwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.1",
            "verseOrgIds": [
              "GAL.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakirane ibibaremerera",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Mwakirane ibibaremerera:",
              "type": "text"
            },
            {
              "text": "cyangwa, Mufashanye mu bibaremerera.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", kugira ngo abe ari ko musohoza amategeko ya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.2",
            "verseOrgIds": [
              "GAL.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyibwira ko ari ikintu kandi ari nta cyo ari cyo, aba yibeshye. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.3",
            "verseOrgIds": [
              "GAL.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyiza ni uko yakwisuzuma mu murimo we ubwe, kuko ari bwo azabona icyo yirata ku bwe wenyine atari ku bwa mugenzi we, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.4",
            "verseOrgIds": [
              "GAL.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko umuntu wese aziyikorera uwe mutwaro.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.5",
            "verseOrgIds": [
              "GAL.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwigishwa ijambo ry'Imana agabane n'umwigisha ibyiza byose.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.6",
            "verseOrgIds": [
              "GAL.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuyobe: Imana ntinegurizwa izuru, kuko ibyo umuntu abiba ari byo azasarura. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.7",
            "verseOrgIds": [
              "GAL.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubibira umubiri we muri uwo mubiri azasaruramo kubora, ariko ubibira Umwuka muri uwo Mwuka azasaruramo ubugingo buhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.8",
            "verseOrgIds": [
              "GAL.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twe gucogorera gukora neza, kuko igihe nigisohora tuzasarura nitutagwa isari. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.9",
            "verseOrgIds": [
              "GAL.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero tugirire bose neza uko tubonye uburyo, ariko cyane cyane ab'inzu y'abizera.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.10",
            "verseOrgIds": [
              "GAL.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murebe namwe uburyo mbandikishirije inyuguti nini n'ukwanjye kuboko: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.11",
            "verseOrgIds": [
              "GAL.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ABASHAKA BOSE KWIHA IGIKUNDIRO KU BY'UMUBIRI NI BO BABAHATA GUKEBWA. NTA YINDI MPAMVU IBIBATEYE, KERETSE KUGIRA NGO BATARENGANYWA BAZIZE UMUSARABA WA KRISTO. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.12",
            "verseOrgIds": [
              "GAL.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndetse abakebwe ubwabo nubwo badakomeza amategeko, nyamara bashaka ko mukebwa ngo babone uko birata ku bw'imibiri yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.13",
            "verseOrgIds": [
              "GAL.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jyeweho sinkiratana ikindi, keretse umusaraba w'Umwami wacu Yesu Kristo wateye ko iby'isi bimbera nk'ibibambwe, nanjye nkabera iby'isi nk'ubambwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.14",
            "verseOrgIds": [
              "GAL.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko gukebwa kutagira umumaro cyangwa kudakebwa, keretse kuba ikiremwa gishya. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.15",
            "verseOrgIds": [
              "GAL.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abazajya bakurikiza ibyo amahoro n'imbabazi bibe muri bo, bibe no mu Bisirayeli b'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.16",
            "verseOrgIds": [
              "GAL.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye none ntihakagire umuntu undushya, kuko mfite ku mubiri inkovu za Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.17",
            "verseOrgIds": [
              "GAL.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ubuntu bw'Umwami wacu Yesu Kristo bubane n'imitima yanyu. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.6.18",
            "verseOrgIds": [
              "GAL.6.18"
            ]
          }
        }
      ]
    }
  ],
