              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26.9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwumvise ingeso zanjye nari mfite kera ngikurikiza idini y'Abayuda, yuko nari nkabije kurenganya Itorero ry'Imana no kuririmbura. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Ibyak 22.3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi narushije benshi bo mu bwoko bwacu tungana gukurikiza idini y'Abayuda, kuko nabarushaga kugira ishyaka ry'imigenzo twahawe na ba sogokuruza.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        }
      ]
    },
