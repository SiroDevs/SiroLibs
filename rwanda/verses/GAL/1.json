            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.13+ACT.26.14+ACT.26.15+ACT.26.16+ACT.26.17+ACT.26.18"
              },
              "items": [
                {
                  "text": "26.13-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko Imana yantoranije nkiri mu nda ya mama, impamagara ku bw'ubuntu bwayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ubwo yashimaga kumpishurira Umwana wayo ngo mvuge ubutumwa bwe bwiza mu banyamahanga, sinahereye ko ngisha inama abafite umubiri n'amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
              "GAL.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "cyangwa ngo nzamuke njye i Yerusalemu gusanga abambanjirije kuba intumwa, ahubwo nagiye muri Arabiya kandi mvuyeyo nsubira i Damasiko.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.17",
            "verseOrgIds": [
              "GAL.1.17"
            ]
          }
        }
      ]
    },
