          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Zerubabeli umutegeka w'u Buyuda uti ‘Nzatigisa ijuru n'isi ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
