          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry'Uwiteka riza kuri Hagayi ubwa kabiri ku munsi wa makumyabiri n'ine w'ukwezi riti ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
