          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatambyi baramusubiza bati “Oya.”",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        }
      ]
