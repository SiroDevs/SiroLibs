            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "text": " kuri bo ni ikimenyetso cyo kurimbuka kwabo, naho kuri mwe ni ikimenyetso cy'agakiza kanyu kava ku Mana. ",
          "type": "text",
          "attrs": {
