              "items": [
                {
                  "text": "Ibyak 16.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Pawulo na Timoteyo imbata za Kristo Yesu, turabandikiye mwebwe abera bo muri Kristo Yesu b'i Filipi bose, hamwe n'abepisikopi n'abadiyakoni.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
