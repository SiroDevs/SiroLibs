        },
        {
          "text": "Ba bakuru makumyabiri na bane bicara ku ntebe zabo imbere y'Imana, bikubita hasi bubamye baramya Imana bati ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
