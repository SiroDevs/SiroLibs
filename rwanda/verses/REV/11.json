                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Iyo minsi itatu n'igice ishize, umwuka w'ubugingo uva ku Mana winjira muri bo baherako barahaguruka, ubwoba bwinshi butera ababibonye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ababibonye:",
              "type": "text"
            },
            {
              "text": "cyangwa, abababonye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
