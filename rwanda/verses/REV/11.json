              },
              "items": [
                {
                  "text": "Zek 2.5-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bampa urubingo rusa n'inkoni bati “Haguruka ugere urusengero rw'Imana n'igicaniro n'abasengeramo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luka 21.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ariko urugo rw'urusengero urureke nturugere kuko rwahawe abanyamahanga, kandi umudugudu wera bazamara amezi mirongo ine n'abiri bawukandagira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahamya banjye babiri nzabaha guhanura, bahanure iminsi igihumbi na magana abiri na mirongo itandatu bambaye ibigunira.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
    {
