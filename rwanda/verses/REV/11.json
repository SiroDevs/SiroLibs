              "items": [
                {
                  "text": "2 Abami 2.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bumva ijwi rirenga rivugira mu ijuru ribabwira riti “Nimuzamuke muze hano.” Nuko bazamukira mu gicu bajya mu ijuru abanzi babo babireba. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
