              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.4.11+ZEC.4.12+ZEC.4.13+ZEC.4.14"
              },
              "items": [
                {
                  "text": "11-14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Abo bahamya ni bo biti bya elayo bibiri n'ibitereko by'amatabaza bibiri, bihagarara imbere y'Umwami w'isi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iyo umuntu ashatse kubagirira nabi umuriro ubava mu kanwa ukotsa abanzi babo, kandi nihagira umuntu ushaka kubagirira nabi, uko ni ko akwiriye kwicwa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Abami 17.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.17+EXO.7.18+EXO.7.19"
              },
              "items": [
                {
                  "text": "Kuva 7.17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.8"
              },
              "items": [
                {
                  "text": "1 Sam 4.8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bafite ubushobozi bwo gukinga ijuru ngo imvura itagwa mu minsi yo guhanura kwabo, kandi bafite ubushobozi bwo guhindura amazi amaraso no guteza isi ibyago byose uko bashatse.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        }
      ]
