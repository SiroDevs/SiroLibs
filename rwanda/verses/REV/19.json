          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ba bakuru makumyabiri na bane na bya bizima bine bikubita hasi, basenga Imana yicara kuri irya ntebe bati “Amen, Haleluya!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        }
      ]
    },
