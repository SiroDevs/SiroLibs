              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Arambwira ati “Andika uti ‘Hahirwa abatorewe ubukwe bw'Umwana w'Intama.’ ” Kandi ati “Ayo ni amagambo y'ukuri kw'Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
