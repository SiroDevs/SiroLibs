              "items": [
                {
                  "text": "Yes 34.10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Barongera bati “Haleluya! Umwotsi we uhora ucumba iteka ryose.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
