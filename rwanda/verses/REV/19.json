              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y'ibyo numva mu ijuru ijwi rirenga risa n'iry'abantu benshi bavuga bati “Haleluya! Agakiza n'icyubahiro n'ubutware ni iby'Imana yacu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.43"
              },
              "items": [
                {
                  "text": "Guteg 32.43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.7"
              },
              "items": [
                {
                  "text": "2 Abami 9.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kuko amateka yayo ari ay'ukuri no gukiranuka. Yaciriye ho iteka maraya uwo ukomeye, wononeshaga abari mu isi ubusambanyi bwe, kandi imuhōreye amaraso y'imbata zayo.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
