            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Hanyuma y'ibyo mbona urusengero rw'ihema ryo guhamya ryo mu ijuru rukinguye, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruvamo ba bamarayika barindwi bafite bya byago birindwi, bambaye imyenda y'ibitare itanduye irabagirana, kandi bambaye imishumi y'izahabu mu bituza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwe muri bya bizima bine giha abo bamarayika barindwi inzabya ndwi z'izahabu, zuzuye umujinya w'Imana ihoraho iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
