              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bya bizima bine birikiriza biti “Amen!” Ba bakuru bikubita hasi baramya ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
              "REV.5.14"
            ]
          }
        },
        {
