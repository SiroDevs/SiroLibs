                "loc": "DAN.7.10"
              },
              "items": [
                {
                  "text": "Dan 7.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ndareba numva ijwi ry'abamarayika benshi bagose ya ntebe na bya bizima na ba bakuru, umubare wabo wari inzovu incuro inzovu n'uduhumbi n'agahumbagiza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuga ijwi rirenga bati “Umwana w'Intama watambwe ni we ukwiriye guhabwa ubutware, n'ubutunzi n'ubwenge n'imbaraga, no guhimbazwa n'icyubahiro n'ishimwe!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko numva ibyaremwe byose byo mu ijuru no mu isi, n'ikuzimu no mu nyanja n'ibibirimo byose bivuga biti “Ishimwe no guhimbazwa n'icyubahiro n'ubutware bibe iby'Iyicaye ku ntebe n'iby'Umwana w'Intama iteka ryose.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
