            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Ezek 40.3",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwavuganaga nanjye yari afite urugero rw'urubingo rw'izahabu, kugira ngo agere urwo rurembo n'amarembo yarwo n'inkike zarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urwo rurembo rungana impande zose, uburebure bungana n'ubugari. Ageresha urwo rurembo rwa rubingo, ageramo sitadiyo",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "sitadiyo",
              "type": "text"
            },
            {
              "text": "ni urugendo rwa metero 200.",
              "type": "text"
            }
          ]
        },
        {
          "text": " inzovu n'ibihumbi bibiri, uburebure bw'umurambararo n'ubugari n'uburebure bw'igihagararo birangana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
