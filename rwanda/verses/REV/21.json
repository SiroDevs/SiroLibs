                "loc": "REV.3.12"
              },
              "items": [
                {
                  "text": "Ibyah 3.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbona ururembo rwera Yerusalemu nshya rumanuka ruva mu ijuru ku Mana, rwiteguwe nk'uko umugeni arimbishirizwa umugabo we. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Ezek 37.27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.11+LEV.26.12"
              },
              "items": [
                {
                  "text": "Lewi 26.11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Numva ijwi rirenga rivuye kuri ya ntebe rivuga riti “Dore ihema ry'Imana riri hamwe n'abantu kandi izaturana na bo, na bo bazaba abantu bayo kandi Imana ubwayo izabana na bo ibe Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.8"
              },
              "items": [
                {
                  "text": "Yes 25.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.10"
              },
              "items": [
                {
                  "text": "35.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "65.19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Izahanagura amarira yose ku maso yabo kandi urupfu ntiruzabaho ukundi, kandi umuborogo cyangwa gutaka cyangwa kuribwa ntibizabaho ukundi kuko ibya mbere bishize.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
