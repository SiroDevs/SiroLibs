            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Inkike zarwo zubakishijwe yasipi, naho ururembo ubwarwo rwubakishijwe izahabu nziza imeze nk'ibirahuri byiza. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
