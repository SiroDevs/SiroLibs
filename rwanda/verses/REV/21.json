                }
              ]
            }
          ]
        },
        {
          "text": " Kandi urwo rurembo ntirugomba kuvirwa n'izuba cyangwa n'ukwezi, kuko ubwiza bw'Imana ari bwo buruvira kandi Umwana w'Intama ari we tabaza ryarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
