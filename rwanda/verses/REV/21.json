                {
                  "text": "Yes 55.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kandi iti “Birarangiye. Ni jye Alufa na Omega, itangiriro n'iherezo. Ufite inyota nzamuhera ubuntu kunywa ku isoko y'amazi y'ubugingo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Sam 7.14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27+PSA.89.28"
              },
              "items": [
                {
                  "text": "Zab 89.27-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Unesha azaragwa byose, nanjye nzaba Imana ye na we abe umwana wanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abanyabwoba n'abatizera, n'abakora ibizira n'abicanyi, n'abasambanyi n'abarozi n'abasenga ibishushanyo",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ibishushanyo:",
              "type": "text"
            },
            {
              "text": "cyangwa, ibigirwamana.",
              "type": "text"
            }
          ]
        },
        {
          "text": " n'abanyabinyoma bose, umugabane wabo uzaba mu nyanja yaka umuriro n'amazuku ari yo rupfu rwa kabiri.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
