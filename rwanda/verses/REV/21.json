          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyicara kuri ya ntebe iravuga iti “Dore byose ndabihindura bishya.” Kandi iti “Andika kuko ayo magambo ari ayo kwizerwa n'ay'ukuri.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        }
      ]
    },
    {
