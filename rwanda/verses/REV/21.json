            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfatiro z'inkike z'urwo rurembo zarimbishijwe amabuye y'igiciro cyinshi y'amoko yose. Urufatiro rwa mbere rwari yasipi, urwa kabiri rwari safiro, urwa gatatu rwari kalukedoni, urwa kane rwari simaragido, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
