              },
              "items": [
                {
                  "text": "2 Pet 3.13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mbona ijuru rishya n'isi nshya, kuko ijuru rya mbere n'isi ya mbere byari byashize, n'inyanja yari itakiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
