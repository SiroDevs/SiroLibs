            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.10.21"
              },
              "items": [
                {
                  "text": "Kuva 10.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Marayika wa gatanu asuka urwabya rwe ku ntebe y'ubwami ya ya nyamaswa. Ubwami bwayo bucura umwijima, kuribwa gutuma bahekenya indimi zabo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.10",
            "verseOrgIds": [
              "REV.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kuribwa kwabo n'ibisebe byabo bituma batuka Imana nyir'ijuru, ntibīhana imirimo yabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.11",
            "verseOrgIds": [
              "REV.16.11"
            ]
          }
        }
      ]
    },
