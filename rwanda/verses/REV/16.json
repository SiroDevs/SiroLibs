              },
              "items": [
                {
                  "text": "Kuva 9.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Uwa mbere aragenda asuka urwabya rwe mu isi, abantu bafite ikimenyetso cya ya nyamaswa bakaramya igishushanyo cyayo bafatwa n'ibisebe bikomeye bibi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.2",
            "verseOrgIds": [
              "REV.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwa kabiri asuka urwabya rwe mu nyanja ihinduka amaraso nk'ay'intumbi, ikintu cyose cyo mu nyanja gifite ubugingo kirapfa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.3",
            "verseOrgIds": [
              "REV.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
