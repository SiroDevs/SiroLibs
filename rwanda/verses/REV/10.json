              },
              "items": [
                {
                  "text": "Amosi 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Marayika nabonye ahagaze ku nyanja no ku butaka amanika ukuboko kwe kw'iburyo, agutunga mu ijuru ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "arahira Ihoraho iteka ryose yaremye ijuru n'ibirimo, n'isi n'ibiyirimo n'inyanja n'ibiyirimo ati “Ntihazabaho igihe ukundi",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ntihazabaho igihe ukundi:",
              "type": "text"
            },
            {
              "text": "cyangwa, Ntibigitinze.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo mu minsi y'ijwi rya marayika wa karindwi ubwo azatangira kuvuza impanda, ni ho ubwiru bw'Imana buzaba busohoye nk'uko yabwiye imbata zayo ari zo bahanuzi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
