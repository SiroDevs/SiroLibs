        },
        {
          "text": "Bukeye abanzi b'Abayuda n'ab'Ababenyamini, bumvise yuko abavukiye mu bunyage bubakira Uwiteka Imana ya Isirayeli urusengero, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
