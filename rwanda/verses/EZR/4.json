                "loc": "EST.1.1"
              },
              "items": [
                {
                  "text": "Esit 1.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ku ngoma ya Ahasuwerusi akijya kwima, barandika barega abaturage b'i Buyuda n'ab'i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
