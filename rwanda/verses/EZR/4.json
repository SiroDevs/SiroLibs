        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.24+2KI.17.25+2KI.17.26+2KI.17.27+2KI.17.28+2KI.17.29+2KI.17.30+2KI.17.31+2KI.17.32+2KI.17.33+2KI.17.34+2KI.17.35+2KI.17.36+2KI.17.37+2KI.17.38+2KI.17.39+2KI.17.40+2KI.17.41"
              },
              "items": [
                {
                  "text": "2 Abami 17.24-41",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " baherako begera Zerubabeli n'abatware b'amazu ya ba sekuruza, baramubwira bati “Nimureke twubakane kuko dushaka Imana yanyu, nk'uko namwe muyishaka, kandi twayitambiraga ibitambo uhereye ku ngoma ya Esarihadoni, umwami wa Ashūri watuzamuye akatuzana hano.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
