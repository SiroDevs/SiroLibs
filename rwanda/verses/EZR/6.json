            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.16",
            "verseOrgIds": [
              "EZR.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo batahaga iyo nzu y'Imana, batambye inka ijana n'amasekurume y'intama magana abiri n'abana b'intama magana ane, kandi batambira Abisirayeli bose amasekurume y'ihene cumi n'abiri, uko umubare w'imiryango y'Abisirayeli wari uri, aba igitambo cyo gukuraho ibyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.17",
            "verseOrgIds": [
              "EZR.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashyiraho abatambyi uko imigabane yabo ikurikirana, n'Abalewi bajya ku bihe byabo ngo bakorere Imana iri i Yerusalemu, nk'uko byanditswe mu gitabo cya Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.18",
            "verseOrgIds": [
              "EZR.6.18"
            ]
          }
        }
      ]
    },
