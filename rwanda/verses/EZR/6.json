            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maze abavukiye mu bunyage baziririza Pasika ku munsi wa cumi n'ine w'ukwezi kwa mbere, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.19",
            "verseOrgIds": [
              "EZR.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko abatambyi n'Abalewi bari biyereje hamwe, bose bari baboneye. Nuko babīkīra umwana w'intama wa Pasika ku bw'abavukiye mu bunyage bose, no ku bwa bene wabo na bo ubwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.20",
            "verseOrgIds": [
              "EZR.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bari bagarutse bavuye mu bunyage, n'abantu bose bari bitandukanije n'ingeso mbi z'abapagani bo muri icyo gihugu, bagafatanya n'Abisirayeli ngo bashakane Uwiteka Imana y'Abisirayeli barasangira, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.21",
            "verseOrgIds": [
              "EZR.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "baziririza iminsi mikuru irindwi y'imitsima idasembuwe banezerewe, kuko Uwiteka yabanejeje kandi yahinduye umutima w'umwami wa Ashūri akabagarukira, kandi akabatwerera amaboko yo gukora umurimo w'inzu y'Imana, ari yo Mana ya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.22",
            "verseOrgIds": [
              "EZR.6.22"
            ]
          }
        }
