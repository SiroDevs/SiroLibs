        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mu mwaka wa kabiri uhereye aho bagereye ku nzu y'Imana i Yerusalemu, mu kwezi kwa kabiri ni ho Zerubabeli mwene Sheyalutiyeli na Yeshuwa mwene Yosadaki batangiye gukora, bafatanije n'abandi batambyi n'Abalewi bene wabo, n'abavuye mu bunyage bakaza i Yerusalemu bose. Bategeka Abalewi bamaze imyaka makumyabiri n'abayishagije, ngo bahagarikire umurimo w'inzu y'Uwiteka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        }
      ]
    },
    {
