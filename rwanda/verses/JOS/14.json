              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Kub 14.30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Abayuda baherako basanga Yosuwa i Gilugali, Kalebu mwene Yefune Umukenazi aramubaza ati “Ntuzi icyo Uwiteka yatuvuzeho jyewe nawe, akabibwira Mose umuntu w'Imana turi i Kadeshi y'i Baruneya? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.1+NUM.13.2+NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15+NUM.13.16+NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30"
              },
              "items": [
                {
                  "text": "Kub 13.1-30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Icyo gihe nari maze imyaka mirongo ine, twari tukiri i Kadeshi y'i Baruneya, Mose umugaragu w'Uwiteka antuma kujya gutata igihugu. Bukeye ngarutse muhamiriza ibyo nari nabonye n'umutima utabeshya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bene data twajyanye bahīsha imitima y'abantu ubwoba, jyeweho nomatanye n'Uwiteka Imana yanjye rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.24"
              },
              "items": [
                {
                  "text": "Kub 14.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze uwo munsi Mose ararahira ati ‘Ni ukuri igihugu wakandagiyemo kizaba gakondo yawe n'iy'abana bawe iteka ryose, kuko womatanye n'Uwiteka Imana yanjye rwose.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Kalebu arongera aravuga ati “Kandi dore Uwiteka yatumye mara iyi myaka mirongo ine n'itanu nk'uko yavuze, uhereye igihe Uwiteka yabibwiriye Mose, Abisirayeli bakizerera mu butayu. None dore uyu munsi nshyikije imyaka mirongo inani n'itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu ndacyafite imbaraga nk'uko nari nzifite urya munsi Mose yanyoherejeho. Uko imbaraga zanjye zameraga ku rugamba, ntabara ngatabaruka, na n'ubu ni ko zikiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "None umpe umusozi Uwiteka yavuze urya munsi. Icyo gihe wumvaga ko Abānaki bari bahari, kandi ko hariho imidugudu minini igoswe n'inkike z'amabuye. None ahari aho Uwiteka azaba ari kumwe nanjye, mbirukane nk'uko Uwiteka yavuze.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa aha Kalebu mwene Yefune umugisha, maze amuha umusozi witwa Heburoni ngo habe gakondo ye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye i Heburoni haba gakondo ya Kalebu mwene Yefune w'Umukenazi na bugingo n'ubu, kuko yomatanye n'Uwiteka Imana y'Abisirayeli rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi i Heburoni kera hitwaga Kiriyataruba. Aruba uwo yari umuntu wo mu Bānaki ukomeye kuruta abandi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko igihugu gihabwa ihumure.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
