            "style": "v",
            "sid": "JOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa ategeka abatware b'imitwe ati ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.10",
            "verseOrgIds": [
              "JOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Munyure mu ngando mutegeke abantu muti ‘Nimukore amahamba kuko mu minsi itatu muzambuka ruriya ruzi rwa Yorodani, mujya guhindūra igihugu Uwiteka Imana yanyu yabahaye mukibemo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        }
      ]
    },
