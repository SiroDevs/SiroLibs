                }
              ]
            }
          ]
        },
        {
          "text": " Uwiteka abwira Yosuwa ati ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Abisirayeli uti ‘Mwitoranyirize imidugudu y'ubuhungiro, iyo nabategekesheje ururimi rwa Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo gatozi wishe umuntu wese, atabyitumye cyangwa atabizi ayihungiremo, kandi izajye ibabera ubuhungiro bwo guhunga umuhōzi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gatozi uhungiye muri umwe muri iyo midugudu, azahagarare ku irembo ry'uwo mudugudu yisobanurire abatware bawo, na bo bazaherako bamwinjiza mu mudugudu bamuhe aho aba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umuhōzi namukurikirayo ntibazamuhe gatozi ngo amuhore, kuko yishe mugenzi we atabyitumye, adasanzwe ari umwanzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko azagume muri uwo mudugudu kugeza ubwo azahagarara imbere y'iteraniro gucirwa urubanza na bo, ukageza n'igihe umutambyi mukuru yasanze mu butambyi azapfira, maze gatozi azaherako agaruke iwabo mu rugo rwe mu mudugudu yahunzemo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bitoranyiriza i Kedeshi y'i Galilaya mu gihugu cy'imisozi y'i Bunafutali, n'i Shekemu mu gihugu cy'imisozi y'i Bwefurayimu, n'i Kiriyataruba (ari yo Heburoni) mu gihugu cy'imisozi y'i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hakurya ya Yorodani iburasirazuba bw'i Yeriko, batoranyayo i Beseri mu butayu bwo mu bitwa h'umuryango w'Abarubeni, n'i Ramoti y'i Galeyadi h'umuryango w'Abagadi, n'i Golani y'i Bashani h'umuryango w'Abamanase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo midugudu yakubitiwe Abisirayeli bose n'umunyamahanga wese ubasuhukiyemo, kugira ngo uwishe umuntu wese atabyitumye azahungireyo ye kwicwa n'umuhōzi, kugeza ubwo azahagarara imbere y'iteraniro.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
