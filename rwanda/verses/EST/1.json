        "style": "s1"
      },
      "items": [
        {
          "text": "Ibirori by'Umwami Ahasuwerusi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
