        "style": "s1"
      },
      "items": [
        {
          "text": "Bene Rekabu banga kuva ku isezerano rya sekuruza",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
