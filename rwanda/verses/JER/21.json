          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ryaje kuri Yeremiya rivuye ku Uwiteka, igihe Umwami Sedekiya amutumyeho Pashuri mwene Malikiya, na Zefaniya mwene Māseya w'umutambyi ati ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
