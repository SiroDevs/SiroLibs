      },
      "items": [
        {
          "text": "Umwami ahanuza Yeremiya Nebukadinezari yabateye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
