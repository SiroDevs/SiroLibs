                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Ngoma 36.5-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Dan 1.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka wa kane wa Yehoyakimu mwene Yosiya umwami w'u Buyuda, (hari no mu mwaka wa mbere wa Nebukadinezari umwami w'i Babuloni), ijambo ryaje kuri Yeremiya ryerekeye ku bantu b'i Buyuda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "iryo umuhanuzi Yeremiya yabwiye ubwoko bw'u Buyuda bwose n'abatuye i Yerusalemu bose ati ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uhereye ku mwaka wa cumi n'itatu wa Yosiya mwene Amoni umwami w'u Buyuda ukageza none, maze imyaka makumyabiri n'itatu ijambo ry'Uwiteka rinzaho nkavugana namwe, nkazinduka kare nkababwira ariko ntimwumva. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka yabatumyeho abagaragu be bose b'abahanuzi, akazinduka kare akabatuma (ariko ntimwumviye habe no gutega amatwi ngo mwumve) ati ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nimuhindukire ubu, umuntu wese ave mu nzira ye mbi no mu bibi by'imirimo yanyu, mube mu gihugu Uwiteka yabahanye na ba sogokuruza uhereye kera ukageza iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntimukurikire izindi mana ngo muzikorere kandi muzisenge, mwe kunyendereza ngo ndakarire imirimo y'amaboko yanyu, kandi sinzabagirira nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntimwanyumviye, ahubwo mwandakazaga ku mirimo y'amaboko yanyu ibateza amakuba.’ ” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma Uwiteka Nyiringabo avuga atya ati “Kuko mutumviye amagambo yanjye, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "dore ngiye kohereza imiryango yose y'ikasikazi nyiteranye, kandi nzatuma ku mugaragu wanjye Nebukadinezari umwami w'i Babuloni, ni ko Uwiteka avuga, mbateze iki gihugu n'abagituyemo, n'ayo mahanga yose agikikijeho. Nzabatsemba rwose, mbagire igitangarirwa n'igitutsi n'imisaka y'iteka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.34"
              },
              "items": [
                {
                  "text": "Yer 7.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.16.9"
              },
              "items": [
                {
                  "text": "16.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.22+REV.18.23"
              },
              "items": [
                {
                  "text": "Ibyah 18.22-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze kandi nzabakuramo ijwi ryo kwishima n'ijwi ry'umunezero, ijwi ry'umukwe n'ijwi ry'umugeni, ijwi ry'urusyo n'umucyo w'urumuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.21"
              },
              "items": [
                {
                  "text": "2 Ngoma 36.21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10"
              },
              "items": [
                {
                  "text": "Yer 29.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.2"
              },
              "items": [
                {
                  "text": "Dan 9.2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Iki gihugu cyose kizaba umwirare n'igitangarirwa, kandi ayo mahanga azakorera umwami w'i Babuloni imyaka mirongo irindwi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Imyaka mirongo irindwi nishira nzahana umwami w'i Babuloni, n'ubwo bwoko n'igihugu cy'Abakaludaya, ni ko Uwiteka avuga, mbahora ibyaha byabo. Nzahagira amatongo iteka ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzasohoreza icyo gihugu amagambo yanjye yose nakivuzeho, ndetse ayanditswe muri iki gitabo yose, ayo Yeremiya yahanuriye amahanga yose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko amahanga menshi n'abami bakomeye bazabagira abaretwa b'ubwabo, kandi nzabitura ibihwanye n'ibyo bakoze, uko imirimo y'amaboko yabo ingana.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana izahana amahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Imana ya Isirayeli yambwiye itya iti “Enda iki gikombe cya vino y'uburakari kiri mu ntoki zanjye, kandi uyivunye amahanga yose ngutumyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yo azanywa adandabirane, asare abitewe n'inkota nzohereza muri yo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mperako nenda igikombe cyari mu ntoki z'Uwiteka mvunya amahanga yose, ayo Uwiteka yantumyeho: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "i Yerusalemu n'imidugudu y'u Buyuda, n'abami baho n'ibikomangoma byaho, ngo bihindurwe umusaka n'igitangarirwa, n'igitutsi no kuvumwa nk'uko bimeze ubu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Farawo umwami wo muri Egiputa n'abagaragu be, n'ibikomangoma bye n'abantu be bose, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'uruvange rw'amoko n'abami bose bo mu gihugu cya Usi, n'abami bose bo mu gihugu cy'Abafilisitiya, na Ashikeloni n'i Gaza, na Ekuroni n'abasigaye bo mu Ashidodi, Edomu na Mowabu na bene Amoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abami bose b'i Tiro n'abami bose b'i Sidoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abami b'ibihugu byo hakurya y'inyanja, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "i Dedani n'i Tema n'i Buzi, n'abiyogoshesha ingohe z'umusatsi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.23",
            "verseOrgIds": [
              "JER.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abami bose bo mu Arabiya, n'abami b'uruvange rw'amoko aba mu butayu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
            "verseOrgIds": [
              "JER.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abami bose b'i Zimuri, n'abami bose bo muri Elamu, n'abami bose b'Abamedi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abami bose b'ikasikazi, abari hafi n'abari kure bose hamwe, n'ibihugu byose byo mu mpande zose zo mu isi, n'umwami wa Sheshaki na we azanywa kuri cya gikombe hanyuma yabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uzababwire uti ‘Uku ni ko Uwiteka Nyiringabo Imana ya Isirayeli ivuga iti: Nimunywe musinde, muruke mugwe ubutabyuka, muzize inkota nzabateza.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nibanga kwakira igikombe kiri mu ntoki zawe ngo banywe, uzababwire uti ‘Uku ni ko Uwiteka Nyiringabo avuga ngo: Kunywa muzanywa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko dore umurwa witiriwe izina ryanjye ari wo ntangiriraho kugirira nabi. Namwe se mwasigara mudahanwe? Ntimuzabura guhanwa kuko ngiye guteza abari mu isi bose inkota.’ Ni ko Uwiteka Nyiringabo avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko ubahanurire aya magambo yose kandi ubabwire uti ‘Uwiteka azatontoma ari hejuru, arangurure ijwi rye ari mu buturo bwe bwera. Azatontomera cyane umukumbi we, azatera hejuru nk'abenga aburire abatuye mu isi bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urusaku ruzagera no ku mpera y'isi kuko Uwiteka afitanye urubanza n'amahanga, azaburanya umuntu wese na bo abanyabyaha azabagabiza inkota.’ ” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko Uwiteka Nyiringabo avuga ati “Dore ibyago bizava mu ishyanga rimwe bitere irindi, kandi inkubi ikomeye izaturuka ku mpera z'isi.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.32",
            "verseOrgIds": [
              "JER.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo munsi abishwe n'Uwiteka bazaba hose uhereye ku mpera y'isi ukageza ku yindi, ntibazaririrwa, cyangwa bakoranywe habe guhambwa, bazaba nk'amase ari ku gasozi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuboroge, bungeri mwe mutake, mwigaragure mu ivu yemwe batahira b'umukumbi, kuko iminsi y'icyorezo isohoye nkabamenagura, kandi muzagwa nk'ikibumbano cyiza kijanjaguritse. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abungeri bazabura aho bahungira, n'abatahira b'umukumbi babure aho bacikira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwumve ijwi ryo gutaka ry'abungeri, n'umuborogo w'abatahira b'umukumbi! Kuko Uwiteka yahinduye ubusa urwuri rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.36",
            "verseOrgIds": [
              "JER.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ibiraro byarimo amahoro byarasenyutse, bitewe n'uburakari bw'Uwiteka bukaze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.37",
            "verseOrgIds": [
              "JER.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasize ubuturo bwe nk'intare, kuko igihugu cyabo cyabaye igitangarirwa bitewe n'ubukana bw'ubibateza, n'uburakari bwe bukaze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
