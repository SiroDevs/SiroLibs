        },
        {
          "text": " Ijambo ry'Uwiteka ryaje ku muhanuzi Yeremiya ryerekeye ku Bafilisitiya, Farawo ataratsinda i Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.1",
