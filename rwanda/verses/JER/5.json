            "verseId": "JER.5.29",
            "verseOrgIds": [
              "JER.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ikintu gitangaza kandi cyangwa urunuka cyabonetse mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.30",
            "verseOrgIds": [
              "JER.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahanuzi bahanura ibinyoma, abatambyi bategeka uko bishakiye, kandi abantu banjye bashima ko bagenza batyo. Amaherezo yabyo se muzabigira mute?”",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.31",
            "verseOrgIds": [
              "JER.5.31"
            ]
          }
        }
