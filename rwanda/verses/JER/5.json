              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.25",
            "verseOrgIds": [
              "JER.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuko abantu banjye babonetsemo abantu babi, baca ibico nk'abategesha inyoni imitego, baratega bagafata abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.26",
            "verseOrgIds": [
              "JER.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'urutanda rwuzuyemo inyoni ni ko amazu yabo yuzuyemo uburiganya, ni cyo cyabateye gukomera bakaba abakire. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.27",
            "verseOrgIds": [
              "JER.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barahonjotse baciye umubiri, ni ukuri imirimo y'ibyaha byabo barayikabya. Kuburana ntibaburanira impfubyi kugira ngo zigubwe neza, kandi ntibacira umukene urubanza rutabera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.28",
            "verseOrgIds": [
              "JER.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ibyo sinzabibahanira? Ni ko Uwiteka abaza. Kandi ubwoko nk'ubu umutima wanjye ntiwabuhora ibyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.29",
            "verseOrgIds": [
              "JER.5.29"
            ]
          }
        }
      ]
    },
