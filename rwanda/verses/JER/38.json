          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kandi bazajyana abagore bawe bose n'abana bawe babashyire Abakaludaya, nawe ntuzabava mu maboko ahubwo uzajyanwa n'ukuboko k'umwami w'i Babuloni, kandi uyu murwa uzatwikwa ari wowe uzize.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
