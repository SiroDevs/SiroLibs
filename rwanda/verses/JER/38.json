                "loc": "EZK.33.21"
              },
              "items": [
                {
                  "text": "Ezek 33.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko Yeremiya aguma mu rugo rw'inzu y'imbohe, arinda ageza ku munsi Yerusalemu yahindūwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
