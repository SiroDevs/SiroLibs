            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
