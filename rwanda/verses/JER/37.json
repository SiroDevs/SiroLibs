        "style": "s1"
      },
      "items": [
        {
          "text": "Abakaludaya bava i Yerusalemu bajya kurwana na Farawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
