          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.23",
            "verseOrgIds": [
              "JER.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twumvise inkuru zaho amaboko yacu araraba, duterwa n'umubabaro mwinshi n'ibise nk'iby'umugore uri ku nda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.24",
            "verseOrgIds": [
              "JER.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntugasohoke ngo ujye mu murima cyangwa ngo ujye mu nzira, kuko inkota y'umubisha n'ibiteye ubwoba biri mu mpande zose.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.25",
            "verseOrgIds": [
              "JER.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana ibwira Abayuda ko ari abagome",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.25",
            "verseOrgIds": [
              "JER.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yewe mukobwa w'abantu banjye we, kenyera ibigunira wigaragure mu ivu, wiraburirwe nk'uwapfushije umwana w'ikinege. Gira umuborogo ubabaje cyane, kuko umurimbuzi azadutera adutunguye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.26",
            "verseOrgIds": [
              "JER.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakugize umunara n'igihome mu bantu banjye, kugira ngo umenye inzira yabo uyigenzure. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.27",
            "verseOrgIds": [
              "JER.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose ni abagome bakabije bagenda babeshyera abandi, bameze nk'imiringa n'ibyuma, bose bakora ibyo gukiranirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.28",
            "verseOrgIds": [
              "JER.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imivuba ivugutirwa cyane, icyuma cy'isasu gikongowe n'umuriro, bagumya gucenshura ariko nta cyo bimaze kuko ababi batavanwamo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.29",
            "verseOrgIds": [
              "JER.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bazabita ifeza yabaye inkamba, kuko Uwiteka yabanze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.6.30",
            "verseOrgIds": [
              "JER.6.30"
            ]
          }
        }
      ]
    }
  ],
