          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry'Uwiteka ryaje ku muhanuzi Yeremiya ryerekeye ku banyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.1",
            "verseOrgIds": [
