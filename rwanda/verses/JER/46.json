        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiya ahanurira amahanga ibyago muri Egiputa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
