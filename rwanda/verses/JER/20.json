            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.3.1+JOB.3.2+JOB.3.3+JOB.3.4+JOB.3.5+JOB.3.6+JOB.3.7+JOB.3.8+JOB.3.9+JOB.3.10+JOB.3.11+JOB.3.12+JOB.3.13+JOB.3.14+JOB.3.15+JOB.3.16+JOB.3.17+JOB.3.18+JOB.3.19"
              },
              "items": [
                {
                  "text": "Yobu 3.1-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Havumwe umunsi navutseho, umunsi mama yambyayeho ntugahirwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.14",
            "verseOrgIds": [
              "JER.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Havumwe umuntu waje kubwira data ati “Wabyariwe umwana w'umuhungu”, bigatuma anezerwa cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
              "JER.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu amere nk'imidugudu Uwiteka yarimbuye ntarushye yicuza, kandi niyumve imiborogo hakiri mu gitondo n'urusaku rw'induru ku manywa y'ihangu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ntishwe ntaravuka ngo mama ambere igituro, inda ye ibe urutare. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.17",
            "verseOrgIds": [
              "JER.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni iki cyatumye mvukira kureba umubabaro n'umuruho, ngo iminsi yanjye imarwe no gukorwa n'isoni?",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.18",
            "verseOrgIds": [
              "JER.20.18"
            ]
          }
        }
      ]
    }
