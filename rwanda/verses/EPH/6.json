              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nanjye munsabire mpabwe kuvuga nshize amanga uko mbumbuye akanwa, kugira ngo menyeshe abantu ubwiru bw'ubutumwa bwiza, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.19",
            "verseOrgIds": [
