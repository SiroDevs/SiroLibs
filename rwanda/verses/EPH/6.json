                  "text": "59.17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Muhagarare mushikamye mukenyeye ukuri, mwambaye gukiranuka nk'icyuma gikingira igituza, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.14",
            "verseOrgIds": [
              "EPH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
