            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Bana, mujye mwumvira ababyeyi banyu mu Mwami wacu, kuko ari byo bibakwiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.1",
            "verseOrgIds": [
              "EPH.6.1"
            ]
          }
        },
