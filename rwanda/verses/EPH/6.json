            }
          ]
        },
        {
          "text": "musengeshe Umwuka iteka mu buryo bwose bwo gusenga no kwinginga, kandi ku bw'ibyo mugumye rwose kuba maso, musabire abera bose. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.18",
            "verseOrgIds": [
