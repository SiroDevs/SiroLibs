            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namwe mbata, mujye mwumvira ba shobuja bo ku mubiri nk'uko mwumvira Kristo, mububashye muhinda imishyitsi kandi mutaryarya mu mitima yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.5",
            "verseOrgIds": [
              "EPH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukabakorere bakibahagarikiye gusa ngo mumere nk'abanezeza abantu, ahubwo mumere nk'imbata za Kristo, mukore ibyo Imana ishaka mubikuye ku mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.6",
            "verseOrgIds": [
              "EPH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubakorere mubyishimiye nk'abakorera Umwami wacu, mutari nk'abakorera abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.7",
            "verseOrgIds": [
              "EPH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko muzi yuko umuntu wese iyo akoze ikintu cyiza azacyiturwa n'Umwami, naho yaba imbata cyangwa uw'umudendezo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.8",
            "verseOrgIds": [
              "EPH.6.8"
            ]
          }
        }
      ]
    },
