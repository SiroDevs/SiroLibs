            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Namwe ba se ntimugasharirire abana banyu, ahubwo mubarere mubahana, mubigisha iby'Umwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.4",
            "verseOrgIds": [
              "EPH.6.4"
            ]
