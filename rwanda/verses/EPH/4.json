            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.16"
              },
              "items": [
                {
                  "text": "Zek 8.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko mwiyambure ibinyoma, umuntu wese avugane ukuri na mugenzi we, kuko turi ingingo za bagenzi bacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.25",
            "verseOrgIds": [
              "EPH.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
