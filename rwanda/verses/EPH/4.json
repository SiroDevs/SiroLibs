            }
          ]
        },
        {
          "text": " Nimurakara ntimugakore icyaha, izuba ntirikarenge mukirakaye ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.26",
            "verseOrgIds": [
              "EPH.4.26"
            ]
          }
        },
