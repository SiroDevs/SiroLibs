    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ubwiru bw'Imana bwo gukiza abanyamahanga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EPH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma jyewe Pawulo ndi imbohe ya Kristo Yesu, mbohewe mwebwe abanyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.1",
            "verseOrgIds": [
              "EPH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EPH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi namwe mwumvise iby'ubutware bwo kugabura ubuntu bw'Imana nahawe ku bwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.2",
            "verseOrgIds": [
              "EPH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko mpishurirwa ubwiru bwayo mu iyerekwa nk'uko nabanje kwandika mu magambo make. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.3",
            "verseOrgIds": [
              "EPH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.26+COL.1.27"
              },
              "items": [
                {
                  "text": "Kolo 1.26-27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Namwe nimuyasoma muzirebera ubwanyu uburyo menye ubwiru bwa Kristo koko. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.4",
            "verseOrgIds": [
              "EPH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo ntibwamenyeshejwe abana b'abantu mu bindi bihe, nk'uko muri iki gihe intumwa ze zera n'abahanuzi babuhishuriwe n'Umwuka, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.5",
            "verseOrgIds": [
              "EPH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "yuko abanyamahanga ari abaraganwa natwe kandi bakaba ingingo z'umubiri umwe natwe, abaheshejwe n'ubutumwa bwiza kuzagabana natwe muri Kristo Yesu ibyasezeranijwe.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.6",
            "verseOrgIds": [
              "EPH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanjye nahindutse umubwiriza wabwo nk'uko impano iri y'ubuntu bw'Imana, iyo naheshejwe n'imbaraga zayo zinkoreramo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.7",
            "verseOrgIds": [
              "EPH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nubwo noroheje cyane hanyuma y'abera bose, naherewe ubwo buntu kugira ngo mbwirize abanyamahanga ubutumwa bwiza bw'ubutunzi bwa Kristo butarondoreka, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.8",
            "verseOrgIds": [
              "EPH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "njijure bose ngo bamenye uburyo iby'ubwiru bikwiriye kugenda, ari bwo bwahishwe n'Imana yaremye byose uhereye kera kose, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.9",
            "verseOrgIds": [
              "EPH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo muri iki gihe abatware n'abafite ubushobozi bwo mu ijuru mu buryo bw'umwuka",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "bwo . . . umwuka:",
              "type": "text"
            },
            {
              "text": "cyangwa, bw'ahantu ho mu ijuru.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", bamenyeshwe n'Itorero ubwenge bw'Imana bw'uburyo bwinshi ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.10",
            "verseOrgIds": [
              "EPH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EPH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk'uko yabigambiriye kera kose muri Kristo Yesu Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.11",
            "verseOrgIds": [
              "EPH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we ni mo duherwa ubushizi bw'amanga ngo twegere Imana dushize ubwoba, tubiheshejwe n'uko tumwizeye. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.12",
            "verseOrgIds": [
              "EPH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma mbinginga ngo mudacogozwa n'amakuba yanjye yo ku bwanyu, kuko ari yo cyubahiro cyanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pawulo asabira Abefeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.13",
            "verseOrgIds": [
              "EPH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma mpfukamira Data wa twese, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.14",
            "verseOrgIds": [
              "EPH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo imiryango yose yo mu ijuru n'iyo mu isi yitirirwa,",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "imiryango . . . yitirirwa:",
              "type": "text"
            },
            {
              "text": "cyangwa, umuryango wose w'abo mu ijuru n'abo mu isi witirirwa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.15",
            "verseOrgIds": [
              "EPH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EPH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo abahe nk'uko ubutunzi bw'ubwiza bwe buri gukomezwa cyane mu mitima yanyu ku bw'Umwuka we, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.16",
            "verseOrgIds": [
              "EPH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EPH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngo Kristo ahore mu mitima yanyu ku bwo kwizera, kugira ngo ubwo mumaze gushōrera imizi mu rukundo mukaba mushikamye, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.17",
            "verseOrgIds": [
              "EPH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EPH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhabwe imbaraga zo kumenyera hamwe n'abera bose ubugari n'uburebure bw'umurambararo, n'uburebure bw'igihagararo, n'uburebure bw'ikijyepfo bwarwo ubwo ari bwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.18",
            "verseOrgIds": [
              "EPH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumenye n'urukundo rwa Kristo ruruta uko rumenywa, ngo mwuzuzwe kugeza ku kuzura kw'Imana.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EPH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.19",
            "verseOrgIds": [
              "EPH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EPH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ibasha gukora ibiruta cyane ibyo dusaba, ndetse n'ibyo twibwira byose nk'uko imbaraga zayo ziri zidukoreramo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.20",
            "verseOrgIds": [
              "EPH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "icyubahiro kibe icyayo mu Itorero no muri Kristo Yesu, kugeza iteka ryose ry'ibihe bidashira, Amen.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.3.21",
            "verseOrgIds": [
              "EPH.3.21"
            ]
          }
        }
      ]
    }
