                  "text": "1 Pet 3.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Bagabo, mukunde abagore banyu nk'uko Kristo yakunze Itorero akaryitangira ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.25",
            "verseOrgIds": [
              "EPH.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EPH 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo aryeze, amaze kuryogesha amazi n'ijambo rye ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.26",
            "verseOrgIds": [
              "EPH.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EPH 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "aryishyīre rifite ubwiza, ridafite ikizinga cyangwa umunkanyari cyangwa ikintu cyose gisa gityo, ahubwo ngo ribe iryera ridafite inenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.27",
            "verseOrgIds": [
              "EPH.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EPH 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko abagabo bakwiriye gukunda abagore babo nk'imibiri yabo. Ukunda umugore we aba yikunda, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.28",
            "verseOrgIds": [
              "EPH.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EPH 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ari nta muntu wakwanga umubiri we, ahubwo yawugaburira akawukuyakuya nk'uko Kristo abigirira Itorero, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.29",
            "verseOrgIds": [
              "EPH.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EPH 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko turi ingingo z'umubiri we. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.30",
            "verseOrgIds": [
              "EPH.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EPH 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.24"
              },
              "items": [
                {
                  "text": "Itang 2.24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni cyo gituma umuntu azasiga se na nyina akabana n'umugore we akaramata, bombi bakaba umubiri umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.31",
            "verseOrgIds": [
              "EPH.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EPH 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo ni ubwiru bukomeye cyane, ariko ibyo mvuga byerekeye kuri Kristo n'Itorero. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.32",
            "verseOrgIds": [
              "EPH.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EPH 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko namwe umuntu wese akunde umugore we nk'uko yikunda, kugira ngo umugore na we abone uko yubaha umugabo we.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.33",
            "verseOrgIds": [
              "EPH.5.33"
            ]
          }
        }
