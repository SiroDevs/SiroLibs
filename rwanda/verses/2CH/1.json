            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo amaramaza kubakira izina ry'Uwiteka inzu, no kubaka inzu y'ubwami.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.18",
            "verseOrgIds": [
              "2CH.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.18:",
              "type": "text"
            },
            {
              "text": "muri Bibliya Yera ya mbere, uyu murongo ni 2.1; bityo, 2.2-18 ihwanye na 2.1-17 muri iyi Bibliya, nk'uko biri mu Ruheburayo.",
              "type": "text"
            }
          ]
        }
      ]
    }
