          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Baziririza Pasika",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Yosiya aziriririza Uwiteka Pasika i Yerusalemu, babīkira umwana w'intama wa Pasika ku munsi wa cumi n'ine w'ukwezi kwa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashyira abatambyi ku murimo wabo, abashyirishaho umwete wo gukora umurimo wo mu nzu y'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abwira Abalewi bigishaga Abisirayeli bose, ari bo berejwe Uwiteka ati “Nimushyire isanduku yera mu nzu Salomo mwene Dawidi umwami wa Isirayeli yubatse, nta mutwaro muzongera guheka ku bitugu byanyu. Maze noneho mukorerane Uwiteka Imana yanyu n'ubwoko bwayo bw'Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.8.14"
              },
              "items": [
                {
                  "text": "2 Ngoma 8.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Mwitegure uko amazu ya ba sogokuruza banyu ari, n'ibihe byanyu nk'uko byanditswe na Dawidi umwami wa Isirayeli, na Salomo umuhungu we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze muhagarare ahantu hera, uko amazu ya ba sogokuruza ya bene wanyu bo mu bantu agabanywamo, kugira ngo umuntu wese agire umugabane w'inzu ya ba sekuruza y'Abalewi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "muhereko mubīkīre umwana w'intama wa Pasika, mwiyeze mwitegurire bene wanyu, mukurikize ijambo ry'Uwiteka ryavuzwe na Mose.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosiya aha abantu bari bahari bose, abana b'intama n'ab'ihene bo mu mikumbi byo kuba ibitambo bya Pasika, umubare wabyo wari inzovu eshatu n'amapfizi ibihumbi bitatu, ibyo byose byavuye mu matungo y'umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n'abatware be baha abantu n'abatambyi n'Abalewi ibyo gutamba, babitangana umutima ukunze. Hilukiya na Zekariya na Yehiyeli abatware b'inzu y'Imana, baha abatambyi ibyo gutambaho ibitambo bya Pasika, intama ibihumbi bitatu n'inka magana atatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na Konaniya na bene se Shemaya na Netaneli, n'abatware b'Abalewi Hashabiya na Yeyeli na Yozabadi, baha Abalewi ibyo gutamba ho ibitambo bya Pasika, intama ibihumbi bitanu n'inka magana atanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko biteguye umurimo, abatambyi bahagarara ahabo n'Abalewi bajya ku bihe byabo, nk'uko umwami yategetse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko babīkīra umwana w'intama wa Pasika, n'abatambyi bamisha amaraso bayahawe n'Abalewi, Abalewi barabibaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurayo ibitambo byoswa, babigabanyaho ngo bagabanye amazu ya ba sekuruza b'abantu, kugira ngo babitambire Uwiteka nk'uko byanditswe mu gitabo cya Mose. Kandi n'inka bazigenza batyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.8+EXO.12.9"
              },
              "items": [
                {
                  "text": "Kuva 12.8-9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Maze botsa igitambo cya Pasika uko bitegekwa, kandi n'amaturo yera bayateka mu nkono, no mu nkono zivuga no mu byuma bikaranga, babijyana vuba bahereza abantu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma bītegurira ibyabo ubwabo n'iby'abatambyi, kuko abatambyi bene Aroni bari bahugijwe no gutamba ibitambo byoswa n'urugimbu bukarinda bwira. Ni cyo cyatumye Abalewi bitegurira ibyabo ubwabo, bategura n'iby'abatambyi bene Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.25.1"
              },
              "items": [
                {
                  "text": "1 Ngoma 25.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " N'abaririmbyi bene Asafu bari ahabo, nk'uko byari byarategetswe na Dawidi na Asafu, na Hemani na Yedutuni bamenya w'umwami. N'abakumirizi bari ku marembo yose, ntibagombaga kuva ku murimo wabo kuko bene wabo b'Abalewi babiteguriye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko umurimo wose w'Uwiteka watunganijwe, kuri uwo munsi wo kuziririza Pasika no gutamba ibitambo byoswa ku cyotero cy'Uwiteka, nk'uko Umwami Yosiya yari yategetse. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.1+EXO.12.2+EXO.12.3+EXO.12.4+EXO.12.5+EXO.12.6+EXO.12.7+EXO.12.8+EXO.12.9+EXO.12.10+EXO.12.11+EXO.12.12+EXO.12.13+EXO.12.14+EXO.12.15+EXO.12.16+EXO.12.17+EXO.12.18+EXO.12.19+EXO.12.20"
              },
              "items": [
                {
                  "text": "Kuva 12.1-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Icyo gihe Abisirayeli bari bahari baziririza Pasika, n'iminsi mikuru irindwi y'imitsima idasembuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Bisirayeli ntihigeze kuziririzwa Pasika nk'iyo uhereye mu bihe by'umuhanuzi Samweli, kandi nta mwami mu bami ba Isirayeli waziririje Pasika ihwanye n'iyo Yosiya yaziririje, afatanije n'abatambyi n'Abalewi n'Abayuda bose, hamwe n'Abisirayeli bari bahari n'abaturage b'i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa cumi n'umunani w'ingoma ya Yosiya, ni ho baziririje Pasika iyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Umwami Yosiya agwa mu ntambara arwana n'umwami wa Egiputa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y'ibyo byose, Yosiya amaze gutunganya urusengero, Neko umwami wa Egiputa arazamuka ajya gutera Karikemeshi ku ruzi rwa Ufurate, maze Yosiya ajya kurwana na we. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Neko amutumaho intumwa ati “Mpfa iki nawe, mwami w'Abayuda? Ubu ngubu si wowe nteye, ahubwo nteye inzu ndwana na yo, ndetse Imana integetse ko nihuta. Rorera kurogoya Imana iri kumwe nanjye, itagutsemba.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yosiya ntiyemera kumuha ibitugu ngo asubireyo, ahubwo ariyoberanya ngo arwane na we, ntiyumvira amagambo ya Neko aturutse mu kanwa k'Imana, ajya kurwanira mu kibaya cy'i Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abarashi barasa Umwami Yosiya, abwira abagaragu be ati “Nimunkure ku rugamba ndakomeretse cyane.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abagaragu be bamukura mu igare, bamushyira mu rya kabiri yari afite bamuzana i Yerusalemu aherako aratanga, ahambwa mu bituro bya ba sekuruza. Abayuda bose b'ab'i Yerusalemu baramuririra.",
          "type": "text",
