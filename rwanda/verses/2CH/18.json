              "2CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubwira ati “Nakurahije kangahe kutazambwira ijambo na rimwe, keretse ukuri mu izina ry'Uwiteka?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        }
