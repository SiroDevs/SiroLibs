          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoramu uwo yatangiye gutegeka amaze imyaka mirongo itatu n'ibiri avutse, amara imyaka munani i Yerusalemu ari ku ngoma. Aratanga agenda nta wamwifuzaga, bamuhamba mu mudugudu wa Dawidi ariko atari mu bituro by'abami.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
              "2CH.21.20"
            ]
          }
        }
      ]
