  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "2CH 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibyo ku ngoma ya Amasiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiya yari amaze imyaka makumyabiri n'itanu avutse ubwo yatangiraga gutegeka, amara imyaka makumyabiri n'icyenda i Yerusalemu ari ku ngoma, kandi nyina yitwaga Yehoyadani w'i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.1",
            "verseOrgIds": [
              "2CH.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ibishimwa n'Uwiteka abikorana umutima utunganye, ariko si rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.2",
            "verseOrgIds": [
              "2CH.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye amaze kuganza mu ngoma, ahōra abagaragu be bishe se, ari umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.3",
            "verseOrgIds": [
              "2CH.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Guteg 24.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko ntiyica abana babo, ahubwo agenza nk'uko byanditswe mu mategeko yo mu gitabo cya Mose, uko Uwiteka yategetse ati “Ba se ntibakicwe babahora abana babo kandi abana ntibakicwe babahora ba se, ahubwo umuntu wese azicwe bamuhora icye cyaha.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.4",
            "verseOrgIds": [
              "2CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Amasiya ateranya Abayuda bose n'Ababenyamini, abatunganya uko amazu ya ba sekuruza yari ari, ngo bategekwe n'abatware batwara ibihumbi n'abatwara amagana, abari bamaze imyaka makumyabiri bavutse n'abayisagije, arababara abona ari abagabo batoranijwe uduhumbi dutatu babasha gutabara, bagatwara amacumu n'ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.5",
            "verseOrgIds": [
              "2CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi agurira abagabo bo mu Bisirayeli b'abanyambaraga b'intwari agahumbi, atanga italanto z'ifeza ijana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.6",
            "verseOrgIds": [
              "2CH.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma haza umuntu w'Imana, aramusanga aramubwira ati “Mwami, ntukundire ingabo z'Abisirayeli ko mujyana kuko Uwiteka atari kumwe n'Abisirayeli, bisobanurwa ngo Abefurayimu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.7",
            "verseOrgIds": [
              "2CH.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niwanga ugatabarana na bo, nubwo warwana intambara ufite ubutwari bungana bute Imana izagutsinda imbere y'ababisha, kuko Imana ifite ububasha bwo gutabara n'ubutsinda.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.8",
            "verseOrgIds": [
              "2CH.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasiya asubiza uwo muntu w'Imana ati “Ariko se iby'italanto ijana nahaye ingabo z'Abisirayeli bibaye bite?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu w'Imana aramusubiza ati “Uwiteka abasha kuguha izizirutaho cyane.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.9",
            "verseOrgIds": [
              "2CH.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Amasiya arobanura izo ngabo zari zije aho ari zivuye i Bwefurayimu ngo zisubire iwabo. Ni cyo cyaziteye kurakarira Abayuda, zisubira iwabo zifite umujinya mwinshi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.10",
            "verseOrgIds": [
              "2CH.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Amasiya yiyungamo atabarana n'abantu be, bajya mu kibaya cy'umunyu yica mu Baseyiri abantu inzovu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.11",
            "verseOrgIds": [
              "2CH.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bafata mpiri abandi inzovu babajyana hejuru y'igitare, babajugunya babashungura munsi yacyo maze bose baravunagurika.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.12",
            "verseOrgIds": [
              "2CH.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ingabo Amasiya yashubijeyo ngo zidatabarana na we, zitera imidugudu y'i Buyuda uhereye i Samariya ukageza i Betihoroni ziyicamo abantu ibihumbi bitatu, banyaga iminyago myinshi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.13",
            "verseOrgIds": [
              "2CH.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko hanyuma Amasiya atabarutse kwica Abedomu, azana ibigirwamana by'Abaseyiri arabishinga ngo bibe imana ze, arabipfukamira abyosereza imibavu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.14",
            "verseOrgIds": [
              "2CH.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye uburakari bw'Uwiteka bukongerera Amasiya, amutumaho umuhanuzi aramubwira ati “Ni iki gituma ushaka imana zitakijije bene so amaboko yawe?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.15",
            "verseOrgIds": [
              "2CH.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akivugana na we, umwami aramubaza ati “Hari ubwo twagushyize mu bajyanama b'umwami? Ceceka utavaho ukubitwa.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umuhanuzi araceceka aravuga ati “Nzi yuko Imana yagambiriye kukurimbura, kuko ugenje utyo ntiwumve inama yanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abayuda n'Abisirayeli barwana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.16",
            "verseOrgIds": [
              "2CH.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Amasiya umwami w'Abayuda ajya inama atuma kuri Yehowasi, mwene Yehowahazi mwene Yehu umwami w'Abisirayeli ati “Vayo twibonanire.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.17",
            "verseOrgIds": [
              "2CH.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowasi umwami w'Abisirayeli atuma kuri Amasiya umwami w'Abayuda ati “Igitovu cy'i Lebanoni cyatumye ku mwerezi w'i Lebanoni kiti ‘Umuhungu wanjye umushyingire umukobwa wawe.’ Bukeye inyamaswa y'i Lebanoni irahanyura ikandagira icyo gitovu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.18",
            "verseOrgIds": [
              "2CH.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uvuga yuko wanesheje Abedomu, umutima wawe wishyira hejuru urirarira. Noneho wihamira iwawe. Ni iki gituma wishyira mu bitari ibyawe ngo bikugirire nabi, ukagwa wowe ubwawe hamwe n'Abayuda?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.19",
            "verseOrgIds": [
              "2CH.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Amasiya ntiyabyitaho, kuko byaturutse ku Mana ngo ibahāne mu babisha babo, kuko bashakaga imana z'i Bwedomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.20",
            "verseOrgIds": [
              "2CH.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehowasi umwami w'Abisirayeli arazamuka atera Amasiya umwami w'Abayuda, bahanganira i Betishemeshi y'i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.21",
            "verseOrgIds": [
              "2CH.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda banesherezwa imbere y'Abisirayeli barahunga, umuntu wese ahungira mu ihema rye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.22",
            "verseOrgIds": [
              "2CH.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehowasi umwami w'Abisirayeli afata Amasiya umwami w'Abayuda, mwene Yowasi mwene Yehowahazi, amufatira i Betishemeshi amujyana i Yerusalemu, asenya inkike z'i Yerusalemu uhereye ku irembo rya Efurayimu ukageza ku irembo ryo ku nkokora, hose hari mikono magana ane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.23",
            "verseOrgIds": [
              "2CH.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyaga izahabu n'ifeza byose, n'ibintu byose basanze mu nzu y'Imana no kwa Obededomu no mu nzu y'umwami, anyaga n'abantu b'integano baba ingwate, asubira i Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Amasiya mwene Yowasi umwami w'Abayuda amara indi myaka cumi n'itanu, Yehowasi mwene Yehowahazi umwami w'Abisirayeli amaze gutanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko indi mirimo ya Amasiya, iyabanje n'iyaherutse, mbese ntiyanditswe mu gitabo cy'abami b'Abayuda n'ab'Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uhereye igihe Amasiya yarekaga gukurikira Uwiteka, bamugambaniraga ari i Yerusalemu ahungira i Lakishi, ariko bohereza abo kumukurikira i Lakishi bamutsindayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bamuzana ku mafarashi, bamuhamba hamwe na ba sekuruza mu mudugudu wa Dawidi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
        }
      ]
    }
