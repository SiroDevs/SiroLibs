              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko Salomo amaze gusenga, umuriro umanuka uva mu ijuru wotsa igitambo cyo koswa n'ibindi bitambo, icyubahiro cy'Uwiteka cyuzura inzu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatambyi ntibabasha kwinjira mu nzu y'Uwiteka, kuko icyubahiro cy'Uwiteka cyuzuye inzu y'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
