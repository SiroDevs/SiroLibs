              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko imyaka itatu ishize, uzajye ukuraho kimwe mu icumi cy'imyaka yose wejeje muri uwo mwaka, ubibike iwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.28",
            "verseOrgIds": [
              "DEU.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Umulewi kuko adafite umugabane cyangwa gakondo muri mwe, n'umusuhuke w'umunyamahanga, n'impfubyi n'umupfakazi bari iwanyu bazaze barye bahage, kugira ngo Uwiteka Imana yawe iguhere umugisha imirimo ukora yose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.29",
