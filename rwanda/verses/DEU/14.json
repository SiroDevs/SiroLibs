              },
              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko uri ubwoko bwerejwe Uwiteka Imana yawe, kandi Uwiteka akagutoraniriza mu mahanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "akagutoraniriza mu mahanga:",
              "type": "text"
            },
            {
              "text": "cyangwa, abarutisha amahanga.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yose yo mu isi kuba ubwoko yironkeye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.2",
            "verseOrgIds": [
              "DEU.14.2"
            ]
          }
        }
      ]
