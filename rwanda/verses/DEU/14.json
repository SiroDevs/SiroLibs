              },
              "items": [
                {
                  "text": "34.26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ntimukarye intumbyi yose. Wemererwa kuyiha umusuhuke w'umunyamahanga uri iwanyu akayirya, cyangwa wemererwa kuyigurisha umunyamahanga. Wehoho uri ubwoko bwerejwe Uwiteka Imana yawe. Ntugatekeshe umwana w'ihene amahenehene ya nyina.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.14.21",
            "verseOrgIds": [
              "DEU.14.21"
            ]
          }
        }
      ]
    },
    {
