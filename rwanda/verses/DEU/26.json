              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi n'Uwiteka uyu munsi yagusezeranishije kumubera ubwoko yironkeye nk'uko yakubwiye, kandi yuko uzitondera amategeko ye yose ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo agusumbishe ayandi mahanga yaremye yose, uyarushe gushimwa no kogera no kubahwa, ubere Uwiteka Imana yawe ubwoko bwera nk'uko yavuze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
