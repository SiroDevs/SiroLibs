              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo nafatwa asambana n'umugore ufite umugabo bombi babīce, umugabo n'umugore basambanye. Uko abe ari ko ukura ikibi mu Bisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
