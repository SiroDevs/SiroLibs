              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umugabo nasanga mu gasozi umukobwa wasabwe akamufatirayo akamukinda, umugabo wamukinze azabe ari we wicwa wenyine. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
