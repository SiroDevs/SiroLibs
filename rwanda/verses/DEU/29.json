        {
          "text": "Ni cyo cyatumye uburakari bw'Uwiteka bugurumanira iki gihugu, bakakizanira imivumo yose yanditswe muri iki gitabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
