              "items": [
                {
                  "text": "Kuva 17.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi n'i Tabera n'i Masa n'i Kiburotihatava, mwarakarijeyo Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
