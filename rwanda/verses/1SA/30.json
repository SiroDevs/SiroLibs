          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi asohoye i Sikulagi yoherereza abatware b'Abayuda b'incuti ze ku minyago, arababwira ati “Ngiyo impano ivuye ku minyago y'abanzi b'Uwiteka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.26",
            "verseOrgIds": [
              "1SA.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abyoherereza ab'i Beteli n'ab'i Ramoti y'ikusi n'ab'i Yatiri, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.27",
            "verseOrgIds": [
              "1SA.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'aba Aroweri n'ab'i Sifemoti n'aba Eshitemowa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.28",
            "verseOrgIds": [
              "1SA.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'ab'i Rakala n'abo mu midugudu y'Abanyeramēli, n'abo mu midugudu y'Abakeni, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.29",
            "verseOrgIds": [
              "1SA.30.29"
            ]
          }
        },
