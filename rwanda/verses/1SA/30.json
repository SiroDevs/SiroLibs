        {
          "text": "n'ab'i Heburoni n'ab'ahandi hose Dawidi n'abantu be bajyaga babamo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
            "verseOrgIds": [
              "1SA.30.31"
