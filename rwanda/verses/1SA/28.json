              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.19",
            "verseOrgIds": [
              "1SA.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya Sawuli aherako yikubita hasi indambya yubamye, kuko akuwe umutima cyane n'ibyo Samweli amubwiye, acika intege kuko yari yiriwe ubusa kandi akaburara. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.20",
            "verseOrgIds": [
              "1SA.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma uwo mugore asanga Sawuli, abona ko yashobewe cyane aramubwira ati “Dore umuja wawe nakumviye mpara amagara, numvira amagambo umbwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.21",
            "verseOrgIds": [
              "1SA.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ndakwinginze, nawe wumvire umuja wawe unyemerere ngufungurire, urye kugira ngo nugenda ubone intege.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.22",
            "verseOrgIds": [
              "1SA.28.22"
            ]
          }
        }
      ]
    },
