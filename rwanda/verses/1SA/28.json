        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aranga ati “Sinshaka kurya.” Ariko abagaragu be n'uwo mugore baramuhata arabumvira, aherako abaduka hasi yicara ku buriri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.23",
            "verseOrgIds": [
              "1SA.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi uwo mugore yari afite ikimasa kibyibushye kiri mu ruhongore arihuta aracyica, yenda ifu ayivugamo umutsima udasembuwe arawotsa, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.24",
            "verseOrgIds": [
              "1SA.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "abihereza Sawuli n'abagaragu be barafungura. Baherako bahaguruka iryo joro, baragenda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.28.25",
            "verseOrgIds": [
              "1SA.28.25"
            ]
          }
        }
      ]
