          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dawidi arahunga, benshi bamusangayo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.57.1"
              },
              "items": [
                {
                  "text": "Zab 57.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.142.1"
              },
              "items": [
                {
                  "text": "142.1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko Dawidi avayo arahunga, arasukira mu buvumo bwa Adulamu. Bukeye bakuru be na bene wabo babyumvise baramanuka bamusangayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.1",
            "verseOrgIds": [
              "1SA.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abari mu makuba bose n'abarimo imyenda bose n'abinubaga bose bateranira aho ari, aba umutware wabo. Nuko abari kumwe na we bari abantu nka magana ane.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.2",
            "verseOrgIds": [
              "1SA.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Dawidi avayo ajya i Misipa i Mowabu, abwira umwami w'i Mowabu ati “Ndakwinginze ukundire data na mama bimukire ino, mubane kugeza aho nzamenyera icyo Imana integeka.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abazanira umwami w'i Mowabu, baturana na we igihe cyose Dawidi yamaze mu buvumo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umuhanuzi Gadi abwira Dawidi ati “Wiguma mu buvumo, buvemo ujye mu gihugu cya Yuda.” Nuko Dawidi avayo arasukira mu ishyamba rya Hereti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sawuli yica abatambyi b'Uwiteka, abahora gufasha Dawidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Sawuli yumva ko Dawidi yabonekanye n'abo bari kumwe. Ubwo Sawuli yari yicaye i Gibeya munsi y'igiti cy'umunyinya i Rama yitwaje icumu, kandi abagaragu be bose bari bahagaze bamukikije. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli abaza abagaragu be bahagaze bamukikije ati “Yemwe mwa Babenyamini mwe, harya mwene Yesayi uwo azaha umuntu wese muri mwe imirima n'inzabibu? Kandi mwese ni ko azabagira abatware b'ibihumbi n'abatware b'amagana, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma muhuza inama yo kungambanira, ntihagira n'umwe umburira ko umuhungu wanjye yasezeranye na mwene Yesayi? Ubonye ngo habure n'umwe muri mwe umbabarira, ngo amenyeshe ko umuhungu wanjye yangandishirije umugaragu, akancira igico nk'uko agenje none?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.8+1SA.21.9+1SA.21.10"
              },
              "items": [
                {
                  "text": "1 Sam 21.8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.52.1+PSA.52.2"
              },
              "items": [
                {
                  "text": "Zab 52.1-2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko Dowegi Umwedomu yari ahagaze aho mu bagaragu ba Sawuli, asubiza umwami ati “Nabonye mwene Yesayi aza i Nobu kwa Ahimeleki mwene Ahitubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ahimeleki amugishiriza Uwiteka inama kandi amuha impamba, amuha n'inkota ya Goliyati Umufilisitiya.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
            "verseOrgIds": [
              "1SA.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami abyumvise, atumiza Ahimeleki umutambyi mwene Ahitubu n'abo mu rugo rwa se bose, ari bo batambyi b'i Nobu, bose bitaba umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.11",
            "verseOrgIds": [
              "1SA.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bageza aho Sawuli aravuga ati “Umva mwana wa Ahitubu.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we ati “Karame, Nyagasani.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.12",
            "verseOrgIds": [
              "1SA.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli aramubaza ati “Ni iki cyatumye mungira inama wowe na mwene Yesayi, ukamuha imitsima n'inkota, ukamugishiriza Imana inama ngo ampagurukire, ancire igico nk'uko agenje none?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.13",
            "verseOrgIds": [
              "1SA.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimeleki asubiza umwami ati “Mbese ni nde mu bagaragu bawe bose w'umwiringirwa nka Dawidi umukwe w'umwami, uba mu nama zawe akaba umunyacyubahiro mu rugo rwawe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.14",
            "verseOrgIds": [
              "1SA.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ubu ni bwo nkimugishiriza Imana inama? Ntibikambeho! Umwami ye gushyira urubanza ku mugaragu we cyangwa ku rugo rwa data rwose, kuko muri ibyo byose umugaragu wawe nta cyo nari nzi, haba n'agahurihuri kabyo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.15",
            "verseOrgIds": [
              "1SA.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami abwira Ahimeleki ati “Ni ukuri Ahimeleki, nta kikubuza gupfana n'abo mu rugo rwa so bose.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.16",
            "verseOrgIds": [
              "1SA.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aherako abwira abarinzi bamukikije ati “Nimuhindukire mwice abatambyi b'Uwiteka kuko bafatanye agatoki na Dawidi, kandi bari bazi ko yahunze ntibabimbwire.” Ariko abagaragu b'umwami banga kurambura amaboko ngo bice abatambyi b'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.17",
            "verseOrgIds": [
              "1SA.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umwami abwira Dowegi ati “Hindukira wice aba batambyi.” Nuko Dowegi Umunyedomu arahindukira arabica. Uwo munsi yica abantu mirongo inani na batanu bambaraga efodi y'igitare. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.18",
            "verseOrgIds": [
              "1SA.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze atsindisha inkota i Nobu umudugudu w'abatambyi, abagabo n'abagore, abana b'incuke n'abonka, n'inka n'indogobe n'intama, byose babimarira ku nkota.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.19",
            "verseOrgIds": [
              "1SA.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umwe mu bahungu ba Ahimeleki mwene Ahitubu witwaga Abiyatari, aracika ahungira kuri Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
            "verseOrgIds": [
              "1SA.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abiyatari abikira Dawidi ko Sawuli yishe abatambyi b'Uwiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.21",
            "verseOrgIds": [
              "1SA.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abwira Abiyatari ati “Urya munsi ubwo narebaga Dowegi Umunyedomu, namenye ko atazabura kubibwira Sawuli. Abo mu rugo rwa so bose ni jye bahowe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.22",
            "verseOrgIds": [
              "1SA.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumana nanjye, humura kuko uhiga ubugingo bwanjye ari we uhiga n'ubwawe. Nubana nanjye nta cyo uzaba.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.23",
            "verseOrgIds": [
              "1SA.22.23"
            ]
          }
        }
      ]
    }
