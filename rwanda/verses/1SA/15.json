            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.30+1KI.11.31"
              },
              "items": [
                {
                  "text": "1 Abami 11.30-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko Samweli agihindukira kugenda, Sawuli asingira ikinyita cy'umwambaro we uracika. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aramubwira ati “Uwiteka na we aguciye ku ngoma ya Isirayeli uyu munsi, ayihaye umuturanyi wawe ukuruta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibera Isirayeli amaboko ntibeshya, kandi ntiyihana kuko atari umuntu ngo yihane.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
