          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni koko Data, kuko ari ko wabishatse.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
