          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asezerera abantu, yikira mu bwato ajya mu gihugu cy'i Magadani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.39",
            "verseOrgIds": [
              "MAT.15.39"
            ]
          }
