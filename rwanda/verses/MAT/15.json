            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahamagara abigishwa be arababwira ati “Mbabariye abo bantu kuko uyu munsi ari uwa gatatu turi kumwe, none ntibafite ibyokurya. Sinshaka kubasezerera batariye, isari itabatsinda ku nzira.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.32",
            "verseOrgIds": [
              "MAT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa baramubaza bati “Muri ubu butayu twakura he imitsima ingana ityo yo guhaza abantu bangana batya?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.33",
            "verseOrgIds": [
              "MAT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu na we arababaza ati “Mufite imitsima ingahe?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramusubiza bati “Ni irindwi n'udufi duke.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.34",
            "verseOrgIds": [
              "MAT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ategeka abantu ko bicara hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.35",
            "verseOrgIds": [
              "MAT.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yenda iyo mitsima irindwi n'udufi, arabishimira, arabimanyagura, abiha abigishwa be, na bo babiha abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.36",
            "verseOrgIds": [
              "MAT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose bararya barahaga, bateranya ubuvungukira busigaye, bwuzura ibitebo birindwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.37",
            "verseOrgIds": [
              "MAT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abariye bari abagabo ibihumbi bine, abagore n'abana batabariwemo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.38",
            "verseOrgIds": [
              "MAT.15.38"
            ]
          }
        }
      ]
    },
