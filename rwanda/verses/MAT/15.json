          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramusubiza ati “Si byiza kwenda ibyokurya by'abana ngo mbijugunyire imbwa.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.26",
            "verseOrgIds": [
              "MAT.15.26"
            ]
          }
        }
      ]
