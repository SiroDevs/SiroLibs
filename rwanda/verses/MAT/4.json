                  "text": "Mar 1.39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Yesu agenderera ab'i Galilaya hose, abigishiriza mu masinagogi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "amasinagogi",
              "type": "text"
            },
            {
              "text": "ni amazu Abayuda bateraniramo basenga Imana, no kwiga ibyayo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yabo ababwira ubutumwa bwiza bw'ubwami, akiza n'indwara zose n'ubumuga bw'abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkuru ye yamamara i Siriya yose, bamuzanira abarwayi bose n'indembe barwaye indwara zitari zimwe, n'abatewe n'abadayimoni, n'abarwaye ibicuri n'ibirema arabakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu benshi baramukurikira bavuye i Galilaya n'i Dekapoli, n'i Yerusalemu n'i Yudaya no hakurya ya Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
