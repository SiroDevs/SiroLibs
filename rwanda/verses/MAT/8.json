              },
              "items": [
                {
                  "text": "Yes 53.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " kugira ngo ibyavuzwe n'umuhanuzi Yesaya bisohore ngo “Ubwe ni we watwaraga ubumuga bwacu, akikorera n'indwara zacu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gukurikira Yesu ntibyoroshye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
