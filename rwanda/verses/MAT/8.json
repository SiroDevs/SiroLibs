          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimugoroba bamuzanira abantu benshi batewe n'abadayimoni, yirukanisha abadayimoni itegeko gusa, akiza abari barwaye bose, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
