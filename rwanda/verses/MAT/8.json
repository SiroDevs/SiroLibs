            "number": "20",
            "style": "v",
            "sid": "MAT 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Undi wo mu bigishwa be aramubwira ati “Databuja, banza undeke ngende mpambe data.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.21",
            "verseOrgIds": [
              "MAT.8.21"
            ]
          }
        }
      ]
    },
    {
