                "loc": "LUK.13.28"
              },
              "items": [
                {
                  "text": "Luka 13.28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ariko abana bo muri burya bwami bazirukanirwa mu mwijima hanze, ari ho bazaririra bakahahekenyera amenyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.12",
            "verseOrgIds": [
              "MAT.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abwira uwo mutware ati “Nuko genda bikubere nk'uko wizeye.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
