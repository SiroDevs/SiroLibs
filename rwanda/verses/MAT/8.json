        },
        {
          "text": "Yesu aramubwira ati “Ingunzu zifite imyobo n'ibiguruka mu kirere bifite ibyari, ariko Umwana w'umuntu ntafite aho kurambika umusaya.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.20",
            "verseOrgIds": [
              "MAT.8.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
