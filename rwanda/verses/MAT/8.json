              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.25",
            "verseOrgIds": [
              "MAT.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza ati “Ni iki kibateye ubwoba, mwa bafite kwizera guke mwe?” Maze arabyuka acyaha umuyaga n'inyanja, biratuza rwose.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.26",
            "verseOrgIds": [
              "MAT.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baratangara bati “Uyu ni muntu ki? Umuyaga n'inyanja na byo biramwumvira!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akiza abantu bafite dayimoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.27",
            "verseOrgIds": [
              "MAT.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze gufata hakurya mu gihugu cy'Abagadareni, ahura n'abantu babiri batewe n'abadayimoni bava mu mva, bari abasazi cyane bituma ari nta watinyuka kunyura muri iyo nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barataka cyane bati “Duhuriye he, Mwana w'Imana? Mbese uje hano kutwica urupfu n'agashinyaguro, igihe cyacu kitaragera?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hirya yabo hari umugana w'ingurube nyinshi zirisha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.30",
            "verseOrgIds": [
              "MAT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadayimoni ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        },
        {
          "text": " baramwinginga bati “Nutwirukana utwohereze muri uriya mugana w'ingurube.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabasubiza ati “Nimugende.” Babavamo baragenda, bajya muri izo ngurube. Umugana wose wirukira ku gacuri, zisuka mu nyanja zipfira mu mazi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abungeri bazo barahunga, binjiye mu mudugudu bavuga ibyo babonye byose, n'iby'abari batewe n'abadayimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo muri uwo mudugudu bose bajya gusanganira Yesu, bamubonye baramwinginga ngo ave mu gihugu cyabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
            "verseOrgIds": [
              "MAT.8.34"
            ]
          }
        }
