            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ajya mu nzu ya Petero, abona nyirabukwe aryamye arwaye ubuganga, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.14",
            "verseOrgIds": [
              "MAT.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "amukora ku kuboko ubuganga bumuvamo, arabyuka aramugaburira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        }
