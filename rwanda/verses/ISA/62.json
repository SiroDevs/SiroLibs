                "loc": "ISA.40.10"
              },
              "items": [
                {
                  "text": "Yes 40.10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.12"
              },
              "items": [
                {
                  "text": "Ibyah 22.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore Uwiteka arategetse, ageza ku mpera y'isi ati “Nimubwire umukobwa w'i Siyoni muti ‘Dore Umukiza wawe araje, azanye n'ingororano kandi inyiturano yo kwitura imuje imbere.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 62:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabita ubwoko bwera, abacunguwe n'Uwiteka, kandi uzitwa Ahashatswe, Umurwa utatawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.12",
            "verseOrgIds": [
              "ISA.62.12"
            ]
          }
        }
      ]
