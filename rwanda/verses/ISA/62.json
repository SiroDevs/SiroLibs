              },
              "items": [
                {
                  "text": "57.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nimusohoke munyure mu marembo mutunganirize abantu inzira, mutumburure, mutumburure inzira nyabagendwa muyikuremo amabuye, mushingire amahanga ibendera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.10",
            "verseOrgIds": [
              "ISA.62.10"
            ]
          }
        },
        {
          "name": "verse",
