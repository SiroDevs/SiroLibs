        },
        {
          "text": " Kandi abahungu bawe uzibyarira mu nda yawe bazabajyana, babagire inkone zo kuba mu nzu y'umwami w'i Babuloni.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
