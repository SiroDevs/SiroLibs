              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya abwira Hezekiya ati “Umva ijambo ry'Uwiteka Nyiringabo: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe kizaza ibiri mu nzu yawe byose, n'ibyo ba sogokuruza babitse kugeza ubu bizajyanwe i Babuloni, nta kintu kizasigara. Ni ko Uwiteka avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
