              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo hari ubitegera amatwi muri mwe, akumva ibyo mu gihe kizaza akabimenya? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde watanze Yakobo ngo ajyanwe ho iminyago, kandi Isirayeli akamuha abanyazi? Si Uwiteka se uwo twacumuyeho, kandi ntibemere kugendera mu nzira ze, ntibumvire amategeko ye? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
