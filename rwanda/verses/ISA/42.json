              },
              "items": [
                {
                  "text": "Mar 1.11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.22"
              },
              "items": [
                {
                  "text": "Luka 3.22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.35"
              },
              "items": [
                {
                  "text": "9.35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Dore umugaragu wanjye ndamiye, uwo natoranije umutima wanjye ukamwishimira. Mushyizeho umwuka wanjye, azazanira abanyamahanga gukiranuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntazatongana, ntazasakuza kandi ntazumvikanisha ijwi rye mu nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubingo rusadutse ntazaruvuna kandi n'urumuri rucumba ntazaruzimya, ahubwo azazana gukiranuka by'ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntazacogora, ntazakuka umutima kugeza aho azasohoreza gukiranuka mu isi, n'ibirwa bizategereza amategeko ye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umva uko Imana Uwiteka ivuze, iyaremye ijuru ikaribamba, iyarambuye isi n'ibiyivamo, abayituramo ikabaha umwuka kandi abayigendaho ikabaha ubugingo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.6"
              },
              "items": [
                {
                  "text": "Yes 49.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.32"
              },
              "items": [
                {
                  "text": "Luka 2.32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.47"
              },
              "items": [
                {
                  "text": "Ibyak 13.47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.23"
              },
              "items": [
                {
                  "text": "26.23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Jyewe Uwiteka naguhamagariye gukiranuka, nzagufata ukuboko, nzakurinda nguhe kuba isezerano ry'abantu no kuba umucyo uvira abanyamahanga, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "no guhumūra impumyi, ukabohora imbohe ugakura ababa mu mwijima mu nzu y'imbohe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndi Uwiteka ni ryo zina ryanjye, icyubahiro cyanjye sinzagiha undi, n'ishimwe ryanjye sinzariha ibishushanyo bibajwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore ibya mbere birasohoye, n'ibishya ndabibamenyesha mbibabwire bitari byaba.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuririmbire Uwiteka indirimbo nshya n'ishimwe rye uhereye ku mpera y'isi. Nimuririmbe mwa bamanuka bajya ku nyanja mwe, n'ibiyirimo byose n'ibirwa n'ababituyeho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutayu n'imidugudu yabwo birangurure amajwi yabyo, n'ibirorero bituweho n'Abakedari, n'abaturage b'i Sela baririmbe ijwi rirenga bari mu mpinga z'imisozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibyo nibyubahe Uwiteka, byamamaze ishimwe rye mu birwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
              "ISA.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka azatabara ari intwari, arwane ishyaka nk'intwari mu ntambara, azivuga arangurure ijwi, ababisha be azabakoreraho ibikomeye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.13",
            "verseOrgIds": [
              "ISA.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dore imbara nacecekeye, narahoze ndiyumanganya, noneho ndataka cyane nk'uko umugore uramukwa asamaguza asemeka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzarimbura imisozi n'udusozi, numishe ubwatsi bwose kandi imigezi nzayihindura ibirwa, n'ibidendezi nzabikamya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.15",
            "verseOrgIds": [
              "ISA.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Impumyi nzaziyobora inzira zitazi, nzinyuze mu tuyira zitigeze kumenya. Umwijima nzawuhindurira umucyo imbere yazo, n'ahagoramye nzahagorora. Ibyo nzabibakorera kandi sinzabahāna. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abiringira ibishushanyo bibajwe bazasubizwa inyuma, ababwira ibishushanyo biyagijwe bati ‘Muri imana zacu’, bazakorwa n'isoni cyane.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwa bipfamatwi mwe, nimwumve. Mwa mpumyi mwe, nimurebe mwitegereze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hari indi mpumyi atari umugaragu wanjye, cyangwa hari ikindi gipfamatwi atari intumwa yanjye ntuma? Hari indi mpumyi atari umuyoboke wanjye, kandi hari impumyi atari umugaragu w'Uwiteka? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areba byinshi ariko ntiyitegereza, amatwi ye arazibutse ariko ntiyumva.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bwo gukiranuka kwe, Uwiteka yashimye kogeza amategeko ye no kuyubahiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko aba ni abantu banyazwe ibyabo bagasenyerwa, bose batezwe ubushya kandi babahisha mu mazu y'imbohe. Ni abo kujyanwa ho iminyago nta wuriho wo kubakiza, ni abo kunyagwa ibyabo ari nta wo kuvuga ko babisubizwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
