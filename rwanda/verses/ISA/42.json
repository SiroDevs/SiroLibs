          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye amurohaho uburakari bwe bugurumana n'intambara zikomeye, bikamutwika impande zose kandi ntabimenye, ibyo byaramutwitse ariko ntiyabyitaho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
