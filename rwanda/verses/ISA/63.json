                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Uriya ni nde uturutse muri Edomu, agahaguruka i Bosira yambaye imyambaro y'imihemba, yambaye imyenda y'icyubahiro agendana imbaraga zihebuje? 1.11-12; Obad 1-14; Mal 1.2-5",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni jye uvugisha gukiranuka, nyir'imbaraga zo gukiza.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 63:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.1",
            "verseOrgIds": [
              "ISA.63.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni iki gitumye imyenda yawe itukura, imyambaro yawe igasa n'iy'uwengesheje ibirenge mu muvure wengerwamo vino?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 63:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.2",
            "verseOrgIds": [
              "ISA.63.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 63:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.20"
              },
              "items": [
                {
                  "text": "Ibyah 14.20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.13"
              },
              "items": [
                {
                  "text": "19.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Niyengesheje umuvure jyenyine, mu bantu bo mu mahanga yose nta n'umwe twari kumwe. Ni ukuri nabengesheje ibirenge ndakaye, mbavungisha umujinya wanjye maze amaraso yabo yimisha ku myambaro yanjye, imyenda yanjye yose irahindana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.3",
            "verseOrgIds": [
              "ISA.63.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 63:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nari naragambiriye umunsi wo guhoreramo inzigo, none n'umwaka wo gucungura abantu banjye na wo uratashye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.4",
            "verseOrgIds": [
              "ISA.63.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 63:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.16"
              },
              "items": [
                {
                  "text": "Yes 59.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nararanganije amaso mbona nta wutabaye, ntangazwa n'uko ari nta wandengeye. Ni cyo cyatumye ukuboko kwanjye kunzanira agakiza, n'uburakari bwanjye ni bwo bwandengeye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.5",
            "verseOrgIds": [
              "ISA.63.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvungisha amahanga uburakari bwanjye, mbasindisha umujinya wanjye, amaraso yabo nyavushiriza ku isi.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 63:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.6",
            "verseOrgIds": [
              "ISA.63.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 63:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzajya nogeza ibyo Uwiteka yangiriye neza n'ishimwe rye, ibyo yaduhaye byose nzajya mbivuga uko bingana, muvuge n'ibyiza byinshi yagiriye inzu ya Isirayeli, ibyo yabahereye ubuntu, nk'uko imbabazi ze nyinshi zingana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yavuze ati “Ni ukuri aba ni abantu banjye, abana batariganya.” Nuko ababere Umukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yababaranye na bo mu mibabaro yabo yose, na marayika uhora imbere ye yajyaga abakiza. Urukundo rwe n'imbabazi ze ni byo byamuteye kubacungura, yarabateruraga akabaheka iminsi yose ya kera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.9",
            "verseOrgIds": [
              "ISA.63.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko baragoma bababaza Umwuka we wera, bituma ahinduka umwanzi wabo ndetse ubwe arwana na bo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 63:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.10",
            "verseOrgIds": [
              "ISA.63.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 63:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze yibuka ibya kera, yibuka Mose n'abantu be ati “Uwabazamuranye n'abungeri b'intama ze, akabakura mu nyanja agiye he? Uwabashyizemo Umwuka we wera ari he? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.11",
            "verseOrgIds": [
              "ISA.63.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 63:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.21"
              },
              "items": [
                {
                  "text": "Kuva 14.21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nde watumye ukuboko kwe kw'icyubahiro kugenda iruhande rw'iburyo rwa Mose, agatandukanya amazi imbere yabo akihesha izina rihoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.12",
            "verseOrgIds": [
              "ISA.63.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 63:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akabanyuza imuhengeri nk'amafarashi anyura mu butayu, ntibasitare? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.13",
            "verseOrgIds": [
              "ISA.63.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 63:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'uko inka zinyura mu gikombe, ni ko Umwuka w'Uwiteka yabaruhuraga.” Uko ni ko wayoboye abantu bawe, kugira ngo wiheshe izina ry'icyubahiro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.14",
            "verseOrgIds": [
              "ISA.63.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 63:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.14",
            "verseOrgIds": [
              "ISA.63.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 63:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reba hasi uri mu ijuru, witegereze uri mu buturo bwo kwera kwawe n'ubw'icyubahiro cyawe. Umwete wawe n'imirimo yawe y'imbaraga biri he? Urukundo rwo mu mutima wawe n'imbabazi zawe ndabyimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.15",
            "verseOrgIds": [
              "ISA.63.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 63:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erega ni wowe Data wa twese, nubwo Aburahamu atatuzi, Isirayeli ntatwemere! Wowe ubwawe Uwiteka, ni wowe Data wa twese, uri Umucunguzi wacu, uhereye kera kose ni ryo zina ryawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.16",
            "verseOrgIds": [
              "ISA.63.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 63:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka, ni iki gituma utuyobya inzira zawe, ukanangira imitima yacu ntitukubahe? Garuka ugirire abagaragu bawe, ari bo miryango ya gakondo yawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.17",
            "verseOrgIds": [
              "ISA.63.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 63:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.17",
            "verseOrgIds": [
              "ISA.63.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 63:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bawe bera bahategetse igihe gito gusa, abanzi bacu bakuribatiye ubuturo bwawe bwera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.18",
            "verseOrgIds": [
              "ISA.63.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 63:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twahindutse nk'abatigeze gutegekwa nawe, nk'abatigeze kwitirirwa izina ryawe.",
          "type": "text",
          "attrs": {
