            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.18+REV.21.19+REV.21.20+REV.21.21"
              },
              "items": [
                {
                  "text": "Ibyah 21.18-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Yewe urengana, ugahungabanywa n'inkubi y'umuyaga ntuhumurizwe, amabuye yawe nzayateraho amabara meza, imfatiro zawe nzazishingisha safiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.11",
            "verseOrgIds": [
              "ISA.54.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 54:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iminara yawe nzayubakisha amabuye abengerana, kandi urugabano rwawe nzarushingisha amabuye anezeza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.12",
            "verseOrgIds": [
              "ISA.54.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
