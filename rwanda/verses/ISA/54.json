              "ISA.54.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 54:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.13",
            "verseOrgIds": [
              "ISA.54.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.45"
              },
              "items": [
                {
                  "text": "Yoh 6.45",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Abana bawe bose bazigishwa n'Uwiteka, kandi bazagira amahoro menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.13",
            "verseOrgIds": [
              "ISA.54.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 54:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzakomezwa no gukiranuka, agahato kazakuba kure kuko utazatinya, uzaba kure y'ibiteye ubwoba kuko bitazakwegera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.14",
            "verseOrgIds": [
              "ISA.54.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 54:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahari bazaterana ariko si jye uzaba ubateranije, uzagukoraniraho wese azagwa ari wowe azize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 54:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.15",
            "verseOrgIds": [
              "ISA.54.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 54:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Dore ni jye urema umucuzi uvugutira umuriro w'amakara agakuramo icyuma akoresha umurimo we, kandi umurimbuzi namuremeye kurimbura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.16",
            "verseOrgIds": [
              "ISA.54.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 54:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nta ntwaro bacuriye kukurwanya izagira icyo igutwara, kandi ururimi rwose ruzaguhagurukira kukuburanya uzarutsinda. Ibyo ni byo murage w'abagaragu b'Uwiteka, kandi uko ni ko gukiranuka kwabo guturuka aho ndi.” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.17",
            "verseOrgIds": [
              "ISA.54.17"
            ]
          }
        }
      ]
    }
