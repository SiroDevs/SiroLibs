          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko muzamera nk'igiti cy'umwela cy'ibibabi birabye, cyangwa nk'isambu itagira amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
              "ISA.1.30"
            ]
          }
        },
        {
