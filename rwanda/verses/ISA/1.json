              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunyambaraga azamera nk'ubutumba kandi umurimo we uzamera nk'igishashi, bizahira hamwe kandi nta wuzabizimya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.31",
