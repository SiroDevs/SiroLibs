          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzakorwa n'isoni z'imirinzi mwifuje, kandi muzamwazwa n'amasambu mwatoranije, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
        {
