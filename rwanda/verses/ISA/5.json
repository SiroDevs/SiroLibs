              },
              "items": [
                {
                  "text": "Luka 20.9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Reka ndirimbire umukunzi wanjye indirimbo y'uruzabibu rwe. Umukunzi wanjye yari afite urutoki rw'uruzabibu ku musozi urumbuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.1",
            "verseOrgIds": [
              "ISA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ararutabirira arurimburamo amabuye, aruteramo insina y'umuzabibu y'ubwoko bwiza cyane, arwubakamo inzu y'amatafari ndende acukuramo n'urwina. Nuko yiringira ko ruzera inzabibu, ariko rwera indibu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.2",
            "verseOrgIds": [
              "ISA.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.2",
            "verseOrgIds": [
              "ISA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe mwa baturage b'i Yerusalemu mwe, namwe bagabo b'i Buyuda, nimudukize jyewe n'uruzabibu rwanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.3",
            "verseOrgIds": [
              "ISA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikintu nari nkwiriye gukorera uruzabibu rwanjye nasize ni ikihe, ko nari niringiye ko ruzera inzabibu, ni iki cyatumye rwera indibu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.4",
            "verseOrgIds": [
              "ISA.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.4",
            "verseOrgIds": [
              "ISA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneho rero reka mbabwire ibyo ngiye gukorera urutoki rwanjye. Nzasenya uruzitiro rwarwo maze rwonwe rwose, nsenye n'inkike yarwo, runyukanyukwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.5",
            "verseOrgIds": [
              "ISA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nzarurimbura. Ntiruzicirwa, ntiruzahingirwa, ahubwo ruzameramo imifatangwe n'amahwa, kandi nzategeka ibicu bye kurugushamo imvura, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko urutoki rw'Uwiteka Nyiringabo ari inzu ya Isirayeli, n'Abayuda ni insina yishimiraga. Yabiringiragamo imanza zitabera, ariko abasangamo kurenganya. Yabiringiragamo gukiranuka, ariko abasangamo umuborogo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Icyaha cyo guhuguza n'igihano cyacyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abagerekeranya ingo ku zindi, bakikubira imirima kugeza ubwo hatagira ahasigara, mugatura mu gihugu mwenyine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka Nyiringabo yampishuriye atya ati “Ingo nyinshi, ndetse n'ingo nini nziza zizaba imisaka, he kugira uzibamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.9",
            "verseOrgIds": [
              "ISA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imirima y'inzabibu cumi izavamo incuro imwe y'intebo, kandi ibibibiro cumi by'imbuto z'amasaka bizavamo incuro imwe y'igiseke.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Icyaha cy'ubusinzi n'ibindi byaha n'ibihano byabyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abazindurwa no kuvumba ibisindisha, bakaba ari cyo biririrwa bakabirara inkera, kugeza aho bibahindura nk'abasazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.11",
            "verseOrgIds": [
              "ISA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu birori byabo bagira inanga na nebelu n'ishako n'imyironge na vino, maze ntibite ku murimo w'Uwiteka, ntibatekereze ibyo yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
              "ISA.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo cyatumye ubwoko bwanjye bujyanwa ho iminyago buzize ubupfu bwabwo, abanyacyubahiro bo muri bwo bishwe n'inzara kandi rubanda ruguye umwuma. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikuzimu habaye ikirura, hasamishije akanwa kaho bitagira akagero, maze abantu banjye uko bangana bahamanukana icyubahiro cyabo, ndetse n'uwo muri bo binezereye bagwanamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umuntu acishijwe bugufi n'ukomeye aracogozwa, n'amaso y'abibone na bo aracogozwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Uwiteka Nyiringabo ashyirishijwe hejuru n'imanza zitabera. Imana yera iragaragarisha kwera kwayo gukiranuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icyo gihe abana b'intama bazarisha mu bikingi byabo uko bashatse, kandi mu matongo y'abakire inzererezi zizahahindūra.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
            "verseOrgIds": [
              "ISA.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abakururisha gukiranirwa ingeso zabo mbi nk'ukuruza umugozi, bakurura n'icyaha nk'ukurura umurunga w'igare, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.18",
            "verseOrgIds": [
              "ISA.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakavuga bati “Ngaho natebuke, agire vuba umurimo we tuwurebe, n'umugambi w'Uwera wa Isirayeli wigire hano, uze tuwumenye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.19",
            "verseOrgIds": [
              "ISA.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.19",
            "verseOrgIds": [
              "ISA.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abita ikibi icyiza n'icyiza bakacyita ikibi. Umwijima bawushyira mu cyimbo cy'umucyo, n'umucyo bakawushyira mu cyimbo cy'umwijima, ibisharira babishyira mu cyimbo cy'ibiryohereye, n'ibiryohereye bakabishyira mu cyimbo cy'ibisharira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
            "verseOrgIds": [
              "ISA.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.20",
            "verseOrgIds": [
              "ISA.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abiyita abanyabwenge bajijutse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.21",
            "verseOrgIds": [
              "ISA.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazabona ishyano abigira intwari zo kunywa inzoga, bakagira imbaraga zo guturira ibisindisha, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.22",
            "verseOrgIds": [
              "ISA.5.22"
            ]
          }
        },
        {
          "name": "verse",
