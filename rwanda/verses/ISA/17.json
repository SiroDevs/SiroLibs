                }
              ]
            }
          ]
        },
        {
          "text": " Ibihanurirwa i Damasiko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
