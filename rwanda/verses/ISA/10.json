          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore bageze Ayati banyuze i Miguroni, i Mikimashi ni ho babitse imitwaro yabo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.28",
            "verseOrgIds": [
              "ISA.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bageze aharenga baganditse i Geba. Ab'i Rama bahinze imishyitsi, ab'i Gibeya yo kwa Sawuli barahunze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.29",
            "verseOrgIds": [
              "ISA.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rangurura ijwi ryawe utake, wa mukobwa w'i Galimu we, ubyumve nawe Layishi, yewe Anatoti wa mutindi we! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.30",
            "verseOrgIds": [
              "ISA.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab'i Madumana babaye impunzi, n'abaturage b'i Gebimu baraterana ngo bahunge.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.31",
            "verseOrgIds": [
              "ISA.10.31"
            ]
          }
        }
      ]
