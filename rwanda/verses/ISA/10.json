          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu munsi wa none arataha i Nobu, arakōrēra ukuboko ku musozi w'umukobwa w'i Siyoni, ari wo Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.32",
            "verseOrgIds": [
              "ISA.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore Uwiteka Umwami Nyiringabo azatemesha amashami imbaraga ze ziteye ubwoba, abasumba abandi cyane bazatemwa, n'abarebare bazacishwa bugufi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.33",
            "verseOrgIds": [
              "ISA.10.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi azamaraho ibihuru byo mu ishyamba abitemesheje icyuma, n'i Lebanoni hazatsindwa n'iyo ntwari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.34",
            "verseOrgIds": [
              "ISA.10.34"
            ]
          }
        }
      ]
