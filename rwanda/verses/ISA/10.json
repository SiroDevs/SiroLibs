        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni cyo gituma Uwiteka Umwami Nyiringabo avuga ati “Yemwe bantu banjye batura i Siyoni, ntimutinye Abashuri nubwo babakubita inkoni bakababangurira inshyimbo, bakabagirira nk'uko Abanyegiputa babagize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.24",
            "verseOrgIds": [
              "ISA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasigaye igihe gito cyane, uburakari n'umujinya byanjye bizabageraho mbarimbure.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.25",
            "verseOrgIds": [
              "ISA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uwiteka Nyiringabo azamubangurira ibiboko nk'ubwo Abamidiyani bicirwaga ku gitare cya Orebu, kandi inkoni ye azaba ayibanguriye hejuru y'inyanja, nk'uko yabigenje muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.26",
            "verseOrgIds": [
              "ISA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo munsi umutwaro baguhekeshaga uzakuva ku bitugu, kandi uzakurwa no ku buretwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "buretwa:",
              "type": "text"
            },
            {
              "text": "reba Itang 27.40 n'igisobanuro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " bagushyizeho, uburetwa buzamarwa no gusīgwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.27",
            "verseOrgIds": [
              "ISA.10.27"
            ]
          }
        }
      ]
    },
