                "loc": "ZEP.2.13+ZEP.2.14+ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2.13-15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ashuri ni yo ngegene y'umujinya wanjye, kandi inkoni yitwaje ni yo burakari bwanjye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.5",
            "verseOrgIds": [
              "ISA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzamuteza ishyanga risuzugura Imana n'ubwoko narakariraga, nzaritegeka kubanyaga bakabajyana ho iminyago, bakabanyukanyukira hasi nk'ibyondo byo mu nzira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.6",
            "verseOrgIds": [
              "ISA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.6",
            "verseOrgIds": [
              "ISA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ibyo si we wabyitumaga ubwe, umutima we ntiwabyibwiraga, ahubwo yamaraniraga kurimbura no kumaraho amahanga atari make. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.7",
            "verseOrgIds": [
              "ISA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko avuga ati “Mbese abatware banjye bose uko bangana si abami? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.8",
            "verseOrgIds": [
              "ISA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Kalino ntihameze nk'i Karikemeshi? N'i Hamati ntihameze nka Arupadi? N'i Samariya ntihameze nk'i Damasiko? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.9",
            "verseOrgIds": [
              "ISA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk'uko ukuboko kwanjye kwageze ku bihugu by'ibigirwamana byari bifite ibishushanyo bibajwe byarutaga ibiri i Yerusalemu n'i Samariya, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.10",
            "verseOrgIds": [
              "ISA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibyo nagiriye i Samariya n'ibigirwamana byaho, sinzabigirira i Yerusalemu n'ibigirwamana byaho?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.11",
            "verseOrgIds": [
              "ISA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Umwami Imana nimara gusohoza ibyo yagambiriye ku musozi wa Siyoni n'i Yerusalemu byose, nzaherako mpane umwami wa Ashuri, muhora ibyo yakoreshejwe n'umutima w'igitsure n'ubwibone by'icyubahiro cye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.12",
            "verseOrgIds": [
              "ISA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yavuze ati “Narabikoze ubwanjye mbikoresheje imbaraga z'ukuboko kwanjye n'ubwenge bwanjye, kuko ndi umunyabwenge. Nakuyeho ingabano z'amahanga, nanyaze ubutunzi bwabo, nagize ubutwari, nimikūra abari bicaye ku ntebe z'ubwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.13",
            "verseOrgIds": [
              "ISA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukuboko kwanjye kwiboneye ubutunzi bw'amahanga nk'uwiboneye icyari cy'inyoni, kandi nk'uko umuntu ateranya amagi inyoni yaretse, ni ko nanjye nateranije ibihugu byo mu isi yose. Nta winyagambuye ngo arambure ibaba, nta wabumbuye akanwa kandi nta n'uwajwigiriye.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.14",
            "verseOrgIds": [
              "ISA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.14",
            "verseOrgIds": [
              "ISA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese intorezo yakwirata ku uyitemesha? Urukero rwakwiyogeza ku urukeresha? Ni nk'aho inkoni yazunguza uyiteruye, cyangwa inshyimbo ikiterura nk'aho atari igiti.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.15",
            "verseOrgIds": [
              "ISA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni byo bizatuma Uwiteka Umwami Nyiringabo ateza abantu be babyibushye konda, kandi mu bwiza bwe hazakongezwa hatwikwe nk'ahatwikwa n'umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.16",
            "verseOrgIds": [
              "ISA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umucyo wa Isirayeli uzaba umuriro, kandi Uwera we azaba ikirimi, bazatwika bamareho imifatangwe n'amahwa bye umunsi umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.17",
            "verseOrgIds": [
              "ISA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi azamaraho ubwiza bw'ishyamba rye, n'ubw'imirima ye yera cyane, azamaraho n'ubugingo n'umubiri, hazabaho ubwihebe nk'uko bimera iyo ūtwara ibendera yiheba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.18",
            "verseOrgIds": [
              "ISA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibiti bizasigara mu ishyamba rye bizaba bike, ibyo umwana muto yakwandika umubare.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imana isezeranya Abisirayeli kubatabara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.19",
            "verseOrgIds": [
              "ISA.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uwo munsi abazaba barokotse muri Isirayeli n'abazaba bacitse ku icumu mu nzu ya Yakobo, bazaba batacyisunga ababakubise, ahubwo bazisunga Uwiteka by'ukuri, Uwera wa Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.20",
            "verseOrgIds": [
              "ISA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarokotse bo mu Bayakobo bazagarukira Imana ikomeye, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.21",
            "verseOrgIds": [
              "ISA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.27"
              },
              "items": [
                {
                  "text": "Rom 9.27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ariko nubwo ubwoko bwawe bwa Isirayeli bungana n'umusenyi wo ku nyanja, igice cyabwo ni cyo kizarokoka kigaruke. Byaragambiriwe gusohozwa rwose n'urubanza rutabera, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.22",
            "verseOrgIds": [
              "ISA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Uwiteka Umwami Nyiringabo yagambiriye kuzabisohoza hagati mu bihugu byose.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.10.23",
            "verseOrgIds": [
              "ISA.10.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 10:23"
          },
