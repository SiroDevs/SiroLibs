                }
              ]
            }
          ]
        },
        {
          "text": " Nimwumve ijwi ry'urangurura ngo “Nimutunganyirize Uwiteka inzira mu butayu, mugororere Imana yacu inzira nyabagendwa mu kidaturwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.3",
            "verseOrgIds": [
              "ISA.40.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
