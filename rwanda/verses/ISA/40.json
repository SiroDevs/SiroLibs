              "items": [
                {
                  "text": "Ibyah 22.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Dore Umwami Imana izaza ari intwari, kandi ukuboko kwayo kuzayitegekera. Dore izanye ingororano, kandi inyiturano zayo ziyiri imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
