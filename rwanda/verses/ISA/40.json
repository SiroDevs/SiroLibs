              "ISA.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yewe wumvisha i Siyoni inkuru z'ibyiza zamuka umusozi muremure, yewe wumvisha i Yerusalemu inkuru z'ibyiza rangurura ijwi ryawe cyane, rirangurure witinya ubwire imidugudu y'i Buyuda uti “Dore Imana yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.9",
            "verseOrgIds": [
              "ISA.40.9"
            ]
          }
        }
      ]
    },
    {
