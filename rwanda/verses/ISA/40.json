            "number": "11",
            "style": "v",
            "sid": "ISA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.15"
              },
              "items": [
                {
                  "text": "Ezek 34.15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.10.11"
              },
              "items": [
                {
                  "text": "Yoh 10.11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Izaragira umukumbi wayo nk'umushumba, izateraniriza abana b'intama mu maboko ibaterurire mu gituza, kandi izonsa izazigenza neza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.11",
            "verseOrgIds": [
              "ISA.40.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Uburyo Imana ikomeye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.11",
            "verseOrgIds": [
              "ISA.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde wigeze kugera amazi ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.12",
            "verseOrgIds": [
              "ISA.40.12"
            ]
          }
        },
        {
          "text": " ku rushyi, akageresha ijuru intambwe z'intoki, akabona indengo yajyamo umukungugu wo ku isi, agashyira imisozi mu gipimo, n'udusozi akatugera mu minzani? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.12",
            "verseOrgIds": [
              "ISA.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.34"
              },
              "items": [
                {
                  "text": "Rom 11.34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.16"
              },
              "items": [
                {
                  "text": "1 Kor 2.16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ni nde wigeze kugenzura Umwuka w'Uwiteka, akamuhugura nk'umugira inama? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yigeze kugisha inama kandi ni nde wigeze kumwigisha, akamwereka uburyo bwo guca imanza zitabera, akamwigisha ubwenge, akamuha uburyo bwo kwitegereza?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore amahanga ameze nk'igitonyanga kiri mu kibindi, agereranywa n'umukungugu ufashe ku minzani. Dore aterura ibirwa nk'uterura akantu gato cyane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.15",
            "verseOrgIds": [
              "ISA.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Lebanoni ntihaba inkwi zo gucana zihagije, kandi n'inyamaswa zaho ntizashyika kuba igitambo cyoswa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.16",
            "verseOrgIds": [
              "ISA.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu maso ye amahanga yose ni nk'ubusa, kuri we abarwa nk'ubusa ndetse ari hanyuma y'ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.17",
            "verseOrgIds": [
              "ISA.40.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.17",
            "verseOrgIds": [
              "ISA.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
