    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze habaho ubaza ati “Ndarangururira iki?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abantu bose bameze nk'ubwatsi, n'ubwiza bwabo bwose bumeze nk'uburabyo bwo ku gasozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwatsi buraraba, uburabyo bugahunguka kuko umwuka w'Uwiteka ubuhushyeho. Ni ukuri abantu ni nk'ubwatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.7",
            "verseOrgIds": [
              "ISA.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwatsi buraraba uburabyo bugahunguka, ariko Ijambo ry'Imana yacu rizahoraho iteka ryose.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.8",
            "verseOrgIds": [
              "ISA.40.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
