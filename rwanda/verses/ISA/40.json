              "ISA.40.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.29"
              },
              "items": [
                {
                  "text": "Ibyak 17.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nuko rero Imana mwayihwanya na nde, cyangwa mwayigereranya n'ishusho ki? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.18",
            "verseOrgIds": [
              "ISA.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore igishushanyo kibajwe umucuzi abanza kukiyaza, umucuzi w'izahabu akagiteraho izahabu, akagicurira imikufi y'ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.19",
            "verseOrgIds": [
              "ISA.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutindi utabona ituro ringana rityo ashaka igiti kitazabora, maze akishakira umukozi w'umuhanga wo gushinga igishushanyo kibajwe, kitazakuka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.20",
            "verseOrgIds": [
              "ISA.40.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.20",
            "verseOrgIds": [
              "ISA.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ntimwamenye kandi ntimurakumva? Nta cyo mwabwiwe uhereye mbere na mbere? Uhereye igihe isi yaremewe nta cyo mwasobanuriwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.21",
            "verseOrgIds": [
              "ISA.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo yicaye hejuru ku rusenge rw'ijuru, abaturage bo mu isi bameze nk'ubuzīkira. Ni yo ibamba ijuru nk'inyegamo, ikaribamba nk'ihema ryo kubamo, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.22",
            "verseOrgIds": [
              "ISA.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibikomangoma ikabihindura ubusa n'abacamanza bo mu isi ikabahindura ibitagira umumaro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.23",
            "verseOrgIds": [
              "ISA.40.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ukuri ni yo bagiterwa, ni koko ni yo bakibibwa, kandi igiti cyabo ni yo kigishora imizi mu butaka. Imana ibahuhaho bakaraba, umuyaga wa serwakira ukabayora nk'ibishingwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.24",
            "verseOrgIds": [
              "ISA.40.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.24",
            "verseOrgIds": [
              "ISA.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nuko rero mwangereranya na nde twahwana?” Ni ko Uwera abaza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.25",
            "verseOrgIds": [
              "ISA.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwubure amaso yanyu murebe hejuru. Ni nde waremye biriya, agashora ingabo zabyo mu mitwe, zose akazihamagara mu mazina? Kuko afite imbaraga nyinshi akagira amaboko n'ububasha, ni cyo gituma nta na kimwe kizimira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.26",
            "verseOrgIds": [
              "ISA.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.26",
            "verseOrgIds": [
              "ISA.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yewe Yakobo Isirayeli, ni iki gituma wiganyira ukavuga uti “Uwiteka ntareba inzira zanjye, kandi ibyanjye Imana yanjye irabyirengagiza”? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.27",
            "verseOrgIds": [
              "ISA.40.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbese ntiwari wabimenya? Ese nturabyumva? Imana ihoraho, Uwiteka Umuremyi w'impera z'isi ntirambirwa, ntiruha. Ubwenge bwayo ntiburondoreka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.28",
            "verseOrgIds": [
              "ISA.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yo iha intege abarambiwe, kandi utibashije imwongeramo imbaraga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.29",
            "verseOrgIds": [
              "ISA.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasore b'imigenda bazacogora baruhe, n'abasore bazagwa rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.30",
            "verseOrgIds": [
              "ISA.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abategereza Uwiteka bazasubizwamo intege nshya, bazatumbagira mu kirere bagurukishe amababa nk'ibisiga, baziruka be kunanirwa, bazagenda be gucogora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.31",
            "verseOrgIds": [
              "ISA.40.31"
            ]
          }
        }
      ]
    }
