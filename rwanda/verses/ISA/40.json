          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nimuhumurize abantu banjye, mubahumurize.” Ni ko Imana yanyu ivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muvuge ibyururutsa imitima y'ab'i Yerusalemu, mukomere muhabwire ko intambara zaho zishize kandi yuko gukiranirwa kwaho hakubabariwe, n'ibyaha byaho byose ko habihaniwe kabiri n'Uwiteka.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
