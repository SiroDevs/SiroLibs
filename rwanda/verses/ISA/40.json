                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ijwi ryaravuze riti “Rangurura.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.6",
            "verseOrgIds": [
              "ISA.40.6"
