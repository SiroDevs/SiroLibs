              "attrs": {
                "loc": "LUK.3.4+LUK.3.5+LUK.3.6"
              },
              "items": [
                {
                  "text": "Luka 3.4-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.3",
            "verseOrgIds": [
              "ISA.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igikombe cyose kizuzuzwa kandi umusozi wose n'agasozi bizaringanizwa, n'ahagoramye hazagororwa n'inzira zidaharuwe zizaharurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.4",
            "verseOrgIds": [
              "ISA.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze icyubahiro cy'Uwiteka kizahishurwa kandi abantu bose bazakibonera rimwe, kuko akanwa k'Uwiteka ari ko kabivuze.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.5",
            "verseOrgIds": [
              "ISA.40.5"
            ]
          }
        }
      ]
    },
