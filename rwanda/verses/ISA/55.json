              "ISA.55.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.9.10"
              },
              "items": [
                {
                  "text": "2 Kor 9.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nk'uko imvura na shelegi bimanuka bivuye mu ijuru ntibisubireyo, ahubwo bigatosa ubutaka bukameza imbuto bugatoshya n'ingundu, bugaha umubibyi imbuto n'ushaka kurya bukamuha umutsima, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.10",
            "verseOrgIds": [
              "ISA.55.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ko ijambo ryanjye riva mu kanwa kanjye rizamera. Ntirizagaruka ubusa ahubwo rizasohoza ibyo nshaka, rizashobora gukora icyo naritumye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 55:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.11",
            "verseOrgIds": [
              "ISA.55.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 55:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Muzasohokana ibyishimo, muzashorerwa amahoro muvayo. Imisozi n'udusozi bizaturagara biririmbire imbere yanyu, ibiti byose byo mu gasozi bizakoma mu mashyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.12",
            "verseOrgIds": [
              "ISA.55.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 55:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu cyimbo cy'umufatangwe hazamera umuberoshi, mu cyimbo cy'umukeri hazamera umuhadasi, bizubahisha izina ry'Uwiteka, bizaba ikimenyetso gihoraho kitazakurwaho.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.55.13",
            "verseOrgIds": [
              "ISA.55.13"
            ]
          }
        }
      ]
    }
