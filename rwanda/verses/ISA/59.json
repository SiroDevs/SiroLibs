              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.26"
              },
              "items": [
                {
                  "text": "Rom 11.26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nuko umucunguzi azaza i Siyoni, asange Abayakobo bahindukira bakareka gucumura.” Ni ko Uwiteka avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.20",
            "verseOrgIds": [
              "ISA.59.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 59:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze aravuga ati “Iri ni ryo sezerano nsezerana na bo. Umwuka wanjye ukuriho n'amagambo yanjye nshyize mu kanwa kawe, ntibizatandukana n'akanwa kawe n'akanwa k'urubyaro rwawe, kandi n'ak'ubuvivi bwawe, uhereye ubu ukageza iteka ryose.” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.21",
            "verseOrgIds": [
              "ISA.59.21"
            ]
          }
        }
      ]
    }
