                }
              ]
            }
          ]
        },
        {
          "text": " Mu mwaka wa gatatu Yehoyakimu umwami w'Abayuda ari ku ngoma, Nebukadinezari umwami w'i Babuloni yateye i Yerusalemu arahagota. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
