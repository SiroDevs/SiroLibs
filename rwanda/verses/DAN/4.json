          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami atararangiza ayo magambo haza ijwi rivuye mu ijuru riti “Yewe Mwami Nebukadinezari, ni wowe ubwirwa. Ubwami bwawe ubukuwemo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "bazakwirukana bagukure mu bantu, ubane n'inyamaswa zo mu ishyamba kugeza aho uzamenyera ko Isumbabyose ari yo itegeka ubwami bw'abantu, kandi ko ibwimikamo uwo ishaka.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
