        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uwo mwanya iryo jambo risohora kuri Nebukadinezari yirukanwa mu bantu, akajya arisha nk'inka, umubiri we utondwaho n'ikime kiva mu ijuru kugeza aho umusatsi we wabereye urushoke nk'amoya y'ikizu, inzara ze zihinduka nk'iz'ibisiga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
