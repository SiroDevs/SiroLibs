          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize amezi cumi n'abiri, umwami yari i Babuloni arambagira mu rugo ibwami, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "aravuga ati “Ngiyi Babuloni hakomeye niyubakiye ngo habe umurwa wanjye nturaho, mpubakishije imbaraga z'amaboko yanjye ngo haheshe ubwami bwanjye icyubahiro.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
