          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daniyeli abona ubwiza bw'Imana, ararabirana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa gatatu wo ku ngoma ya Kūro umwami w'i Buperesi, Daniyeli wahimbwe Beluteshazari hariho icyo yeretswe kandi cyari icy'ukuri, ari cyo ntambara zikomeye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "ntambara zikomeye:",
              "type": "text"
            },
            {
              "text": "cyangwa, byago by'ibihe birebire.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amenya icyo ari cyo, ibyo yeretswe biramusobanukira.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.1",
            "verseOrgIds": [
              "DAN.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri iyo minsi, jyewe Daniyeli namaze ibyumweru bitatu ndira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.2",
            "verseOrgIds": [
              "DAN.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta mutsima naryaga nubwo ari mwiza, nta nyama cyangwa vino, nta cyo nasamiraga kandi sinihezuraga kugeza aho ibyo byumweru uko ari bitatu byose bishiriye.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.3",
            "verseOrgIds": [
              "DAN.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.3",
            "verseOrgIds": [
              "DAN.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ku munsi wa makumyabiri n'ine w'ukwezi kwa mbere, nari ku nkombe y'uruzi runini rwitwa Hidekelu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.4",
            "verseOrgIds": [
              "DAN.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.13+REV.1.14+REV.1.15"
              },
              "items": [
                {
                  "text": "Ibyah 1.13-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.2.18"
              },
              "items": [
                {
                  "text": "2.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.12"
              },
              "items": [
                {
                  "text": "19.12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko ntereye amaso mbona umugabo wambaye umwenda w'igitare, yari akenyeje izahabu nziza yacukuwe Ufazi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.5",
            "verseOrgIds": [
              "DAN.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umubiri we wasaga na yasipi, mu maso he hasaga n'umurabyo, amaso ye yasaga n'amatabaza yaka umuriro, amaboko ye n'ibirenge bye byasaga n'imiringa isenwe, kandi ijwi ry'amagambo ye ryari rimeze nk'iry'abantu benshi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.6",
            "verseOrgIds": [
              "DAN.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jye Daniyeli gusa wabonye ibyo neretswe ibyo, ariko abantu twari kumwe ntibarakabibona, ahubwo bahinze umushyitsi cyane barahunga, barihisha. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.7",
            "verseOrgIds": [
              "DAN.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nsigara aho jyenyine mbona ibyo byerekanywe bikomeye, sinasigarana intege kuko ubwiza bwanjye bwampindukiyemo ububore ndatentebuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.8",
            "verseOrgIds": [
              "DAN.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko numvaga ijwi ry'amagambo ye, nkiryumva ngwa nubamye ndarabirana nk'usinziriye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.9",
            "verseOrgIds": [
              "DAN.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko haza ukuboko kunkoraho, kurambyutsa kumpfukamisha amavi n'ibiganza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.10",
            "verseOrgIds": [
              "DAN.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.10",
            "verseOrgIds": [
              "DAN.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambwira ati “Yewe Daniyeli mugabo ukundwa cyane, umva amagambo ngiye kukubwira, haguruka weme kuko uyu munsi ngutumweho.” Amaze kumbwira iryo jambo ndahaguruka, mpagarara ntengurwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.11",
            "verseOrgIds": [
              "DAN.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aherako arambwira ati “Witinya Daniyeli, kuko uhereye ku munsi watangiriyeho gushishikarira gusobanukirwa no kwicisha bugufi imbere y'Imana yawe, amagambo yawe yarumviswe kandi ni yo anzanye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.12",
            "verseOrgIds": [
              "DAN.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.7"
              },
              "items": [
                {
                  "text": "Ibyah 12.7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Ariko umutware w'ibwami bw'u Buperesi amara iminsi makumyabiri n'umwe ambuza. Nyuma Mikayeli, umwe wo mu batware bakomeye aza kuntabara, ntinda mu bami b'u Buperesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.13",
            "verseOrgIds": [
              "DAN.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none nzanywe no kugusobanurira ibizaba ku bantu bawe mu minsi y'imperuka, kuko ibyo weretswe ari iby'igihe gishyize kera.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.14",
            "verseOrgIds": [
              "DAN.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.14",
            "verseOrgIds": [
              "DAN.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kumbwira ayo magambo, ncurika umutwe ndumirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.15",
            "verseOrgIds": [
              "DAN.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze haza uwasaga n'umwana w'umuntu akora ku munwa wanjye, mperako mbumbura akanwa kanjye ndavuga, mbwira uwari umpagaze imbere nti “Databuja, ibyo neretswe ko byatumye imibabaro yanjye ingarukamo nkabura intege, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.16",
            "verseOrgIds": [
              "DAN.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbese nkanjye umugaragu wawe nabasha nte kuvugana na databuja, ko nta ntege ngifite kandi ntagihumeka neza?”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.17",
            "verseOrgIds": [
              "DAN.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwasaga n'umuntu arongera ankoraho, arankomeza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.18",
            "verseOrgIds": [
              "DAN.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambwira ati “Yewe mugabo ukundwa cyane, witinya, amahoro abe muri wowe. Komera, koko komera.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.19",
            "verseOrgIds": [
              "DAN.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukivugana mperako ndakomezwa ndavuga nti “Databuja vuga, kuko unkomeje.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.19",
            "verseOrgIds": [
              "DAN.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.19",
            "verseOrgIds": [
              "DAN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambaza ati “Uzi ikinzanye aho uri? Dore ubu ngiye gusubirayo kurwana n'umutware w'u Buperesi, nimara kugenda umwami w'u Bugiriki araherako aze. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.10.20",
            "verseOrgIds": [
              "DAN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.7"
              },
