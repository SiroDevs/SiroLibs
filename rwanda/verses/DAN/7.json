              "DAN.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ayo magambo agarukiye aha. Ariko jyewe ubwanjye Daniyeli, ibyo natekereje bimpagarika umutima cyane, bituma mu maso hanjye hahinduka ukundi, ariko mbika iryo jambo mu mutima wanjye.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.28",
            "verseOrgIds": [
              "DAN.7.28"
            ]
          }
        }
