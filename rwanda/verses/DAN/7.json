            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.14"
              },
              "items": [
                {
                  "text": "14.14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " “Hanyuma nkitegereza ibyo neretswe nijoro, mbona haje usa n'umwana w'umuntu aziye mu bicu byo mu ijuru, aza umujyo umwe asanga wa Mukuru nyir'ibihe byose, bamumugeza imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.13",
            "verseOrgIds": [
              "DAN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.15"
              },
              "items": [
                {
                  "text": "Ibyah 11.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Nuko ahabwa ubutware n'icyubahiro n'ubwami, kugira ngo abantu b'amoko yose y'indimi zitari zimwe bajye bamukorera. Ubutware bwe ni ubutware bw'iteka ryose butazashira, kandi ubwami bwe ni ubwami butazakurwaho.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.14",
            "verseOrgIds": [
              "DAN.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Gusobanura inzozi za Daniyeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
