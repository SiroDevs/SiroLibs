              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.18",
            "verseOrgIds": [
              "DAN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mperako nifuza kumenya amashirakinyoma y'iby'inyamaswa ya kane itasaga n'izindi zose, yari iteye ubwoba cyane bitavugwa, ifite imikaka y'ibyuma n'inzara z'imiringa ari yo yaconshomeraga ibintu ikabimenagura, ibisigaye ikabisiribangisha amajanja yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.19",
            "verseOrgIds": [
              "DAN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nifuza kumenya iby'amahembe cumi yari ku mutwe wayo, n'iby'irindi hembe ryameze atatu asanzwe akarandurwa imbere yaryo, ari ryo rya hembe ryari rifite amaso n'akanwa kavuga ibikomeye, ryarushaga ayandi gukomera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.7.20",
            "verseOrgIds": [
              "DAN.7.20"
            ]
          }
        }
      ]
    },
    {
