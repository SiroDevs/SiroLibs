    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "COL 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndashaka ko mumenya uburyo mbarwanira intambara, mwebwe n'ab'i Lawodikiya ndetse n'abatarambona ku mubiri bose ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.1",
            "verseOrgIds": [
              "COL.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo imitima yabo ihumurizwe, ubwo bafatanirije hamwe mu rukundo ngo bahabwe ubutunzi bwose bwo kumenya neza mu mitima yabo, bamenye ubwiru bw'Imana ari bwo Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.2",
            "verseOrgIds": [
              "COL.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we ni mo ubutunzi bwose bw'ubwenge no kumenya bwahishwe.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imbuzi ku byerekeye inyigisho z'ibinyoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.3",
            "verseOrgIds": [
              "COL.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mvugiye ibyo kugira ngo hatagira ubashukisha amagambo yoshya, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.4",
            "verseOrgIds": [
              "COL.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nubwo ntari kumwe namwe ku mubiri ndi kumwe namwe mu mutima, nishima kandi mbona gahunda yanyu nziza n'uburyo mushikamye mu byo kwizera Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.5",
            "verseOrgIds": [
              "COL.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nk'uko mwakiriye Kristo Yesu Umwami wacu abe ari ko mugendera muri we, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.6",
            "verseOrgIds": [
              "COL.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mushōreye imizi muri we kandi mwubatswe muri we, mukomejwe no kwizera nk'uko mwigishijwe, mufite ishimwe ryinshi risesekaye.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.7",
            "verseOrgIds": [
              "COL.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwirinde, hatagira umuntu ubanyagisha ubwenge bw'abantu n'ibihendo by'ubusa bikurikiza imihango y'abantu, iyo bahawe na ba sekuruza ho akarande, kandi bigakurikiza imigenzereze ya mbere y'iby'isi bidakurikiza Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.8",
            "verseOrgIds": [
              "COL.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "COL 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyamara muri we ni ho hari kūzura k'Ubumana kose mu buryo bw'umubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.9",
            "verseOrgIds": [
              "COL.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mwuzuriye muri we, ari we Mutwe w'ubutware bwose n'ubushobozi bwose.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "COL 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.10",
            "verseOrgIds": [
              "COL.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "COL 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we ni na mo mwakebewe gukebwa kutari ukw'intoki, ahubwo ni ugukebwa kuva kuri Kristo, ari ko kwiyambura umubiri w'ibyaha bya kamere. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.11",
            "verseOrgIds": [
              "COL.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "COL 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.4"
              },
              "items": [
                {
                  "text": "Rom 6.4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kuko mwahambanywe na we mu mubatizo kandi ni mo mwazuranywe na we, ku bwo kwizera imbaraga z'Imana yamuzuye mu bapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.12",
            "verseOrgIds": [
              "COL.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "COL 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.1+EPH.2.2+EPH.2.3+EPH.2.4+EPH.2.5"
              },
              "items": [
                {
                  "text": "Ef 2.1-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " Kandi ubwo mwari mupfuye muzize ibicumuro byanyu no kudakebwa kw'imibiri yanyu, yabahinduranye bazima na we imaze kutubabarira ibicumuro byacu byose, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.13",
            "verseOrgIds": [
              "COL.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "COL 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.15"
              },
              "items": [
                {
                  "text": "Ef 2.15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " igahanagura urwandiko rw'imihango rwaturegaga, ikarudukuzaho kurubamba ku musaraba. ",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.14",
            "verseOrgIds": [
              "COL.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "COL 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi imaze kunyaga abatware n'abafite ubushobozi, ibahemura ku mugaragaro, ibīvuga hejuru ku bw'umusaraba.",
          "type": "text",
          "attrs": {
            "verseId": "COL.2.15",
            "verseOrgIds": [
              "COL.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
