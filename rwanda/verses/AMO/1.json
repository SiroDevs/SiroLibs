        },
        {
          "text": " Aravuga ati “Uwiteka azivuga ari i Siyoni, arangurure ijwi rye ari i Yerusalemu, kandi ibyanya by'abashumba bizasigara biganya, n'impinga z'i Karumeli zizuma.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
