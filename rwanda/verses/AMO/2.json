              "AMO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwiteka aravuga ati “Ibicumuro bitatu bya Isirayeli, ndetse bine, bizantera kutabakuraho igihano kuko baguze umukiranutsi ifeza, n'umutindi bakamugura inkweto. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bifuza kureba abakene birenza umukungugu ku mutwe, bakagoreka n'inzira y'umugwaneza. Umwana na se baryamana n'umukobwa umwe, bakagayisha izina ryanjye ryera. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biryamira iruhande rw'igicaniro cyose ku myambaro bendeye ubugwate, kandi banywera mu nzu y'Imana yabo vino y'abaciwe ibyiru.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
