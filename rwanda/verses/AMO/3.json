          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.23.15"
              },
              "items": [
                {
                  "text": "2 Abami 23.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Kuko umunsi nzahanira Isirayeli ibicumuro bye, nzahana n'ibicaniro by'i Beteli, kandi amahembe y'igicaniro azacibwa agwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
            "verseOrgIds": [
              "AMO.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyumba y'itumba nzayisenya hamwe n'inyumba y'impeshyi, kandi amanyumba arimbishijwe amahembe y'inzovu azasenywa, n'amazu akomeye azatsembwaho.” Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.15",
            "verseOrgIds": [
              "AMO.3.15"
            ]
          }
        }
      ]
    }
