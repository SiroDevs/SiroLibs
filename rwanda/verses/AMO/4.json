              "items": [
                {
                  "text": "Itang 19.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": " “Nubitse imidugudu yanyu nk'uko Imana yubitse i Sodomu n'i Gomora, muba nk'umushimu ukuwe mu muriro, ariko ntibyatuma mungarukira. Ni ko Uwiteka avuga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        }
