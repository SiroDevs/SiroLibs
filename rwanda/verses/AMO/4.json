          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni cyo gituma nzakugenzereza ntyo, Isirayeli we. Ubwo nzakugenzereza ntyo, itegure gusanganira Imana yawe, Isirayeli we. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dore iyabumbye imisozi ikarema n'umuyaga, ikagaragariza umuntu ibyo yibwira, igahindura umuseke kuba umwijima kandi igatambagira aharengeye ho mu isi, Uwiteka Imana Nyiringabo, ni ryo zina ryayo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.13",
            "verseOrgIds": [
              "AMO.4.13"
            ]
          }
        }
      ]
