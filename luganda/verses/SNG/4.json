  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "SNG 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "sp"
      },
      "items": [
        {
          "text": "Owoomukwano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "SNG 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'olabika bulungi, gwe njagala, laba ondabikidde bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Amaaso go mayiba mu lugoye mw'ogabisse.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "Enviiri zo ziri ng'eggana ly'embuzi",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:1"
      },
      "items": [
        {
          "text": "eziserengeta okuva ku lusozi Gireyaadi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.1",
            "verseOrgIds": [
              "SNG.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "SNG 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amannyo go gali ng'ekisibo ky'endiga nga kye zijje zisalibweko ebyoya,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "nga ziva okunaazibwa.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "Buli emu nnongo eri n'ennongo ginnaayo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:2"
      },
      "items": [
        {
          "text": "so tewali eri yokka.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.2",
            "verseOrgIds": [
              "SNG.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "SNG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emimwa gyo giri ng'ewuzi ey'olugoye olutwakaavu;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "n'akamwa ko kandabikira bulungi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "Amatama go mu lugoye lw'ogabisseeko",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:3"
      },
      "items": [
        {
          "text": "gali ng'ekitundu ky'ekkomamawanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.3",
            "verseOrgIds": [
              "SNG.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "SNG 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensingo yo eri ng'omulongooti gwa Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "ogwatereezebwa obulungi;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "ne ku gwo nga kuliko engabo lukumi,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:4"
      },
      "items": [
        {
          "text": "zonna nga ngabo z'abasajja abalwanyi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.4",
            "verseOrgIds": [
              "SNG.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "SNG 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amabeere go gombi gali ng'abaana b'empeewo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "ab'empeewo, nga balongo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:5"
      },
      "items": [
        {
          "text": "abaliira mu malanga.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.5",
            "verseOrgIds": [
              "SNG.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "SNG 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okutuusa obudde nga bukedde,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "n'ebisiikirize nga biweddewo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "ndigenda ku lusozi olunene olwa mooli",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:6"
      },
      "items": [
        {
          "text": "ne ku kasozi ak'omugavu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.6",
            "verseOrgIds": [
              "SNG.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "SNG 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'olabika bulungi wenna, omwagalwa wange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:7"
      },
      "items": [
        {
          "text": "toliiko bbala na limu.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.7",
            "verseOrgIds": [
              "SNG.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "SNG 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jjangu tuve mu Lebanooni, omugole wange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "jjangu tuve mu Lebanooni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "Lengera okuva ku ntikko ya Amana,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "n'okuva ku ntikko ya Seniri ne ku ntikko ya Kerumooni,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "n'okuva mu mpuku ey'empologoma,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:8"
      },
      "items": [
        {
          "text": "ne ku nsozi ez'engo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.8",
            "verseOrgIds": [
              "SNG.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "SNG 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osenzesenze omutima gwange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "mwannyinaze, omugole wange;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "otutte omutima gwange, ne munye y'eriiso lyo gy'onkubye,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:9"
      },
      "items": [
        {
          "text": "n'omukuufu ogumu ogw'omu bulago bwo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.9",
            "verseOrgIds": [
              "SNG.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "SNG 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'okwagala kwo kulungi mwannyinaze, omugole wange,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "okwagala kwo nga kusinga nnyo envinnyo,",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:10"
      },
      "items": [
        {
          "text": "n'akawoowo ak'amafuta go kasinga eby'akawoowo eby'engeri zonna obulungi.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.10",
            "verseOrgIds": [
              "SNG.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "SNG 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emimwa gyo gitonnya obuwoomi ng'ebisenge eby'omubisi gw'enjuki, omugole wange;",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "amata n'omubisi gw'enjuki biri wansi w'olulimi lwo.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "SNG 4:11"
      },
      "items": [
        {
          "text": "Akaloosa ak'ebyambalo byo kali ng'akawoowo ak'e Lebanooni.",
          "type": "text",
          "attrs": {
            "verseId": "SNG.4.11",
            "verseOrgIds": [
              "SNG.4.11"
            ]
          }
        }
      ]
    },
