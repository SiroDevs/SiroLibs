{
  "id": "JHN.7",
  "number": "7",
  "bookId": "JHN",
  "reference": "Yokaana 7",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 53,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "JHN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ne Baganda be",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lw'ebyo, Yesu n'alaga e Ggaliraaya, kubanga teyayagala kubeera mu Buyudaaya, kubanga Abayudaaya baali bamunoonya okumutta.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.1",
            "verseOrgIds": [
              "JHN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye embaga y'Abayudaaya eyitibwa ey'Ensiisira yali eneetera okutuuka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.2",
            "verseOrgIds": [
              "JHN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda ba Yesu ne bamugamba nti, \"Vva wano, olage mu Buyudaaya, abayigirizwa bo balabe ebyamagero by'okola.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.3",
            "verseOrgIds": [
              "JHN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosobola kwatiikirira nga weekwese. Kale obanga, okola ebintu ebyo, weerage eri ensi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.4",
            "verseOrgIds": [
              "JHN.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda be nabo tebaamukkiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.5",
            "verseOrgIds": [
              "JHN.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'abaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ekiseera kyange eky'okugenda tekinnatuuka. Naye mmwe muyinza okugenda mu kiseera kyonna we mwagalira.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.6",
                "verseOrgIds": [
                  "JHN.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe ensi teyinza kubakyawa, naye Nze enkyawa kubanga ngitegeeza ebikolwa byayo ebibi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.7",
                "verseOrgIds": [
                  "JHN.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.7",
            "verseOrgIds": [
              "JHN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe mwambuke ku mbaga. Nze sijja kwambuka ku mbaga eno, kubanga ekiseera kyange tekinnatuuka.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.8",
                "verseOrgIds": [
                  "JHN.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.8",
            "verseOrgIds": [
              "JHN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe yamala okubagamba ebyo n'asigala mu Ggaliraaya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ku Mbaga ey'Ensiisira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baganda be bwe bamala okwambuka ku mbaga naye n'ayambuka, mu kyama so si mu lwatu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayudaaya ne bamunoonya ku mbaga nga beebuuza nti, \"Omusajja oli, ali ludda wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne wabaawo oluvuuvuumo lungi mu bantu. Abamu ne bagamba nti, \"Mulungi.\" Naye abalala nga bagamba nti, \"Nedda, alimba abantu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka olw'okutya Abayudaaya, tewaaliwo amwogerako mu lwatu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Ayigiriza ku Mbaga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu makkati g'embaga Yesu n'ayambuka mu Yeekaalu n'ayigiriza.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze b'Abayudaaya ne beewuunya nga bagamba nti, \"Omuntu ono ayinza atya okumanya okusoma so nga tasomangako?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu kwe kubaddamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nze sibayigiriza byange ku bwange, wabula eby'oyo eyantuma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.16",
                "verseOrgIds": [
                  "JHN.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.16",
            "verseOrgIds": [
              "JHN.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli ayagala okukola Katonda by'ayagala, ategeera obanga bye njigiriza byange ku bwange oba bya Katonda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.17",
                "verseOrgIds": [
                  "JHN.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.17",
            "verseOrgIds": [
              "JHN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ayogera ku bubwe anoonya kitiibwa kye, naye oyo anoonya ekitiibwa ky'oyo eyantuma wa mazima so n'obutali butuukirivu tebuba mu ye. Musa teyabawa amateeka?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.18",
                "verseOrgIds": [
                  "JHN.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.18",
            "verseOrgIds": [
              "JHN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ku mmwe tekuliiko n'omu akwata mateeka. Kale lwaki musala amagezi okunzita?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.19",
                "verseOrgIds": [
                  "JHN.7.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekibiina ky'abantu ne baddamu nti, \"Oliko dayimooni! Ani asala amagezi okukutta?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.20",
            "verseOrgIds": [
              "JHN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu n'addamu nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nakola ekikolwa kimu ku Ssabbiiti buli muntu ne yeewuunya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.21",
                "verseOrgIds": [
                  "JHN.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.21",
            "verseOrgIds": [
              "JHN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Musa kyeyava abalagira okukomolebwa, okukomolebwa tekwatandikira ku Musa wabula kwatandikira ku bajjajjammwe; ne ku Ssabbiiti mukomola omuntu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.22",
                "verseOrgIds": [
                  "JHN.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.22",
            "verseOrgIds": [
              "JHN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Obanga mukomola ku Ssabbiiti etteeka lya Musa lireme okumenyebwa, kale lwaki Nze munsunguwalira olw'okuwonya omuntu ku Ssabbiiti, n'aba mulamu ddala?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.23",
                "verseOrgIds": [
                  "JHN.7.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.23",
            "verseOrgIds": [
              "JHN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Temusalanga musango okusinziira ku ndabika, naye musalenga omusango ogw'ensonga.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.24",
                "verseOrgIds": [
                  "JHN.7.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ye Kristo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abantu abamu ab'omu Yerusaalemi ne beebuuzaganya nga bagamba nti, \"Ono si ye muntu gwe banoonya okutta?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.25",
            "verseOrgIds": [
              "JHN.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale wuuno ayigiriza lwatu, ate tebaliiko kye bamugambako. Osanga abakulembeze bategedde nti omuntu ono ye Kristo!",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.26",
            "verseOrgIds": [
              "JHN.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tumanyi omuntu ono gy'ava; so nga Kristo bw'alijja tewaliba n'omu amanya gy'ava.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.27",
            "verseOrgIds": [
              "JHN.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu bwe yali ng'akyayigiriza mu Yeekaalu n'akangula ku ddoboozi n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ddala mummanyi ne gye nva mumanyiiyo. Sajja ku bwange wabula ekituufu nti oyo eyantuma gwe mutamanyi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.28",
                "verseOrgIds": [
                  "JHN.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.28",
            "verseOrgIds": [
              "JHN.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nze mmumanyi, kubanga nava gy'ali, era ye yantuma.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.29",
                "verseOrgIds": [
                  "JHN.7.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne basala amagezi okumukwata, kyokka tewaali amukwatako, kubanga ekiseera kye kyali tekinnaba kutuuka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.30",
            "verseOrgIds": [
              "JHN.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bangi mu bibiina by'abantu ne bamukkiriza, ne bagamba nti, \"Kale Kristo bw'alijja, alikola eby'amagero ebisinga eby'ono byakoze?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.31",
            "verseOrgIds": [
              "JHN.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abafalisaayo ne bawulira abantu nga boogera ku Yesu mu bwama. Awo bakabona abakulu n'Abafalisaayo ne batuma abaweereza baabwe okumukwata.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nzija kumala nammwe ebbanga ttono, ndyoke nzireyo eri oyo eyantuma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.33",
                "verseOrgIds": [
                  "JHN.7.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.33",
            "verseOrgIds": [
              "JHN.7.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulinnoonya, naye temugenda kundaba, nga gye ndi, mmwe temuyinza kutuukayo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.34",
                "verseOrgIds": [
                  "JHN.7.34"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Abayudaaya ne beebuuzaganya nti, \"Omuntu ono alaga wa gye tutalimulabira? Ayagala kugenda eri abo abaasaasaanira mu Buyonaani, ayigirize Abayonaani?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.35",
            "verseOrgIds": [
              "JHN.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ategeeza ki bw'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Mulinnoonya, naye temulindaba?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.36",
                "verseOrgIds": [
                  "JHN.7.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Era nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.36",
            "verseOrgIds": [
              "JHN.7.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "'Gye ndaga temuyinza kutuukayo?' \"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.36",
                "verseOrgIds": [
                  "JHN.7.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ensulo z'Amazzi amalamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ku lunaku olw'embaga olusembayo, olusingira ddala obukulu, Yesu n'ayimirira n'ayogera n'eddoboozi ery'omwanguka n'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli alina ennyonta, ajje gye ndi anywe!",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.37",
                "verseOrgIds": [
                  "JHN.7.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.37",
            "verseOrgIds": [
              "JHN.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ng'Ekyawandiikibwa bwe kigamba nti buli akkiriza Nze emigga egy'amazzi amalamu girikulukuta nga gifuluma mu mutima gwe!\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.7.38",
                "verseOrgIds": [
                  "JHN.7.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.38",
            "verseOrgIds": [
              "JHN.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yali ayogera ku Mwoyo Mutukuvu, abamukkiriza gwe baali bagenda okufuna, kubanga Mwoyo oyo yali tannagabibwa, kubanga Yesu yali tannaba kugulumizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.39",
            "verseOrgIds": [
              "JHN.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abamu mu kibiina bwe baawulira ng'ayogera bw'atyo, ne bagamba nti, \"Ddala omuntu ono ye Nnabbi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.40",
            "verseOrgIds": [
              "JHN.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalala ne bagamba nti, \"Omuntu ono ye Kristo.\" Naye abalala ne bagamba nti, \"Nedda, Kristo tayinza kuba ng'ava mu Ggaliraaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.41",
            "verseOrgIds": [
              "JHN.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Ekyawandiikibwa kigamba nti: Kristo wa kuva mu zzadde lya Dawudi, era nga wa kuzaalibwa mu Besirekemu, ekibuga kya Dawudi mwe yali.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.42",
            "verseOrgIds": [
              "JHN.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ekibiina ne kyesalamu olwa Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.43",
            "verseOrgIds": [
              "JHN.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamu ne baagala okumukwata, kyokka ne wabulawo amukwatako.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.44",
            "verseOrgIds": [
              "JHN.7.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obutakkiriza bw'Abakulembeze b'Abayudaaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo abaweereza b'abakabona abakulu n'Abafalisaayo ne baddayo eri bakabona abakulu n'Abafalisaayo. Abakulembeze Ne bababuuza nti, \"Lwaki temumuleese?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.45",
            "verseOrgIds": [
              "JHN.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaweereza ne baddamu nti, \"Ebigambo by'ayogera bya kitalo, tetubiwulirangako.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.46",
            "verseOrgIds": [
              "JHN.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafalisaayo ne babagamba nti, \"Era nammwe abakyamizza?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.47",
            "verseOrgIds": [
              "JHN.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo n'omu ku bakulembeze wadde ku Bafalisaayo eyali akkiririzza mu muntu oyo?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.48",
            "verseOrgIds": [
              "JHN.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ekibiina ky'abantu bano abatamanyi mateeka, bakolimiddwa!\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.49",
            "verseOrgIds": [
              "JHN.7.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Nikodemo, omu ku bo eddako eyagenda eri Yesu, n'abuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.50",
            "verseOrgIds": [
              "JHN.7.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 7:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Amateeka gaffe gakkiriza okusalira omuntu omusango nga tannaba kuwozesebwa okutegeera ky'akoze?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.51",
            "verseOrgIds": [
              "JHN.7.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 7:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bamuddamu nti, \"Naawe wava Ggaliraaya? Nnoonyereza, ojja kulaba nti e Ggaliraaya teva nnabbi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.52",
            "verseOrgIds": [
              "JHN.7.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 7:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Awo ne baabuka, buli omu n'addayo eka.",
              "type": "text",
