            "number": "3",
            "style": "v",
            "sid": "PSA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka tukutule enjegere zaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "era tweyambulemu ekikoligo kyabwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Katonda oyo atuula mu ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "abasekerera busekerezi, n'enkwe zaabwe ezitaliimu zimusesa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
