          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.2.11",
                "verseOrgIds": [
                  "PSA.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nga mumutya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
