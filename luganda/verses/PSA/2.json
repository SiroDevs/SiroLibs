            "number": "5",
            "style": "v",
            "sid": "PSA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'alyoka abanenya ng'ajjudde obusungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:5"
      },
      "items": [
        {
          "text": "n'abatiisa nnyo ng'aswakidde.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abagamba nti, \"Ddala ddala nateekawo kabaka owange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
