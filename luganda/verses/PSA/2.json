      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:6"
      },
      "items": [
        {
          "text": "ku lusozi lwange Sayuuni olutukuvu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
