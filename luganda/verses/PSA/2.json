          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki amawanga geegugunga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "n'abantu ne bateganira obwereere okusala enkwe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
