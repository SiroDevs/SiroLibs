      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:3"
      },
      "items": [
        {
          "text": "ne gwokya abalabe be ku njuyi zonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
