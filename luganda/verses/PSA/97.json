      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:8"
      },
      "items": [
        {
          "text": "kubanga ogoberera eby'ensonga, Ayi Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.8",
            "verseOrgIds": [
              "PSA.97.8"
