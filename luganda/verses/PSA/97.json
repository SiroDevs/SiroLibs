      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 97:4"
      },
      "items": [
        {
          "text": "ensi n'ekulaba n'ekankana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.4",
            "verseOrgIds": [
              "PSA.97.4"
            ]
          }
        }
