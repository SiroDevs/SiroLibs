          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuliro gumukulembera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.3",
            "verseOrgIds": [
              "PSA.97.3"
            ]
          }
        }
      ]
    },
