          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebire n'ekizikiza bimwetooloola;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.97.2",
            "verseOrgIds": [
              "PSA.97.2"
            ]
          }
        }
      ]
    },
    {
