                "verseId": "PSA.25.2",
                "verseOrgIds": [
                  "PSA.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", tondeka kuswala mu maaso g'abalabe bange. Tobaganya kumpangula.",
