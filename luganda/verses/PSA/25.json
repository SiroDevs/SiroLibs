              "type": "text",
              "attrs": {
                "verseId": "PSA.25.4",
                "verseOrgIds": [
                  "PSA.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.4",
            "verseOrgIds": [
              "PSA.25.4"
            ]
          }
        }
      ]
    },
