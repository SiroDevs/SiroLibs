      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:12"
      },
      "items": [
        {
          "text": "Oyo gw'anaayigirizanga okukwata ekkubo lye yamulondera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
