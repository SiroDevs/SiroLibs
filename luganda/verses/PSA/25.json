          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jjukira, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.6",
                "verseOrgIds": [
                  "PSA.25.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", okusaasira kwo okunene, n'okwagala kwo okungi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
        }
