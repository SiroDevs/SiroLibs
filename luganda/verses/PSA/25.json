      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "kubanga ggwe Katonda, ow'obulokozi bwange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "era essuubi lyange liri mu ggwe olunaku lwonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
