      "attrs": {
        "style": "q2",
        "vid": "PSA 25:11"
      },
      "items": [
        {
          "text": "onsonyiwe ebibi byange, kubanga bingi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.11",
            "verseOrgIds": [
              "PSA.25.11"
            ]
          }
        }
      ]
    },
