    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:6"
      },
      "items": [
        {
          "text": "kubanga byava dda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.6",
            "verseOrgIds": [
              "PSA.25.6"
            ]
          }
