          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu wa ngeri ki atya Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.12",
            "verseOrgIds": [
              "PSA.25.12"
            ]
          }
        }
      ]
    },
