      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "ng'okwagala kwo gye ndi bwe kuli, kubanga oli mulungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
