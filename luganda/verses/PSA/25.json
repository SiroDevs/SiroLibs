      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "Onzijukire, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
