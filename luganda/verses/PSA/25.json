          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obulamu bwe bunajjuzibwanga emikisa gya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.13",
            "verseOrgIds": [
              "PSA.25.13"
            ]
          }
        }
      ]
    },
