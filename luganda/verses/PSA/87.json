      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 87:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.2",
                "verseOrgIds": [
                  "PSA.87.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ayagala emiryango gya Sayuuni",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:2"
      },
      "items": [
        {
          "text": "okusinga ennyumba zonna eza Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 87:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu eby'ekitiibwa bikwogerwako,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "ggwe ekibuga kya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 87:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mu mawanga ge mmanyi mwe muli Lakabu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "ne Babulooni;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "era ndyogera ku Bufirisuuti, ne ku Ttuulo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "ne ku Esiyopya nti, 'Ono yazaalirwa mu Sayuuni.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 87:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe baliba boogera ku Sayuuni baligamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "\"Ono n'oli baazaalirwa omwo,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "n'oyo Ali Waggulu Ennyo alikinyweza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 87:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.6",
                "verseOrgIds": [
                  "PSA.87.6"
                ]
              }
            }
          ]
        },
        {
          "text": "aliwandiika mu kitabo bw'ati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "omuli amannya g'abantu nti, \"Ono yazaalibwa omwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 87:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banaakubanga ebivuga nga bwe bayimba nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:7"
      },
      "items": [
        {
          "text": "\"Ensulo zange zonna ziri mu ggwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    }
