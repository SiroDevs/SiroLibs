    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Zabbuli ya Sulemaani.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 72:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, kabaka omuwe okuba omwenkanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:1"
      },
      "items": [
        {
          "text": "ne mutabani we omuwe obutuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.1",
            "verseOrgIds": [
              "PSA.72.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 72:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "alyoke alamulenga abantu bo mu butuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:2"
      },
      "items": [
        {
          "text": "n'abaavu abalamulenga mu mazima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.2",
            "verseOrgIds": [
              "PSA.72.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 72:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensozi zireeterenga abantu bo okukulaakulana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:3"
      },
      "items": [
        {
          "text": "n'obusozi bubaleetere obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.3",
            "verseOrgIds": [
              "PSA.72.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 72:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaalwaniriranga abaavu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "n'atereeza abaana b'abo abeetaaga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:4"
      },
      "items": [
        {
          "text": "n'omujoozi n'amusaanyaawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.4",
            "verseOrgIds": [
              "PSA.72.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 72:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakutyenga ng'enjuba n'omwezi gye bikoma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:5"
      },
      "items": [
        {
          "text": "okwaka mu mirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.5",
            "verseOrgIds": [
              "PSA.72.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 72:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeere ng'enkuba bw'etonnya ku muddo ogusaliddwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:6"
      },
      "items": [
        {
          "text": "afaanane ng'oluwandaggirize olufukirira ensi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.6",
            "verseOrgIds": [
              "PSA.72.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 72:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutuukirivu bweyongere nnyo mu mulembe gwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:7"
      },
      "items": [
        {
          "text": "n'okufuga kwe kujjule emirembe okutuusa omwezi lwe gulikoma okwaka!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.7",
            "verseOrgIds": [
              "PSA.72.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 72:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afugenga okuva ku nnyanja okutuuka ku nnyanja,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:8"
      },
      "items": [
        {
          "text": "n'okuva ku mugga Fulaati",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        },
        {
          "text": "okutuuka ku nkomerero z'ensi!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.8",
            "verseOrgIds": [
              "PSA.72.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 72:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebika eby'omu malungu bimugonderenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:9"
      },
      "items": [
        {
          "text": "n'abalabe be bamujeemulukukire beekulukuunye ne mu nfuufu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.9",
            "verseOrgIds": [
              "PSA.72.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 72:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabaka b'e Talusiisi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        },
        {
          "text": "n'ab'oku bizinga eby'ewala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "bamuwenga omusolo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "bakabaka b'e Syeba n'ab'e Seeba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:10"
      },
      "items": [
        {
          "text": "bamutonerenga ebirabo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.10",
            "verseOrgIds": [
              "PSA.72.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 72:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabaka bonna banaavuunamanga mu maaso ge;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:11"
      },
      "items": [
        {
          "text": "amawanga gonna ganaamuweerezanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.11",
            "verseOrgIds": [
              "PSA.72.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 72:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga anaawonyanga eyeetaaga bw'anaamukoowoolanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:12"
      },
      "items": [
        {
          "text": "n'omwavu ne kateeyamba ataliiko mwasirizi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.12",
            "verseOrgIds": [
              "PSA.72.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 72:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaasaasiranga omunafu n'omwavu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:13"
      },
      "items": [
        {
          "text": "n'awonya obulamu bwa kateeyamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.13",
            "verseOrgIds": [
              "PSA.72.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 72:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaabanunulanga mu mikono gy'omujoozi n'abawonya obukambwe bwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:14"
      },
      "items": [
        {
          "text": "kubanga obulamu bwabwe bwa muwendo mungi gy'ali.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.14",
            "verseOrgIds": [
              "PSA.72.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 72:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awangaale!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "Aleeterwe zaabu okuva e Syeba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "Abantu bamwegayiririrenga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 72:15"
      },
      "items": [
        {
          "text": "era bamusabirenga emikisa buli lunaku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.72.15",
            "verseOrgIds": [
              "PSA.72.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 72:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eŋŋaano ebale nnyingi nnyo mu nsi,",
