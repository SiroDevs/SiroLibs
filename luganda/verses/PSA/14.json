          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bonna bakyamye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
