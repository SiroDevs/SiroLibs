      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:3"
      },
      "items": [
        {
          "text": "boonoonese;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.3",
            "verseOrgIds": [
              "PSA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:3"
      },
      "items": [
