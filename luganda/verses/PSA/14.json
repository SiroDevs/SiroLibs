          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.14.4",
                "verseOrgIds": [
                  "PSA.14.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.4",
            "verseOrgIds": [
              "PSA.14.4"
            ]
          }
        }
      ]
    },
    {
