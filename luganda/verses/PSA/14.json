    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Zabbuli ya Dawudi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusirusiru ayogera mu mutima gwe nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "\"Tewali Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "Aboogera bwe batyo boonoonefu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:1"
      },
      "items": [
        {
          "text": "bakola ebitasaana tekuli n'omu ku bo akola kirungi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.1",
            "verseOrgIds": [
              "PSA.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
