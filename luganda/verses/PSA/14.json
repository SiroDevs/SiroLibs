                "verseId": "PSA.14.2",
                "verseOrgIds": [
                  "PSA.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "atunuulira abantu bonna mu nsi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "ng'asinziira mu ggulu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "okulaba obanga mulimu mu bo ategeera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:2"
      },
      "items": [
        {
          "text": "era abanoonya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.2",
            "verseOrgIds": [
              "PSA.14.2"
            ]
          }
        }
      ]
    },
    {
