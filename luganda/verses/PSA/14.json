          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balitya nnyo!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 14:5"
      },
      "items": [
        {
          "text": "Kubanga Katonda abeera wamu n'abatuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.14.5",
            "verseOrgIds": [
              "PSA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
