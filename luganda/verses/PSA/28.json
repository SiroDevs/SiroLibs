          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkukoowoola ggwe, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.28.1",
                "verseOrgIds": [
                  "PSA.28.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", Olwazi lwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "tolema kumpuliriza;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "kubanga bw'onoonsiriikirira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:1"
      },
      "items": [
        {
          "text": "nzija kuba nga bali abakkirira mu kinnya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.1",
            "verseOrgIds": [
              "PSA.28.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owulire eddoboozi ery'okwegayirira kwange,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "nga mpanise emikono gyange",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "okwolekera ekifo kyo ekisinga byonna obutukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:2"
      },
      "items": [
        {
          "text": "nga nkukaabirira okunnyamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.2",
            "verseOrgIds": [
              "PSA.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tontwalira mu boonoonyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "abakola ebibi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "abanyumya obulungi ne bannaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:3"
      },
      "items": [
        {
          "text": "so ng'emitima gyabwe gijjudde bukyayi bwerere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.3",
            "verseOrgIds": [
              "PSA.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
