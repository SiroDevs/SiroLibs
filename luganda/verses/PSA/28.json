        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.28.8",
                "verseOrgIds": [
                  "PSA.28.8"
                ]
              }
            }
          ]
        },
        {
          "text": "y'awa abantu be amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:8"
      },
      "items": [
        {
          "text": "era kye kiddukiro eky'obulokozi bw'oyo gwe yafukako amafuta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.8",
            "verseOrgIds": [
              "PSA.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olokole abantu bo, obawe omukisa abalonde bo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 28:9"
      },
      "items": [
        {
          "text": "Obakulemberenga ng'omusumba, era obawanirirenga emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.28.9",
            "verseOrgIds": [
              "PSA.28.9"
            ]
          }
        }
      ]
    }
