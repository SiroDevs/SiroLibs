    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Ya Mukulu wa Bayimbi. Ku ddoboozi, \"Amalanga g'Endagaano.\" Zabbuli ya Asafu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 80:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wulira, Ayi Omusumba wa Isirayiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "ggwe akulembera Yusufu ng'alunda ekisibo kyo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:1"
      },
      "items": [
        {
          "text": "ggwe atudde ku ntebe ey'obwakabaka mu bakerubi, twakire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.1",
            "verseOrgIds": [
              "PSA.80.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 80:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaanyi go galabike mu Efulayimu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "ne mu Benyamini ne mu Manase,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:2"
      },
      "items": [
        {
          "text": "ojje otulokole.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.2",
            "verseOrgIds": [
              "PSA.80.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 80:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukomyewo gy'oli, Ayi Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "otutunuulize amaaso ag'ekisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:3"
      },
      "items": [
        {
          "text": "otulokole.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.3",
            "verseOrgIds": [
              "PSA.80.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 80:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.80.4",
                "verseOrgIds": [
                  "PSA.80.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:4"
      },
      "items": [
        {
          "text": "olituusa ddi okusunguwalira okusaba kw'abantu bo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.4",
            "verseOrgIds": [
              "PSA.80.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 80:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabaliisa emmere ejjudde amaziga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:5"
      },
      "items": [
        {
          "text": "n'obanywesa ebikopo by'amaziga musera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.5",
            "verseOrgIds": [
              "PSA.80.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 80:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otufudde eky'okusekererwa mu baliraanwa baffe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:6"
      },
      "items": [
        {
          "text": "n'abalabe baffe ne batuduulira.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.6",
            "verseOrgIds": [
              "PSA.80.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 80:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukomyewo gy'oli, Ayi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.80.7",
                "verseOrgIds": [
                  "PSA.80.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "otutunuulize amaaso go ag'ekisa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:7"
      },
      "items": [
        {
          "text": "tulokolebwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.7",
            "verseOrgIds": [
              "PSA.80.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 80:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waleeta omuzabbibu ng'oguggya mu Misiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:8"
      },
      "items": [
        {
          "text": "n'ogobamu amawanga agaali mu nsi muno n'ogusimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.8",
            "verseOrgIds": [
              "PSA.80.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 80:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wagulongooseza ettaka, ne gumera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:9"
      },
      "items": [
        {
          "text": "emirandira ne ginywera bulungi, ne gwagaagala mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.9",
            "verseOrgIds": [
              "PSA.80.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 80:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekisiikirize kyagwo ne kibikka ensozi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:10"
      },
      "items": [
        {
          "text": "n'amatabi gaagwo ne gaba ng'emivule egy'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.10",
            "verseOrgIds": [
              "PSA.80.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 80:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatabi gaagwo ne gatuuka ku Nnyanja eya Wakati",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:11"
      },
      "items": [
        {
          "text": "n'amatabi g'ennyanja gaayo ne gatuuka ku Mugga Fulaati.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.11",
            "verseOrgIds": [
              "PSA.80.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 80:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale wamenyera ki ebisenge byagwo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:12"
      },
      "items": [
        {
          "text": "abayitawo bonna ne beenogera ebibala byagwo?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.12",
            "verseOrgIds": [
              "PSA.80.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 80:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embizzi ez'omu kibira zigwonoona,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:13"
      },
      "items": [
        {
          "text": "na buli nsolo ey'omu nsiko egulya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.13",
            "verseOrgIds": [
              "PSA.80.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 80:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukyukire, Ayi Katonda ow'Eggye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "otunuulire ensi ng'osinziira mu ggulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 80:14"
      },
      "items": [
        {
          "text": "olabirire omuzabbibu guno.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.14",
            "verseOrgIds": [
              "PSA.80.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 80:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwe wagwesimbira n'omukono gwo ogwa ddyo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.80.15",
            "verseOrgIds": [
              "PSA.80.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 80:15"
      },
      "items": [
        {
