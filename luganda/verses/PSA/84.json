      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:2"
      },
      "items": [
        {
          "text": "gwagala na kuzirika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.2",
            "verseOrgIds": [
              "PSA.84.3"
            ]
          }
        }
      ]
    },
    {
