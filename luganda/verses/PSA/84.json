                "verseId": "PSA.84.1",
                "verseOrgIds": [
                  "PSA.84.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.1",
            "verseOrgIds": [
              "PSA.84.2"
            ]
          }
        }
