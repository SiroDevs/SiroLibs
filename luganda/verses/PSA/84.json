          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.84.8",
                "verseOrgIds": [
                  "PSA.84.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 84:8"
      },
      "items": [
        {
          "text": "mpuliriza, Ayi Katonda wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.8",
            "verseOrgIds": [
              "PSA.84.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 84:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi Katonda, Engabo yaffe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.84.9",
            "verseOrgIds": [
              "PSA.84.10"
            ]
          }
        }
      ]
    },
