    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "Wabula erinnya lyo lye ligwana okuweebwanga ekitiibwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
