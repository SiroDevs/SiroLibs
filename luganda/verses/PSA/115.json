      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "olw'okwagala kwo n'olw'obwesigwa bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
