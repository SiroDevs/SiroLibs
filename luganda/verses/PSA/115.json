          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki amawanga gabuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
