            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.1",
                "verseOrgIds": [
                  "PSA.115.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", si ffe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
