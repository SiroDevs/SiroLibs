      "attrs": {
        "style": "q2",
        "vid": "PSA 115:5"
      },
      "items": [
        {
          "text": "birina amaaso, naye tebiraba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
