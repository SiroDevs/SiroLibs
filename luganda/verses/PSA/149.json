          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batenderezenga erinnya lye nga bwe bazina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
