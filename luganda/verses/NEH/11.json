  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "NEH 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abatuuze Abapya aba Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze b'abantu ne babeeranga mu Yerusaalemi, abantu abalala ne bakuba akalulu okulonda omuntu omu ku buli bantu kkumi okugenda okubeera mu Yerusaalemi, ekibuga ekitukuvu; omwenda bo ne basigala mu byalo byabwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu ne beebaza abo bonna abeewaayo okubeera mu Yerusaalemi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano be bakungu b'amasaza abaasenga mu Yerusaalemi: Abayisirayiri abamu, nga mwe muli bakabona n'Abaleevi, n'abaweereza ab'omu yeekaalu, ne bazzukulu ba baddu ba Sulemaani; buli omu yabeeranga ku ttaka lye mu kibanja kye.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Yerusaalemi mwabeerangamu abamu ku bazzukulu ba Yuda, n'abamu ku bantu abaava mu Benyamini.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 11:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 11:4"
      },
      "items": [
        {
          "text": "Bazzukulu ba Yuda abaasenga eyo be bano:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:4"
      },
      "items": [
        {
          "text": "Ataya mutabani wa Uzziya, muzzukulu wa Zekkaliya, muzzukulu wa Amaliya, muzzukulu wa Sefatiya, muzzukulu wa Makalaleri, ow'omu lulyo lwa Pereezi;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.4",
            "verseOrgIds": [
              "NEH.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Maaseya mutabani wa Baluki, muzzukulu wa Kolukoze, muzzukulu wa Kazaya, muzzukulu wa Adaya, muzzukulu wa Yoyalibu, muzzukulu wa Zekkaliya, ow'omu lulyo lwa Siiro.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.5",
            "verseOrgIds": [
              "NEH.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazzukulu ba Pereezi abaasenga mu Yerusaalemi baawerera ddala abasajja ebikumi bina mu nkaaga mu munaana (468), abaali abalwanyi abazira.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.6",
            "verseOrgIds": [
              "NEH.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazzukulu ba Benyamini abaasenga eyo be bano:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:7"
      },
      "items": [
        {
          "text": "Sallu mutabani wa Mesullamu, muzzukulu wa Yowedi, muzzukulu wa Pedaya, muzzukulu wa Kolaya, muzzukulu wa Maaseya, muzzukulu wa Isiyeri, muzzukulu wa Yesaya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.7",
            "verseOrgIds": [
              "NEH.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abagoberezi be Gabbayi ne Sallayi, bonna ne bawera abasajja lwenda mu abiri mu munaana (928).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.8",
            "verseOrgIds": [
              "NEH.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoweeri mutabani wa Zikuli ye yali omulabirizi waabwe, ne Yuda mutabani wa Kassenuwa nga ye mukulu w'Ekitundu Ekyokubiri eky'ekibuga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.9",
            "verseOrgIds": [
              "NEH.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakabona baali:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:10"
      },
      "items": [
        {
          "text": "Yedaya mutabani wa Yoyalibu, ne Yakini,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.10",
            "verseOrgIds": [
              "NEH.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Seraya mutabani wa Kirukiya, muzzukulu wa Mesullamu, muzzukulu wa Zadooki, muzzukulu wa Merayoosi, muzzukulu wa Akitubu, alabirira ennyumba ya Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.11",
            "verseOrgIds": [
              "NEH.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne baganda baabwe abaakolanga emirimu mu yeekaalu, be basajja lunaana mu abiri mu babiri (822); Adaya mutabani wa Yerokamu, muzzukulu wa Peraliya, muzzukulu wa Amuzi, muzzukulu wa Zekkaliya, muzzukulu wa Pasukuli, muzzukulu wa Malukiya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.12",
            "verseOrgIds": [
              "NEH.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne baganda be, abaali abakulu b'ennyumba; abasajja ebikumi bibiri mu ana mu babiri (242); Amasusaayi mutabani wa Azaleri, muzzukulu wa Azayi, muzzukulu wa Mesiremoosi, muzzukulu wa Immeri,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.13",
            "verseOrgIds": [
              "NEH.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne baganda be, abaali abalwanyi abazira; abasajja kikumi mu abiri mu munaana (128). Omukulu waabwe ye yali Zabudyeri mutabani wa Kaggedolimu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.14",
            "verseOrgIds": [
              "NEH.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi baali:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:15"
      },
      "items": [
        {
          "text": "Semaaya mutabani wa Kassubu, muzzukulu wa Azulikamu, muzzukulu wa Kasabiya, muzzukulu wa Bunni;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.15",
            "verseOrgIds": [
              "NEH.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sabbesayi ne Yozabadi, abakulu b'Abaleevi, abaavunaanyizibwanga emirimu egy'ebweru egy'ennyumba ya Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.16",
            "verseOrgIds": [
              "NEH.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mattaniya mutabani wa Mikka, muzzukulu wa Zabudi muzzukulu wa Asafu, eyakulemberanga okwebaza mu kiseera eky'okusaba;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:17"
      },
      "items": [
        {
          "text": "Bakubukiya omumyuka we mu baganda be;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:17"
      },
      "items": [
        {
          "text": "ne Abuda mutabani wa Sammuwa, muzzukulu wa Galali, ate muzzukulu wa Yedusuni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.17",
            "verseOrgIds": [
              "NEH.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaleevi abaabeeranga mu kibuga ekitukuvu bonna awamu, baali ebikumi bibiri mu kinaana mu bana (284).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.18",
            "verseOrgIds": [
              "NEH.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuumi b'emiryango baali:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "NEH 11:19"
      },
      "items": [
        {
          "text": "Akkubu, ne Talumoni ne baganda baabwe; abaakuumanga emiryango nga bawera abasajja kikumi mu nsanvu mu babiri (172).",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
            "verseOrgIds": [
              "NEH.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayisirayiri abalala bonna, awamu ne bakabona, n'Abaleevi, baabeeranga mu byalo byonna ebya Yuda, buli muntu ng'ali ku butaka bwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abaweereza ba yeekaalu baabeeranga ku lusozi Oferi, era Zika ne Gisupa be baali abakulu baabwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukulu w'Abaleevi mu Yerusaalemi yali Uzzi mutabani wa Baani, muzzukulu wa Kasabiya, muzzukulu wa Mattaniya, era muzzukulu wa Mikka. Ate era Uzzi yali omu ku bazzukulu ba Asafu, abaakulemberanga okuyimba mu nnyumba ya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayimbi baakoleranga ku biragiro bya kabaka, nga buli lunaku bwe lwetaaganga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
