          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abalala mu Enulimmoni, n'abalala mu Zola, n'abalala mu Yalamusi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abalala mu Zonowa, n'abalala mu Adulamu n'ebyalo ebikyetoolodde, n'abalala mu Lakisi n'ennimiro ezikyetoolodde, n'abalala mu Azeka n'ebyalo ebikyetoolodde. Ne basiisira okuva e Beeruseba okutuuka ku kiwonvu kya Kinomu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        }
      ]
