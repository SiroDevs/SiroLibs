        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebibuga ekyokwekwekamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOS.20.1",
                "verseOrgIds": [
                  "JOS.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'alyoka agamba Yoswa nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gamba abaana ba Isirayiri bateekewo ebibuga ebyokwekwekamu nga bwe nabalagira okuyita mu Musa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nti omuntu yenna atta omulala nga tagenderedde era nga takitegese addukirenga omwo, eyo gy'anaawoneranga omuwoolezi w'eggwanga ayagala okwesasuza.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Annadukiranga mu kimu ku bibuga ebyo n'ayimirira ku mulyango gw'ekibuga annyonnyole ensonga ye eri abakadde b'ekibuga ekyo. Awo ne balyoka bamukkiriza okuyingira mu kibuga ne bamuwa ekifo eky'okubeeramu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'oyo ayagala okwesasuza singa anaamugobereranga, tebateekwa kuwaayo oyo asse tagenderedde kubanga muliraanwa we yamutta tagenderedde, lwa kuba nti yamulinako ekiruyi n'obukyayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mu kibuga omwo mwanaabeeranga, abantu baamu banaawuliranga ensonga ye, era anaabeeranga omwo okutuusa kabona omukulu aliko mu kiseera ekyo, lw'alifa. Olwo nno aliddayo ewaabwe mu kibuga gye yadduka.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne baawulako ebibuga bino: Kedesi mu Ggaliraaya mu nsi ey'ensozi eya Nafutaali, ne Sekemu mu nsi ey'ensozi eya Efulayimu, ne Kiriasualuba, ye Kebbulooni mu nsi ey'ensozi eya Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'emitala wa Yoludaani ku Yeriko ku luuyi olw'ebuvanjuba ne bateekayo Bezeri mu lukoola mu lusenyi mu kika kya Lewubeeni, ne Lamosi mu Gireyaadi mu kika kya Gaadi, ne Golani mu Basani mu kika kya Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebyo bye bibuga ebyateekebwawo abaana ba Isirayiri bonna era ne bannaggwanga abaali mu bo nti omuntu yenna eyattanga omuntu nga tagenderedde addukire eyo aleme kuttibwa omuwoolezi w'eggwanga okutuusa lw'aliyimirira mu maaso g'ekibiina.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
  ],
