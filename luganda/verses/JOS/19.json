              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ensalo yaabwe n'eva ku mwera oguli mu Zaanannimu e Kerefu ne Adaminekebu ne Yabuneeri okutuuka ku Lakkumu n'eryoka ekoma ku mugga Yoludaani.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.33",
            "verseOrgIds": [
