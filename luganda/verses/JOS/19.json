              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bamaze okugabana ensi mu bitundu eby'enjawulo abaana ba Isirayiri ne bawa Yoswa mutabani wa Nuuni omugabo mu bo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
