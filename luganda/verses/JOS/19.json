            "style": "v",
            "sid": "JOS 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'ewetera ku luuyi olw'ebugwanjuba n'etuuka ku Azunnosutaboli ne yeeyongerayo ku Kukkoki, ne yeeyongerayo e Zebbulooni mu bukiikaddyo, n'ekwata ku Aseri mu bugwanjuba, ne ku Yuda ekiri ku Yoludaani ebuvanjuba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.34",
            "verseOrgIds": [
              "JOS.19.34"
            ]
          }
        }
      ]
    },
