      "attrs": {
        "style": "li2",
        "vid": "GEN 36:24"
      },
      "items": [
        {
          "text": "Aya ne Ana; ono ye Ana eyavumbula ensulo z'amazzi agookya, ezaali mu ddungu; bwe yali ng'alunda endogoyi za kitaawe Zibyoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.24",
            "verseOrgIds": [
