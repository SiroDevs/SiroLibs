        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibulaamu ne Agali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salaayi mukyala wa Ibulaamu yali teyamuzaalira mwana;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.1",
            "verseOrgIds": [
              "GEN.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salaayi n'agamba Ibulaamu nti, \"Laba",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.2",
                "verseOrgIds": [
                  "GEN.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "tampadde mwana; weebake n'omuweereza wange, oboolyawo nnyinza okufuna abaana mu ye.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 16:2"
      },
      "items": [
        {
          "text": "Awo Ibulaamu n'awulira eddoboozi lya Salaayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.2",
            "verseOrgIds": [
              "GEN.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'atyo Ibulaamu bwe yali yaakamala emyaka kkumi mu nsi ya Kanani, Salaayi mukazi we n'addira Agali Omumisiri, omuweereza we n'amuwa Ibulaamu abeere mukazi we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.3",
            "verseOrgIds": [
              "GEN.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu ne yeegatta ne Agali, Agali n'aba olubuto.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 16:4"
      },
      "items": [
        {
          "text": "Agali bwe yalaba ng'ali lubuto, n'anyooma Salaayi, mugole we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.4",
            "verseOrgIds": [
              "GEN.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salaayi n'agamba Ibulaamu nti, \"Ekibi ekinkoleddwako kibeere ku ggwe. Nakuwa omuweereza wange mu kifuba kyo naye bw'alabye ng'ali lubuto n'annyooma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.5",
                "verseOrgIds": [
                  "GEN.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "atulamule nze naawe!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.5",
            "verseOrgIds": [
              "GEN.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Ibulaamu n'agamba Salaayi nti, \"Laba, omuweereza wo ali mu buyinza bwo; mukole nga bw'oyagala.\" Awo Salaayi natandika okubonyaabonya Agali; Agali n'adduka okuva w'ali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.6",
            "verseOrgIds": [
              "GEN.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Agali ne Isimayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.7",
                "verseOrgIds": [
                  "GEN.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amusanga ku nsulo y'amazzi mu ddungu, ensulo y'amazzi eri ku kkubo eriraga e Ssuuli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.7",
            "verseOrgIds": [
              "GEN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'agamba nti, \"Agali, omuweereza wa Salaayi, ovudde wa era ogenda wa?\" N'amuddamu nti, \"Nziruka mugole wange Salaayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.8",
            "verseOrgIds": [
              "GEN.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.9",
                "verseOrgIds": [
                  "GEN.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nti, \"Ddayo eri mugole wo omugondere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.9",
            "verseOrgIds": [
              "GEN.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era Malayika n'amugamba nti, \"Ezadde lyo ndiryaza waleme kubeerawo asobola kulibala.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.10",
            "verseOrgIds": [
              "GEN.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.11",
                "verseOrgIds": [
                  "GEN.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "n'amugamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "\"Laba, olina omwana mu nda yo,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "aliba wabulenzi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "olimutuuma Isimayiri,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:11"
      },
      "items": [
        {
          "text": "kubanga",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.11",
                "verseOrgIds": [
                  "GEN.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ategedde okubonaabona kwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.11",
            "verseOrgIds": [
              "GEN.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliba ng'entulege,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "anaalwananga na buli muntu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "era na buli muntu anaalwananga naye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "era anaabanga mu bulabe",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 16:12"
      },
      "items": [
        {
          "text": "ne baganda be.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.12",
            "verseOrgIds": [
              "GEN.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo n'akoowoola erinnya lya",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "GEN.16.13",
                "verseOrgIds": [
                  "GEN.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "eyayogera naye, n'agamba nti, \"Oli Katonda alaba\", kubanga yagamba nti, \"Ndabidde ddala Katonda ne nsigala nga ndi mulamu nga maze okumulaba.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.13",
            "verseOrgIds": [
              "GEN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluzzi kye lwava luyitibwa Beerirakayiro, luli wakati wa Kadesi ne Beredi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.14",
            "verseOrgIds": [
              "GEN.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Agali n'azaalira Ibulaamu omwana owoobulenzi, Ibulaamu n'atuuma mutabani wa Agali gwe yamuzaalira, erinnya Isimayiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibulaamu yali wa myaka kinaana mu mukaaga Agali bwe yamuzaalira Isimayiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
    }
  ],
