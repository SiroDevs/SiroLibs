                "verseOrgIds": [
                  "1CH.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "nga baleekaana n'amaloboozi ag'essanyu, n'eddoboozi ery'eŋŋombe, ery'amakondeere, n'ebitaasa, era nga bakuba nnyo entongooli n'ennanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.28",
            "verseOrgIds": [
              "1CH.15.28"
            ]
          }
        }
