      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:25"
      },
      "items": [
        {
          "text": "ne ku batabani ba Issiya, Zekkaliya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.25",
            "verseOrgIds": [
              "1CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
