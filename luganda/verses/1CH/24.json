      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 24:30"
      },
      "items": [
        {
          "text": "Abo be baali Abaleevi, ng'ennyumba zaabwe bwe zaali.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
