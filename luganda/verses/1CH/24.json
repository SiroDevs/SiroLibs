    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:26"
      },
      "items": [
        {
          "text": "Mutabani wa Yaaziya ye yali Beno.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        }
      ]
    },
