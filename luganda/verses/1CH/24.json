          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku Kiisi, yali mutabani we Yerameeri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.29",
            "verseOrgIds": [
              "1CH.24.29"
            ]
          }
