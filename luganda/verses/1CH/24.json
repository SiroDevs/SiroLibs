          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ku batabani ba Musi, Makuli, ne Ederi ne Yerimosi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        }
