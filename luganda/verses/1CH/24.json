          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okuva ku Makuli, Eriyazaali, ataazaala baana babulenzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28",
            "verseOrgIds": [
              "1CH.24.28"
            ]
          }
        }
