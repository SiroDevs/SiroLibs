      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:24"
      },
      "items": [
        {
          "text": "ne ku batabani ba Mikka, ne Samiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.24",
            "verseOrgIds": [
              "1CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
