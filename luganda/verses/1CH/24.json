            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ne bano bwe batyo ne bakuba obululu, nga baganda baabwe bazzukulu ba Alooni bwe baakola, mu maaso ga Kabaka Dawudi, ne Zadooki, ne Akimereki, n'abakulu b'ennyumba za bakabona n'Abaleevi. Ennyumba ya muganda waabwe omukulu yayisibwanga mu ngeri y'emu ng'ey'omuto.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
