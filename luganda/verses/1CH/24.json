          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabani ba Merali,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        }
      ]
    },
    {
