      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:20"
      },
      "items": [
        {
          "text": "okuva mu batabani ba Subayeri yali Yedeya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
      ]
    },
    {
