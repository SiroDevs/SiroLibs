      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:27"
      },
      "items": [
        {
          "text": "mu Yaaziya: Beno, ne Sokamu, ne Zakkuli, ne Ibuli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        }
      ]
    },
    {
