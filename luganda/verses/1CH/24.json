      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 24:20"
      },
      "items": [
        {
          "text": "okuva mu batabani ba Amulaamu, yali Subayeri;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        }
