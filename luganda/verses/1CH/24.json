      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 24:22"
      },
      "items": [
        {
          "text": "ate ku batabani ba Seromosi yali Yakasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.22",
            "verseOrgIds": [
              "1CH.24.22"
            ]
          }
        }
      ]
    },
    {
