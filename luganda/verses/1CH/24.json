          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ba Lekabiya, Issiya ye yali omuggulanda.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
