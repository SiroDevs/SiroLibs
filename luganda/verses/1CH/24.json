                "verseOrgIds": [
                  "1CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", nga bagoberera ebiragiro ebyabaweebwa jjajjaabwe Alooni, nga",
          "type": "text",
          "attrs": {
