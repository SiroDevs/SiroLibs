          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tewali kibi kirabiddwa mu Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.21",
            "verseOrgIds": [
              "NUM.23.21"
            ]
          }
        }
      ]
    },
