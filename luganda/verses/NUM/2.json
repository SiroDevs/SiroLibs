              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana ba Isirayiri bwe batyo ne bakola ebyo byonna",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.34",
            "verseOrgIds": [
              "NUM.2.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
