            "sid": "NUM 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okugatta awamu abasajja bonna abaali mu lusiisira lwa Ddaani baali emitwalo kkumi n'ettaano mu kasanvu mu lukaaga (157,600). Abo be banaasembangayo okusitula ng'olugendo lutuuse, ng'ebendera zaabwe bwe ziri.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
