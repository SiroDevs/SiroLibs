        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo be baana ba Isirayiri abaabalibwa ng'empya zaabwe bwe zaali. Okugatta abaali mu nsiisira bonna ng'ebibinja byabwe bwe byali, baawera emitwalo nkaaga mu enkumi ssatu mu ebikumi bitaano mu amakumi ataano (603,550).",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye abaana ba Isirayiri bwe baali babalibwa, Abaleevi bo tebaabalibwa, kubanga bw'atyo",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe yalagira Musa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
