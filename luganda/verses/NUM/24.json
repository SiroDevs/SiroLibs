  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "NUM 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Balamu bwe yalaba nga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.1",
                "verseOrgIds": [
                  "NUM.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda asiimye okuwa Isirayiri omukisa, n'ataddayo kunoonya bya bulaguzi, nga bwe yakola ku mirundi emirala, naye n'ayolekeza amaaso ge eddungu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.1",
            "verseOrgIds": [
              "NUM.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu n'alengera ewala, n'alaba Isirayiri gye yasiisira ng'ebika bwe byali, n'ajjirwa Omwoyo wa Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.2",
            "verseOrgIds": [
              "NUM.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'alagula nti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "\"Okulagula kwa Balamu mutabani wa Byoli,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:3"
      },
      "items": [
        {
          "text": "okulagula kw'omuntu azibuddwa amaaso,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.3",
            "verseOrgIds": [
              "NUM.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "okulagula kw'oyo awulira ekigambo kya Katonda",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "alaba okwolesebwa kw'Ayinzabyonna,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:4"
      },
      "items": [
        {
          "text": "eyeeyaze wansi, n'amaaso ge nga gatunula:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.4",
            "verseOrgIds": [
              "NUM.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eweema zo nga nnungi, Ayi Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:5"
      },
      "items": [
        {
          "text": "ebifo byo mw'obeera, Ayi Isirayiri!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.5",
            "verseOrgIds": [
              "NUM.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Byeyaliiridde ng'ebiwonvu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "ng'ennimiro ku mabbali g'omugga,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "ng'emigavu egisimbiddwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.6",
                "verseOrgIds": [
                  "NUM.24.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:6"
      },
      "items": [
        {
          "text": "ng'emivule egiri okumpi n'amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.6",
            "verseOrgIds": [
              "NUM.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazzi ganaakulukutanga mu bulobo bwabwe; ne gabooga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "ensigo zaabwe zirifunanga amazzi mangi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "\"Kabaka waabwe aliba wa kitiibwa okukira Agagi",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:7"
      },
      "items": [
        {
          "text": "obwakabaka bwabwe bunaagulumizibwanga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.7",
            "verseOrgIds": [
              "NUM.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Katonda ye yabaggya mu Misiri",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "balina amaanyi nga aga sseddume ey'omu nsiko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "Basaanyaawo amawanga g'abalabe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "ne bamenyaamenya amagumba gaabwe mu butundutundu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:8"
      },
      "items": [
        {
          "text": "ne babalasa n'obusaale bwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.8",
            "verseOrgIds": [
              "NUM.24.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'empologoma ensajja, beekulula ne bagalamira wansi,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "ng'empologoma enkazi; ani ayaŋŋanga okubagolokosa?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NUM 24:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "\"Akusabiranga omukisa aweebwenga omukisa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 24:9"
      },
      "items": [
        {
          "text": "n'oyo akukolimira akolimirwenga!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.9",
            "verseOrgIds": [
              "NUM.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo obusungu bwa Balaki ne bubuubuukira ku Balamu. N'akuba mu ngalo omulundi gumu, n'amugamba nti, \"Nakuyita okolimire abalabe bange, naye obasabidde mukisa emirundi gino gyonsatule.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.10",
            "verseOrgIds": [
              "NUM.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno situka oddeyo ewammwe! Nagamba nti nnandikuwadde ebitiibwa bingi, naye",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.11",
                "verseOrgIds": [
                  "NUM.24.11"
                ]
              }
            }
          ]
        },
        {
          "text": "akuziyizza okuweebwa ebitiibwa ebyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.11",
            "verseOrgIds": [
              "NUM.24.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu n'agamba Balaki nti, \"Ababaka bo be wantumira, saabagamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.12",
            "verseOrgIds": [
              "NUM.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Balaki ne bw'alimpa ennyumba ye ng'ejjudde zaabu ne ffeeza, sigenda kusukka kiragiro kya",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.13",
                "verseOrgIds": [
                  "NUM.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ne nkola ekyange ku bwange oba nga kirungi oba nga kibi, wabula nga ndyogera ebyo byokka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "NUM.24.13",
                "verseOrgIds": [
                  "NUM.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "by'alindagira okwogera?'",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.13",
            "verseOrgIds": [
              "NUM.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaakano nno nzirayo ewaffe mu bantu bange, naye wuliriza nga nkulabula abantu bano kye balikola abantu bo mu nnaku ezijja.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.14",
            "verseOrgIds": [
              "NUM.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okulagula kwa Balamu Okwokuna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
