  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "JOB 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erifaazi Addamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Erifaazi Omutemani n'addamu n'ayogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.1",
            "verseOrgIds": [
              "JOB.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omuntu ayinza okugasa Katonda?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:2"
      },
      "items": [
        {
          "text": "Wadde oyo ow'amagezi ayinza okumuyamba?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.2",
            "verseOrgIds": [
              "JOB.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayinzabyonna yandifunye kwesiima ki singa wali mutuukirivu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:3"
      },
      "items": [
        {
          "text": "Yandiganyuddwa ki singa amakubo go gaali magolokofu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.3",
            "verseOrgIds": [
              "JOB.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Akukangavvula lwa kumutya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:4"
      },
      "items": [
        {
          "text": "era kyava akuvunaana?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.4",
            "verseOrgIds": [
              "JOB.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwonoona kwo si kunene nnyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:5"
      },
      "items": [
        {
          "text": "Ebibi byo si bingi nnyo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.5",
            "verseOrgIds": [
              "JOB.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga waggya ku muganda wo emisingo awatali nsonga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:6"
      },
      "items": [
        {
          "text": "waggya engoye ku bantu, n'obaleka bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.6",
            "verseOrgIds": [
              "JOB.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewawa bakoowu mazzi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:7"
      },
      "items": [
        {
          "text": "abaagala wabamma emmere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.7",
            "verseOrgIds": [
              "JOB.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wadde nga wali musajja wa maanyi, eyalina ettaka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:8"
      },
      "items": [
        {
          "text": "omusajja ow'ekitiibwa, era nga byonna ggwe nnyini byo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.8",
            "verseOrgIds": [
              "JOB.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weegobako bannamwandu bagende nga toliiko ky'obawadde;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:9"
      },
      "items": [
        {
          "text": "abatalina bakitaabwe n'obamalamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.9",
            "verseOrgIds": [
              "JOB.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emitego kyegivudde gikwetooloola.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:10"
      },
      "items": [
        {
          "text": "Lwaki entiisa ey'amangu ekujjira?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.10",
            "verseOrgIds": [
              "JOB.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lwaki enzikiza ekutte nnyo tosobola kulaba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:11"
      },
      "items": [
        {
          "text": "era lwaki amataba gakubikkako?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.11",
            "verseOrgIds": [
              "JOB.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Katonda tali waggulu mu ggulu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:12"
      },
      "items": [
        {
          "text": "Era laba, emmunyeenye ezisingayo okuba waggulu, nga bwe ziri ewala!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.12",
            "verseOrgIds": [
              "JOB.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate n'ogamba nti, 'Katonda amanyi ki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:13"
      },
      "items": [
        {
          "text": "Ayinza okulamulira mu kizikiza?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.13",
            "verseOrgIds": [
              "JOB.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebire ebikutte bimubikkako, n'aba ng'atatulaba",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:14"
      },
      "items": [
        {
          "text": "bw'aba atambula mu bifo by'omu ggulu.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.14",
            "verseOrgIds": [
              "JOB.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoosigala mu kkubo ery'edda",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:15"
      },
      "items": [
        {
          "text": "abasajja abakozi b'ebibi lye baakwata?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.15",
            "verseOrgIds": [
              "JOB.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baatwalibwa ng'ekiseera kyabwe tekinnatuuka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:16"
      },
      "items": [
        {
          "text": "emisingi gyabwe gyatwalibwa amataba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.16",
            "verseOrgIds": [
              "JOB.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Be bagamba Katonda nti, 'Tulekere emirembe!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:17"
      },
      "items": [
        {
          "text": "Ayinzabyonna ayinza kutukola ki?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.17",
            "verseOrgIds": [
              "JOB.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate nga ye, ye yajjuza ennyumba zaabwe ebintu ebirungi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 22:18"
      },
      "items": [
        {
          "text": "noolwekyo neewuunya nnyo amagezi g'abakozi b'ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.18",
            "verseOrgIds": [
              "JOB.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatuukirivu balaba okuzikirira kwabwe ne bajaguza;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.22.19",
            "verseOrgIds": [
              "JOB.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
