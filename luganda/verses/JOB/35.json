  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JOB 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eriku n'ayongera okwogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.1",
            "verseOrgIds": [
              "JOB.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Olowooza kiba kituufu ggwe okugamba nti, Katonda ananziggyako omusango.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:2"
      },
      "items": [
        {
          "text": "Oyogera nti, obutuukirivu bwange businga obwa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate obuuza nti, 'Nganyulwa ntya?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:3"
      },
      "items": [
        {
          "text": "Kirungi ki kye nfuna mu kwonoona kwange?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nandyagadde okukuddamu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:4"
      },
      "items": [
        {
          "text": "ne mikwano gyo egyo gy'oli nagyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunula eri eggulu olabe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:5"
      },
      "items": [
        {
          "text": "tunuulira ebire, ebiri waggulu ennyo okukusinga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa oyonoona ekyo kimukwatako kitya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:6"
      },
      "items": [
        {
          "text": "Ebyonoono byo bwe byeyongera, ekyo kimukolako ki?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'oba omutuukirivu, kiki ky'oba omuwadde,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:7"
      },
      "items": [
        {
          "text": "oba kiki ky'aba afunye okuva mu ngalo zo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwonoona kwo kukosa muntu nga ggwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:8"
      },
      "items": [
        {
          "text": "era n'obutuukirivu bwo bukwata ku baana b'abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakaaba olw'okunyigirizibwa okw'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:9"
      },
      "items": [
        {
          "text": "balaajaanira ab'omukono ogw'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tewali n'omu agamba nti, Aluwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JOB.35.10",
                "verseOrgIds": [
                  "JOB.35.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Omutonzi wange",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:10"
      },
      "items": [
        {
          "text": "atuwa ennyimba ekiro,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "atuyigiriza ebingi okusinga ensolo ez'omu nsiko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:11"
      },
      "items": [
        {
          "text": "era n'atufuula bagezi okusinga ebinyonyi eby'omu nsiko?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Newaakubadde nga bakaaba, tayinza kuwulira",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:12"
      },
      "items": [
        {
          "text": "n'addamu kukaaba kw'abasajja ab'amalala abakozi b'ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala ddala Katonda tawuliriza kukoowoola kwabwe okwo okutaliimu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:13"
      },
      "items": [
        {
          "text": "Ayinzabyonna takufaako.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale kiba kitya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "bw'ogamba nti tomulaba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "era nti, Omusango gwo guli mu maaso ge",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "era oteekwa okumulindirira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "oba nti, ne bw'asunguwala tabonereza",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "era tafaayo nnyo ku butali butuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno Yobu ayasamya akamwa ke okwogera ebitaliimu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:16"
      },
      "items": [
        {
          "text": "obutamanya bumwogeza ebigambo olukunkumuli.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    }
  ],
