  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2SA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dawudi ne Mefibosesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawudi n'abuuza nti, \"Wakyaliwo omuntu mu nnyumba ya Sawulo eyasigalawo gwe nnyinza okulaga ekisa ku lwa Yonasaani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo waaliwo omuddu mu nnyumba ya Sawulo erinnya lye Ziba. Ne bamutumya, n'ajja mu maaso ga Dawudi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:2"
      },
      "items": [
        {
          "text": "Kabaka n'amubuuza nti, \"Ggwe Ziba?\" N'addamu nti, \"Nze wuuyo omuddu wo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'amubuuza nti, \"Tewaliwo muntu mu nnyumba ya Sawulo eyasigalawo gwe nnyinza okukolera ebirungi olw'ekisa kya Katonda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:3"
      },
      "items": [
        {
          "text": "Ziba n'addamu kabaka nti, \"Wakyaliwo mutabani wa Yonasaani, eyalemala ebigere.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabaka n'amubuuza nti, \"Ali ludda wa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:4"
      },
      "items": [
        {
          "text": "Ziba n'amuddamu nti, \"Ali mu nnyumba ya Makiri mutabani wa Ammiyeri mu Lodebali.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Dawudi n'amutumya, ne bamuleeta okuva mu nnyumba ya Makiri mutabani wa Ammiyeri mu Lodebali.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibosesi mutabani wa Yonasaani, muzzukulu wa Sawulo n'ajja eri Dawudi n'avuunama mu maaso ge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:6"
      },
      "items": [
        {
          "text": "Dawudi n'amubuuza nti, \"Ggwe Mefibosesi?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:6"
      },
      "items": [
        {
          "text": "N'addamu nti, \"Nze wuuyo omuddu wo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawudi n'amugamba nti, \"Totya kubanga siireme kukukolera bya kisa ku lwa Yonasaani kitaawo. Nzija kukuddiza ettaka lyonna eryali erya jjajjaawo Sawulo, era onooliranga ku mmeeza yange.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibosesi ne yeeyanza n'ayogera nti, \"Omuddu wo kye ki, okufaayo ku mbwa enfu nga nze?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo kabaka n'ayita Ziba, omuddu wa Sawulo, n'amugamba nti, \"Mpadde muzzukulu wa mukama wo ebintu byonna ebyali ebya Sawulo n'ennyumba ye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe ne batabani bo n'abaddu bo munaamulimiranga ettaka ne muleeta ebibala ebirivaamu, muzzukulu wa mukama wo abenga n'ekyokulya. Mefibosesi muzzukulu wa mukama wo, ye anaaliiranga ku mmeeza yange nange, ennaku zange zonna.\" Ziba yalina abaana aboobulenzi kkumi na bataano n'abaddu amakumi abiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Ziba n'agamba kabaka nti, \"Nga bw'olagidde mukama wange kabaka, bwe kijja okukolebwa omuddu wo.\" Mefibosesi n'aliiranga ku mmeeza ya Dawudi ng'omu ku balangira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibosesi yalina mutabani we omuto, eyayitibwanga Mikka, ne bonna abaali ab'ennyumba ya Ziba baali baddu ba Mefibosesi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefibosesi n'abeera mu Yerusaalemi kubanga yaliiranga ku mmeeza ya kabaka. Yali yalemala ebigere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
