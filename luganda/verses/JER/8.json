  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "JER 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mu kiseera ekyo, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.1",
                "verseOrgIds": [
                  "JER.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", amagumba ga bakabaka ba Yuda, n'amagumba g'abalangira, n'amagumba ga bakabona, n'amagumba ga bannabbi, n'amagumba g'abatuuze b'omu Yerusaalemi galiggyibwa mu ntaana zaago.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale galyanikibwa mu musana, eri omwezi n'emmunyeenye ez'omu ggulu, ze baayagala era ne baaweereza era ze baagoberera ne beebuuzaako ne basinza. Tebalikuŋŋaanyizibwa wadde okuziikibwa naye balibeera ng'ebisasiro wansi ku ttaka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'abantu b'ensi eno ennyonoonyi bw'etyo abalisigalawo, be ndiba nsasaanyizza mu mawanga, balyegomba okufa okusinga okuba abalamu,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.3",
                "verseOrgIds": [
                  "JER.8.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekibi n'Okubonerezebwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bategeeze nti, Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.4",
                "verseOrgIds": [
                  "JER.8.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "\"Omuntu bw'agwa, tayimuka?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:4"
      },
      "items": [
        {
          "text": "Oba omuntu bw'ava mu kkubo ettuufu, takyusa n'adda?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.4",
            "verseOrgIds": [
              "JER.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale lwaki abantu bange bano",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:5"
      },
      "items": [
        {
          "text": "banvaako ne bagendera ddala?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.5",
            "verseOrgIds": [
              "JER.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawuliriza n'obwegendereza",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "naye tebayogera mazima;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "tewali muntu yenna yeenenya bibi byakoze n'okwebuuza nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "'Kiki kino kye nkoze?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "Buli muntu akwata kkubo lye",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:6"
      },
      "items": [
        {
          "text": "ng'embalaasi efubutuka ng'etwalibwa mu lutalo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.6",
            "verseOrgIds": [
              "JER.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebinyonyi ebibuukira mu bbanga",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "bimanyi ebiseera mwe bitambulira;",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "ne kaamukuukulu n'akataayi ne ssekanyolya",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "bimanyi ebiseera mwe bikomerawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "naye abantu bange",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:7"
      },
      "items": [
        {
          "text": "tebamanyi biragiro bya",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.7",
                "verseOrgIds": [
                  "JER.8.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.7",
            "verseOrgIds": [
              "JER.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyinza mutya okwogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "\"Tuli bagezi nnyo, n'amateeka ga",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.8",
                "verseOrgIds": [
                  "JER.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "tugalina,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "ate nga ekkalaamu y'abawandiisi ey'obulimba",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:8"
      },
      "items": [
        {
          "text": "yeebikyusizza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.8",
            "verseOrgIds": [
              "JER.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagezigezi baliswala ne bakeŋŋentererwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "era balitwalibwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "Bagaanyi ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.8.9",
                "verseOrgIds": [
                  "JER.8.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:9"
      },
      "items": [
        {
          "text": "magezi ki ge balina?",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.9",
            "verseOrgIds": [
              "JER.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo bakazi baabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "ndibagabira abasajja abalala",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "n'ennimiro zaabwe",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "zitwalibwe abantu abalala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "Bonna ba mululu okuva ku asembayo wansi okutuuka ku akomererayo waggulu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.10",
            "verseOrgIds": [
              "JER.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 8:10"
      },
      "items": [
        {
          "text": "nnabbi ne kabona bonna balimba ne babba abantu.",
          "type": "text",
          "attrs": {
