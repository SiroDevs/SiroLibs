        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olunaku olw'Akabi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.1",
                "verseOrgIds": [
                  "JER.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira nga kigamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.1",
            "verseOrgIds": [
              "JER.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Towasa, kuzaalira balenzi na bawala mu kifo kino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.2",
            "verseOrgIds": [
              "JER.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.3",
                "verseOrgIds": [
                  "JER.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ky'agamba ku balenzi n'abawala abazaalibwa mu nsi eno era ne ku bakazi ba nnyaabwe ne ku basajja ba kitaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.3",
            "verseOrgIds": [
              "JER.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balifa endwadde ez'akabi. Tebalibakungubagira wadde okuziikibwa naye balibeera ng'ebisaaniko ebisuuliddwa ku ttaka. Balizikirira na kitala era balifa njala; n'emirambo gyabwe girifuuka mmere ya binyonyi eby'omu bbanga n'ebisolo eby'omu nsiko.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.4",
            "verseOrgIds": [
              "JER.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, \"Toyingira mu nnyumba we balya emmere y'olumbe, togenda kukungubaga wadde okubasaasira kubanga nziggyewo omukisa gwange n'okwagala kwange era n'okusaasira kwange ku bantu bano,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.5",
                "verseOrgIds": [
                  "JER.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.5",
            "verseOrgIds": [
              "JER.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna ab'ekitiibwa n'abakopi baakufiira mu nsi eno. Tebajja kuziikibwa wadde okukungubagirwa era tewali ajja kwesala misale wadde okumwa omutwe ku lwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.6",
            "verseOrgIds": [
              "JER.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewaliba n'omu aliwaayo mmere okuliisa abakungubagira abafiiriddwa, ne bwaliba kitaabwe oba nnyaabwe nga kwe kuli afudde; tewaliba n'omu alibawaayo wadde ekyokunywa okubakubagiza.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.7",
            "verseOrgIds": [
              "JER.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era toyingiranga mu nnyumba muli kinyumu n'otuula okulya n'okunywa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.8",
            "verseOrgIds": [
              "JER.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga kino",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.9",
                "verseOrgIds": [
                  "JER.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, Katonda wa Isirayiri, ky'agamba nti, \"Nga weerabirako n'amaaso go, mu nnaku z'obulamu bwo, ndikomya eddoboozi ery'essanyu era n'ery'okwesiima ery'abagole omusajja ne mukyala we mu kifo kino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.9",
            "verseOrgIds": [
              "JER.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bw'oligamba abantu bino byonna ne bakubuuza nti, 'Lwaki",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "atutuusizaako akabi kano konna? Kibi ki kye tukoze? Musango ki gwe tuzizza eri",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.10",
                "verseOrgIds": [
                  "JER.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.10",
            "verseOrgIds": [
              "JER.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale bagambe nti, 'Kubanga bakitammwe bandeka ne batakuuma mateeka gange,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.11",
                "verseOrgIds": [
                  "JER.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", 'ne bagoberera bakatonda abalala ne babaweereza ne babasinza. Bandeka ne batakuuma mateeka gange.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.11",
            "verseOrgIds": [
              "JER.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era mweyisizza bubi n'okusinga bakitammwe. Laba buli omu nga bwe yeeyisa ng'akakanyaza omutima gwe ogujjudde ebibi mu kifo ky'okuŋŋondera.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.12",
            "verseOrgIds": [
              "JER.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo ndibaggya mu nsi eno ne mbateeka mu nsi mmwe gye mutamanyi wadde bakitammwe gye bataamanya, era nga muli eyo muliweereza bakatonda abalala emisana n'ekiro, era siribakwatirwa kisa.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye ennaku zijja,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.14",
                "verseOrgIds": [
                  "JER.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". \"Abantu lwe bataliddayo kwogera nti, 'Ddala nga Katonda bw'ali omulamu eyaggya Isirayiri mu nsi y'e Misiri,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye baligamba nti, 'Ddala nga",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.15",
                "verseOrgIds": [
                  "JER.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'ali omulamu eyaggya Abayisirayiri mu nsi ey'omu bukiikakkono era n'okuva mu nsi zonna gye yali abasudde.' Kubanga ndibakomyawo mu nsi gye nawa bajjajjaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.15",
            "verseOrgIds": [
              "JER.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye kaakano leka ntumye abavubi bange,\" bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.16",
                "verseOrgIds": [
                  "JER.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"era bajja kubavuba. Ng'ekyo kiwedde nzija kutumya abayizzi bange, era bajja kubayigga ku buli lusozi era na buli kasozi na buli lwatika lwonna mu njazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.16",
            "verseOrgIds": [
              "JER.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaaso gange galaba buli kye bakola, tebinkwekeddwa wadde obutali butuukirivu bwabwe okuunkwekebwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.17",
            "verseOrgIds": [
              "JER.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibasasula olw'obutali butuukirivu bwabwe n'olw'ekibi kyabwe emirundi ebiri, kubanga boonoonye ensi yange olw'ebintu ebitaliimu bulamu ne bajjuza omugabo gwange ebifaananyi bya bakatonda baabwe abakolerere, eby'emizizo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.18",
            "verseOrgIds": [
              "JER.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JER.16.19",
                "verseOrgIds": [
                  "JER.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", amaanyi gange era ekigo kyange,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 16:19"
      },
      "items": [
        {
          "text": "ekiddukiro kyange mu biro eby'okulabiramu ennaku,",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.19",
            "verseOrgIds": [
              "JER.16.19"
            ]
          }
        }
      ]
