  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "EZK 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okukungubagira Falaawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo mu mwaka ogw'ekkumi n'ebiri, mu mwezi ogw'ekkumi n'ebiri ku lunaku olw'olubereberye, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.1",
                "verseOrgIds": [
                  "EZK.32.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kinzijira n'aŋŋamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.1",
            "verseOrgIds": [
              "EZK.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omwana w'omuntu, tandika okukungubagira Falaawo, ye kabaka w'e Misiri, omutegeeze nti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "\" 'Oli ng'empologoma mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ng'ogusota wakati mu nnyanja,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "ng'owaguza mu migga gyo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "era ng'otabangula amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:2"
      },
      "items": [
        {
          "text": "n'osiikuula n'emigga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.2",
            "verseOrgIds": [
              "EZK.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.3",
                "verseOrgIds": [
                  "EZK.32.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda nti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "\" 'Ndikusuulako akatimba kange,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "ne nkusindikira ekibiina ky'abantu ekinene,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:3"
      },
      "items": [
        {
          "text": "era balikuvuba n'akatimba kange.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.3",
            "verseOrgIds": [
              "EZK.32.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndikusuula ku lukalu, ne nkuleka ku ttale,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "era ebinyonyi byonna eby'omu bbanga birikukkako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "n'ensolo enkambwe zonna ez'omu nsi zirikulya",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:4"
      },
      "items": [
        {
          "text": "ne zikkusibwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.4",
            "verseOrgIds": [
              "EZK.32.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndisaasaanya ennyama ey'omubiri gwo ku nsozi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:5"
      },
      "items": [
        {
          "text": "era ndijjuza ebiwonvu amagumba go.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.5",
            "verseOrgIds": [
              "EZK.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditotobaza ensi n'omusaayi gwo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "okutuukira ddala ku nsozi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:6"
      },
      "items": [
        {
          "text": "era ndijjuza zonna ennyama ey'omubiri gwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.6",
            "verseOrgIds": [
              "EZK.32.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe ndikusaanyaawo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "ndibikka eggulu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "ne nfuula emmunyeenye zaakwo",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:7"
      },
      "items": [
        {
          "text": "okubaako ekizikiza;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.7",
            "verseOrgIds": [
              "EZK.32.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndibikka omusana n'ekire, era n'omwezi tegulireeta kitangaala kyagwo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "Ebitangaala byonna eby'omu ggulu, ndibifuula enzikiza;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:8"
      },
      "items": [
        {
          "text": "era n'ensi yo yonna ndigireetako enzikiza, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "EZK.32.8",
                "verseOrgIds": [
                  "EZK.32.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.8",
            "verseOrgIds": [
              "EZK.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndyeraliikiriza emitima gy'amawanga amangi,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "bwe ndikuzikiriza mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:9"
      },
      "items": [
        {
          "text": "ne mu nsi z'otomanyangako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.9",
            "verseOrgIds": [
              "EZK.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga mangi galijjula entiisa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "era bakabaka baabwe balisasamala,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "ng'obagalulira ekitala mu maaso gaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "Ku lunaku olw'okugwa kwo,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "buli omu ku bo alikankana,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 32:10"
      },
      "items": [
        {
          "text": "era buli muntu aligezaako okuwonya obulamu bwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.10",
            "verseOrgIds": [
              "EZK.32.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Kubanga bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.11",
            "verseOrgIds": [
              "EZK.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
