          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Era Falaawo, bw'alibalaba, alyekubagiza olw'eggye lye eryattibwa n'ekitala, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.31",
            "verseOrgIds": [
              "EZK.32.31"
            ]
          }
        },
        {
