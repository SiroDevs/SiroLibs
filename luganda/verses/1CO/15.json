  "verseCount": 58,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1CO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kristo Yazuukira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, mbajjukiza Enjiri gye nababuulira era gye mwakkiriza era gye munywereddemu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.1",
            "verseOrgIds": [
              "1CO.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulokolebwa lwa Njiri eyo gye nababuulira, bwe muginywererako, naye bwe kitaba bwe kityo muba mwakkiririza bwereere.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.2",
            "verseOrgIds": [
              "1CO.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga nabategeeza ekigambo ekikulu ennyo nange kye nnaweebwa ekigamba nti Kristo yafa olw'ebibi byaffe, ng'Ebyawandiikibwa bwe bigamba,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.3",
            "verseOrgIds": [
              "1CO.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nti yaziikibwa, n'azuukizibwa ku lunaku olwokusatu ng'Ebyawandiikibwa bwe bigamba,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.4",
            "verseOrgIds": [
              "1CO.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "era nti yalabibwa Keefa n'oluvannyuma ekkumi n'ababiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.5",
            "verseOrgIds": [
              "1CO.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era yalabibwa abooluganda abasukka ebikumi ebitaano omulundi gumu era abamu ku abo bakyali balamu newaakubadde ng'abalala baafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.6",
            "verseOrgIds": [
              "1CO.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo n'alyoka alabikira Yakobo, n'oluvannyuma n'alabikira n'abatume bonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.7",
            "verseOrgIds": [
              "1CO.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oluvannyuma lwa bonna n'alyoka alabikira nange, ng'omwana azaalibbwa nga musowole.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.8",
            "verseOrgIds": [
              "1CO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga nze nsembayo mu batume, Era sisaanira na kuyitibwa mutume, kubanga nayigganya Ekkanisa ya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.9",
            "verseOrgIds": [
              "1CO.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye olw'ekisa kya Katonda ndi nga bwe ndi kaakano, era ekisa Katonda kye yankwatirwa tekyafa bwereere. Kubanga nakola nnyo okusinga abalala bonna, naye si nze nakola wabula ekisa kya Katonda ekiri nange kye kyakola.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.10",
            "verseOrgIds": [
              "1CO.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oba nze oba bo, be baakola ennyo ekyo si kikulu, ekikulu kye kino nti twababuulira Enjiri era nammwe ne mugikkiriza.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.11",
            "verseOrgIds": [
              "1CO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuzuukira kw'Abafu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga abantu bategeezebwa nti Kristo yazuukizibwa mu bafu lwaki abamu mu mmwe bagamba nti tewali kuzuukira kwa bafu?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.12",
            "verseOrgIds": [
              "1CO.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga tewali kuzuukira kwa bafu ne Kristo teyazuukizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.13",
            "verseOrgIds": [
              "1CO.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era obanga Kristo teyazuukizibwa, bye tubategeeza tebiriimu, era n'okukkiriza kwammwe tekuliiko kye kugasa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.14",
            "verseOrgIds": [
              "1CO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ate era tuba ng'aboogera eby'obulimba ku Katonda, kubanga twakakasa nti Katonda yazuukiza Kristo. Naye teyamuzuukiza bwe kiba ng'abafu tebazuukizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.15",
            "verseOrgIds": [
              "1CO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga abafu tebazuukizibwa, ne Kristo teyazuukizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.16",
            "verseOrgIds": [
              "1CO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era obanga Kristo teyazuukizibwa okukkiriza kwammwe tekuliimu nsa, era mukyali mu bibi byammwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.17",
            "verseOrgIds": [
              "1CO.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'abo abaafa nga bakkiriza Kristo baazikirira.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.18",
            "verseOrgIds": [
              "1CO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga essuubi lyaffe mu Kristo likoma mu bulamu buno bwokka, tuli bakusaasirwa nnyo okusinga abantu bonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.19",
            "verseOrgIds": [
              "1CO.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka ddala Kristo yazuukizibwa mu bafu, era bye bibala ebibereberye eby'abo abaafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.20",
            "verseOrgIds": [
              "1CO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba ng'okufa bwe kwaleetebwa omuntu, era n'okuzuukira kw'abafu kwaleetebwa muntu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.21",
            "verseOrgIds": [
              "1CO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba ng'abantu bonna bwe baafa olwa Adamu, era bwe batyo bonna balifuulibwa abalamu olwa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.22",
            "verseOrgIds": [
              "1CO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka buli omu mu luwalo lwe, Kristo ye yasooka era bw'alijja ababe ne baddako,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.23",
            "verseOrgIds": [
              "1CO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwo enkomerero n'eryoka etuuka, Kristo n'akwasa Katonda Kitaawe obwakabaka; Kristo ng'amaze okuzikiriza obufuzi bwonna, n'obuyinza bwonna era n'amaanyi gonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.24",
            "verseOrgIds": [
              "1CO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Kristo agwanidde okufuga okutuusa bw'alissa abalabe be bonna wansi w'ebigere bye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.25",
            "verseOrgIds": [
              "1CO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulabe we alisembayo okuzikirizibwa kwe Kufa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.26",
            "verseOrgIds": [
              "1CO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga yassa ebintu byonna wansi w'ebigere bye. Naye bw'agamba nti ebintu byonna biri wansi we, kitegeeza nti aggyeko oli ey'amusobozesa okufuga ebintu byonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.27",
            "verseOrgIds": [
              "1CO.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CO 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katonda bw'alimala okussa byonna mu buyinza bwa Kristo, olwo Kristo yennyini, Omwana we, n'alyoka afugibwa Katonda eyamuwa okufuga byonna. Era olwo Katonda n'alyoka afugira ddala byonna.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.28",
            "verseOrgIds": [
              "1CO.15.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CO 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga abafu tebazuukizibwa, abo ababatizibwa ku lw'abafu balikola batya? Era kale lwaki babatizibwa ku lwabwe?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.29",
            "verseOrgIds": [
              "1CO.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CO 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ffe lwaki tuli mu kabi buli kaseera?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.30",
            "verseOrgIds": [
              "1CO.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CO 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, olw'okwenyumiriza kwe munninamu, era kwe nnina mu Kristo Yesu Mukama waffe, nkakasa nti nfa buli lunaku.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.31",
            "verseOrgIds": [
              "1CO.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CO 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale obanga nze omuntu obuntu nalwana n'ensolo enkambwe mu Efeso, kingasa ki? Obanga abafu tebazuukizibwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 15:32"
      },
      "items": [
        {
          "text": "\"Kale tulye tunywe",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 15:32"
      },
      "items": [
        {
          "text": "kubanga enkya tuli ba kufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.32",
            "verseOrgIds": [
              "1CO.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CO 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temulimbibwalimbibwanga, kubanga \"emikwano emibi gyonoona empisa ennungi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.33",
            "verseOrgIds": [
              "1CO.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CO 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweddemu, mutambulirenga mu butuukirivu mulekeraawo okukola ebibi, kubanga abamu mu mmwe tebamanyi Katonda. Kino nkyogera kubakwasa nsonyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.34",
            "verseOrgIds": [
              "1CO.15.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuzuukira kw'Omubiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CO 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuntu ayinza okubuuza nti, \"Abafu bazuukizibwa batya?\" Era nti, mubiri gwa ngeri ki gwe bajja nagwo?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.35",
            "verseOrgIds": [
              "1CO.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CO 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musirusiru ggwe! Ensigo gy'osiga temeruka nga tennafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.36",
            "verseOrgIds": [
              "1CO.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CO 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ensigo eyo gy'osiga eba mpeke buweke; so si ekirivaamu oba ya ŋŋaano, oba ya ngeri ndala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.37",
            "verseOrgIds": [
              "1CO.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CO 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Katonda agiwa omubiri nga bw'ayagala, era buli ngeri ya nsigo agiwa omubiri gwayo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.38",
            "verseOrgIds": [
              "1CO.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga emibiri gyonna tegiba gya ngeri emu. Waliwo omubiri ogw'abantu, waliwo ogw'ensolo, waliwo ogw'ennyonyi, era waliwo n'ogw'ebyennyanja.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.39",
            "verseOrgIds": [
              "1CO.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo waliwo emibiri egy'omu ggulu, n'emibiri egy'omu nsi. Naye ekitiibwa ky'emibiri egy'omu ggulu kirala, era n'eky'egy'omu nsi kirala.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.40",
            "verseOrgIds": [
              "1CO.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CO 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo ekitiibwa ky'enjuba, waliwo eky'omwezi, era waliwo ekitiibwa eky'emmunyeenye. Naye era n'emmunyeenye tezenkanankana mu kwaka kubanga buli munyeenye ya njawulo mu kwaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.41",
            "verseOrgIds": [
              "1CO.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CO 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era bwe kiri mu kuzuukira. Omubiri guziikibwa nga gwa kuvunda, ne guzuukizibwa nga si gwa kuvunda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.42",
            "verseOrgIds": [
              "1CO.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CO 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guziikibwa nga si gwa kitiibwa, naye ne guzuukizibwa nga gujjudde ekitiibwa. Guziikibwa nga munafu, naye guzuukizibwa nga gwa maanyi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.43",
            "verseOrgIds": [
              "1CO.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CO 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guziikibwa nga mubiri bubiri, naye guzuukizibwa nga mubiri gwa mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CO 15:44"
      },
      "items": [
        {
          "text": "Kale obanga waliwo omubiri obubiri, era waliwo omubiri ogw'omwoyo,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.44",
            "verseOrgIds": [
              "1CO.15.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CO 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "kyekyava kiwandiikibwa nti, \"Adamu, omuntu eyasooka, yatondebwa ng'alina obulamu.\" Kyokka Adamu ow'oluvannyuma ye Mwoyo aleeta obulamu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.45",
            "verseOrgIds": [
              "1CO.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CO 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye eky'omwoyo si kye kyasooka, wabula eky'omubiri obubiri kye kyasooka, n'oluvannyuma eky'omwoyo ne kijja.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.46",
            "verseOrgIds": [
              "1CO.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "1CO 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu eyasooka yava mu ttaka, yakolebwa mu nfuufu. Ye omuntu owookubiri yava mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.47",
            "verseOrgIds": [
              "1CO.15.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "1CO 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'eyakolebwa mu nfuufu bw'ali, n'abo abaakolebwa mu nfuufu bwe bali.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.48",
            "verseOrgIds": [
              "1CO.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CO 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era nga bwe tufaanana oyo eyakolebwa mu nfuufu, era bwe tutyo bwe tulifaanana oyo eyava mu ggulu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.49",
            "verseOrgIds": [
              "1CO.15.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "1CO 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abooluganda, kye ŋŋamba kye kino nti omubiri guno ogw'oku nsi, ogw'ennyama n'omusaayi, teguyinza kusikira bwakabaka bwa Katonda. Emibiri gyaffe egivunda tegisobola kuba gya lubeerera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.50",
            "verseOrgIds": [
              "1CO.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "1CO 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye leka mbabuulire ekyama: Si ffenna abalifa, naye eŋŋombe ey'enkomerero bw'erivuga ffenna tulifuusibwa",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.51",
            "verseOrgIds": [
              "1CO.15.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "1CO 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu kaseera katono ng'okutemya kikowe. Kubanga eŋŋombe erivuga, n'abafu balizuukizibwa, nga tebakyaddayo kufa era ffenna tulifuusibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.52",
            "verseOrgIds": [
              "1CO.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "1CO 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omubiri guno oguvunda gwa kufuuka ogutavunda, era omubiri guno ogufa gwa kufuuka ogutafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.53",
            "verseOrgIds": [
              "1CO.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1CO 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omubiri guno oguvunda bwe gulifuuka ogutavunda, ogufa ne gufuuka ogutafa, olwo Ekyawandiikibwa ne kiryoka kituukirira ekigamba nti, \"Okufa kuwanguddwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.54",
            "verseOrgIds": [
              "1CO.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1CO 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ggwe kufa, obuwanguzi bwo buluwa?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 15:55"
      },
      "items": [
        {
          "text": "Ggwe kufa, amaanyi go agalumya galuwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.55",
            "verseOrgIds": [
              "1CO.15.55"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "1CO 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuyinza obulumya buva mu kibi, n'amaanyi g'ekibi gava mu mateeka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.56",
            "verseOrgIds": [
              "1CO.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "1CO 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka Katonda yeebazibwe atuwanguza ffe ku bwa Mukama waffe Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.57",
            "verseOrgIds": [
              "1CO.15.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "1CO 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo, baganda bange abaagalwa, mubenga banywevu era abatasagaasagana nga mweyongeranga bulijjo okukola omulimu gwa Mukama waffe, kubanga mumanyi nti okufuba kwammwe si kwa bwereere mu Mukama waffe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.15.58",
            "verseOrgIds": [
              "1CO.15.58"
            ]
          }
        }
      ]
    }
  ],
