  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1CO 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe najja gye muli abooluganda sajja gye muli na bumanyirivu mu kwogera wadde amagezi nga nangirira ekyama kya Katonda gye muli.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga nasalawo obutamanya kintu kyonna mu mmwe wabula Yesu Kristo oyo eyakomererwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nnali nammwe nnali munafu, nga ntya era nga nkankana nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era okubuulira kwange n'okuyigiriza tebyali mu bigambo bya magezi ebisendasenda, naye byali mu maanyi ne Mwoyo Mutukuvu,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okukkiriza kwammwe kuleme kuba kw'amagezi ga bantu wabula kwesigame ku maanyi ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amagezi ga Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye eri abo abakulu mu mwoyo, twogera eby'amagezi agatali ga mu mulembe guno, wadde ag'abafuzi ab'omu mulembe guno abaggwaawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.6",
            "verseOrgIds": [
              "1CO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabula twogera eby'amagezi ga Katonda, agatamanyiddwa era agakisibwa, Katonda bye yateekateeka edda n'edda olw'ekitiibwa kyaffe;",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.7",
            "verseOrgIds": [
              "1CO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tewali n'omu ku bafuzi ab'omulembe guno abaagategeera, kubanga singa baamanya tebandikomeredde Mukama ow'ekitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.8",
            "verseOrgIds": [
              "1CO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nga bwe kyawandiikibwa nti,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "\"Eriiso bye litalabangako,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "n'okutu bye kutawulirangako,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "n'omutima gw'omuntu kye gutalowoozangako",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:9"
      },
      "items": [
        {
          "text": "Katonda bye yategekera abo abamwagala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.9",
            "verseOrgIds": [
              "1CO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ffe Katonda yabitubikkulira mu Mwoyo, kubanga Omwoyo anoonyereza ebintu byonna, n'eby'omunda ennyo ebya Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.10",
            "verseOrgIds": [
              "1CO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga muntu ki ategeera eby'omuntu omulala okuggyako omwoyo w'omuntu oyo ali mu ffe? Noolwekyo n'ebintu bya Katonda tewali abimanyi okuggyako Omwoyo wa Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.11",
            "verseOrgIds": [
              "1CO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era kaakano ffe tetwafuna mwoyo wa ku nsi, wabula Omwoyo eyava eri Katonda, tulyoke tumanye ebintu Katonda bye yatuwa obuwa,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.12",
            "verseOrgIds": [
              "1CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ne mu bigambo bye twogera so si mu kuyigirizibwa okw'amagezi g'abantu, naye mu bigambo Omwoyo by'ayigiriza, ebintu eby'Omwoyo nga bikwatagana n'eby'Omwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.13",
            "verseOrgIds": [
              "1CO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu obuntu tasobola kufuna bintu bya Mwoyo wa Katonda, kubanga busirusiru gy'ali, era tasobola kubimanya, kubanga bikeberwa Mwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.14",
            "verseOrgIds": [
              "1CO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuntu ow'Omwoyo akebera ebintu byonna, naye tewali n'omu amukebera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.15",
            "verseOrgIds": [
              "1CO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubanga ani eyali ategedde okulowooza kwa Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "era ani alimulagira?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "1CO 2:16"
      },
      "items": [
        {
          "text": "Kyokka ffe tulina endowooza ya Kristo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
          }
        }
      ]
    }
  ],
