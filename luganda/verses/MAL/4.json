        "style": "s1"
      },
      "items": [
        {
          "text": "Olunaku lwa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
