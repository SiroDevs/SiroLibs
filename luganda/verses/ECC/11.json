        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bw'ogaba Katonda Akuddizaawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siganga emmere yo ng'enkuba etonnya,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:1"
      },
      "items": [
        {
          "text": "kubanga ebbanga lyayo bwe lirituuka olikungula.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gabiranga musanvu weewaawo munaana,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:2"
      },
      "items": [
        {
          "text": "kubanga mu biseera eby'oluvannyuma oyinza okubeera mu kwetaaga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebire bwe bijjula amazzi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "bitonnyesa enkuba ku nsi;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "n'omuti bwe gugwa nga gwolekedde obukiikaddyo oba obukiikakkono,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "mu kifo mwe gugwa mwe gulibeera.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo alabirira embuyaga talisiga;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:4"
      },
      "items": [
        {
          "text": "n'oyo atunuulira ebire talikungula.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga bw'otosobola kutegeera kkubo mpewo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "oba omubiri nga bwe guzimbibwa ku mwana ali mu lubuto;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "bw'otyo bw'otosobola kutegeera Katonda",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "Omutonzi wa byonna by'akola.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku makya siga ensigo zo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "n'akawungeezi toddiriza mukono gwo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "kubanga tomanyi eziryala,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "zino oba ziri,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "oba zombi ziriba nnungi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekitangaala kirungi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:7"
      },
      "items": [
        {
          "text": "era okulaba ku musana kisanyusa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale omuntu bw'awangaala emyaka emingi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "agisanyukirengamu gyonna,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "naye ajjukirenga nti waliwo ennaku ez'ekizikiza",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "nnyingi ezijja.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "Ebyo byonna ebijja butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuvubuka sanyukiranga mu buvubuka bwo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "n'omutima gwo gusanyukenga mu nnaku ez'obuvubuka bwo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "tambulira mu makubo g'omutima gwo",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "ne mu kulaba kw'amaaso go.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Naye manya nga mu byonna,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Katonda agenda kukusalira omusango.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo ggyawo okweraliikirira mu mutima",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "era weggyeko emitawaana mu ggwe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "kubanga obuvubuka n'amaanyi gaabwe butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    }
  ],
