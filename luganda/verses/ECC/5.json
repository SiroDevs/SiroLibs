{
  "id": "ECC.5",
  "number": "5",
  "bookId": "ECC",
  "reference": "Omubuulizi 5",
  "copyright": "Biblica® Bayibuli Entukuvu, Endagaano Enkadde nʼEndagaano Empya ekwatiddwa ku katambi™ Obwannannyini© 1984, 1986, 1993, 2014 bwa Biblica, Inc. Biblica® Open Luganda Contemporary Bible™ Copyright © 1984, 1986, 1993, 2014 by Biblica, Inc. \"Biblica\" Linnya ery'obwannannyini eryawandiisibwa Biblica mu Amerika era nga balina n'ekkakkalabozo, Inc. Bwaweebwa olukusa okulikozesa. \"Biblica\" is a trademark registered in the United States Patent and Trademark Office by Biblica, Inc. Used with permission.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "ECC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mutye Katonda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weekuume ng'oyingira mu nnyumba ya Katonda; okumusemberera n'okumuwuliriza, kisinga okuwaayo ssaddaaka ng'ez'abasirusiru abatamanyi nga bakola ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyanguyirizanga na kamwa ko okwogera ekigambo,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "wadde omutima gwo ogwanguyiriza,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "okwogera ekigambo mu maaso ga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "Katonda ali mu ggulu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "ng'ate ggwe oli ku nsi;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:2"
      },
      "items": [
        {
          "text": "kale ebigambo byo bibeerenga bitono.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'okutawaana ennyo bwe kuleetera omuntu ebirooto,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:3"
      },
      "items": [
        {
          "text": "n'ebigambo by'omusirusiru bwe bityo bwe biba nga bingi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe weeyamanga obweyamo eri Katonda tolwanga kubutuukiriza, kubanga tasanyukira basirusiru. Tuukirizanga obweyamo bwo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.4",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuteyama kisinga okweyama n'ototuukiriza kye weeyamye.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.5",
            "verseOrgIds": [
              "ECC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akamwa ko kaleme ku kwonoonyesa, n'ogamba oyo atumiddwa gy'oli nti, \"Nakola kisobyo okweyama.\" Kale lwaki weeretako okusunguwalirwa Katonda olw'ebigambo byo, n'azikiriza emirimu gy'emikono gyo?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.6",
            "verseOrgIds": [
              "ECC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebirooto entoko n'ebigambo ebingi temuli makulu; noolwekyo otyanga Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.7",
            "verseOrgIds": [
              "ECC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obugagga ku Bwabwo Bwokka Butaliimu Bwereere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'olabanga ng'omwavu anyigirizibwa mu ssaza, amazima n'obwenkanya nga tewali, teweewuunyanga! Kubanga omukungu waalyo alinako amusinga, ate nga bombi balina ababatwala.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bonna balya ku bibala bya nsi eyo; kabaka yennyini mu nnimiro zaayo mw'afuna.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo alulunkanira ensimbi, tasobola kuba na nsimbi zimumala;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:10"
      },
      "items": [
        {
          "text": "wadde oyo alulunkanira obugagga n'amagoba:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:10"
      },
      "items": [
        {
          "text": "na kino nakyo butaliimu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu nga bwe byeyongera obungi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:11"
      },
      "items": [
        {
          "text": "n'ababirya gye bakoma okweyongera.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:11"
      },
      "items": [
        {
          "text": "Kale nnyini byo agasibwa ki,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:11"
      },
      "items": [
        {
          "text": "okuggyako okusanyusa amaaso ge?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otulo tuwoomera omupakasi",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "ne bw'aba agabana bitono oba bingi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "Naye obugagga bw'omugagga obuyitiridde,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:12"
      },
      "items": [
        {
          "text": "tebumuganya kwebaka.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okukola n'Essanyu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waliwo ekibi ekinene kye nalaba wansi w'enjuba:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:13"
      },
      "items": [
        {
          "text": "nannyini bugagga abuterekera mu kwerumya,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebyembi bw'ebigwawo eby'obugagga ebyo bibula,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:14"
      },
      "items": [
        {
          "text": "kale bw'aba ne mutabani",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:14"
      },
      "items": [
        {
          "text": "tewabaawo mutabani we ky'asigaza.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu nga bwe yava mu lubuto lwa nnyina n'ajja mu nsi nga talina kintu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "bw'atyo bw'aliddayo nga mwereere ng'ava mu nsi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "Tewali ky'aggya mu mirimu gye,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 5:15"
      },
      "items": [
        {
          "text": "wadde kyayinza okugenda nakyo mu mukono gwe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kino kya bulumi bwereere:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 5:16"
      },
      "items": [
        {
          "text": "nga bwe yajja era bw'atyo bw'aligenda;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
