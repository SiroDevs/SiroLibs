            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli muntu alinjatulira mu maaso g'abantu, nange ndimwatulira mu maaso ga Kitange ali mu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.32",
                "verseOrgIds": [
                  "MAT.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Na buli muntu alinneegaanira mu maaso g'abantu, nange ndimwegaanira mu maaso ga Kitange ali mu ggulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.33",
                "verseOrgIds": [
                  "MAT.10.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Temulowooza nti najja okuleeta emirembe ku nsi! Sajja kuleeta mirembe wabula ekitala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.34",
                "verseOrgIds": [
                  "MAT.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga najja okwawukanya",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'omwana owoobulenzi ne kitaawe,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "n'omwana owoobuwala ne nnyina",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "n'okwawukanya muka mwana ne nnyazaala we.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
