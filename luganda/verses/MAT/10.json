  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MAT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atuma Abayigirizwa Ekkumi n'Ababiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ayita abayigirizwa be ekkumi n'ababiri, ne bajja gy'ali n'abawa obuyinza okugobanga baddayimooni, n'okuwonyanga buli ndwadde n'okukozimba ebya buli ngeri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amannya g'abayigirizwa ekkumi n'ababiri ge gano:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 10:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "Simooni, ayitibwa Peetero; ne Andereya, muganda wa Peetero;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "ne Yakobo, omwana wa Zebbedaayo; ne Yokaana, muganda wa Yakobo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Firipo; ne Battolomaayo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "ne Tomasi; ne Matayo, omusolooza w'omusolo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "ne Yakobo, omwana wa Alufaayo; ne Saddayo;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne Simooni, Omukananaayo; ne Yuda Isukalyoti, eyalya mu Yesu olukwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ekkumi n'ababiri Yesu n'abatuma ng'abalagira nti:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Temugenda eri bannamawanga wadde mu kibuga ky'Abasamaliya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.5",
                "verseOrgIds": [
                  "MAT.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye mugende eri abaana ba Isirayiri, endiga za Katonda ezaabula.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.6",
                "verseOrgIds": [
                  "MAT.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.6",
            "verseOrgIds": [
              "MAT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mugende mubabuulire nti, 'Obwakabaka obw'omu ggulu busembedde.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.7",
                "verseOrgIds": [
                  "MAT.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.7",
            "verseOrgIds": [
              "MAT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Muwonye abalwadde, muzuukize abafu, mulongoose abagenge, era mugobe ne baddayimooni. Muweereddwa buwa nammwe muwenga buwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.8",
                "verseOrgIds": [
                  "MAT.10.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Temubanga na zaabu oba ffeeza wadde ekikomo mu nkoba zammwe,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.9",
                "verseOrgIds": [
                  "MAT.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.9",
            "verseOrgIds": [
              "MAT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "wadde ensawo ey'oku mugongo, wadde essaati ebbiri, wadde omugogo gw'engatto omulala, wadde omuggo. Kubanga omukozi asaanira okuweebwa eby'okumuyamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.10",
                "verseOrgIds": [
                  "MAT.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli kibuga oba kyalo mwe mutuukanga, munoonyengamu amaka g'omuntu asaanidde, musulenga omwo okutuusa lwe mulivaayo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.11",
                "verseOrgIds": [
                  "MAT.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.11",
            "verseOrgIds": [
              "MAT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe muyingiranga mu nnyumba mubeeyanjulire, amaka ago mugalagenga okwagala kwammwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.12",
                "verseOrgIds": [
                  "MAT.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.12",
            "verseOrgIds": [
              "MAT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amaka ago bwe gabanga ag'abantu abasaanidde, emirembe gyammwe ginaabeeranga ku bo, naye bwe gatabanga bwe gatyo emirembe gyammwe ginaabaddiranga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.13",
                "verseOrgIds": [
                  "MAT.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.13",
            "verseOrgIds": [
              "MAT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli atabasembezenga wadde okuwuliriza ebigambo byammwe, bwe mubanga muva mu kibuga ekyo oba mu nnyumba eyo, mukunkumulanga enfuufu",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.14",
                "verseOrgIds": [
                  "MAT.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ey'oku bigere byammwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.14",
                "verseOrgIds": [
                  "MAT.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti ensi ya Sodomu ne Ggomola ziriweebwa ekibonerezo ku lunaku olw'okusalirako omusango ekirigumiikirizika okukira ekibuga ekyo oba amaka ago.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.15",
                "verseOrgIds": [
                  "MAT.10.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Laba mbatuma ng'endiga mu misege. Noolwekyo mubeere bagezigezi ng'emisota, era abataliiko kya kunenyezebwa ng'amayiba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.16",
                "verseOrgIds": [
                  "MAT.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mwekuume abantu! Kubanga balibawaayo eri enkiiko z'Abakadde, ne mu makuŋŋaaniro gaabwe, ne babakuba emigo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.17",
                "verseOrgIds": [
                  "MAT.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulitwalibwa mu maaso ga bagavana ne bakabaka ku lwange, okuba abajulirwa eri bo n'abannaggwanga.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.18",
                "verseOrgIds": [
                  "MAT.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe muweebwangayo, temweraliikiriranga kye munaawoza, kubanga kinaabaweebwanga mu kiseera ekyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.19",
                "verseOrgIds": [
                  "MAT.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga si mmwe mugenda okwogera wabula Omwoyo wa Kitammwe y'alyogerera mu mmwe!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.20",
                "verseOrgIds": [
                  "MAT.10.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Owooluganda aliwaayo muganda we okuttibwa era n'abazadde baliwaayo abaana baabwe okuttibwa. Abaana nabo balyefuukira bazadde baabwe ne babatta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.21",
                "verseOrgIds": [
                  "MAT.10.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulikyayibwa abantu bonna olw'erinnya lyange. Naye oyo aligumiikiriza okutuuka ku nkomerero alirokolebwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.22",
                "verseOrgIds": [
                  "MAT.10.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe babayigganyanga mu kibuga ekimu muddukirenga mu kirala! Ddala ddala mbagamba nti muliba temunnabuna bibuga bya Isirayiri, Omwana w'Omuntu n'ajja.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.23",
                "verseOrgIds": [
                  "MAT.10.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Omuyigirizwa tasinga amusomesa, so n'omuddu tasinga mukama we.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.24",
                "verseOrgIds": [
                  "MAT.10.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kirungi omuyigirizwa okuba ng'omusomesa we, n'omuddu okuba nga mukama we. Obanga nnannyinimu ayitibwa Beeruzebuli, tekisingawo nnyo ku b'omu nju ye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.25",
                "verseOrgIds": [
                  "MAT.10.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Noolwekyo temubatyanga. Teri kyakisibwa ekitalimanyibwa, era tewali kyakwekebwa ekitalizuulibwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.26",
                "verseOrgIds": [
                  "MAT.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Buli kye mbabuulira mu kizikiza mukyogereranga mu musana, na buli kye mbagamba mu kaama, nakyo mukyasanguzanga waggulu ku nnyumba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.27",
                "verseOrgIds": [
                  "MAT.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era temubatyanga abo abatta omubiri kubanga tebasobola kutta mwoyo! Naye mutyenga oyo yekka, ayinza okuzikiriza byombi omwoyo n'omubiri mu ggeyeena.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.28",
                "verseOrgIds": [
                  "MAT.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enkazaluggya ebbiri tezigula sente emu? Naye tewali n'emu ku zo eyinza okuttibwa nga Kitammwe tamanyi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.29",
                "verseOrgIds": [
                  "MAT.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era buli luviiri oluli ku mitwe gyammwe lwabalibwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.30",
                "verseOrgIds": [
                  "MAT.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.30",
            "verseOrgIds": [
              "MAT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kale temweraliikiriranga kubanga mmwe muli ba muwendo munene eri Kitammwe okusinga enkazaluggya ennyingi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.31",
                "verseOrgIds": [
                  "MAT.10.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
