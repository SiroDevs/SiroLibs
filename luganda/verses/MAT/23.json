        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mmwe emisota! Abaana b'embalasaasa muliwona mutya omusango ogugenda okubatwaza mu ggeyeena?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.33",
                "verseOrgIds": [
                  "MAT.23.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.33",
            "verseOrgIds": [
              "MAT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kyenva mbaweereza bannabbi, n'abasajja ab'amagezi, n'abawandiisi, abamu mulibatta nga mubakomerera ku musaalaba, n'abalala mulibakuba embooko mu makuŋŋaaniro gammwe, ne mubagobaganya mu bibuga byammwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.34",
                "verseOrgIds": [
                  "MAT.23.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.34",
            "verseOrgIds": [
              "MAT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe mutyo omusango gw'okutemula abatuukirivu, okutandikira ku Aberi omutuukirivu okutuuka ku Zaakaliya, mutabani wa Balakiya gwe mwattira wakati wa yeekaalu n'ekyoto, ne gubasingira ddala.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.35",
                "verseOrgIds": [
                  "MAT.23.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.35",
            "verseOrgIds": [
              "MAT.23.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ddala ddala mbagamba nti ebyo byonna birituuka ku mulembe guno.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.36",
                "verseOrgIds": [
                  "MAT.23.36"
                ]
              }
            }
          ]
        }
