          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Laba kaakano ennyumba yo esigalidde awo, kifulukwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.38",
                "verseOrgIds": [
                  "MAT.23.38"
                ]
              }
            }
          ]
