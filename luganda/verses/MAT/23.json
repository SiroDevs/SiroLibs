            "verseOrgIds": [
              "MAT.23.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 23:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kubanga nkugamba nti toliddayo kundaba nate, okutuusa ng'oyogedde nti, 'Aweereddwa omukisa oyo ajja mu linnya lya Mukama.' \"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.39",
