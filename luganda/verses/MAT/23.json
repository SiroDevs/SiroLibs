  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "MAT 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Yesu n'ayogera eri ebibiina n'abayigirizwa be ng'agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.1",
            "verseOrgIds": [
              "MAT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Abawandiisi n'Abafalisaayo batudde ku ntebe ya Musa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.2",
                "verseOrgIds": [
                  "MAT.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.2",
            "verseOrgIds": [
              "MAT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Noolwekyo mukole era mwekuume buli kye babagamba wabula temugoberera bikolwa byabwe. Kubanga boogera naye ne batakola bye bagamba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.3",
                "verseOrgIds": [
                  "MAT.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.3",
            "verseOrgIds": [
              "MAT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Basiba emigugu emizito ne bagitikka abalala, so nga bo n'okugezaako tebagezaako kukwatako n'engalo yaabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.4",
                "verseOrgIds": [
                  "MAT.23.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Buli kye bakola bakikola abantu babalabe. Bambala ku mikono gyabwe obusawo",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "omuli ennyiriri eziva mu Byawandiikibwa, ne bawanvuya amatanvuuwa ku byambalo byabwe, agajjukiza abagambala okudda eri Mukama, nga babikola okulaga ababalaba.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.5",
                "verseOrgIds": [
                  "MAT.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.5",
            "verseOrgIds": [
              "MAT.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Baagala nnyo ebifo eby'oku mwanjo ku mbaga, ne mu bifo eby'ekitiibwa mu makuŋŋaaniro.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.6",
                "verseOrgIds": [
                  "MAT.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.6",
            "verseOrgIds": [
              "MAT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Banyumirwa nnyo okuweebwa ekitiibwa mu butale n'okuyitibwa 'Labbi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.7",
                "verseOrgIds": [
                  "MAT.23.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Temweyitanga 'Labbi",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.8",
                "verseOrgIds": [
                  "MAT.23.8"
                ]
              }
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": ",' kubanga Katonda yekka ye Muyigiriza wammwe, naye mmwe muli baaluganda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.8",
                "verseOrgIds": [
                  "MAT.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.8",
            "verseOrgIds": [
              "MAT.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era temuyitanga muntu yenna ku nsi 'Kitammwe,' kubanga Katonda ali mu ggulu ye yekka gwe muteekwa okuyita bwe mutyo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.9",
                "verseOrgIds": [
                  "MAT.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.9",
            "verseOrgIds": [
              "MAT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era temuganyanga muntu yenna kubayita 'bayigiriza,' kubanga omuyigiriza wammwe ali omu yekka, ye Kristo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.10",
                "verseOrgIds": [
                  "MAT.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.10",
            "verseOrgIds": [
              "MAT.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Oyo ayagala abantu okumussaamu ekitiibwa. Asaana abeere muweereza waabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.11",
                "verseOrgIds": [
                  "MAT.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.11",
            "verseOrgIds": [
              "MAT.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Naye buli alyegulumiza alikkakkanyizibwa, na buli alyetoowaza aligulumizibwa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.12",
                "verseOrgIds": [
                  "MAT.23.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze mmwe Abawandiisi, nammwe Abafalisaayo. Bannanfuusi mmwe! Muziyiza abantu abalala okuyingira mu bwakabaka obw'omu ggulu, ate nammwe ne mutayingira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.13",
                "verseOrgIds": [
                  "MAT.23.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bannanfuusi mmwe Abawandiisi nammwe Abafalisaayo! Mulowoozesa abantu nti muli batuukirivu nga musaba essaala, so ng'ate mwekyusa ne mugobaganya bannamwandu mu mayumba gaabwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.14",
                "verseOrgIds": [
                  "MAT.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.14",
            "verseOrgIds": [
              "MAT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zibasanze bannanfuusi mmwe Abawandiisi nammwe Abafalisaayo! Kubanga mutambula okwetooloola ennyanja ne ku lukalu musobole okukyusa omuntu, naye bw'akyuka, mumufuula mwana wa ggeyeena okusingawo emirundi ebiri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.15",
                "verseOrgIds": [
                  "MAT.23.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze mmwe abakulembeze abazibe b'amaaso abagamba nti, 'Okulayira Yeekaalu, si nsonga, naye oyo alayira zaabu ali mu Yeekaalu, asaana okukituukiriza!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.16",
                "verseOrgIds": [
                  "MAT.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.16",
            "verseOrgIds": [
              "MAT.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe abatalina magezi abazibe b'amaaso! Ku ebyo byombi kiruwa ekisingako obukulu, zaabu oba Yeekaalu efuula zaabu okuba entukuvu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.17",
                "verseOrgIds": [
                  "MAT.23.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.17",
            "verseOrgIds": [
              "MAT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ate mugamba nti, 'Omuntu okulayira ekyoto, kirina amakulu, naye bw'alayira ebirabo ebireeteddwa ku kyoto, asaana okukituukiriza!'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.18",
                "verseOrgIds": [
                  "MAT.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.18",
            "verseOrgIds": [
              "MAT.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe abazibe b'amaaso, ku byombi kiruwa ekisinga kinnaakyo obukulu, ekirabo ekiri ku kyoto oba ekyoto kyennyini ekifuula ekirabo ekyo okuba ekitukuvu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.19",
                "verseOrgIds": [
                  "MAT.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.19",
            "verseOrgIds": [
              "MAT.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe mulayira ekyoto, muba mulayira ekyoto n'ebikiriko byonna,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.20",
                "verseOrgIds": [
                  "MAT.23.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.20",
            "verseOrgIds": [
              "MAT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "era bwe mulayira Yeekaalu muba mulayira Yeekaalu ne Katonda agibeeramu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.21",
                "verseOrgIds": [
                  "MAT.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.21",
            "verseOrgIds": [
              "MAT.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Era bwe mulayira eggulu, muba mulayira n'entebe ya Katonda ey'obwakabaka n'oyo yennyini agituulako.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.22",
                "verseOrgIds": [
                  "MAT.23.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze, mmwe Abawandiisi, nammwe Abafalisaayo! Bannanfuusi mmwe! Kubanga muwaayo ekimu eky'ekkumi ku buli kintu, ne ku buli kika kya muddo oguwunyisa obulungi era oguwoomesa enva, okutuukira ddala ne ku kalagala akasinga obutono, naye ne mulagajjalira ebintu ebisinga obukulu eby'amateeka, ng'obwenkanya, n'okusaasira n'okukkiriza. Weewaawo musaanidde okuwaayo ekitundu eky'ekkumi, naye ebintu ebirala ebisinga obukulu temusaanidde kubiragajjalira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.23",
                "verseOrgIds": [
                  "MAT.23.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.23",
            "verseOrgIds": [
              "MAT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe abakulembeze abazibe b'amaaso! Musengejja akabu muleme kukanywera mu mazzi, naye ne munyweramu eŋŋamira!",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.24",
                "verseOrgIds": [
                  "MAT.23.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze mmwe Abawandiisi nammwe Abafalisaayo! Bannanfuusi mmwe! Muzigula kungulu kw'ekikopo ne kungulu kw'ebbakuli, naye nga munda mujjudde omululu n'okwefaako mwekka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.25",
                "verseOrgIds": [
                  "MAT.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.25",
            "verseOrgIds": [
              "MAT.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmwe Abafalisaayo abazibe b'amaaso! Musooke mulongoose munda w'ekikopo olwo nno mulongoose ne kungulu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.26",
                "verseOrgIds": [
                  "MAT.23.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze mmwe Abawandiisi nammwe Abafalisaayo! Mulabika ng'amalaalo agatemagana kungulu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "songa munda gajjudde amagumba g'abafu n'obuvundu obwa buli ngeri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.27",
                "verseOrgIds": [
                  "MAT.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.27",
            "verseOrgIds": [
              "MAT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulabika ng'abantu abatuukirivu kungulu, songa munda mujjudde obunnanfuusi n'obumenyi bw'amateeka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.28",
                "verseOrgIds": [
                  "MAT.23.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zibasanze mmwe Abawandiisi nammwe Abafalisaayo! Bannanfuusi mmwe! Kubanga muzimbira bannabbi ebijjukizo, ne mutimba ebijjukizo, by'abatuukirivu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.29",
                "verseOrgIds": [
                  "MAT.23.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.29",
            "verseOrgIds": [
              "MAT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ne mulyoka mugamba nti, 'Naye ddala singa twaliwo mu biseera bya bajjajjaffe tetwandisizza kimu nabo mu kuyiwa omusaayi gw'abannabbi.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.30",
                "verseOrgIds": [
                  "MAT.23.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.30",
            "verseOrgIds": [
              "MAT.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Bwe mwogera mutyo muba mwessaako omusango nga bwe muli abaana b'abo abatta bannabbi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.31",
                "verseOrgIds": [
                  "MAT.23.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.23.31",
            "verseOrgIds": [
              "MAT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mugenda nga mutuukiriza ebyo bajjajjammwe bye bataamaliriza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.23.32",
                "verseOrgIds": [
                  "MAT.23.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 23:33"
