    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 1:4"
      },
      "items": [
        {
          "text": "Nasoni n'azaala Salumooni.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.4",
            "verseOrgIds": [
              "MAT.1.4"
            ]
          }
        }
      ]
    },
    {
