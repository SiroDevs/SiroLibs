    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okubonerezebwa kwa Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tosanyuka ggwe Isirayiri;",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "tojaguza ng'amawanga amalala,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "kubanga tobadde mwesigwa eri Katonda wo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "weegomba empeera eya malaaya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:1"
      },
      "items": [
        {
          "text": "ku buli gguuliro.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.1",
            "verseOrgIds": [
              "HOS.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egguuliro n'essogolero tebiribaliisa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:2"
      },
      "items": [
        {
          "text": "ne wayini omusu alibaggwaako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.2",
            "verseOrgIds": [
              "HOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebalisigala mu nsi ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.3",
                "verseOrgIds": [
                  "HOS.9.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "Efulayimu aliddayo e Misiri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:3"
      },
      "items": [
        {
          "text": "n'alya emmere etali nnongoofu mu Bwasuli.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.3",
            "verseOrgIds": [
              "HOS.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tebaliwaayo biweebwayo ebya wayini eri",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.4",
                "verseOrgIds": [
                  "HOS.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "so ne ssaddaaka zaabwe tezirimusanyusa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Ssaddaaka zaabwe ziriba ng'emmere ey'abakungubazi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "ne bonna abaliziryako balifuuka abatali balongoofu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "Emmere eyo eriba yaabwe bo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:4"
      },
      "items": [
        {
          "text": "so teriyingizibwa mu yeekaalu ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.4",
                "verseOrgIds": [
                  "HOS.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.4",
            "verseOrgIds": [
              "HOS.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiki ky'olikola ku lunaku olw'embaga ezaalondebwa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:5"
      },
      "items": [
        {
          "text": "ku lunaku olw'embaga ya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "HOS.9.5",
                "verseOrgIds": [
                  "HOS.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.5",
            "verseOrgIds": [
              "HOS.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bwe baliwona okuzikirira,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Misiri alibakuŋŋaanya,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "ne Menfisi alibaziika.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "Eby'obugagga byabwe ebya ffeeza birizika,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:6"
      },
      "items": [
        {
          "text": "n'eweema zaabwe zirimeramu amaggwa.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.6",
            "verseOrgIds": [
              "HOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ennaku ez'okubonerezebwa zijja,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "ennaku ez'okusasulirwamu ziri kumpi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Ekyo Isirayiri akimanye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "Olw'ebibi byammwe okuba ebingi ennyo,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "n'obukambwe bwammwe obungi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "nnabbi ayitibwa musirusiru,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:7"
      },
      "items": [
        {
          "text": "n'oyo eyabikkulirwa mumuyita mugu wa ddalu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.7",
            "verseOrgIds": [
              "HOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnabbi awamu ne Katonda wange",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "ye mukuumi wa Efulayimu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "newaakubadde nga waliwo emitego mu kkubo lye,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:8"
      },
      "items": [
        {
          "text": "n'obukambwe mu nnyumba ya Katonda we.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.8",
            "verseOrgIds": [
              "HOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boonoonye nnyo nnyini",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "nga mu nnaku ez'e Gibea.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 9:9"
      },
      "items": [
        {
          "text": "Katonda alijjukira obutali butuukirivu bwabwe,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.9",
            "verseOrgIds": [
              "HOS.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 9:9"
      },
      "items": [
