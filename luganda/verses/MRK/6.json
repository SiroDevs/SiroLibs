        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Awonya Abalwadde e Genesaleeti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "MRK 6:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo eryato lyabwe bwe lyagoba ku lubalama lw'ennyanja Genesaleeti,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.53",
            "verseOrgIds": [
              "MRK.6.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "MRK 6:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne bavaamu. Abantu bwe balaba Yesu, amangwago ne bamutegeererawo.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.54",
            "verseOrgIds": [
              "MRK.6.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "MRK 6:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne babuna mu bitundu ebyali biriraanyeewo nga bamuleetera abalwadde nga basituliddwa ku butanda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.55",
            "verseOrgIds": [
              "MRK.6.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "MRK 6:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wonna wonna gye yagendanga, mu byalo, mu bibuga, mu butale ne ku nguudo ne baleeta abalwadde ne bamwegayirira waakiri bakwateko bukwasi ku lukugiro lw'ekyambalo kye. Era bonna abaakikwatako ne bawona.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.6.56",
            "verseOrgIds": [
              "MRK.6.56"
            ]
          }
        }
      ]
    }
