  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ISA 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ettabi Eririva ku Yese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensibuka erimera ng'eva ku kikonge kya Yese,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:1"
      },
      "items": [
        {
          "text": "ne ku mirandira kulivaako omuti, ne ku muti kulivaako Ettabi eriribala ekibala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.1",
            "verseOrgIds": [
              "ISA.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwoyo wa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.2",
                "verseOrgIds": [
                  "ISA.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "alibeera ku ye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "Mwoyo ow'amagezi n'okutegeera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "ne Mwoyo w'okusala ensonga, n'ow'amaanyi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:2"
      },
      "items": [
        {
          "text": "ne Mwoyo w'okumanya era n'okutya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.2",
                "verseOrgIds": [
                  "ISA.11.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.2",
            "verseOrgIds": [
              "ISA.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era n'essanyu lye liribeera mu kutya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.3",
                "verseOrgIds": [
                  "ISA.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ISA 11:3"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "Taasalenga misango ng'asinziira ku maaso ge gokka nga bwe galaba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:3"
      },
      "items": [
        {
          "text": "oba okusalawo ng'asinziira ku byawulira n'amatu ge byokka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.3",
            "verseOrgIds": [
              "ISA.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye anaasaliranga abaavu emisango mu bwenkanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "era asalire mu bwenkanya abo abawombeefu ab'omu nsi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "era alikuba ensi n'omuggo ogw'omu kamwa ke,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:4"
      },
      "items": [
        {
          "text": "era alitta omukozi w'ebibi n'omukka ogw'omu kamwa ke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.4",
            "verseOrgIds": [
              "ISA.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obutuukirivu, bwe buliba olukoba lwe yeesibya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:5"
      },
      "items": [
        {
          "text": "n'obwesigwa, bw'alyesiba mu kiwato kye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.5",
            "verseOrgIds": [
              "ISA.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusege gulisulanga wamu n'omwana gw'endiga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "n'engo egalamire wamu n'omwana gw'embuzi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "era ennyana n'empologoma n'ennyana eya ssava binaagalamiranga wamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:6"
      },
      "items": [
        {
          "text": "era omwana omuto yalizirabirira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.6",
            "verseOrgIds": [
              "ISA.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ente n'eddubu biririira wamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "abaana baazo banaagalamiranga wamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:7"
      },
      "items": [
        {
          "text": "Empologoma erirya omuddo ng'ente.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.7",
            "verseOrgIds": [
              "ISA.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "N'omwana ayonka alizannyira ku kinnya ky'enswera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:8"
      },
      "items": [
        {
          "text": "n'omwana omuto aliteeka omukono gwe mu kinnya ky'essalambwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.8",
            "verseOrgIds": [
              "ISA.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewalibeera kukolaganako bulabe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "wadde okuttiŋŋana ku lusozi lwange olutukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "Kubanga ensi eribeera ejjudde okumanya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.11.9",
                "verseOrgIds": [
                  "ISA.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:9"
      },
      "items": [
        {
          "text": "ng'amazzi bwe gajjuza ennyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.9",
            "verseOrgIds": [
              "ISA.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ku lunaku luli, muzzukulu wa Yese aliyimirira ng'ebendera eri amawanga. Oyo amawanga gwe ganaanoonyanga, n'ekifo kye eky'okuwummuliramu, kiribeera kya kitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku lunaku olwo Mukama aligolola omukono gwe omulundi ogwokubiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "text": "okununula abasigalawo ku bantu be, okubaggya mu Bwasuli ne mu Misiri ne mu Pasuloosi ne mu Kuusi ne mu Eramu ne mu Sinaali ne mu Kamasi ne mu bizinga eby'omu nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era aliwanikira amawanga bbendera, akuŋŋaanye abawaŋŋanguse ba Isirayiri;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:12"
      },
      "items": [
        {
          "text": "aleete wamu abantu ba Yuda abaali basaasaanye mu nsonda ennya ez'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwo obuggya bwa Efulayimu bulyoke buggweewo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 11:13"
      },
      "items": [
        {
