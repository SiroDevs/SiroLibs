        "sid": "ISA 57"
      },
      "items": [
        {
          "text": "57",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 57:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abatuukirivu bazikirira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "naye tewali akirowoozako n'akatono.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "Abantu abeewaddeyo eri Katonda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "batwalibwa nga tewali n'afuddeyo kukirowoozaako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "Kubanga omutuukirivu aggyibwawo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:1"
      },
      "items": [
        {
          "text": "olw'akabi akagenda okujja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.1",
            "verseOrgIds": [
              "ISA.57.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 57:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayingira mu mirembe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "n'afuna okuwummulira mu kufa kwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:2"
      },
      "items": [
        {
          "text": "ne bawummula ga beebase, abo abatambulira mu bugolokofu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.2",
            "verseOrgIds": [
              "ISA.57.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 57:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye mmwe mujje musembere wano batabani b'omukazi omufumu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:3"
      },
      "items": [
        {
          "text": "ezzadde ly'omwenzi omukazi eyeetunda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.3",
            "verseOrgIds": [
              "ISA.57.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 57:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzannyira ku ani?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Ani gwe mukongoola",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "ne mumusoomooza?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "Temuli baana ba bujeemu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:4"
      },
      "items": [
        {
          "text": "ezzadde eryobulimba?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.4",
            "verseOrgIds": [
              "ISA.57.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 57:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka ne mwegombera wansi w'emiti",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "na buli wansi wa buli muti oguyimiridde;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "mmwe abasaddaaka abaana bammwe mu biwonvu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:5"
      },
      "items": [
        {
          "text": "ne wansi w'enjatika z'enjazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.5",
            "verseOrgIds": [
              "ISA.57.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 57:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakatonda bo ge mayinja amaweweevu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        },
        {
          "text": "gosinziza mu biwonvu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "abo be babo, obusika bwo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "abo b'ofukira ekiweebwayo ekyokunywa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "era n'ebiweebwayo eby'empeke.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:6"
      },
      "items": [
        {
          "text": "Nga weemalidde mu kukola bino byonna, olowooza nnyinza okusanyuka?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.6",
            "verseOrgIds": [
              "ISA.57.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 57:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwambuka ku ntikko z'ensozi okwenda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:7"
      },
      "items": [
        {
          "text": "nga mugenze okuwaayo ssaddaaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.7",
            "verseOrgIds": [
              "ISA.57.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 57:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emabega w'enzigi zammwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "we muteeka ebibumbe eby'obuwemu bye musinza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "Mwandeka ne mukola eby'obuwemu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "mu bitanda byammwe ebigazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "Eyo gye mweyambulira ne mukola endagaano",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:8"
      },
      "items": [
        {
          "text": "n'abo be mwagala be muleeta mu bitanda byammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.8",
            "verseOrgIds": [
              "ISA.57.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 57:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne weekuba kalifuuwa omuyitirivu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "ng'ogenda okutwala amafuta ag'omuzeeyituuni ewa Moleki katonda wo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "n'otuma ababaka bo ewala ennyo banoonye bakatonda,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:9"
      },
      "items": [
        {
          "text": "kumpi batuuke n'emagombe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.9",
            "verseOrgIds": [
              "ISA.57.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 57:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakubo go gonna gakuteganya ne gakukooya nnyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "naye teweegamba nako nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "'Nteganira ki atalina kyeŋŋanyurwa?'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 57:10"
      },
      "items": [
        {
          "text": "Singa tewanoonya bikuzaamu maanyi, wandizirise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.10",
            "verseOrgIds": [
              "ISA.57.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 57:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"B'ani abo be watya n'otekemuka n'obawuliriza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.11",
            "verseOrgIds": [
