            "number": "1",
            "style": "v",
            "sid": "ISA 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunnabbi obukwata ku Tuulo:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Mukube ebiwoobe, mmwe ebyombo by'e Talusiisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "kubanga Tuulo kizikirizibbwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "ne mutasigala nnyumba newaakubadde ebyombo we biyinza okugobera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "Ekigambo kyababikulirwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:1"
      },
      "items": [
        {
          "text": "okuva mu nsi ya Kittimu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musirike mmwe ab'oku kizinga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "nammwe abasuubuzi b'e Sidoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:2"
      },
      "items": [
        {
          "text": "abagaggawalidde ku nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku nnyanja ennene",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "kwajjirako ensigo za Sikoli,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "n'ebyamakungula bya Kiyira bye byali amagoba ga Tuulo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:3"
      },
      "items": [
        {
          "text": "era yafuuka akatale k'amawanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwatibwe ensonyi ggwe Sidoni naawe ggwe ekigo ky'ennyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "kubanga ennyanja eyogedde nti:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "\"Sirumwangako kuzaala wadde okuzaalako.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:4"
      },
      "items": [
        {
          "text": "Sirabiriranga baana babulenzi newaakubadde okukuza abaana aboobuwala.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo bwe kirijja eri Misiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:5"
      },
      "items": [
        {
          "text": "balinakuwalira ebigambo ebiva e Tuulo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwunguke mugende e Talusiisi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:6"
      },
      "items": [
        {
          "text": "mukube ebiwoobe mmwe abantu ab'oku kizinga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kino kye kibuga kyammwe eky'amasanyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "ekibuga ekikadde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "ekyagenda okusenga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:7"
      },
      "items": [
        {
          "text": "mu nsi eyeewala?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ani eyateekateeka kino okutuuka ku Tuulo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "Tuulo ekitikkira engule,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "ekibuga ekirina abasuubuzi abalangira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:8"
      },
      "items": [
        {
          "text": "ekirina abasuubuzi abamanyifu mu nsi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.9",
                "verseOrgIds": [
                  "ISA.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye yakiteekateeka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "amuggyemu amalala n'ekitiibwa kyonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:9"
      },
      "items": [
        {
          "text": "akkakkanye n'abo bonna abamanyifu ku nsi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bw'otambula ku lukalu lwonna olw'omugga Kiyira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:10"
      },
      "items": [
        {
          "text": "tokyalina kifo ebyombo we bituukira ggwe muwala wa Talusiisi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.23.11",
                "verseOrgIds": [
                  "ISA.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda agolodde omukono gwe eri ennyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "n'akankanya obwakabaka bwayo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "Awadde ekiragiro ekikwata ku Kanani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 23:11"
      },
      "items": [
        {
          "text": "nti ebigo byakyo birizikirizibwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayogera nti, \"Tokyaddayo kukola bya masanyu nate,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
