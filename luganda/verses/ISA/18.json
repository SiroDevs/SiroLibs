      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:5"
      },
      "items": [
        {
          "text": "okumulisa nga kuwedde, n'ekimuli nga kifuuka zabbibu eyengedde,",
