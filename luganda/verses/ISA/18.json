      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "n'ensolo ez'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 18:6"
      },
      "items": [
        {
          "text": "Era ennyonyi ezirya ebiramu zirye okwo mu biseera by'ekyeya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
