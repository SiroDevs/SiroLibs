      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "bw'atyo Katonda bwalikusanyukira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
      ]
