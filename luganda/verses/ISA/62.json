      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:5"
      },
      "items": [
        {
          "text": "Nga omugole omusajja bwasanyukira oyo gw'awasizza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
