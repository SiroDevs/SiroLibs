          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.62.3",
                "verseOrgIds": [
                  "ISA.62.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.3",
            "verseOrgIds": [
              "ISA.62.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:3"
      },
      "items": [
        {
          "text": "enkuufiira y'obwakabaka mu mukono gwa Katonda wo.",
