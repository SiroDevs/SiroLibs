            "number": "1",
            "style": "v",
            "sid": "ISA 62:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lwa Sayuuni ssiisirike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "era ku lwa Yerusaalemi ssiiwummule,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "okutuusa nga obutuukirivu bwe butemagana ng'emmambya esala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:1"
      },
      "items": [
        {
          "text": "obulokozi bwe ng'ettaala eyaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 62:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga galiraba obutuukirivu bwo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "era ne bakabaka bonna baliraba ekitiibwa kyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.2",
            "verseOrgIds": [
              "ISA.62.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 62:2"
      },
      "items": [
        {
          "text": "Oliyitibwa erinnya epya",
