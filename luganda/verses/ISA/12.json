    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwebaza",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "olw'Obulokozi bwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo oligamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "\"Nnaakwebazanga ayi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.1",
                "verseOrgIds": [
                  "ISA.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "newaakubadde nga wansunguwalira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:1"
      },
      "items": [
        {
          "text": "obusungu bwo bwaggwaawo era onzizizzaamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.1",
            "verseOrgIds": [
              "ISA.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba Katonda bwe bulokozi bwange;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "nzija kumwesiga era siritya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "kubanga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.2",
                "verseOrgIds": [
                  "ISA.12.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ge maanyi gange era lwe luyimba lwange,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:2"
      },
      "items": [
        {
          "text": "era afuuse obulokozi bwange.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.2",
            "verseOrgIds": [
              "ISA.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaasenanga n'essanyu amazzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:3"
      },
      "items": [
        {
          "text": "okuva mu nzizi ez'obulokozi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.3",
            "verseOrgIds": [
              "ISA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ku lunaku olwo mulyogera nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "\"Mwebaze",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.4",
                "verseOrgIds": [
                  "ISA.12.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, mukoowoole erinnya lye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "mubuulire ebikolwa bye mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:4"
      },
      "items": [
        {
          "text": "mwogere nti erinnya lye ligulumizibwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.4",
            "verseOrgIds": [
              "ISA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyimbire",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.12.5",
                "verseOrgIds": [
                  "ISA.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ettendo kubanga akoze eby'ettendo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:5"
      },
      "items": [
        {
          "text": "muleke kino kimanyibwe mu mawanga gonna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.5",
            "verseOrgIds": [
              "ISA.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leekaana n'eddoboozi ery'omwanguka oyimbe n'essanyu ggwe omuntu w'omu Sayuuni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 12:6"
      },
      "items": [
        {
          "text": "kubanga Omutukuvu wa Isirayiri ali wakati mu ggwe mukulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.12.6",
            "verseOrgIds": [
              "ISA.12.6"
            ]
          }
        }
      ]
    }
  ],
