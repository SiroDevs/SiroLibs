  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ISA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omulokozi Atuzaaliddwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye tewaliba kizikiza eri oyo eyali mu kubonaabona. Edda yatoowaza ensi ya Zebbulooni n'ensi ya Nafutaali, naye mu kiseera ekijja aliwa Ggaliraaya ekitiibwa, ensi ey'abamawanga emitala wa Yoludaani, awali ekkubo erigenda ku nnyanja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.1",
            "verseOrgIds": [
              "ISA.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu abaatambuliranga mu kizikiza",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "balabye ekitangaala eky'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "abo abaatuulanga mu nsi ey'ekizikiza ekingi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:2"
      },
      "items": [
        {
          "text": "omusana gubaakidde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.2",
            "verseOrgIds": [
              "ISA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyazizza eggwanga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "obongedde essanyu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "basanyukira mu maaso go ng'abantu bwe basanyuka mu biseera eby'amakungula,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:3"
      },
      "items": [
        {
          "text": "ng'abasajja bwe basanyuka nga bagabana omunyago.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.3",
            "verseOrgIds": [
              "ISA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nga ku lunaku Abamidiyaani lwe baawangulwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "omenye ekikoligo ekyamuzitoowereranga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "n'ekiti eky'oku kibegabega kye,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:4"
      },
      "items": [
        {
          "text": "n'oluga lw'oyo amunyigiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.4",
            "verseOrgIds": [
              "ISA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga buli ngatto ya mulwanyi ekozesebwa mu lutalo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "na buli kyambalo ekibunye omusaayi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "biriba bya kwokebwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:5"
      },
      "items": [
        {
          "text": "bye birikozesebwa okukoleeza omuliro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.5",
            "verseOrgIds": [
              "ISA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga omwana atuzaaliddwa ffe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "omwana owoobulenzi atuweereddwa ffe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "n'okufuga kunaabanga ku bibegabega bye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "N'erinnya lye aliyitibwa nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Wa kitalo, Omuwi w'amagezi, Katonda Ayinzabyonna,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:6"
      },
      "items": [
        {
          "text": "Kitaffe ow'Emirembe Gyonna, Omulangira w'Emirembe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.6",
            "verseOrgIds": [
              "ISA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okufuga kwe n'emirembe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "biryeyongeranga obutakoma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "Alifugira ku ntebe ya Dawudi ne ku bwakabaka bwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "n'okubuwanirira n'obwenkanya n'obutuukirivu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "okuva leero okutuusa emirembe gyonna.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "Obumalirivu bwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.9.7",
                "verseOrgIds": [
                  "ISA.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:7"
      },
      "items": [
        {
          "text": "bulikituukiriza ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.7",
            "verseOrgIds": [
              "ISA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusungu bwa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Isirayiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama yaweereza obubaka obukwata ku Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:8"
      },
      "items": [
        {
          "text": "ku birituuka ku Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.8",
            "verseOrgIds": [
              "ISA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era abantu bonna balibumanya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "Efulayimu n'abantu b'omu Samaliya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "aboogera n'amalala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:9"
      },
      "items": [
        {
          "text": "n'omutima omukakanyavu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.9",
            "verseOrgIds": [
              "ISA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nti, \"Amatoffaali gagudde wansi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:10"
      },
      "items": [
        {
          "text": "naye tulizimbya amayinja amateme,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 9:10"
      },
      "items": [
        {
          "text": "emisukamooli gitemeddwawo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 9:10"
      },
      "items": [
        {
          "text": "naye tulizzaawo emivule.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.9.10",
            "verseOrgIds": [
              "ISA.9.9"
            ]
          }
        }
      ]
    },
    {
