                "verseId": "ISA.22.25",
                "verseOrgIds": [
                  "ISA.22.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ayogedde.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        }
