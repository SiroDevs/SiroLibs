      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obunnabbi Obufa ku Yerusaalemi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunnabbi obukwata ku Kiwonvu ky'Okwolesebwa:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "Kiki ekikutawanya kaakano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:1"
      },
      "items": [
        {
          "text": "n'okulinnya n'olinnya waggulu ku busolya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.1",
            "verseOrgIds": [
              "ISA.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ggwe ekibuga ekijjudde oluyoogaano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "ggwe ekibuga eky'amasanyu era eky'ebinyumu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "Abantu bo abattibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:2"
      },
      "items": [
        {
          "text": "tebaafa kitala newaakubadde okufiira mu lutalo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.2",
            "verseOrgIds": [
              "ISA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakulembeze bo bonna baddukidde wamu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "bawambiddwa awatali kulwana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "Bonna baakwatibwa ne batwalibwa wamu nga basibe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:3"
      },
      "items": [
        {
          "text": "kubanga badduka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.3",
            "verseOrgIds": [
              "ISA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyenava njogera nti, \"Munveeko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "mundeke nkaabire ddala nnyo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "Temugezaako kunsaasira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:4"
      },
      "items": [
        {
          "text": "olw'okuzikirizibwa kw'omuwala w'abantu bange.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.4",
            "verseOrgIds": [
              "ISA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.22.5",
                "verseOrgIds": [
                  "ISA.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye alina olunaku",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "olw'akatabanguko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "olw'okulinyirirwa n'entiisa mu Kiwonvu ky'Okwolesebwa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "olunaku olw'okumenya bbugwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:5"
      },
      "items": [
        {
          "text": "n'okukaabirira ensozi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.5",
            "verseOrgIds": [
              "ISA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eramu ayambalidde omufuko gw'obusaale,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "n'atwala n'abavuzi b'amagaali ge n'embalaasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:6"
      },
      "items": [
        {
          "text": "Kiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        },
        {
          "text": "asabuukulula engabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.6",
            "verseOrgIds": [
              "ISA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiwonvu byo ebisinga obulungi bijjudde amagaali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:7"
      },
      "items": [
        {
          "text": "n'abeebagala embalaasi bassibbwa ku wankaaki.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.7",
            "verseOrgIds": [
              "ISA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwerinda kwa Yuda kuggyiddwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "Ku lunaku olwo watunuulira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:8"
      },
      "items": [
        {
          "text": "ebyokulwanyisa eby'omu Lubiri olw'Ekibira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.8",
            "verseOrgIds": [
              "ISA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walaba amabanga agaali mu kwerinda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "kw'Ekibuga kya Dawudi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "wakuŋŋaanya amazzi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:9"
      },
      "items": [
        {
          "text": "mu Kidiba eky'Emmanga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.9",
            "verseOrgIds": [
              "ISA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wabala ebizimbe mu Yerusaalemi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:10"
      },
      "items": [
        {
          "text": "n'omenya amayumba okusobola okunyweza bbugwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.10",
            "verseOrgIds": [
              "ISA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasima ekidiba omuterekebwa amazzi wakati w'ebisenge ebibiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "n'okuŋŋaanya ag'ekidiba ekikadde,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "naye tewatunuulira Oyo eyakisima,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 22:11"
      },
      "items": [
        {
          "text": "wadde okussaamu ekitiibwa Oyo eyakiteekateeka mu biro eby'edda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.11",
            "verseOrgIds": [
              "ISA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olwo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.12",
            "verseOrgIds": [
              "ISA.22.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
