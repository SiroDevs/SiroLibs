          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'ati bw'ayogera Katonda ow'Eggye nti, \"Ku lunaku olwo, enkondo ennene eyakomererwa mu kifo n'enywera erisalibwa, n'eneguka, n'egwa, n'omugugu gw'ekutte gulisarwako.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.25",
            "verseOrgIds": [
              "ISA.22.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
