    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zibasanze abo Abeesiga Misiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zibasanze abo abaserengeta e Misiri okuyambibwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "abeesiga embalaasi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "abeesiga amagaali gaabwe amangi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "abeesiga amaanyi amangi ag'abeebagala embalaasi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "ne batatunuulira Omutukuvu wa Isirayiri",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:1"
      },
      "items": [
        {
          "text": "wadde okunoonya obuyambi bwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.1",
                "verseOrgIds": [
                  "ISA.31.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.1",
            "verseOrgIds": [
              "ISA.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kyokka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.2",
                "verseOrgIds": [
                  "ISA.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mugezi era asobola okuleeta akabi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "tajjulula bigambo bye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "Aligolokokera ku nnyumba y'abatali batuukirivu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:2"
      },
      "items": [
        {
          "text": "ne ku abo abayamba abakozi b'ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.2",
            "verseOrgIds": [
              "ISA.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Abamisiri bantu buntu si Katonda",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "n'embalaasi zaabwe mibiri bubiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "Katonda bw'agolola omukono gwe",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "oyo ayamba, alyesittala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "n'oyo ayambibwa aligwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:3"
      },
      "items": [
        {
          "text": "era bombi balizikiririra wamu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.3",
            "verseOrgIds": [
              "ISA.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala ddala bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gye ndi nti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "\"Ng'empologoma bwe wuluguma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "empologoma ey'amaanyi bwe wulugumira ku muyiggo gwayo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "era newaakubadde ng'ekibinja ky'abasumba",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "kiyitibwa awamu okugirumba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "tetiisibwatiisibwa kuwowogana kwabwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "newaakubadde oluyoogaano lwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "Bw'atyo ne",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.4",
                "verseOrgIds": [
                  "ISA.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye bw'aliserengeta,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:4"
      },
      "items": [
        {
          "text": "okulwanira ku lusozi Sayuuni ne ku busozi bwa lwo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.4",
            "verseOrgIds": [
              "ISA.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng'ebinyonyi bwe bibuukira waggulu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "bw'atyo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ISA.31.5",
                "verseOrgIds": [
                  "ISA.31.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye bw'alisaanikira Yerusaalemi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "alikikuuma, n'akiwonya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:5"
      },
      "items": [
        {
          "text": "alikiyitamu n'akirokola.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.5",
            "verseOrgIds": [
              "ISA.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mudde eri oyo gwe mwajeemera ennyo, mmwe abaana ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.6",
            "verseOrgIds": [
              "ISA.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biro ebyo buli omu ku mmwe alisuulira ddala wala ebitali Katonda ebya ffeeza ne zaabu, emikono gyo egitali mituukirivu gye byakola.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.7",
            "verseOrgIds": [
              "ISA.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwasuli kirigwa n'ekitala ekitali kya muntu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "ekitala ekitali ky'abo abafa kirimusaanyaawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "Alidduka ekitala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:8"
      },
      "items": [
        {
          "text": "n'abavubuka be balikozesebwa emirimu egy'amaanyi n'obuwaze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.8",
            "verseOrgIds": [
              "ISA.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigo kyabwe kirigwa olw'okutya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 31:9"
      },
      "items": [
        {
          "text": "n'abaduumizi baabwe balitekemuka omutima olw'okulaba ebbendera ey'olutalo,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.31.9",
            "verseOrgIds": [
              "ISA.31.9"
            ]
          }
        }
      ]
