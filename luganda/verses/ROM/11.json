          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Oba ani eyali asoose okumuwa ekintu,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.35",
            "verseOrgIds": [
              "ROM.11.35"
            ]
          }
        }
      ]
