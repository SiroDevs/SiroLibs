      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:35"
      },
      "items": [
        {
          "text": "alyoke amuddizeewo?\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.35",
            "verseOrgIds": [
              "ROM.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
