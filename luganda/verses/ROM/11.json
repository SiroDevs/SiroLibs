          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga byonna biva gy'ali, era biyita mu ye era bidda gy'ali.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
            ]
          }
        }
      ]
