          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era eyo ye ndagaano yange nabo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:27"
      },
      "items": [
        {
          "text": "bwe ndibaggyako ebibi byabwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.27",
            "verseOrgIds": [
              "ROM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu njiri balabe ku lwammwe, naye mu kulondebwa baagalwa olwa bajjajjaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.28",
            "verseOrgIds": [
              "ROM.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda bw'agabira abantu ebirabo oba bw'abayita, teyejjusa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.29",
            "verseOrgIds": [
              "ROM.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuba nga mmwe edda bwe mwajeemera Katonda, kyokka kaakano nga musaasiddwa olw'obujeemu bw'Abayudaaya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.30",
            "verseOrgIds": [
              "ROM.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "bwe batyo nabo kaakano bajeemu, eri ekyo ekyali okusaasira gye muli, balyoke basaasirwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.31",
            "verseOrgIds": [
              "ROM.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga Katonda yaleka abantu bonna mu bujeemu alyoke abakwatirwe ekisa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.32",
            "verseOrgIds": [
              "ROM.11.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ROM 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nga Katonda wa kitalo,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:33"
      },
      "items": [
        {
          "text": "ng'amagezi ge mangi n'okutegeera kwe kungi era n'obugagga bungi;",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:33"
      },
      "items": [
        {
          "text": "ensala ye ey'emisango nga tekeberekeka, n'amakubo ge tegekkaanyizika.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.33",
            "verseOrgIds": [
              "ROM.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ROM 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kubanga ani ayinza okutegeera okulowooza kwa Mukama?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:34"
      },
      "items": [
        {
          "text": "Oba ani ayinza okumuluŋŋamya?\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.34",
            "verseOrgIds": [
              "ROM.11.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
