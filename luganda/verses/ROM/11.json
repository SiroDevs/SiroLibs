      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 11:36"
      },
      "items": [
        {
          "text": "Ekitiibwa kibe gy'ali emirembe gyonna. Amiina.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.11.36",
            "verseOrgIds": [
              "ROM.11.36"
