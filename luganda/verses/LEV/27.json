    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obweyamo eri",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.1",
                "verseOrgIds": [
                  "LEV.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba Musa nti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yogera eri abaana ba Isirayiri obagambe nti: Omuntu bw'anaakolanga obweyamo obw'enjawulo obw'okuwaayo abantu eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.2",
                "verseOrgIds": [
                  "LEV.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": "naye ng'asasulayo miwendo egibagyamu, onoobasaliranga bw'oti:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "omusajja aweza emyaka egy'obukulu egiri wakati w'amakumi abiri n'enkaaga anaaleetanga sekeri za ffeeza amakumi ataano",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "text": ", nga sekeri z'omu watukuvu bwe ziba,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye bw'anaabanga omukazi onoomusaliranga sekeri amakumi asatu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu aweza emyaka egy'obukulu egiri wakati w'ettaano n'amakumi abiri, bw'anaabanga omusajja onoomusaliranga sekeri amakumi abiri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "text": "naye omukazi sekeri kkumi",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'anaabanga omwana ng'ali wakati w'omwezi gumu n'emyaka etaano, onoomusaliranga sekeri ttaano",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "text": "eza ffeeza nga mulenzi, naye omuwala sekeri za ffeeza ssatu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaabanga ow'emyaka egy'obukulu nkaaga n'okusingawo, omusajja onoomusaliranga sekeri kkumi na ttaano",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "text": "n'omukazi sekeri kkumi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu eyakola obweyamo bw'anaabanga omwavu ennyo atasobola kuleeta miwendo egyo gye wamusalira, anaayanjulwanga eri kabona; kale kabona anaamusaliranga omuwendo ogumugyamu ng'ageraageranya obusobozi bw'oyo eyeeyama nga bwe bunaabanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obweyamo Obukwata ku Bisolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Obweyamo bw'omuntu bwe bunaabeeranga obw'ekisolo ekikkirizibwa ng'ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.9",
                "verseOrgIds": [
                  "LEV.27.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, ekisolo ng'ekyo ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.9",
                "verseOrgIds": [
                  "LEV.27.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kinaabanga kitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tasaaniranga kukikyusaamu oba kukiwaanyisaamu ekibi mu kirungi wadde ekirungi mu kibi; bw'anaabanga awaanyisizza ekisolo ekimu mu kirala, byombi kino na kiri ky'awanyisizzaamu binaafuukanga bitukuvu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ensolo omuntu gy'anaabanga yeeyamye bw'eneebanga etali nnongoofu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "text": ", etakkirizibwa ng'ekiweebwayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.11",
                "verseOrgIds": [
                  "LEV.27.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, ensolo eyo esaanira okuleetebwanga eri kabona,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ye alyokenga asalewo nga bw'eri, oba nnungi oba mbi. Omuwendo kabona gw'anaabaliriranga ku nsolo eyo, gwe gunaawebwangayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nannyini nsolo bw'anaabanga ayagala okuginunulayo, anaasaniranga okugattako ekitundu ekimu ekyokutaano ku muwendo gwayo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obweyamo Obukwata ku Nnyumba ne ku Ttaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja bw'anaawangayo ennyumba ye okubeera entukuvu eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.14",
                "verseOrgIds": [
                  "LEV.27.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda kabona anaagirabiranga omuwendo ogugigyamu, oba nnungi oba mbi. Omuwendo ogwo kabona gw'anaasalanga gwe gunaakolanga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyo anaawangayo ennyumba ye eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.15",
                "verseOrgIds": [
                  "LEV.27.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'anaabanga ayagala okuginunula, anaayongerangako ekitundu kimu kyakutaano ku muwendo gwayo, olwo ng'ennyumba emuddira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja bw'anaawangayo ekitundu ky'ettaka lye, lye yasikira, eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.16",
                "verseOrgIds": [
                  "LEV.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, omuwendo oguligyamu gunaabalirirwanga nga gwesigamizibwa ku bungi bw'ensigo ezeetaagibwa okusiga ku ttaka eryo ne ziggweerako; ensigo za sayiri ezipimibwamu oma zinaabalirirwangamu sekeri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "text": "za ffeeza amakumi ataano.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Singa ennimiro ye, agiwaayo mu biseera by'Omwaka gwa Jjubiri, omuwendo ogubaliriddwa gunaasigalanga nga bwe guli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bw'anaawangayo ennimiro ye nga Jjubiri eweddeko, kabona anagibalirirangamu omuwendo ng'agwesigamya ku myaka eginaabanga gibulayo Omwaka gwa Jjubiri eddirira gulyoke gutandike, n'omuwendo ogwali gubaliriddwa gunaakendeezebwangako.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era oyo anaabanga awaddeyo ennimiro ye bw'anaayagalanga okuginunula, kale anaagattangako ekitundu kimu kyakutaano ku muwendo gwayo, olwo ennimiro n'emuddira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye bw'anaabanga tayagala kununula nnimiro eyo, oba bw'anaabanga agiguzizza omuntu omulala, kale ng'olwo tekyanunulibwa n'akamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mu Mwaka gwa Jjubiri ennimiro eyo bw'eneeteebwanga, eneebanga ntukuvu, ng'ennimiro eyawongebwa ewa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.21",
                "verseOrgIds": [
                  "LEV.27.21"
                ]
              }
            }
          ]
        },
        {
          "text": "; eneebanga ya kabona.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Omusajja bw'anaawangayo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.22",
                "verseOrgIds": [
                  "LEV.27.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ennimiro gye yagula, etali ku ttaka lye ery'obwannannyini,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kabona anaabaliriranga omuwendo ogugigyamu okutuuka ku mwaka gwa Jjubiri, omusajja anaasasulanga omuwendo ogwo ku lunaku olwo ng'ekintu ekitukuvu eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.23",
                "verseOrgIds": [
                  "LEV.27.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka gwa Jjubiri, ennimiro eneddizibwanga oyo gwe yagigulako, nga y'oyo eyali nannyini ttaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli muwendo ogubalirirwa guneesigamizibwanga ku sekeri z'Awatukuvu, nga gera",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        },
        {
          "text": "amakumi abiri zivaamu sekeri emu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebintu Ebiwonge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tewabanga awaayo omwana gw'ensolo omubereberye eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", kubanga abaana b'ensolo ababereberye bonna ba",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", oba nte oba ndiga zonna za",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.26",
                "verseOrgIds": [
                  "LEV.27.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'anaabanga awaddeyo emu ku nsolo ezitali nnongoofu, anagisasuliranga omuwendo gwayo ogwagibalirirwamu, ng'agattako ekitundu kimu kyakutaano eky'omuwendo gwayo. Bw'ataaginunulengayo eneetundwanga omuwendo ogwagibalirirwamu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naye omuntu yenna bw'anaamalanga okuwongera",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.28",
                "verseOrgIds": [
                  "LEV.27.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ku bintu bye by'anaabanga nabyo, gamba oba muntu oba kisolo oba ennimiro ye gye yasikira, tewaabengawo ku bintu ebyo bitundibwa oba okununulibwa; buli kintu ekiwongere ddala mu ngeri eyo kinaabanga kitukuvu nnyo eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.28",
                "verseOrgIds": [
                  "LEV.27.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu eyawongebwa nga wa kuttibwa, taanunulibwenga kinaamusaaniranga kuttibwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okununula Ebitundu Eby'ekkumi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Buli kitundu eky'ekkumi ekiva mu nsi, gamba ku mmere ey'empeke eva mu ttaka, oba ku bibala ebiva ku miti, kya",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.30",
                "verseOrgIds": [
                  "LEV.27.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda, era kitukuvu eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.30",
                "verseOrgIds": [
                  "LEV.27.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu anaayagalanga okununula ku bitundu bye eby'ekkumi, anaagatangako ekitundu kimu kyakutaano ku muwendo gwakyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebitundu eby'ekkumi byonna ebyamagana g'ente n'eby'ebisibo by'endiga, kwe kugamba nti buli nsolo omusumba gy'anaabalanga nga ya kkumi, eneebanga ntukuvu eri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.32",
                "verseOrgIds": [
                  "LEV.27.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tasaaniranga kulondamu nnungi ng'alekawo embi, oba okuwaanyisa. Bw'anaawaanyisanga ng'olwo ensolo zombi, eri n'eno ewanyisizibbwa zinaafuukanga ntukuvu teziinunulibwenga.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ago ge mateeka",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "LEV.27.34",
                "verseOrgIds": [
                  "LEV.27.34"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ge yawa Musa ku lusozi Sinaayi agategeeze abaana ba Isirayiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        }
      ]
    }
  ],
