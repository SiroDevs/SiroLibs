                "verseOrgIds": [
                  "1KI.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", ne baddayo ewaabwe, nga",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
