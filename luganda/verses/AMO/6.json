          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anenya Abali mu Mirembe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zibasanze abo abateefiirayo mu Sayuuni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "n'abo abawulira emirembe ku lusozi lw'e Samaliya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "Mmwe abasajja abeekitiibwa ab'ensi enkulembeze,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:1"
      },
      "items": [
        {
          "text": "abantu ba Isirayiri gye beeyuna.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.1",
            "verseOrgIds": [
              "AMO.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugende mulabe e Kalune;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "muveeyo mulage mu Kamasi ekikulu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "ate era muserengete mu kibuga ky'Abafirisuuti eky'e Gaasi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Basinga obwakabaka bwammwe obubiri?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:2"
      },
      "items": [
        {
          "text": "Ensi yaabwe esinga eyammwe obunene?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.2",
            "verseOrgIds": [
              "AMO.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulindiriza olunaku olw'ekibi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:3"
      },
      "items": [
        {
          "text": "ate ne musembeza effugabbi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.3",
            "verseOrgIds": [
              "AMO.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugalamira ku bitanda ebyakolebwa mu masanga",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "ne muwummulira mu ntebe ennyonvu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "nga muvaabira ennyama y'endiga",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:4"
      },
      "items": [
        {
          "text": "n'ey'ennyana ensava.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.4",
            "verseOrgIds": [
              "AMO.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekubira ennanga nga Dawudi bwe yakolanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:5"
      },
      "items": [
        {
          "text": "ne muyiiya n'ennyimba ku bivuga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.5",
            "verseOrgIds": [
              "AMO.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwekatankira wayini,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "ne mwesiiga n'ebizigo ebirungi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:6"
      },
      "items": [
        {
          "text": "naye temukaabira kubonaabona kwa Yusufu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.6",
            "verseOrgIds": [
              "AMO.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mmwe mulisooka okugenda mu buwaŋŋanguse.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:7"
      },
      "items": [
        {
          "text": "Era embaga zammwe n'okwewummuza birikoma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.7",
            "verseOrgIds": [
              "AMO.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye alayidde,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.8",
                "verseOrgIds": [
                  "AMO.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda Ayinzabyonna agamba nti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "\"Neetamiddwa amalala ga Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "nkyawa ebigo bye,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "era nzija kuwaayo ekibuga",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:8"
      },
      "items": [
        {
          "text": "ne byonna ebikirimu eri abalabe baakyo.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.8",
            "verseOrgIds": [
              "AMO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era singa ennyumba eneeba ekyalinawo abasajja ekkumi abasigaddewo, nabo balifa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.9",
            "verseOrgIds": [
              "AMO.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era singa ow'ekika akola ku by'okuziika, anaaba afulumya amagumba n'abuuza oba waliwo omuntu yenna eyeekwese munda mu nnyumba, oba alina gwe yeekwese naye, n'addamu nti, \"Nedda,\" olwo omuziisi anaamusirisa ng'agamba nti, \"Sirika; tetwogera ku linnya lya",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.10",
                "verseOrgIds": [
                  "AMO.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.10",
            "verseOrgIds": [
              "AMO.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "AMO.6.11",
                "verseOrgIds": [
                  "AMO.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "alagidde,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "ennyumba ennene erimenyebwamenyebwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:11"
      },
      "items": [
        {
          "text": "n'ennyumba entono erimenyebwamenyebwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.11",
            "verseOrgIds": [
              "AMO.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kisoboka embalaasi okuddukira ku mayinja?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Waali wabaddewo abalima ku mayinja n'enkumbi ezisikibwa ente?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 6:12"
      },
      "items": [
        {
          "text": "Naye obwenkanya mubufudde obutwa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.6.12",
            "verseOrgIds": [
              "AMO.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
