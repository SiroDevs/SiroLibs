  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ZEC 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayita Abantu be Okudda gy'ali",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ogwokubiri ogw'obufuzi bwa kabaka Daliyo omufuzi w'e Buperusi mu mwezi ogw'omunaana, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.1",
                "verseOrgIds": [
                  "ZEC.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Zekkaliya omwana wa Berekiya, omwana wa Iddo nnabbi, nga kigamba nti:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.1",
            "verseOrgIds": [
              "ZEC.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.2",
                "verseOrgIds": [
                  "ZEC.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": "yasunguwalira nnyo bajjajjammwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.2",
            "verseOrgIds": [
              "ZEC.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye kaakano mubagambe nti: Bw'atyo bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'eggye nti, 'Mudde gye ndi,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, 'nange nadda gye muli,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.3",
                "verseOrgIds": [
                  "ZEC.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.3",
            "verseOrgIds": [
              "ZEC.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temuba nga bajjajjammwe, bannabbi ab'edda be baakoowoolanga nti, 'Muve mu makubo gammwe amabi, n'ebikolwa byammwe ebikyamu.' Naye tebampuliriza wadde okuŋŋondera, bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.4",
                "verseOrgIds": [
                  "ZEC.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.4",
            "verseOrgIds": [
              "ZEC.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye bajjajjammwe bali ludda wa? Ye bannabbi babeera balamu emirembe gyonna?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.5",
            "verseOrgIds": [
              "ZEC.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebigambo byange n'ebiragiro bye nalagira abaddu bange, bannabbi, eri bajjajjammwe tebyatuukirira?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:6"
      },
      "items": [
        {
          "text": "\"Ne balyoka beenenya ne bagamba nti, '",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.6",
                "verseOrgIds": [
                  "ZEC.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye bye yasuubiza okutukola olw'empisa zaffe embi n'ebikolwa byaffe ebitali bya butuukirivu, bw'atyo bw'atukoledde ddala.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.6",
            "verseOrgIds": [
              "ZEC.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nnabbi Ayolesebwa Embalaasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku lunaku olw'amakumi abiri mu ennya, mu mwezi ogw'ekkumi n'ogumu gwe bayita Sebati, mu mwaka ogwokubiri ogw'obufuzi bwa kabaka Daliyo, ekigambo kya",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.7",
                "verseOrgIds": [
                  "ZEC.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ne kijjira Zekkaliya mutabani wa Berekiya, omwana wa Iddo nnabbi nga kigamba nti.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.7",
            "verseOrgIds": [
              "ZEC.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalaba ekiro ng'omusajja yeebagadde embalaasi emyufu era yali ayimiridde mu miti emikadasi mu kiwonvu. Emabega we waaliyo embalaasi endala, enjeru, n'eza kikuusikuusi, n'emyufu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.8",
            "verseOrgIds": [
              "ZEC.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne mbuuza nti, \"Mukama wange bino bitegeeza ki?\" Malayika eyali ayogera nange n'aŋŋamba nti, \"Nzija kukulaga kye bitegeeza.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.9",
            "verseOrgIds": [
              "ZEC.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omusajja eyali ayimiridde mu miti n'addamu nti, \"Ezo embalaasi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.10",
                "verseOrgIds": [
                  "ZEC.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "z'asindise okulawuna ensi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.10",
            "verseOrgIds": [
              "ZEC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ziddamu malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.11",
                "verseOrgIds": [
                  "ZEC.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "eyali ayimiridde mu miti nti, \"Tubunye ensi yonna, era laba ensi yonna esiriikiridde teriimu kanyego eteredde mirembe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.11",
            "verseOrgIds": [
              "ZEC.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo malayika wa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "n'agamba nti, \"Ayi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.12",
                "verseOrgIds": [
                  "ZEC.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye, olituusa ddi obutakwatirwa Yerusaalemi n'ebibuga bya Yuda kisa, by'osunguwalidde okumala emyaka ensanvu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.12",
            "verseOrgIds": [
              "ZEC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.13",
                "verseOrgIds": [
                  "ZEC.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "n'alyoka addamu malayika eyali ayogera nange ebigambo ebirungi, ebigambo ebizzaamu amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.13",
            "verseOrgIds": [
              "ZEC.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo malayika eyali ayogera nange n'agamba nti, \"Langirira ogambe nti, Bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.14",
                "verseOrgIds": [
                  "ZEC.1.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ow'Eggye nti, 'Yerusaalemi ne Sayuuni mbikwatiririddwa obuggya obw'amaanyi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.14",
            "verseOrgIds": [
              "ZEC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye nyiigidde nnyo amawanga agali mu mirembe, kubanga abantu bange nnali mbanyiigiddeko katono naye bo ne bababonyaabonyeza ddala.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.15",
            "verseOrgIds": [
              "ZEC.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Noolwekyo, bw'ati bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nti, 'Nkomyewo mu Yerusaalemi n'ekisa. Ennyumba yange ne Yerusaalemi kyonna, bijja kuzimbibwa,' bw'ayogera",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.16",
                "verseOrgIds": [
                  "ZEC.1.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.16",
            "verseOrgIds": [
              "ZEC.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yogera n'eddoboozi ery'omwanguka nti,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda ow'Eggye alangiridde nti, 'Ebibuga byange bijja kuddamu okukulukuta obugagga, era",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.17",
                "verseOrgIds": [
                  "ZEC.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "alizzaamu Sayuuni amaanyi, ne yeeroboza Yerusaalemi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.17",
            "verseOrgIds": [
              "ZEC.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ZEC 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo ne nnyimusa amaaso gange, era laba, ne ndaba amayembe ana.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.18",
            "verseOrgIds": [
              "ZEC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ZEC 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malayika eyali ayogera nange ne mubuuza nti, \"Amayembe ago gategeeza ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:19"
      },
      "items": [
        {
          "text": "N'anziramu nti, \"Gategeeza obuyinza obwasaasaanya abantu ab'omu Yuda, n'ab'omu Isirayiri, n'ab'omu Yerusaalemi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.19",
            "verseOrgIds": [
              "ZEC.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ZEC 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.1.20",
                "verseOrgIds": [
                  "ZEC.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "n'andaga abaweesi bana.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.20",
            "verseOrgIds": [
              "ZEC.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ZEC 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mbuuza nti, \"Abo bazze kukola ki?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 1:21"
      },
      "items": [
        {
          "text": "N'addamu nti, \"Ago amayembe, bwe buyinza obwasaasaanya Yuda nga tewali na muntu ayimusa mutwe gwe; naye abaweesi abana bazze okubatiisa era n'okubazikiriza, ago amawanga agaasitukira ku nsi ya Yuda okusaasaanya abantu baamu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.1.21",
            "verseOrgIds": [
              "ZEC.2.4"
            ]
          }
        }
      ]
    }
