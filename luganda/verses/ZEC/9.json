  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ZEC 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekigambo kya Katonda kyolekedde ensi ya Kadulaki",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "era kirituuka e Ddamasiko.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "Kubanga abantu bonna n'ebika byonna ebya Isirayiri",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:1"
      },
      "items": [
        {
          "text": "batunuulidde",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "ZEC.9.1",
                "verseOrgIds": [
                  "ZEC.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ne Kamasi ekiriraanyeewo nakyo bwe kityo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:2"
      },
      "items": [
        {
          "text": "ne Ttuulo ne Sidoni wadde nga birina amagezi mangi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ttuulo kyezimbira ekigo",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "ne kituuma ffeeza n'eba ng'enfuufu,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:3"
      },
      "items": [
        {
          "text": "ne zaabu n'eba nnyingi ng'ettaka ery'omu kkubo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laba, Mukama alikyambulako ebintu byakyo,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "alizikiriza amaanyi gaakyo ag'oku nnyanja,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:4"
      },
      "items": [
        {
          "text": "era kiryokebwa omuliro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asukulooni bino kiribiraba ne kitya;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "ne Gaza bwe kityo kiribeera mu kulumwa okw'amaanyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Era n'essuubi lya Ekuloni liriggwaawo;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "Gaza aliggyibwako kabaka we,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:5"
      },
      "items": [
        {
          "text": "ne Asukulooni tekiribaamu bantu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagwira balitwala Asudodi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:6"
      },
      "items": [
        {
          "text": "era n'amalala g'Abafirisuuti ndigamalawo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.6",
            "verseOrgIds": [
              "ZEC.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Era ndiggya omusaayi mu kamwa ke",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "n'emmere ey'omuzizo okuva wakati mu mannyo ge.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "N'abo bonna abalisigalawo mu kyo baliba bantu ba Katonda waffe,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "balifuuka bakulembeze mu Yuda,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:7"
      },
      "items": [
        {
          "text": "ne Ekuloni kiriba nga Abayebusi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ndirwanirira ennyumba yange",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "eri eggye eddumbaganyi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "so tewaliba mulumbaganyi aliddayo kujooga bantu bange",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:8"
      },
      "items": [
        {
          "text": "kubanga kaakano mbalabirira.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanyuka nnyo ggwe omuwala wa Sayuuni:",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "leekaana nnyo, ggwe omuwala wa Yerusaalemi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "laba, kabaka wo ajja gy'oli;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "mutuukirivu era muwanguzi;",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "muwombeefu era yeebagadde endogoyi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:9"
      },
      "items": [
        {
          "text": "endogoyi ento, omwana gw'endogoyi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efulayimu ndimuggyako amagaali,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "ne Yerusaalemi muggyeko embalaasi ennwanyi,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "n'omutego gw'obusaale gulimenyebwa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "era alireeta emirembe mu mawanga,",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "n'obufuzi bwe buliva ku nnyanja emu butuuke ku nnyanja endala",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEC 9:10"
      },
      "items": [
        {
          "text": "era buve ku mugga Fulaati butuuke ku nkomerero z'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.10",
            "verseOrgIds": [
              "ZEC.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naawe ggwe, olw'omusaayi gw'endagaano gye nakola naawe,",
          "type": "text",
          "attrs": {
