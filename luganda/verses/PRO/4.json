  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "PRO 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amagezi ge gali ku Ntikko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muwulirize baana bange okuyigiriza kwange ng'okwa kitammwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:1"
      },
      "items": [
        {
          "text": "era musseeyo omwoyo mufune okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.1",
            "verseOrgIds": [
              "PRO.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga mbawa okuyigiriza okulungi;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:2"
      },
      "items": [
        {
          "text": "temulekanga biragiro byange.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.2",
            "verseOrgIds": [
              "PRO.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nnali omuvubuka nga ndi ne kitange,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:3"
      },
      "items": [
        {
          "text": "omwana omu yekka omwagalwa, owa mmange,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.3",
            "verseOrgIds": [
              "PRO.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "yanjigiriza n'aŋŋamba nti, \"Ebigambo byange bikuumenga ku mutima gwo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:4"
      },
      "items": [
        {
          "text": "kuuma ebiragiro byange obeere mulamu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.4",
            "verseOrgIds": [
              "PRO.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Funa amagezi; funa okutegeera,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:5"
      },
      "items": [
        {
          "text": "teweerabiranga era tovanga ku bigambo bya mu kamwa kange.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.5",
            "verseOrgIds": [
              "PRO.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Togalekanga, nago ganaakukuumanga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:6"
      },
      "items": [
        {
          "text": "gaagale nago ganaakulabiriranga.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.6",
            "verseOrgIds": [
              "PRO.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ddala amagezi kye kintu ekisingira ddala obukulu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:7"
      },
      "items": [
        {
          "text": "noolwekyo fuba ofune amagezi, era fubira ddala nnyo ofune okutegeera.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.7",
            "verseOrgIds": [
              "PRO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi gagulumize, nago gajja kukuyimusa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:8"
      },
      "items": [
        {
          "text": "gaanirize, nago gajja kukuweesa ekitiibwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.8",
            "verseOrgIds": [
              "PRO.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagezi gajja kukutikkira engule ey'ekisa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:9"
      },
      "items": [
        {
          "text": "era gakuwe n'engule ey'ekitiibwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.9",
            "verseOrgIds": [
              "PRO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Enjawulo wakati w'Ab'amagezi n'Abagwenyufu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wuliriza ggwe, mutabani, era okkirize ebigambo byange",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:10"
      },
      "items": [
        {
          "text": "olyoke owangaalire ku nsi n'essanyu eringi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.10",
            "verseOrgIds": [
              "PRO.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkuluŋŋamya mu kkubo ery'amagezi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:11"
      },
      "items": [
        {
          "text": "ne nkukulembera mu makubo ag'obutuukirivu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.11",
            "verseOrgIds": [
              "PRO.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onootambulanga, ekigere kyo kireme okuziyizibwa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:12"
      },
      "items": [
        {
          "text": "era bw'onoddukanga, tojjanga kwesittala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.12",
            "verseOrgIds": [
              "PRO.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nywerezanga ddala okuyigirizibwa, tokutanga:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:13"
      },
      "items": [
        {
          "text": "kukuumenga kubanga bwe bulamu bwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.13",
            "verseOrgIds": [
              "PRO.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyingiranga mu kkubo ly'abakozi b'ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:14"
      },
      "items": [
        {
          "text": "wadde okutambulira mu kkubo ly'abantu aboonoonyi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.14",
            "verseOrgIds": [
              "PRO.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyewalenga, tolitambulirangamu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:15"
      },
      "items": [
        {
          "text": "liveeko okwate ekkubo lyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.15",
            "verseOrgIds": [
              "PRO.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubanga abakozi b'ebibi tebayinza kwebaka okuggyako nga bakoze ebibi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:16"
      },
      "items": [
        {
          "text": "era otulo tubabulira ddala bwe baba tebalina gwe bakozeeko bulabe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.16",
            "verseOrgIds": [
              "PRO.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okukola ebibi y'emmere yaabwe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:17"
      },
      "items": [
        {
          "text": "n'okukozesa eryanyi kye kyokunywa kyabwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.17",
            "verseOrgIds": [
              "PRO.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekkubo ly'abatuukirivu liri ng'enjuba eyakavaayo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 4:18"
      },
      "items": [
        {
          "text": "eyeeyongera okwaka okutuusa obudde lwe butangaalira ddala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.4.18",
            "verseOrgIds": [
              "PRO.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
