                "verseId": "JDG.13.24",
                "verseOrgIds": [
                  "JDG.13.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'amuwa omukisa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
