          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "JDG.13.23",
                "verseOrgIds": [
                  "JDG.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda yabadde wa kututta, teyandisiimye kiweebwayo ekyokebwa n'ekiweebwayo eky'empeke okuva gye tuli, newaakubadde okutulaga ebintu bino byonna, wadde okututegeeza kino.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
      ]
    },
    {
