              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo omukazi n'azaala omwana wabulenzi, n'amutuuma Samusooni. Omwana n'akula,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
            "verseOrgIds": [
              "JDG.13.24"
            ]
