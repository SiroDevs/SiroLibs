          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manowa n'agamba mukazi we nti, \"Tugenda kufa kubanga tulabye Katonda.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mukazi we n'amugamba nti, \"Singa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        },
        {
          "name": "char",
