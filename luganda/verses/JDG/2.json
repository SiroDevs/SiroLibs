              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukulembeze olwafanga ne baddamu okweyisanga obubi okukira ne bajjajjaabwe, ne bagobereranga ne baweerezanga era n'okuvuunamiranga bakatonda abalala ne banywerera ku mpisa zaabwe embi olw'emputtu yaabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.2.19",
            "verseOrgIds": [
              "JDG.2.19"
            ]
          }
        }
