  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "DEU 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amateeka g'Ebyobufumbo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja bw'anaawasanga omukazi, naye oluvannyuma n'amukyawa, kubanga amuvumbuddeko ebitamusanyusa, bw'atyo n'amuwandiikira ebbaluwa ey'okumugoba, n'agimukwasa, n'amugoba mu nnyumba ye,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "omukazi oyo anaayinzanga okwefunira omusajja omulala n'amufumbirwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja ono owookubiri naye bw'anaamukyawanga n'amuwandiikira ebbaluwa ey'okumugoba, n'agimukwasa, n'amugoba mu nnyumba ye, oba omusajja oyo owookubiri bw'anaafanga;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bba eyasooka, eyali amugobye takkirizibwenga kuddamu kumuwasa kuba mukazi we, kubanga omukazi oyo anaabanga amaze okwebaka n'omusajja omulala. Ekyo kinaabanga kya kivve mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.4",
                "verseOrgIds": [
                  "DEU.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". Totwalanga kibi mu nsi",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.4",
                "verseOrgIds": [
                  "DEU.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo gy'akuwa okubeera obutaka bwo obw'enkalakkalira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amateeka Agatali Gamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusajja bw'anaabanga yaakawasa taalondebwenga kugenda kutabaala oba okuweebwa omulimu omulala omunene ng'ogwo. Anaasigalanga mu maka ge okumala ebbanga lya mwaka mulamba ng'asanyusa mukazi we gw'anaabanga awasizza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'awolanga munne n'amusaba omusingo, oba akakalu, tamuggyangako lubengo oba enso ng'omusingo oba akakalu, kubanga mu musingo ng'ogwo, aba atwaliddemu obulamu bwa munne.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu bw'anaakwatibwanga ng'awamba, obanga atunda Omuyisirayiri munne mu buddu, kale omuwambi anattibwanga. Bw'otyo bw'onoomalangamu ekibi wakati mu mmwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe wanaagwangawo obulwadde obw'olususu ng'obw'ebigenge, weegenderezanga nnyo, n'ogonderanga ebyo Abaleevi, bakabona, bye banaabalagiranga okukola, nga bwe mbalagidde.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojjukiranga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.9",
                "verseOrgIds": [
                  "DEU.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo kye yakola Miryamu nga muli mu lugendo lwammwe nga muva mu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'owolanga munno ekintu eky'engeri yonna, toyingiranga mu nnyumba ya munno oyo okunonamu omusingo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ggwe awoze onaabeeranga wabweru n'olindirira oyo gw'onoobanga owoze, okukuleetera omusingo ogwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gw'owoze bw'anaabanga omwavu, ekyambalo ky'anaabanga akuwadde ng'omusingo, tosulanga nakyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enjuba bw'eneebanga yaakagwa, onookiddizanga munno oyo alyoke akyebikke ekiro nga yeebase. Bw'atyo anaakwebazanga era kinaabanga kikolwa kya butuukirivu mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.13",
                "verseOrgIds": [
                  "DEU.24.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toyiikirizanga mwavu n'omupakasi ali mu kwetaaga, n'olwawo okumusasula empeera ye; ne bw'anaabanga Omuyisirayiri munno oba ow'okubannamawanga abanaabeeranga mu nsi yo nga basula mu kimu ku bibuga byo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoomusasulanga empeera ye eya buli lunaku ng'enjuba tennaba kugwa, kubanga mwavu n'omutima gwe gubeera ku mpeera eyo. Kubanga bw'onoomulagajjaliranga, anaayinzanga okukaabirira",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.15",
                "verseOrgIds": [
                  "DEU.24.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda n'akuloopayo, bw'otyo onoogwanga mu musango ogw'ekibi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakitaabwe b'abaana tebattibwenga nga babalanganga abaana baabwe, n'abaana tebattibwenga nga babalanganga bakitaabwe; buli omu anattibwanga ng'alangibwanga ekibi kye ye yennyini.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bannamawanga b'onoobeeranga nabo, n'abaana bamulekwa, obasaliranga emisango gyabwe n'obwenkanya, era totwalanga kyambalo kya nnamwandu ng'omusingo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojjukiranga nga bwe wali omuddu mu Misiri, naye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.18",
                "verseOrgIds": [
                  "DEU.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo n'akununulayo. Kyenva nkulagira okukolanga bw'otyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onookungulanga ebibala mu nnimiro yo ne weerabirayo ekinywa mu nnimiro, toddangayo kukikima. Onookirekeranga omunnaggwanga oba omwana omufuuzi oba nnamwandu; bw'atyo",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.24.19",
                "verseOrgIds": [
                  "DEU.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "alyoke akuwenga omukisa mu byonna by'onookolanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onookubanga emizeeyituuni okuva ku miti gyo, toddangayo ku matabi mulundi gwakubiri okumalirako ddala ebibala ebinaabanga bisigaddeko. Ebyo binaabanga bya bannamawanga, n'abaana bamulekwa ne bannamwandu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'onookungulanga emizabbibu okuva mu nnimiro yo, toddangamu mulundi gwakubiri. Ebibala ebinaabanga bisigaddeko onoobirekeranga bannamawanga, ne bamulekwa ne bannamwandu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ojjukiranga nga bwe wali omuddu mu nsi ey'e Misiri; kyenva nkulagira okukolanga bw'otyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.22",
            "verseOrgIds": [
              "DEU.24.22"
            ]
          }
        }
      ]
    }
  ],
