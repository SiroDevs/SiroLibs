          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.6.25",
                "verseOrgIds": [
                  "DEU.6.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe, nga bwe yatulagira, tunaabanga tutuukirizza ebyo by'ayagala.' \"",
          "type": "text",
          "attrs": {
