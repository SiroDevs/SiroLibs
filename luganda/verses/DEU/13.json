  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "DEU 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mmwe bwe mulabikangamu nnabbi oba omuntu n'akutegeeza eby'omu maaso nga yeeyambisa ebirooto, n'alangirira ebyamagero oba ebyewuunyisa ebijja okubeerawo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "era ebyamagero ebyo, oba ebyewuunyisa ebyo by'anaabanga alangiridde ne bituukirira, n'alyoka akugamba nti, \"Ka tugoberere bakatonda abalala era tubaweerezenga\" (bakatonda ggwe b'otomanyangako),",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.2",
            "verseOrgIds": [
              "DEU.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "towulirizanga bigambo bya nnabbi oyo, oba omuloosi w'ebirooto oyo. Kubanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.3",
                "verseOrgIds": [
                  "DEU.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe anaabanga abagezesa bugezesa ategeere obanga munaabanga mumwagala n'omutima gwammwe gwonna n'emmeeme yammwe yonna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.3",
            "verseOrgIds": [
              "DEU.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.4",
                "verseOrgIds": [
                  "DEU.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe gwe munaagobereranga, era ye yekka gwe munaatyanga, era amateeka ge, ge munaakwatanga, era n'eddoboozi lye, lye munaawulirizanga era lye munaagonderanga, era ku ye kwe munaanywereranga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.4",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale nno nnabbi oyo, oba omuloosi w'ebirooto oyo anattibwanga, kubanga anaabanga abasasamaza mujeemere",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, eyabaggya mu nsi ey'e Misiri, n'abanunula mu nnyumba ey'obuddu, nnabbi oyo ng'akusasamaza, ove mu kkubo ettuufu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.5",
                "verseOrgIds": [
                  "DEU.13.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo lye yakulagira okutambulirangamu. Bw'otyo ekibi ekiri mu mmwe, bw'onookimalangamu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu yenna, ne bw'abanga muganda wo oba mutabani wo, oba muwala wo, oba mukazi wo omuganzi ennyo, oba mukwano gwo gw'oyagala ennyo ow'okulusegere, n'akusendasendanga mu kyama ng'agamba nti, \"Jjangu tugende tusinze bakatonda abalala,\" bakatonda ggwe b'otomanyangako, ne bakadde bo be batamanyangako,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.6",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakatonda ab'abantu ababeetoolodde, ab'oku muliraano, oba abeewala, okuva ensi gy'etandikira ne gy'ekoma,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "tomuwulirizanga, so by'anaakugambanga tobikolanga. Tomusaasiranga era tomuzibiikirizanga wadde okumusonyiwanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuttiranga ddala. Gw'omusokangako ng'attibwa n'abantu bonna ne bassa okwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onoomukubanga amayinja n'omutta, kubanga anaabanga agezezzaako okukukyusa akuggye ku",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.10",
                "verseOrgIds": [
                  "DEU.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo eyakuggya mu nsi ey'e Misiri mu nnyumba ey'obuddu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kale Isirayiri yonna banaakiwuliranga banaatyanga, era tewaabeerengawo mu mmwe n'omu anaddangayo okukola ekibi ng'ekyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bw'owuliranga mu kimu ku bibuga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.12",
                "verseOrgIds": [
                  "DEU.13.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo by'akuwa okubeerangamu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nga mulimu abantu abali mu mmwe abasituse ne basikiriza abantu b'omu kibuga kyabwe ekyo nga babagamba nti, \"Ka tugende tusinze bakatonda abalala,\" bakatonda be mutamanyangako,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale nno kikusaanira obuulirizenga nnyo ku kintu ekyo, okyekebejjenga, okyekkaanyizenga ddala. Bwe kinaakakasibwanga nga kya mazima, nga wakati mu mmwe waliwo abakoze ekintu ekibi bwe kityo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kale, abantu bonna abanaabeeranga mu kibuga onoobattanga n'ekitala, awamu n'ebisolo byabwe bye balunda byonna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
            "verseOrgIds": [
              "DEU.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyago gwonna onoogukuŋŋaanyizanga wakati mu kibangirizi eky'omu kibuga, era onooyokyanga ekibuga kyonna n'omunyago gwako n'omuliro, ng'ekiweebwayo ekiri awamu ekyokebwa eri",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.16",
                "verseOrgIds": [
                  "DEU.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo. Ekibuga ekyo kinaasigalanga awo nga kifunvu eky'olubeerera, tekiddibwengamu kuzimbibwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.16",
            "verseOrgIds": [
              "DEU.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tewaabeerengawo kintu na kimu ku ebyo ebinaabanga bimaze okukolimirwa ky'onoosangibwanga nakyo, bwe butyo obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.17",
                "verseOrgIds": [
                  "DEU.13.18"
                ]
              }
            }
          ]
        },
        {
          "text": "obunaabanga obungi ennyo bunakkakkananga; anaakukwatirwanga ekisa, n'akulaganga okwagala kwe, n'akwongeranga okwala, nga bwe yalayirira bajjajjaabo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.17",
            "verseOrgIds": [
              "DEU.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubanga onoogonderanga eddoboozi lya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.18",
                "verseOrgIds": [
                  "DEU.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo n'okwatanga amateeka ge gonna ge nkuwa leero, n'okolanga ebisaanidde mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.13.18",
                "verseOrgIds": [
                  "DEU.13.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.18",
            "verseOrgIds": [
              "DEU.13.19"
            ]
          }
        }
      ]
    }
  ],
