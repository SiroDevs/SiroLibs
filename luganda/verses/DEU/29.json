  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "DEU 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okuzza Obuggya Endagaano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bye bigambo by'endagaano",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.28.69"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.1",
                "verseOrgIds": [
                  "DEU.28.69"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda gye yalagira Musa okukola n'abaana ba Isirayiri nga bali mu nsi ya Mowaabu, ng'egattibwa ku ndagaano gye yali akoze nabo ku Kolebu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.28.69"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awo Musa n'ayita Abayisirayiri bonna n'abagamba nti, Mwalaba n'amaaso gammwe ebyo byonna",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.2",
                "verseOrgIds": [
                  "DEU.29.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda bye yakolera mu nsi y'e Misiri ku Falaawo ne ku bakungu be, ne ku nsi ye yonna.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Walaba n'amaaso go ebigezo ebinene, n'obubonero obw'ebyamagero, n'ebyewuunyisa ebikulu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.3",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye n'okutuusa ku lunaku lwa leero",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.4",
                "verseOrgIds": [
                  "DEU.29.3"
                ]
              }
            }
          ]
        },
        {
          "text": "tabawanga mutima ogutegeera, oba amaaso agalaba, oba amatu agawulira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe nabakulembera okumala emyaka amakumi ana mu ddungu engoye zammwe tezaakaddiwako, n'engatto y'omu kigere kyo teyakaddiwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.5",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Temwalya ku mugaati wadde okunywa ku nvinnyo, oba ku kyokunywa ekirala kyonna ekitamiiza. Ekyo nakikola mulyoke mumanye nga nze",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.6",
                "verseOrgIds": [
                  "DEU.29.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe mwatuuka mu kifo kino, Sikoni kabaka w'e Kesuboni, ne Ogi kabaka w'e Basani, ne basituka okutulwanyisa, naye ne tubawangula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twatwala ensi yaabwe, ne tugigabira Abalewubeeni, n'Abagaadi, n'ekitundu ky'ekika eky'Abamanase, okuba obutaka bwabwe obw'ensikirano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noolwekyo mukwatenga ebigambo by'endagaano eno n'obwegendereza, mulyoke muwangulenga mu buli kimu kye munaakolanga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukuŋŋaanye wano leero mwenna mu maaso ga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.10",
                "verseOrgIds": [
                  "DEU.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wammwe, nga muli n'abakulembeze b'ebika byammwe, n'abakulu bammwe abakulembeze, n'abafuzi bammwe, n'abasajja bonna aba Isirayiri,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n'abaana bammwe abato, ne bakazi bammwe, ne munnaggwanga asula awamu naawe mu lusiisira lwo, okukutyabira enku, n'okukukimira amazzi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oli wano okukola endagaano ne",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.12",
                "verseOrgIds": [
                  "DEU.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo, ng'ekirayiro gy'ali,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.12",
                "verseOrgIds": [
                  "DEU.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wo gy'akola naawe leero;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "alyoke akukakase ng'akunyweza leero okubeeranga eggwanga lye, naye nga ye Katonda wo, nga bwe yakusuubiza, era nga bwe yalayirira bakadde bo: Ibulayimu ne Isaaka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endagaano eno gye nkola, ng'eriko n'ekirayiro kyayo,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "sigikola nammwe abayimiridde wano naffe leero mwekka, wabula ngikola wamu n'oyo atali wano naffe leero.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujjukira bulungi nga bwe twali mu nsi y'e Misiri, ne bwe twajjanga tuyita wakati mu mawanga okutuukira ddala wano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalabanga ebintu eby'ekikaafiiri, nga mwe mwalinga ebifaananyi ebibajje mu miti n'ebiwoole mu mayinja ne mu ffeeza ne mu zaabu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukakasize ddala leero nga mu maka gammwe oba mu bika byammwe temulinaamu musajja oba mukazi n'omu akyamizza omutima gwe okuva ku",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.18",
                "verseOrgIds": [
                  "DEU.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe agende asinze bakatonda bali abalala abamawanga ago. Mukakasize ddala nga mu mmwe temuliimu kikolo okuyinza okukula obutwa obw'engeri eyo obukaawa ng'omususa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuntu ow'engeri ng'eyo ng'awulidde ebigambo eby'ekikolimo kino n'amala yeeyibaala, ne yeetukuza ku bubwe yekka, n'alowooza munda ye nti, \"Nzija kubeera bulungi newaakubadde nga mmaliridde okukwata ekkubo eryange ery'obujeemu,\" ekyo kinaaletanga akacwano ku ttaka erinnyogovu obulungi ne ku kkalu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.20",
                "verseOrgIds": [
                  "DEU.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "taamusonyiwenga, kubanga obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.20",
                "verseOrgIds": [
                  "DEU.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "n'ekiruyi kye binaabuubuukiranga ku muntu oyo. Ebikolimo byonna ebiwandiikiddwa mu Kitabo kino binaamukkangako, era",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.20",
                "verseOrgIds": [
                  "DEU.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "alisangula erinnya lye n'aliggya wansi w'eggulu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.21",
                "verseOrgIds": [
                  "DEU.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": "anaamwawulanga n'amuggya mu bika byonna ebya Isirayiri n'amubonereza nnyo, nga bwe kiri mu bikolimo byonna eby'endagaano ebiwandiikiddwa mu Kitabo ky'Amateeka kino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana bammwe abaliddawo ne bannamawanga abaliva mu nsi ezeewala baliraba ekibonerezo ekiriba kigudde ku nsi n'obulwadde",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.22",
                "verseOrgIds": [
                  "DEU.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": "bw'aliba aleese ku ttaka ly'ensi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ettaka liriba lyonoonese nga lya munnyo n'amayinja agookya, nga tekuyinza kusimbibwako kintu wadde okubaako n'ekimerako, nga n'omuddo tegusobola kumerako. Ensi erifaanana ng'okuzikirizibwa kwa Sodomu, ne Ggomola, ne Aduma, ne Zeboyimu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.23",
                "verseOrgIds": [
                  "DEU.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "bye yazikiriza mu busungu bwe obungi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amawanga galyebuuza nga geewunya nti, \"Lwaki",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.24",
                "verseOrgIds": [
                  "DEU.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "akoze ekintu kino, n'akikola n'obusungu obungi butyo?\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kino kye kiriba eky'okuddamu nti, \"Kubanga abantu bano basudde eri endagaano ya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.25",
                "verseOrgIds": [
                  "DEU.29.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda wa bajjajjaabwe, endagaano gye yakola nabo bwe yabaggya mu nsi y'e Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baagenda ne basinza bakatonda abalala, ne babaweereza, bakatonda be baali batamanyi, era Katonda waabwe be yali tabawadde.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwe butyo obusungu bwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.27",
                "verseOrgIds": [
                  "DEU.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ne bubuubuukira ku nsi eyo, n'agireetako ebikolimo byonna ebiwandiikiddwa mu Kitabo kino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.28",
                "verseOrgIds": [
                  "DEU.29.27"
                ]
              }
            }
          ]
        },
        {
          "text": "n'abasiguukulula mu nsi yaabwe ng'aliko ekiruyi, era ng'ajjudde obusungu bungi, n'abakasuka mu nsi endala, nga bwe kiri leero.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebintu eby'ekyama bya",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Mukama",
              "type": "text",
              "attrs": {
                "verseId": "DEU.29.29",
                "verseOrgIds": [
                  "DEU.29.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Katonda waffe, naye ebyo ebyabikkulibwa bye byaffe n'abaana baffe emirembe gyonna, tulyoke tugonderenga ebigambo byonna ebiri mu mateeka gano.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
        }
      ]
    }
