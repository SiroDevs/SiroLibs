              "items": [
                {
                  "text": "Isaya 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Alafu afalume himu duniani, na vilongozi na akulu a viha, matajiri na atu a vyeo, phamwenga na atu osi anjina, atumwa na ario huru, adzifwitsa pangani na mawe ga myangoni. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
          }
        },
