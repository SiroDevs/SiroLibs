              },
              "items": [
                {
                  "text": "Isaya 34:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na nyenyezi zagbwa duniani, ovyo ovyo dza maembe gazugbwago ni phuto kali. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.13",
