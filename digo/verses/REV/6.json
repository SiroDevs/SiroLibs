                }
              ]
            }
          ]
        },
        {
          "text": "Chisha nchiona ye Mwana ngʼondzi anagandula hura ukaka wa sita. Phahi tsi yasumba sana, na dzuwa richigaluka rangi richikala dziru pipipi dza makala. Mwezi uchikala kundu dododo dza mlatso ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.12",
            "verseOrgIds": [
              "REV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
