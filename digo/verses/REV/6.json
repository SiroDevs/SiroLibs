                "loc": "REV.16.20"
              },
              "items": [
                {
                  "text": "Maono 16:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hiko mainguni kpwakundzwa dza jamvi. Myango yosi na visuwa vyosi vyauswa mura mwatu virimo kala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.14",
            "verseOrgIds": [
              "REV.6.14"
            ]
          }
        },
