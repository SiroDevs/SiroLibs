              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho kahi-kahi kuzunguluka chihi cha chifalume kala phana viumbe vine. Navyo kala vina matso chila phatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiumbe cha kpwandza kala ni dza simba, cha phiri kala ni dza ndzau, cha hahu kala china sura dza mutu, nacho cha ne kala ni dza kozi riurukaro. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
