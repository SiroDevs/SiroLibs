                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hipho mbere za chihi kala phana utu dza bahari ya chilolo, avi ni dziwe ra kungʼala-ngʼala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.6",
            "verseOrgIds": [
              "REV.4.6"
            ]
