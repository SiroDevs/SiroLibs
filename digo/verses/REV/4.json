              "items": [
                {
                  "text": "Isaya 6:2–3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hivyo viumbe vine, chila chimwenga kala china mapha sita. Nago mapha kala gana matso chila phatu. Kala vinaimba usiku na mutsi bila ya kunyamala, nao wira wenye kala ni hinyu:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
