                }
              ]
            }
          ]
        },
        {
          "text": "Gafula vivi nchikala ninalongozwa ni Roho, na phapho nchiona chihi cha chifalume ko mlunguni. Na iye achisagariraye ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.2",
            "verseOrgIds": [
              "REV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
