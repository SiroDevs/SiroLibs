              "items": [
                {
                  "text": "Isaya 6:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mo ndani Mlungu achifwinika mosi kuonyesa utukufuwe na uwezowe. Kpwa hivyo takuna ariyeweza kuinjira Nyumba ya Kuvoya Mlungu tsona hadi mashaka go sabaa ga hara malaika gariphokamilika.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
