                "loc": "EXO.38.21"
              },
              "items": [
                {
                  "text": "Kutsama 38:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya hipho nálola dzulu mlunguni nchiona Nyumba ya Kuvoya Mlungu i laza, yani hema ambaro kala ni ushaidi kama Mlungu a kuko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao hara malaika sabaa ariokala anareha mashaka sabaa atuluka kula mumo. Malaika aho kala akavwala nguwo nono za kungʼala-ngʼala zisizo na dowa, na kala akadzifunga mikanda mipana yotengezwa na zahabu mwao vifuwani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwenga wa hara viumbe vine waapha chila mmwenga wa hara malaika sabaa liga ra zahabu roodzala tsukizi za Mlungu aishiye hata kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
