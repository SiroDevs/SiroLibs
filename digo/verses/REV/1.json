            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ndiye ariyehumendza hangu mwandzo na achihuusira dambi zehu kpwa kuhufwerera. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4+REV.1.5",
            "verseOrgIds": [
              "REV.1.4",
