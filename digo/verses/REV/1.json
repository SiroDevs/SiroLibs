              "items": [
                {
                  "text": "Kutsama 19:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Maono 5:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wahuhenda hutawale phamwenga naye na hukale alavyadzi-sadaka kumuhumikira Mlungu ambaye ni Ise. Utukufu na uwezo wosi naukale wakpwe iye Jesu hata kare na kare! Amina.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
