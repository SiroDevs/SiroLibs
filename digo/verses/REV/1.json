                }
              ]
            }
          ]
        },
        {
          "text": "Nazo nyayoze kala zinangʼala-ngʼala dza shaba ya kuera ichiyosafishwa mohoni. Rakare kala ni dza madzi manji gajerago na nguvu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
