              "items": [
                {
                  "text": "Zaburi 89:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Baruwa hino ila kpwangu mimi Johana. Nakuandikirani mwimwi makundi sabaa ga afuasi a Jesu murio jimbo ra Asia.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4+REV.1.5",
            "verseOrgIds": [
              "REV.1.4",
