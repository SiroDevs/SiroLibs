            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona kala ana nyenyezi sabaa mkpwono wa kulume. Mwakpwe mromoni kala mchituluka upanga wa kurya sana, chisha wa maso kosi-kosi. Usowe kala unangʼala dza viratu dzuwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
