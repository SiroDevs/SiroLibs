            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu wamuonyesa Jesu Masihi mambo ambago kala ni lazima gahendeke vi sambi sambi. Naye Jesu wanihumira malaikawe kunirehera ujumbe huno mimi mtumishiwe, Johana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami nágaandika mambo gosi nrigogaona. Mambo higo nágaona, nago ni kuhusu ukpweli uriongʼazwa ni Jesu Masihi, yani neno ra Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu andajaliya atu osi ndioasomera ayawao ujumbe huno wa unabii, nao ndiophundza na kuulunga piya andajaliwa. Mana wakati ambao ni gahendeke u phephi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
