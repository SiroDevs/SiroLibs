                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu, yekalako, ariyeko, na ndiyekalako, anaamba hivi, “Mimi ndimi Alifa na ndimi Omega, Mwenye Nguvu Zosi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
