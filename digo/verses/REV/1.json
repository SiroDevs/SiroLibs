              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.13"
              },
              "items": [
                {
                  "text": "Danieli 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.5"
              },
              "items": [
                {
                  "text": "10:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hipho kahi-kahi ya taa hizo, náona mutu “dza Mutu Yela Mlunguni” akavwala kandzu iriyofika nyayoni na mkanda mpana wa zahabu chifuwani. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.7.9"
              },
              "items": [
                {
                  "text": "Danieli 7:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.6"
              },
              "items": [
                {
                  "text": "Danieli 10:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nyereze kala ni nyereru dza pamba ama bafuta, na matsoge kala ni dza jimbijimbi ra moho. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
