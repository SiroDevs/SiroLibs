                "loc": "EZK.26.16"
              },
              "items": [
                {
                  "text": "Ezekieli 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.26.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na aho afalume a dunia ariozinga naye na kushiriki utajiriwe, andarira na kuusononekera nyo mudzi ndiphoona unafuka mosi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.9",
            "verseOrgIds": [
              "REV.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho afalume andaima kure na nyo mudzi kpwa kuogopha go mateso. Nao andarira aambe, “Shaka rani ro, shaka rani ro, uwe mudzi mkpwulu, Babeli, mudzi urio na nguvu! Mana uamulio ukakufikira nawe kutiywa adabu muda wa dzisaa dzimwenga bahi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.10",
            "verseOrgIds": [
              "REV.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
