                }
              ]
            }
          ]
        },
        {
          "text": "Na ariphoona mosi kpwa mudzi unaphya, arira kululu achiamba, “Takuna mudzi mkpwulu wanjina dza huno!” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.18",
