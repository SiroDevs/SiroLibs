                  "text": "25:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na himo mudzini sauti za atu kuimba, a kupiga ngephephe, a kupiga vivoti na a tarumbeta, tazindasikirika tsona bii! Wala takundakala na fundi wa aina yoyosi, wala takundasikirika lala rinasaga tsona bii! ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.22",
            "verseOrgIds": [
              "REV.18.22"
            ]
          }
        },
        {
          "name": "verse",
