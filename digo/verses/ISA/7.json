                "loc": "2KI.16.5"
              },
              "items": [
                {
                  "text": "2 Afalume 16:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.5+2CH.28.6"
              },
              "items": [
                {
                  "text": "2 Nyakati 28:5–6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati Ahazi mwana wa Jothamu, mwana wa Uziya anatawala Juda, mfalume Resini wa tsi ya Shamu na mfalume Peka wa tsi ya Iziraeli ambaye kala ni mwana wa Remaliya, aambuka Jerusalemu ili akapigane na Juda ela taayaweza kuiteka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume Ahazi wa chivyazi cha Daudi ariphoasikira kukala Shamu ikaungana na Iziraeli, iye na atue agbwirwa ni wuoga, achikakama dza mihi ya tsakani isumbiswavyo ni phepho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Mwenyezi Mlungu achimuambira Isaya, “Phiya uwe na mwanao Sheari-Jashubu mkakutane na Ahazi hiko mwisho wa mfumbi uinjizao madzi kpwenye birika ra dzulu ririro barabara ya kuphiya chiwanjani kufumwako nguwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kamuambire, adzimanyirire, ahurire, asiogophe wala asivundzike moyo kpwa sababu ya hasira siru ya Resini wa Shamu na mwana wa Remaliya, mana aho ni dza vinga viiri vifukavyo mosi chivyotuluzwa kula mohoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamu, mfalume wa Iziraeli na atue akampangira mai. Aho akaambirana, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Huphiyeni hukashambuliye tsi ya Juda. Nahukabomoleni huihale ikale yehu na humuike mwana wa Tabeeli akale mfalumewe.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu, mkpwulu wa osi anaamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achigomba tsona na Ahazi achimuamba, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.10",
            "verseOrgIds": [
              "ISA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mvoye Mwenyezi Mlungu, Mlunguo akuphe ishara, ikale ni ya kula kuzimu au ya kula mlunguni.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.11",
            "verseOrgIds": [
              "ISA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Ahazi achiamba, “Sindavoya, sindamjeza Mwenyezi Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.12",
            "verseOrgIds": [
              "ISA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alafu Isaya achiamba, “Sambi niphundzani mwimwi atu a chivyazi cha Daudi! Dze, vyo vyakuremweza atu tavitosha hata vino mnalonda muremweze Mlungu wangu?” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.13",
            "verseOrgIds": [
              "ISA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.23"
              },
              "items": [
                {
                  "text": "Mathayo 1:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa hivyo Mwenyezi Mlungu mwenye andakupha ishara. Lola, mwanamwali andagbwira mimba, adzivugule mwana mlume, naye andamuiha Imanueli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.14",
            "verseOrgIds": [
              "ISA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andarya maziya ga mtindi na asali hadi ndiphoweza kurema mai na kutsambula manono. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.15",
            "verseOrgIds": [
              "ISA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kabila hiye mwana amanye kurema mai na kutsambula manono, hizo tsi ambazo afalumee airi unaaogopha zindakala tazina atu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.16",
            "verseOrgIds": [
              "ISA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu andakuhenda uwe na atu a nyumbayo na atu a nyumba ya sowe mphahe mashaka makulu ambago tagadzangbwehendeka hangu tsi ya Efuraimu iriphotengana na Juda, yani andairehera mfalume wa Ashuru.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo Mwenyezi Mlungu andapigira milozi jeshi ririro mwisho wa vidzuho vya Misiri redze dza maindzi na jeshi ra Ashuru redze dza nyuchi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao andakpwedza ahurire kpwenye madete gasigo na chitu na kpwenye panga za mawe na dzulu ya vidori vyosi na dzulu ya marisa gosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.19",
            "verseOrgIds": [
              "ISA.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo Mwenyezi Mlungu andahumira wembe uchiokodishwa kula kanda-kanda ya muho Yufurati yani mfalume wa Ashuru. Andakunyolani vitswa, vyeru na malalaika ga maguluni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.20",
            "verseOrgIds": [
              "ISA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo mutu andafuga mwana ngʼombe mmwenga na mangʼondzi mairi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.21",
            "verseOrgIds": [
              "ISA.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela andaphaha maziya manji hata akale na maziya ga mtindi, mana chila ndiyesala kpwenye tsi andanwa maziya ga mtindi na asali. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.22",
            "verseOrgIds": [
              "ISA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo chila phatu phokala na mizabibu elufu mwenga ambayo garamaye ni dza vipande elufu mwenga vya feza, phandakala miya na vikpwata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.23",
            "verseOrgIds": [
              "ISA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu andakpwedza hipho na maha na mivi kpwedzaindza mana tsi yosi i tele miya na vikpwata. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.24",
            "verseOrgIds": [
              "ISA.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundaphiya tsona hiko vidzangoni ambako kala uchikurima, kpwa kuogopha miya na vikpwata, ela kundarichirwa ngʼombe na mangʼondzi garise.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.25",
            "verseOrgIds": [
              "ISA.7.25"
            ]
          }
        }
      ]
    }
  ],
