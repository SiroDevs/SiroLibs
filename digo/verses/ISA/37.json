          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Isaya mwana wa Amozi, achihuma ujumbe kpwa Hezekiya achiamba, “Mwenyezi Mlungu, Mlungu wa Iziraeli anaamba hivi: Voyo uchironivoya kuhusu Senakeribu mfalume wa Ashuru, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.21",
            "verseOrgIds": [
              "ISA.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "riri ndiro neno arirogomba Mwenyezi Mlungu kumuhusu iye:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
            "verseOrgIds": [
              "ISA.37.22"
            ]
          }
        }
      ]
    },
