              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Senakeribu mfalume wa Ashuru achiuka, achiuya kpwakpwe, achendakala Ninawi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.37",
            "verseOrgIds": [
              "ISA.37.37"
            ]
          }
