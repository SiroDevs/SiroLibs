                }
              ]
            },
            {
              "text": "Ezekieli 29:1—32:32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hino ni ruwiya kuhusu Misiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.1",
            "verseOrgIds": [
              "ISA.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku Mwenyezi Mlungu, Mlungu wa majeshi ndiphounula mkpwonowe chinyume cha Misiri, Amisiri andakala dza achetu, andakakama kpwa wuoga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsi ya Juda indakala utu wa kutisha kpwa Amisiri. Chila ndiyehadzirwa Juda andaogopha kpwa sababu ya mai ambago Mwenyezi Mlungu, Mlungu wa majeshi akagapanga chinyume cha Amisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo uchifika, atu a midzi mitsano hiko Misiri andagomba Chieburania na kuapa kukala andamuhumikira Mwenyezi Mlungu, Mlungu wa majeshi. Mudzi mmwenga kahi ya midzi iyo undaihwa “Mudzi wa Dzuwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati uho kundakala na phatu pha kumlavira Mwenyezi Mlungu sadaka pho kahi-kahi ya tsi ya Misiri na nguzo chiyotengbwa kpwa ajiliye himo miphakani. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phatu hipho pha kulavira sadaka phandakala ishara na ushaidi wa wazi kpwa ajili ya Mwenyezi Mlungu, Mlungu wa majeshi ko tsi ya Misiri. Ndiphomririra Mwenyezi Mlungu kpwa sababu anaonerwa, iye andaahumira muokoli na mkanizi ndiyeativya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu andadzionyesa kpwa Amisiri, nao andakubali mamlakage. Andalavya sadaka za kuochwa na sadaka zanjina. Andaika naziri kpwa Mwenyezi Mlungu na aziuse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu andaipiga Misiri, alafu aiphoze. Nao andagaluka kumlola iye, naye andaphundza mavoyo gao na aaphoze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo kundakala na barabara kulu kula Misiri hadi Ashuru. Aashuru andaphiya Misiri na Amisiri aphiye Ashuru na osi andaabudu phamwenga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo Aiziraeli andakala kundi ra hahu phamwenga na Misiri na Ashuru, Aiziraeli andakala baraka kpwa atu a dunia yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu, Mlungu wa majeshi andaitangazira baraka dunia kpwa kuamba, “Naajaliwe Amisiri atu angu, Aashuru ni kazi ya mikono yangu na Aiziraeli ni urisi wangu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
  ],
