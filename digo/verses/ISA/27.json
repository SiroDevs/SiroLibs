              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo mundaimba kuhusu chunga chinono cha mizabibu wira uambao,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
