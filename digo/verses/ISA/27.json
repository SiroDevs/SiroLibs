                }
              ]
            }
          ]
        },
        {
          "text": "Siku iyo Mwenyezi Mlungu andahumira upangawe uryao, mkpwulu na wa nguvu, kumtiya adabu nyoka aihwaye Leviathani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "27:1",
              "type": "text"
            },
            {
              "text": "Leviathani",
              "type": "text"
            },
            {
              "text": "ni nyama wa baharini mfwano wa dzoka kulu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nyoka iye aambalaye upesi. Naye andariolaga rira dzoka rikalaro baharini.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        }
      ]
