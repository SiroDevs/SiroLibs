              "items": [
                {
                  "text": "2 Afalume 24:10–16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tsona anao anjina a chilume andahalwa kpwa lazima, akatulwe na kuhumika ndani ya nyumba ya mfalume wa Babeli.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        }
