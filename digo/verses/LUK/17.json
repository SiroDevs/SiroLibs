                "loc": "GEN.6.5+GEN.6.6+GEN.6.7+GEN.6.8"
              },
              "items": [
                {
                  "text": "Mwandzo 6:5–8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vivyo vyokala wakati wa Nuhu, ndivyo ndivyokala wakati mimi Mutu Yela Mlunguni ndiphouya. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.6+GEN.7.7+GEN.7.8+GEN.7.9+GEN.7.10+GEN.7.11+GEN.7.12+GEN.7.13+GEN.7.14+GEN.7.15+GEN.7.16+GEN.7.17+GEN.7.18+GEN.7.19+GEN.7.20+GEN.7.21+GEN.7.22+GEN.7.23+GEN.7.24"
              },
              "items": [
                {
                  "text": "Mwandzo 7:6–24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati wa Nuhu atu kala achirya na kunwa, kala achilóla na kulólwa, hadi siku Nuhu ariphoinjira safina, alafu mafuriko gachedza, na gachiolaga atu osi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.27",
            "verseOrgIds": [
              "LUK.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.20"
              },
              "items": [
                {
                  "text": "Mwandzo 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.25"
              },
              "items": [
                {
                  "text": "19:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hata siku za Lutu yakala vivyo piya, atu arya na kunwa, kuhenda bishara, kurima na kudzenga. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela siku Lutu ariphouka Sodoma, vidziwe vya chibiriti viakavyo moho kula mlunguni vyamwagika dza mvula na vichiaolaga osi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.29",
            "verseOrgIds": [
              "LUK.17.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
