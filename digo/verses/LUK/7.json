                "loc": "MAT.21.32"
              },
              "items": [
                {
                  "text": "Mathayo 21:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.12"
              },
              "items": [
                {
                  "text": "Luka 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na atu osi phamwenga na atoza kodi amphundza Johana, achimtogola Mlungu, nao achibatizwa ni Johana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.29",
            "verseOrgIds": [
              "LUK.7.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mafarisayo na alimu a Shariya arema kubatizwa ni Johana, hipho achikala akarema mpango wa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.30",
            "verseOrgIds": [
              "LUK.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.30",
            "verseOrgIds": [
              "LUK.7.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu waenderera kugomba achiamba, “Sambi atu a siku hizi ndaafwananisha na chitu chani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.31",
            "verseOrgIds": [
              "LUK.7.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni dza anache avumbao cheteni, kundi mwenga rinaambira ranjina:",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.32",
            "verseOrgIds": [
              "LUK.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.35",
            "verseOrgIds": [
              "LUK.7.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfarisayo mmwenga wamualika Jesu akarye naye kpwakpwe kaya. Alafu Jesu waphiya achendasagala chakuryani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.36",
            "verseOrgIds": [
              "LUK.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.7"
              },
              "items": [
                {
                  "text": "Mathayo 26:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.14.3"
              },
              "items": [
                {
                  "text": "Mariko 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.3"
              },
              "items": [
                {
                  "text": "Johana 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi, mudzi hinyo kala kuna mchetu mmwenga malaya. Hiye mchetu ariphosikira Jesu anarya nyumbani mwa Mfarisayo, wahala tupa ya marashi ga samani na achedza nago mura nyumbani. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.37",
            "verseOrgIds": [
              "LUK.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waima phephi na Jesu, achiandza kurira na matsozige gachitwena maguluni pha Jesu. Chisha achigaphangusa na nyereze, achimdonera magulu alafu achigapaka higo marashi.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.38",
            "verseOrgIds": [
              "LUK.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.38",
            "verseOrgIds": [
              "LUK.7.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuya Mfarisayo yemualika Jesu ariphoona vira, wagomba na rohore, achiamba, “Kala mutu hiyu ni nabii, angemanya ni ani na ni mchetu wa aina yani amgutaye, mana ni mchina-dambi!” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.39",
            "verseOrgIds": [
              "LUK.7.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Jesu achimuamba yuya Mfarisayo, “Simoni, nina maneno nalonda nikuambire.” Simoni achiamba, “Haya mwalimu, niambira.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.40",
            "verseOrgIds": [
              "LUK.7.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 7:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Jesu waamba, “Kpwahenda mutu mmwenga achiaphasa pesa atu airi: Mmwenga wamuaphasa shilingi elufu mirongo mitsano na wanjina achimuaphasa shilingi elufu tsano. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.41",
            "verseOrgIds": [
              "LUK.7.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 7:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osi airi ashindwa kuripha, hipho yuya mutu yeaphasa pesa achiaswamehe. Sambi, unafikiri ni yuphi ndiyeshukuru zaidi?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.42",
            "verseOrgIds": [
              "LUK.7.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni achimuamba, “Naona ni yuya yeswamehewa deni kulu.” Jesu achimuamba, “Ni sawa, ukagomba kpweli.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 7:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.43",
            "verseOrgIds": [
              "LUK.7.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 7:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alafu wagaluka achilola yuya mchetu na achimuamba Simoni, “Unamuona yuno mchetu? Nchiphoinjira himu mwako nyumbani, kukanipha madzi ga kusinga magulu, ela yuno mchetu akanisinga magulu na matsozige na akaniphangusa na nyereze. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.44",
            "verseOrgIds": [
              "LUK.7.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LUK 7:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukanipha mwadzo wa kunidonera, ela hiyu mchetu akanidonera magulu hangu nchiphokpwedza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.45",
            "verseOrgIds": [
              "LUK.7.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LUK 7:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona kukanipaka mafuha chitswani kama desturi, ela iye akanipaka marashi ga magulu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.46",
            "verseOrgIds": [
              "LUK.7.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, nakuamba, mendzwa nyinji achigonihendera hiyu mayo ganaonyesa akaswamehewa dambize nyinji. Ela mutu aswamehewaye chidide andamendza chidide.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.47",
            "verseOrgIds": [
              "LUK.7.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LUK 7:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.47",
            "verseOrgIds": [
              "LUK.7.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LUK 7:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu achimuamba yuya mchetu, “Mayo, ukaswamehewa dambizo.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.48",
            "verseOrgIds": [
              "LUK.7.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 7:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho hara atu anjina okala anarya naye achiuzana, “Ni ani yuno, ambaye anaswamehe hata dambi?” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.49",
            "verseOrgIds": [
              "LUK.7.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 7:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu achimuamba yuya mchetu, “Kuluphiroro rikakuokola, phiya salama.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.50",
            "verseOrgIds": [
              "LUK.7.50"
            ]
          }
        }
      ]
    }
