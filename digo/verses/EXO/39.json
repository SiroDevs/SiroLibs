          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo hinyo Aiziraeli achikala akamala kutengeza chila chitu arichokala Mwenyezi Mlungu akamlagiza Musa achihende. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.42",
            "verseOrgIds": [
              "EXO.39.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 39:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Musa ariphoilola iyo kazi achiona kukala hinyo atu akaihenda sawa-sawa, dza viratu vira Mwenyezi Mlungu arivyomlagiza. Kpwa hivyo achiabariki.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.43",
            "verseOrgIds": [
              "EXO.39.43"
            ]
          }
        }
      ]
