                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usivisujudiye wala kuviabudu, kpwa sababu mimi, Mwenyezi Mlungu, Mlunguo, ni Mlungu mwenye wivu. Nindatiya adabu ana kpwa dambi za ise zao, hadi chivyazi cha hahu na cha ne cha hara arionimena. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.5",
            "verseOrgIds": [
              "EXO.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nkuonyesa mendzwa isiyosika kpwa maelufu na elufu ga hara animendzao na kugbwira amuri zangu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.6",
            "verseOrgIds": [
              "EXO.20.6"
            ]
          }
        }
      ]
    },
