                "loc": "DEU.22.28+DEU.22.29"
              },
              "items": [
                {
                  "text": "Kumbukumbu 22:28–29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutu achimrusa msichana ambaye kadzangbwelólwa na achimchenga-chenga hata achikala naye, naamlavire mali na amlóle. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ichikala ise wa msichana kataki tsetsetse mwanawe alólwe ni hiye, hiye mlume naaisabu mali ya msichana amuphe ise. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.10+DEU.18.11"
              },
              "items": [
                {
                  "text": "Kumbukumbu 18:10–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musiriche mchetu mtsai akakala moyo bii. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.23"
              },
              "items": [
                {
                  "text": "Alawi 18:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.20.15+LEV.20.16"
              },
              "items": [
                {
                  "text": "20:15–16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.21"
              },
              "items": [
                {
                  "text": "Kumbukumbu 27:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutu yeyesi ndiyelala nyama, ni aolagbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.2+DEU.17.3+DEU.17.4+DEU.17.5+DEU.17.6+DEU.17.7"
              },
              "items": [
                {
                  "text": "Kumbukumbu 17:2–7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mutu yeyesi ndiyemlavira sadaka mlungu wanjina isiphokala Mwenyezi Mlungu ni aolagbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.9"
              },
              "items": [
                {
                  "text": "Kutsama 23:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.33+LEV.19.34"
              },
              "items": [
                {
                  "text": "Alawi 19:33–34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.17+DEU.24.18"
              },
              "items": [
                {
                  "text": "Kumbukumbu 24:17–18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.19"
              },
              "items": [
                {
                  "text": "27:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musiahendere mai ajeni, wala kuaonera, mana mwimwi namwi mwakala ajeni kpwenye tsi ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usimuhendere mai gungu au mwanachiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mchiahendera mai gogosi na achiniririra kuhusu munagoahendera nindaphundza chiriro chao, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nindatsukirwa na nikuolageni kpwa upanga, ili achetu enu nao akale magungu na ana enu nao akale anachiya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.35+LEV.25.36+LEV.25.37+LEV.25.38"
              },
              "items": [
                {
                  "text": "Alawi 25:35–38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.7+DEU.15.8+DEU.15.9+DEU.15.10+DEU.15.11"
              },
              "items": [
                {
                  "text": "Kumbukumbu 15:7–11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.19+DEU.23.20"
              },
              "items": [
                {
                  "text": "23:19–20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uchimuaphasa mchiya kahi za atu angu, muaphase kare tu, wala usimtake fwaida dza vira aguzi a pesa ahendavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.10+DEU.24.11+DEU.24.12+DEU.24.13"
              },
              "items": [
                {
                  "text": "Kumbukumbu 24:10–13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Uchihala nguwo ya myao ikale mzamana, lazima umuuyizire kabila dzuwa kutswa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kana nguwo yanjina ya kudzibwiningiza hata ni iyo bahi, na usiphomuuyizira andadzibwiningizani? Manya kukala achiniririra kpwa sababu ukasala na nguwoye, nindamphundza kpwa sababu mimi ni Mlungu wa mbazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.5"
              },
              "items": [
                {
                  "text": "Mahendo 23:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Usimkufuru Mlungu, wala kumlani mtawala wa atuo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msihende vwende kunilavira mtalo wangu kahi za mavuno genu, na uchi wenu wa zabibu. Tsona mundanipha ana enu a mwandzo alume. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na chila mwana ngʼombe wa kpwandza mlume, au mwana ngʼondzi, achivyalwa mricheni na nine sabaa mwenga, ela siku ya nane ichifika nlavirani. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.15"
              },
              "items": [
                {
                  "text": "Alawi 17:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwimwi mundakala atu angu atakatifu, kpwa hivyo, msirye kabisa nyama chiyeolagbwa ni nyama wa vuweni, nyama dza hinyo mundaatsuphira madiya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.31"
            ]
          }
        }
      ]
    }
