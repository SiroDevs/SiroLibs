            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiziraeli arya manna kpwa miaka mirongo mine, hadi achifika tsi yohenda makalo. Arya manna hadi ariphofika miphaka ya Kanani, ambako akpwendahenda makalo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
