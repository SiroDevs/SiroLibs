            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu achimuamba Musa, “Sambi undaona ndivyo muhenda Farao. Kpwa uwezo wangu nindamuhenda aariche nyo atu auke, na kpwa uwezo wangu andaazola kpwenye tsiiye.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.1",
            "verseOrgIds": [
              "EXO.6.1"
            ]
          }
        }
      ]
    },
