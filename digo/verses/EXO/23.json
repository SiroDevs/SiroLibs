            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.19"
              },
              "items": [
                {
                  "text": "27:19",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Musiahendere ajeni mai, mana mwimwi namwi kala mu ajeni kahi za tsi ya Misiri na mnamanya ujeni urivyo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.9",
            "verseOrgIds": [
              "EXO.23.9"
            ]
          }
        }
      ]
    },
