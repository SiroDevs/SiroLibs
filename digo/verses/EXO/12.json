              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.17"
              },
              "items": [
                {
                  "text": "Agalatia 3:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Muda ambao O Aiziraeli kala akasagala Misiri kala ni miaka magana mane na mirongo mihahu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.40",
            "verseOrgIds": [
              "EXO.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pho mwisho wa yo miaka magana mane na mirongo mihahu, yo siku ya mwisho yenye, atu osi a Mwenyezi Mlungu atuluka kula tsi ya Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.41",
            "verseOrgIds": [
              "EXO.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa kukala Mwenyezi Mlungu wachesa usiku hinyo kutuluza Aiziraeli kula Misiri. Na usiku uho Aiziraeli osi anafwaha kuchesa ili kuika ishima kpwa Mwenyezi Mlungu. Kpwa hivyo usiku uho ni wa kutambukirwa ni Aiziraeli osi na vivyazi vyao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.42",
            "verseOrgIds": [
              "EXO.12.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
