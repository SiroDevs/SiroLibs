              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Aiziraeli osi ahenda dza Mwenyezi Mlungu arivyolagiza Musa na Aruni. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.50",
            "verseOrgIds": [
              "EXO.12.50"
