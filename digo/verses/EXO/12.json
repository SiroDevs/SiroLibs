              "EXO.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aiziraeli auka na magulu kula mudzi wa Ramesesi hadi mudzi wa Sukothi. Alume machiyao kala ni kama elufu magana sita bila ya kuolanga achetu na anache. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.37",
            "verseOrgIds": [
              "EXO.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kundi kulu ra atu ambao kala sio Aiziraeli piya rauka phamwenga nao, phamwenga na vyaa vya ngʼombe, vya mangʼondzi na mbuzi na vyaa vya mifugo yanjina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.38",
            "verseOrgIds": [
              "EXO.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atengeza mikahe isiyotiywa hamira na gara madonje ga unga uriokala akaukanda ariphokala anatuluka Misiri. Unga uho kala tautiirwe hamira mana kala ahendazolwa ko Misiri, na taaphahire nafwasi ya kujita chakurya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.12.39",
            "verseOrgIds": [
              "EXO.12.39"
            ]
          }
        }
      ]
    },
    {
