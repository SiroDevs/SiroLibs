        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.35+EXO.12.36"
              },
              "items": [
                {
                  "text": "Kutsama 12:35–36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nindahenda Amisiri akumendzeni na ichikala munauka, msiuke mikono mihuphu. ",
          "type": "text",
