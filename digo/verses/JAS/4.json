          "type": "text",
          "attrs": {
            "verseId": "JAS.4.12",
            "verseOrgIds": [
              "JAS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
