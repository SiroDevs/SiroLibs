              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.11",
            "verseOrgIds": [
              "JAS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.34+MAT.5.35+MAT.5.36+MAT.5.37"
              },
              "items": [
                {
                  "text": "Mathayo 5:34–37",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zaidi ya higo gosi enehu, msiape tsetsetse. Msiape kuhadza Mlungu, dunia wala chitu chochosi. Ichikala neno ni ra kpweli amba “Ni kpweli”, na ichikala sivyo amba “Sivyo”, ela msiape au mundaamulwa.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JAS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.12",
            "verseOrgIds": [
              "JAS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JAS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, kuna mutu ariye tabuni? Ni lazima avoye Mlungu. Uchikala una raha, phahi imba mawira ga kumtogola Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.13",
            "verseOrgIds": [
              "JAS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.13"
              },
              "items": [
                {
                  "text": "Mariko 6:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kuna mmwenga wenu ni mkpwongo? Naaihe vilongozi a afuasi a Jesu amuvoyere na ampake mafuha",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:14",
              "type": "text"
            },
            {
              "text": "Akongo nkupakpwa mafuha kuonyesa Mlungu ndiye aphozaye kpwa uwezowe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwa dzina ra Bwana Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.14",
            "verseOrgIds": [
              "JAS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwi mchivoya na kuamini kukala hiye mkpwongo andaphola, Mlungu andamphoza. Ichikala wahenda dambi, andaswamehewa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.15",
            "verseOrgIds": [
              "JAS.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo chila mmwenga naaseme dambize kpwa myawe na mvoyerane ili muweze kuphozwa makongo genu. Mavoyo ga mutu wa haki gana nguvu sana na ganahenda kazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.16",
            "verseOrgIds": [
              "JAS.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Afalume 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.1"
              },
              "items": [
                {
                  "text": "18:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Elija kala ni mwanadamu dza sisi. Wavoya chikpweli-kpweli kusinye mvula, nayo mvula taiyanya ko Iziraeli kpwa miaka mihahu na miezi sita. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.17",
            "verseOrgIds": [
              "JAS.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.42+1KI.18.43+1KI.18.44+1KI.18.45"
              },
              "items": [
                {
                  "text": "1 Afalume 18:42–45",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Badaye Elija wavoya tsona, ndipho mvula ichinya, nayo tsi ichimera mimea.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.18",
            "verseOrgIds": [
              "JAS.5.18"
            ]
          }
        }
      ]
    },
    {
