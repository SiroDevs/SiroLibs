              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho ise achimuamba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.39",
            "verseOrgIds": [
              "GEN.27.39"
            ]
