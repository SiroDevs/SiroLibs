              "GEN.27.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.20"
              },
              "items": [
                {
                  "text": "Aeburania 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho wasengera na achimdonera. Isaka ariphosikira kungu ya nguwoze, wamjaliya achiamba, “Ehe, kungu nono ya mwanangu ni dza kungu ya munda uriojaliwa ni Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.27",
            "verseOrgIds": [
              "GEN.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu akuphe mvula nyinji na minda ya rutuba ili uphahe mavuno manji na uchi munji. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.28",
            "verseOrgIds": [
              "GEN.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Mwandzo 12:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Makabila gosi nagakuhumikire, atu osi naakugbwerere maguluni. Ukale mkpwulu wa nduguzo, nao naakugbwerere maguluni. Yeyesi ndiyekulani naye naalaniwe, ndiyekuazira manono naajaliwe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.29",
            "verseOrgIds": [
              "GEN.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya Isaka kumala kumjaliya Jakobo, Jakobo wauka. Ariphouka tu, nduguye Esau achedza kula windzani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.30",
            "verseOrgIds": [
              "GEN.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya naye watengeza chakurya cha mtswano na achimphirikira ise. Achendamuamba, “Baba, tafadhali sagalato, urye nyama nchizokurehera kula weruni, ili unijaliye.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.31",
            "verseOrgIds": [
              "GEN.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise Isaka achiamba, “U ani we?” Naye achiamba, “Ni mimi, mwanao mvyere Esau.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.32",
            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wagbwirwa ni mchecheta, achikakama na achiamba, “Vino akale ni ani yuya chiyeniindzira nyama na akanirehera? Nkarya sambi yenye kabila kudzangbwekpwedza; nami nkamjaliya na indakala hivyo!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau ariphosikira hivyo, wasikira utsungu sana na achirira kpwa raka ra dzulu kuno anamuambira ise, “Ee baba nijaliya nami piya!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.34",
            "verseOrgIds": [
              "GEN.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ise achiamba, “Mwenenu akedzanichenga na akahala barakazo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.35",
            "verseOrgIds": [
              "GEN.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.29+GEN.25.30+GEN.25.31+GEN.25.32+GEN.25.33+GEN.25.34"
              },
              "items": [
                {
                  "text": "Mwandzo 25:29–34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau achiamba, “Ndiyo mana aihwa Jakobo! Wanichenga kano mbiri: Ra kpwandza wahala uvyere wangu na vino lola, akahala baraka zangu.” Halafu achiamba, “Dze, kunisazirire baraka yoyosi?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.36",
            "verseOrgIds": [
              "GEN.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka achimuambira Esau, “Lola, nkamuhenda dzumbeo na nkamupha nduguze osi akale atumishie, na nkamupha mavuno na uchi. Sambi siweza kukuhendera rorosi mwanangu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.37",
            "verseOrgIds": [
              "GEN.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.17"
              },
              "items": [
                {
                  "text": "Aeburania 12:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Esau achimuambira ise, “Kpwani che una baraka mwenga bahi, baba? Nijaliya nami baba!” Esau wakota kululu achirira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.38",
            "verseOrgIds": [
              "GEN.27.38"
            ]
          }
        }
      ]
    },
