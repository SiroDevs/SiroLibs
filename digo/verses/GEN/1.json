        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu achilola vitu vyosi vyokala akaviumba achiona ni vinono sana. Kuchikala dziloni na kuchikala ligundzu siku ya sita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.31",
