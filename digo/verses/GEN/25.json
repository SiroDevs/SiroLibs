              "GEN.25.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.12"
              },
              "items": [
                {
                  "text": "Arumi 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achimuamba, “Una chandzo cha makundi mairi ga atu mo mwako ndanini, higo makundi mairi ndigovyala tagandagbwirana. Kundi mwenga rindakala na nguvu kuriko ranjina, mvyere andamuhumikira mdide.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku za kuvyala ziriphofika, Rebeka wadzivugula patsa ya ana alume. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana wa kpwandza kala a kundu-kundu na mwiriwe wosi kala una malalaika manji dza nguwo yotengezwa na nyoya. Kpwa hivyo, amuiha Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:25",
              "type": "text"
            },
            {
              "text": "Kpwa Chieburania mana ga neno",
              "type": "text"
            },
            {
              "text": "Esau",
              "type": "text"
            },
            {
              "text": "ni",
              "type": "text"
            },
            {
              "text": "ariye na malalaika manji.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa phiri wavyalwa kala akamgbwira Esau jimbe, kpwa hivyo achiihwa Jakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:26",
              "type": "text"
            },
            {
              "text": "Kpwa Chieburania neno",
              "type": "text"
            },
            {
              "text": "Jakobo,",
              "type": "text"
            },
            {
              "text": "manage ni dza",
              "type": "text"
            },
            {
              "text": "anagbwira jimbe,",
              "type": "text"
            },
            {
              "text": "piya manage ni",
              "type": "text"
            },
            {
              "text": "anachenga.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Rebeka ariphovyala nyo anae a patsa, Isaka kala ana miaka mirongo sita.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
