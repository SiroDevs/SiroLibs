          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara anache akula; Esau wakala hodari wa kuindza, mutu wa kumendza weru-weru, ela Jakobo kala ni mpole wa kumendza kusagala kaya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka wammendza Esau zaidi, kpwa sababu kala achimendza kurya nyama zoindzwa ni Esau; ela Rebeka wammendza Jakobo zaidi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
    {
