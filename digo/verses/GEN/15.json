              "type": "tag",
              "attrs": {
                "loc": "JAS.2.23"
              },
              "items": [
                {
                  "text": "Jakobo 2:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Buramu achimkuluphira Mwenyezi Mlungu na kpwa sababu iyo Mwenyezi Mlungu achimuhenda akale mutu wa haki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        }
      ]
