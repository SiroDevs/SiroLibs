              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuhu phokala uchi ukamkutika na kumanya achigohenderwa ni mwanawe mdide, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "waamba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.25",
            "verseOrgIds": [
              "GEN.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.27",
            "verseOrgIds": [
              "GEN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya mafuriko Nuhu wasagala miaka magana mahahu na mirongo mitsano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
            "verseOrgIds": [
              "GEN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miaka ariyoishi Nuhu ni miaka magana tisiya na mirongo mitsano, ndipho achifwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.29",
            "verseOrgIds": [
              "GEN.9.29"
            ]
          }
        }
      ]
    }
  ],
