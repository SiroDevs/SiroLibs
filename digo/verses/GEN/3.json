          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiye mlume dzinare kala ndiye Adamu; naye wamuiha mchewe Hawa, mana iye ndiye ninengbwa wa anadamu osi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
