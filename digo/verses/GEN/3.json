              "items": [
                {
                  "text": "2 Akorintho 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.14"
              },
              "items": [
                {
                  "text": "1 Timothi 2:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipho Mwenyezi Mlungu achimuamba ye mchetu, “Ni maneno gani gano uchigohenda?” Ye mchetu achiamba, “Nyoka ndiyo ichiyonichenga, nami nikarya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        }
