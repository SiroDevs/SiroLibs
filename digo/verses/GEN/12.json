                "loc": "ACT.7.2+ACT.7.3"
              },
              "items": [
                {
                  "text": "Mahendo 7:2–3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.8"
              },
              "items": [
                {
                  "text": "Aeburania 11:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku mwenga, Mwenyezi Mlungu wamuamba Buramu, “Uka kpwenye tsi yenu, uriche mbarizo na nduguzo na uphiye tsi ambayo nindakuonyesa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.1",
            "verseOrgIds": [
              "GEN.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Buramu wauka dza arivyolagizwa ni Mwenyezi Mlungu, na Lutu achiphiya naye. Buramu kala ana miaka mirongo sabaa na mitsano ariphouka Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buramu wahala mchewe Sarai, na Lutu, mwana wa nduguye, mali zosi arizophaha na atumwa osi arioaphaha pho Harani, achiuka achiphiya Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buramu watsupira kahi-kahi ya yo tsi hadi achifika Shekemu, phatu phokala na muhi wa mwaloni urio More. Siku zizo Akanani kala anasagala tsi iyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.5"
              },
              "items": [
                {
                  "text": "Mahendo 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.16"
              },
              "items": [
                {
                  "text": "Agalatia 3:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu wamtsembukira Buramu, achimuamba, “Hino ndiyo tsi ndiyoipha uvyazio.” Hipho Buramu wadzenga phatu pha kulavira sadaka Mwenyezi Mlungu, ambaye kala akamtsembukira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kula hipho waphiya uphande wa myango ya mlairo wa dzuwa wa Betheli na achichita hemare. Betheli ichikala i mtswerero wa dzuwa na Ai ichikala i mlairo wa dzuwa. Phapho wamdzengera Mwenyezi Mlungu phatu pha kulavira sadaka na achimuabudu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Buramu wazidi kuphiya uphande wa Negebu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu kpwakala na ndzala hiko Kanani, na ndzala iyo yakala kulu hata ichibidi Buramu atsame, waphiya Misiri achendasagala kuko kpwa muda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buramu ariphokala a phephi kufika Misiri, wamuambira mchewe Sarai, “Ninamanya kukala uwe u mnono? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amisiri achikuona andaamba, ‘Yuyu ni mchewe,’ na phapho aniolage ela uwe akuriche moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.2"
              },
              "items": [
                {
                  "text": "Mwandzo 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.7"
              },
              "items": [
                {
                  "text": "26:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nakuvoya uaambire kukala uwe u mwenehu, ili nisiolagbwe na nihenderwe mambo manono kpwa sababuyo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi Buramu ariphofika Misiri, Amisiri achimuona kukala ye mchetu ni mnono sana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maofisaa a Farao ariphomuona, achendamtogola mbere za Farao, halafu ye mchetu achihalwa achiphirikpwa dzumbani kpwa Farao. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buramu wahenderwa mambo manono-manono ni Farao kpwa sababu ya Sarai na achihewa mangʼondzi na mbuzi, ngʼombe, punda, atumwa alume na achetu na ngamia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mwenyezi Mlungu waagayisa na achiatiya makongo makali-makali Farao na atu a nyumbaye yosi kpwa sababu ya Sarai, mkpwaza Buramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.17",
            "verseOrgIds": [
              "GEN.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho Farao achimlagizira Buramu, achimuamba, “Ni neno rani rino ronihendera? Kpwa utu wani kuyaniambira kukala yuno ni mcheo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.18",
            "verseOrgIds": [
              "GEN.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa utu wani waniamba ni mwenenu, na uchinihenda nimuhale akale mkpwazangu? Sambi mcheo hiyu; muhale na muuke!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.19",
            "verseOrgIds": [
              "GEN.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Farao achilagiza atue amsindikize Buramu na mchewe na mali zosi zokala nazo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.20",
            "verseOrgIds": [
              "GEN.12.20"
            ]
          }
        }
      ]
    }
  ],
