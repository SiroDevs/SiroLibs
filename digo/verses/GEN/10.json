          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu, kala ni mvyerengbwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:21",
              "type": "text"
            },
            {
              "text": "Mvyerengbwa",
              "type": "text"
            },
            {
              "text": "Tafusiri zanjina zinaamba",
              "type": "text"
            },
            {
              "text": "Shemu mdide wa Jafeti.",
              "type": "text"
            }
          ]
        },
        {
          "text": " wa Jafeti, na ndiye mkarengbwa wa Aeburania osi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.21",
            "verseOrgIds": [
              "GEN.10.21"
            ]
          }
        }
      ]
    },
