          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinyo ndio atu a chivyazi cha Shemu kulengana na mbari zao, luga zao, tsi yao na makabila gao.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.10.31",
