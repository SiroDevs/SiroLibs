              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ise achiamba, “Apa,” naye Yusufu achimuapira. Chisha ise achiuyiza chitswache chitandani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.31",
