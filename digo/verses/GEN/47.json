              "type": "text"
            }
          ]
        },
        {
          "text": "ela siku nchifwa, nitsukulani kula Misiri, mkanizike kpwehu vikurani.” Yusufu achiamba, “Nindahenda kama uchivyoniamba, baba.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
