              "type": "text"
            }
          ]
        },
        {
          "text": "Lutu ariphofika Soari dzuwa kala rikatuluka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.23",
            "verseOrgIds": [
              "GEN.19.23"
