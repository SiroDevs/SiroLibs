              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye malaika achimuamba, “Haya, ni sawa-sawa, nkakubali. Sindauangamiza mudzi hinyo uchiouhadza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
