          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo-iyo ligundzu Burahimu wauya phara ariphokala akaima mbere za Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achilola uphande wa Sodoma na Gomora na tsi yosi ya kugbwa na achiona mosi unafuka kula photsi, dza mosi wa tanu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
