              "text": "19:22",
              "type": "text"
            },
            {
              "text": "Soari",
              "type": "text"
            },
            {
              "text": "manaye ni",
              "type": "text"
            },
            {
              "text": "mdide.",
              "type": "text"
            }
          ]
        }
