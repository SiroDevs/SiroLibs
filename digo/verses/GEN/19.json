              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara malaika airi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:1",
              "type": "text"
            },
            {
              "text": "Hara malaika airi",
              "type": "text"
            },
            {
              "text": "ni sawa na",
              "type": "text"
            },
            {
              "text": "hara mabwana airi",
              "type": "text"
            },
            {
              "text": "ario sura 18:22.",
              "type": "text"
            }
          ]
        },
        {
          "text": " afika Sodoma dziloni, Lutu kala asegere ryangoni, ryango ra Sodoma. Ariphoaona, wangʼoka achendaachinjira, chisha achizama hadi usowe uchiguta photsi ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.1",
            "verseOrgIds": [
              "GEN.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na achiamba, “Mabwana karibuni kpwangu kaya; mimi ni mtumishi wenu. Munaweza kusinga magulu na kulala hiko rero usiku, ligundzu chiti mundalamuka na mphiye charo chenu.” Ela aho achiamba, “Aa, swino hundalala phapha muhalani.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.2",
            "verseOrgIds": [
              "GEN.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Lutu achiabembeleza hadi mwisho achiphiya nao kpwakpwe kaya. Achiatengezera chakurya chinono, yani mikahe isiyotiywa hamira. Chiriphoivwa waapha achirya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.3",
            "verseOrgIds": [
              "GEN.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabila taadzangbwekpwendalala, alume a mudzi wa Sodoma — avyere kpwa adide — akpwedzazunguluka nyumba ya Lutu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.4",
            "verseOrgIds": [
              "GEN.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.19.22+JDG.19.23+JDG.19.24"
              },
              "items": [
                {
                  "text": "Aamuli 19:22–24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Achimuiha Lutu, achimuamba, “A kuphi hara alume achiokpwedza kpwako dziloni? Atuluze kondze, hunalonda huahende achetu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.5",
            "verseOrgIds": [
              "GEN.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lutu watuluka kondze na achifunga mryango. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.6",
            "verseOrgIds": [
              "GEN.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiaamba, “Enehu, nakuvoyani msihende mambo mai! ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.7",
            "verseOrgIds": [
              "GEN.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani! Nina ana airi achetu ambao taadzangbwelala na alume. Godzani nikurehereni muahende mlondavyo. Ela musiahendere mai hano, mana ni ajeni angu, ni lazima niarinde.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.8",
            "verseOrgIds": [
              "GEN.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela aho achiamba, “Hebu, huphise hipha njirani! Uwe u mjeni tu na kuweza kuhuambira ra kuhenda. Phahi, hundakuhenda vibaya kushinda aho ajenio.” Achimsukuma-sukuma sana Lutu, achisengera ili avundze mryango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.9",
            "verseOrgIds": [
              "GEN.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela hara alume airi mura nyumbani agolosa mikono, achimuhala Lutu, achimuinjiza ndani na achifunga mryango. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.10",
            "verseOrgIds": [
              "GEN.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.6.18"
              },
              "items": [
                {
                  "text": "2 Afalume 6:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha achiahenda vipofu gafula atu osi okala kondze mryangoni, avyere kpwa adide, na achidziremweza kuendza mryango, ela tauonere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.11",
            "verseOrgIds": [
              "GEN.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara alume airi amuambira Lutu, “Dze, una mutu wanjina yeyesi hipha, mwana mlume ama mchetu, mkpwaza-mwana, mtsedza ama mʼbario yeyesi akalaye mudzi huno? Atsamize, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.12",
            "verseOrgIds": [
              "GEN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana swino hundauangamiza kpwa kukala chiriro kuhusu atu aha chikazidi nacho chikafikira Mwenyezi Mlungu naye akahuhuma hubanange uhu mudzi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.13",
            "verseOrgIds": [
              "GEN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho, Lutu watuluka achendaambira achumba a anae achetu, achiaambira, “Upesi, ukani hipha; Mwenyezi Mlungu a phephi auangamize huno mudzi.” Ela aho achiona ni machani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.14",
            "verseOrgIds": [
              "GEN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuriphokala kunangʼala-ngʼala, nyo malaika amuhimiza Lutu achimuamba, “Henda wangbwi uhale mcheo na anao, muuke, sedze mkafwa wakati mudzi unatiywa adabu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.15",
            "verseOrgIds": [
              "GEN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.7"
              },
              "items": [
                {
                  "text": "2 Petero 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lutu achikala anasita-sita, hipho hara malaika amgbwira mkpwono iye, mchewe na hara anae airi achetu achialongoza kondze ya mudzi, mana Mwenyezi Mlungu waaonera mbazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.16",
            "verseOrgIds": [
              "GEN.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariphokala akaatuluza kondze, mmwenga wao waamba, “Chimbirani mtivye maisha genu! Msilole nyuma wala musiime phophosi kpwenye tsi ya kugbwa! Chimbirirani myangoni ili sedze mkafwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.17",
            "verseOrgIds": [
              "GEN.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Lutu achiaambira, “Hata nagasikale mabwana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.18",
            "verseOrgIds": [
              "GEN.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kpweli mimi mtumishi wenu mkanitsunuka na mkanionera mbazi kpwa kunitivya, ela siweza kufika myangoni mana ni kure sana. Nchihenda vivyo, nindaphahwa ni go mai na nifwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.19",
            "verseOrgIds": [
              "GEN.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani, phapha phana mudzi mdide niwezao kuuchimbirira. Dza muonavyo ni mdide, ela nirichani nchimbirire hiko nami ndakala moyo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.20",
