              "items": [
                {
                  "text": "Juda 1:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipho Mwenyezi Mlungu achihenda Sodoma na Gomora kunye mvula ya moho wa chibiriti kula mlunguni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.24",
            "verseOrgIds": [
              "GEN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiangamiza midzi iyo, tsi yosi ya kugbwa, atu osi ariokala mumo na chila chitu chomera hiko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.25",
            "verseOrgIds": [
              "GEN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
