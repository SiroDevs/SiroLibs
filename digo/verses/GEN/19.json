            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Henda wangbwi uchimbirire kuko, mana sindahenda rorosi hadi ufike kuko.” Kpwa sababu Lutu waamba ni mdide, hura mudzi waihwa Soari.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        },
        {
