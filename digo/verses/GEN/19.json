              "items": [
                {
                  "text": "Luka 17:32",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela mkpwaza Lutu walola nyuma na achigaluka nguzo ya munyu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.26",
            "verseOrgIds": [
              "GEN.19.26"
