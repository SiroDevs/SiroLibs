          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinya ndio afalume ariotawala tsi ya Edomu kabila ya mfalume yeyesi kutawala atu a Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.31",
            "verseOrgIds": [
              "GEN.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela mwana wa Beori watawala tsi ya Edomu, na mudziwe kala unaihwa Dinihaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela ariphofwa, Jobabu mwana wa Zera, watawala badalaye kula mudzi wa Bosira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya Jobabu, wakpwedza Hushamu kula tsi ya Atemani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achedza Hadadi mwana wa Bedadi, kula mudzi wa Avithi (iye wapiga Amidiani na achiashinda kahi za tsi ya Amoabu). ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi ariphofwa, yetawala badaye ni Samula kula mudzi wa Masireka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "alafu achilungirwa ni Shauli kula mudzi wa Rehobothi phephi na muho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shauli ariphofwa, Baali-Hanani, mwana wa Akibori watawala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baali-Hanani ariphofwa walungirwa ni Hadadi kula mudzi wa Pau mchewe kala aihwa Mehetabeli, mwana wa Matiredi mwana mchetu wa Mezahabu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
