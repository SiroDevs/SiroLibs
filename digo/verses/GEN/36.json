          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dishoni, Eseri na Dishani. Aha kala ni vilongozi a Ahori kulengana na mbari zao hiko tsi ya Seiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.30",
            "verseOrgIds": [
              "GEN.36.30"
            ]
          }
        }
