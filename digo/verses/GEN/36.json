              "type": "text"
            }
          ]
        },
        {
          "text": "Kuuyira, naamba, madzumbe ga Ahori kala ni Lotani, Shobali, Sibeoni, Ana, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.29",
            "verseOrgIds": [
