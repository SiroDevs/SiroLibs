              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burahimu achiamba, “Mimi nkadzilavya kugomba na uwe Mwenyezi Mlungu, dze muchiphahikana atu mirongo miiri?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
