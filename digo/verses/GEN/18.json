          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Burahimu achigomba naye tsona achiamba, “Dze, ichikala kuna atu mirongo mine tu?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
