          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achiamba, “Sindahenda hivyo nchiphaha atu mirongo mihahu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        }
      ]
