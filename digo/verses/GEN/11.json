            "sid": "GEN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera wavyala Buramu, Nahori na Harani. Harani wavyala Lutu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani wafwa Uru mudzi wa Akalidayo, ambako ndiko kovyalwa, na ariphofwa iseye Tera kala achere moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buramu walóla Sarai na Nahori walóla Milika mwana wa Harani, ambaye piya kala ni ise wa Isika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarai kala ni tasa, kala kana mwana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
