          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera wamuhala mwanawe Buramu na mdzukuluwe Lutu, mwana mlume wa Harani na mkpwaza-mwanawe Sarai, mkpwaza Buramu. Osi atuluka Uru, mudzi wa Akalidayo achitaka kuphiya tsi ya Kanani. Ela ariphofika Harani, achisagala phapho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        }
