          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya kuvyala Shela, Arifakisadi wasagala miaka magana mane na tahu na achikala akavyala ana anjina, alume na achetu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
