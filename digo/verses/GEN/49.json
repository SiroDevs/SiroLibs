              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya higo Jakobo waiha anae aaphe wasiya;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "49:1",
              "type": "text"
            },
            {
              "text": "Aaphe wasiya",
              "type": "text"
            },
            {
              "text": ": Maneno higa tagamo kpwenye tafasiri zanjina.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ariphokpwedza waambira, “Anangu mosi ndzoni phano ili nikuambireni mambo ndigokuphahani siku zedzazo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.1",
            "verseOrgIds": [
              "GEN.49.1"
            ]
          }
        }
      ]
    },
    {
