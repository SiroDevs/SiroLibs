          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ee, Mwenyezi Mlungu, nagodza wokofuo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.18",
            "verseOrgIds": [
              "GEN.49.18"
            ]
          }
        }
      ]
