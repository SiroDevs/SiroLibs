        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
