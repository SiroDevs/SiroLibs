            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enehu, mwimwi enye mnamanya kala charo chehu cha kpwedza kpwenu tachiyakala cha bure. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
          }
        },
        {
