              "1TH.4.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.51"
              },
              "items": [
                {
                  "text": "1 Akorintho 15:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.52"
              },
              "items": [
                {
                  "text": "52",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hiri hunarokuambirani ni fundzo ra Bwana Jesu kuhusu siku ndiphouya. Hakika swiswi ambao huchere moyo tahundaphiya mlunguni kabila ya hara ariofwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Bwana Jesu mwenye andatserera kula mlunguni na kulavya malagizo kpwa sauti kulu. Sauti ya malaika mkpwulu indasikirwa na gunda ra Mlungu rindapigbwa. Nao ndiofufuka mwandzo andakala hara ariofwa na kuno anamkuluphira Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naswi ndiokala huchere moyo wakati hinyo hundakusanywa phamwenga nao hiko mainguni kumchinjira Bwana Jesu. Phahi hundakala phamwenga na Bwana Jesu hata kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo, atiyeni moyo ayawenu na maneno higa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
