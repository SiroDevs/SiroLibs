              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.56"
              },
              "items": [
                {
                  "text": "Zaburi 56",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi waririkana higo maneno ambago kala ganagombwa na gachimuhenda aogophe sana Akishi mfalume wa Gathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.12",
            "verseOrgIds": [
              "1SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34"
              },
              "items": [
                {
                  "text": "Zaburi 34",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phapho hipho mbere za atu osi wabadilisha tabiyaye, achidzihenda ana koma ariphokala mwao mikononi. Achikuna-kuna mbao za mryango, kuno akarichira nyuhe zinachunjurika dzulu ya cheruche. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.13",
            "verseOrgIds": [
              "1SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho hiye Akishi achiaambira higo maofisaage, “Munaona kukala hiyu mutu ana koma, namwi mkamreha kpwangu? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.14",
            "verseOrgIds": [
              "1SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnanirehera mutu wa koma anionyese komaze phapha. Haya yuyu kandainjira mwangu nyumbani. Kpwani nahaja ya atu a koma?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.15",
            "verseOrgIds": [
              "1SA.21.15"
            ]
          }
        }
      ]
    }
