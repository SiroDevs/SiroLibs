                "loc": "MRK.2.25+MRK.2.26"
              },
              "items": [
                {
                  "text": "Mariko 2:25–26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.3"
              },
              "items": [
                {
                  "text": "Luka 6:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi Daudi waphiya Nobu kpwa mlavyadzi-sadaka yeihwa Ahimeleki. Ahimeleki waphiya kpwendamchinjira Daudi kuno anakakama kpwa wuoga, achimuuza, “Mbona ukedza hiku macheyo kuna myao?” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.1",
            "verseOrgIds": [
              "1SA.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi achimjibu mlavyadzi-sadaka Ahimeleki achimuamba, “Mfalume akanihuma shuuli, akaniamba, ‘Shuguli hino nchiyokuhuma na hiri neno ninarokuamuru, risimanywe ni mutu yeyesi,’ ndipho nkaalagiza atu angu hukakutane phatu fulani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.2",
            "verseOrgIds": [
              "1SA.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi una chitu chani phano? Nipha mikahe mitsano, au chochosi urichonacho.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.3",
            "verseOrgIds": [
              "1SA.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi yuya mlavyadzi-sadaka achimjibu Daudi achiamba, “Taphana mikahe ya kawaida, ela mikahe mitakatifu. Unaweza kuhala napho hinyo atuo taadzangbwelala na achetu vi dzuzi-dzuzi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.4",
            "verseOrgIds": [
              "1SA.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Daudi achimuambira mlavyadzi-sadaka, “Kpwa kpweli tahukalala na achetu hizi siku tahu. Tauhenda hivyo napho hunaphiya shuuli ya kawaida, phahi hino ya rero ambavyo ni malumu hukadziika atakatifu zaidi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.5",
            "verseOrgIds": [
              "1SA.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5+LEV.24.6+LEV.24.7+LEV.24.8+LEV.24.9"
              },
              "items": [
                {
                  "text": "Alawi 24:5–9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi ye mlavyadzi-sadaka achimupha iyo mikahe mitakatifu; kpwa mana takuyakala na mikahe isiphokala iyo mikahe ya kuikpwa mbere za Mlungu, nayo ikauswa kula mbere za Mwenyezi Mlungu, ili itiywe mikahe ya moho ya siku hiyo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.6",
            "verseOrgIds": [
              "1SA.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo phakala na mtumishi mmwenga wa Sauli, yekala anatimiza ada za chidini pho mbere za Mwenyezi Mlungu, dzinare ni Doegi, Muedomu, yekala mkpwulu wa arisa a Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.7",
            "verseOrgIds": [
              "1SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Daudi achimuuza Ahimeleki, “Kuna fumo au upanga phano? Kpwa mana sedzere na upanga wala silaha zangu zanjina kpwa kukala hino shuuli ya mfalume ikakala ya wangbwi-wangbwi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.8",
            "verseOrgIds": [
              "1SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.51"
              },
              "items": [
                {
                  "text": "1 Samueli 17:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuya mlavyadzi-sadaka achiamba, “Upanga wa Goliathi yuya Mfilisti uriyemuolaga Dete ra Ela, ndio urio phapha, ukafungbwa ndani ya nguwo nyuma ya chisibao. Ichikala unalonda kuuhala, haya hala, mana hipha taphana wanjina isiphokala uho tu.” Daudi achiamba, “Nipha mana takuna wanjina mnono dza uho.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.9",
            "verseOrgIds": [
              "1SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Daudi wachimbira siku hiyo, kpwa kumuogopha Sauli, achiphiya kpwa Akishi, mfalume wa Gathi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.10",
            "verseOrgIds": [
              "1SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.7"
              },
              "items": [
                {
                  "text": "1 Samueli 18:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.5"
              },
              "items": [
                {
                  "text": "29:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Maafisa a mfalume Akishi achiuza, “Dze! Yuno siye yuya Daudi, mfalume wa iyo tsi yao? Avi yuno ndiye ambaye Aiziraeli amuimbira kpwa kuvumikizana kuno anamuvwinira kpwenye ngoma zao achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.21.11",
            "verseOrgIds": [
              "1SA.21.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
