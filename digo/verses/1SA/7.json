                  "text": "2 Samueli 6:2–4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.13.5+1CH.13.6+1CH.13.7"
              },
              "items": [
                {
                  "text": "1 Nyakati 13:5–7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hinyo atu a Kiriathi-Jearimu akpwedza na achiritsukula sanduku ra Mwenyezi Mlungu, achendariika ndani ya nyumba ya Abinadabu iriyokala dzulu ya mwango nao achimtsambula mwanawe Eliazari ili arinde hiro sanduku ra Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.1",
            "verseOrgIds": [
              "1SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ro sanduku ra Mwenyezi Mlungu raphirikpwa Kiriathi-Jearimu ambako rabaki kuko muda mure, miaka kama mirongo miiri hivi. Nayo nyumba yosi ya Iziraeli yamririra Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.2",
            "verseOrgIds": [
              "1SA.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Samueli achiaambira Aiziraeli, “Ichikala munamuuyira Mwenyezi Mlungu kpwa mioyo yenu yosi, phahi yuuseni tsetsetse yo milungu yenu mijeni na vizuka vya Ashitorethi viuke kpwenu, na muelekeze mioyo yenu kpwa Mwenyezi Mlungu, mukamhumikire iye macheye, naye andakuokolani kula kpwa mikono ya Afilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.3",
            "verseOrgIds": [
              "1SA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Aiziraeli achiyuusa yo milungu ya Baali na ya Ashitorethi, achimuhumikira Mwenyezi Mlungu macheye.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.4",
            "verseOrgIds": [
              "1SA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Samueli waamba, “Aiziraeli osi naakusanyike hiko Mizipa nami ndaavoyera kpwa Mwenyezi Mlungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.5",
            "verseOrgIds": [
              "1SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi akusanyika hiko Mizipa nao aheka madzi achigamwaga mbere za Mwenyezi Mlungu. Siku iyo afunga achiamba, “Hukahenda dambi mbere za Mwenyezi Mlungu.” Naye Samueli achiamula Aiziraeli hiko Mizipa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.6",
            "verseOrgIds": [
              "1SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti ariphosikira kukala ana a Iziraeli akakusanyika hiko Mizipa, akulu a Afilisti aambuka dzulu ili akapigane na Iziraeli. Nao ana a Iziraeli ariphosikira aredza ashambuliwe ni Afilisti, aogopha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.7",
            "verseOrgIds": [
              "1SA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Aiziraeli achimuambira Samueli, “Usiriche kumririra Mwenyezi Mlungu, Mlungu wehu, kpwa ajili yehu, ili ahutivye kula mikononi mwa Afilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.8",
            "verseOrgIds": [
              "1SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Samueli wahala mwana ngʼondzi mtsanga, achimlavira Mwenyezi Mlungu sadaka ya kuochwa ndzima. Samueli achimririra Mwenyezi Mlungu kpwa ajili ya Iziraeli; naye Mwenyezi Mlungu achimwihikira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.9",
            "verseOrgIds": [
              "1SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho Samueli ariphokala anailavya iyo sadaka ya kuochwa, Afilisti asengera ili kupigana na Aiziraeli; ela siku iyo Mwenyezi Mlungu waapigira chiguruguru Afilisti, msindo mkpwulu sana, achiogofyerwa nao achiangamizwa ni Aiziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.10",
            "verseOrgIds": [
              "1SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao Aiziraeli atuluka hipho Mizipa, achialunga Afilisti, achiapiga hadi kutsapa Bethi-Kari.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.11",
            "verseOrgIds": [
              "1SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alafu Samueli wahala dziwe, achiriimisa kahi-kahi ya Mizipa na Sheni naro dzinare wariiha Ebenezeri",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:12",
              "type": "text"
            },
            {
              "text": "Ebenezeri",
              "type": "text"
            },
            {
              "text": "Manaye ni",
              "type": "text"
            },
            {
              "text": "Dziwe ra kuterya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " achiamba, “Mwenyezi Mlungu akahuterya hadi hipha.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.12",
            "verseOrgIds": [
              "1SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo Afilisti ashindwa, taayainjira tsona ndani ya miphaka ya Iziraeli na uwezo wa Mwenyezi Mlungu wakala chinyume cha Afilisti siku zosi za Samueli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.13",
            "verseOrgIds": [
              "1SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo midzi hira Afilisti ariyokala akaafuta Aiziraeli yauyizwa tsona kpwa enye. Midzi iyo kala i kahi-kahi ya Ekironi na Gathi, nao Aiziraeli autivya mphaka wao kula mikononi mwa Afilisti. Chisha kpwakala na amani kahi ya Iziraeli na Aamori.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.14",
            "verseOrgIds": [
              "1SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye hiye Samueli waamula Iziraeli maishage gosi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.15",
            "verseOrgIds": [
              "1SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chila mwaka kala achizunguluka Betheli, Giligali na Mizipa kuamula Aiziraeli kosi hiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.16",
            "verseOrgIds": [
              "1SA.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha kala achiuya hadi Rama, mana hipho ndipho phariphokala phakpwe kaya. Napho ndipho ariphoamula Aiziraeli na phapho ndipho ariphomdzengera Mwenyezi Mlungu phatu pha kulavira sadaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.7.17",
            "verseOrgIds": [
              "1SA.7.17"
            ]
          }
        }
      ]
    }
  ],
