          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1CH 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uriya Muhiti, Zabadi mwana wa Ahilai, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.41",
            "verseOrgIds": [
              "1CH.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1CH 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adina mwana wa Shiza Murubini, mkpwulu wa mbari ya Arubini, na atu mirongo mihahu phamwenga naye, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.42",
            "verseOrgIds": [
              "1CH.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1CH 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani mwana wa Maaka, na Joshafati Mmithini, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.43",
            "verseOrgIds": [
              "1CH.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1CH 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziya Muashiterati, Shama na Jeieli ana a Hothamu kula Aroeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.44",
            "verseOrgIds": [
              "1CH.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "1CH 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jediaeli na mwanao Joha, ana a Shimuri, Mutizi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.45",
            "verseOrgIds": [
              "1CH.11.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "1CH 11:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elieli Mmahawi, na Jeribai na Joshavia ana a Elinaamu, na Ithima kula Moabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.46",
            "verseOrgIds": [
              "1CH.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
