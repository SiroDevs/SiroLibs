          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hurai kula vidzuho vya Gaashi, Abieli kula Araba, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.32",
            "verseOrgIds": [
              "1CH.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azimawethi kula Baharumu, Eliahiba kula Shaaliboni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.33",
            "verseOrgIds": [
              "1CH.11.33"
            ]
          }
        },
        {
