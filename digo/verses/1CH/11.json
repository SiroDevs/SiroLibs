          },
          "items": [
            {
              "text": "11:34",
              "type": "text"
            },
            {
              "text": "Kulengana na 2 Samueli 23:25: Chieburania",
              "type": "text"
            },
            {
              "text": "ana a Hashemu",
              "type": "text"
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kula Gizoni, Jonathani mwana wa Shage kula Harari, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.11.34",
            "verseOrgIds": [
              "1CH.11.34"
            ]
          }
        },
        {
          "name": "verse",
