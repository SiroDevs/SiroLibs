              "items": [
                {
                  "text": "1 Afalume 4:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume Selemani wakusanya magari ga kuvwehwa ni farasi na anajeshi akuhumira farasi. Magarige kala ni elufu mwenga na magana mane na anajeshi akuhumira farasi elufu kumi na mbiri ambao waaika kpwenye midzi yenye vituwo vya magari ga kuvwehwa ni farasi na hiko Jerusalemu arikokala. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.26",
            "verseOrgIds": [
              "1KI.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.17"
              },
              "items": [
                {
                  "text": "Kumbukumbu 17:17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalume wahenda feza na zahabu zikale mayamaya dza mawe ko Jerusalemu. Mierezi nayo achiihenda ikale minji dza mihi ya mikuyu yokala tsi ya kugbwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.27",
            "verseOrgIds": [
              "1KI.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.16"
              },
              "items": [
                {
                  "text": "Kumbukumbu 17:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Farasi a Selemani nao arehwa kula Misiri na Kue.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:28",
              "type": "text"
            },
            {
              "text": "Tafusiri zanjina zinaamba",
              "type": "text"
            },
            {
              "text": "Kilikia.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Nyo ahendadzi-bishara a mfalume akpwendaagula kula Kue. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.28",
            "verseOrgIds": [
              "1KI.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bei ya gari mwenga ra kuvwehwa ni farasi kala ni vipande",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "10:29",
              "type": "text"
            },
            {
              "text": "Tafusiri zanjina zahumira",
              "type": "text"
            },
            {
              "text": "shekeli",
              "type": "text"
            },
            {
              "text": "badala ya",
              "type": "text"
            },
            {
              "text": "vipande.",
              "type": "text"
            }
          ]
        },
        {
          "text": " magana sita vya feza ko Misiri na farasi mmwenga kala ni vipande gana mwenga na mirongo mitsano. Chisha hinyo ahendadzi-bishara a mfalume kala achiaguzira afalume osi a Ahiti na a Aaramu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.10.29",
            "verseOrgIds": [
              "1KI.10.29"
            ]
          }
        }
