          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Viratu vira Hiramu watengeza nyungu, miko ya kudzengera na mabakuli. Phahi, Hiramu wamala kazi zosi za nyumba ya Mwenyezi Mlungu ariyolagizwa ni mfalume Selemani:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.7.40",
            "verseOrgIds": [
              "1KI.7.40"
            ]
          }
        }
      ]
