          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo ganjina ga Nadabu na gosi arigohenda gaandikpwa kpwenye chitabu cha Kumbukumbu za afalume a Iziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume Asa wa Juda na mfalume Baasha wa Iziraeli akala na viha kahi yao siku zao zosi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
