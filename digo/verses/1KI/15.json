          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwaka wa hahu wa utawala wa Asa mfalume wa Juda, Baasha mwana wa Ahija, waandza kuitawala Iziraeli hiko Tirisa. Watawala muda wa miaka mirongo miiri na mine. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.33",
