              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu achimuambira Musa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
