              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.16+DEU.12.17+DEU.12.18+DEU.12.19+DEU.12.20+DEU.12.21+DEU.12.22+DEU.12.23"
              },
              "items": [
                {
                  "text": "Kumbukumbu 12:16–23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mutu yeyesi akale Muiziraeli au mjeni, asagalaye kahi yenu achirya milatso yoyosi, nindamtsukirirwa naye ni atengbwe kure na atue. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.22"
              },
              "items": [
                {
                  "text": "Aeburania 9:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Indakala hivyo kpwa mana uzima wa chiumbe u ndani ya milatso. Nkakulagizani kulavya milatso phatu pha kulavira sadaka ili kudzihendera upatanisho, kpwa kukala milatso ndiyo ihenderayo mutu upatanisho wa kumuusira dambi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyo mana nkakulagizani hivi mwi Aiziraeli nchiamba, ‘Mutu yeyesi kahi yenu au mjeni asagalaye kahi yenu asirye milatso.’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutu yeyesi akale Muiziraeli au mjeni, asagalaye kahi yenu achendaindza nyama au nyama wa mapha ambao ni a kuriwa, analondwa kumwaga milatso photsi na kuisirira na mtsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
              "LEV.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana, uzima wa chila chiumbe u ndani ya milatsoye. Ndiyo mana nkakulagizani mwimwi Aiziraeli, ‘Msirye milatso ya chiumbe chochosi mana uzima wa chiumbe chochosi u ndani ya milatsoye. Yeyesi ndiyerya milatso ni atengbwe.’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.14",
            "verseOrgIds": [
              "LEV.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
