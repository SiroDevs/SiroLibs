              "items": [
                {
                  "text": "Kutsama 21:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mutu yeyesi ndiyeolaga myawe ni aolagbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.17",
            "verseOrgIds": [
              "LEV.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu yeyesi ndiyeolaga nyama wa myawe, ni amriphe na nyama wanjina. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.18",
            "verseOrgIds": [
              "LEV.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu yeyesi ndiyemlumiza myawe, naye ni alumizwe sawa-sawa na vira achivyomlumiza myawe: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.19",
            "verseOrgIds": [
              "LEV.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.21.23+EXO.21.24+EXO.21.25"
              },
              "items": [
                {
                  "text": "Kutsama 21:23–25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.21"
              },
              "items": [
                {
                  "text": "Kumbukumbu 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.38"
              },
              "items": [
                {
                  "text": "Mathayo 5:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "achimvundza mfupha naye andavundzwa mfupha, dzitso kpwa dzitso, dzino kpwa dzino. Chila mutu ndiyemlumiza myawe naye ni alumizwe dza vivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.20",
            "verseOrgIds": [
              "LEV.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyeolaga nyama wa myawe ni amriphe, ela mutu yeyesi ndiyeolaga mutu wanjina ni aolagbwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.21",
            "verseOrgIds": [
              "LEV.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.16"
              },
              "items": [
                {
                  "text": "Isabu 15:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mwimwi mosi mundalunga shariya hiyo, mjeni au mwenyezi. Mimi, ndimi Mwenyezi Mlungu, Mlungu wenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.22",
            "verseOrgIds": [
              "LEV.24.22"
            ]
          }
        }
      ]
    },
