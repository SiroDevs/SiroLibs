              "LEV.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Musa achiaambira Aiziraeli lagizo hiri, nao achimphirika yuya mutu yekufuru Mwenyezi Mlungu kondze ya kambi, achendampiga mawe hadi achifwa. Aiziraeli ahenda dza vira Mwenyezi Mlungu arivyomlagiza Musa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.23",
            "verseOrgIds": [
              "LEV.24.23"
            ]
          }
        }
      ]
