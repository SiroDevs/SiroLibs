        },
        {
          "text": "“Gbwirani na kutimiza malagizo gangu. Mimi, ndimi Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
