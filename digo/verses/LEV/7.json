              },
              "items": [
                {
                  "text": "Kumbukumbu 12:16–23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.23"
              },
              "items": [
                {
                  "text": "15:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Piya, msirye milatso yoyosi, ikale ni ya nyama wa mapha au ya nyama wa kufuga phophosi msagalapho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.26",
            "verseOrgIds": [
              "LEV.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu yeyesi achirya milatso, andatengbwa na atue.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.27",
