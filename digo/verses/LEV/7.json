              "LEV.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, higa ndigo malagizo kuhusu sadaka ya kuochwa, sadaka ya mtsere, sadaka ya kuusa dambi, sadaka ya kuusa makosa, sadaka ya kutenga mutu kpwa ajili ya Mlungu na kuhusu sadaka ya amani. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu wamupha Musa shariya hizi dzulu ya mwango Sinai siku iyo ariphoaamuru Aiziraeli amrehere sadaka zao, hiko jangbwa ra Sinai.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
