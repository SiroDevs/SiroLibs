              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Johana 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumendzana kpwehu kunaonyesa kala hwatuluka chifoni na huchiinjira uzimani. Mutu yeyesi asiyemmendza mfuasi myawe, bado achere chifoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyesi aziraye myawe ni muolagadzi, namwi mnamanya kala muolagadzi kandakala na uzima wa kare na kare. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
            "verseOrgIds": [
              "1JN.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu Masihi wadzilavya aolagbwe kpwa sababu yehu, hivyo ndivyo hunamanya mendzwa irivyo. Hata swiswi naswi hunalondwa humendze ayawehu, hata ichikala ni kufwa, hudzilavye huolagbwe kpwa sababu ya ayawehu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.16",
            "verseOrgIds": [
              "1JN.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu achikala na mali himu duniani, na aone mfuasi myawe ni mgbwayi kana chitu, ela asimuonere mbazi, kpwa kpweli mutu hiye kaweza kuamba ana mendzwa ya Mlungu mwakpwe moyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
              "1JN.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anangu, mendzwa yehu naisikale ya maneno mahuphu, ela nahumendzaneni na mendzwa ya kpweli ya mahendo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Huchikala na mendzwa ya mahendo, hundamanya kala hunalunga njira ya kpweli. Na hata huchimanya kala mwehu mioyoni huna makosa, hundaweza kuima mbere za Mlungu bila ya wuoga. Mana Mlungu ni mkpwulu kuriko maazo gehu, tsona anamanya chila chitu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19+1JN.3.20",
            "verseOrgIds": [
              "1JN.3.19",
              "1JN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asena angu, ichikala maazo gehu tagana lawama, phahi, hunaweza kukala bila ya wuoga mbere za Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1JN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naswi hunaweza kuvoya Mlungu chochosi, na akahupha kpwa sababu hunalunga malagizoge na kuhenda mambo gamhamirago. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
            "verseOrgIds": [
              "1JN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1JN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.34"
              },
              "items": [
                {
                  "text": "Johana 13:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na hivi ndivyo Mlungu arivyolagiza: humkuluphire Mwanawe Jesu Masihi na humendzane kama arivyolagiza. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.23",
            "verseOrgIds": [
              "1JN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1JN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu alungao malagizo ga Mlungu a phamwenga na Mlungu, naye Mlungu a phamwenga nao. Naswi huna hakika kala Mlungu a phamwenga naswi kpwa sababu Rohowe anaishi mwehu mioyoni.",
