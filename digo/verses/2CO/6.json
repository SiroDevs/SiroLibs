              "items": [
                {
                  "text": "Alawi 26:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.27"
              },
              "items": [
                {
                  "text": "Ezekieli 37:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Vizuka vina uhusiano wani na phatu pha kuvoya Mlungu? Mana swiswi ndio phatu phatakatifu photengbwa kuvoya Mlungu ariye moyo. Kama Mlungu arivyoamba:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
      ]
