                "loc": "DEU.25.3"
              },
              "items": [
                {
                  "text": "Kumbukumbu 25:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kano tsano nikapigbwa vikoto kano mirongo mine kasoro chimwenga ni Ayahudi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.24",
            "verseOrgIds": [
              "2CO.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CO 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.19"
              },
              "items": [
                {
                  "text": "Mahendo 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.22"
              },
              "items": [
                {
                  "text": "16:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kano tahu Arumi akanipiga milawa. Limwenga nikapigbwa mawe, kano tahu nikavudzikirwa ni meli baharini, na nchisala mumo baharini usiku na mutsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.25",
            "verseOrgIds": [
              "2CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CO 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.23"
              },
              "items": [
                {
                  "text": "Mahendo 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.5"
              },
              "items": [
                {
                  "text": "14:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwenye vyaro vyangu vinji, nikakutana na hatari za myuho, za anyangʼanyi, za Ayahudi ayangu na za atu asio kala Ayahudi. Piya nakala na hatari midzini, tsakani, baharini, na kula kpwa atu adzihendao dza afuasi ayangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.26",
            "verseOrgIds": [
              "2CO.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikakala na kazi ngumu na tabu, siku nyinji nikakala matso bila usingizi. Nikakala na ndzala na chiru, bila chakurya cha kutosha. Tsona nikapigbwa ni mnyevu bila nguwo za kuvwala.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CO 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.27",
            "verseOrgIds": [
              "2CO.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CO 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Higo mbai, nakala na mzigo chila siku kpwa kujali makundi gosi ga afuasi a Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.28",
            "verseOrgIds": [
              "2CO.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu anaphokala mnyonje chiroho, nami nkusikira unyonjewe. Mutu anapholongozwa kuhenda dambi, nami nkusononeka sana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CO 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.29",
            "verseOrgIds": [
              "2CO.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CO 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichikala ni lazima kudzikarya, richa nidzikarye kuhusu mambo ganagoonyesa unyonje wangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.30",
            "verseOrgIds": [
              "2CO.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CO 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu, Baba wa Bwana Jesu atogolwaye hata kare na kare, anamanya sigomba handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.31",
            "verseOrgIds": [
              "2CO.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CO 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.23+ACT.9.24+ACT.9.25"
              },
              "items": [
                {
                  "text": "Mahendo 9:23–25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Niriphokala Damasikasi, mtawala ariyekala tsini ya Mfalume Areta, waika arindzi katika miryango ya midzi ili anigbwire. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.32",
            "verseOrgIds": [
              "2CO.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CO 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nátserezwa na bweko ririrotsupizwa dzitundu ra ukuta wa mudzi, na kpwa njira iyo nápona kugbwirwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
            "verseOrgIds": [
              "2CO.11.33"
            ]
          }
        }
      ]
