            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.22",
            "verseOrgIds": [
              "PHP.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navoya Bwana wehu Jesu Masihi akujaliyeni mosi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.4.23",
            "verseOrgIds": [
              "PHP.4.23"
            ]
          }
        }
      ]
