              "GAL.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.9.26+ACT.9.27+ACT.9.28+ACT.9.29+ACT.9.30"
              },
              "items": [
                {
                  "text": "Mahendo 9:26–30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya miaka mihahu, náphiya Jerusalemu kpwendamuona Petero, na nchisagala naye siku kumi na tsano. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtume wanjina yemuona hiko kala ni Jakobo bahi, mwanao wa Bwana Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuambirani kpweli mbere za Mlungu higa nagokuandikirani sigo ga handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.20",
            "verseOrgIds": [
              "GAL.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya kusagala Jerusalemu na Petero, náphiya jimbo ra Siria na ra Kilikia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.21",
            "verseOrgIds": [
              "GAL.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo kala sidzangbwekutana uso kpwa uso na makundi ga afuasi a Jesu ariokala Judea. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.22",
            "verseOrgIds": [
              "GAL.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kala taadzangbweniona ela kala ahendasikira kukala, “Ye mutu ambaye kala achihugayisa, ndipho anatangaza riro kuluphiro ambaro mwandzo kala analonda kuriangamiza.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
            "verseOrgIds": [
              "GAL.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 1:24"
          },
