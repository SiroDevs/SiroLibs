          "type": "text",
          "attrs": {
            "verseId": "GAL.3.9",
            "verseOrgIds": [
              "GAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
