            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwimwi mosi mu ana a Mlungu kpwa kukala mwamkuluphira Masihi Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mriphobatizwa kuonyesa kala mu a Jesu, mwaandza maisha maphya kuhenda tabiyaze. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taphana tafwauti ya Myahudi na Myunani, mtumwa wala mutu huru, mlume wala mchetu, mana mosi mu amwenga kpwa sababu ya Jesu Muokoli. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
