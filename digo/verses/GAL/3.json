                  "text": "Arumi 4:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ichikala mu a Jesu, phahi mu vivyazi vya Burahimu, na mundaphokera majaliwa arigolagbwa Burahimu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.29",
