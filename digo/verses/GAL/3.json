              "GAL.3.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.26"
              },
              "items": [
                {
                  "text": "Kumbukumbu 27:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu osi akuluphirao Shariya ana lana, mana Maandiko ganaamba, “Mutu yeyesi ambaye kandalunga na kuhenda chila chitu choandikpwa ndani ya Chitabu cha Shariya, ana lana!” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.10",
            "verseOrgIds": [
              "GAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.2.4"
              },
              "items": [
                {
                  "text": "Habakuki 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa kpweli takuna mutu aphahaye haki mbere za Mlungu kpwa kulunga Shariya, kpwa sababu Maandiko ganaamba, “Atu ndioishi ni hara ndiophaha haki kpwa kukuluphira.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.11",
            "verseOrgIds": [
              "GAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Alawi 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yo Shariya taina uhusiano wowosi na kuluphiro. Ela phatuphe, Maandiko ganaamba, “Mutu ndiyegbwira malagizo gosi ga Shariya andaishi kpwa sababu ya kulunga zizo Shariya.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.12",
            "verseOrgIds": [
              "GAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Kumbukumbu 21:23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shariya zinatiya lana, ela Jesu wahukombola na lana iyo kpwa kutiywa lana ye mwenye, ariphoolagbwa msalabani. Kama Maandiko gaambavyo, “Mutu yeyesi ndiyeolagbwa kpwa kutsomekpwa muhini andalaniwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.13",
            "verseOrgIds": [
              "GAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahenda hivyo ili gara majaliwa arigolagbwa Burahimu, gahewe atu asio kala Ayahudi piya. Phahi hunaphokera Roho Mtakatifu huriyelagbwa mana hunamkuluphira Jesu Muokoli.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.14",
            "verseOrgIds": [
              "GAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enehu, hebu nikupheni mfwano huno wa maisha ga chila siku: Atu airi achiphahana, na kutiirana saini, dze, ni ani awezaye kuiusa au kuigaluza? Vilagane vya Mlungu ni dza vivyo, tavigaluka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.15",
            "verseOrgIds": [
              "GAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.7"
              },
              "items": [
                {
                  "text": "Mwandzo 12:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mlungu waika chilagane hicho na Burahimu na uvyaziwe. Maandiko gachiamba “uvyaziwe” manage siyo “atu anji a uvyaziwe,” ela manage ni “mmwenga wa uvyaziwe.” Na ye hiye mmwenga niambaye ni Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.16",
            "verseOrgIds": [
              "GAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Kutsama 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Nalonda kuamba hivi: Mlungu waika chilagane na Burahimu. Shariya za Musa ambazo zalaviwa miaka magana mane na mirongo mihahu bada ya hicho chilagane, taziweza kuchifuta, wala kuusa chilagane cha Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.14"
              },
              "items": [
                {
                  "text": "Arumi 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mana ichikala zawadi ya Mlungu inaphahikana kpwa kulunga Shariya, phahi si lazima kukuluphira chilaganeche. Ela Mlungu wamupha Burahimu zawadi kpwa mbazize kpwa sababu ya hicho chilagane.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi Shariya za Musa kala zina mana yani? Shariya zaikpwa kutawala atu mana kawaida atu kala nkuhenda dambi. Nazo kala ni zikale hadi yuya chivyazi cha Burahimu yekala akalagbwa, edze. Mlungu walavya Shariya na Musa kutsupira kpwa malaika, naye Musa achikala mpatanishi wa Mlungu na atu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngudzi anatakikana wakati pande mbiri zinaika mapatano. Ela Mlungu ni mmwenga na ye mwenye waika chilagane na Burahimu bila ya mpatanishi.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, Shariya kala zinapinga chilagane cha Mlungu? Hata chidide! Ichikala Shariya inaweza kurehera anadamu uzima wa kare na kare, phahi atu angephaha haki kpwa kuzilunga. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.21",
            "verseOrgIds": [
              "GAL.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Maandiko ganaamba chila mutu nkuhenda dambi na kaweza kuishi kulengana na Shariya. Ndio mana Mlungu walaga kuapha atu amukuluphirao Jesu Masihi uzima wa kare na kare.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Swiswi Ayahudi kala hukafungbwa ni Shariya dza mabusu, hadi huriphongʼazwa matso kala mutu anaphaha uzima wa kare na kare kpwa kumkuluphira Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Shariya kala ni mtawala wehu hadi Jesu ariphokpwedza, ndipho huphahe haki mbere za Mlungu kpwa kumkuluphira. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambi kpwa vira hwamkuluphira Jesu, tahutawalwa tsona ni Shariya.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
    },
    {
