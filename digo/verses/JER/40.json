            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.22+2KI.25.23+2KI.25.24"
              },
              "items": [
                {
                  "text": "2 Afalume 25:22–24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akulu osi a majeshi na vikosi vyao ariodzifwitsa ko tsi ya kugbwa wakati wa viha asikira kukala mfalume wa Babeli kala akatsambula Gedalia mwana wa Ahikamu kukala liwali kahi ya yo tsi. Piya asikira kala akamuika chilongozi wa alume, achetu na anache ambao kala ni achiya kpwenye yo tsi, ambao taaharirwe mateka kuphirikpwa Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho achedza kpwa Gedalia ko Mizipa. Aho kala ni Isimaili mwana wa Nethania, Jonathani na Johanani ana a Karea, Seraya mwana wa Tanihumethi, ana a Efai Munetofa, Jezaniya kula Maaka, aho osi na vikosi vyao. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.8",
            "verseOrgIds": [
              "JER.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gedalia mwana wa Ahikamu, mdzukulu wa Shafani waapira aho na vikosi vyao achiamba, “Msiogophe kuahumikira Akalidayo, sagalani mumu tsini na mumuhumikire mfalume wa Babeli na mambo genu gandakuphihiranito. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.9",
            "verseOrgIds": [
              "JER.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mimi nindasala Mizipa nkuwakilisheni mbere za Akalidayo ndiohutsolokera. Ela mwimwi siyani uchi wa zabibu, mvune matunda ga wakati wa vuri, mtengeze mafuha ga zaituni, mgatiye miyoni na msagale kpwenye midzi mriyoihala.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.10",
            "verseOrgIds": [
              "JER.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo, Ayahudi ariokala Moabu, Amoni, Edomu na tsi zosi ariphosikira kukala mfalume wa Babeli kala akaricha atu ko Juda na achitsambula Gedalia mwana wa Ahikamu mdzukulu wa Shafani, akale mtawala wao, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.11",
            "verseOrgIds": [
              "JER.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "osi auya kula kokala akatsamukana achiphiya tsi ya Juda kpwa Gedalia ko Mizipa. Achendavuna zabibu na matunda ga vuri kpwa unji.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.12",
            "verseOrgIds": [
              "JER.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Johanani mwana wa Karea na vilongozi osi a jeshi ariodzifwitsa ko weruni, akpwedza kpwa Gedalia ko Mizipa ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "achimuamba, “Unamanya kukala mfalume Baalisi wa Aamoni akahuma Isimaili mwana wa Nethania edze akuolage?” Ela Gedalia mwana wa Ahikamu kayaamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Johanani wamuiha njama Gedalia ko Mizipa achimuamba, “Niricha nikamuolage Isimaili mwana wa Nethania na taphana ndiyemanya. Kpwa utu wani akuolage na kuahenda Ayahudi osi achiokukuluphira atsamuke na atu a Juda asereo aangamike?” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Gedalia mwana wa Ahikamu achimuamba Johanani mwana wa Karea, “Usimuolage, unagomba handzo, Isimaili kaweza kuhenda dzambo dza hiro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
    }
