              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo, lola, ndakuusani phamwenga na nyo mudzi nriokuphani mwimwi na akare enu nikakutsupheni kure nami. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.23.39",
            "verseOrgIds": [
              "JER.23.39"
            ]
          }
        },
