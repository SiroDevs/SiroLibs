                {
                  "text": "2 Nyakati 36:5–7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.1+DAN.1.2"
              },
              "items": [
                {
                  "text": "Danieli 1:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gaga ndigo maneno garigogombwa ni nabii Jeremia mwaka wa ne wa utawala wa Jehoyakimu mwana wa Josiya mfalume wa Juda, naye Baruku mwana wa Neriya kala anagaandika chitabuni, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwenyezi Mlungu, Mlungu wa Iziraeli anakuamba uwe Baruku: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
            "verseOrgIds": [
              "JER.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe waamba, ‘Shaka rani mino! Mana ye Mwenyezi Mlungu akaniengerezera sonono kahi ya shida nrizo nazo. Nikaremwa kuula wala siona baha.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Mwenyezi Mlungu akaniambira nikuambe hivi, ‘Lola, chila nrichodzenga ndachibomola na nrichophanda ndachingʼola, kahi za tsi yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.4",
            "verseOrgIds": [
              "JER.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, unadzilondera mambo makulu? Usigalonde, mana nindaarehera atu osi mashaka, ela ndativya maishago kpwahali kokosi ambako undaphiya. Nayo indakala ni zawadiyo, mimi Mwenyezi Mlungu nkaamba.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.5",
            "verseOrgIds": [
              "JER.45.5"
            ]
          }
        }
      ]
    }
