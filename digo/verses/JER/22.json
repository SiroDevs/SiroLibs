                "loc": "2CH.36.1+2CH.36.2+2CH.36.3+2CH.36.4"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:1–4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi kuhusu Shalumu",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:11",
              "type": "text"
            },
            {
              "text": "Dzina ranjina ra mfalume Shalumu ni mfalume Jehoahazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mwana wa mfalume Josiya wa Juda ariyetawala badala ya ise ela achitsamizwa kpwa lazima, Mwenyezi Mlungu anaamba, “Kandauya ngʼo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu iye andafwerera ko arikotsamizwa kpwa lazima na tsi ihi kandaiona tsona.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
      ]
    },
