            "caller": "#"
          },
          "items": [
            {
              "text": "\n        2 Afalume 23:36—24:6",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.5+2CH.36.6+2CH.36.7"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:5–7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa hivyo kuhusu Jehoyakimu mwana wa mfalume Josiya wa Juda Mwenyezi Mlungu anaamba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        }
