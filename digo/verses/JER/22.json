                "loc": "2KI.24.8+2KI.24.9+2KI.24.10+2KI.24.11+2KI.24.12+2KI.24.13+2KI.24.14+2KI.24.15"
              },
              "items": [
                {
                  "text": "2 Afalume 24:8–15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.9+2CH.36.10"
              },
              "items": [
                {
                  "text": "2 Nyakati 36:9–10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mwenyezi Mlungu anaamba, kpweli dza niishivyo, mfalume Konia, mwana wa Jehoyakimu, mfalume wa Juda, hata kala u pehe nivwalayo dza muhuri wa mfalume, ningekutuluza kula mwangu chalani. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.24",
            "verseOrgIds": [
              "JER.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkakutiya mikononi mwa nyo alondao kukutuluza uhai, mikononi mwa atu akuogofyerao. Nindakutiya mikononi mwa mfalume Nebukadineza wa Babeli na mikononi mwa Akalidayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.25",
            "verseOrgIds": [
              "JER.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindakuzolani, uwe na mayoo ariyekuvyala mphiye tsi ambayo tamyavyalwa, mkafwerere kuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwi tamundauya tsetsetse tsi ambayo mundakala munaiaza.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        }
