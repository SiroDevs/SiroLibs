            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tangazani ko Juda na mkote kululu ko Jerusalemu muambe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.4.5",
            "verseOrgIds": [
              "JER.4.5"
            ]
