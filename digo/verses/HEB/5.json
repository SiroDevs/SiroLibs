                {
                  "text": "Mariko 14:32–42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.39+LUK.22.40+LUK.22.41+LUK.22.42+LUK.22.43+LUK.22.44+LUK.22.45+LUK.22.46"
              },
              "items": [
                {
                  "text": "Luka 22:39–46",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ariphokala hipha duniani, Jesu wavoya sana Mlungu kpwa raka ra dzulu na kurira, mana kala anamanya kukala Mlungu ana uwezo wa kumtivya na chifo. Wamuogopha Mlungu kpwa chila njira, naye achiphokera mavoyoge. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.7",
            "verseOrgIds": [
              "HEB.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata dzagbwe kala akatsambulwa ni Mlungu akale Mwanawe, wadzifundza kuhenda vira Mlungu alondavyo kula kpwa go mateso arigophaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.8",
            "verseOrgIds": [
              "HEB.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariphokala akahendwa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9+HEB.5.10",
            "verseOrgIds": [
              "HEB.5.9",
              "HEB.5.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:9–10",
              "type": "text"
            },
            {
              "text": "Chiyunani chinaamba,",
              "type": "text"
            },
            {
              "text": "Ariphohendwa mkamilifu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mkamilifu kpwa njira hino, Mlungu wamuhenda akale mlavyadzi-sadaka mkpwulu sawa na ulavyadzi-sadaka wa Melikisedeki.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.9+HEB.5.10",
            "verseOrgIds": [
              "HEB.5.9",
              "HEB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
