              "items": [
                {
                  "text": "Zaburi 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivyo hivyo Jesu kayadziunula kpwa kudzipha mwenye nguma ya kukala mlavyadzi-sadaka mkpwulu, ela watsambulwa ni Mlungu. Mana ye Mlungu wamuamba, “Uwe u Mwanangu, rero nikakala sowe.”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.5.5",
            "verseOrgIds": [
              "HEB.5.5"
            ]
          }
        }
      ]
    },
