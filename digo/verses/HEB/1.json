          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu wamuhenda Mwanawe akale mkpwulu kuriko malaika dza vira arivyomupha dzina ririro kulu kutsupa rira ra malaika. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.4",
            "verseOrgIds": [
              "HEB.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
