              },
              "items": [
                {
                  "text": "Zaburi 104:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na iye ariphogomba kuhusu malaika, waamba, “Uwe ukuhenda malaikao akakala dza phuto, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:7",
              "type": "text"
            },
            {
              "text": "Chiyunani neno ririrohumirwa hipha rina mana ya roho au phuto.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na ukuahenda atumishio akakala dza moho wa kuaka.” ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.1.7",
            "verseOrgIds": [
              "HEB.1.7"
            ]
          }
        },
