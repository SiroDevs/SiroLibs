                "loc": "PSA.2.7"
              },
              "items": [
                {
                  "text": "Zaburi 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.14"
              },
              "items": [
                {
                  "text": "2 Samueli 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
