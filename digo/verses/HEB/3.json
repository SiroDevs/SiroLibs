                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ano ani nyo ariosikira na achirema maneno ga Mlungu? Ni hara ariolongozwa ni Musa kula Misiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.16",
            "verseOrgIds": [
              "HEB.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na dze nyo ariomreyeza Mlungu miaka mirongo mine nao? Avi ni aho ariohenda dambi hata achifwa weruni. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.17",
            "verseOrgIds": [
              "HEB.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ano ani ambao Mlungu waapa kukala kandaaruhusu kuinjira phatuphe pha kuoya? Ni hara ariorema kumuogopha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.18",
            "verseOrgIds": [
              "HEB.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo hunamanya atu hinyo akosa kuinjira phatu hipho kpwa sababu ya kusakuluphira kpwao.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.19",
            "verseOrgIds": [
              "HEB.3.19"
            ]
          }
        }
