                {
                  "text": "Zaburi 95:7–8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kama Maandiko ganavyoamba:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.15",
            "verseOrgIds": [
              "HEB.3.15"
            ]
          }
        }
