              "HEB.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enehu, dzimanyirireni sedze hata mmwenga wenu akakala na moyo wenye maazo mai na kusakuluphira, na kpwa kuhenda hivyo, andadzitenga na Mlungu ariye moyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.12",
            "verseOrgIds": [
              "HEB.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela chila mmwenga na amutiye myawe moyo chila siku hunayoyiiha “rero”",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:13",
              "type": "text"
            },
            {
              "text": "Neno",
              "type": "text"
            },
            {
              "text": "Rero",
              "type": "text"
            },
            {
              "text": "rinahumirwa kpwa mana ya wakati wosi ambao atu achere na nafwasi ya kumkuluphira Mlungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ili mutu asedze akachengbwa akauya dambini, na akakala na moyo mufu kpwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana hunashiriki gosi phamwenga na Jesu, ichikala hunadinisa kugbwiririra kuluphiro hurirokala naro kula mwandzo hadi mwisho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
