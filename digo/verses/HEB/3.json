              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi kama Roho Mtakatifu anavyoamba:",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.7",
            "verseOrgIds": [
              "HEB.3.7"
