              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume wa Misiri kayatuluka tsona kula tsiiye, kpwa sababu mfalume wa Babeli kala akamfuta seemu zosi ambazo pho mwandzo kala ni mali ya mfalume wa Misiri, kuandzira chidzuho cha Misiri hadi muho Yufurati.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakini kala ana miaka minane ariphoandza kutawala. Watawala ko Jerusalemu kpwa muda wa miezi mihahu. Nine waihwa Nehushita, mwana mchetu wa Elinathani, kula Jerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakini wahenda mai mbere za Mwenyezi Mlungu dza vyo ise arivyohenda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati hinyo jeshi ra Nebukadineza mfalume wa Babeli akpwedza Jerusalemu na kuuzangira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshi ririphokala rikauzangira mudzi, Nebukadineza mwenye mfalume wa Babeli wainjira Jerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.22.24+JER.22.25+JER.22.26+JER.22.27+JER.22.28+JER.22.29+JER.22.30"
              },
              "items": [
                {
                  "text": "Jeremia 22:24–30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.1+JER.24.2+JER.24.3+JER.24.4+JER.24.5+JER.24.6+JER.24.7+JER.24.8+JER.24.9+JER.24.10"
              },
              "items": [
                {
                  "text": "24:1–10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.1+JER.29.2"
              },
              "items": [
                {
                  "text": "29:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "na Jehoyakini mfalume wa Juda wadzilavya kpwa mfalume wa Babeli, ye mwenye phamwenga na nine, ahendadzi-kazie, akulu na majemedarige. Mfalume wa Babeli waahala mateka kahi za mwaka wa nane wa kutawalwakpwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona dza vyo Mwenyezi Mlungu arivyogomba, Nebukadineza wahala mali yosi yokala ndani ya nyumba ya Mwenyezi Mlungu, na ndani ya nyumba ya chifalume. Wakata miyo yosi ya zahabu ambayo Selemani mfalume wa Iziraeli watengeza. Miyo iyo yakala ndani ya Nyumba ya kuvoya Mlungu ya Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wahala atu osi a Jerusalemu, akulu osi, atu osi ariokala masujaa, afungbwa elufu kumi, na mafundi osi na afuladzi a vyuma. Takuna ariyesala isiphokala hara ariokala achiya kabisa kpwenye iyo tsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.17.12"
              },
              "items": [
                {
                  "text": "Ezekieli 17:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Amphirika Jehoyakini hadi Babeli phamwenga na nine, achee, akulu a jeshire, na akulu osi a tsi. Hinyo waahala mateka kula Jerusalemu achiaphirika Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza mfalume wa Babeli waahala mateka atu masujaa a Juda, jumula yao atu elufu sabaa phamwenga na mafundi hodari na afuladzi a vyuma elufu mwenga, osi hinya kala ni atu enye mkpwotse na a kuweza kupigana viha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        }
      ]
    },
