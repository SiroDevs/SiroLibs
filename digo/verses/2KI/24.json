              "items": [
                {
                  "text": "Danieli 1:1–2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati Jehoyakimu anatawala, Nebukadineza mfalume wa Babeli waambuka achendashambuliya tsi ya Juda. Jehoyakimu wamuhumikira kpwa miaka mihahu, halafu achimgalukira, na achimuasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi, Mwenyezi Mlungu wamuhumira makundi ga Ababeli, Aaramu, Amoabu na Aamoni achishambuliya tsi ya Juda na kuibananga, sawa-sawa na neno Mwenyezi Mlungu arirogomba kutsupira atumishie ambao ni manabii. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakika mambo higa gaifikira tsi ya Juda kpwa lagizo ra Mwenyezi Mlungu, kuatsamiza kula mbere za usowe, kpwa sababu ya dambi za mfalume Manase na gosi arigogahenda, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kpwa sababu waolaga atu anji asiokala na makosa, achiodzaza Jerusalemu milatso ya atu hinyo. Mwenyezi Mlungu kayakubali kumswamehe makosa higo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mahendo ganjina ga Jehoyakimu na gosi arigohenda gaandikpwa kpwenye chitabu cha mahendo ga afalume a Iziraeli na Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakimu wafwa, na mwanawe Jehoyakini",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:6",
              "type": "text"
            },
            {
              "text": "Jehoyakini",
              "type": "text"
            },
            {
              "text": "piya anaihwa",
              "type": "text"
            },
            {
              "text": "Jekonia.",
              "type": "text"
            }
          ]
        },
        {
          "text": " achitawala badalaye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
