          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jothamu wafwa na achizikpwa vikurani pha akaree ko mudzi wa Daudi. Mwanawe Ahazi achitawala badalaye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.38",
