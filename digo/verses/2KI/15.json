              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo ganjina ga Jothamu na gosi arigohenda, gaandikpwa kpwenye chitabu cha mahendo ga afalume a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
