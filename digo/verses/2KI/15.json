          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahendo ganjina gosi ga Zakariya gaandikpwa kpwenye Chitabu cha Mambo ga Nyakati za Afalume a Iziraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11",
