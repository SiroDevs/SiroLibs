          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakati wa utawala wa Jothamu, Mwenyezi Mlungu waandza kumhuma mfalume Resini wa Aramu na mfalume Peka wa Iziraeli, mwana wa Remaliya, kushambuliya tsi ya Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.37",
            "verseOrgIds": [
              "2KI.15.37"
            ]
          }
        },
