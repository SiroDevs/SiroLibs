              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahendo ganjina gosi ga Ahazi gaandikpwa kpwenye chitabu cha mahendo ga afalume a Juda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.28"
              },
              "items": [
                {
                  "text": "Isaya 14:28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ahazi wafwa na achizikpwa phamwenga na akaree kpwenye mudzi wa Daudi, naye mwanawe Hezekiya achikala mfalume badalaye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
