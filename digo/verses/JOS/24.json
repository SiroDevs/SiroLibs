          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bada ya mambo higa, Joshuwa mwana wa Nuni na mtumishi wa Mwenyezi Mlungu, wafwa wakati ana miaka gana mwenga na kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.19.49+JOS.19.50"
              },
              "items": [
                {
                  "text": "Joshuwa 19:49–50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye achizikpwa kpwenye tsi yokala akaganyirwa hiko Timunathi-Sera kahi ya myango ya Efuraimu, vurini mwa mwango Gaashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        }
