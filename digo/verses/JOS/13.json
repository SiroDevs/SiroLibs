          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Musa kala akaapha urisi nusu ya mbari ya Manase kulengana na miryango yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
