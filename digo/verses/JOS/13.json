          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yao ya tsi yohewa yaandzira Mahanaimu ichitsanganya tsi yosi yokala utawala wa mfalume Ogi yekala Bashani, phamwenga na midzi mirongo sita ya Jairi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
