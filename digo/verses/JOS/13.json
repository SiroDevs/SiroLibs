                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.12"
              },
              "items": [
                {
                  "text": "Kumbukumbu 3:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mbari za Rubini, Gadi na nusu yanjina ya mbari ya Manase kala zikahewa tsi iriyo mlairo wa dzuwa wa muho Joridani ikale urisi wao dza vyo Musa mtumishi wa Mwenyezi Mlungu arivyoaganyira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu yao yaandzira Aroeri kanda-kanda ya Dete ra Arinoni na mudzi hura uriokala kahi-kahi ya dete, tsi yosi ya kugbwa hangu Medeba hadi Diboni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha mphaka waenderera kula midzi yosi ya mfalume Sihoni wa Aamori, yetawala hiko Heshiboni hadi mphaka na Aamoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
            "verseOrgIds": [
              "JOS.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "phamwenga na tsi za Giliadi, seemu za Ageshuri na Amaaka, mwango wa Herimoni na tsi yosi ya Bashani hadi Saleka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya na ufalume wosi wa Ogi mmwenga wa Arafa ariosala, ambaye watawala hiko Ashitarothi na Edirei ko Bashani. Musa kala akaashinda Arafa osi na kuazola, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "isiphokala Ageshuri na Amaaka ambao tayazolwa ela anaishi na Aiziraeli hadi rero.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        }
      ]
    },
    {
