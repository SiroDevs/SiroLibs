        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.23",
            "verseOrgIds": [
              "JOS.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seemu za tsi ambazo Musa waapha atu a mbari ya Gadi kulengana na miryango yao ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "yakala Jazeri, midzi yosi ya Giliadi na nusu ya tsi ya Aamoni hadi Aroeri iriyo mlairo wa dzuwa wa Raba, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "vivyo hivyo kuandzira Heshiboni hadi Ramathi-Mizipa, Betonimu, na kula Mahanaimu hadi seemu ya Debiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsi yao yatsanganya midzi ya deteni, ambayo ni Bethi-Haramu, Bethi-Nimura, Sukothi na Zafoni na tsi yosi yokala ya mfalume Sihoni wa Heshiboni; eneo hiro rakala uphande wa mlairo wa dzuwa wa muho Joridani na kuphakana na bahari ya Kinerethi kpwa uphande wa mwakani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Midzi hino na vidzidzivye ndiyo yokala urisi wa mbari ya Gadi na miryango yao.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        }
      ]
    },
