          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu waapha Aiziraeli tsi iyo yosi ambayo kala akaapira akare ao, nao achiihala achimiliki na achisagala mumo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
