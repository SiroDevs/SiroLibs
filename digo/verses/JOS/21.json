            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumula ya midzi yosi yohewa Alawi katika seemu za Aiziraeli yakala midzi mirongo mine na minane phamwenga na weruwe wa kurisa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.41",
            "verseOrgIds": [
              "JOS.21.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
