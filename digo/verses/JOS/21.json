          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Takuyakala ahadi yoyosi yolagbwa Aiziraeli ni Mwenyezi Mlungu ambayo taiyahendeka, chila ahadi yakamilishwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
