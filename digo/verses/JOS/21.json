            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi midzi ambayo ahewa mryango wa Kohathi yokala ikasala yakala midzi kumi phamwenga na weruwe wa kurisa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.26",
