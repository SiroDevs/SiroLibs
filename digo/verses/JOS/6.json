              "JOS.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.30"
              },
              "items": [
                {
                  "text": "Aeburania 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo alavyadzi-sadaka apiga gara magunda. Mara tu atu ariphosikira sauti ya magunda, achikota kululu nao ukuta wa mudzi uchigbwa. Atu ainjira hura mudzi kula phara atu ariphokala akaelekeza, achiuteka nyo mudzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.20",
            "verseOrgIds": [
              "JOS.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achiolaga kpwa upanga vyosi vyokala na uhai himo mudzini: atu osi alume kpwa achetu, avyere kpwa adide, ngʼombe, mangʼondzi na punda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.21",
            "verseOrgIds": [
              "JOS.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Joshuwa achiambira hara apelelezi ariopeleleza iyo tsi, “Phiyani mkainjire nyumba ya iye malaya mkatuluze iye mchetu na atue osi kama murivyomuapira.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.22",
            "verseOrgIds": [
              "JOS.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi hara barobaro ariopeleleza ainjira achimtuluza Rahabu, ise na nine, nduguze a chilume na atue osi. Atuluza jamaa osi a Rahabu achiaika kondze ya kambi ya Aiziraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.23",
            "verseOrgIds": [
              "JOS.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha hinyo mudzi wa Jeriko achiutiya moho phamwenga na chila chitu chirichokalamo isiphokala feza, zahabu, miyo ya shaba na ya chuma; ihi achiitiya kpwenye hazina ya nyumba ya Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.24",
            "verseOrgIds": [
              "JOS.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.31"
              },
              "items": [
                {
                  "text": "Aeburania 11:31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela yuya malaya Rahabu phamwenga na atu osi a nyumba ya ise, arichwa ni Joshuwa aishi, nacho chivyazi chao chinaishi kahi-kahi ya Aiziraeli hadi rero, kpwa sababu wafwitsa apelelezi ariohumwa kupeleleza mudzi wa Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.25",
            "verseOrgIds": [
              "JOS.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
