            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.48",
            "verseOrgIds": [
              "JOS.19.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 19:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariphomala kuganyirana seemu zosi za tsi, Aiziraeli amupha Joshuwa mwana wa Nuni seemuye yokala kahi-kahi yao. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.49",
            "verseOrgIds": [
              "JOS.19.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 19:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulengana na malagizo ga Mwenyezi Mlungu, Joshuwa wahewa mudzi arioulonda. Mudzi hinyo ni Timunathi-Sera urio seemu za myango ya Efuraimu, achiudzenga luphya na achisagala mumo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.19.50",
            "verseOrgIds": [
              "JOS.19.50"
            ]
          }
        }
      ]
    },
