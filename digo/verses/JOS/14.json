              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.30"
              },
              "items": [
                {
                  "text": "Isabu 14:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi atu a mbari ya Juda amlunga Joshuwa hiko mudzi wa Giligali, naye Kalebu mwana wa Jefune, yekala Mkenizi achimuamba, “Uwe unamanya vira Mwenyezi Mlungu arivyomuamba Musa mutu wa Mlungu hiko Kadeshi-Barinea kuhusu mimi na uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.6",
            "verseOrgIds": [
              "JOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.13.1+NUM.13.2+NUM.13.3+NUM.13.4+NUM.13.5+NUM.13.6+NUM.13.7+NUM.13.8+NUM.13.9+NUM.13.10+NUM.13.11+NUM.13.12+NUM.13.13+NUM.13.14+NUM.13.15+NUM.13.16+NUM.13.17+NUM.13.18+NUM.13.19+NUM.13.20+NUM.13.21+NUM.13.22+NUM.13.23+NUM.13.24+NUM.13.25+NUM.13.26+NUM.13.27+NUM.13.28+NUM.13.29+NUM.13.30"
              },
              "items": [
                {
                  "text": "Isabu 13:1–30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Wakati Musa mtumishi wa Mwenyezi Mlungu ariphonihuma kula Kadeshi-Barinea kpwendapeleleza yo tsi, nakala na miaka mirongo mine, nami nchimrehera habari za kuaminika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.7",
            "verseOrgIds": [
              "JOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela ayangu nriophiya nao kupeleleza atiya atu wuoga, ela mino nalunga malagizo ga Mwenyezi Mlungu, Mlungu wangu moyo kutsuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.8",
            "verseOrgIds": [
              "JOS.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.24"
              },
              "items": [
                {
                  "text": "Isabu 14:24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Musa waapa siku iyo achiamba, ‘Kpwa hakika tsi iyo ambayo nyayozo zikavyoga indakala urisio phamwenga na anao hata kare na kare, kpwa sababu ukalunga Mwenyezi Mlungu moyo kutsuka.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.9",
            "verseOrgIds": [
              "JOS.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haya lola! Ni muda wa miaka mirongo mine na mitsano hangu Mwenyezi Mlungu amuambire Musa neno hiri, wakati Aiziraeli achere zunguluka hiko jangbwani. Hangu wakati hinyo hadi rero Mwenyezi Mlungu akaniika moyo, vivi nina umuri wa miaka mirongo minane na mitsano. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.10",
            "verseOrgIds": [
              "JOS.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hangu wakati uho hadi rero nchere na mkpwotse dza yo siku ambayo Musa wanihuma. Hata vivi nina mkpwotse wa kuweza kupigana viha au kuhenda kazi yanjina yoyosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.11",
            "verseOrgIds": [
              "JOS.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi navoya uniphe tsi hino ya myango ambayo Mwenyezi Mlungu waniahidi siku hiyo. We mwenye wasikira kukala Aanaki achere sagala mumo ngomeni, ela nkuhenda Mwenyezi Mlungu akanipha uwezo wa kuazola kama arivyogomba.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.12",
            "verseOrgIds": [
              "JOS.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho Joshuwa wamʼbariki Kalebu mwana wa Jefune, achimupha seemu ya Heburoni ikale urisiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.13",
            "verseOrgIds": [
              "JOS.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo mudzi wa Heburoni ni seemu ya nyumba ya Kalebu mwana wa Jefune Mkenizi hadi rero, kpwa kukala Kalebu wamkuluphira Mwenyezi Mlungu, Mlungu wa Iziraeli moyo kutsuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.14",
            "verseOrgIds": [
              "JOS.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzina ra mwandzo ra mudzi wa Heburoni kala ni Kiriathi-Ariba. Ariba wakala mutu maarufu kahi ya Aanaki osi. Nayo tsi ndzima ichikala bila viha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.15",
            "verseOrgIds": [
              "JOS.14.15"
            ]
          }
        }
      ]
    }
  ],
