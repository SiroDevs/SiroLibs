              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu wamanya hinya atu taakuluphirika, mana anamanya achili za anadamu zirivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
