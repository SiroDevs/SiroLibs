              "items": [
                {
                  "text": "Luka 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "(Wakati hinyo Johana kala kadzangbwetiywa jela.)",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.24",
            "verseOrgIds": [
              "JHN.3.24"
            ]
          }
        }
