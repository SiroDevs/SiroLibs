            "sid": "MAT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hino ni adisi ya Jesu Masihi. Iye kala ni chivyazi cha Daudi, na chivyazi cha Burahimu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.1",
            "verseOrgIds": [
              "MAT.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.16",
            "verseOrgIds": [
              "MAT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa hivyo vivyazi vyosi kula Burahimu hadi Daudi ni vivyazi kumi na vine. Kula Daudi hadi Ayahudi kuhalwa kuphiya Babeli ni vivyazi kumi na vine. Bada ya Ayahudi kuhalwa kuphirikpwa Babeli hadi wakati wa kuvyalwa Masihi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:17",
              "type": "text"
            },
            {
              "text": "Masihi",
              "type": "text"
            },
            {
              "text": "manage ni",
              "type": "text"
            },
            {
              "text": "yetsambulwa ni Mlungu kuokola atu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni vivyazi kumi na vine.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.1.17",
            "verseOrgIds": [
              "MAT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
