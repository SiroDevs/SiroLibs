              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.22",
            "verseOrgIds": [
              "MAT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.8"
              },
              "items": [
                {
                  "text": "Mahendo 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku iyo-iyo Jesu watsolokerwa ni Masadukayo anjina. Nao Masadukayo ni kundi ra Ayahudi asioamini kukala atu achifwa andafufuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.23",
            "verseOrgIds": [
              "MAT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Kumbukumbu 25:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Agomba achimuamba, “Mwalimu, Musa waamba mutu achilóla alafu achifwa bila ya kuphaha ana, nduguye ni lazima ahale ufwa hiye gungu, na amvyarire ana yuya mufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.24",
            "verseOrgIds": [
              "MAT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi kpwakala na ndugu sabaa ambao hwaishi nao. Wa mwandzo walóla mchetu, achifwa bila ya kuvyala naye ana. Hiye gungu achihalwa ufwa ni ndugungbwa wa yuya mufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.25",
            "verseOrgIds": [
              "MAT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi hiye wa phiri wafwa kabila ya kuphaha mwana. Wa hahu naye dza vivyo, hadi achisira osi sabaa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.26",
            "verseOrgIds": [
              "MAT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwisho, yuya mchetu naye piya wafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.27",
            "verseOrgIds": [
              "MAT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, siku ndiphofufulwa atu, yuya mchetu andakala mkpwaza ani? Mana ndugu osi amlóla.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.28",
            "verseOrgIds": [
              "MAT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela Jesu waambira, “Mwimwi Masadukayo munakosera, mana tammanya Maandiko wala uwezo wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.29",
            "verseOrgIds": [
              "MAT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana siku ya kufufulwa, atu andakala dza malaika hiko mlunguni ambao taalóla wala taalólwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.30",
            "verseOrgIds": [
              "MAT.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na kuhusu atu kufufulwa, dze, tamdzangbwesoma gara ambago muambirwa ni Mlungu? Iye waamba, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.31",
            "verseOrgIds": [
              "MAT.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.6"
              },
              "items": [
                {
                  "text": "Kutsama 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "‘Mimi ni Mlungu wa Burahimu, wa Isaka na wa Jakobo.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:32",
              "type": "text"
            },
            {
              "text": "Ndani ya chitabu cha Kutsama 3:6, Mlungu wamuambira Musa maneno higa miaka minji ambapho Burahimu, Isaka na Jakobo kala akafwa kare.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Kpwa hivyo, iye si Mlungu wa atu ariofwa, ela ni Mlungu wa ario moyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.32",
            "verseOrgIds": [
              "MAT.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na atu osi ariphosikira higo, aangalazwa ni mafundzoge.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.33",
            "verseOrgIds": [
              "MAT.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo ariphosikira kukala Jesu waahendesa Masadukayo anyamale, akutana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.34",
            "verseOrgIds": [
              "MAT.22.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmwenga wao, yekala ni mwanashariya, wamuuza Jesu swali kumhega achili. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.35",
            "verseOrgIds": [
              "MAT.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waamba, “Mwalimu, ndani ya Shariya za Musa ni shariya iphi iriyo kulu sana?” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.36",
            "verseOrgIds": [
              "MAT.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.5"
              },
              "items": [
                {
                  "text": "Kumbukumbu 6:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Naye Jesu achiamba, “ ‘Mmendze Mwenyezi Mlungu, Mlungu wenu, na mioyo yenu yosi, na roho zenu zosi, na mkpwotse wenu wosi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.37",
            "verseOrgIds": [
              "MAT.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ndiyo shariya ya kpwandza na ya muhimu sana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.38",
            "verseOrgIds": [
              "MAT.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
              },
              "items": [
                {
                  "text": "Alawi 19:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Na ya phiri yoigana na iyo ya kpwandza, ni hino yiambayo, ‘Mmendze myao dza vyo udzimendzavyo mwenye.’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.39",
            "verseOrgIds": [
              "MAT.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.25+LUK.10.26+LUK.10.27+LUK.10.28"
              },
              "items": [
                {
                  "text": "Luka 10:25–28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Shariya zosi za Musa na mafundzo ga manabii zinategemea shariya hizi mbiri.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
            "verseOrgIds": [
              "MAT.22.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MAT 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.40",
            "verseOrgIds": [
              "MAT.22.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MAT 22:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafarisayo ariphokala achere phamwenga, Jesu waauza, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.41",
            "verseOrgIds": [
              "MAT.22.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MAT 22:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kpwani mwino munamanyani kuhusu Masihi?",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:42",
              "type": "text"
            },
            {
              "text": "Yani",
              "type": "text"
            },
            {
              "text": "Masihi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Ni chivyazi cha ani?” Nao achimuamba, “Ni chivyazi cha Mfalume Daudi.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.42",
            "verseOrgIds": [
              "MAT.22.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MAT 22:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu achiaambira, “Sambi inawezekanadze Daudi wagomba kpwa uwezo wa Roho Mtakatifu achimuiha ‘Bwana?’ Mana wagomba achiamba:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.22.43",
            "verseOrgIds": [
              "MAT.22.43"
            ]
          }
        }
      ]
    }
