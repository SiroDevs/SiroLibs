          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mafundzo gangu ga rahisi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.30",
            "verseOrgIds": [
              "MAT.11.30"
            ]
          }
