                {
                  "text": "Luka 10:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela nakuambirani kukala siku ya uamuli, mwimwi mundaphaha uamuli mkali kuriko ya atu a Sodoma.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.24",
            "verseOrgIds": [
              "MAT.11.24"
            ]
          }
        }
      ]
