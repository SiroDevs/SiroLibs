          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndzoni kpwangu mwimwi mosi mgayao na kuremererwa ni mizigo miziho, nami nindakuoyezani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
