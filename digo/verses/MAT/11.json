            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "11:30",
              "type": "text"
            },
            {
              "text": "Chiyunani chinaamba",
              "type": "text"
            },
            {
              "text": "gogolo rangu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na mzigo wangu tauremera.”",
          "type": "text",
