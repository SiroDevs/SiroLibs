                "loc": "JER.6.16"
              },
              "items": [
                {
                  "text": "Jeremia 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Gbwirani mzigo wangu na mdzifundze kula kpwangu; mana mimi ni mpole na wa mbazi, namwi roho zenu zindaoya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
