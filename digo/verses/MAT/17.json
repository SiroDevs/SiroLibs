              "MAT.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anafundzie ariphokala akakusanyika phamwenga hiko Galilaya, Jesu waambira, “Wakati ukafika mimi, Mutu Yela Mlunguni, niyalaviwa kpwa anadamu ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ambao andaniolaga. Ela siku ya hahu bada ya kuolagbwa nindafufulwa.” Anafundzi ariphosikira higo asononeka sana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
