          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana gosi higo ni kuendzwa ni atu asiommanya Mlungu, ela Sowe yenu ariye mlunguni anamanya mnalonda vitu hivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.32",
