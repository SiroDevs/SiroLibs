        },
        {
          "text": "“Kpwa hivyo, msitangetange kuamba, mundaryani, mundanwani, wala mundavwalani, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.31",
            "verseOrgIds": [
