                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela Mafarisayo achiamba, “Anatuluza pepho kpwa uwezo wa mkpwulu wa pepho.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
