              "items": [
                {
                  "text": "Luka 9:35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha kpwatuluka sauti kula mlunguni ichiamba, “Hiyu ni mwanangu nimmendzaye, naye ananihamira sana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        }
