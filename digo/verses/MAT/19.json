                "loc": "MAT.20.16"
              },
              "items": [
                {
                  "text": "Mathayo 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
