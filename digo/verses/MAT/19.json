              "items": [
                {
                  "text": "Luka 13:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela anji ambao ni a kpwandza andakala a mwisho, na anji a mwisho andakala a kpwandza.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
