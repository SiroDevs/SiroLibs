                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kundi ra afuasi ayawenu a hiku Babeli,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:13",
              "type": "text"
            },
            {
              "text": "Babeli",
              "type": "text"
            },
            {
              "text": ": Dzina ambaro atu anjina kala achirihumira badala ya kuhadza mudzi wa Rumi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ambao piya atsambulwa ni Mlungu, akakuphozani. Piya mkaphozwa ni mwanangu wa chiroho aihwaye Mariko.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.13",
            "verseOrgIds": [
              "1PE.5.13"
            ]
          }
        }
      ]
