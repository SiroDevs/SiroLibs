          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.18",
            "verseOrgIds": [
              "NEH.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitambukira kpwa manono ee Mlungu wangu, kpwa gosi nrigoahendera atu hinya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.19",
            "verseOrgIds": [
              "NEH.5.19"
            ]
          }
        }
      ]
