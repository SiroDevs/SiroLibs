              },
              "items": [
                {
                  "text": "Arumi 2:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yuya fundi wa vyuma aihwaye Isikanda, wanihendera vibaya sana. Bwana andamripha kpwa gara arigonihendera. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
