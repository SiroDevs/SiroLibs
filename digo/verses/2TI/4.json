                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Tikiko námhuma mudzi wa Efeso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
            ]
