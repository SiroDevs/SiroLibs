        },
        {
          "text": "Luka macheye ndiye yesala phamwenga nami. Kpwa hivyo ndzo na Mariko, mana anaweza kuniterya kuhenda kazi yangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
