          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baruwa hino ila kpwangu mimi Paulo, mtume wa Masihi Jesu. Kpwa mendzwa ya Mlungu náhewa uwezo niatangazire atu uzima ambao waahidiwa kpwa kuungana na Jesu Muokoli.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        }
      ]
    },
