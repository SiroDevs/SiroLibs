          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu a Zabuloni taayazola Akanani ariosagala mudzi wa Kitironi, wala hara kala achiishi mudzi wa Nahaloli, ela nyo aenderera kusagala nao kuno anahenda kazi za shokowa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
        }
