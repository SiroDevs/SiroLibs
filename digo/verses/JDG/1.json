            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.63"
              },
              "items": [
                {
                  "text": "Joshuwa 15:63",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.6"
              },
              "items": [
                {
                  "text": "2 Samueli 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.11.4"
              },
              "items": [
                {
                  "text": "1 Nyakati 11:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela atu a Benjamini taayazola Ajebusi arioishi Jerusalemu, kpwa hivyo Ajebusi achiishi phamwenga na Abenjamini mo Jerusalemu hadi rero.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.21",
            "verseOrgIds": [
              "JDG.1.21"
            ]
          }
        }
      ]
