            "style": "v",
            "sid": "MAL 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.16",
            "verseOrgIds": [
              "MAL.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mkamremweza Mwenyezi Mlungu na higo maneno genu. Ela mwi munauza, ‘Ni maneno gani huchigomremweza nago?’ Mkamremweza kpwa kuamba, ‘Mwenyezi Mlungu anamendza ahendi a mai osi tsona anamuhamira.’ Au kpwa kuuza, ‘Ye Mlungu ahendaye haki a kuphi.’”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.2.17",
            "verseOrgIds": [
              "MAL.2.17"
            ]
          }
        }
      ]
    }
  ],
