              "1CO.3.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.6.19"
              },
              "items": [
                {
                  "text": "1 Akorintho 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.6.16"
              },
              "items": [
                {
                  "text": "2 Akorintho 6:16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Hakika mnamanya kukala mwimwi mu phatu phatakatifu photengbwa kuvoya Mlungu, naye Roho Mtakatifu anaishi ndani yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.16",
            "verseOrgIds": [
              "1CO.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutu achibananga phatu pha kuvoya Mlungu, naye Mlungu andamʼbananga. Mana phatu pha kuvoya Mlungu ni phatu phatakatifu, na mwimwi ndimwi pho phatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CO 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.17",
            "verseOrgIds": [
              "1CO.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CO 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msidzichenge! Mutu yeyesi ndiyedziona ni mwenye ikima kpwa kudzipima na atu a dunia, phahi naakale mzuzu ili akale mwenye ikima kpweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.18",
            "verseOrgIds": [
              "1CO.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CO 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.13"
              },
              "items": [
                {
                  "text": "Ayubu 5:13",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa mana gara ambago mwanadamu anaona ni ikima, Mlungu kpwakpwe ni uzuzu. Mana Maandiko ganaamba, “Mlungu nkuagbwira enye ikima kpwa kuhumira ulachu wao.” ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.19",
            "verseOrgIds": [
              "1CO.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.94.11"
              },
              "items": [
                {
                  "text": "Zaburi 94:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Piya ganaamba, “Mwenyezi Mlungu anamanya maazo ga enye ikima, kukala tagana mana yoyosi.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CO 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.20",
            "verseOrgIds": [
              "1CO.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CO 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mutu naasidzikarye kuhusu chilongozi fulani. Mana vitu vyosi ni vyenu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.21",
            "verseOrgIds": [
              "1CO.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CO 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "hata Paulo, Apolo, Petero,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
              "1CO.3.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:22",
              "type": "text"
            },
            {
              "text": "Dzina asili ra",
              "type": "text"
            },
            {
              "text": "Petero",
              "type": "text"
            },
            {
              "text": "ni",
              "type": "text"
            },
            {
              "text": "Kefa.",
              "type": "text"
            }
          ]
        },
        {
          "text": " dunia hino, uzima na chifo, vitu vya sambi na hata vya badaye, hivi vyosi ni vyenu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.3.22",
            "verseOrgIds": [
