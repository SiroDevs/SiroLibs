                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Mahendo 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakpwedza kpwenu bada ya kutsupira jimbo ra Makedonia,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:5",
              "type": "text"
            },
            {
              "text": "Makedonia",
              "type": "text"
            },
            {
              "text": "ni seemu ya vurini mwa tsi ya Yunani na",
              "type": "text"
            },
            {
              "text": "Korintho",
              "type": "text"
            },
            {
              "text": "ni mudzi hiko Akaya, seemu ya mwakani mwa tsi ya Yunani.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana ninapanga kutsupa na kuko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.5",
            "verseOrgIds": [
              "1CO.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mendzerepho ndakala namwi kpwa muda, hata kpwa majira ga mnyevu, ili mniterye vyaro vyangu kokosi ndikophiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.6",
            "verseOrgIds": [
              "1CO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa vira ndakala natsapira kpwenu, sitaki nedze kpwenu sambi kpwa muda mfupi bahi. Mlungu achimendza, napanga kukala namwi kpwa muda wa kukola. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.7",
            "verseOrgIds": [
              "1CO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.15+LEV.23.16+LEV.23.17+LEV.23.18+LEV.23.19+LEV.23.20+LEV.23.21"
              },
              "items": [
                {
                  "text": "Alawi 23:15–21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
