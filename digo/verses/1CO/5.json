              "1CO.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.9"
              },
              "items": [
                {
                  "text": "Agalatia 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa kpweli ngulu zenu tazifwaha. Kpwani tammanya kala hamira chache inaweza kuumusa donje ra unga munji sana? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.6",
            "verseOrgIds": [
              "1CO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.5"
              },
              "items": [
                {
                  "text": "Kutsama 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Yiuseni iyo hamira ya kare ya dambi na mkale atu aswafi bila ya hamira, dza vira murivyo. Mana Jesu, ambaye ndiye Mwana ngʼondzi wehu wa Pasaka, walaviwa dza sadaka msalabani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.7",
            "verseOrgIds": [
              "1CO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.7"
              },
              "items": [
                {
                  "text": "Kutsama 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.3"
              },
              "items": [
                {
                  "text": "Kumbukumbu 16:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Phahi nahusherekeeni Pasaka kpwa kuhumira mkpwahe usiotiywa hamira, mkpwahe wa uswafi na kpweli, si kpwa hamira ya kare, hamira ya uyi na ubaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.8",
            "verseOrgIds": [
              "1CO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nákuandikirani kare baruwa nchikuambirani musigbwirane na atu adiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.9",
            "verseOrgIds": [
              "1CO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siyagomba kuhusu atu a dunia ambao ni azindzi, achoyo, a tamaa mbaya, anyangʼanyi na aabuduo vizuka, mana mchidzitenga na atu dza hinyo, ingebidi mtsame kabisa himu duniani. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.10",
            "verseOrgIds": [
              "1CO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela manage kala ni higa: Musigbwirane na mutu yeyesi adziihaye mfuasi ambaye ni mdiya, wa tamaa mbii, wa kuabudu vizuka, wa kulaphiza atu, mlevi ama muivi. Tsona piya msirye na mutu dza hiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.5"
              },
              "items": [
                {
                  "text": "Kumbukumbu 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "17:7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Kpwa kpweli siyo kazi yangu kuhukumu atu ambao sio afuasi. Mana Mlungu andaamula atu hinyo. Ela kazi yenu ni kuhukumu atu ambao ni afuasi a kundi renu. Kama Maandiko gaambavyo, “Ye mutu mui mtuluzeni kahi yenu.”",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12+1CO.5.13",
            "verseOrgIds": [
              "1CO.5.12",
              "1CO.5.13"
            ]
          }
        }
      ]
    }
