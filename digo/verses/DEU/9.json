            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tsona mwamtsukiza Mwenyezi Mlungu, Mlungu wenu, hiko Tabera, Masa na Kiburothi-Hataava. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
