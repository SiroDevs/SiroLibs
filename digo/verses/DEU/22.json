                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mlume achikutana na msichana ambaye kadzangbweposwa, achimgbwira kpwa nguvu nao achifumaniwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "mlume hiye andamripha ise wa msichana iye vipande mirongo mitsano vya feza kpwa sababu akamvundzira ishima na msichana iye andakala mchewe na kandamricha maishage gosi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
