              "DEU.26.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Kumbukumbu 14:28–29",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Chila mwaka wa hahu, chila mmwenga wenu andalavya fungu ra kumi ga mavunoge gosi kpwa ajili ya Alawi, ajeni, anachiya na magungu, ili aphahe chakurya cha kutosha anaphokala kpwenye midzi yenu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.12",
            "verseOrgIds": [
              "DEU.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu mundaamba hivi mbere za Mwenyezi Mlungu, Mlungu wenu, ‘Hukausa mafungu matakatifu kula mwehu madzumbani na hukaapha Alawi, ajeni, anachiya na magungu, dza vira urivyohuamuru. Tahudzangbwevundza amurizo wala tahudzangbweyala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.13",
            "verseOrgIds": [
              "DEU.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tahuyarya fungu ra kumi huriphokala hunaomboleza; tahuyarituluza kondze ya nyumba zehu huriphokala achafu wala kurilavya kpwa mikoma. Hukakutii ee Mwenyezi Mlungu, Mlungu wehu; hukahenda chila chitu urichohulagiza kuhusu fungu ra kumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.14",
            "verseOrgIds": [
              "DEU.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola photsi kula makalogo matakatifu hiko mlunguni, ujaliye atuo Iziraeli na tsi uriyohupha, tsi yenye rutuba dza vira urivyolaga akare ehu.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.15",
            "verseOrgIds": [
              "DEU.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Rero hino, Mwenyezi Mlungu, Mlungu wenu, anakuamuruni mgbwire masharuti na malagizo higa. Hakikishani munagahenda kpwa mioyo yenu yosi na roho zenu zosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.16",
            "verseOrgIds": [
              "DEU.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rero mkagomba enye kukala Mwenyezi Mlungu ndiye Mlungu wenu na kukala mundalunga njiraze na mundagbwira masharutige, amurize, shariyaze na kusikira sautiye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.17",
            "verseOrgIds": [
              "DEU.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
