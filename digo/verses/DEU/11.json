        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ichikala mundagbwira amuri zosi ambazo nakuphani, ambazo ni; kummendza Mwenyezi Mlungu, Mlungu wenu, kulunga njiraze zosi na kukala aaminifu kpwakpwe, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "phahi Mwenyezi Mlungu andazola mataifa ganjina makulu genye mkpwotse kuriko mwimwi. Namwi mundaphaha tsi ariyoisagala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
