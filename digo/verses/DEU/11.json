            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.6.6+DEU.6.7+DEU.6.8+DEU.6.9"
              },
              "items": [
                {
                  "text": "Kumbukumbu 6:6–9",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Phahi higa maneno gangu gaikeni mwenu mioyoni na mwenu rohoni, chisha mugafunge mwenu mikononi na mwenu vilanguni, ili msigayale. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fundzani ana enu maneno higa na mgabishe msagalapho mwenu madzumbani, munyendekapho, mulalapho na mulamukapho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaandikeni kpwenye mimo ya miryango yenu na maryango ga midzi yenu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ili mwimwi na ana enu mphahe kuishi maisha mare kpwenye tsi ambayo Mwenyezi Mlungu, Mlungu wenu, waapa kuapha akare enu siku zosi ambazo dunia indakalapho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
