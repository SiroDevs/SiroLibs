            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.35+LEV.19.36"
              },
              "items": [
                {
                  "text": "Alawi 19:35–36",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msikale na mawe aina mbiri ga mizani kpwenye mikoba yenu, mwenga ziho na ranjina phepheya. Msihumire mizani za handzo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.13",
            "verseOrgIds": [
              "DEU.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya msikale na aina mbiri za vipimo, chikulu na chidide mwenu madzumbani.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.14",
            "verseOrgIds": [
              "DEU.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
