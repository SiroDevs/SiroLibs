              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami namuhuma kpwa lengo riro, edze akuambireni vira huendereravyo na piya akutiyeni moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
              "EPH.6.22"
            ]
