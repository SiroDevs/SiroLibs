            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EPH 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enehu, ni lazima mphundzane kpwa mana munamuogopha Jesu.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.21",
            "verseOrgIds": [
              "EPH.5.21"
            ]
          }
        }
      ]
    },
    {
