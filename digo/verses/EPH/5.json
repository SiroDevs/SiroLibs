                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.1"
              },
              "items": [
                {
                  "text": "1 Petero 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Achetu nakuambirani hivi. Chila mchetu ni lazima asikize mlumewe, dza viratu amphundzavyo Bwana Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.22",
            "verseOrgIds": [
              "EPH.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EPH 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mlume ni mkpwulu wa mchewe dza viratu Jesu arivyo mkpwulu wa atue, naye ndiye muokoli wao. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.23",
            "verseOrgIds": [
              "EPH.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi chila mchetu ni lazima aphundze mlumewe kpwa rorosi, dza viratu afuasi a Jesu amphundzavyo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.5.24",
            "verseOrgIds": [
              "EPH.5.24"
            ]
          }
        }
      ]
    },
