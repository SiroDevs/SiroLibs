        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo kazi ya Selemani ichikamilika, hangu siku ya kuikpwa msingi wa nyumba ya Mwenyezi Mlungu hadi kusirakpwe. Hipho Nyumba ya kuvoya Mlungu ichimarigizwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
