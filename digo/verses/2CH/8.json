            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Selemani wamlavira Mwenyezi Mlungu sadaka za kuochwa dzulu ya phatu pha kulavira sadaka ariphophadzenga mbere ya baraza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
