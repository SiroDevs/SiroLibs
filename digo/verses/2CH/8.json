      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selemani wadzenga nyumba ya Mwenyezi Mlungu na yakpwe mwenye na achizimala kpwa muda wa miaka mirongo miiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achiidzenga luphya midzi hira ambayo kala akahewa ni Hiramu, achiapha Aiziraeli asagale mumo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Selemani waphiya achendavamia mudzi wa Hamathi-Soba, na achiushinda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achidzenga mudzi wa Tadimori hiko weruni na midzi yosi ya kuikira vitu, ariyoidzenga Hamathi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achidzenga luphya mudzi wa Bethi-Horoni ya dzulu na Bethi-Horoni ya tsini, midzi mikulu yozungulusirwa dzikuta ririro na maryango na magbwama ga vyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya wadzenga mudzi wa Baalathi na midziye yosi ya kuikira hazina ambayo kala i phephi na Baalathi, midzi ya kuikira magarige ga kuvwehwa ni farasi na anajeshie akuhumira farasi na chochosi aricholonda kudzenga katika Jerusalemu, Lebanoni au phatu phanjina katika ufalumewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piya himo Iziraeli mwaishi atu anjina ambao kala sio Aiziraeli nao ni Ahiti, Aamori, Aperizi, Ahivi na Ajebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hano kala ni a chivyazi cha hara ambao Aiziraeli taayaweza kuaangamiza wakati anahala tsi. Phahi Selemani waahenda atumwae achiahendesa kazi za shokowa hata rero. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahi ya Aiziraeli Selemani kayahenda mutu hata mmwenga kukala mtumwa mwakpwe kazini, ela waaika akale anajeshi na akulu a majeshi, aimirizi a magarige ga kuvwehwa ni farasi, na anajeshi akuhumira farasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kahi ya hinyo Aiziraeli piya atsambulwa vilongozi akulu magana mairi na mirongo mitsano akale aimirizi tsini ya mfalume Selemani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
