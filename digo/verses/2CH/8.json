        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Selemani wamreha mchewe, mwana mchetu wa Farao kula mudzi wa Daudi, achimuinjiza nyumba ariyomdzengera. Manage waamba, “Mkpwazangu kandaishi nyumbani mwa Daudi mfalume wa Iziraeli, kpwa kukala phatu phoikpwa sanduku ra Mwenyezi Mlungu ni phatakatifu.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
