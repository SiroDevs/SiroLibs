              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahendo ganjina ga Jehoyakimu, na go mai arigogahenda, ga kutsukiza na vira arivyophiya chinyume na Mlungu, gaandikpwa kpwenye chitabu cha mahendo ga afalume a Iziraeli na a Juda. Chisha mwanawe Jehoyakini watawala badalaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoyakini kala ana miaka minane",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:9",
              "type": "text"
            },
            {
              "text": "Maandiko ganjina ganaamba miaka kumi na nane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ariphoandza kutawala na achitawala miezi mihahu na siku kumi ko Jerusalemu. Naye piya wamuasi Mwenyezi Mlungu, achihenda mai. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
