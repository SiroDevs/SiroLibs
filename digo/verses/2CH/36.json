              "items": [
                {
                  "text": "34:1–5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ndipho Mwenyezi Mlungu achihuma Nebukadineza mfalume wa Babeli",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:17",
              "type": "text"
            },
            {
              "text": "Chieburania chinaamba",
              "type": "text"
            },
            {
              "text": "wa Akalidayo",
              "type": "text"
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwendashambuliya Jerusalemu. Nebukadineza waolaga mabarobaro aho ambao kala a phatu phatakatifu, wala kayaonera mbazi mutu yeyesi, si mchetu wala mlume, si mvyere wala mdide. Mlungu waatiya osi mkpwononi mwa Nebukadineza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza watsukula chila chitu ambacho kala chikasala himo nyumba ya kuvoya Mlungu. Hazina za nyumba ya Mwenyezi Mlungu na hazina za mfalume na za maofisaage, zosi wazikusanya achiuya nazo Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        }
      ]
