            }
          ]
        },
        {
          "text": "Ndipho Nebukadineza mfalume wa Babeli, waambuka achedzamshambuliya. Jehoyakimu wagbwirwa, achifungbwa na silisili na achiphirikpwa hadi tsi ya Babeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza piya wahala miyo minji ya samani kula kpwa nyumba ya Mwenyezi Mlungu na achendayiika kpwenye nyumbaye ya chifalume hiko Babeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
