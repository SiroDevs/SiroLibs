              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwishowe atumishie ampangira njama ya kumuolaga na achimuolagira ndani ya nyumbaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
