            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya ariphofika, ye mfalume wamuuza, “Dze swino huphiye kupiga viha Ramothi-Giliadi hebu husiphiye?” Naye achijibu achiamba, “Ambukani, mkaipige, namwi mundaturya mana andatiywa mwenu mikononi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        }
      ]
    },
