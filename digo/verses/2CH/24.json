              "2CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.35"
              },
              "items": [
                {
                  "text": "Mathayo 23:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.51"
              },
              "items": [
                {
                  "text": "Luka 11:51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha Roho wa Mlungu achimuinjira Zakariya, mwana wa mlavyadzi-sadaka Jehoyada naye achiima mbere za atu, phatu phounuka chidide, achiaambira, “Mlungu anaamba hivi, ‘Kpwa utu wani munavundza shariya za Mwenyezi Mlungu? Tamundaongokerwa bii. Kpwa kukala mkamrema Mwenyezi Mlungu naye akakuremani.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi hinyo atu ampangira njama na kpwa amuri ya mfalume achimpiga mawe hadi achimuolaga muhalani pha nyumba ya Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hivyo phahi ndivyo mfalume Joashi arivyoyala unono ambao Jehoyada ise wa Zakariya wamuhendera, hadi achimuolagira mwanawe. Naye Zakariya ariphokala anafwa waamba, “Mwenyezi Mlungu gaone higa na uniriphizire chisasi!”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi iriphofika mwisho wa mwaka, Jeshi ra Shamu ramvamia Joashi. Ravamia Juda na Jerusalemu richiolaga chila chilongozi ariyekala kahi za atu, richihala nyara zao richiziphirikira mfalume wa Damasikasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzagbwe jeshi ra Shamu kala rina atu achache Mwenyezi Mlungu warihenda rishinde jeshi kulu ra Joashi kpwa mana kala akamricha Mwenyezi Mlungu, Mlungu wa akare ao. Hivyo ahumirwa ni Mlungu kumtiya adabu Joashi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshi ra Shamu ririphouka, ramricha Joashi majuruhu. Kpwa sababu ya kumwaga milatso ya mwana wa mlavyadzi-sadaka Jehoyada, atumishi a Joashi apanga njama, achimuolaga phokala a chitandani kadziweza. Hivyo wafwa achizikpwa hiko Mudzi wa Daudi ela kayazikpwa vikurani pha afalume. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hara ariompangira njama ni Zabadi mwana wa Shimeathi mchetu wa Chiamoni na Jehozabadi mwana wa Shimurithi mchetu wa Chimoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mambo gosi ga ana a Joashi na mambo mai arigotabiriwa ni manabii na kudzengbwa luphya kpwa Nyumba ya kuvoya Mlungu, higo gosi gaandikpwa kpwenye chitabu cha mahendo ga Afalume a Iziraeli. Naye mwanawe Amaziya watawala badalaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
