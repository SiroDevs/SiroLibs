              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Selemani achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        }
