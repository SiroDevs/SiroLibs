              },
              "items": [
                {
                  "text": "Alawi 9:23–24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Selemani ariphomala mavoyo higo moho watserera kula mlunguni uchiocha sadaka za kuochwa na sadaka zanjina nayo nyumba ya kuvoya Mlungu ichiodzala utukufu wa Mwenyezi Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nao alavyadzie-sadaka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:2",
              "type": "text"
            },
            {
              "text": "Atu arioikpwa kuwakilisha anadamu na Mlungu katika kuphokera sadaka kula kpwa atu na kuzilavya kpwa Mlungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " taayaweza kuinjira Nyumba ya kuvoya Mlungu kpwa mana utukufu wa Mwenyezi Mlungu kala ukaiodzaza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
