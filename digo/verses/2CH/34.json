            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Josiya achiusa vizuka vyosi ambavyo kala ni tsukizo kula kpwenye midzi ya Iziraeli na achiamurisha chila mutu ambaye ni Muiziraeli aabudu Mwenyezi Mlungu macheye. Hinyo atu taayaricha kumlunga Mwenyezi Mlungu, Mlungu wa akare aho siku zosi za utawala wa Josiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
