              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halafu mfalume achiima phatuphe achiika chilagane mbere za Mwenyezi Mlungu, kukala andamlunga Mwenyezi Mlungu, na kugbwira malagizoge, shariyaze na amurize kpwa moyowe wosi na kpwa rohoye yosi, na kugbwira maneno ga chilagane, garigoandikpwa kpwenye chitabu chicho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achiaambira atu a Jerusalemu na Benjamini ahende dza vivyo. Nao achiahidi kumuabudu Mwenyezi Mlungu, Mlungu wa akare aho tu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
