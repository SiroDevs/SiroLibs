          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho hiye Mkushi achitsoloka, naye achiamba, “Nkakurehera habari nono bwana wangu mfalume. Rero Mwenyezi Mlungu akakutivya kula kpwa hinyo osi ariounuka kupigana nawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye mfalume achimuuza hiye Mkushi, “Dze, ye barobaro Abusalomu a salama?” Hiye Mkushi achimjibu achiamba, “Aviha a bwana wangu mfalume, na osi aunukao ili akudhuru na akale dza arivyo hiye barobaro.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
