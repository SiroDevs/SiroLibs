                "loc": "1SA.20.15+1SA.20.16+1SA.20.17"
              },
              "items": [
                {
                  "text": "1 Samueli 20:15–17",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Daudi wauza, “Dze, takuna hata mutu mmwenga wa chivyazi cha Sauli ariyesala, niphahe kumuhendera manono kpwa ajili ya Jonathani?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phakala na mtumishi mmwenga wa nyumba ya Sauli, aihwaye Siba, phahi amuiha aphiye kpwa Daudi na mfalume achimuuza, “We ndiwe Siba?” Naye achiamba, “Ehe ndimi, mfalume!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.4.4"
              },
              "items": [
                {
                  "text": "2 Samueli 4:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Mfalume achiamba, “Dze, hivi sambi takuna mutu yeyesi wa chivyazi cha Sauli, niphahe kumuhendera manono kama nrivyoahidi mbere za Mlungu?” Siba achimjibu mfalume achiamba, “Bado kuna mwana mmwenga wa Jonathani ambaye nchiswere.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfalume achimuuza, “A kuphi?” Siba achimjibu mfalume achiamba, “A hiko Lo-Debari, nyumbani kpwa Makiri mwana wa Amieli.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi mfalume Daudi wahuma atu hiko Lo-Debari, kpwendamuhala kula kpwa Makiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mefiboshethi mwana wa Jonathani, mdzukulu wa Sauli ariphofika kpwa Daudi, wazama hadi chilangu chichiguta photsi kumupha ishima. Daudi achimuiha, “Mefiboshethi!” Naye achiihika, “Ee himi hipha mtumishio!” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi achimuamba, “Usiogophe, mana kpwa kpweli ndakuhendera manono kpwa ajili ya sowe Jonathani, nami ndakuuyizira minda yosi ya tsaweyo Sauli, nawe undarya phamwenga nami siku zosi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshethi wasujudu tsona achiamba, “Kpwa utu wani unanishuulikiya mimi mtumishio nisiye na mana dza diya ra kufwa?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho mfalume achimuiha Siba, mtumishi wa Sauli achimuamba, “Mali yosi iriyokala ya Sauli na ya chivyaziche, nkamupha mdzukulu wa bwanao. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe na anao phamwenga na atumishio mundamrimira mindaye, nawe undamrehera mdzukulu wa bwanao mavunoge, ili akale na chakurya, ela Mefiboshethi, andarya kpwangu siku zosi.” (Hiye Siba kala ana ana kumi na atsano na atumwa mirongo miiri.)",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipho Siba achimuambira mfalume, “Mino mtumwao ndahenda higo gosi dza vyo ambavyo uwe bwana wangu mfalume, uchivyoniamuru.” Phahi Mefiboshethi warya kpwa mfalume dza mmwengawapho wa ana a mfalume. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiye Mefiboshethi kala ana mwana mdide aihwaye Mika. Na atu osi ariosagala nyumbani mwa Siba kala ni atumwa a Mefiboshethi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpwa vira Mefiboshethi kala nchiswere, wasagala hiko Jerusalemu mana kala achirya kpwa mfalume siku zosi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
