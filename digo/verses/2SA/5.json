              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti auya tsona, achimwagikana Dete ra Arafa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.22",
            "verseOrgIds": [
