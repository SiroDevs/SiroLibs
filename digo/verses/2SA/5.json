          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho ndiphosikira misindo dzulu ya yo miforisadi, ndipho nawe uphiye wangbwi-wangbwi kpwa kukala Mwenyezi Mlungu akakutanguliya mberezo kpwendapiga jeshi ra Afilisti.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.24",
            "verseOrgIds": [
              "2SA.5.24"
            ]
          }
        },
