            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.3.4"
              },
              "items": [
                {
                  "text": "1 Nyakati 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.27"
              },
              "items": [
                {
                  "text": "29:27",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Daudi kala ana miaka mirongo mihahu ariphoandza kutawala, naye watawala miaka mirongo mine. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
              "2SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiko Heburoni watawala miaka sabaa na miezi sita na hiko Jerusalemu watawala miaka mirongo mihahu na mihahu Iziraeli yosi na Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.5",
            "verseOrgIds": [
              "2SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 5:5"
          },
          "items": [
            {
