              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi dzimanyirireni. Nakuambirani chimbere mambo higa gosi kabila tagadzangbwehendeka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.23",
