            "number": "35",
            "style": "v",
            "sid": "MRK 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesu ariphokala anafundza muhalani, muhala wa Nyumba ya Kuvoya Mlungu, wauza, “Kpwani alimu a Shariya a sawa achiamba Masihi",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:35",
              "type": "text"
            },
            {
              "text": "Yani",
              "type": "text"
            },
            {
              "text": "Masihi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ni chivyazi cha Mfalume Daudi? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.35",
            "verseOrgIds": [
              "MRK.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zaburi 110:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ambapho Daudi mwenye walongozwa ni Roho Mtakatifu achiamba:",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.36",
            "verseOrgIds": [
              "MRK.12.36"
            ]
          }
        }
      ]
    },
    {
