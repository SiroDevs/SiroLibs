              "MRK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.8"
              },
              "items": [
                {
                  "text": "Mahendo 23:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Siku mwenga Jesu watsolokerwa ni Masadukayo anjina. Nao Masadukayo ni kundi ra Ayahudi asioamini kukala atu achifwa andafufuka. Phahi achimuamba, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.18",
            "verseOrgIds": [
              "MRK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Kumbukumbu 25:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“Mwalimu, Musa wahuandikira kpwenye Shariya kukala, mutu achifwa na achikala karichire mwana, nduguye ni lazima ahale ufwa hiye gungu, na amvyarire ana yuya mufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.19",
            "verseOrgIds": [
              "MRK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho kare kpwahenda ndugu sabaa. Wa mwandzo walóla mchetu, na ariphofwa karichire ana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.20",
            "verseOrgIds": [
              "MRK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdidewe achihala ufwa yuya gungu, naye achifwa bila kuricha ana. Dzambo hiro rakala vivyo na ndugu wa hahu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.21",
            "verseOrgIds": [
              "MRK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osi sabaa alóla hiyu gungu ela afwa osi bila kuricha mwana. Mwisho, yuya mchetu naye piya wafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.22",
            "verseOrgIds": [
              "MRK.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, siku ndiphofufulwa atu, yuya mchetu andakala mkpwaza ani? Mana ndugu osi sabaa amlóla.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.12.23",
            "verseOrgIds": [
              "MRK.12.23"
            ]
          }
        }
      ]
    },
    {
