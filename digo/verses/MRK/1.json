                "loc": "MAL.3.1"
              },
              "items": [
                {
                  "text": "Malaki 3:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "viratu irivyoandikpwa ni manabii Isaya kukala,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.2",
            "verseOrgIds": [
              "MRK.1.2"
            ]
          }
        }
