            "caller": "#"
          },
          "items": [
            {
              "text": "1:1",
              "type": "text"
            },
            {
              "text": "Injili",
              "type": "text"
            },
            {
              "text": "manage ni habari nono.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuhusu Jesu Masihi, Mwana wa Mlungu. Habarize zaandza, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.1",
            "verseOrgIds": [
              "MRK.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
