                "loc": "ZEP.2.8+ZEP.2.9+ZEP.2.10+ZEP.2.11"
              },
              "items": [
                {
                  "text": "Zefania 2:8–11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "“ ‘Mwenyezi Mlungu anaamba hivi: Kpwa kukala Moabu na Seiri nkuamba, “Lola, nyo atu a Juda ni sawa na mataifa gosi ganjina,” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.8",
            "verseOrgIds": [
              "EZK.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kpwa hivyo nindausira Moabu urindzi kpwa kuhenda midziye iriyo miphakani ivamiywe, midzi ihendayo Moabu idzikarye. Midzi yenye ni Bethi-Jeshimothi, Baali-Meoni na Kiriathaimu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.9",
            "verseOrgIds": [
              "EZK.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindalavya Moabu phamwenga na Amoni kpwa atu a mlairo wa dzuwa zikale zao, ili Aamoni asitambukirwe tsona kahi za mataifa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nami ndahukumu Moabu, nao andamanya kukala mimi, ndimi Mwenyezi Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
      ]
    },
