              "EZK.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Uhu ndio wira wa sonono ambao andamuimba. Achetu a mataifa ganjina andaimba Misiri na jeshire kulu, mimi Mwenyezi Mlungu nkaamba.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.16",
            "verseOrgIds": [
              "EZK.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
