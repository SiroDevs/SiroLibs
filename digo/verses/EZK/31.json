              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.17",
            "verseOrgIds": [
              "EZK.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Ni muhi uphi wa Edeni ambao unaweza kufwananishwa na ngumayo na ukuluo we Farao? Uwe undatserezwa phamwenga na mihi ya Edeni ko kuzimu, undalazwa kahi ya nyo asiotiywa tsatsani, phamwenga na arioolagbwa na upanga. Higa ndigo ndigomphaha Farao phamwenga na jeshire kulu, Mwenyezi Mlungu anaamba.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.31.18",
            "verseOrgIds": [
              "EZK.31.18"
            ]
          }
        }
      ]
