          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsona go maryango ga muhala wa ndani kala gana baraza pande zosi zenye ure wa mita mbiri na nusu na upana wa mita kumi na mbiri na nusu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
