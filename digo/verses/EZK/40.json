          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barazaye kala inalola muhala wa kondze, na zo kuta za phatu pha kumenyera baraza kala zikatsongbwa mitende na ngazize kala zina nyago nane.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.31",
