          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye achichifwenula mbere zangu, nacho kala chikaandikpwa kosi-kosi, kala chikaandikpwa mawira ga sonono, chiriro na mashaka.",
          "type": "text",
          "attrs": {
