                {
                  "text": "Maono 5:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Chisha nchiona nkagoloserwa mkpwono ambao kala ukagbwira chitabu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
