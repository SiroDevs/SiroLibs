                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Siku ya kumi na mbiri ya mwezi wa kumi, mwaka wa kumi bada ya kutsamizwa kpwa lazima, Mwenyezi Mlungu wagomba nami achiamba, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwanadamu, elekeza usoo uphande ariko Farao, mfalume wa Misiri na ulavye unabii chinyumeche na chinyume cha Misiri yosi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.2",
            "verseOrgIds": [
              "EZK.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomba naye uambe, ‘Mwenyezi Mlungu anaamba hivi:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.3",
            "verseOrgIds": [
              "EZK.29.3"
            ]
          }
        }
      ]
    },
    {
