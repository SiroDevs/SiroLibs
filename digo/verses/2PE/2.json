              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.5",
            "verseOrgIds": [
              "2PE.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2PE 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Mwandzo 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phapho hipho hunamanya tsona kuhusu midzi ya Sodoma na Gomora. Mlungu waiocha na moho midzi hino ili rikale fundzo kpwa atu asiolonda kulunga maneno ga Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.6",
            "verseOrgIds": [
              "2PE.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.1+GEN.19.2+GEN.19.3+GEN.19.4+GEN.19.5+GEN.19.6+GEN.19.7+GEN.19.8+GEN.19.9+GEN.19.10+GEN.19.11+GEN.19.12+GEN.19.13+GEN.19.14+GEN.19.15+GEN.19.16"
              },
              "items": [
                {
                  "text": "Mwandzo 19:1–16",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Ela Lutu kala achiishi phamwenga na atu hinyo ayi, na iye kala ni mutu mnono mbere za Mlungu. Chila siku, Lutu kala achiona na kusikira mambo ga waibu, na moyowe kala unaphya sababu ya mambo mai ambago kala ganahendwa. Kpwa hivyo, wakati hinyo Mlungu anaocha midzi hiyo, wamtivya Lutu ariyekala wa haki.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7+2PE.2.8",
            "verseOrgIds": [
              "2PE.2.7",
              "2PE.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2PE 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.7+2PE.2.8",
            "verseOrgIds": [
              "2PE.2.7",
              "2PE.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2PE 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dze, mambo gano ganahuonyesani? Ganaonyesa kukala Mlungu anamanya njira ambazo andativya atue anono agayao. Ela andaatiya adabu atu ayi kpwenderera hadi siku ya uamuli,",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:9",
              "type": "text"
            },
            {
              "text": "Mana yanjina ni:",
              "type": "text"
            },
            {
              "text": "Ela Mlungu nkuaika atu ayi kugodzera siku ya hukumu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.9",
            "verseOrgIds": [
              "2PE.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2PE 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "haswa hara ambao andalunga tamaa mbii za miri yao na kuricha kuogopha utawalawe. Atu a ngulu na ajeuri asioishimu viumbe vya dzulu mlunguni, ela nkuvilaphiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.10",
            "verseOrgIds": [
              "2PE.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata malaika ario na uwezo zaidi kuriko atu, taalaphiza wala kulavya mashitaka kuhusu viumbe hivyo mbere za Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2PE 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.11",
            "verseOrgIds": [
              "2PE.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2PE 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha alimu a handzo nkulaphiza vitu asivyovimanya. Ni dza nyama a weruni ahendao mambo bila kuririkana, na ariovyalwa ili agbwirwe na kuolagbwa. Mlungu andaangamiza dza viratu anadamu aolagavyo nyama. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.12",
            "verseOrgIds": [
              "2PE.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2PE 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andagaya kpwa sababu agayisa atu anjina. Anahererwa kuhenda sharee za marya, na kuzinga wakati wa mutsi. Nkuhererwa kukuchengani wakati munarya nao phamwenga, na kpwa njira hino nkukutiyani waibu dza dowa ra nguwo nyereru. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.13",
            "verseOrgIds": [
              "2PE.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2PE 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atu aha achiona mchetu nkumuaza, na tamaa yao ya kuzinga taisira. Nkurusa atu ambao taadinire chiroho na chila wakati achili zao nkufikiriya kuphaha pesa. Phahi atu aha analaniwa ni Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.14",
            "verseOrgIds": [
              "2PE.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2PE 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.4+NUM.22.5+NUM.22.6+NUM.22.7+NUM.22.8+NUM.22.9+NUM.22.10+NUM.22.11+NUM.22.12+NUM.22.13+NUM.22.14+NUM.22.15+NUM.22.16+NUM.22.17+NUM.22.18+NUM.22.19+NUM.22.20+NUM.22.21+NUM.22.22+NUM.22.23+NUM.22.24+NUM.22.25+NUM.22.26+NUM.22.27+NUM.22.28+NUM.22.29+NUM.22.30+NUM.22.31+NUM.22.32+NUM.22.33+NUM.22.34+NUM.22.35"
              },
              "items": [
                {
                  "text": "Isabu 22:4–35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": "Aricha njira nono imuhamirayo Mlungu, achiangamika dza arivyoangamika Balaamu, mwana wa Beori, yemendza kuphaha pesa kpwa kuhenda mambo mai. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.15",
            "verseOrgIds": [
              "2PE.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela hiye nabii Balaamu wademurirwa kpwa dambize. Pundawe wagomba kpwa raka ra mutu, na achiricha Balaamu asihende higo mambo ga koma.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2PE 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.16",
            "verseOrgIds": [
              "2PE.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2PE 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinya alimu a handzo taana rorosi dza vidzuho vyouma, na piya ni dza maingu gophepheruswa ni phuto kali, gasigoreha mvula. Kpwa hivyo Mlungu andaatiya adabu phatu phenye chilungulungu cha jiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.17",
            "verseOrgIds": [
              "2PE.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nkugomba maneno ga chizuzu na kudzikarya. Kpwa kuhumira tamaa mbii za mwiri anarusa afuasi ambao anaandza kuishi maisha manono chinyume cha hara anaoishi maisha mai. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.18",
            "verseOrgIds": [
              "2PE.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkulavya ahadi za handzo kuhusu uhuru wa chiroho kuno nyo enye ni atumwa a ndzimo mbii ambazo zinaangamiza. Mana mutu nkuhendwa mtumwa ni chochosi ambacho chinamtawala. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.19",
            "verseOrgIds": [
              "2PE.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hipho mwandzo atu aha aricha kutawalwa ni tamaa mbii za dunia kpwa sababu anamanya Bwana na Muokoli wehu Jesu Masihi. Ela auyirapho garatu ga kare nkuinjira muhamboni, akatawalwa tsona ni tamaa mbii. Vivi sambi a tabuni zaidi kuriko pho mwandzo wakati kala taadzangbwemmanya Jesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.20",
            "verseOrgIds": [
              "2PE.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hata hivyo ingekala vinono kalapho taayamanya njira za kumuhamira Mlungu, kuriko kuzimanya na alafu kugaluka na kuricha kulunga malagizoge matakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.2.21",
            "verseOrgIds": [
              "2PE.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2PE 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.26.11"
              },
              "items": [
                {
                  "text": "Misemo 26:11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
