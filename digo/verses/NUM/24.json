            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha achilavya ujumbe uhu achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.15",
            "verseOrgIds": [
              "NUM.24.15"
            ]
