          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha Balaamu achiona Amaleki kpwenye ruwiya na achilavya ujumbe huno achiamba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.24.20",
