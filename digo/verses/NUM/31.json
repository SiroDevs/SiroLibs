          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chisha maofisaa ambao kala anaimirira vikosi vya jeshi, yani akulu a vikosi vya anajeshi elufu-elufu na a vikosi vya anajeshi gana-gana aphiya kpwa Musa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.48",
            "verseOrgIds": [
              "NUM.31.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
