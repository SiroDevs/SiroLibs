              "type": "text"
            }
          ]
        },
        {
          "text": "Musa na mlavyadzi-sadaka Eliazari achiphokera yo miyo ya zahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
