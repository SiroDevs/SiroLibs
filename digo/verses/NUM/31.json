          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vivi hukamrehera Mwenyezi Mlungu sadaka vitu vya zahabu hurivyoviphaha: mikufu, bangili, pehe, vipuli na shanga hupatanishwe na Mwenyezi Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.50",
            "verseOrgIds": [
              "NUM.31.50"
            ]
          }
        }
