                "loc": "HEB.12.26"
              },
              "items": [
                {
                  "text": "Aeburania 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": "\n",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mana Mwenyezi Mlungu, Mlungu wa majeshi anaamba, ‘Bado muda mchache tu nindasumbisa tsona mlungu na dunia, bahari na tsi kavu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAG 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu, Mlungu wa majeshi anaamba, ‘Mataifa ganjina gosi nindagatikisa na utajiri wao wosi andaureha hipha na nyumba hino niiodzaze nguma.’ ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Mwenyezi Mlungu, Mlungu wa majeshi anaamba, ‘Feza na zahabu ni mali yangu.’ ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyezi Mlungu, Mlungu wa majeshi anaamba, ‘Nguma ya mwisho ya nyumba hino indakala kulu kutsupa hira ya mwandzo na phapha hipha nindakuphani amani.’”",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
