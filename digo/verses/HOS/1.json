              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.5",
            "verseOrgIds": [
              "HOS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gomeri achigbwira mimba tsona na achidzivugula mwana mchetu. Ndipho Mwenyezi Mlungu achigomba na Hosea achimuamba, “Hiyu dzinare muihe Loruhama,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:6",
              "type": "text"
            },
            {
              "text": "Loruhama",
              "type": "text"
            },
            {
              "text": "manaye ni",
              "type": "text"
            },
            {
              "text": "sindamuonera mbazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mana sindaaonera tsona mbazi atu a Iziraeli, wala kuaswamehe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.6",
            "verseOrgIds": [
              "HOS.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ela nindaaonera mbazi atu a Juda, nami nindaativya bila ya viha. Sindahumira maha, panga, farasi, wala anajeshi akuhumira farasi, ela kpwa nguvu zangu mimi Mwenyezi Mlungu, Mlungu wao.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.7",
            "verseOrgIds": [
              "HOS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Gomeri ariphomrikisa Loruhama, wagbwira mimba yanjina, achivyala mwana mlume wa phiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.8",
            "verseOrgIds": [
              "HOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phahi Mwenyezi Mlungu wagomba na Hosea achimuamba, ‘Hiyu muihe Loami,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:9",
              "type": "text"
            },
            {
              "text": "Loami",
              "type": "text"
            },
            {
              "text": "manaye ni",
              "type": "text"
            },
            {
              "text": "Mwimwi simwi atu angu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kpwa mana mwimwi simwi atu angu, nami simi Mlungu wenu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.1.9",
            "verseOrgIds": [
              "HOS.1.9"
            ]
          }
        }
      ]
    },
