          "items": [
            {
              "text": "3.6",
              "type": "text"
            },
            {
              "text": "Other ancient authorities insert",
              "type": "text"
            },
            {
              "text": "firm to the end",
              "type": "text"
            }
          ]
        }
      ]
    },
