              },
              "items": [
                {
                  "text": "Rev 18.21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " When you finish reading this book, bind a stone to it, and cast it into the midst of the Euphrates, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.63",
            "verseOrgIds": [
              "JER.51.63"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "64",
            "style": "v",
            "sid": "JER 51:64"
          },
          "items": [
            {
              "text": "64",
              "type": "text"
            }
          ]
        },
        {
          "text": "and say, ‘Thus shall Babylon sink, to rise no more, because of the evil that I am bringing upon her.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.51.64",
            "verseOrgIds": [
              "JER.51.64"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
