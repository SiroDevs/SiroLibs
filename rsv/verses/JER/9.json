          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Thus says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.23",
            "verseOrgIds": [
              "JER.9.23"
            ]
          }
        },
