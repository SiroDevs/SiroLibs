          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "text": " said to me, “You have seen well, for I am watching",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.12",
              "type": "text"
            },
            {
              "text": "Heb",
              "type": "text"
            },
            {
              "text": "shoqed",
              "type": "text"
            }
          ]
        },
        {
          "text": " over my word to perform it.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
