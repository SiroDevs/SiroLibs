                {
                  "text": "Rev 6.8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Though they fast, I will not hear their cry, and though they offer burnt offering and cereal offering, I will not accept them; but I will consume them by the sword, by famine, and by pestilence.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
