{
  "id": "JER.34",
  "number": "34",
  "bookId": "JER",
  "reference": "Jeremiah 34",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
