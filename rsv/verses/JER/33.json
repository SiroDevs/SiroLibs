              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“For thus says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "text": ": David shall never lack a man to sit on the throne of the house of Israel, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "and the Levitical priests shall never lack a man in my presence to offer burnt offerings, to burn cereal offerings, and to make sacrifices for ever.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
      ]
