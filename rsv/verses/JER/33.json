          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Behold, the days are coming, says the ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "text": ", when I will fulfil the promise I made to the house of Israel and the house of Judah. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
