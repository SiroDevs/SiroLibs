          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Jer 23.5",
                  "type": "text"
