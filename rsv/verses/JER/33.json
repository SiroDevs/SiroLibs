        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
