{
  "id": "JER.36",
  "number": "36",
  "bookId": "JER",
  "reference": "Jeremiah 36",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "36",
