            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Now Solomon purposed to build a temple for the name of the ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        },
        {
          "text": ", and a royal palace for himself. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.2.1",
            "verseOrgIds": [
              "2CH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
