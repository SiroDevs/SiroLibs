                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.15"
              },
              "items": [
                {
                  "text": "1 Kings 5.15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.16"
              },
              "items": [
                {
                  "text": "16",
