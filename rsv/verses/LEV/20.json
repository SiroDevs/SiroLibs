          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "text": " said to Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.1",
            "verseOrgIds": [
              "LEV.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 20:2"
          },
          "items": [
            {
