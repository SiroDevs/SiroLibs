            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Consecrate yourselves therefore, and be holy; for I am the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "text": " your God. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keep my statutes, and do them; I am the ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
        {
          "text": " who sanctify you. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
