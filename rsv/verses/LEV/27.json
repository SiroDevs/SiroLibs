          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "If a man wishes to redeem any of his tithe, he shall add a fifth to it. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
