        },
        {
          "text": "Thus the Lord ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "text": " showed me: behold, the Lord ",
