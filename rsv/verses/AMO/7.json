          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Amos answered Amaziah, “I am no prophet, nor a prophet's son;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
