              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "one of the sons of the prophets",
              "type": "text"
            }
          ]
        },
        {
          "text": " but I am a herdsman, and a dresser of sycamore trees, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
