              "type": "text"
            },
            {
              "text": "let us",
              "type": "text"
            }
          ]
        },
        {
          "text": " have peace with God through our Lord Jesus Christ. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.1",
            "verseOrgIds": [
              "ROM.5.1"
            ]
