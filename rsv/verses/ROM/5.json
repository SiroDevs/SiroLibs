          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.2",
              "type": "text"
            },
            {
              "text": "Other ancient authorities add",
              "type": "text"
            },
            {
              "text": "by faith",
              "type": "text"
            }
          ]
        },
        {
          "text": " to this grace in which we stand, and we",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5.2",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "let us",
              "type": "text"
            }
          ]
        },
        {
          "text": " rejoice in our hope of sharing the glory of God. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.2",
            "verseOrgIds": [
              "ROM.5.2"
            ]
          }
        },
        {
