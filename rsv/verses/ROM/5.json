              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.16"
              },
              "items": [
                {
                  "text": "1 Jn 3.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.10"
