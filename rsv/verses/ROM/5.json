                {
                  "text": "Jn 15.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.32"
              },
              "items": [
                {
                  "text": "Rom 8.32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
