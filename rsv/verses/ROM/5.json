              "type": "tag",
              "attrs": {
                "loc": "ROM.6.23"
              },
              "items": [
                {
                  "text": "Rom 6.23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
