          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "and do not turn aside after",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.21",
            "verseOrgIds": [
              "1SA.12.21"
            ]
          }
        },
        {
