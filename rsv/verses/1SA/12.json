            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Samuel said to the people, “Fear not; you have done all this evil, yet do not turn aside from following the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "text": ", but serve the ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "text": " with all your heart; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.12.20",
            "verseOrgIds": [
              "1SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
