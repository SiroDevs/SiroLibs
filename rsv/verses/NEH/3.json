          },
          "items": [
            {
              "text": "3.9",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "foreman of half the portion assigned to",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jerusalem, repaired. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.9",
            "verseOrgIds": [
              "NEH.3.9"
            ]
          }
