            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Eliashib the high priest rose up with his brethren the priests and they built the Sheep Gate. They consecrated it and set its doors; they consecrated it as far as the Tower of the Hundred, as far as the Tower of Hananel. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "And next to him the men of Jericho built. And next to them",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.2",
              "type": "text"
            },
            {
              "text": "Heb",
              "type": "text"
            },
            {
              "text": "him",
              "type": "text"
            }
          ]
        },
        {
          "text": " Zaccur the son of Imri built.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
