          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malchijah the son of Harim and Hasshub the son of Pahath-moab repaired another section and the Tower of the Ovens. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
