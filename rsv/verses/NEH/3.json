            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "And next to them Meremoth the son of Uriah, son of Hakkoz repaired. And next to them Meshullam the son of Berechiah, son of Meshezabel repaired. And next to them Zadok the son of Baana repaired. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "And next to them the Tekoites repaired; but their nobles did not put their necks to the work of their ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.5",
            "verseOrgIds": [
              "NEH.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
