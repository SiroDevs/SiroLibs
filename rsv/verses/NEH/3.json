          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.12",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "foreman of half the portion assigned to",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jerusalem, repaired, he and his daughters.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        }
