          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Next to them Jedaiah the son of Harumaph repaired opposite his house; and next to him Hattush the son of Hashabneiah repaired. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
