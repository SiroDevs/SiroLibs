              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "foreman of half the portion assigned to",
              "type": "text"
            }
          ]
        },
        {
          "text": " Keilah, repaired for his district. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.17",
            "verseOrgIds": [
              "NEH.3.17"
            ]
          }
