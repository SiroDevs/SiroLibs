          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "After him Nehemiah the son of Azbuk, ruler of half the district of",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        },
