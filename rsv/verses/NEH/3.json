            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.8",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "abandoned",
              "type": "text"
            }
          ]
        },
        {
          "text": " Jerusalem as far as the Broad Wall. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.8",
            "verseOrgIds": [
              "NEH.3.8"
            ]
          }
        },
        {
