            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And one called to another and said:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
