        },
        {
          "text": "In the year that King Uzziah died I saw the Lord sitting upon a throne, high and lifted up; and his train filled the temple. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Above him stood the seraphim; each had six wings: with two he covered his face, and with two he covered his feet, and with two he flew. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
