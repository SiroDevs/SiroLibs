          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "In that day their strong cities will be like the deserted places of the Hivites and the Amorites,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
