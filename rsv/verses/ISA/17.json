              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "In that day men will regard their Maker, and their eyes will look to the Holy One of Israel; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "they will not have regard for the altars, the work of their hands, and they will not look to what their own fingers have made, either the Asherim or the altars of incense.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
