          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finally, my brethren, rejoice in the Lord. To write the same things to you is not irksome to me, and is safe for you.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.1",
            "verseOrgIds": [
              "PHP.3.1"
            ]
          }
        }
      ]
    },
    {
