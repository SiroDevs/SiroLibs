              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.33"
              },
              "items": [
                {
                  "text": "1 Cor 10.33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.14"
              },
              "items": [
                {
                  "text": "Rom 11.14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " To the weak I became weak, that I might win the weak. I have become all things to all men, that I might by all means save some. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.22",
            "verseOrgIds": [
              "1CO.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CO 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "I do it all for the sake of the gospel, that I may share in its blessings.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
            "verseOrgIds": [
              "1CO.9.23"
            ]
          }
        }
      ]
    },
