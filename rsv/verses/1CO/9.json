                "loc": "ROM.2.12"
              },
              "items": [
                {
                  "text": "Rom 2.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
