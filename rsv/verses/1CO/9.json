                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.8"
              },
              "items": [
                {
                  "text": "4.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.12"
              },
              "items": [
                {
                  "text": "Jas 1.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.5.4"
              },
              "items": [
                {
                  "text": "1 Pet 5.4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Every athlete exercises self-control in all things. They do it to receive a perishable wreath, but we an imperishable. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.25",
            "verseOrgIds": [
              "1CO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Well, I do not run aimlessly, I do not box as one beating the air; ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.26",
            "verseOrgIds": [
              "1CO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "but I pommel my body and subdue it, lest after preaching to others I myself should be disqualified.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.27",
            "verseOrgIds": [
              "1CO.9.27"
            ]
          }
        }
