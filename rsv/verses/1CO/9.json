            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.1"
              },
              "items": [
                {
                  "text": "Heb 12.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Do you not know that in a race all the runners compete, but only one receives the prize? So run that you may obtain it. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.24",
            "verseOrgIds": [
              "1CO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
