              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Therefore I sent",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.17",
            "verseOrgIds": [
              "1CO.4.17"
            ]
          }
        },
        {
          "name": "note",
