                  "text": "2 Cor 1.23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " What do you wish? Shall I come to you with a rod, or with love in a spirit of gentleness?",
          "type": "text",
