                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " This is how one should regard us, as servants of Christ and stewards of the mysteries of God. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.1",
            "verseOrgIds": [
              "1CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moreover it is required of stewards that they be found trustworthy. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.2",
            "verseOrgIds": [
              "1CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "But with me it is a very small thing that I should be judged by you or by any human court. I do not even judge myself. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.3",
            "verseOrgIds": [
              "1CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.12"
              },
              "items": [
                {
                  "text": "2 Cor 1.12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " I am not aware of anything against myself, but I am not thereby acquitted. It is the Lord who judges me. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.4",
            "verseOrgIds": [
              "1CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.16"
              },
              "items": [
                {
                  "text": "Rom 2.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.13"
              },
              "items": [
                {
                  "text": "1 Cor 3.13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.18"
              },
              "items": [
                {
                  "text": "2 Cor 10.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.29"
              },
              "items": [
                {
                  "text": "Rom 2.29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Therefore do not pronounce judgment before the time, before the Lord comes, who will bring to light the things now hidden in darkness and will disclose the purposes of the heart. Then every man will receive his commendation from God.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        }
      ]
    },
