              "1CO.6.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.39+MAT.5.40"
              },
              "items": [
                {
                  "text": "Mt 5.39-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " To have lawsuits at all with one another is defeat for you. Why not rather suffer wrong? Why not rather be defrauded? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.7",
            "verseOrgIds": [
              "1CO.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "But you yourselves wrong and defraud, and that even your own brethren.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.6.8",
            "verseOrgIds": [
              "1CO.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
