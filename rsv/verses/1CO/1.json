                {
                  "text": "1 Cor 3.4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.24"
              },
              "items": [
                {
                  "text": "Acts 18.24",
                  "type": "text"
                }
              ]
