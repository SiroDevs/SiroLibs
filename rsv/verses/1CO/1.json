            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " I give thanks to God",
          "type": "text",
          "attrs": {
            "verseId": "1CO.1.4",
            "verseOrgIds": [
              "1CO.1.4"
            ]
          }
