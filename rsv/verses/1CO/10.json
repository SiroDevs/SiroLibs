              "items": [
                {
                  "text": "Rom 15.2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.5"
              },
              "items": [
                {
                  "text": "1 Cor 13.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " just as I try to please all men in everything I do, not seeking my own advantage, but that of many, that they may be saved.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.10.33",
            "verseOrgIds": [
              "1CO.10.33"
            ]
          }
        }
