              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moses and Aaron did all these wonders before Pharaoh; and the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        },
        {
          "text": " hardened Pharaoh's heart, and he did not let the people of Israel go out of his land.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
