            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“When men quarrel and one strikes the other with a stone or with his fist and the man does not die but keeps his bed, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.18",
            "verseOrgIds": [
              "EXO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "then if the man rises again and walks abroad with his staff, he that struck him shall be clear; only he shall pay for the loss of his time, and shall have him thoroughly healed.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.19",
            "verseOrgIds": [
              "EXO.21.19"
            ]
          }
        }
      ]
