            }
          ]
        },
        {
          "text": " “The first of the first fruits of your ground you shall bring into the house of the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
          "text": " your God.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
