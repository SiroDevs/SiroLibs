        {
          "text": " “Six days you shall do your work, but on the seventh day you shall rest; that your ox and your ass may have rest, and the son of your bondmaid, and the alien, may be refreshed. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
