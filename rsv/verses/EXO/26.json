            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “And you shall make a veil of blue and purple and scarlet stuff and fine twined linen; in skilled work shall it be made, with cherubim; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "and you shall hang it upon four pillars of acacia overlaid with gold, with hooks of gold, upon four bases of silver. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "And you shall hang the veil from the clasps, and bring the ark of the testimony in thither within the veil; and the veil shall separate for you the holy place from the most holy. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall put the mercy seat upon the ark of the testimony in the most holy place. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "And you shall set the table outside the veil, and the lampstand on the south side of the tabernacle opposite the table; and you shall put the table on the north side.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
    },
