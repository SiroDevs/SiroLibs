              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then came Amalek and fought with Israel at Rephidim. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.8",
            "verseOrgIds": [
              "EXO.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Moses said to Joshua, “Choose for us men, and go out, fight with Amalek; tomorrow I will stand on the top of the hill with the rod of God in my hand.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.9",
            "verseOrgIds": [
              "EXO.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Joshua did as Moses told him, and fought with Amalek; and Moses, Aaron, and Hur went up to the top of the hill. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.10",
            "verseOrgIds": [
              "EXO.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Whenever Moses held up his hand, Israel prevailed; and whenever he lowered his hand, Amalek prevailed. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.11",
            "verseOrgIds": [
              "EXO.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "But Moses' hands grew weary; so they took a stone and put it under him, and he sat upon it, and Aaron and Hur held up his hands, one on one side, and the other on the other side; so his hands were steady until the going down of the sun. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.12",
            "verseOrgIds": [
              "EXO.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Joshua mowed down Amalek and his people with the edge of the sword.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.13",
            "verseOrgIds": [
              "EXO.17.13"
            ]
          }
        }
      ]
    },
