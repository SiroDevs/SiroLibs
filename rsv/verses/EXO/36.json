          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he made bars of acacia wood, five for the frames of the one side of the tabernacle, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.31",
            "verseOrgIds": [
              "EXO.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "and five bars for the frames of the other side of the tabernacle, and five bars for the frames of the tabernacle at the rear westward. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.32",
            "verseOrgIds": [
              "EXO.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he made the middle bar to pass through from end to end halfway up the frames. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.33",
            "verseOrgIds": [
              "EXO.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he overlaid the frames with gold, and made their rings of gold for holders for the bars, and overlaid the bars with gold.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.34",
            "verseOrgIds": [
              "EXO.36.34"
            ]
          }
        }
      ]
