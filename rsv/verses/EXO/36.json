                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he made the veil of blue and purple and scarlet stuff and fine twined linen; with cherubim skilfully worked he made it. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.35",
            "verseOrgIds": [
              "EXO.36.35"
            ]
          }
        },
