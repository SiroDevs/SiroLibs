            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15.23",
              "type": "text"
            },
            {
              "text": "That is",
              "type": "text"
            },
            {
              "text": "Bitterness",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
