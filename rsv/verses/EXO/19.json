                "loc": "1PE.2.9"
              },
              "items": [
                {
                  "text": "1 Pet 2.9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.6"
              },
              "items": [
                {
                  "text": "Rev 1.6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "5.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Now therefore, if you will obey my voice and keep my covenant, you shall be my own possession among all peoples; for all the earth is mine, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.5",
            "verseOrgIds": [
              "EXO.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "and you shall be to me a kingdom of priests and a holy nation. These are the words which you shall speak to the children of Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.6",
            "verseOrgIds": [
              "EXO.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Moses came and called the elders of the people, and set before them all these words which the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "text": " had commanded him. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.7",
            "verseOrgIds": [
              "EXO.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And all the people answered together and said, “All that the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "text": " has spoken we will do.” And Moses reported the words of the people to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.8",
            "verseOrgIds": [
              "EXO.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "text": " said to Moses. “Lo, I am coming to you in a thick cloud, that the people may hear when I speak with you, and may also believe you for ever.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Moses told the words of the people to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.9",
            "verseOrgIds": [
              "EXO.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
        {
          "text": " said to Moses, “Go to the people and consecrate them today and tomorrow, and let them wash their garments, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.10",
            "verseOrgIds": [
              "EXO.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "and be ready by the third day; for on the third day the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "text": " will come down upon Mount Sinai in the sight of all the people. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.11",
            "verseOrgIds": [
              "EXO.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.18+HEB.12.19+HEB.12.20"
              },
              "items": [
                {
                  "text": "Heb 12.18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And you shall set bounds for the people round about, saying, ‘Take heed that you do not go up into the mountain or touch the border of it; whoever touches the mountain shall be put to death; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.12",
            "verseOrgIds": [
              "EXO.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "no hand shall touch him, but he shall be stoned or shot; whether beast or man, he shall not live.’ When the trumpet sounds a long blast, they shall come up to the mountain.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.13",
            "verseOrgIds": [
              "EXO.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "So Moses went down from the mountain to the people, and consecrated the people; and they washed their garments. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.14",
            "verseOrgIds": [
              "EXO.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "And he said to the people, “Be ready by the third day; do not go near a woman.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.15",
            "verseOrgIds": [
              "EXO.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "On the morning of the third day there were thunders and lightnings, and a thick cloud upon the mountain, and a very loud trumpet blast, so that all the people who were in the camp trembled. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.16",
            "verseOrgIds": [
              "EXO.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Moses brought the people out of the camp to meet God; and they took their stand at the foot of the mountain. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.17",
            "verseOrgIds": [
              "EXO.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Mount Sinai was wrapped in smoke, because the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "text": " descended upon it in fire; and the smoke of it went up like the smoke of a kiln, and the whole mountain quaked greatly. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.18",
            "verseOrgIds": [
              "EXO.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "And as the sound of the trumpet grew louder and louder, Moses spoke, and God answered him in thunder. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "text": " came down upon Mount Sinai, to the top of the mountain; and the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "text": " called Moses to the top of the mountain, and Moses went up. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "text": " said to Moses, “Go down and warn the people, lest they break through to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "text": " to gaze and many of them perish. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "And also let the priests who come near to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "text": " consecrate themselves, lest the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "text": " break out upon them.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Moses said to the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "text": ", “The people cannot come up to Mount Sinai; for thou thyself didst charge us, saying, ‘Set bounds about the mountain, and consecrate it.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
