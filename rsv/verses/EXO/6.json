                  "text": "Gen 46.8-11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.5+NUM.26.6+NUM.26.7+NUM.26.8+NUM.26.9+NUM.26.10+NUM.26.11+NUM.26.12+NUM.26.13+NUM.26.14"
              },
              "items": [
                {
                  "text": "Num 26.5-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " These are the heads of their fathers' houses: the sons of Reuben, the first-born of Israel: Hanoch, Pallu, Hezron, and Carmi; these are the families of Reuben. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.14",
            "verseOrgIds": [
              "EXO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Simeon: Jemuel, Jamin, Ohad, Jachin, Zohar, and Shaul, the son of a Canaanite woman; these are the families of Simeon. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.15",
            "verseOrgIds": [
              "EXO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.3.15+NUM.3.16+NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20"
              },
              "items": [
                {
                  "text": "Num 3.15-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.57+NUM.26.58"
              },
              "items": [
                {
                  "text": "26.57-58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.1"
              },
              "items": [
                {
                  "text": "1 Chron 6.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.16+1CH.6.17+1CH.6.18+1CH.6.19"
              },
              "items": [
                {
                  "text": "16-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " These are the names of the sons of Levi according to their generations: Gershon, Kohath, and Merari, the years of the life of Levi being a hundred and thirty-seven years. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.16",
            "verseOrgIds": [
              "EXO.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Gershon: Libni and Shime-i, by their families. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.17",
            "verseOrgIds": [
              "EXO.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Kohath: Amram, Izhar, Hebron, and Uzziel, the years of the life of Kohath being a hundred and thirty-three years. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
              "EXO.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Merari: Mahli and Mushi. These are the families of the Levites according to their generations. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.19",
            "verseOrgIds": [
              "EXO.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.26.58+NUM.26.59+NUM.26.60"
              },
              "items": [
                {
                  "text": "Num 26.58-60",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Amram took to wife Jochebed his father's sister and she bore him Aaron and Moses, the years of the life of Amram being one hundred and thirty-seven years. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.20",
            "verseOrgIds": [
              "EXO.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Izhar: Korah, Nepheg, and Zichri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.21",
            "verseOrgIds": [
              "EXO.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the sons of Uzziel: Misha-el, Elzaphan, and Sithri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.22",
            "verseOrgIds": [
              "EXO.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaron took to wife Elisheba, the daughter of Amminadab and the sister of Nahshon; and she bore him Nadab, Abihu, Eleazar, and Ithamar. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.23",
            "verseOrgIds": [
              "EXO.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Korah: Assir, Elkanah, and Abiasaph; these are the families of the Korahites. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.24",
            "verseOrgIds": [
              "EXO.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eleazar, Aaron's son, took to wife one of the daughters of Puti-el; and she bore him Phinehas. These are the heads of the fathers' houses of the Levites by their families.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.25",
            "verseOrgIds": [
              "EXO.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
