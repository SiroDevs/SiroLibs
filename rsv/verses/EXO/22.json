              "EXO.22.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n        Lev 5.14—6.7",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.5.5+NUM.5.6+NUM.5.7+NUM.5.8"
              },
              "items": [
                {
                  "text": "Num 5.5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “If a man delivers to his neighbor money or goods to keep, and it is stolen out of the man's house, then, if the thief is found, he shall pay double. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "If the thief is not found, the owner of the house shall come near to God, to show whether or not he has put his hand to his neighbor's goods.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“For every breach of trust, whether it is for ox, for ass, for sheep, for clothing, or for any kind of lost thing, of which one says, ‘This is it,’ the case of both parties shall come before God; he whom God shall condemn shall pay double to his neighbor.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“If a man delivers to his neighbor an ass or an ox or a sheep or any beast to keep, and it dies or is hurt or is driven away, without any one seeing it, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "an oath by the ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "text": " shall be between them both to see whether he has not put his hand to his neighbor's property; and the owner shall accept the oath, and he shall not make restitution. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if it is stolen from him, he shall make restitution to its owner. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "If it is torn by beasts, let him bring it as evidence; he shall not make restitution for what has been torn.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
