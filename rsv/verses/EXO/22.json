              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " You shall not afflict any widow or orphan. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.22"
            ]
