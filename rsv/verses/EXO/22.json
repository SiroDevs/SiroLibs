        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“If a man borrows anything of his neighbor, and it is hurt or dies, the owner not being with it, he shall make full restitution. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "If the owner was with it, he shall not make restitution; if it was hired, it came for its hire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22.15",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "it is reckoned in",
              "type": "text"
            },
            {
              "text": "(Heb",
              "type": "text"
            },
            {
              "text": "comes into",
              "type": "text"
            },
            {
              "text": ")",
              "type": "text"
            },
            {
              "text": "its hire",
              "type": "text"
            }
          ]
        }
      ]
    },
