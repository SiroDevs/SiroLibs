                "loc": "ROM.1.7"
              },
              "items": [
                {
                  "text": "Rom 1.7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " To the saints and faithful brethren in Christ at Colossae:",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Grace to you and peace from God our Father.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "COL 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.2",
            "verseOrgIds": [
              "COL.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "COL 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.16"
              },
              "items": [
                {
                  "text": "Eph 1.16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " We always thank God, the Father of our Lord Jesus Christ, when we pray for you, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.3",
            "verseOrgIds": [
              "COL.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "COL 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "because we have heard of your faith in Christ Jesus and of the love which you have for all the saints, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.4",
            "verseOrgIds": [
              "COL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "COL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "because of the hope laid up for you in heaven. Of this you have heard before in the word of the truth, the gospel ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.5",
            "verseOrgIds": [
              "COL.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "COL 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "which has come to you, as indeed in the whole world it is bearing fruit and growing—so among yourselves, from the day you heard and understood the grace of God in truth, ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.6",
            "verseOrgIds": [
              "COL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "COL 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.4.12"
              },
              "items": [
                {
                  "text": "Col 4.12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.23"
              },
              "items": [
                {
                  "text": "Philem 23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " as you learned it from Epaphras our beloved fellow servant. He is a faithful minister of Christ on our",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1.7",
              "type": "text"
            },
            {
              "text": "Other ancient authorities read",
              "type": "text"
            },
            {
              "text": "your",
              "type": "text"
            }
          ]
        },
        {
          "text": " behalf ",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.7",
            "verseOrgIds": [
              "COL.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "COL 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "and has made known to us your love in the Spirit.",
          "type": "text",
          "attrs": {
            "verseId": "COL.1.8",
            "verseOrgIds": [
              "COL.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
