          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Helem his brother: Zophah, Imna, Shelesh, and Amal. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        },
        {
