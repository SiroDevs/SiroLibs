              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Ulla: Arah, Hanniel, and Rizia. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
