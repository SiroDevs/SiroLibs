          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "The sons of Zophah: Suah, Harnepher, Shual, Beri, Imrah. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
