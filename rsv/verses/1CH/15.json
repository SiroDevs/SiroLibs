{
  "id": "1CH.15",
  "number": "15",
  "bookId": "1CH",
  "reference": "1 Chronicles 15",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
