              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.5"
              },
              "items": [
                {
                  "text": "Acts 18.5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But now that Timothy has come to us from you, and has brought us the good news of your faith and love and reported that you always remember us kindly and long to see us, as we long to see you— ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.6",
            "verseOrgIds": [
              "1TH.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "for this reason, brethren, in all our distress and affliction we have been comforted about you through your faith; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.7",
            "verseOrgIds": [
              "1TH.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "for now we live, if you stand fast in the Lord. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.8",
            "verseOrgIds": [
              "1TH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "For what thanksgiving can we render to God for you, for all the joy which we feel for your sake before our God, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.9",
            "verseOrgIds": [
              "1TH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "praying earnestly night and day that we may see you face to face and supply what is lacking in your faith?",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.10",
            "verseOrgIds": [
              "1TH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Now may our God and Father himself, and our Lord Jesus, direct our way to you; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.11",
            "verseOrgIds": [
              "1TH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "and may the Lord make you increase and abound in love to one another and to all men, as we do to you, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.12",
            "verseOrgIds": [
              "1TH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.8"
              },
              "items": [
                {
                  "text": "1 Cor 1.8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.19"
              },
              "items": [
                {
                  "text": "1 Thess 2.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.17"
              },
              "items": [
                {
                  "text": "4.17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " so that he may establish your hearts unblamable in holiness before our God and Father, at the coming of our Lord Jesus with all his saints.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.13",
            "verseOrgIds": [
              "1TH.3.13"
            ]
          }
        }
      ]
