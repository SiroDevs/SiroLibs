            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And we exhort you, brethren, admonish the idlers, encourage the fainthearted, help the weak, be patient with them all. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.5.14",
            "verseOrgIds": [
              "1TH.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
