              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZR 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "At that time those who had come from captivity, the returned exiles, offered burnt offerings to the God of Israel, twelve bulls for all Israel, ninety-six rams, seventy-seven lambs, and as a sin offering twelve he-goats; all this was a burnt offering to the ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.35",
            "verseOrgIds": [
              "EZR.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZR 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "They also delivered the king's commissions to the king's satraps and to the governors of the province Beyond the River; and they aided the people and the house of God.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.36",
            "verseOrgIds": [
              "EZR.8.36"
            ]
          }
        }
