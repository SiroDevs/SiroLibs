            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "And one of the four living creatures gave the seven angels seven golden bowls full of the wrath of God who lives for ever and ever; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
