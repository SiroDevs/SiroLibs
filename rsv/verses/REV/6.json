                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and I heard what seemed to be a voice in the midst of the four living creatures saying, “A quart of wheat for a denarius,",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.6",
              "type": "text"
            },
            {
              "text": "The denarius was a day's wage for a laborer",
              "type": "text"
            }
          ]
        },
        {
          "text": " and three quarts of barley for a denarius;",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.6",
              "type": "text"
            },
            {
              "text": "The denarius was a day's wage for a laborer",
              "type": "text"
            }
          ]
        },
        {
          "text": " but do not harm oil and wine!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.6",
            "verseOrgIds": [
              "REV.6.6"
            ]
          }
        }
      ]
