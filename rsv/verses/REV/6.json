                  "text": "Is 2.10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Then the kings of the earth and the great men and the generals and the rich and the strong, and every one, slave and free, hid in the caves and among the rocks of the mountains, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.6.15",
            "verseOrgIds": [
              "REV.6.15"
            ]
