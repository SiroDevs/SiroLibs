                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he who sat upon the throne said, “Behold, I make all things new.” Also he said, “Write this, for these words are trustworthy and true.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.55.1"
              },
              "items": [
                {
                  "text": "Is 55.1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he said to me, “It is done! I am the Alpha and the Omega, the beginning and the end. To the thirsty I will give from the fountain of the water of life without payment. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.89.27+PSA.89.28"
              },
              "items": [
                {
                  "text": "Ps 89.27-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " He who conquers shall have this heritage, and I will be his God and he shall be my son. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.33"
              },
              "items": [
                {
                  "text": "Is 30.33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But as for the cowardly, the faithless, the polluted, as for murderers, fornicators, sorcerers, idolaters, and all liars, their lot shall be in the lake that burns with fire and sulphur, which is the second death.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
