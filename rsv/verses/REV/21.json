            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " he will wipe away every tear from their eyes, and death shall be no more, neither shall there be mourning nor crying nor pain any more, for the former things have passed away.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
