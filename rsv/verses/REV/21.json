              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the city has no need of sun or moon to shine upon it, for the glory of God is its light, and its lamp is the Lamb. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
