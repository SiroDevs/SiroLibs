              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "After this I heard what seemed to be the loud voice of a great multitude in heaven, crying,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
