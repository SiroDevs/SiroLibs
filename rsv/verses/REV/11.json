            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " They have power to shut the sky, that no rain may fall during the days of their prophesying, and they have power over the waters to turn them into blood, and to smite the earth with every plague, as often as they desire. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
