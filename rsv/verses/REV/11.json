                {
                  "text": "Zech 12.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.18"
              },
              "items": [
                {
                  "text": "Is 63.18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Lk 21.24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " but do not measure the court outside the temple; leave that out, for it is given over to the nations, and they will trample over the holy city for forty-two months. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "And I will grant my two witnesses power to prophesy for one thousand two hundred and sixty days, clothed in sackcloth.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        }
      ]
    },
