              },
              "items": [
                {
                  "text": "Ps 60.9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " His disciples remembered that it was written, “Zeal for thy house will consume me.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
