              "type": "text"
            }
          ]
        },
        {
          "text": " On the third day there was a marriage at Cana in Galilee, and the mother of Jesus was there; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.1",
            "verseOrgIds": [
              "JHN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus also was invited to the marriage, with his disciples. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.2",
            "verseOrgIds": [
              "JHN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.26"
              },
              "items": [
                {
                  "text": "Jn 19.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.3.31"
              },
              "items": [
                {
                  "text": "Mk 3.31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " When the wine gave out, the mother of Jesus said to him, “They have no wine.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.3",
            "verseOrgIds": [
              "JHN.2.3"
            ]
          }
        },
        {
