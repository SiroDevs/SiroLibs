                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And Jesus said to her, “O woman, what have you to do with me? My hour has not yet come.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.4",
            "verseOrgIds": [
              "JHN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "His mother said to the servants, “Do whatever he tells you.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.5",
            "verseOrgIds": [
              "JHN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 2:6"
          },
          "items": [
            {
