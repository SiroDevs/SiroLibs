              "items": [
                {
                  "text": "Lk 2.41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " The Passover of the Jews was at hand, and Jesus went up to Jerusalem. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.12+MAT.21.13"
              },
              "items": [
                {
                  "text": "Mt 21.12-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.15+MRK.11.16+MRK.11.17"
              },
              "items": [
                {
                  "text": "Mk 11.15-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.45+LUK.19.46"
              },
              "items": [
                {
                  "text": "Lk 19.45-46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " In the temple he found those who were selling oxen and sheep and pigeons, and the money-changers at their business. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "And making a whip of cords, he drove them all, with the sheep and oxen, out of the temple; and he poured out the coins of the money-changers and overturned their tables. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.49"
              },
              "items": [
                {
                  "text": "Lk 2.49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And he told those who sold the pigeons, “Take these things away; you shall not make my Father's house a house of trade.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
