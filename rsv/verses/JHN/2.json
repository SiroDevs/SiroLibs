            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.2"
              },
              "items": [
                {
                  "text": "6.2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " This, the first of his signs, Jesus did at Cana in Galilee, and manifested his glory; and his disciples believed in him.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
