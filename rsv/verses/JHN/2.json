              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.3"
              },
              "items": [
                {
                  "text": "Mk 7.3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.25"
              },
              "items": [
                {
                  "text": "Jn 3.25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Now six stone jars were standing there, for the Jewish rites of purification, each holding twenty or thirty gallons. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.6",
            "verseOrgIds": [
              "JHN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus said to them, “Fill the jars with water.” And they filled them up to the brim. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "He said to them, “Now draw some out, and take it to the steward of the feast.” So they took it. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "When the steward of the feast tasted the water now become wine, and did not know where it came from (though the servants who had drawn the water knew), the steward of the feast called the bridegroom ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.9",
            "verseOrgIds": [
              "JHN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "and said to him, “Every man serves the good wine first; and when men have drunk freely, then the poor wine; but you have kept the good wine until now.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.10",
            "verseOrgIds": [
              "JHN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
