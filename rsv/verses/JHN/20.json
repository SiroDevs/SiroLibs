              "attrs": {
                "loc": "LUK.24.1+LUK.24.2+LUK.24.3+LUK.24.4+LUK.24.5+LUK.24.6+LUK.24.7+LUK.24.8+LUK.24.9+LUK.24.10"
              },
              "items": [
