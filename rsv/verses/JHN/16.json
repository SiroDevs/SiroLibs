                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “A little while, and you will see me no more; again a little while, and you will see me.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.16",
            "verseOrgIds": [
              "JHN.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Some of his disciples said to one another, “What is this that he says to us, ‘A little while, and you will not see me, and again a little while, and you will see me’; and, ‘because I go to the Father’?” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.17",
            "verseOrgIds": [
              "JHN.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "They said, “What does he mean by ‘a little while’? We do not know what he means.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.18",
            "verseOrgIds": [
              "JHN.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesus knew that they wanted to ask him; so he said to them, “Is this what you are asking yourselves, what I meant by saying, ‘A little while, and you will not see me, and again a little while, and you will see me’? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.19",
            "verseOrgIds": [
              "JHN.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.20.20"
              },
              "items": [
                {
                  "text": "Jn 20.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " Truly, truly, I say to you, you will weep and lament, but the world will rejoice; you will be sorrowful, but your sorrow will turn into joy. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.20",
            "verseOrgIds": [
              "JHN.16.20"
            ]
          }
        },
        {
