          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "To the churches of Galatia:",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.2",
            "verseOrgIds": [
              "GAL.1.2"
            ]
          }
        }
      ]
