              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Moses stripped Aaron of his garments, and put them upon Eleazar his son; and Aaron died there on the top of the mountain. Then Moses and Eleazar came down from the mountain. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.28",
            "verseOrgIds": [
              "NUM.20.28"
            ]
          }
