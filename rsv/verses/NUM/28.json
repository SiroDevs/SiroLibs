        },
        {
          "text": " “On the fourteenth day of the first month is the ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "text": "'s passover. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
