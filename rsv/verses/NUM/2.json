          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "his host as numbered being thirty-five thousand four hundred. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.23",
            "verseOrgIds": [
              "NUM.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
