          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“On the south side shall be the standard of the camp of Reuben by their companies, the leader of the people of Reuben being Elizur the son of Shedeur, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
