          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "his host as numbered being thirty-two thousand two hundred. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then the tribe of Benjamin, the leader of the people of Benjamin being Abidan the son of Gideoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
            "verseOrgIds": [
              "NUM.2.22"
            ]
          }
        },
