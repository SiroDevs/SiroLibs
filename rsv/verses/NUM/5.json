          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "The ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "text": " said to Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.1",
            "verseOrgIds": [
              "NUM.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
