              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 22:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "When Balak heard that Balaam had come, he went out to meet him at the city of Moab, on the boundary formed by the Arnon, at the extremity of the boundary. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.36",
            "verseOrgIds": [
              "NUM.22.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 22:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Balak said to Balaam, “Did I not send to you to call you? Why did you not come to me? Am I not able to honor you?” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.37",
            "verseOrgIds": [
              "NUM.22.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 22:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balaam said to Balak, “Lo, I have come to you! Have I now any power at all to speak anything? The word that God puts in my mouth, that must I speak.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.38",
            "verseOrgIds": [
              "NUM.22.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 22:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Then Balaam went with Balak, and they came to Kiriath-huzoth. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.39",
            "verseOrgIds": [
              "NUM.22.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 22:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "And Balak sacrificed oxen and sheep, and sent to Balaam and to the princes who were with him.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.40",
            "verseOrgIds": [
              "NUM.22.40"
            ]
          }
        }
      ]
