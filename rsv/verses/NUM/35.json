                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " The ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "text": " said to Moses in the plains of Moab by the Jordan at Jericho, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.1",
            "verseOrgIds": [
              "NUM.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Command the people of Israel, that they give to the Levites, from the inheritance of their possession, cities to dwell in; and you shall give to the Levites pasture lands round about the cities. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.2",
            "verseOrgIds": [
              "NUM.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "The cities shall be theirs to dwell in, and their pasture lands shall be for their cattle and for their livestock and for all their beasts. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.3",
            "verseOrgIds": [
              "NUM.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "The pasture lands of the cities, which you shall give to the Levites, shall reach from the wall of the city outward a thousand cubits all round. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.4",
            "verseOrgIds": [
              "NUM.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "And you shall measure, outside the city, for the east side two thousand cubits, and for the south side two thousand cubits, and for the west side two thousand cubits, and for the north side two thousand cubits, the city being in the middle; this shall belong to them as pasture land for their cities. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.5",
            "verseOrgIds": [
              "NUM.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.1+DEU.19.2+DEU.19.3+DEU.19.4+DEU.19.5+DEU.19.6+DEU.19.7+DEU.19.8+DEU.19.9+DEU.19.10+DEU.19.11+DEU.19.12+DEU.19.13"
              },
              "items": [
                {
                  "text": "Deut 19.1-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " The cities which you give to the Levites shall be the six cities of refuge, where you shall permit the manslayer to flee, and in addition to them you shall give forty-two cities. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.6",
            "verseOrgIds": [
              "NUM.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "All the cities which you give to the Levites shall be forty-eight, with their pasture lands. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.7",
            "verseOrgIds": [
              "NUM.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "And as for the cities which you shall give from the possession of the people of Israel, from the larger tribes you shall take many, and from the smaller tribes you shall take few; each, in proportion to the inheritance which it inherits, shall give of its cities to the Levites.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.8",
            "verseOrgIds": [
              "NUM.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "text": " said to Moses, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.9",
            "verseOrgIds": [
              "NUM.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Say to the people of Israel, When you cross the Jordan into the land of Canaan, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.10",
            "verseOrgIds": [
              "NUM.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "then you shall select cities to be cities of refuge for you, that the manslayer who kills any person without intent may flee there. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.11",
            "verseOrgIds": [
              "NUM.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "The cities shall be for you a refuge from the avenger, that the manslayer may not die until he stands before the congregation for judgment. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.12",
            "verseOrgIds": [
              "NUM.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the cities which you give shall be your six cities of refuge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.13",
            "verseOrgIds": [
              "NUM.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall give three cities beyond the Jordan, and three cities in the land of Canaan, to be cities of refuge. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.14",
            "verseOrgIds": [
              "NUM.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "These six cities shall be for refuge for the people of Israel, and for the stranger and for the sojourner among them, that any one who kills any person without intent may flee there.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.15",
            "verseOrgIds": [
              "NUM.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“But if he struck him down with an instrument of iron, so that he died, he is a murderer; the murderer shall be put to death. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.16",
            "verseOrgIds": [
              "NUM.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if he struck him down with a stone in the hand, by which a man may die, and he died, he is a murderer; the murderer shall be put to death. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.17",
            "verseOrgIds": [
              "NUM.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Or if he struck him down with a weapon of wood in the hand, by which a man may die, and he died, he is a murderer; the murderer shall be put to death. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.18",
            "verseOrgIds": [
              "NUM.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "The avenger of blood shall himself put the murderer to death; when he meets him, he shall put him to death. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.19",
            "verseOrgIds": [
              "NUM.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And if he stabbed him from hatred, or hurled at him, lying in wait, so that he died, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.20",
            "verseOrgIds": [
              "NUM.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "or in enmity struck him down with his hand, so that he died, then he who struck the blow shall be put to death; he is a murderer; the avenger of blood shall put the murderer to death, when he meets him.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“But if he stabbed him suddenly without enmity, or hurled anything on him without lying in wait, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "or used a stone, by which a man may die, and without seeing him cast it upon him, so that he died, though he was not his enemy, and did not seek his harm; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "then the congregation shall judge between the manslayer and the avenger of blood, in accordance with these ordinances; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "and the congregation shall rescue the manslayer from the hand of the avenger of blood, and the congregation shall restore him to his city of refuge, to which he had fled, and he shall live in it until the death of the high priest who was anointed with the holy oil. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if the manslayer shall at any time go beyond the bounds of his city of refuge to which he fled, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "and the avenger of blood finds him outside the bounds of his city of refuge, and the avenger of blood slays the manslayer, he shall not be guilty of blood. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "For the man must remain in his city of refuge until the death of the high priest; but after the death of the high priest the manslayer may return to the land of his possession.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 35:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "“And these things shall be for a statute and ordinance to you throughout your generations in all your dwellings. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.29",
            "verseOrgIds": [
              "NUM.35.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 35:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "If any one kills a person, the murderer shall be put to death on the evidence of witnesses; but no person shall be put to death on the testimony of one witness. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.30",
            "verseOrgIds": [
              "NUM.35.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 35:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moreover you shall accept no ransom for the life of a murderer, who is guilty of death; but he shall be put to death. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.31",
            "verseOrgIds": [
              "NUM.35.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 35:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "And you shall accept no ransom for him who has fled to his city of refuge, that he may return to dwell in the land before the death of the high priest. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.32",
            "verseOrgIds": [
              "NUM.35.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 35:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall not thus pollute the land in which you live; for blood pollutes the land, and no expiation can be made for the land, for the blood that is shed in it, except by the blood of him who shed it. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.33",
            "verseOrgIds": [
              "NUM.35.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 35:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall not defile the land in which you live, in the midst of which I dwell; for I the ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        },
        {
          "text": " dwell in the midst of the people of Israel.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.34",
            "verseOrgIds": [
              "NUM.35.34"
            ]
          }
        }
      ]
    }
  ],
