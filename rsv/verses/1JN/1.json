          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "that which we have seen and heard we proclaim also to you, so that you may have fellowship with us; and our fellowship is with the Father and with his Son Jesus Christ. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
