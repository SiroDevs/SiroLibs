        },
        {
          "text": "You shall not go after other gods, of the gods of the peoples who are round about you; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
        },
