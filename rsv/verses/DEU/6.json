          "text": "for the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "text": " your God in the midst of you is a jealous God; lest the anger of the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        },
        {
          "text": " your God be kindled against you, and he destroy you from off the face of the earth.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
