          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "But if you refrain from vowing, it shall be no sin in you. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.22",
            "verseOrgIds": [
              "DEU.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "You shall be careful to perform what has passed your lips, for you have voluntarily vowed to the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        },
        {
          "text": " your God what you have promised with your mouth.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.23",
            "verseOrgIds": [
              "DEU.23.23"
            ]
          }
        }
      ]
