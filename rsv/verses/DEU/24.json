              "type": "text"
            }
          ]
        },
        {
          "text": " “You shall not pervert the justice due to the sojourner or to the fatherless, or take a widow's garment in pledge; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
