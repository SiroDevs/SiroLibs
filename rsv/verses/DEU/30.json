            }
          ]
        },
        {
          "text": "“And when all these things come upon you, the blessing and the curse, which I have set before you, and you call them to mind among all the nations where the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "text": " your God has driven you, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "and return to the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "text": " your God, you and your children, and obey his voice in all that I command you this day, with all your heart and with all your soul; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "then the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "text": " your God will restore your fortunes, and have compassion upon you, and he will gather you again from all the peoples where the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "text": " your God has scattered you. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
