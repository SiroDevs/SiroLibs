                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Cor 13.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5.19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.28"
              },
              "items": [
                {
                  "text": "Heb 10.28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “A single witness shall not prevail against a man for any crime or for any wrong in connection with any offense that he has committed; only on the evidence of two witnesses, or of three witnesses, shall a charge be sustained. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.15",
            "verseOrgIds": [
              "DEU.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.16"
              },
              "items": [
                {
                  "text": "Ex 20.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.1"
              },
              "items": [
                {
                  "text": "23.1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.16"
              },
              "items": [
                {
                  "text": "Lev 19.16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.5.20"
              },
              "items": [
                {
                  "text": "Deut 5.20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " If a malicious witness rises against any man to accuse him of wrongdoing, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.16",
            "verseOrgIds": [
              "DEU.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "then both parties to the dispute shall appear before the ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "text": ", before the priests and the judges who are in office in those days; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.17",
            "verseOrgIds": [
              "DEU.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "the judges shall inquire diligently, and if the witness is a false witness and has accused his brother falsely, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.18",
            "verseOrgIds": [
              "DEU.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "1 Cor 5.13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " then you shall do to him as he had meant to do to his brother; so you shall purge the evil from the midst of you. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.19",
            "verseOrgIds": [
              "DEU.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the rest shall hear, and fear, and shall never again commit any such evil among you. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.20",
            "verseOrgIds": [
              "DEU.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
