                  "text": "Mt 8.26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.14.31"
              },
              "items": [
                {
                  "text": "14.31",
