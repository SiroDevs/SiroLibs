                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " “No one can serve two masters; for either he will hate the one and love the other, or he will be devoted to the one and despise the other. You cannot serve God and mammon.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.24",
            "verseOrgIds": [
              "MAT.6.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6.24",
              "type": "text"
            },
            {
              "text": "Mammon",
              "type": "text"
            },
            {
              "text": "is a Semitic word for money or riches",
              "type": "text"
            }
          ]
        }
