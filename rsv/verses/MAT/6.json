              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.19.28"
              },
              "items": [
                {
                  "text": "Mt 19.28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.10.29+MRK.10.30"
              },
              "items": [
                {
                  "text": "Mk 10.29-30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.29+LUK.18.30"
              },
              "items": [
                {
                  "text": "Lk 18.29-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " But seek first his kingdom and his righteousness, and all these things shall be yours as well.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.6.33",
            "verseOrgIds": [
              "MAT.6.33"
            ]
          }
        }
