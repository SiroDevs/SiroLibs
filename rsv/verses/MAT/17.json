        },
        {
          "text": " And as they were coming down the mountain, Jesus commanded them, “Tell no one the vision, until the Son of man is raised from the dead.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.9",
            "verseOrgIds": [
              "MAT.17.9"
            ]
          }
        },
