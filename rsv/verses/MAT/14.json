              "text": "14.24",
              "type": "text"
            },
            {
              "text": "Other ancient authorities read",
              "type": "text"
            },
            {
              "text": "was out on the sea",
              "type": "text"
            }
          ]
        },
        {
          "text": " beaten by the waves; for the wind was against them. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
