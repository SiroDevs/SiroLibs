            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " and lo, a voice from heaven, saying, “This is my beloved Son,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.17",
              "type": "text"
            },
            {
              "text": "Or",
              "type": "text"
            },
            {
              "text": "my Son, my",
              "type": "text"
            },
            {
              "text": "(or",
              "type": "text"
            },
            {
              "text": "the",
              "type": "text"
            },
            {
              "text": ")",
              "type": "text"
            },
            {
              "text": "Beloved",
              "type": "text"
            }
          ]
        },
        {
          "text": " with whom I am well pleased.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
