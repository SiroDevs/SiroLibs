        {
          "text": " As he entered Caperna-um, a centurion came forward to him, beseeching him ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
