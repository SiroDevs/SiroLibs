                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And when he came to the other side, to the country of the Gadarenes,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8.28",
              "type": "text"
            },
            {
              "text": "Other ancient authorities read",
              "type": "text"
            },
            {
              "text": "Gergesenes;",
              "type": "text"
            },
            {
              "text": "some,",
              "type": "text"
            },
            {
              "text": "Gerasenes",
              "type": "text"
            }
          ]
        },
        {
          "text": " two demoniacs met him, coming out of the tombs, so fierce that no one could pass that way. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
