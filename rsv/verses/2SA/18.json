            {
              "text": "Ch 19.1 in Heb",
              "type": "text"
            }
          ]
        },
        {
          "text": " And the king was deeply moved, and went up to the chamber over the gate, and wept; and as he went, he said, “O my son Absalom, my son, my son Absalom! Would I had died instead of you, O Absalom, my son, my son!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
