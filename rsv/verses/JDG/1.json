          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zebulun did not drive out the inhabitants of Kitron, or the inhabitants of Nahalol; but the Canaanites dwelt among them, and became subject to forced labor.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.30",
            "verseOrgIds": [
              "JDG.1.30"
            ]
          }
