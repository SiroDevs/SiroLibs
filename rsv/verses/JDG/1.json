                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " And Ephraim did not drive out the Canaanites who dwelt in Gezer; but the Canaanites dwelt in Gezer among them.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.1.29",
            "verseOrgIds": [
