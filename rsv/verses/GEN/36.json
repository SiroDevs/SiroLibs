              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaz, Teman, Mibzar, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
