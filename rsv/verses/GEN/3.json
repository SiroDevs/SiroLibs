          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "therefore the ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "text": " God sent him forth from the garden of Eden, to till the ground from which he was taken. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
