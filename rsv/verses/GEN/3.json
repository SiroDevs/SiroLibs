              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "The man called his wife's name Eve,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3.20",
              "type": "text"
            },
            {
              "text": "The name in Hebrew resembles the word for",
              "type": "text"
            },
            {
              "text": "living",
              "type": "text"
            }
          ]
        },
        {
          "text": " because she was the mother of all living. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
