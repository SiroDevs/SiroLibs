        },
        {
          "text": "These are the descendants of Shem. When Shem was a hundred years old, he became the father of Arpachshad two years after the flood; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
