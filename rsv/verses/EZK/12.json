            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the word of the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "text": " came to me: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Son of man, what is this proverb that you have about the land of Israel, saying, ‘The days grow long, and every vision comes to naught’? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.22",
            "verseOrgIds": [
              "EZK.12.22"
            ]
          }
        },
        {
          "name": "verse",
