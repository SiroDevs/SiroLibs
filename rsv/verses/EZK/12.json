          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "For there shall be no more any false vision or flattering divination within the house of Israel. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
