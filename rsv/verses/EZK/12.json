              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moreover the word of the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "text": " came to me: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Son of man, eat your bread with quaking, and drink water with trembling and with fearfulness; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "and say of the people of the land, Thus says the Lord ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "text": " concerning the inhabitants of Jerusalem in the land of Israel: They shall eat their bread with fearfulness, and drink water in dismay, because their land will be stripped of all it contains, on account of the violence of all those who dwell in it. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "And the inhabited cities shall be laid waste, and the land shall become a desolation; and you shall know that I am the ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
