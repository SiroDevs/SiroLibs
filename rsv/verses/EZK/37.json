          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "They shall dwell in the land where your fathers dwelt that I gave to my servant Jacob; they and their children and their children's children shall dwell there for ever; and David my servant shall be their prince for ever. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
