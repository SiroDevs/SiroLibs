          "type": "text",
          "attrs": {
            "verseId": "EZK.7.1",
            "verseOrgIds": [
              "EZK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
