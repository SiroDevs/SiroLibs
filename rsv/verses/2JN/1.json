          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "The children of your elect sister greet you.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.13",
            "verseOrgIds": [
              "2JN.1.13"
            ]
          }
