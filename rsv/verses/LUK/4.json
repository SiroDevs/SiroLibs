        },
        {
          "text": " And Jesus, full of the Holy Spirit, returned from the Jordan, and was led by the Spirit ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.1",
            "verseOrgIds": [
              "LUK.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
