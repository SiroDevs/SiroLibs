  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "ROM 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja dị ndụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụnna m, eji m obi ebere Chineke na-arịọ ka unu chee anụ ahụ unu dịka aja dị ndụ, dịkwa nsọ, ma bụrụkwa nke na-atọ Chineke ụtọ, nke bụkwa ofufe nke ime mmụọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.1",
            "verseOrgIds": [
              "ROM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu eyila ụwa nke a, kama bụrụnụ ndị enwoghara site nʼịgbanwe uche unu. Mgbe ahụ, unu ga-enwe ike nwapụta ihe bụ uche Chineke na ihe ọ na-achọ, nke bụ ezi ihe, nke na-atọ ya ụtọ na nke zukwara oke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.2",
            "verseOrgIds": [
              "ROM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ obi umeala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka onyinye amara e nyere m siri dị, ana m adọ onye ọbụla nʼime unu aka na ntị sị, Unu atụkwasịla uche nʼechiche banyere onwe unu karịa ka o si kwesi. Kama, jirinụ obi dị umeala lee onwe unu anya dịka okwukwe Chineke nyere unu ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.3",
            "verseOrgIds": [
              "ROM.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka anyị niile nʼotu nʼotu si nwe anụ ahụ nke nwere akụkụ dị iche iche, bụ akụkụ ndị na-arụ ọrụ dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.4",
            "verseOrgIds": [
              "ROM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼotu aka ahụ, nʼime Kraịst anyị bụ otu, nʼagbanyeghị na anyị bụ akụkụ dị iche iche nke otu anụ ahụ. E jikọtara anyị niile nʼotu nʼotu nye ibe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.5",
            "verseOrgIds": [
              "ROM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nwere onyinye dị iche iche nke e sitere nʼamara nye anyị, ọ bụrụ na onye ọbụla nwere onyinye ibu amụma, ya buo ya dịka okwukwe o nwere ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.6",
            "verseOrgIds": [
              "ROM.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ ije ozi, ya jee ozi, ya bụrụkwanụ izi ihe, ya zie ihe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.7",
            "verseOrgIds": [
              "ROM.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye nwere onyinye ịgbaume, gbaa ndị ọzọ ume, ya bụrụkwanụ inyeaka, ka onye nwere onyinye a site nʼafọ ofufu mee ya, ọ bụrụ ịbụ onyendu, ka onye ahụ duo site nʼikpachapụ anya, ya bụrụkwanụ ime ebere, ka onye ahụ jiri obi ụtọ na-eme ya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.8",
            "verseOrgIds": [
              "ROM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịhụnanya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ịhụnanya bụrụ nke ihu abụọ nʼadịghị na ya, kpọọ ihe ọjọọ asị, jidesie ihe dị mma ike.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.9",
            "verseOrgIds": [
              "ROM.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hụrịtanụ onwe unu nʼanya, dịka ụmụ nke otu nna. Ka ihe ibe unu na-eme na-atọ unu ụtọ. Na-asọpụkwaranụ ibe unu karịa otu ha si asọpụrụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.10",
            "verseOrgIds": [
              "ROM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu abụla ndị umengwụ nʼọrụ unu. Kama werenụ mmụọ na obi na-anụ ọkụ na-ejere Onyenwe anyị ozi mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.11",
            "verseOrgIds": [
              "ROM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nweenụ obi aṅụrị nʼime olileanya, nweenụ ntachiobi nʼime nsogbu, na-ekpekwanụ ekpere mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.12",
            "verseOrgIds": [
              "ROM.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na enyetụnụ ụfọdụ ndị nsọ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        },
        {
          "text": "ihe site nʼihe unu nwere iji gboo mkpa dịrị ha. Na-elekọtakwanụ ndị ọbịa anya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.13",
            "verseOrgIds": [
              "ROM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gọzienụ ndị na-akpagbu unu, gọzienụ ha, unu abụkwala ha ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.14",
            "verseOrgIds": [
              "ROM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ọzọ na-aṅụrị ọṅụ, soronụ ha ṅụrịa ọṅụ. Mgbe ha nọ nʼiru ụjụ, soronụ ha ruo ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.15",
            "verseOrgIds": [
              "ROM.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-ebinụ nʼudo. A bụla onye mpako, unu na ndị ọnọdụ ha dị ala na-enwe mmekọrịta, echekwala na ị maara ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.16",
            "verseOrgIds": [
              "ROM.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejikwala ihe ọjọọ akwụghachi ihe ọjọọ e mere gị. Kama, na-echenụ otu unu ga-esi mee ihe dị mma nʼanya mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.17",
            "verseOrgIds": [
              "ROM.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ike gị niile ha, mee ka gị na onye ọbụla biri nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.18",
            "verseOrgIds": [
              "ROM.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị enyi m, unu abọla ọbọ, kama hapụrụnụ Chineke ọrụ ịbọtara unu ọbọ. Nʼihi na e dere ya, \"Ịbọ ọbọ dịrị m, aga m akwụghachi,\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "text": "ka Onyenwe anyị kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.19",
            "verseOrgIds": [
              "ROM.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "\"ọ bụrụ na agụụ na-agụ onye iro gị, were nri zụọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "ọ bụrụkwa na akpịrị na-akpọ ya nkụ, nye ihe ọṅụṅụ ka ọ ṅụọ,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 12:20"
      },
      "items": [
        {
          "text": "mgbe ị na-eme nke a, ị na-agụkwasị icheku ọkụ na-ere ere nʼisi ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.20",
            "verseOrgIds": [
              "ROM.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ekwela ka ihe ọjọọ merie unu, kama werenụ ezi ihe merie ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.12.21",
            "verseOrgIds": [
              "ROM.12.21"
            ]
          }
        }
      ]
    }
  ],
