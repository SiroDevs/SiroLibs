  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ROM 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl, odibo Kraịst Jisọs, onye Chineke kpọrọ ka ọ bụrụ onyeozi ya na onye o kewapụtara ka o zisaa oziọma ya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
            "verseOrgIds": [
              "ROM.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziọma a bụ nke ahụ Chineke kwere na nkwa nʼoge gara aga site nʼọnụ ndị amụma ya nke e dere ihe banyere ya nʼakwụkwọ nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.2",
            "verseOrgIds": [
              "ROM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oziọma a metụtara Ọkpara ya, onye bụ nwa Devid site nʼọmụmụ nke anụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye esitere na Mmụọ nke ịdị nsọ họpụta ị bụ Ọkpara Chineke, site nʼike nke mbilite nʼọnwụ, bụ Kraịst Jisọs, Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye anyị sitere nʼaka ya nata amara na ọrụ ị bụ onyeozi, ime ka ndị mba ọzọ nwee nrube isi nke okwukwe nʼetiti ha nʼihi aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyere unu onwe unu ndị ahụ a kpọrọ ka ha bụrụ ndị nke Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya bụ, unu ndị Chineke hụrụ nʼanya bi na Rom, ndị ọ kpọrọ ka ha bụrụ ndị nsọ:",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ROM 1:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 1:7"
      },
      "items": [
        {
          "text": "Ka amara na udo nke sitere na Chineke Nna anyị, na Onyenwe anyị Jisọs Kraịst dịrị unu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmasị Pọl ịga Rom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbụ, ana m ekele Chineke ekele nʼihi unu niile, site nʼaha Jisọs Kraịst. Nʼihi na a na-ekwusa ihe banyere okwukwe unu nʼụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke, onye m na-ejere ozi, nʼime mmụọ site na ikwusa oziọma nke Ọkpara ya, bụ onye akaebe na m na-echeta unu mgbe niile nʼekpere m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼekpere m oge niile, a na m arịọ ka ọ bụrụ ihe ga-ekwe mee na site nʼike Chineke, aga m enwe ohere ịbịa leta unu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.10",
            "verseOrgIds": [
              "ROM.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agụ m agụụ nke ukwuu ịbịa hụ unu anya, nʼihi na achọrọ m ka unu keta oke nʼonyinye Mmụọ Nsọ nke Chineke nyere m, nke ga-enyere unu aka iguzosi ike nʼokwukwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.11",
            "verseOrgIds": [
              "ROM.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwaghị naanị nke a, kama achọrọ m ka anyị gbarịtaa onwe anyị ume site nʼokwukwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.12",
            "verseOrgIds": [
              "ROM.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m, achọrọ m ime ka unu mata na atụọla m atụmatụ ịbịa leta unu ọtụtụ mgbe (ma tutu ruo ugbu a e gbochiri m ịbịa), ka m nwee ike nweta mkpụrụ nʼetiti unu, dịka m nwere nʼetiti ndị mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.13",
            "verseOrgIds": [
              "ROM.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na abụ m onye ji ụgwọ nye ndị Griik na ndị mba ọzọ, nyekwa ndị maara ihe na ndị nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.14",
            "verseOrgIds": [
              "ROM.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere m ji dị njikere ikwusa oziọma nyekwa unu bụ ndị bi na Rom.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.15",
            "verseOrgIds": [
              "ROM.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihere oziọma ahụ anaghị eme m, nʼihi na ọ bụ ike Chineke na-ewetara onye ọbụla kwere na ya nzọpụta, nye onye Juu na mbụ nakwa nye onye Griik.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.16",
            "verseOrgIds": [
              "ROM.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ nʼoziọma ka e kpughere ezi omume Chineke, ezi omume nke na-esite nʼokwukwe ruo okwukwe. Dịka e siri dee ya, \"Onye ezi omume ga-esite nʼokwukwe dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.17",
            "verseOrgIds": [
              "ROM.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwe Chineke megide mmehie nke mmadụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e sitela nʼeluigwe kpughe ọnụma Chineke megide mmehie na ajọ omume niile nke ndị na-emebi iwu, ndị na-esite nʼajọ omume ha na-eguzogide eziokwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.18",
            "verseOrgIds": [
              "ROM.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị a maara ihe ha kwesiri ịmata banyere Chineke. Ha maara ya nʼihi na Chineke nʼonwe ya emeela ka o doo ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.19",
            "verseOrgIds": [
              "ROM.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na site nʼoge Chineke kere ụwa na ihe niile dị nʼime ya, ụdịdị ya nke a na-apụghị ịhụ anya na ike nke ebighị ebi ya na ụdịdị ịdị nsọ ya ka e mere ka ọ pụta ìhè nye ụmụ mmadụ. Ụmụ mmadụ na-aghọta ihe ndị a site nʼihe ndị e kere eke. Nʼihi nke a ụmụ mmadụ enwekwaghị ngọpụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.20",
            "verseOrgIds": [
              "ROM.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ eziokwu na ha maara Chineke, ma ha anaghị asọpụrụ ya, ha anakwaghị enye ya ekele dịka Chineke. Echiche uche ha bụ ihe efu, nzuzu ha mere ka obi ha gbaa ọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.21",
            "verseOrgIds": [
              "ROM.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-eche na ha bụ ndị maara ihe, ha amataghị na ha bụ ndị nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.22",
            "verseOrgIds": [
              "ROM.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ife Chineke na-adịghị anwụ anwụ ofufe, ha weere otuto ha kwesiri inye ya nye ihe ndị ahụ ha jiri aka ha kpụọ. Ihe ndị a yiri mmadụ na-anwụ anwụ, na nnụnụ, na ụmụ anụmanụ, na ihe na-akpụ akpụ nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.23",
            "verseOrgIds": [
              "ROM.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, Chineke hapụrụ ha ka ha mee ihe ọjọọ ndị ahụ na-agụ obi ha agụụ nye adịghị ọcha nke ịkwa iko, ha jikwa ahụ ha emerịta mpu nʼetiti onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.24",
            "verseOrgIds": [
              "ROM.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha were okwu ụgha dochie nʼọnọdụ eziokwu banyere Chineke. Ha na-asọpụrụ, na-efekwa ihe e kere eke, ma hapụ Onye okike, onye a na-eto ruo ebighị ebi. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.25",
            "verseOrgIds": [
              "ROM.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere Chineke jiri nyefee ha nʼaka agụụ anụ ahụ nke na-eme ihere. Nʼihi ya, ọ bụladị ndị inyom na ndị inyom ibe ha nọgidere na-enwe mmekọrịta nʼụzọ na-ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, kama ha na ndị inyom inwe mmekọrịta; ndị ikom ha họọrọ ka ha na ndị ikom ibe ha na-enwe ụdị mmekọrịta nke ha na ndị inyom kwesiri inwe. Nwoke na-edinakwuru nwoke ibe ya. Nʼụzọ dị otu a, ha natakwara ntaramahụhụ kwesiri ha nʼihi ihe ọjọọ ndị a ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ROM 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ebe ha kpachapụrụ anya jụ ịmata onye Chineke bụ, Chineke nyere ha akọnuche ndị nzuzu, nke mere ka ha na-eme ihe ọjọọ niile nke ajọ echiche obi ha chepụtara.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jupụtara nʼajọ omume na mmehie niile, anya ukwu na aghụghọ. Ha jupụtakwara nʼekworo, na igbu mmadụ, na esemokwu, na uche gbagọrọ agbagọ na ịkpọ asị. Ha bụ ndị na-ekwu okwu azụ,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị nkwutọ na ndị kpọrọ Chineke asị, na ndị na-akparị mmadụ na ndị mpako na ndị na-anya isi. Ha na-atụpụta ụzọ ọhụrụ ime ihe ọjọọ, ha adịghị asọpụrụ ndị mụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụkwa ndị na-enweghị nghọta, ndị na-enweghị okwukwe, ndị obi ọjọọ na ndị na-enweghị obi ebere.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ROM 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha maa na Chineke nyere iwu dị ike na ndị na-ebi ndụ dị otu a kwesiri ọnwụ, ma ha gara nʼihu na-eme ihe ndị a, ma na-akwalịkwa mmụọ ndị ọzọ ka ha soro na-eme ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.32",
            "verseOrgIds": [
              "ROM.1.32"
            ]
          }
        }
      ]
    }
