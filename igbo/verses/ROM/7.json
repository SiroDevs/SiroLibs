  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "ROM 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịma atụ site nʼọlụlụ di na nwunye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na unu amaghị ụmụnna m, unu ndị maara iwu nke ọma na ọ bụ oge mmadụ dị ndụ ka iwu na-ejide ya?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.1",
            "verseOrgIds": [
              "ROM.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ihe ịmaatụ, iwu na-ejikọta nwanyị lụrụ di na di ya mgbe di ya ka nọ ndụ, ma ọ bụrụ na di nwanyị ahụ anwụọ, ọ nọkwaghị nʼokpuru iwu jikọtara ha dịka di na nwunye.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.2",
            "verseOrgIds": [
              "ROM.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-akpọ ya nwanyị na-akwa iko ma ọ bụrụ na ọ lakwuru nwoke ọzọ mgbe di ya ka dị ndụ. Ma ọ bụrụ na di ya anwụọ, ọ ga-abụ onye nwere onwe ya site nʼiwu ahụ. Ọ kwaghị iko ma ọ bụrụ na ọ lụọ nwoke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.3",
            "verseOrgIds": [
              "ROM.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụnna m, unu onwe unu kwa anwụọla nʼebe iwu dị site nʼahụ Kraịst, ka e nwe ike kenye unu onye ọzọ, bụ onye ahụ e mere ka o si nʼọnwụ bilie. Ka anyị site na ya mịa mkpụrụ nye Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.4",
            "verseOrgIds": [
              "ROM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anụ ahụ mmehie na-achị anyị, ọchịchọ ọjọọ nke iwu na-akpali jupụtara nʼime anyị, nke mere na anyị na-amị mkpụrụ nye ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.5",
            "verseOrgIds": [
              "ROM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, a tọghapụla anyị pụọ nʼaka iwu ebe anyị nwụrụ nye ihe ndị kere anyị agbụ na mbụ, anyị anaghị ebikwa ndụ nʼusoro iwu ochie nke e dere nʼakwụkwọ, kama anyị na-eje ozi nʼusoro ndụ ọhụrụ nke mmụọ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu na mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, gịnị ka anyị ga-ekwu? Iwu ahụ ọ bụ mmehie? Nʼezie, mbaa! Agaraghị m ama ihe mmehie bụ ma ọ bụghị site nʼiwu. Ọ bụrụ na iwu asịghị, \"Enwela anya ukwu,\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "text": "agaraghị m ama na ọ bụ mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmehie sitere nʼiwu a megidere ọchịchọ ọjọọ, mee ka echiche m mgbe niile bụrụ ihe gbasara ihe ọjọọ, na otu m ga-esi mee ha. A sị na iwu adịghị, mmehie agaraghị adị.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mbụ, abụ m onye dị ndụ mgbe iwu na-adịghị, ma mgbe iwu bịara, e mere ka mmehie nwe ntute.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anwụrụ m, ma chọpụta na iwu ahụ kwesiri iwetara m ndụ ghọziri ihe wetara ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mmehie jiri ohere ahụ iwu webatara ghọgbuo m, sitekwa nʼiwu ahụ gbuo m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, iwu ahụ dị nsọ, ihe e nyere nʼiwu dị nsọ, bụrụkwa ezi omume na ihe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ pụtara na ihe ahụ dị mma wetaara m ọnwụ? Mba! Kama ọ bụ mmehie sitere nʼihe dị mma wetara m ọnwụ, ka e nwee ike gosipụta na mmehie bụ ihe jọgburu onwe ya site nʼihe e nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgụ na mgba dị na ndụ onye Kraịst",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị matara na iwu bụ ihe nke mmụọ ebe mụ onwe m bụ anụ ahụ efu, onye e rere dịka ohu nye mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.14",
            "verseOrgIds": [
              "ROM.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ụzọ ihe m na-eme si doo m anya. Nʼihi na ihe m na-eme abụghị ihe m chọrọ ime, ọ bụ ihe m kpọrọ asị bụ ihe na-agara m aka ime mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.15",
            "verseOrgIds": [
              "ROM.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na m eme ihe m na-achọghị ime, ana m ekwenye na iwu dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.16",
            "verseOrgIds": [
              "ROM.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka ọ dị, ọ bụkwaghị mụ onwe m na-eme ihe ndị a, kama ọ bụ mmehie bi nʼime m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.17",
            "verseOrgIds": [
              "ROM.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O doro m anya na o nweghị ihe ọma ọbụla dị nʼime m, ya bụ nʼime anụ ahụ m. Nʼihi na ọ na-agụ m agụụ ime ezi ihe, ma ike ime ezi ihe adịghị nʼime m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.18",
            "verseOrgIds": [
              "ROM.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe m na-eme mgbe m chọrọ ime ezi ihe abụghị ezi ihe ahụ m chọrọ ime kama ọ bụ ajọọ ihe ahụ m na-achọghị ime ka m na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m na-eme ihe ahụ m na-achọghị ime, ọ pụtara na ọ bụghị mụ onwe m na-eme ihe ndị ahụ. Kama ọ bụ mmehie bi nʼime m na-eme ha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọpụtara m iwu nke na-arụ ọrụ nʼime m. Mgbe m chọrọ ime ihe ọma, naanị ihe ọjọọ bụ ihe na-agara m aka ime.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.21",
            "verseOrgIds": [
              "ROM.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ime onwe m, ọ na-agụ m agụụ ime ihe iwu Chineke kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.22",
            "verseOrgIds": [
              "ROM.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ROM 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ana m ahụta iwu ọzọ dị nʼime m nke na-agba mgba megide iwu nke dị nʼuche m, ime ka m bụrụ ohu nye iwu nke mmehie na-arụ ọrụ ya nʼanụ ahụ m.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.23",
            "verseOrgIds": [
              "ROM.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ROM 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ụdị ọnọdụ ọjọọ nke m hụtara onwe m nʼime ya! Onye pụrụ ịnapụta m site nʼanụ ahụ a nke na-eduba m nʼọnwụ?",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.24",
            "verseOrgIds": [
              "ROM.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ekele dịrị Chineke, onye na-anapụta m site na Kraịst Jisọs Onyenwe anyị!",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.25",
            "verseOrgIds": [
              "ROM.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ROM 7:25"
      },
      "items": [
        {
          "text": "Ya mere, nʼime mmụọ m, abụ m odibo nye iwu Chineke, ma nʼime anụ ahụ mmehie m, abụ m ohu nye iwu nke mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.25",
            "verseOrgIds": [
              "ROM.7.25"
            ]
          }
        }
      ]
    }
  ],
