  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "LUK 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu maka atụrụ furu efu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ndị ọna ụtụ na ndị mmehie na-abịa ya nso ịnụta ihe ọ na-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Farisii na ndị ozizi iwu tamuru ntamu na-asị, \"Nwoke a na-anabata ndị mmehie sorokwa ha na-eri nri.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ tụrụ ha ilu a sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.3",
            "verseOrgIds": [
              "LUK.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na otu onye nʼime unu enwee narị atụrụ ma otu nʼime ha akpafuo. Ọ bụ na ọ gaghị ahapụ iri atụrụ itoolu na itoolu ahụ fọdụrụ nʼọzara, pụọ ịchọgharị otu ahụ kpafuru ruo mgbe ọ chọtara ya?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.4",
                "verseOrgIds": [
                  "LUK.15.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.4",
            "verseOrgIds": [
              "LUK.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọ chọtara ya, ọ ga-eji ọṅụ tụkwasị ya nʼubu ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.5",
                "verseOrgIds": [
                  "LUK.15.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.5",
            "verseOrgIds": [
              "LUK.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọ lọtara nʼụlọ ya, ọ ga-akpọkọta ndị enyi ya na ndị agbataobi ya sị ha, 'Soronụ m ṅụrịa ọṅụ nʼihi na achọtala m atụrụ m furu efu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.6",
                "verseOrgIds": [
                  "LUK.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.6",
            "verseOrgIds": [
              "LUK.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Asị m unu, nʼụzọ dị otu a, ọṅụ dị ukwu ga-adị nʼeluigwe nʼihi otu onye mmehie nke chegharịrị, karịa iri itoolu na itoolu ndị ezi omume bụ ndị nchegharị na-adịghị mkpa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.7",
                "verseOrgIds": [
                  "LUK.15.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu maka mkpụrụ ego furu efu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Maọbụ olee nwanyị nke nwere mkpụrụ ọlaọcha iri, ọ bụrụ nʼotu nʼime ha adafuo. Ọ gaghị amụnye oriọna, zaa ime ụlọ ya ịchọ otu mkpụrụ ego ahụ tutu ọ chọta ya?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.8",
                "verseOrgIds": [
                  "LUK.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.8",
            "verseOrgIds": [
              "LUK.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọ chọtara otu mkpụrụ ego ahụ, ọ ga-akpọ ndị enyi ya na ndị agbataobi ya sị ha, 'Soronụ m ṅụrịa ọṅụ nʼihi na achọtala m ego m furu efu.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.9",
                "verseOrgIds": [
                  "LUK.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.9",
            "verseOrgIds": [
              "LUK.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụzọ dị otu a, asị m unu, ọṅụ ga-adị nʼihu ndị mmụọ ozi Chineke nʼihi otu onye mmehie nke chegharịrị.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.10",
                "verseOrgIds": [
                  "LUK.15.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu maka nwa mmefu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwukwaara sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Otu nwoke mụtara ụmụ nwoke abụọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.11",
                "verseOrgIds": [
                  "LUK.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.11",
            "verseOrgIds": [
              "LUK.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nwa ya nke nta sịrị nna ya, 'Nna, kenye m oke ruuru m nʼihe niile i nwere.' Ya mere, o kenyere ya oke nke ya site nʼihe o nwere.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.12",
                "verseOrgIds": [
                  "LUK.15.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ụbọchị ole na ole gasịrị, nwokorobịa ahụ kwakọtara ihe niile o nwere gaa biri nʼotu obodo dị anya. Nʼebe ahụ, o mefuchara ihe niile o nwere nʼibi ndụ ọjọọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.13",
                "verseOrgIds": [
                  "LUK.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.13",
            "verseOrgIds": [
              "LUK.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe o mefuchara ihe niile o nwere, oke ụnwụ dara nʼala ahụ. Ọ malitere ịnọ nʼụkọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.14",
                "verseOrgIds": [
                  "LUK.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.14",
            "verseOrgIds": [
              "LUK.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi nke a, ọ gara binyere otu onye obodo ahụ nyere ya ọrụ ilekọta ezi ya na inye ha nri.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.15",
                "verseOrgIds": [
                  "LUK.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.15",
            "verseOrgIds": [
              "LUK.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ na-agụ ya ka o site na nri ọ na-enye ezi rijuo afọ, ma ọ dịghị onye nyere ya ụdị nri ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.16",
                "verseOrgIds": [
                  "LUK.15.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ọ ghọtara onwe ya, ọ sịrị, 'Mmadụ ole bụ ndị ọrụ e goro ego nna m nwere, ndị nri na-ezuru ma mapụtakwa, ma agụụ na-egbu m nʼebe a.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.17",
                "verseOrgIds": [
                  "LUK.15.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.17",
            "verseOrgIds": [
              "LUK.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Aga m ebili lakwuru nna m, sị ya, Nna, emehiela m megide eluigwe na gị onwe gị.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.18",
                "verseOrgIds": [
                  "LUK.15.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.18",
            "verseOrgIds": [
              "LUK.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ekwesikwaghị m ka a kpọọ m nwa gị ọzọ, were m dị ka otu nʼime ndị i goro ọrụ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.19",
                "verseOrgIds": [
                  "LUK.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.19",
            "verseOrgIds": [
              "LUK.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, o biliri laghachikwuru nna ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 15:20"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma mgbe ọ nọrịị nʼebe dị anya, nna ya hụrụ ya, nwee ọmịiko nʼahụ ya, gbaara ọsọ ga makụọ ya, sutukwa ya ọnụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.20",
                "verseOrgIds": [
                  "LUK.15.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwa ya nwoke ahụ sịrị ya, 'Nna, emehiela m megide eluigwe na gị onwe gị. Ekwesighị m ka a kpọọ m nwa gị ọzọ.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.21",
                "verseOrgIds": [
                  "LUK.15.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma nna ya gwara ndị ohu ya sị, 'Meenụ ngwangwa weta uwe kachasị mma yikwasị ya. Gbanye ya ọlaaka nʼaka, yinyekwanụ ya akpụkpọụkwụ nʼụkwụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.22",
                "verseOrgIds": [
                  "LUK.15.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.22",
            "verseOrgIds": [
              "LUK.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gaanụ kpụpụta nwa ehi gbara abụba, gbuo ya, ka anyị rie ma ṅụrịakwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.23",
                "verseOrgIds": [
                  "LUK.15.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.23",
            "verseOrgIds": [
              "LUK.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na nwa m a, nwụrụ anwụ ma ọ dịla ndụ ọzọ. O fukwara efu ma a chọtala ya.' Ha bidoro na-eri, na-aṅụ na-aṅụrịkwa ọṅụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.24",
                "verseOrgIds": [
                  "LUK.15.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dịghị anya, nwa ya nke okenye, onye jere ịrụ ọrụ nʼubi, mgbe ọ na-abịaru ụlọ nso, ọ nụrụ ụda egwu na ịgba egwu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.25",
                "verseOrgIds": [
                  "LUK.15.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.25",
            "verseOrgIds": [
              "LUK.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ kpọrọ otu nʼime ndị ohu jụọ ya ihe na-eme.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.26",
                "verseOrgIds": [
                  "LUK.15.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.26",
            "verseOrgIds": [
              "LUK.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ sịrị ya, 'Nwanne gị nwoke alọtala. Nna gị egbuola nwa ehi gbara abụba nʼihi na ọ lọtara nʼudo na ahụ ike.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.27",
                "verseOrgIds": [
                  "LUK.15.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iwe were ya, ọ jụrụ ịbata nʼime ụlọ. Nna ya pụtara nʼezi rịọ ya arịrịọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.28",
                "verseOrgIds": [
                  "LUK.15.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.28",
            "verseOrgIds": [
              "LUK.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ zara nna ya sị, 'Lee ọtụtụ afọ niile ndị a ka m nọọ na-ejere gị ozi, enupukwaghị m isi nʼiwu gị nʼụzọ ọbụla. Ma o nweghị oge i nyere m ọ bụladị nwa ewu sị mụ na ndị enyi m jiri ya mee oriri.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.29",
                "verseOrgIds": [
                  "LUK.15.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.29",
            "verseOrgIds": [
              "LUK.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ugbu a, nwa gị a, onye ya na ndị akwụna mefuru akụ gị alọtala, ya ka i gburu nwa ehi gbara abụba.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.30",
                "verseOrgIds": [
                  "LUK.15.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ọ sịrị ya, 'Nwa m, mụ na gị nọ mgbe niile, ihe niile m nwere bụkwa nke gị.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.31",
                "verseOrgIds": [
                  "LUK.15.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.31",
            "verseOrgIds": [
              "LUK.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma anyị kwesiri ịṅụrị ọṅụ, kpọọkwa oriri, nʼihi na nwanne gị nwoke a nwụrụ anwụ ma ọ dịla ndụ ọzọ. O fukwara efu ma a chọtala ya. ' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.15.32",
                "verseOrgIds": [
                  "LUK.15.32"
                ]
              }
            }
          ]
        }
      ]
    }
