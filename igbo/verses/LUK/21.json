  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "LUK 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyinye nwanyị dị ya nwụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ leliri anya elu hụ ka ndị ọgaranya si etinye onyinye ha nʼime igbe onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ hụkwara otu nwanyị di ya nwụrụ anwụ ka ọ bịara tinye naanị mkpụrụ ego kọpa abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie, agwa m unu, nwanyị ogbenye a di ya nwụrụ etinyela ego karịa ndị ọzọ niile.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.3",
                "verseOrgIds": [
                  "LUK.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ndị ọzọ niile nyere onyinye ha site nʼego mapụtaara ha nʼakụnụba ha, ma ya onwe ya sitere nʼogbenye ya tinye ihe niile o ji biri.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.4",
                "verseOrgIds": [
                  "LUK.21.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akara na-egosi ọgwụgwụ oge",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụfọdụ na-ekwu okwu banyere otu e si were nkume mara mma na onyinye e chere nʼihu Chineke, chọọ ụlọnsọ ukwu ahụ mma, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma banyere ihe ndị a, oge na-abịa mgbe ihe ndị a niile unu na-ahụ na-agaghị adịkwa. Ọ dịghị otu nkume a ga-ahapụ nʼelu ibe ya, a ga-akwatusị ha niile.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.6",
                "verseOrgIds": [
                  "LUK.21.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jụrụ ya sị, \"Onye ozizi, olee mgbe ihe ndị a ga-emezu? Gịnị ga-abụkwa ihe ịrịbama ga-egosi na ha na-aga imezu?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lezienụ anya ka a ghara iduhie unu nʼihi na ọtụtụ ga-abịa nʼaha m sị, 'Abụ m ya,' na-asịkwa na 'Oge ahụ dị nso.' Unu esokwala ha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.8",
                "verseOrgIds": [
                  "LUK.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọbụla unu nụrụ akụkọ agha dị iche iche na ọgbaaghara, ka ụjọ ghara ịtụ unu, ihe ndị a aghaghị ibu ụzọ mezuo, ma ọgwụgwụ oge erubeghị.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.9",
                "verseOrgIds": [
                  "LUK.21.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mba ga-ebili megide mba, alaeze ga-ebilikwa megide alaeze.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.10",
                "verseOrgIds": [
                  "LUK.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ga-enwe ala ọma jijiji dị ukwuu. Ụnwụ na ọrịa ọjọọ dị iche iche ga-adịkwa nʼebe dị iche iche. A ga-ahụ ihe dị egwu na ihe ịrịbama dị ukwuu site na mbara eluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.11",
                "verseOrgIds": [
                  "LUK.21.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma tupu ihe ndị a niile emezuo, ha ga-ejide unu, kpagbukwaa unu. Ha ga-enyefe unu nʼaka ọtụtụ ụlọ ekpere. Ha ga-atụkwa unu mkpọrọ. Ha ga-akpọpụkwa unu nʼihu ndị eze na ndị ọchịchị nʼihi aha m.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.12",
                "verseOrgIds": [
                  "LUK.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nke a ga-abụrụ unu ohere iji gbaa akaebe.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.13",
                "verseOrgIds": [
                  "LUK.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma burunu ụzọ kpebie nʼobi unu na unu agaghị echegbu onwe unu maka ihe unu ga-aza.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.14",
                "verseOrgIds": [
                  "LUK.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na aga m enye unu ụdị okwu na amamihe nke ndị na-ebo unu ebubo na-enweghị ike iguzogide maọbụ kwuo okwu megide.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.15",
                "verseOrgIds": [
                  "LUK.21.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụladị ndị mụrụ unu, ụmụnne unu ndị nwoke na ndị nwanyị, ndị ikwu unu na ndị enyi unu, ha ga-arara unu nye nʼaka ndị ọchịchị, ndị ga-egbukwa ụfọdụ nʼime unu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.16",
                "verseOrgIds": [
                  "LUK.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmadụ niile ga-akpọ unu asị nʼihi m.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.17",
                "verseOrgIds": [
                  "LUK.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma otu agịrị isi dị nʼisi unu agaghị ala nʼiyi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.18",
                "verseOrgIds": [
                  "LUK.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu ga-azọpụta ndụ unu site na ntachiobi unu.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.19",
                "verseOrgIds": [
                  "LUK.21.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe unu hụrụ ka ndị agha gbara Jerusalem gburugburu, matanụ na oge e ji ala ya nʼiyi eruola.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.20",
                "verseOrgIds": [
                  "LUK.21.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.20",
            "verseOrgIds": [
              "LUK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼoge ahụ ka ndị nọ na Judịa gbalaga nʼugwu, ka ndị nọ nʼime obodo si na ya pụta, ka ndị na-anọghị nʼobodo gharakwa ịba nʼime ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.21",
                "verseOrgIds": [
                  "LUK.21.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.21",
            "verseOrgIds": [
              "LUK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na oge a ga-abụ oge ịbọ ọbọ ka e mezuo ihe niile akwụkwọ nsọ kwuru.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.22",
                "verseOrgIds": [
                  "LUK.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.22",
            "verseOrgIds": [
              "LUK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ahụhụ ga-adịrị ndị dị ime, na ndị na-enye ụmụaka ara, nʼụbọchị ahụ! A ga-enwe oke ihe mgbu nʼala a, iwe ga-adakwasịkwa ụmụ mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.23",
                "verseOrgIds": [
                  "LUK.21.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.23",
            "verseOrgIds": [
              "LUK.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mma agha ga-egbu ha, mba niile ga-adọrọkwa ha nʼagha. Ndị mba ọzọ ga na-azọtọsị Jerusalem nʼụkwụ ruo mgbe oge nke ndị mba ọzọ ahụ zuru.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.24",
                "verseOrgIds": [
                  "LUK.21.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"A ga-enwe ihe ịrịbama nʼanyanwụ, nʼọnwa, na kpakpando. Nʼelu ụwa, mba niile ga-anọ nʼoke ahụhụ na mgbagwoju anya dị ka oke osimiri na-eme mkpọtụ, ebili mmiri ga na-ebilikwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.25",
                "verseOrgIds": [
                  "LUK.21.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.25",
            "verseOrgIds": [
              "LUK.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị mmadụ ga-adakwa mba nʼobi nʼihi ụjọ mgbe ha ghọtara ihe gaje ịbịakwasị ụwa, nʼihi na a ga-eme ka ike niile nke dị nʼeluigwe maa jijiji.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.26",
                "verseOrgIds": [
                  "LUK.21.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.26",
            "verseOrgIds": [
              "LUK.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼoge ahụ, a ga-ahụ Nwa nke Mmadụ ka ọ na-abịa nʼike na ebube nʼigwe ojii.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.27",
                "verseOrgIds": [
                  "LUK.21.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.27",
            "verseOrgIds": [
              "LUK.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ihe ndị a malitere ime, guzoronụ ọtọ welie isi unu elu, nʼihi na oge mgbapụta unu dị nso.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.28",
                "verseOrgIds": [
                  "LUK.21.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụụrụ ha ilu a,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Leenụ osisi fiig na osisi ndị ọzọ niile anya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.29",
                "verseOrgIds": [
                  "LUK.21.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.29",
            "verseOrgIds": [
              "LUK.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ha bidoro ipupụta ahịhịa ọhụrụ, unu na-amata na ọkọchị adịla nso.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.30",
                "verseOrgIds": [
                  "LUK.21.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.30",
            "verseOrgIds": [
              "LUK.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụzọ dị otu a kwa, mgbe unu hụrụ ihe ndị a niile ka ha na-eme, matanụ na alaeze Chineke adịla nso.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.31",
                "verseOrgIds": [
                  "LUK.21.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie agwa m unu, ọgbọ a agaghị agabiga tupu ihe ndị a niile emezuo.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.32",
                "verseOrgIds": [
                  "LUK.21.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.32",
            "verseOrgIds": [
              "LUK.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Eluigwe na ụwa ga-agabiga, ma okwu m enweghị ike ịgabiga.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.33",
                "verseOrgIds": [
                  "LUK.21.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kpachapụkwanụ anya, unu ekwela ka e bogbuo obi unu site nʼoke oriri na ọṅụṅụ na nchekasị nke ndụ a, site otu a mee ka ụbọchị ahụ bịakwasị unu na mberede, dị ka ọnya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.34",
                "verseOrgIds": [
                  "LUK.21.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.34",
            "verseOrgIds": [
              "LUK.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ọ ga-abịakwasị ndị niile bi nʼelu ụwa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.35",
                "verseOrgIds": [
                  "LUK.21.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.35",
            "verseOrgIds": [
              "LUK.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nọrọnụ na nche oge niile ma na-ekpekwanụ ekpere ka unu nwee ike ịgbanarị ihe niile gaje ịbịa, ka unu nweekwa ike iguzo nʼihu Nwa nke Mmadụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.36",
                "verseOrgIds": [
                  "LUK.21.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa ụbọchị, ọ na-ezi ihe nʼụlọnsọ ukwu ahụ, ma nʼuhuruchi, ọ na-arịgoro nʼelu Ugwu Oliv ị ga nọọ ọnọdụ abalị.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.37",
            "verseOrgIds": [
              "LUK.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ niile na-abịakwute ya nʼisi ụtụtụ niile nʼụlọnsọ ukwu ịnụrụ okwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.38",
            "verseOrgIds": [
              "LUK.21.38"
            ]
          }
        }
      ]
    }
  ],
