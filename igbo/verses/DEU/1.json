  "verseCount": 46,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "DEU 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Izrel ebuliekwa ije",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ okwu ahụ Mosis gwara Izrel niile mgbe ha nọ nʼọwụwa anyanwụ Jọdan,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.1",
            "verseOrgIds": [
              "DEU.1.1"
            ]
          }
        },
        {
          "text": "nʼọzara nʼAraba, ebe chere ihu nʼobodo Suf, nʼetiti Paran na Tofel na Leban, na Hazerọt, na Dizahab.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.1",
            "verseOrgIds": [
              "DEU.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼugwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.2",
            "verseOrgIds": [
              "DEU.1.2"
            ]
          }
        },
        {
          "text": "Horeb ruo Kadesh Banea, bụ njem abalị iri na otu ma e soro ụzọ gawara ugwu Sia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.2",
            "verseOrgIds": [
              "DEU.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼabalị mbụ nke ọnwa iri na otu, nke afọ iri anọ ka Mosis gwara ụmụ Izrel ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.3",
            "verseOrgIds": [
              "DEU.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.3",
                "verseOrgIds": [
                  "DEU.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya nʼiwu banyere ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.3",
            "verseOrgIds": [
              "DEU.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke mere mgbe ọ lụgbuchara Saịhọn, eze ndị Amọrait, onye na-achị na Heshbọn, lụgbukwaa Ọg, eze ndị Bashan na Edrei, onye na-achị nʼAshtarọt.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.4",
            "verseOrgIds": [
              "DEU.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọwụwa anyanwụ Jọdan, nʼala ndị Moab ka Mosis nọ kọwaara ụmụ Izrel iwu ndị a sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.5",
            "verseOrgIds": [
              "DEU.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.6",
                "verseOrgIds": [
                  "DEU.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị gwara anyị nʼugwu Horeb sị, \"Unu anọọla ọtụtụ oge nʼugwu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.6",
            "verseOrgIds": [
              "DEU.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a bilienụ ije, baa nʼala ugwu ugwu ndị Amọrait. Gaakwanụ nʼala niile ndị agbataobi ha bụ Araba, nʼugwu niile na nʼebe dị ala ala na Negeb, nʼọnụ mmiri nke oke osimiri, garuokwanụ ala ndị Kenan na nke ndị Lebanọn, gagidekwanụ ruo nʼosimiri ukwu Yufretis.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.7",
            "verseOrgIds": [
              "DEU.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, enyela m unu ala ahụ niile! Baanụ nʼime ya, bichiekwanụ ala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.8",
                "verseOrgIds": [
                  "DEU.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụrụ iyi na ọ ga-enye nna nna unu bụ Ebraham, Aịzik, Jekọb na ụmụ ụmụ ha niile ndị ga-esote ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.8",
            "verseOrgIds": [
              "DEU.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhọpụta ndị ndu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, agwara m unu ụmụ Izrel okwu sị, \"Unu bụụrụ m oke ibu arọ, apụghịkwa m ibu unu naanị m.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.9",
            "verseOrgIds": [
              "DEU.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.10",
                "verseOrgIds": [
                  "DEU.1.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu emeela ka unu mụbaa dịka kpakpando nke eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.10",
            "verseOrgIds": [
              "DEU.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.11",
            "verseOrgIds": [
              "DEU.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.11",
                "verseOrgIds": [
                  "DEU.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna unu ha meekwa ka unu mụbaa nʼọnụọgụgụ, puku kwụrụ puku, ya gọziekwa unu dịka o kwere na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.11",
            "verseOrgIds": [
              "DEU.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma olee otu naanị m ga-esi buo ibu unu, doziekwa ise okwu unu na nsogbu unu niile?",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.12",
            "verseOrgIds": [
              "DEU.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Họpụtanụ ụfọdụ ndị ikom nwe amamihe, nghọta, na ndị a na-akwanyere ụgwụ, site nʼebo niile unu nʼotu nʼotu, aga m emekwa ha ndịisi unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.13",
            "verseOrgIds": [
              "DEU.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu zara sị m, \"Ihe ahụ i zubere ime dị mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.14",
            "verseOrgIds": [
              "DEU.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, a kpọọrọ m ndịisi nʼebo dị iche iche, ndị ikom maara ihe, na ndị a na-asọpụrụ, mee ka ha bụrụ ndịisi ọchịchị unu, ụfọdụ ha na-elekọta puku mmadụ, ụfọdụ narị mmadụ, ndị ọzọ na-elekọta iri mmadụ ise, ndị ọzọ mmadụ iri, ka ha bụrụ ndị ndu ebo dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.15",
            "verseOrgIds": [
              "DEU.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adọrọ m ndị ikpe unu a aka na ntị nʼoge ahụ sị ha, \"Nụrụnụ ikpe niile metụtara esemokwu dị nʼetiti ụmụnna unu, ma kpeenụ ikpe ọbụla na-eleghị mmadụ anya nʼihu ma ikpe ahụ ọ dị nʼetiti ụmụnna unu ndị Izrel, maọbụ nʼetiti ndị Izrel na ndị ọbịa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.16",
            "verseOrgIds": [
              "DEU.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpeenụ ikpe ziri ezi nye onye ukwu na onye nta. Elekwala ndị unu na-ekpe ikpe anya nʼihu, nʼihi na unu na-ekpe ikpe unu nʼọnọdụ Chineke.\" Enyekwara m ha iwu sị ha wetaranụ m ikpe niile siri unu ike ka m leba ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.17",
            "verseOrgIds": [
              "DEU.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, agwara m unu ihe niile unu na-aghaghị ime.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.18",
            "verseOrgIds": [
              "DEU.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzipụ ndị Nnyopụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, dịka iwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.19",
            "verseOrgIds": [
              "DEU.1.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.19",
                "verseOrgIds": [
                  "DEU.1.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị nyere si dị, anyị hapụrụ ugwu Horeb, chee ihu gawa nʼala ugwu ugwu ndị Amọrait. Ụzọ anyị si gafee ọzara ukwu ahụ dị egwu nke unu ji anya unu hụ tutu anyị erute Kadesh Banea.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.19",
            "verseOrgIds": [
              "DEU.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ agwara m unu okwu sị, \"Unu erutela nʼala ugwu ugwu ndị Amọrait, ala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.20",
            "verseOrgIds": [
              "DEU.1.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.20",
                "verseOrgIds": [
                  "DEU.1.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị na-enye anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.20",
            "verseOrgIds": [
              "DEU.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.21",
                "verseOrgIds": [
                  "DEU.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu enyela unu ala ahụ. Gaanụ nweta ya ka ọ bụrụ nke unu dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.21",
                "verseOrgIds": [
                  "DEU.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna unu gwara unu sị, Unu atụla egwu, ka obi unu gharakwa ịda mba.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.21",
            "verseOrgIds": [
              "DEU.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu niile bịakwutere m sị m, \"Ka anyị zipụ ndị nnyocha ka ha gaa mata ezi ụzọ e si abanye nʼala ahụ. Anyị ga-ekpebikwa obodo ndị anyị ga-ebu ụzọ banye.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.22",
            "verseOrgIds": [
              "DEU.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntụpụta unu juru m afọ, nʼihi ya, esitere m nʼetiti unu họpụta mmadụ iri na abụọ, otu onye site nʼebo ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.23",
            "verseOrgIds": [
              "DEU.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a pụrụ, gbagoo ala ugwu ugwu ahụ tutu bịaruo na Ndagwurugwu Eshkọl. Ha legharịrị anya nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.24",
            "verseOrgIds": [
              "DEU.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ghọtara ụfọdụ nʼime mkpụrụ osisi mịrị nʼala ahụ, bulatara anyị. Ha wetakwaara anyị ozi, sị, \"Ala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.25",
                "verseOrgIds": [
                  "DEU.1.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị na-aga inye anyị dị mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.25",
            "verseOrgIds": [
              "DEU.1.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nnupu isi ụmụ Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu jụrụ ịga nʼala ahụ, si otu a nupu isi megide iwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.26",
                "verseOrgIds": [
                  "DEU.1.26"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nyere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.26",
            "verseOrgIds": [
              "DEU.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu nọ nʼụlọ ikwu unu tamuo ntamu na-asị, \"Nʼezie",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.27",
                "verseOrgIds": [
                  "DEU.1.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụghị anyị nʼanya. Lee ka o si site nʼala Ijipt dupụta anyị were anyị nyefee nʼaka ndị Amọrait ka ha laa anyị nʼiyi!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.27",
            "verseOrgIds": [
              "DEU.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebee ka anyị nwere ike ịga ugbu a? Ụmụnna anyị gara nyochaa ala ahụ emenyela anyị egwu. Ha sịrị, 'Na ndị bi nʼala ahụ toro ogologo karịa anyị bụrụkwa ndị dị ike. Ha sịkwara na mgbidi e ji gbaa obodo ha gburugburu topuru ruo nʼeluigwe! Anyị hụkwara ụmụ Anak",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        },
        {
          "text": "nʼebe ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.28",
            "verseOrgIds": [
              "DEU.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agwara m unu sị, \"Ka ụjọ ghara ịtụ unu, unu atụla ndị ahụ egwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.29",
            "verseOrgIds": [
              "DEU.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.30",
                "verseOrgIds": [
                  "DEU.1.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, onye na-aga nʼihu unu, ga-alụrụ unu ọgụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "text": "dịka o si lụọra unu ọgụ nʼihu anya unu, nʼala Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.30",
            "verseOrgIds": [
              "DEU.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakwa nʼime ọzara, ebe unu nọ hụ otu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.31",
                "verseOrgIds": [
                  "DEU.1.31"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu si bulie unu elu dịka nna si ebuli nwa ya elu, nʼụzọ niile unu gbasoro tutu unu erute ebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.31",
            "verseOrgIds": [
              "DEU.1.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 1:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agbanyeghị nke a, unu ekwenyeghị na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.32",
                "verseOrgIds": [
                  "DEU.1.32"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.32",
            "verseOrgIds": [
              "DEU.1.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 1:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ onye gara nʼihu unu nʼije unu niile, ịchọpụtara unu ebe unu ga-ama ụlọ ikwu unu, onye jikwa ọkụ duo unu nʼabalị, jiri igwe ojii duo unu nʼehihie, iji zi unu ụzọ unu ga-agbaso.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.33",
            "verseOrgIds": [
              "DEU.1.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 1:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu o si dị, mgbe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.34",
                "verseOrgIds": [
                  "DEU.1.34"
                ]
              }
            }
          ]
        },
        {
          "text": "nụrụ ntamu unu, iwe dị ukwuu were ya, nʼihi ntamu unu, ọ ṅụrụ iyi sị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.34",
            "verseOrgIds": [
              "DEU.1.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 1:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"O nweghị otu onye nʼime ọgbọ ọjọọ a ga-anọ ndụ hụ ala ọma ahụ m ṅụrụ iyi inye nna nna unu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.35",
            "verseOrgIds": [
              "DEU.1.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 1:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "karịakwa Kaleb, nwa Jefune. Ọ ga-ahụ ala ahụ anya, aga m enye ya na ụmụ ụmụ ya ala ahụ ọ zọkwasịrị ụkwụ ya, nʼihi na o ji obi ya niile sogide",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.36",
                "verseOrgIds": [
                  "DEU.1.36"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.36",
            "verseOrgIds": [
              "DEU.1.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 1:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa nʼihi unu ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.37",
                "verseOrgIds": [
                  "DEU.1.37"
                ]
              }
            }
          ]
        },
        {
          "text": "ji weso m iwe, na-asị, \"Gị onwe gị kwa, ị gaghị aba nʼebe ahụ!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.37",
            "verseOrgIds": [
              "DEU.1.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DEU 1:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama Joshua, nwa Nun, onye na-enyere gị aka, ga-edu ha banye nʼebe ahụ. Gbaa ya ume nʼihi na ọ bụ ya ga-edu ndị Izrel inweta ala ahụ dịka ihe nketa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.38",
            "verseOrgIds": [
              "DEU.1.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DEU 1:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa ụmụntakịrị ahụ na-amaghị ihe dị iche site nʼihe ọma na ihe ọjọọ ka m ga-enye ala ahụ. Ha ga-abanye nʼime ya, nweta ya dịka ihe nketa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.39",
            "verseOrgIds": [
              "DEU.1.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DEU 1:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu onwe unu, bilienụ, chigharịa gawa nʼime ọzara. Cheenụ ihu unu nʼOsimiri Uhie.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.40",
            "verseOrgIds": [
              "DEU.1.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DEU 1:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, unu kwupụtara mmehie unu sị, \"Anyị emehiela megide",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.41",
                "verseOrgIds": [
                  "DEU.1.41"
                ]
              }
            }
          ]
        },
        {
          "text": ". Anyị ga-agbago nʼala ahụ gaa lụọ ọgụ, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.41",
                "verseOrgIds": [
                  "DEU.1.41"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị nyere anyị nʼiwu.\" Ya mere, onye ọbụla nʼime unu yikwasịrị ihe agha ya na-eche na ọ dị mfe ịgbago nʼobodo ndị ahụ dị nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.41",
            "verseOrgIds": [
              "DEU.1.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DEU 1:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.42",
                "verseOrgIds": [
                  "DEU.1.42"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Gwa ha, 'Unu arịgokwala, gaa buo agha, nʼihi na agaghị m anọnyere unu. Ndị iro unu ga-emerikwa unu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.42",
            "verseOrgIds": [
              "DEU.1.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DEU 1:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, agwara m unu, ma unu aṅaghị ntị. Unu nupuru isi nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.43",
                "verseOrgIds": [
                  "DEU.1.43"
                ]
              }
            }
          ]
        },
        {
          "text": ", jiri nganga juru unu obi bilie, rigoo nʼobodo ahụ dị nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.43",
            "verseOrgIds": [
              "DEU.1.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 1:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Amọrị bụ ndị bi nʼugwu ahụ pụtara, ha chụsasịrị unu dịka aṅụ si eme, tidaa unu nʼala site na Sia ruo Homa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.44",
            "verseOrgIds": [
              "DEU.1.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 1:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, unu lọghachiri bịa kwaa akwa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.1.45",
                "verseOrgIds": [
                  "DEU.1.45"
                ]
              }
            }
          ]
        },
        {
          "text": ", ma o geghị ntị nye olu akwa unu, ọ ṅakwaghị unu ntị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.45",
            "verseOrgIds": [
              "DEU.1.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 1:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, unu nọrọ ọtụtụ oge na Kadesh.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.1.46",
            "verseOrgIds": [
              "DEU.1.46"
            ]
          }
        }
      ]
    }
