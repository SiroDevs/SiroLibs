  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "DEU 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe nketa ndị nchụaja na ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja bụ ndị Livayị, na ndị ebo Livayị niile agaghị enwe oke maọbụ ihe nketa ọbụla dịka ebo ndị ọzọ nʼIzrel. Ihe onyinye ịchụ aja niile e wetara nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.1",
                "verseOrgIds": [
                  "DEU.18.1"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼọkụ bụ ihe nketa ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha agaghị enwe ihe nketa ọbụla nʼetiti ụmụ Izrel ndị ọzọ, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.2",
                "verseOrgIds": [
                  "DEU.18.2"
                ]
              }
            }
          ]
        },
        {
          "text": "abụrụla ihe nketa nke ha dịka o kwere ha na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ga-abụ oke ruuru ndị nchụaja nʼebe ndị mmadụ nọ, nʼebe ndị na-achụ aja, site nʼanụ ehi maọbụ atụrụ: a ga-enye onye nchụaja ubu aka ya, agba ya abụọ na afọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-enwetakwa mkpụrụ mbụ nke owuwe ihe ubi unu, ya bụ, ọka mbụ unu, mmanya vaịnị ọhụrụ unu, mmanụ oliv unu na ajị mbụ a kpụchapụtara site nʼahụ igwe atụrụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.5",
                "verseOrgIds": [
                  "DEU.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ahọpụtala ebo Livayị na ụmụ ụmụ ha site nʼebo niile nke Izrel ka ha bụrụ ndị ga-eguzo jee ozi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.5",
                "verseOrgIds": [
                  "DEU.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": "oge niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Livayị ọbụla si nʼebe o bi kwapụ gaa biri nʼobodo ọzọ nʼIzrel nwere ike ije nʼebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.6",
                "verseOrgIds": [
                  "DEU.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtara,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-eje ozi nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.7",
                "verseOrgIds": [
                  "DEU.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ya dịka ụmụnna ya ndị Livayị na-eje ozi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.7",
                "verseOrgIds": [
                  "DEU.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-esokwa keta oke a na-ekenye ndị Livayị bi nʼobodo ahụ, nʼagbanyeghị na ọ na-enweta ego site nʼorire e rere ihe onwunwe ezinaụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpere arụsị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ị banyere nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.9",
                "verseOrgIds": [
                  "DEU.18.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị, amụtakwala ime omume arụ dịka ndị mba bi nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka a hapụ ịchọta onye ọbụla nʼetiti gị nke na-ewere nwa ya nwoke maọbụ nwanyị nye ka a kpọọ ya ọkụ nʼihi ịchụrụ chi ndị mba ọzọ aja. Ka onye Izrel ọbụla ghara ịbụ onye na-ajụ mmụọ ase maọbụ onye mgbaasị maọbụ na-agba aja,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.10",
            "verseOrgIds": [
              "DEU.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ onye na-akụ mmadụ ibe ya ọgwụ, maọbụ onye na-ajụ mmụọ ọjọọ ase, maọbụ dibịa afa maọbụ onye na-ajụ ase site nʼaka ndị nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.11",
            "verseOrgIds": [
              "DEU.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla na-eme ihe ndị a bụ onye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.12",
                "verseOrgIds": [
                  "DEU.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ asị. Ọ bụkwa nʼihi ihe arụ ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.12",
                "verseOrgIds": [
                  "DEU.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ji na-achụpụ ndị bi nʼala a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.12",
            "verseOrgIds": [
              "DEU.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ghaghị ịbụ onye zuruoke nʼụzọ niile nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.13",
                "verseOrgIds": [
                  "DEU.18.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.13",
            "verseOrgIds": [
              "DEU.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye amụma nke ga-abịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba ndị ị na-aga inweta ala ha bụ ndị na-ajụ ase site nʼaka ndị mgbaasị na ndị na-agba aja, ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.14",
                "verseOrgIds": [
                  "DEU.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị anabataghị na ị ga-eme ihe dị otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.14",
            "verseOrgIds": [
              "DEU.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.15",
                "verseOrgIds": [
                  "DEU.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-eme ka onye amụma nke dị ka m biliere unu site nʼetiti unu, site nʼetiti ndị unu bụ Izrel. Ọ bụ ya ka unu ga-aṅa ntị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.15",
            "verseOrgIds": [
              "DEU.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke a bụ ihe gị onwe gị rịọrọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.16",
                "verseOrgIds": [
                  "DEU.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị nʼugwu Horeb, nʼụbọchị mkpokọta ahụ. I kwuru sị, \"Anyị achọghị ịnụ olu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.18.16",
                "verseOrgIds": [
                  "DEU.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": "maọbụ hụ ọkụ ahụ dị egwu anya ọzọ, ka anyị ghara ịnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
