      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Ngabiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debe ọnwa Abib",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "text": "iche maka ime Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.1",
                "verseOrgIds": [
                  "DEU.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, nʼihi na ọ bụ nʼọnwa Abib ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.1",
                "verseOrgIds": [
                  "DEU.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị mere ka i si nʼala Ijipt pụta nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji anụ si nʼigwe atụrụ na ehi gị chụọrọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.2",
                "verseOrgIds": [
                  "DEU.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị aja ngabiga nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.2",
                "verseOrgIds": [
                  "DEU.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahọpụta dịka ebe obibi nye aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erila ya na achịcha e ji ihe na-eko achịcha mee, kama ụbọchị asaa ka ị ga-eri achịcha na-ekoghị eko, ya bụ, achịcha ahụhụ, iji cheta na i si nʼala Ijipt pụta ngwangwa. Nke a ga-eme ka i nwee ike na-echeta mgbe i sitere nʼala Ijipt pụta, ụbọchị niile nke ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ihe ọbụla na-eko achịcha ghara ịbata nʼezinaụlọ gị abalị asaa ndị ahụ. Unu ahapụkwala anụ ọbụla unu chụrụ nʼaja nʼoge uhuruchi nke ụbọchị mbụ, nọọ ruo ụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gaghị achụ aja ngabiga nʼobodo ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.5",
                "verseOrgIds": [
                  "DEU.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nyere gị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "karịakwa nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.6",
                "verseOrgIds": [
                  "DEU.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị họpụtara dịka ebe obibi nye ya ka i ga-anọ chụọ ya. Nʼebe ahụ ka ị ga-achụ aja ngabiga gị nʼoge uhuruchi, mgbe anwụ dachara, nʼoge mgbe dịka oge ụbọchị ahụ i sitere nʼIjipt pụta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ahụ ya nʼọkụ riekwa ya nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.7",
                "verseOrgIds": [
                  "DEU.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ga-ahọpụta. Nʼụtụtụ, ị ga-alaghachikwa nʼụlọ ikwu gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị isii ka ị ga-eri achịcha na-ekoghị eko, nʼụbọchị nke asaa, nweenụ mkpọkọta nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.8",
                "verseOrgIds": [
                  "DEU.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, arụkwala ọrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme owuwe ihe ubi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gụpụta izu asaa site na mgbe ị malitere itinye mma iwe ihe ubi nʼukwu ọka guzoro eguzo nʼubi gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
              "DEU.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meenụ Mmemme Izu Ụka asaa nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.10",
                "verseOrgIds": [
                  "DEU.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke gị, site na inye onyinye afọ ofufu, nʼusoro ọtụtụ ngọzị",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.10",
                "verseOrgIds": [
                  "DEU.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị ji gọzie gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ oge ịṅụrị ọṅụ nye gị na ụmụ gị ndị ikom na ndị inyom, ndị ohu gị nwoke na nwanyị, ndị Livayị bi nʼobodo gị, ndị ọbịa, ndị na-enweghị nna na ndị inyom di ha nwụrụ bi nʼetiti gị. Meenụ nke a nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.11",
                "verseOrgIds": [
                  "DEU.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, nʼebe ahụ ọ họpụtara dịka ebe obibi nye aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheta na ị bụrị ohu nʼala Ijipt, nʼihi nke a, unu echefula iwu ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme ụlọ ikwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmenụ mmemme ụlọ Ikwu. Unu aghaghị ime ya ụbọchị asaa mgbe unu wechara ihe ubi, ya bụ, mgbe unu chịkọtachara ọka site nʼebe ịzọcha ọka, nakwa ebe ịzọcha mmanya unu niile",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ oge ịṅụrị ọṅụ, nye gị onwe gị, ụmụ ndị ikom na ndị inyom gị, ndị odibo nwoke na nwanyị unu niile, ndị Livayị, ndị ọbịa, ụmụ mgbei na ụmụ nwanyị niile di ha nwụrụ anwụ ndị bi nʼobodo gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.14",
            "verseOrgIds": [
              "DEU.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-eme mmemme a nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ụbọchị asaa nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼonwe ya họpụtara. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.15",
                "verseOrgIds": [
                  "DEU.16.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ga-agọzi ihe ubi gị niile, gọziekwa akaọrụ gị niile, ime ka ọṅụ gị zuo oke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.15",
            "verseOrgIds": [
              "DEU.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugboro atọ nʼafọ ka ndị ikom unu niile aghaghị ịbịa chee onwe ha nʼihu Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": "unu, nʼebe ọ ga-ahọpụta: nʼoge mmemme ndị a: Mmemme Achịcha na-ekoghị eko, Mmemme Izu Ụka asaa na Mmemme Ụlọ Ikwu. Ọ dịghị onye ọbụla ga-agba aka efu bịa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.16",
                "verseOrgIds": [
                  "DEU.16.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.16",
            "verseOrgIds": [
              "DEU.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla ga-eweta onyinye dịka o nwere ike na dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.16.17",
                "verseOrgIds": [
                  "DEU.16.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị sị gọzie ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.17",
            "verseOrgIds": [
              "DEU.16.17"
            ]
          }
        }
      ]
