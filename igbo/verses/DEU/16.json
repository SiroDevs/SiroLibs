              "type": "text"
            }
          ]
        },
        {
          "text": "Amanyela oyiyi osisi chi Ashera ọbụla gị nʼakụkụ ebe ịchụ aja ị wuru nye",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.21",
