            "sid": "DEU 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ọbụla agaghị alụ nwunye nna ya, nʼihi na ọ bụ nwunye nna ya. Ime ihe dị otu a bụ imerụ ihe ndina nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.30",
            "verseOrgIds": [
              "DEU.23.1"
            ]
          }
        }
