  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "NEH 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị nchụaja na ndị Livayị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndị nchụaja na ndị Livayị ndị so Zerubabel nwa Shealtiel na Jeshua lọta.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:1"
      },
      "items": [
        {
          "text": "Seraya, Jeremaya, Ezra,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaraya, Maluk, Hatush,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2",
            "verseOrgIds": [
              "NEH.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekanaya, Rehum, Meremot,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.3",
            "verseOrgIds": [
              "NEH.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ido, Gineton, Abija",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.4",
            "verseOrgIds": [
              "NEH.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mijamin, Maadaya, Bilga,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.5",
            "verseOrgIds": [
              "NEH.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemaya, Joiarib, Jedaya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.6",
            "verseOrgIds": [
              "NEH.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salu, Amok, Hilkaya na Jedaya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.7",
            "verseOrgIds": [
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:7"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "NEH 12:7"
      },
      "items": [
        {
          "text": "Ndị a niile bụ ndị ndu ndị nchụaja na ndị na-enyere ndị ndụ aka nʼụbọchị Jeshua.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị so ha bụ ndị a: Jeshua, Binui, Kadmiel, Sherebaya, Juda nakwa Matanaya, onye ya na ndị otu ya na-elekọta ofufe ekele.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.8",
            "verseOrgIds": [
              "NEH.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakbukaya, na Unni, ndị otu ha nọ na ncherita ihu nʼofufe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshua mụrụ Joiakim,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:10"
      },
      "items": [
        {
          "text": "Joiakim mụrụ Eliashib,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:10"
      },
      "items": [
        {
          "text": "Eliashib mụrụ Joiada,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joiada mụrụ Jonatan,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:11"
      },
      "items": [
        {
          "text": "ebe Jonatan mụrụ Jadua.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndịisi ikwu ndị nchụaja nʼoge ndụ Joiakim.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 12:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:12"
      },
      "items": [
        {
          "text": "Meraia bụ onyeisi ụmụ Seraya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:12"
      },
      "items": [
        {
          "text": "Hananaya bụ onyeisi ụmụ Jeremaya,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meshulam bụ onyeisi ụmụ Ezra,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:13"
      },
      "items": [
        {
          "text": "Jehohanan, onyeisi ụmụ Amaraya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatan, onyeisi ụmụ Maluk;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:14"
      },
      "items": [
        {
          "text": "Josef bụ onyeisi ụmụ Shekanaya",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke Harim, Adna,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:15"
      },
      "items": [
        {
          "text": "nke Meremot, Helkai;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zekaraya, onyeisi ụmụ Ido;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:16"
      },
      "items": [
        {
          "text": "Meshulam, onyeisi ụmụ Gineton",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zikri, onyeisi ụmụ Abija;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:17"
      },
      "items": [
        {
          "text": "Piltai, onyeisi ụmụ Modaya na Miniamin",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shamua, onyeisi ụmụ Bilga,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:18"
      },
      "items": [
        {
          "text": "Jehonatan, onyeisi ụmụ Shemaya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matenai, onyeisi ụmụ Joiarib;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:19"
      },
      "items": [
        {
          "text": "Uzi, onyeisi ụmụ Jedaya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalai, onyeisi ụmụ Salu;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:20"
      },
      "items": [
        {
          "text": "Eba, onyeisi ụmụ Amok,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashabaya, onyeisi ụmụ Hilkaya;",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "NEH 12:21"
      },
      "items": [
        {
          "text": "Netanel, onyeisi ndị Jedaya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "E dekọtara aha ndịisi ezinaụlọ ndị Livayị niile nʼụbọchị Eliashib, Joiada, Johanan na Jadua, nakwa nke ndị nchụaja nʼakwụkwọ nʼoge ọchịchị Daraiọs bụ eze Peshịa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "E dekwara aha ndịisi ndị Livayị niile nʼakwụkwọ tutu ruo nʼoge Johanan nwa Eliashib dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ndịisi ndị Livayị nʼoge ahụ: Hashabaya, Sherebaya, Jeshua, nwa Kadmiel na ndị otu ha. Ha kere onwe ha ụzọ abụọ. Ụzọ abụọ ndị a na-eguzokwa na-eche ibe ha ihu mgbe ọbụla ha na-abụku Chineke abụ otuto na ekele. Otu ụzọ na-amalite nke ọzọ azaghachi, dịka Devid onye nke Chineke si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nche na-eche ọnụ ụzọ ụlọ ịchịkọba ihe nke ụlọnsọ bụ ndị a: Matanaya, Bakbukaya, Ọbadaya, Meshulam, Talmon na Akub.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jere ozi ha nʼoge Joiakim nwa Jeshua, nwa Jozadak, dị ndụ, na nʼoge Nehemaya bụ onyeisi ọchịchị, na nʼoge Ezra bụkwa onye nchụaja, na onye nkuzi okwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ido mgbidi Jerusalem nsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a na-edo mgbidi Jerusalem ọhụrụ ahụ nsọ, e sitere nʼobodo niile ndị Livayị bi kpọọ ha ka ha bịa nye aka iji ọṅụ mee mmemme ido nsọ ahụ. Ha bịakwara jiri abụ ekele na ihe egwu dị iche iche dịka ụbọ akwara, ịgba na une kelee Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbụ abụ sitekwara nʼobodo niile dị gburugburu Jerusalem bịa, ọ bụladị site nʼobodo niile ndị Netofa,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Bet-Gilgal, na akụkụ Geba na Azmavet, nʼihi na ha ewuorola onwe ha obodo nta dị iche iche gburugburu Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị nchụaja na ndị Livayị dochara onwe ha ọcha, ha dokwara ndị Izrel niile, na ọnụ ụzọ ama niile, na mgbidi ahụ ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mere m ka ndị ndu Juda niile rigoro nʼelu mgbidi ahụ. Nʼebe ahụ ka m kenyere otu ndị ọbụ abụ abụọ inye ekele. Otu ụzọ gara akụkụ aka nri nke elu mgbidi ahụ ruo nʼỌnụ Ụzọ Ama Ikpofu Ahịhịa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshaya na ọkara ndị ndu Juda na-eso ha nʼazụ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha na Azaraya, Ezra, Meshulam,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Juda, Benjamin, Shemaya, Jeremaya",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị nchụaja ndị a ndị na-afụ opi, tinyere Zekaraya nwa Jonatan, nwa Shemaya. Ndị bụ nna nna Zekaraya bụ Matanaya, Mikaya na Zakua, ndị ikwu Asaf.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị otu ya, bụ Shemaya, Azarel, Milalai, Gilalai, Maai, Netanel, Juda na Hanani. Ha niile ji ngwa egwu ha, ụdị ngwa egwu ndị ahụ Devid onye nke Chineke nyere nʼiwu na ndị ọbụ abụ ga-eji. Ezra, bụ ode akwụkwọ nọ nʼihu na-edu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha rutere nʼỌnụ Ụzọ ama Isi Iyi, ha rigooro nʼelu nkwasa nrigo ụlọ elu e si abata nʼobodo Devid, si ebe ahụ gafee ụlọeze Devid, gaakwa lọghachi nʼỌnụ Ụzọ Ama Mmiri, nke dị nʼakụkụ ọwụwa anyanwụ obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbụ abụ nke ọzọ bụ ndị na-enye ekele gara ụzọ aka ekpe. Mụ onwe m sooro ha nʼelu mgbidi ahụ, tinyere ọkara ndị mmadụ ahụ, gafee Ụlọ elu Ite Ọkụ jeruo Mgbidi Sara Mbara.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị sitekwara nʼebe ahụ gafee Ọnụ Ụzọ Ama Ifrem, Ọnụ Ụzọ ama Jeshana, Ọnụ Ụzọ Ama Azụ, Ọnụ Ụzọ Ama Ụlọ Elu Hananel, ruokwa nʼỌnụ Ụzọ Ama Ụlọ Elu Narị na ruo nʼỌnụ Ụzọ Ama Atụrụ, kwụsị nʼỌnụ Ụzọ Ama Ndị Nche.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NEH 12:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụzọ ndị mmadụ abụọ na-abụ abụ ekele nye Chineke zukọtara bata nʼụlọnsọ ukwu. Esokwa m ha bata, mụ na ọkara ndị ndu,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinyere ndị nchụaja ndị a: Eliakịm, Maaseia, Miniamin, Mikaya, Elioenai, Zekaraya na Hananaya. Ndị a niile ji opi ha.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọzọ sokwa bata bụ ndị a: Maaseia, Shemaya, Elieza, Uzi, Jehohanan, Malkija, Elam na Eza. Onyendu ndị ọbụ abụ ahụ niile bụ Jezrahaya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NEH 12:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha chụrụ ọtụtụ aja nʼụbọchị ahụ nʼihi na Chineke nyere ha oke ọṅụ. Ụmụnta na ndị inyom sokwa ṅụrịa ọṅụ. Ha nụkwara ụda ọṅụ ndị Jerusalem site nʼebe dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NEH 12:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ ka a họpụtara ndị ikom na-elekọta ụlọ ịchịkọba ihe, ebe a na-achịkọba onyinye mkpụrụ mbụ, na onyinye otu ụzọ nʼụzọ iri. A na-esite nʼobodo gbara Jerusalem gburugburu na-ewebata nʼụlọ ịchịkọba ihe onyinye niile e nyere nʼiwu maka ọdịmma ndị nchụaja na ndị Livayị. E si otu a na-ewebata ya nʼihi na ọrụ ndị nchụaja na ndị Livayị na-arụ na-atọ ndị Juda ụtọ nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.44",
            "verseOrgIds": [
              "NEH.12.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NEH 12:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha na-arụ ọrụ Chineke ahụ ha ketara ịrụ, ya na ọrụ ido ndị mmadụ na ihe ọbụla nsọ. Otu a kwa ka ndị ọbụ abụ, na ndị na-eche nche sị arụkwa ọrụ a dịka iwu Devid na Solomọn nwa ya nyere si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼoge Devid na Asaf ka e bidoro inwe ndị ndu abụ ito na ikele Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nʼoge Zerubabel na Nehemaya, ndị Izrel niile na-ewebata onyinye e ji akwagide ọrụ ndị ọbụ abụ, na ndị nche, na ndị Livayị. Ha kewapụtakwara oke ruru ndị Livayị ndị ọzọ iche, ndị Livayị nʼonwe ha kwa, kewapụtara oke ruru ụmụ Erọn nʼime ihe e nyere ha dịka e si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.47",
            "verseOrgIds": [
              "NEH.12.47"
            ]
          }
        }
