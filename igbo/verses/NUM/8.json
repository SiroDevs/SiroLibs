          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.8.21",
                "verseOrgIds": [
                  "NUM.8.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka onyinye aja mfufe, chụọrọ ha aja ikpuchi mmehie, ime ka ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, ndị Livayị bịara ije ozi ha nʼụlọ nzute nʼokpuru Erọn na ụmụ ya ndị ikom. Ha nyekwara ndị Livayị ọrụ dịka",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.22",
            "verseOrgIds": [
              "NUM.8.22"
            ]
          }
        },
