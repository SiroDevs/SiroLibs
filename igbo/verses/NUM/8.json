          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị niile doro onwe ha ọcha, sachakwaa uwe ha niile. Erọn chere ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.21",
            "verseOrgIds": [
              "NUM.8.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
