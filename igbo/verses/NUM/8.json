                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.20",
            "verseOrgIds": [
              "NUM.8.20"
            ]
          }
        },
        {
          "name": "verse",
