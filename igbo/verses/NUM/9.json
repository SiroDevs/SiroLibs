  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "NUM 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Ngabiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.1",
                "verseOrgIds": [
                  "NUM.9.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu ndị a nʼọzara Saịnaị nʼọnwa mbụ nʼafọ nke abụọ site nʼoge ha hapụrụ ala Ijipt. Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel ka ha mee Mmemme Ngabiga nʼoge a kara aka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mee ya nʼoge a kara aka, malite nʼuhuruchi abalị iri na anọ nke ọnwa a. Ha ga-eme ya nʼusoro dịka iwu na ụkpụrụ e ji eme ya si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Mosis gwara ndị Izrel sị ha mee Mmemme Ngabiga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mekwara ya nʼọzara Saịnaị malite nʼuhuruchi abalị iri na anọ nke ọnwa mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "text": "Ndị Izrel mere ihe niile nʼusoro dịka iwu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.5",
                "verseOrgIds": [
                  "NUM.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis si dị.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụfọdụ nʼime ụmụ Izrel esoghị mee Mmemme Ngabiga ahụ nʼihi na ha rụrụ arụ site nʼịnọ ozu nso. Nʼihi ya, ha bịakwutere Mosis na Erọn nʼụbọchị ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị Mosis, \"Anyị ghọrọ ndị rụrụ arụ nʼihi ịnọ ozu mmadụ nso. Gịnị ga-egbochi anyị iso ndị Izrel ndị ọzọ iwetara",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.7",
                "verseOrgIds": [
                  "NUM.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye nʼoge a kara aka?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis zara sị ha, \"Cherenụ ka m ga jụta",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.8",
                "verseOrgIds": [
                  "NUM.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ihe bụ uche ya banyere mkpa unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.9",
                "verseOrgIds": [
                  "NUM.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, 'Ọ bụrụ na e nwee onye Izrel ọbụla nke merụrụ onwe ya nʼoge Mmemme Ngabiga site nʼịnọ ozu mmadụ nso, maọbụ site nʼịnọ nʼije, ha nwekwara ike iso mee Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.10",
                "verseOrgIds": [
                  "NUM.9.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ha ga-eme ya nʼuhuruchi abalị iri na anọ nke ọnwa abụọ. Ha ga-eri nwa atụrụ ha, achịcha na-ekoghị eko,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "text": "na ahịhịa ilu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha agaghị erifọ ihe ọbụla nʼime ya ruo chi ọbụbọ ụbọchị so ya. Ha agaghị agbaji ọkpụkpụ ọbụla nke nwa atụrụ ahụ. Mgbe ha mere Mmemme Ngabiga, ha ga-esorokwa ụzọ niile e si eme mmemme ahụ mee nke ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọbụla nọ nʼọnọdụ ịdị ọcha, onye nke na-anọghị nʼije nʼoge Mmemme Ngabiga ma kpachapụrụ anya hapụ isoro ndị ọzọ nʼoge mmemme a, a ga-ewezuga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "text": "ya site nʼetiti ụmụ Izrel niile, nʼihi na ọ jụrụ iwetara",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.13",
                "verseOrgIds": [
                  "NUM.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye nʼoge a kara aka. Onye dị otu a ga-ebu ahụhụ mmehie ya nʼisi ya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbịa bi nʼetiti unu chọrọ iso na Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.14",
                "verseOrgIds": [
                  "NUM.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ ga-eme ya nʼusoro dịka iwu na ụkpụrụ e nyere si dị. Unu ga-enwe otu iwu ahụ nye onye amụrụ nʼala na mbịarambịa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igwe ojii kpuchiri ụlọ nzute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ e guzobere ụlọ nzute ahụ bụ ụlọ ikwu nke igbe iwu ọgbụgba ndụ ahụ, igwe ojii kpuchiri ya. Site nʼuhuruchi ruo nʼụtụtụ igwe ojii ahụ dị nʼelu ụlọ nzute ahụ dịka ọkụ nʼile anya.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ọ dịgidere mgbe niile. Igwe ojii kpuchigidere ya, ma nʼabalị ọ na-acha dị ka ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ bụla igwe ojii ahụ si nʼelu ụlọ nzute ahụ bilie, ụmụ Izrel na-ebuli njem, ma mgbe ọbụla igwe ojii ahụ na-anọgide, ha na-anọgidekwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.18",
                "verseOrgIds": [
                  "NUM.9.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nyekwara iwu, ha na-akwụsị, maa ụlọ ikwu ha. Oge niile igwe ojii nọgidere nʼelu ụlọ nzute ahụ ka ụmụ Izrel na-anọgidekwa nʼụlọ ikwu ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na igwe ojii ahụ anọọtee anya, ụmụ Izrel nʼonwe ha na-erube isi nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NUM.9.19",
                "verseOrgIds": [
                  "NUM.9.19"
                ]
              }
            }
          ]
        },
        {
          "text": "hapụ ịga nʼihu nʼije ha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oge ụfọdụ, igwe ojii ahụ na-anọgide naanị abalị ole na ole. Dịka iwu",
          "type": "text",
          "attrs": {
