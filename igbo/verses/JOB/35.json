  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "JOB 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Elihu sịrị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.1",
            "verseOrgIds": [
              "JOB.35.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị na-eche na nke a ziri ezi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:2"
      },
      "items": [
        {
          "text": "Ị sịrị, 'Na m ziri ezi ọ bụghị Chineke.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.2",
            "verseOrgIds": [
              "JOB.35.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị ihe ndị a, ị na-ajụ ya si, 'Uru gịnị ka ọ baara m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:3"
      },
      "items": [
        {
          "text": "gịnị bụ uru m ma ọ bụrụ na emehieghị m?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.3",
            "verseOrgIds": [
              "JOB.35.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ ga-amasị m ịzaghachi gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:4"
      },
      "items": [
        {
          "text": "zaghachikwa ndị enyi gị na ha nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.4",
            "verseOrgIds": [
              "JOB.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lelie anya na eluigwe ma hụkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:5"
      },
      "items": [
        {
          "text": "Legide mbara igwe na igwe oji niile, nke dị anya karịa gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.5",
            "verseOrgIds": [
              "JOB.35.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i mehie, olee ụzọ nke a si metụta ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:6"
      },
      "items": [
        {
          "text": "Ọ bụrụ na mmehie gị bara ụba, gịnị ka nke a pụrụ ime ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.6",
            "verseOrgIds": [
              "JOB.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị bụ onye ezi omume, gịnị ka ị na-enye ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:7"
      },
      "items": [
        {
          "text": "maọbụ gịnị ka ọ na-anata site nʼaka gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.7",
            "verseOrgIds": [
              "JOB.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajọ omume gị na-emetụta naanị mmadụ dịka gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:8"
      },
      "items": [
        {
          "text": "ma ezi omume gị na-emetụta naanị ụmụ ndị mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.8",
            "verseOrgIds": [
              "JOB.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụmụ mmadụ na-eti mkpu akwa nʼihi ịba ụba nke mmegbu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:9"
      },
      "items": [
        {
          "text": "ha na-arịọ arịrịọ enyemaka site nʼaka ndị dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.9",
            "verseOrgIds": [
              "JOB.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ dịghị onye na-asị, 'Olee ebe Chineke onye kere m nọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:10"
      },
      "items": [
        {
          "text": "onye na-enye abụ nʼime abalị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.10",
            "verseOrgIds": [
              "JOB.35.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye na-akụziri anyị ihe karịa ka ọ na-akụziri ụmụ anụ ọhịa nke ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:11"
      },
      "items": [
        {
          "text": "onye na-eme ka anyị bụrụ ndị maara ihe karịa ụmụ nnụnụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        },
        {
          "text": "nke igwe?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.11",
            "verseOrgIds": [
              "JOB.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị azaghachi mgbe ụmụ mmadụ na-eti mkpu akwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:12"
      },
      "items": [
        {
          "text": "nʼihi ịnya isi nke ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.12",
            "verseOrgIds": [
              "JOB.35.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, Chineke adịghị aṅa ntị nʼarịrịọ efu ha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:13"
      },
      "items": [
        {
          "text": "Onye pụrụ ime ihe niile a dịghị elebara ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.13",
            "verseOrgIds": [
              "JOB.35.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ya bụrụzie nke a ị na-ekwu, ọ ga-esi aṅaa gee ntị",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "mgbe ị na-ekwu na ị dịghị ahụ ya anya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "na i burula ikpe gị bịa nʼihu ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:14"
      },
      "items": [
        {
          "text": "na ị ga-anọkwa na-eche ya!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.14",
            "verseOrgIds": [
              "JOB.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọ, nʼihi na iwe ya adịghị eweta ntaramahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:15"
      },
      "items": [
        {
          "text": "nʼihi na ọ dịghị arịba ama ajọ omume ọ bụladị nke dịkarịsịrị nta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.15",
            "verseOrgIds": [
              "JOB.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Job saghere ọnụ ya kwuo okwu dịka onye na-amaghị ihe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 35:16"
      },
      "items": [
        {
          "text": "ka onye na-enweghị uche ọ na-ekwu okwu nkwukwasị efu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.35.16",
            "verseOrgIds": [
              "JOB.35.16"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "JOB.36",
