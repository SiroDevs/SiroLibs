  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "JOB 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Job zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.1",
            "verseOrgIds": [
              "JOB.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụladị taa, mkpesa m dị ilu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:2"
      },
      "items": [
        {
          "text": "aka ya dị arọ megide m nʼagbanyeghị ịsụ ude m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.2",
            "verseOrgIds": [
              "JOB.23.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwa na m maara ebe m ga-achọta ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:3"
      },
      "items": [
        {
          "text": "a sịkwa na m nwere ike ijeru ebe obibi ya!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.3",
            "verseOrgIds": [
              "JOB.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m edozi mkpesa m nʼusoro nʼihu ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:4"
      },
      "items": [
        {
          "text": "were ịrụ ụka mejuo ọnụ m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.4",
            "verseOrgIds": [
              "JOB.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m achọpụta ihe o ga-aza m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:5"
      },
      "items": [
        {
          "text": "ma tuleekwa ihe ọ ga-agwa m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.5",
            "verseOrgIds": [
              "JOB.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji ike dị egwu megide m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:6"
      },
      "items": [
        {
          "text": "Mba, ọ gaghị ebo m ebubo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.6",
            "verseOrgIds": [
              "JOB.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, onye ziri ezi ga-eme mkpesa nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:7"
      },
      "items": [
        {
          "text": "Nʼebe ahụ, a ga-anapụtakwa m site nʼaka onye ikpe m rụọ mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.7",
            "verseOrgIds": [
              "JOB.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na m agaa nʼọwụwa anyanwụ ọ nọghị nʼebe ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:8"
      },
      "items": [
        {
          "text": "ọ bụrụ na m gaa nʼọdịda anyanwụ, agaghị m achọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.8",
            "verseOrgIds": [
              "JOB.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nọ nʼọrụ nʼugwu anaghị m ahụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:9"
      },
      "items": [
        {
          "text": "mgbe ọ lọghachiri na ndịda anaghị m ahụkwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.9",
            "verseOrgIds": [
              "JOB.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ maara ụzọ m na-aga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:10"
      },
      "items": [
        {
          "text": "mgbe ọ nwapụtasịrị m, aga m apụta dịka ọlaedo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.10",
            "verseOrgIds": [
              "JOB.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ụkwụ m abụọ na-agbaso nzọ ụkwụ ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:11"
      },
      "items": [
        {
          "text": "ana m eso ụzọ ya na-atụgharịghị nʼaka nri maọbụ aka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.11",
            "verseOrgIds": [
              "JOB.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esibeghị m nʼiwu nke si nʼọnụ ya pụta wezuga onwe m;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:12"
      },
      "items": [
        {
          "text": "a na m echekwa okwu ọnụ ya karịa nri nke m na-eri kwa ụbọchị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.12",
            "verseOrgIds": [
              "JOB.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma o guzo naanị ya, onye pụrụ iguzogide ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:13"
      },
      "items": [
        {
          "text": "Ọ na-eme ihe ọbụla masịrị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.13",
            "verseOrgIds": [
              "JOB.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-emezu ụkpụrụ ya niile o zubere megide m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:14"
      },
      "items": [
        {
          "text": "ọ ka nwekwara nzube ndị ọzọ yiri nke a o dobere imegide m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.14",
            "verseOrgIds": [
              "JOB.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya ka obi ji ama m jijiji nʼihu ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:15"
      },
      "items": [
        {
          "text": "mgbe m chetara banyere ihe ndị a niile, ana m atụ egwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.15",
            "verseOrgIds": [
              "JOB.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke emeela ka obi m daa mba;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:16"
      },
      "items": [
        {
          "text": "Onye pụrụ ime ihe niile emeela ka m maa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.16",
            "verseOrgIds": [
              "JOB.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọchịchịrị emeghị ka m mechie ọnụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 23:17"
      },
      "items": [
        {
          "text": "bụ oke ọchịchịrị nke kpuchiri ihu m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.23.17",
            "verseOrgIds": [
              "JOB.23.17"
            ]
          }
        }
      ]
    }
  ],
