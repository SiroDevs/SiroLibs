      "attrs": {
        "style": "q2",
        "vid": "JOB 4:19"
      },
      "items": [
        {
          "text": "bụ ndị ntọala ha dị nʼaja,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.19",
            "verseOrgIds": [
              "JOB.4.19"
            ]
