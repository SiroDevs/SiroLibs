      "attrs": {
        "style": "q2",
        "vid": "JOB 4:18"
      },
      "items": [
        {
          "text": "ọ bụrụ na ọ na-ebo ndị mmụọ ozi ya ebubo imejọ ihe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.4.18",
            "verseOrgIds": [
              "JOB.4.18"
            ]
