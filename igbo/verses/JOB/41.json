  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JOB 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị pụrụ iji nko azụ jide Leviatan",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:1"
      },
      "items": [
        {
          "text": "maọbụ jiri ụdọ kegide ire ya bịada ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.1",
            "verseOrgIds": [
              "JOB.40.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị pụrụ ikenye eriri nʼimi ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:2"
      },
      "items": [
        {
          "text": "maọbụ were ngu igwe mapuo agba ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.2",
            "verseOrgIds": [
              "JOB.40.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-arịọ gị arịrịọ ka i meere ya ebere?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:3"
      },
      "items": [
        {
          "text": "Ọ ga-eji olu dị nro gwa gị okwu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.3",
            "verseOrgIds": [
              "JOB.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ekwe ka gị na ya baa nʼọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:4"
      },
      "items": [
        {
          "text": "ka i were ya dịka ohu gị ogologo ndụ ya niile?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.4",
            "verseOrgIds": [
              "JOB.40.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji ya gwurie egwu dịka nnụnụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:5"
      },
      "items": [
        {
          "text": "Maọbụ kee ya eriri nye ya ụmụ agbọghọ nọ nʼụlọ gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.5",
            "verseOrgIds": [
              "JOB.40.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahịa ha ga-eji ya zụọ ahịa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:6"
      },
      "items": [
        {
          "text": "Ha ga-eke ya nʼetiti ndị mgbereahịa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.6",
            "verseOrgIds": [
              "JOB.40.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị pụrụ iji igwe nko mejuo akpụkpọ ahụ ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:7"
      },
      "items": [
        {
          "text": "maọbụ iji ùbe ndị ọkụ azụ dupuo isi ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.7",
            "verseOrgIds": [
              "JOB.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị tụkwasị ya aka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:8"
      },
      "items": [
        {
          "text": "ị gaghị echefu ọgụ ọ ga-alụso gị. Ị gakwaghị anwa ya ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.8",
            "verseOrgIds": [
              "JOB.40.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ime ihe nzuzu bụ mmadụ ịgbalị ijide ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:9"
      },
      "items": [
        {
          "text": "Naanị ilekwasị ya anya na-eyi egwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.9",
            "verseOrgIds": [
              "JOB.41.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, o nweghị onye nwere obi ike ịkpasu ya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:10"
      },
      "items": [
        {
          "text": "Ọ bụ onye pụrụ iguzogide m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.10",
            "verseOrgIds": [
              "JOB.41.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee onye m ji ụgwọ nke m na-aghaghị ịkwụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:11"
      },
      "items": [
        {
          "text": "Ihe niile dị nʼokpuru eluigwe bụ nke m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.11",
            "verseOrgIds": [
              "JOB.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agaghị m akwụsị ikwu ihe banyere ụkwụ na aka Leviatan,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:12"
      },
      "items": [
        {
          "text": "na ike ya, na ụdịdị ya mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.12",
            "verseOrgIds": [
              "JOB.41.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nwere ike ikpughepụ ihe e ji kpuchie ya ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:13"
      },
      "items": [
        {
          "text": "Onye nwekwara ike ịbanye nʼagba ya apịajiri okpukpu abụọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.13",
            "verseOrgIds": [
              "JOB.41.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye pụrụ imeghe ụzọ nke ọnụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:14"
      },
      "items": [
        {
          "text": "nke eze dị oke egwu gbara gburugburu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.14",
            "verseOrgIds": [
              "JOB.41.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụ ya nwere ọta",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        },
        {
          "text": "ndị e doro nʼusoro",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:15"
      },
      "items": [
        {
          "text": "nke e mechisịrị ike ka ha rapara nʼahụ ibe ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.15",
            "verseOrgIds": [
              "JOB.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ọbụla dị ibe ya nso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:16"
      },
      "items": [
        {
          "text": "na ikuku enweghị ike gafee nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.16",
            "verseOrgIds": [
              "JOB.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jikọtara ha ọnụ nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:17"
      },
      "items": [
        {
          "text": "ha na-ejisi onwe ha ike, enweghị ike ikewa ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.17",
            "verseOrgIds": [
              "JOB.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìhè na-enwupụta mgbe ọbụla o zere uzere;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:18"
      },
      "items": [
        {
          "text": "anya ya abụọ na-achakwa dịka anwụ ụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.18",
            "verseOrgIds": [
              "JOB.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ire ọkụ na-asọpụta site nʼọnụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:19"
      },
      "items": [
        {
          "text": "icheku ọkụ na-ekepụtakwa nʼọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.19",
            "verseOrgIds": [
              "JOB.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anwụrụ ọkụ na-esi nʼimi ya na-apụta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:20"
      },
      "items": [
        {
          "text": "dịka ukuru ọkụ nke na-esi nʼime mmiri na-agbọ nʼelu osisi achara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.20",
            "verseOrgIds": [
              "JOB.41.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ume ọ na-ekupụta na-afụnwu ọkụ icheku.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:21"
      },
      "items": [
        {
          "text": "Ire ọkụ na-esitekwa nʼọnụ ya na-amapụ dịka àkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.21",
            "verseOrgIds": [
              "JOB.41.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 41:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike nwere ọnọdụ nʼolu ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:22"
      },
      "items": [
        {
          "text": "obi ịlọ mmiri na-aga ya nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.22",
            "verseOrgIds": [
              "JOB.41.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akpụkpọ anụ ahụ ya bụ ihe jikọtara ọnụ nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:23"
      },
      "items": [
        {
          "text": "ha siri ike na-apụghị inugharị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.23",
            "verseOrgIds": [
              "JOB.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 41:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi ya dị ike dịka nkume,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:24"
      },
      "items": [
        {
          "text": "dịka nkume e ji akwọ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.24",
            "verseOrgIds": [
              "JOB.41.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 41:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o bilitere ọtọ, ndị dike na-atụ oke ụjọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:25"
      },
      "items": [
        {
          "text": "ha na-alaghachi azụ nʼihi mmagharị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.25",
            "verseOrgIds": [
              "JOB.41.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị mma agha ọbụla pụrụ igbochi ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:26"
      },
      "items": [
        {
          "text": "o nwekwaghị ùbe igwe, maọbụ àkụ maọbụ ihe ọbụla a pịrị ọnụ ya apị nke pụrụ igbochi ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.26",
            "verseOrgIds": [
              "JOB.41.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ọ nọ, igwe dị ka ahịhịa;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:27"
      },
      "items": [
        {
          "text": "bronz dịkwa ka osisi rere ure nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.27",
            "verseOrgIds": [
              "JOB.41.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Àkụ adịghị eme ka ọ gbalaga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:28"
      },
      "items": [
        {
          "text": "ịtụ ya nkume dị ka ịtụ ya igbugbo ọka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.28",
            "verseOrgIds": [
              "JOB.41.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpọrọ osisi na-adị ya ka ahịhịa ọka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:29"
      },
      "items": [
        {
          "text": "ọ na-achị ọchị na mkpọtụ arụa na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.29",
            "verseOrgIds": [
              "JOB.41.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 41:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okpuru afọ ya dị ka ejuju dị nkọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:30"
      },
      "items": [
        {
          "text": "nke na-ahapụ ụzọ nʼapịtị dịka igwe eji azọcha mkpụrụ ọka site nʼogbe ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.30",
            "verseOrgIds": [
              "JOB.41.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 41:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eme mmiri dị ogbu ka ọ gbọọ dịka ite;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:31"
      },
      "items": [
        {
          "text": "ọ na-akpagharị oke osimiri ka ọ dị ka mmanụ otite dị nʼite.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.31",
            "verseOrgIds": [
              "JOB.41.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 41:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ahapụ ụfụfụ nʼazụ mgbe ọ na-aga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:32"
      },
      "items": [
        {
          "text": "mmadụ ga-eche na ọ osimiri nwere isi awọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.32",
            "verseOrgIds": [
              "JOB.41.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 41:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ihe ọzọ dị nʼụwa yiri ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:33"
      },
      "items": [
        {
          "text": "o nweghị ihe na-emenye ya ụjọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.33",
            "verseOrgIds": [
              "JOB.41.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 41:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eleda ndị mpako niile anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 41:34"
      },
      "items": [
        {
          "text": "Ọ bụkwa eze nʼebe ndị na-anya isi nọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.41.34",
            "verseOrgIds": [
              "JOB.41.26"
            ]
          }
        }
      ]
    }
  ],
