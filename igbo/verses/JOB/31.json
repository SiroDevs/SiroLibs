  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "JOB 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mụ na anya m gbara ndụ kpebie",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:1"
      },
      "items": [
        {
          "text": "na o nweghị mgbe m ga-ele nwaagbọghọ ọbụla anya nʼihi agụụ ịkwa iko.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na, gịnị bụ oke mmadụ ketara nʼaka Chineke onye bi nʼelu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:2"
      },
      "items": [
        {
          "text": "gịnị bụkwa ihe nketa ya site nʼaka Onye pụrụ ime ihe niile nọ nʼelu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị mbibi nye ndị ajọ omume,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:3"
      },
      "items": [
        {
          "text": "nhụju anya nye ndị na-eme ihe ọjọọ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ọ naghị ahụ ụzọ m niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:4"
      },
      "items": [
        {
          "text": "gụọkwa nzọ ukwu m niile ọnụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na m gara ije nʼụzọ ụgha",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:5"
      },
      "items": [
        {
          "text": "maọbụ na ụkwụ m mere ngwangwa gbasoro ụzọ aghụghọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka Chineke were ihe ọtụtụ ziri ezi tụọ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:6"
      },
      "items": [
        {
          "text": "ọ ga-amata na m bụ onye na-enweghị ịta ụta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na nzọ ụkwụ m si nʼụzọ wezuga onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "ọ bụrụ anya m na-edu obi m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "ma ọ bụkwanụ na aka m abụọ bụ ihe e merụrụ emerụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ otu a, ka onye ọzọ rie ihe m kụrụ nʼubi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:8"
      },
      "items": [
        {
          "text": "ka e hopuchakwa ihe niile m kụrụ nʼubi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ọ gụọla obi m agụụ ijekwuru nwanyị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:9"
      },
      "items": [
        {
          "text": "maọbụ na m ezoola nʼọnụ ụzọ onye agbataobi m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, ka nwunye m kwọọrọ nwoke ọzọ nri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:10"
      },
      "items": [
        {
          "text": "ka ndị ikom ọzọ dinaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke ahụ ga-abụ ihe ihere,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:11"
      },
      "items": [
        {
          "text": "bụrụkwa mmehie kwesiri ka e kpee ya ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ọkụ na-ere ruo nʼebe ịla nʼiyi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:12"
      },
      "items": [
        {
          "text": "nke pụrụ ihopu ihe owuwe ubi m niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na m jụrụ ikpe ikpe ziri ezi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "nye nwoke maọbụ nwanyị ọbụla na-ejere m ozi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "mgbe ha nwere mkpesa megide m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "gịnị ka m ga-eme mgbe Chineke bịakwutere m?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:14"
      },
      "items": [
        {
          "text": "Gịnị ka m ga-aza ya mgbe ọ jụrụ m ajụjụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ọ bụghị onye kpụrụ m nʼafọ nne m mekwara ha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "Ọ bụghị ya kpụrụ anyị abụọ nʼafọ nne anyị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na m ajụ inye ndị ogbenye ihe dị ha mkpa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:16"
      },
      "items": [
        {
          "text": "ma ọ bụrụkwa na m eme ka anya nwanyị di ya nwụrụ dalaa ya nʼisi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na m dobere ihe oriri m maka naanị m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:17"
      },
      "items": [
        {
          "text": "ma jụ inye ya ụmụ mgbei;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma site nʼokorobịa m, azụlitere m ha dịka nna kwesiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:18"
      },
      "items": [
        {
          "text": "ọ bụkwa site na nwantakịrị ka m bụ onyendu nye nwanyị di ya nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ dị mgbe m hụrụ onye na-ala nʼiyi nʼihi enweghị akwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:19"
      },
      "items": [
        {
          "text": "maọbụ onye nọ nʼụkọ nke na-enweghị uwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.19",
            "verseOrgIds": [
              "JOB.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma obi ha agọzighị m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:20"
      },
      "items": [
        {
          "text": "nʼihi iji ajị sitere nʼụmụ atụrụ m mee ka o nwee okpomọkụ nʼahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.20",
            "verseOrgIds": [
              "JOB.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m eweliela aka m megide onye nna ya nwụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:21"
      },
      "items": [
        {
          "text": "nʼihi na m mara na m nwere nkwuwa okwu nʼụlọikpe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.21",
            "verseOrgIds": [
              "JOB.31.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, ka aka m si nʼubu m dapụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:22"
      },
      "items": [
        {
          "text": "ka e tijiekwa ogwe aka m site na nkwonkwo ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.22",
            "verseOrgIds": [
              "JOB.31.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na atụrụ m egwu mbibi na-esite nʼaka Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:23"
      },
      "items": [
        {
          "text": "nʼihi egwu ebube ya, enweghị m ike ime ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ntụkwasị obi m dị nʼọlaedo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:24"
      },
      "items": [
        {
          "text": "maọbụ na m sị ọlaedo a nụchara anụcha, 'Ị bụ ebe ndabere m.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m ṅụrịrị ọṅụ nʼihi oke akụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:25"
      },
      "items": [
        {
          "text": "ihe nnweta nke aka m ritere nʼuru,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na m legidere anyanwụ anya nʼebube ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:26"
      },
      "items": [
        {
          "text": "maọbụ ọnwa nʼike nchawa ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ga-eme ka obi m bụrụ ihe a rafuru na nzuzo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:27"
      },
      "items": [
        {
          "text": "maọbụ aka m abụrụ ihe e weliri ife ha ofufe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.27",
            "verseOrgIds": [
              "JOB.31.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, ihe ndị a ga-abụ mmehie nke a ga-ekpe ikpe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:28"
      },
      "items": [
        {
          "text": "nʼihi na m gaara abụ onye na-ekwesighị ntụkwasị obi nye Chineke, Onye bi nʼelu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.28",
            "verseOrgIds": [
              "JOB.31.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na m ṅụrịrị ọṅụ nʼihi ọdachi nke dakwasịrị onye iro m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:29"
      },
      "items": [
        {
          "text": "maọbụ chịa ọchị nʼihi nsogbu nke dakwasịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekwebeghị m ka ọnụ m mehie",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:30"
      },
      "items": [
        {
          "text": "megide ha site nʼịbụ ndụ ha ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na o nwebeghị oge ndị nọ nʼezinaụlọ m kwuru okwu sị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:31"
      },
      "items": [
        {
          "text": "'Onye ka ọ bụ nke na-erijubeghị afọ site nʼihe oriri Job na-enye?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.31",
            "verseOrgIds": [
              "JOB.31.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ dịghị onye ọbịa na-anọ ọnọdụ abalị nʼama,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:32"
      },
      "items": [
        {
          "text": "nʼihi ụzọ m na-eghe oghe mgbe ọbụla nye ndị ije.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m na-ezo mmehie m dịka ndị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:33"
      },
      "items": [
        {
          "text": "site nʼizobe mmehie m nʼime obi m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na m tụrụ egwu igwe mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "si otu a, tụọ oke egwu nʼihi nleda anya nke ndị agbụrụ dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "nke mere ka m gbaa nkịtị ghara ịpụ nʼezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
