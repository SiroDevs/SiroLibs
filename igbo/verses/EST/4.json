  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "EST 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mọdekai agwa Esta maka nsogbu ha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mọdekai nụrụ ihe mere, ọ dọwara uwe ya, yikwasị onwe ya akwa mkpe, werekwa ntụ kpokwasị onwe ya, pụọ baa nʼime obodo, na-eti mkpu akwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.1",
            "verseOrgIds": [
              "EST.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bịaruru nʼọnụ ụzọ ama nke ụlọeze guzo nʼebe ahụ, nʼihi na ọ dịghị onye a na-ekwe ka o yiri akwa mkpe banye nʼogige ụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.2",
            "verseOrgIds": [
              "EST.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼalaeze ahụ ndị Juu niile, nọ nʼiru ụjụ na ibu ọnụ na ịkwa akwa na iti aka nʼobi nʼihi iwu eze ahụ. Ọtụtụ yikwa akwa mkpe ha, dinarakwa na ntụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.3",
            "verseOrgIds": [
              "EST.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụmụ agbọghọ na ndị onozi Esta gwara ya ihe banyere Mọdekai, o wutere ya nke ukwuu. O zigaara Mọdekai uwe, ka o nwee ike gbanwee uwe mkpe ahụ o yi, ma ọ naraghị ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.4",
            "verseOrgIds": [
              "EST.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Esta ziri ka a kpọọ Hatak, otu nʼime ndị onozi eze, onye nke ọ bụ ọrụ ya ijere Esta ozi, gwa ya ka o jekwuru Mọdekai jụọ ya ihe kpatara nke a, na ihe mere o ji na-eme otu a.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.5",
            "verseOrgIds": [
              "EST.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatak jere nʼama obodo ahụ ebe ọ hụrụ Mọdekai nʼọnụ ụzọ ụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.6",
            "verseOrgIds": [
              "EST.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mọdekai kọọrọ ya ihe niile, na otu Heman si kwee nkwa ịkwụnye ego nʼụlọakụ eze ka e were laa ndị Juu nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.7",
            "verseOrgIds": [
              "EST.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyekwara ya akwụkwọ iwu eze ebe e dere maka ịla ha nʼiyi, bụ nke akpọsara na Susa, ka o gosi ya Esta, kọwaakwa ya nye ya. Ọ gwara ya ka o nye ya iwu ka ọ bakwuru eze rịọ ya arịrịọ amara, rịọkwa ya ebere nʼihi ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.8",
            "verseOrgIds": [
              "EST.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hatak lọghachiri zie Esta ihe niile Mọdekai kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.9",
            "verseOrgIds": [
              "EST.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Esta gwara Hatak ka o jeghachi gwa Mọdekai sị,",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.10",
            "verseOrgIds": [
              "EST.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụwa niile maara nke ọma na onye ọbụla, maọbụ nwoke maọbụ nwanyị, banyere nʼime ime ụlọeze mgbe eze na-akpọghị ya, ga-anwụ, karịakwa ma eze o setịpụrụ mkpara ọlaedo ya gosi onye ahụ na ọ nabatara ọbịbịa ya. Ugbu a, o meela ihe dị ka otu ọnwa kemgbe eze na-ezibeghị ozi ka a kpọọ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.11",
            "verseOrgIds": [
              "EST.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gwara Mọdekai ihe Esta zara,",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.12",
            "verseOrgIds": [
              "EST.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "o zighachiri ọsịsa a, \"Echela nʼihi na i bi nʼụlọeze na naanị gị ga-afọdụ ndụ nʼetiti ndị Juu niile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.13",
            "verseOrgIds": [
              "EST.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị gba nkịtị nʼoge a, oghere na napụta ndị Juu ga-esite nʼụzọ ọzọ bịa, ma gị onwe gị na ụlọ nna gị ga-ala nʼiyi. Onye makwanụ ihe mere i ji nọrọ nʼụlọeze nʼoge dị otu a?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Esta zara Mọdekai sị;",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa kpọkọtaa ndị Juu niile bi na Susa, bukwaaranụ m ọnụ. Unu erila ihe ọbụla, maọbụ ṅụọ ihe ọbụla abalị atọ, ehihie na abalị. Mụ onwe m kwa, na ụmụ agbọghọ na-ejere m ozi, ga-emekwa otu ihe ahụ. Emesịa, ọ bụ ezie na ọ bụ ihe megidere iwu, ma aga m aga hụ eze anya. Ihe ọ pụtara ya pụta. Ọ pụtara m ọnwụ, ka m nwụọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mọdekai pụrụ, gaa mee dịka Esta gwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
    }
  ],
