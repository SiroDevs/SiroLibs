  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "EST 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị iri na atọ nke ọnwa iri na abụọ, nke bụ ọnwa Ada, bụ ụbọchị a gaara emezu iwu ahụ eze nyere. Nʼụbọchị a, ndị iro ndị Juu lere anya na ha ga-ekpochapụ ha. Ma ugbu a, a tụgharịala iwu ahụ, mee ya ka ọ bụrụ ihe megidere ndị ahụ kpọrọ ndị Juu asị.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.1",
            "verseOrgIds": [
              "EST.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juu chịkọtara onwe ha ọnụ nʼobodo niile dị nʼalaeze eze Sekses, maka ịzọ ndụ ha. Ma o nweghị onye ọbụla pụrụ imegide ha, nʼihi na egwu ha dakwasịrị ndị obodo niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.2",
            "verseOrgIds": [
              "EST.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi ọchịchị obodo niile, ndị na-anọchite anya eze, na ndịisi, na ndị ozi eze, nyeere ndị Juu aka, nʼihi na ha tụrụ egwu Mọdekai.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.3",
            "verseOrgIds": [
              "EST.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Mọdekai bụ onye a ma ama nʼụlọeze, ọ bụkwa onye a maara aha ya nʼalaeze ahụ niile, nʼihi na ike ọchịchị ya na-abawanye ụba karịa ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.4",
            "verseOrgIds": [
              "EST.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere, na ndị Juu ji mma agha gbuo, ma bibie ndị iro ha niile. Ha mesoro ndị kpọrọ ha asị mmeso ọbụla masịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.5",
            "verseOrgIds": [
              "EST.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime obodo ahụ e wusiri ike bụ Susa, ndị Juu gburu narị ndị ikom ise laa ha nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.6",
            "verseOrgIds": [
              "EST.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gbukwara Pashandata, Dalfon, Aspata,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.7",
            "verseOrgIds": [
              "EST.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Porata, Adalia, Aridata,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.8",
            "verseOrgIds": [
              "EST.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamashta, Arisai Aridai na Vaizata,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.9",
            "verseOrgIds": [
              "EST.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha bụkwa ụmụ ndị ikom iri Heman nwa Hamedata, onye iro ndị Juu mụtara. Ma ha emetụghị akụnụba ha aka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.10",
            "verseOrgIds": [
              "EST.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, a gwara eze ọnụọgụgụ ndị e gburu nʼobodo Susa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.11",
            "verseOrgIds": [
              "EST.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sịrị Esta bụ nwunye eze, \"Ndị Juu egbuola narị mmadụ ise nʼobodo Susa, gbukwaa ụmụ ndị ikom Heman iri. Ebe ha mere otu a nʼebe a, onye ma ihe ha mere nʼobodo dị iche iche nʼalaeze m? Ugbu a, gịnị ọzọ bụ arịrịọ gị? A ga-emezuru gị ya. Gịnị ọzọ bụ ihe ị chọrọ? A ga-emekwa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.12",
            "verseOrgIds": [
              "EST.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta sịrị, \"Ọ bụrụ na ọ dị eze mma, ka ndị Juu bi na Susa meekwa ihe ha mere taa echi, ka a kwụbakwa ụmụ ndị ikom iri Heman nʼelu osisi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.13",
            "verseOrgIds": [
              "EST.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze kwenyere, a kụkwara ya dịka ekwe na Susa, a kwụbara ụmụ iri Heman nʼelu osisi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.14",
            "verseOrgIds": [
              "EST.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juu bi na Susa chịkọtakwara onwe ha ọnụ nʼụbọchị iri na anọ nke ọnwa Ada, gbuo narị mmadụ atọ ọzọ nʼobodo Susa. Ma ha emetụghị akụnụba ndị ahụ aka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.15",
            "verseOrgIds": [
              "EST.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Juu ndị ọzọ bi nʼobodo ndị ọzọ dị iche iche eze na-achị, jikọtakwara onwe ha ọnụ ịzọ ndụ ha, site otu a nwere onwe ha pụọ nʼaka ndị iro ha. Ha gburu iri puku mmadụ asaa na ise bụ ndị kpọrọ ha asị, ma ha emetụghị akụnụba ha aka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.16",
            "verseOrgIds": [
              "EST.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mere ihe ndị a nʼabalị iri na atọ nke ọnwa Ada,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        },
        {
          "text": "ha zukwara ike nʼụbọchị so ya bụ abalị iri na anọ. Ha mere ụbọchị ahụ, ụbọchị ọṅụ na nke oriri na ọṅụṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.17",
            "verseOrgIds": [
              "EST.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Juu nọ na Susa zukọtara nʼụbọchị nke iri na atọ, na nʼụbọchị nke iri na anọ. Emesịa, nʼụbọchị nke iri na ise ha zuru ike, mekwa ya ụbọchị ọṅụ na nke oriri na ọṅụṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.18",
            "verseOrgIds": [
              "EST.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere ndị Juu niile bi nʼime ime obodo ji eme mmemme ọṅụ na nke oriri na ọṅụṅụ nʼabalị iri na anọ nke ọnwa iri na abụọ nke afọ ọbụla. Ha mere ụbọchị ahụ ka ọ bụrụkwa ụbọchị inyerịta onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.19",
            "verseOrgIds": [
              "EST.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmemme Purim",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Mọdekai dere ihe ndị a niile nʼakwụkwọ, zigakwara ndị Juu niile nọ nʼokpuru ọchịchị eze Sekses, ma ndị nọ nso ma ndị nọ nʼebe dị anya,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.20",
            "verseOrgIds": [
              "EST.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ha na-eme mmemme a kwa afọ nʼụbọchị nke iri na anọ na nke iri na ise nke ọnwa Ada ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.21",
            "verseOrgIds": [
              "EST.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ iji gosi mgbe ndị Juu nweere onwe ha site nʼaka ndị iro ha, na iji cheta mgbe iru ụjụ ha ghọrọ ọṅụ, na mgbe ịkwa akwa ha ghọrọ ụbọchị mmemme ọṅụ. O deere ha ka ha debe ụbọchị ndị a dịka ụbọchị mmemme ọṅụ na oriri na ọṅụṅụ, na inyerịta onwe ha onyinye ihe oriri na inye ụmụ ogbenye onyinye dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.22",
            "verseOrgIds": [
              "EST.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EST 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị Juu kwenyere ịga nʼihu ime mmemme a nke ha malitere ime, dịka Mọdekai si deere ha ya,",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.23",
            "verseOrgIds": [
              "EST.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EST 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi na Heman nwa Hamedata, onye Agag, onye iro ndị Juu niile, kpebiri ịla ha nʼiyi nʼụbọchị ahụ ọ tụpụtara site nʼife nza.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.24",
            "verseOrgIds": [
              "EST.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EST 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe izu ọjọọ a ruru eze ntị, o nyere iwu nke e debanyere nʼakwụkwọ sị, ka echiche ọjọọ nke Heman megide ndị Juu tụgharịa nʼisi ya, ọ kwukwara ka akwụgbuo ya na ụmụ ndị ikom niile nʼelu osisi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.25",
            "verseOrgIds": [
              "EST.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EST 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, a kpọrọ ụbọchị ndị ahụ Purim nke sitere na mkpụrụ okwu Pur. Nʼihi ihe niile e dere nʼakwụkwọ ahụ na nke ha hụkwara na nke mekwaara ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.26",
            "verseOrgIds": [
              "EST.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EST 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juu niile kwekọrịtara idebe mmemme a, na imekwa ka ụmụ ha, na ndị niile kwenyere iso ha, na-emekwa ya. Ha kpebiri na ha ga-edebe ụbọchị abụọ ndị ahụ kwa afọ, nʼụzọ nakwa oge e zubere ka ọ bụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.27",
            "verseOrgIds": [
              "EST.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EST 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga na-echeta ụbọchị ndị a, na-eme kwa ya nʼọgbọ niile ọbụla, nʼezinaụlọ ọbụla, nʼala ọbụla a na-achị nakwa obodo ọbụla. Ndị Juu aghaghị idebe mmemme ụbọchị Purim, ma ọ bụkwanụ ncheta ụbọchị ndị a apụọ nʼobi ọgbọ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.28",
            "verseOrgIds": [
              "EST.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EST 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Esta nwunye eze, nwa Abihail, na Mọdekai onye Juu jikọtara aka dee akwụkwọ ọzọ nke e ji mesie akwụkwọ ahụ Mọdekai dere ike, maka ịmalite mmemme Purim.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.29",
            "verseOrgIds": [
              "EST.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EST 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mọdekai zipụrụ akwụkwọ ozi nke okwu udo na eziokwu",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "text": "dị nʼime ya, nye ndị Juu niile bi nʼime mpaghara alaeze Sekses, nke dị otu narị na iri abụọ na asaa (127).",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.30",
            "verseOrgIds": [
              "EST.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EST 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji akwụkwọ a mesie okwu ahụ ike na a ga-edebe ụbọchị ndị ahụ kwa afọ maka mmemme Purim dịka Mọdekai onye Juu na Esta nwunye eze nyere nʼiwu. Ndị Juu niile na ụmụ ụmụ ha ga-eme mmemme a nʼoge a kara aka, dịka ha si edebe iwu ndị ọzọ metụtara oge ibu ọnụ na oge iru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.31",
            "verseOrgIds": [
              "EST.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EST 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu a Esta nyere mesịrị ụkpụrụ mmemme Purim ike. E dekwara ya nʼakwụkwọ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.9.32",
            "verseOrgIds": [
              "EST.9.32"
            ]
          }
        }
      ]
    }
