      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:21"
      },
      "items": [
        {
          "text": "zọpụta m site na mpi atụ ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.21",
            "verseOrgIds": [
              "PSA.22.22"
            ]
          }
        }
      ]
    },
