      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:17"
      },
      "items": [
        {
          "text": "ndị mmadụ na-ele m anya na-emikwa ọnụ ọchị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.17",
            "verseOrgIds": [
              "PSA.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
