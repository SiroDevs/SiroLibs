          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ekwupụta aha gị nye ụmụnna m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.22",
            "verseOrgIds": [
              "PSA.22.23"
            ]
          }
        }
      ]
