      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:16"
      },
      "items": [
        {
          "text": "otù ndị na-eme ihe ọjọọ agbaala m gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
    {
