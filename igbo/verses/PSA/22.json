      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:24"
      },
      "items": [
        {
          "text": "kama mgbe ọ kpọkuru ya, ọ nụrụ olu akwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
