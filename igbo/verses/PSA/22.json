      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:26"
      },
      "items": [
        {
          "text": "ndị niile na-achọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.26",
                "verseOrgIds": [
                  "PSA.22.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eto ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        }
