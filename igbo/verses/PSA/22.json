      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:23"
      },
      "items": [
        {
          "text": "unu bụ ndị agbụrụ Jekọb, sọpụrụnụ ya!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
