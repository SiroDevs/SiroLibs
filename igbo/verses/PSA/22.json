        {
          "text": "Ma gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.19",
            "verseOrgIds": [
              "PSA.22.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.19",
                "verseOrgIds": [
                  "PSA.22.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", anọla m ebe dị anya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.19",
            "verseOrgIds": [
              "PSA.22.20"
            ]
          }
        }
      ]
    },
    {
