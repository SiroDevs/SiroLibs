          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ nkịta agbaala m gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
