          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o ledaghị ahụhụ onye a na-akpagbu anya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
