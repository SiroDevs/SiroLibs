      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:25"
      },
      "items": [
        {
          "text": "aga m emezukwa nkwa niile m kwere gị nʼihu ndị ahụ na-atụ egwu gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.25",
            "verseOrgIds": [
              "PSA.22.26"
            ]
          }
        }
      ]
    },
    {
