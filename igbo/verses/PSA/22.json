          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiokwu otuto m nʼetiti ọha mmadụ sitere na gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.25",
            "verseOrgIds": [
              "PSA.22.26"
            ]
          }
        }
      ]
    },
