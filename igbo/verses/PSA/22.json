          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ogbenye ga-eri nri, rijuo afọ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.26",
            "verseOrgIds": [
              "PSA.22.27"
            ]
          }
        }
      ]
    },
