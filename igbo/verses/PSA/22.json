          "type": "text",
          "attrs": {
            "verseId": "PSA.22.27",
            "verseOrgIds": [
              "PSA.22.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
