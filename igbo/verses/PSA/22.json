      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:16"
      },
      "items": [
        {
          "text": "ha adupuola m aka m na ụkwụ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.16",
            "verseOrgIds": [
              "PSA.22.17"
            ]
          }
        }
      ]
    },
    {
