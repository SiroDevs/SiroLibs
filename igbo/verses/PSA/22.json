  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PSA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma dịrị onyeisi abụ. Nʼusoro olu abụ nke \"Nne ele nke ụtụtụ.\" Abụ Ọma Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwa na abụ ekele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke m, Chineke m, gịnị mere i jiri hapụ m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "Gịnị mere i ji nọ ebe dị anya ịzọpụta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "nʼebe dị anya site nʼịsụ ude m niile?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke m, ana m akpọku gị nʼehihie, ma ị dịghị aza m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "nʼabalị kwa, ma ọ dịghị izuike m nwere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, i nọ nʼocheeze gị dịka Onye ahụ dị Nsọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "ị bụ otuto ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna anyị ha tụkwasịrị gị obi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "ha tụkwasịrị gị obi, ị zọpụtakwara ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọkuru gị si otu a bụrụ ndị a zọpụtara;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "ihere emeghị ha nʼihi na ha tụkwasịrị gị obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ m idide, abụghị m mmadụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "onye ndị ọzọ na-akwa emo, onye ndị mmadụ na-eleda anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile hụrụ m na-achị m ọchị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:7"
      },
      "items": [
        {
          "text": "na-emiri m ọnụ ịkwa emo, na-efufekwa isi ha na-asị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"O na-atụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.8",
                "verseOrgIds": [
                  "PSA.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "obi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.8",
                "verseOrgIds": [
                  "PSA.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bịa gbapụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "Ya napụta ya ebe ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "na ihe ya masịrị ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.9",
                "verseOrgIds": [
                  "PSA.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ bụ gị wepụtara m site nʼafọ nne m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "Ọ bụ gị mere ka m tụkwasị gị obi, ọ bụladị mgbe m ka na-aṅụ ara.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge amụrụ m ka e nyefere m nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:10"
      },
      "items": [
        {
          "text": "Site nʼafọ nne m, ka gị onwe gị bụ Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọla m ebe dị anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "nʼihi na nsogbu dị nso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "Ọ dịkwaghị onye inyeaka nọ nso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ oke ehi gbara m gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "oke ehi dị ike nke Bashan",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        },
        {
          "text": "gbara m gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọdụm ndị na-agbọ ụja mgbe ha na-adọgbu anụ ọhịa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "text": "asaghepụla ọnụ ha megide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "A wụpụla m dịka mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "ọkpụkpụ m niile apụkwaala nʼọnọdụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Obi m agbazela dịka mmanụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "obi ịlọ mmiri ewerela ọnọdụ nʼime m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike ọbụla adịghịkwa m nʼahụ, dịka a ga-asị na m bụ ụrọ nke anwụ mịkọọrọ mmiri dị ya nʼime.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "Ire m na-araparakwa m nʼọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "nʼihi na ị tọgbọrọ m nʼọnụ ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
