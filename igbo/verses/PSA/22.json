          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PSA 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbapụta m site nʼọnụ ọdụm ndị a,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.21",
            "verseOrgIds": [
              "PSA.22.22"
            ]
          }
        }
      ]
    },
