            "sid": "PSA 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eke uwe m nʼetiti ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.18",
            "verseOrgIds": [
              "PSA.22.19"
            ]
          }
        }
      ]
