      "attrs": {
        "style": "q2",
        "vid": "PSA 22:24"
      },
      "items": [
        {
          "text": "maọbụ kwaa ya emo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
