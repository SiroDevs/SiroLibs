      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:24"
      },
      "items": [
        {
          "text": "o lefughị ya anya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.24",
            "verseOrgIds": [
              "PSA.22.25"
            ]
          }
        }
      ]
    },
