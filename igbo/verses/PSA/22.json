      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:23"
      },
      "items": [
        {
          "text": "Tụọnụ ya egwu, unu agbụrụ Izrel!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
