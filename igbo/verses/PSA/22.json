          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A pụrụ ịgụta ọkpụkpụ m niile ọnụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.17",
            "verseOrgIds": [
              "PSA.22.18"
            ]
          }
        }
      ]
    },
    {
