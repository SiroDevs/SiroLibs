      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:19"
      },
      "items": [
        {
          "text": "gị Onye bụ ike m, mee ngwangwa bịa nyere m aka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.19",
            "verseOrgIds": [
              "PSA.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PSA 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napụta ndụ m site na mma agha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.20",
            "verseOrgIds": [
              "PSA.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:20"
      },
      "items": [
        {
          "text": "site nʼike ụmụ nkịta, napụta ndụ m nke dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.20",
            "verseOrgIds": [
              "PSA.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
