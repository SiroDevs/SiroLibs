          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsọtụ elu ụwa niile ga-echeta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.27",
            "verseOrgIds": [
              "PSA.22.28"
            ]
          }
        }
