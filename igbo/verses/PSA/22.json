      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:18"
      },
      "items": [
        {
          "text": "ha sitere nʼife nza kee uwe m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.18",
            "verseOrgIds": [
              "PSA.22.19"
            ]
          }
        }
      ]
    },
    {
