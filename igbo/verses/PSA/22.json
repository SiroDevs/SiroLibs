      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:22"
      },
      "items": [
        {
          "text": "nʼetiti ọha mmadụ aga m enye gị otuto.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.22",
            "verseOrgIds": [
              "PSA.22.23"
            ]
          }
        }
      ]
    },
    {
