          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toonu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.23",
                "verseOrgIds": [
                  "PSA.22.24"
                ]
              }
            }
          ]
        },
        {
          "text": "! Unu niile bụ ndị na-atụ egwu ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.23",
            "verseOrgIds": [
              "PSA.22.24"
            ]
          }
        }
      ]
    },
