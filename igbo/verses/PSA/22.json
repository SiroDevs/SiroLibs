              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.22.27",
                "verseOrgIds": [
                  "PSA.22.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
