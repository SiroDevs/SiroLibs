            "sid": "PSA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duo m nʼeziokwu gị, kuzikwaara m ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
        {
          "text": "nʼihi na ị bụ Chineke, onye Nzọpụta m, ụbọchị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.5",
            "verseOrgIds": [
              "PSA.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:5"
      },
      "items": [
