          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke m, ọ bụ gị ka m tụkwasịrị obi m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "Ekwela ka ihere mee m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:2"
      },
      "items": [
        {
          "text": "ekwekwala ka ndị iro m merie m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.2",
            "verseOrgIds": [
              "PSA.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
