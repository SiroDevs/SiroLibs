          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihere agaghị eme",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "onye ọbụla olileanya ya dị na gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "ma ihere ga-eme ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:3"
      },
      "items": [
        {
          "text": "bụ ndị niile ịghọ aghụghọ jụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.3",
            "verseOrgIds": [
              "PSA.25.3"
            ]
          }
        }
      ]
    },
