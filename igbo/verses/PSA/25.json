          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye dị mma na onye ezi omume ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.8",
            "verseOrgIds": [
              "PSA.25.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.25.8",
                "verseOrgIds": [
                  "PSA.25.8"
                ]
              }
            }
          ]
        },
