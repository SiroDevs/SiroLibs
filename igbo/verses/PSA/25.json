          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echetala mmehie m mere nʼokorobịa m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "ya na nnupu isi m niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 25:7"
      },
      "items": [
        {
          "text": "Kama site nʼịhụnanya gị cheta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.7",
            "verseOrgIds": [
              "PSA.25.7"
            ]
          }
        }
      ]
    },
