        "vid": "PSA 25:10"
      },
      "items": [
        {
          "text": "nye ndị niile na-edebe iwu ọgbụgba ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.10",
            "verseOrgIds": [
              "PSA.25.10"
            ]
