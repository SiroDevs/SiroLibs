        {
          "text": "Ọ na-edu ndị dị umeala nʼobi nʼụzọ ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.25.9",
            "verseOrgIds": [
              "PSA.25.9"
            ]
