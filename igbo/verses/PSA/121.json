          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼezie onye na-eche Izrel nche",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
    },
