        {
          "text": "ga-edebe gị ka ihe ọjọọ ọbụla ghara ịdakwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.7",
            "verseOrgIds": [
              "PSA.121.7"
