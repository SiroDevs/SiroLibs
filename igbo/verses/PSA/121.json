          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyeaka m na-esite nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.2",
                "verseOrgIds": [
                  "PSA.121.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
    {
