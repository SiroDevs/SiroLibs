      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:2"
      },
      "items": [
        {
          "text": "onye kere eluigwe na ụwa bịa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.2",
            "verseOrgIds": [
              "PSA.121.2"
            ]
          }
        }
      ]
    },
