          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.121.8",
                "verseOrgIds": [
                  "PSA.121.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-echebe gị mgbe ị na-apụ na mgbe ị na-abata abata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.8",
            "verseOrgIds": [
              "PSA.121.8"
            ]
          }
        }
      ]
