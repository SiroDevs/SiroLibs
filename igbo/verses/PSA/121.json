      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 121:4"
      },
      "items": [
        {
          "text": "adịghị arahụ ụra, ọ dịghị atụkwa oru ụra.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.121.4",
            "verseOrgIds": [
              "PSA.121.4"
            ]
          }
        }
      ]
