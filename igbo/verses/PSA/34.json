        "sid": "PSA 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Devid. Mgbe ọ gbanwere omume ya mee ka onye na-ayị ara nʼihu Abimelek, onye nke chụpụrụ ya, ya a pụọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke dị mma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.1",
                "verseOrgIds": [
                  "PSA.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": "mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:1"
      },
      "items": [
        {
          "text": "Mgbe niile ka otuto ya ga-adị nʼọnụ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.1",
            "verseOrgIds": [
              "PSA.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m ga-anya isi na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.2",
                "verseOrgIds": [
                  "PSA.34.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:2"
      },
      "items": [
        {
          "text": "ka ndị niile a na-akpagbu gee ntị ṅụrịa ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.2",
            "verseOrgIds": [
              "PSA.34.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soro m too",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.3",
                "verseOrgIds": [
                  "PSA.34.4"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:3"
      },
      "items": [
        {
          "text": "ka anyị bulie aha ya elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.3",
            "verseOrgIds": [
              "PSA.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na etikuru m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.4",
                "verseOrgIds": [
                  "PSA.34.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mkpu akwa, ọ zakwara m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:4"
      },
      "items": [
        {
          "text": "napụta m site nʼaka ịtụ ụjọ m niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.4",
            "verseOrgIds": [
              "PSA.34.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihu ndị na-elekwasị ya anya na-enwu dịka ihe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:5"
      },
      "items": [
        {
          "text": "ihere adịghị eme ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.5",
            "verseOrgIds": [
              "PSA.34.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ogbenye a kpọkuru",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.6",
                "verseOrgIds": [
                  "PSA.34.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ zakwara ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:6"
      },
      "items": [
        {
          "text": "ọ zọpụtara ya site na nsogbu ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.6",
            "verseOrgIds": [
              "PSA.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.7",
                "verseOrgIds": [
                  "PSA.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na-agba ndị niile na-atụ egwu ya gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:7"
      },
      "items": [
        {
          "text": "na-anapụtakwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.7",
            "verseOrgIds": [
              "PSA.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri aka gị tulee ma hụkwa na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.8",
                "verseOrgIds": [
                  "PSA.34.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dị mma;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:8"
      },
      "items": [
        {
          "text": "onye a gọziri agọzi ka onye ahụ bụ, onye nke na-agbaba nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.8",
            "verseOrgIds": [
              "PSA.34.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụọnụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.9",
                "verseOrgIds": [
                  "PSA.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu ndị nsọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:9"
      },
      "items": [
        {
          "text": "nʼihi na ọ dịghị ihe na-akọ ndị niile na-atụ egwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.9",
            "verseOrgIds": [
              "PSA.34.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agụụ nwere ike ịgụ ụmụ ọdụm, ike pụkwara ịgwụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:10"
      },
      "items": [
        {
          "text": "ma ihe ọbụla bụ ihe ọma agaghị akọ ndị niile na-achọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.10",
                "verseOrgIds": [
                  "PSA.34.11"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.10",
            "verseOrgIds": [
              "PSA.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ m, bịanụ gee m ntị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:11"
      },
      "items": [
        {
          "text": "aga m ezi unu ihe ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.34.11",
                "verseOrgIds": [
                  "PSA.34.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.11",
            "verseOrgIds": [
              "PSA.34.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nʼime unu hụrụ ndụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 34:12"
      },
      "items": [
        {
          "text": "ma nwee ọchịchọ ihu ọtụtụ ụbọchị ndị dị mma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.12",
            "verseOrgIds": [
              "PSA.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "chezie ire gị ka ọ ghara ikwu ihe ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.34.13",
