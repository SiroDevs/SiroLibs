      "attrs": {
        "style": "q2",
        "vid": "PSA 135:5"
      },
      "items": [
        {
          "text": "na Onyenwe anyị dị ukwuu karịa chi niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.135.5",
            "verseOrgIds": [
              "PSA.135.5"
            ]
