        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.1",
                "verseOrgIds": [
                  "PSA.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ìhè",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        },
        {
          "text": "m na nzọpụta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "onye ka m ga-atụ egwu ya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.1",
                "verseOrgIds": [
                  "PSA.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ebe siri ike nke ndụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:1"
      },
      "items": [
        {
          "text": "ọ bụkwa onye ka m ga-atụ egwu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.1",
            "verseOrgIds": [
              "PSA.27.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị na-eme ihe ọjọọ busoro m agha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "ka ha ripịa anụ ahụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "ọ bụ ndị iro m na ndị kpọrọ m asị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:2"
      },
      "items": [
        {
          "text": "bụ ndị ga-asọ ngọngọ ma dakwaa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.2",
            "verseOrgIds": [
              "PSA.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na usuu ndị agha agbaa m gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "obi m agaghị atụ ụjọ ọbụla;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "ọ bụladị na agha adaa imegide m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:3"
      },
      "items": [
        {
          "text": "nʼoge ahụ, ka m ga-enwe ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.3",
            "verseOrgIds": [
              "PSA.27.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị otu ihe ka m rịọrọ nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.4",
                "verseOrgIds": [
                  "PSA.27.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "nke ahụ bụkwa ihe m na-achọsi ike;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ka m biri nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.4",
                "verseOrgIds": [
                  "PSA.27.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "ụbọchị niile nke ndụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "na ka m lekwasị ịma mma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.4",
                "verseOrgIds": [
                  "PSA.27.4"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:4"
      },
      "items": [
        {
          "text": "na ka m chọọ ya nʼime ụlọnsọ ukwuu ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.4",
            "verseOrgIds": [
              "PSA.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼụbọchị nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "ọ ga-echebe m nʼime ebe obibi ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "ọ ga-ezo m nʼime ụlọ ikwu ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:5"
      },
      "items": [
        {
          "text": "ma bulie m elu, debe m nʼelu oke nkume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.5",
            "verseOrgIds": [
              "PSA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, a ga-eweli isi m elu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "karịa ndị iro m gbara m gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "aga m eji iti mkpu ọṅụ, chụọ aja nʼụlọ ikwu ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:6"
      },
      "items": [
        {
          "text": "aga m abụ abụ, kụọ egwu nye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.6",
                "verseOrgIds": [
                  "PSA.27.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.6",
            "verseOrgIds": [
              "PSA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị mgbe m na-akpọku gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.7",
                "verseOrgIds": [
                  "PSA.27.7"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:7"
      },
      "items": [
        {
          "text": "Meere m ebere, zaa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.7",
            "verseOrgIds": [
              "PSA.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi m na-ekwu banyere gị, \"Chọọ ihu ya!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 27:8"
      },
      "items": [
        {
          "text": "Ihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.27.8",
                "verseOrgIds": [
                  "PSA.27.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", ka m ga-achọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.27.8",
            "verseOrgIds": [
              "PSA.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezonarịla m ihu gị,",
          "type": "text",
          "attrs": {
