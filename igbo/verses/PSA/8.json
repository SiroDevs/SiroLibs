        "sid": "PSA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma dịrị onyeisi abụ. Abụ Ọma Devid nʼusoro gittit.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdị ebube Chineke na nsọpụrụ nke mmadụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.8.1",
                "verseOrgIds": [
                  "PSA.8.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "lee ka ịdị ukwuu nke aha gị si jupụta ụwa niile!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 8:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "I meela ka ebube gị dị elu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:1"
      },
      "items": [
        {
          "text": "nʼime eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.1",
            "verseOrgIds": [
              "PSA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼotuto",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        },
        {
          "text": "ụmụntakịrị na ụmụ na-aṅụ ara,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "ị tọọla ntọala siri ike megide ndị iro gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:2"
      },
      "items": [
        {
          "text": "ka e si otu a mechie ọnụ onye iro na onye ahụ na-abọ ọbọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.2",
            "verseOrgIds": [
              "PSA.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla m lere anya na mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "hụ ọrụ niile nke aka gị rụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "mgbe m lere anya nʼelu hụ ọnwa na kpakpando",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:3"
      },
      "items": [
        {
          "text": "i tinyere nʼọnọdụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.3",
            "verseOrgIds": [
              "PSA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gịnị ka mmadụ bụ i ji na-eche banyere ha?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:4"
      },
      "items": [
        {
          "text": "Gịnịkwa ka mmadụ bụ iji na-elekọta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        },
        {
          "text": "ha?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.4",
            "verseOrgIds": [
              "PSA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mere ka ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        },
        {
          "text": "dị ala nwantakịrị nʼebe ndị mmụọ ozi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        },
        {
          "text": "nọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:5"
      },
      "items": [
        {
          "text": "I jikwa ebube na nsọpụrụ kpube ya nʼisi dịka okpueze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.5",
            "verseOrgIds": [
              "PSA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mekwaala ya ka ọ bụrụ onyeisi nke ihe niile i kere eke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:6"
      },
      "items": [
        {
          "text": "tinyekwa ihe niile nʼokpuru ụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.6",
            "verseOrgIds": [
              "PSA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-achị igwe ewu na atụrụ, na ehi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:7"
      },
      "items": [
        {
          "text": "na ụmụ anụ ọhịa ndị ọzọ niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.7",
            "verseOrgIds": [
              "PSA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nnụnụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:8"
      },
      "items": [
        {
          "text": "na azụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 8:8"
      },
      "items": [
        {
          "text": "na anụ ndị ọzọ na-ebi nʼime mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.8.8",
            "verseOrgIds": [
              "PSA.8.9"
            ]
          }
        }
      ]
    },
