          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.1",
                "verseOrgIds": [
                  "PSA.127.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ewughị ụlọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "ndị na-ewu ya na-adọgbu onwe ha nʼọrụ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "Ọ bụrụ na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.1",
                "verseOrgIds": [
                  "PSA.127.1"
                ]
              }
            }
          ]
        },
        {
          "text": "echeghị obodo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:1"
      },
      "items": [
        {
          "text": "nʼefu ka ndị nche na-amụ anya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.1",
            "verseOrgIds": [
              "PSA.127.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 127:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼefu ka ị na-ebili nʼisi ụtụtụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "na-adọgbu onwe gị nʼọrụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "ịchọta ihe ị ga-eri ruo nʼabalị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:2"
      },
      "items": [
        {
          "text": "nʼihi na ọ na-eme ka ndị niile ọ hụrụ nʼanya hie ụra nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.2",
            "verseOrgIds": [
              "PSA.127.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 127:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụntakịrị bụ ihe nketa si nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.127.3",
                "verseOrgIds": [
                  "PSA.127.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:3"
      },
      "items": [
        {
          "text": "ụmụntakịrị bụ ụgwọ ọrụ ọ na-enye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.3",
            "verseOrgIds": [
              "PSA.127.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 127:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka àkụ nʼaka dike nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:4"
      },
      "items": [
        {
          "text": "otu a, ka ụmụ a mụtaara na mgbe okorobịa dị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.4",
            "verseOrgIds": [
              "PSA.127.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 127:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye a gọziri agọzi ka nwoke ahụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:5"
      },
      "items": [
        {
          "text": "onye kpojuru àkụ ndị a nʼakpa àkụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 127:5"
      },
      "items": [
        {
          "text": "Ihere agaghị eme ha mgbe ha na ndị iro",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 127:5"
      },
      "items": [
        {
          "text": "na-arụrịta ụka nʼama.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.127.5",
            "verseOrgIds": [
              "PSA.127.5"
            ]
          }
        }
      ]
    }
