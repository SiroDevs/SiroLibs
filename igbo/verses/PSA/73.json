  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "73",
        "style": "c",
        "sid": "PSA 73"
      },
      "items": [
        {
          "text": "73",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "Nchịkọta Akwụkwọ nke atọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.73-PSA.89"
          },
          "items": [
            {
              "text": "Abụ Ọma 73–89",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 73",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma Asaf.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgwụgwụ nke ndị na-emebi iwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 73:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, Chineke dịịrị Izrel mma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:1"
      },
      "items": [
        {
          "text": "dịkwara ndị obi ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.1",
            "verseOrgIds": [
              "PSA.73.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 73:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mụ onwe m, ọ fọdụrụ nwantịị ka m zọhie ụkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:2"
      },
      "items": [
        {
          "text": "ọ fọdụrụ nwantịị ka ụkwụ m gbụchapụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.2",
            "verseOrgIds": [
              "PSA.73.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 73:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e kwosara m ndị mpako ekworo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:3"
      },
      "items": [
        {
          "text": "mgbe m hụrụ ịba ụba",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        },
        {
          "text": "nke ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.3",
            "verseOrgIds": [
              "PSA.73.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 73:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha anaghị adọgbu onwe ha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:4"
      },
      "items": [
        {
          "text": "ahụ ha gbara abụba, siekwa ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.4",
            "verseOrgIds": [
              "PSA.73.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 73:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsogbu niile mmadụ ibe ha na-enwe adịghị erute ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:5"
      },
      "items": [
        {
          "text": "Ha enweghị mkpa ọbụla nke na-akpa ha dịka ndị ọzọ nwere.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.5",
            "verseOrgIds": [
              "PSA.73.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 73:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, nganga bụ ihe ịnya nʼolu ha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:6"
      },
      "items": [
        {
          "text": "ha jikwa ihe ike kpuchie onwe ha dịka uwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.6",
            "verseOrgIds": [
              "PSA.73.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 73:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmehie na-esite nʼobi ọjọọ ha apụta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:7"
      },
      "items": [
        {
          "text": "echiche ọjọọ ha enweghị ngụta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.7",
            "verseOrgIds": [
              "PSA.73.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 73:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-akwa emo, na-ejikwa iro ekwu okwu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:8"
      },
      "items": [
        {
          "text": "nʼime mpako ha, ha na-aba mba imegbu ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.8",
            "verseOrgIds": [
              "PSA.73.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 73:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji ọnụ ha na-ekwu na eluigwe bụ nke ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:9"
      },
      "items": [
        {
          "text": "ha jikwa ire ha kwuo na ụwa niile bụ nke ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.9",
            "verseOrgIds": [
              "PSA.73.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 73:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ndị ha na-eso ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:10"
      },
      "items": [
        {
          "text": "na-aṅụrụ okwu ha ebe ọ bara ụba dịka mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.10",
            "verseOrgIds": [
              "PSA.73.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 73:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-asị, \"Olee otu Chineke ga-esi mara?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:11"
      },
      "items": [
        {
          "text": "Ọ dịkwanụ ihe Onye kachasị ihe niile elu maara?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.11",
            "verseOrgIds": [
              "PSA.73.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 73:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ndị ajọ omume dị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:12"
      },
      "items": [
        {
          "text": "ha na-ebi ndụ na-enweghị nsogbu; akụnụba ha na-amụbakwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.12",
            "verseOrgIds": [
              "PSA.73.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 73:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, ọ bụ naanị nʼefu ka m debere obi m ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:13"
      },
      "items": [
        {
          "text": "nʼefu ka m kwọrọ aka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        },
        {
          "text": "m abụọ nʼemeghị ihe ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.13",
            "verseOrgIds": [
              "PSA.73.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 73:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogologo ụbọchị niile, anọ m na nsogbu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:14"
      },
      "items": [
        {
          "text": "ụtụtụ niile ka m na-anata ntaramahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.14",
            "verseOrgIds": [
              "PSA.73.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 73:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m kwuru sị, \"Nke a ka m ga-ekwu,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:15"
      },
      "items": [
        {
          "text": "agaara m abụ onye na-ekwesighị ntụkwasị obi nʼetiti ụmụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.15",
            "verseOrgIds": [
              "PSA.73.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 73:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m gbalịrị ịghọta ihe ndị a niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 73:16"
      },
      "items": [
        {
          "text": "ọ ghọọrọ m ihe mwute,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.73.16",
            "verseOrgIds": [
              "PSA.73.16"
