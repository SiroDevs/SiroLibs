              "attrs": {
                "verseId": "PSA.116.7",
                "verseOrgIds": [
                  "PSA.116.7"
                ]
              }
            }
          ]
        },
        {
          "text": "emesola gị mmeso ọma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.7",
            "verseOrgIds": [
              "PSA.116.7"
            ]
          }
