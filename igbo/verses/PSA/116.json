        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.116.1",
                "verseOrgIds": [
                  "PSA.116.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼanya, nʼihi na ọ nụrụ olu m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.1",
            "verseOrgIds": [
              "PSA.116.1"
            ]
          }
        }
      ]
    },
    {
