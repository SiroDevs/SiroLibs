      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:2"
      },
      "items": [
        {
          "text": "aga m akpọku ya oge ndụ m niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.2",
            "verseOrgIds": [
              "PSA.116.2"
            ]
          }
        }
      ]
    },
    {
