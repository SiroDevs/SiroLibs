      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 116:8"
      },
      "items": [
        {
          "text": "anya m site na anya mmiri akwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.116.8",
            "verseOrgIds": [
              "PSA.116.8"
            ]
          }
