{
  "id": "PSA.75",
  "number": "75",
  "bookId": "PSA",
  "reference": "Abụ Ọma 75",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "75",
        "style": "c",
        "sid": "PSA 75"
      },
      "items": [
        {
          "text": "75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Nke olu abụ \"E bibikwala.\" Abụ Ọma Asaf. Otu Abụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ikpe ziri ezi nke Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 75:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị na-eto gị, O Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "Anyị na-eto gị, nʼihi na aha gị dị nso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "Ndị mmadụ na-ekwu banyere ọrụ ebube gị dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 75:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-asị, \"Ana m ahọpụta oge a kara aka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "Ọ bụ m na-ekpe ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 75:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụwa na mmadụ niile bi nʼime ya na-ama jijiji,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "text": "ọ bụ m na-ejidesi ogidi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        },
        {
          "text": "ya ike ka o guzo chịm.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.3",
                "verseOrgIds": [
                  "PSA.75.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 75:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ndị mpako, ana m asị, 'Unu etukwala ọnụ ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "nye ndị ajọ omume, ana m asị, Unu ewelila mpi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        },
        {
          "text": "unu elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 75:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ewelila mpi unu megide eluigwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:5"
      },
      "items": [
        {
          "text": "unu ejila nnupu isi kwuo okwu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 75:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye ọbụla sitere nʼọwụwa anyanwụ, maọbụ nʼọdịda anyanwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:6"
      },
      "items": [
        {
          "text": "maọbụ nʼọzara nke pụrụ ibuli mmadụ elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 75:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ọ bụ Chineke, onye na-ekpe ikpe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:7"
      },
      "items": [
        {
          "text": "ọ na-eweli otu onye elu, wedakwa onye ọzọ ala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 75:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu iko dị nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.8",
                "verseOrgIds": [
                  "PSA.75.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "nke jupụtara na mmanya na-agba ụfụfụ nke a gwanyekọtara ụda dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "Ọ na-awụpụ ya, ndị ajọ omume niile nke ụwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "na-aṅụ ya ruo mgbe ọ gwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 75:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mụ onwe m, aga m ekwupụta nke a ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:9"
      },
      "items": [
        {
          "text": "Aga m abụku Chineke nke Jekọb abụ otuto,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 75:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ onye sịrị, \"Aga m ebipụ mpi ndị ajọ omume niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:10"
      },
      "items": [
        {
          "text": "ma a ga-ebuli mpi ndị ezi omume elu.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "PSA.76",
    "number": "76",
