      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "buru mkpụrụ ubi ọ ga-agha na-aga,",
          "type": "text",
          "attrs": {
