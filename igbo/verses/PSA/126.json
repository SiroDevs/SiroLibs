      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "ga-emesịa jiri abụ ọṅụ na-alọghachi azụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
          }
        }
      ]
