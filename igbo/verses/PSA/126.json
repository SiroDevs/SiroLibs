      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:6"
      },
      "items": [
        {
          "text": "mgbe ha bu ukwu ọka ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.6",
            "verseOrgIds": [
              "PSA.126.6"
            ]
