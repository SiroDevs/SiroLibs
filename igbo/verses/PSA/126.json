      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:1"
      },
      "items": [
        {
          "text": "anyị dị ka ndị na-arọ nrọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.1",
            "verseOrgIds": [
              "PSA.126.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
