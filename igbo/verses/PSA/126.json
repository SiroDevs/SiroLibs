      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "abụ ọṅụ jukwara anyị ire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 126:2"
      },
      "items": [
        {
          "text": "Mgbe ahụ, e kwukwara ya na mba niile sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.126.2",
            "verseOrgIds": [
              "PSA.126.2"
            ]
