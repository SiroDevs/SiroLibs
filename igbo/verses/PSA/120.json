      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ nrigo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere maka nnapụta",
          "type": "text"
        }
      ]
    },
    {
