      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:1"
      },
      "items": [
        {
          "text": "nʼihe niile bụ ndị ọ gbakụtara azụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
        }
      ]
    },
    {
