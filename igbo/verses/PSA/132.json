          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ṅụrụ iyi nye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.2",
                "verseOrgIds": [
                  "PSA.132.2"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:2"
      },
      "items": [
        {
          "text": "kwee nkwa nye Onye dị ukwuu nke Jekọb:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.2",
            "verseOrgIds": [
              "PSA.132.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 132:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Agaghị m abanye nʼime ụlọ m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:3"
      },
      "items": [
        {
          "text": "maọbụ rigoo nʼihe ndina m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.3",
            "verseOrgIds": [
              "PSA.132.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 132:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "agaghị m arahụ ụra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:4"
      },
      "items": [
        {
          "text": "egbugbere anya m agaghị atụ oru ụra,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.4",
            "verseOrgIds": [
              "PSA.132.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 132:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "tutu ruo mgbe m chọtaara",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.5",
                "verseOrgIds": [
                  "PSA.132.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ọnọdụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:5"
      },
      "items": [
        {
          "text": "ebe obibi nye Onye dị ukwuu nke Jekọb.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.5",
            "verseOrgIds": [
              "PSA.132.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 132:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nụrụ ihe banyere ya nʼEfrata,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:6"
      },
      "items": [
        {
          "text": "anyị chọtara ya nʼubi niile nke Jearim.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.6",
            "verseOrgIds": [
              "PSA.132.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 132:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ka anyị gaa na-ebe obibi ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:7"
      },
      "items": [
        {
          "text": "ka anyị kpọọ isiala nʼebe ihe mgbakwasị ụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.7",
            "verseOrgIds": [
              "PSA.132.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 132:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Bilie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.8",
                "verseOrgIds": [
                  "PSA.132.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", bata nʼebe izuike gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:8"
      },
      "items": [
        {
          "text": "gị na igbe ọgbụgba ndụ nke ike gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.8",
            "verseOrgIds": [
              "PSA.132.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 132:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndị nchụaja gị yiri ezi omume gị dịka uwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:9"
      },
      "items": [
        {
          "text": "ka ndị gị kwesiri ntụkwasị obi bụọ abụ nʼihi ọṅụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.9",
            "verseOrgIds": [
              "PSA.132.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 132:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ohu gị, bụ Devid,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:10"
      },
      "items": [
        {
          "text": "agbakụtala onye gị e tere mmanụ azụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.10",
            "verseOrgIds": [
              "PSA.132.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 132:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.11",
                "verseOrgIds": [
                  "PSA.132.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụrụ Devid iyi nʼeziokwu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "bụ iyi nke ọ gaghị esi na ya laghachi azụ:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "\"Otu nʼime ụmụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:11"
      },
      "items": [
        {
          "text": "ka m ga-eme ka ọ nọdụ nʼocheeze gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.11",
            "verseOrgIds": [
              "PSA.132.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 132:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na ụmụ ndị ikom gị edebe ọgbụgba ndụ m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "na ụkpụrụ niile m kuziri ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "mgbe ahụ ụmụ ha ga-anọdụ ala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:12"
      },
      "items": [
        {
          "text": "nʼocheeze gị ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.12",
            "verseOrgIds": [
              "PSA.132.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 132:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.132.13",
                "verseOrgIds": [
                  "PSA.132.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọrọla Zayọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 132:13"
      },
      "items": [
        {
          "text": "ọ bụ ọchịchọ obi ya ime ya ebe obibi ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.13",
            "verseOrgIds": [
              "PSA.132.13"
            ]
          }
