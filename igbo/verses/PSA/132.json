                "verseOrgIds": [
                  "PSA.132.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", cheta Devid,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.132.1",
            "verseOrgIds": [
              "PSA.132.1"
            ]
          }
