    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid na igbe ọgbụgba ndụ Onyenwe anyị",
          "type": "text"
        }
      ]
    },
