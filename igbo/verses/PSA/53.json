  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "53",
        "style": "c",
        "sid": "PSA 53"
      },
      "items": [
        {
          "text": "53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 53",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Nʼusoro Mahalat. Abụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzuzu nke ndị na-emebi iwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 53:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nzuzu na-asị nʼime obi ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "\"Ọ dịghị Chineke ọbụla dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "Ha bụ ndị ajọ omume riri ahụ, ụzọ ha niile bụkwa ihe arụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:1"
      },
      "items": [
        {
          "text": "ọ dịghị onye ọbụla na-eme ezi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.1",
            "verseOrgIds": [
              "PSA.53.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 53:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke sitere nʼeluigwe",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "na-ele ụmụ mmadụ anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "ịhụ ma ọ ga-achọta onye ọbụla nwere nghọta,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:2"
      },
      "items": [
        {
          "text": "onye nke na-achọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.2",
            "verseOrgIds": [
              "PSA.53.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 53:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla, nʼotu nʼotu ewezugala onwe ha, ha niile abụrụla ndị ajọ omume riri ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "ọ dịghị onye ọbụla na-eme ihe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:3"
      },
      "items": [
        {
          "text": "ọ dịghị ọ bụladị otu onye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.3",
            "verseOrgIds": [
              "PSA.53.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 53:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile na-eme ajọ ihe, ha amaghị ihe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 53:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "Ha na-eripịa ndị m dịka mmadụ si eri nri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:4"
      },
      "items": [
        {
          "text": "ha adịghị akpọkukwa Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.4",
            "verseOrgIds": [
              "PSA.53.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 53:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼebe ahụ ka ha nọ, nʼọnọdụ oke egwu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "ebe ọ dịghị ihe egwu na-adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "Chineke fesasịrị ọkpụkpụ ndị niile megidere gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:5"
      },
      "items": [
        {
          "text": "i mere ka ihere mee ha, nʼihi na Chineke ajụla ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.5",
            "verseOrgIds": [
              "PSA.53.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 53:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, a sịkwarị na nzọpụta Izrel ga-esi na Zayọn pụta!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "Mgbe Chineke ga-akpọghachite ndị ya nʼọnọdụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 53:6"
      },
      "items": [
        {
          "text": "ka Jekọb ṅụrịa ọṅụ, ka Izrel nwekwaa obi ụtọ!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.53.6",
            "verseOrgIds": [
              "PSA.53.7"
            ]
          }
        }
      ]
    }
  ],
