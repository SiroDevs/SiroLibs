    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "Bụkuonụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.1",
                "verseOrgIds": [
                  "PSA.149.1"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "Bụọnụ abụ ito ya nʼetiti ndị nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 149:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Izrel ṅụrịa ọṅụ nʼime onye kere ha;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:2"
      },
      "items": [
        {
          "text": "ka ndị bi na Zayọn nwee obi ụtọ nʼime Eze",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        },
        {
          "text": "ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 149:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ha jiri ite egwu too aha ya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:3"
      },
      "items": [
        {
          "text": "ka ha jiri ọyọ na ụbọ akwara kpọọrọ ya egwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 149:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe banyere ndị ya na-atọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.149.4",
                "verseOrgIds": [
                  "PSA.149.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:4"
      },
      "items": [
        {
          "text": "Ọ na-eji nzọpụta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        },
        {
          "text": "kpukwasị ndị dị umeala nʼobi nʼisi dịka okpueze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 149:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndị nsọ ṅụrịa ọṅụ nʼime nsọpụrụ a,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:5"
      },
      "items": [
        {
          "text": "bụkwaa abụ nʼihi ọṅụ nʼelu ihe ndina ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 149:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka otuto Chineke dịrị nʼọnụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:6"
      },
      "items": [
        {
          "text": "ka mma agha ihu abụọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        },
        {
          "text": "dịrịkwa nʼaka ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 149:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "iji bọọrọ mba niile ọbọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:7"
      },
      "items": [
        {
          "text": "taakwa ndị niile dị iche iche ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 149:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "iji mkpọrọ igwe kee ndị eze ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:8"
      },
      "items": [
        {
          "text": "na ndị ha a na-asọpụrụ agbụ igwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 149:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "imezu ihe ahụ e kpebiri, depụtakwa megide ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:9"
      },
      "items": [
        {
          "text": "Nke a bụ nsọpụrụ dịrị ndị nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
      ]
    },
