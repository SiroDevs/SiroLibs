                "verseId": "PSA.149.1",
                "verseOrgIds": [
                  "PSA.149.1"
                ]
              }
            }
          ]
        },
        {
          "text": "!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
