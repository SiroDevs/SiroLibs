          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:4"
      },
      "items": [
        {
          "text": "ma karịakwa ụda nke ebili mmiri nke oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.4",
            "verseOrgIds": [
              "PSA.93.4"
            ]
          }
        }
      ]
