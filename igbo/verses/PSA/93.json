          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke osimiri niile amaliela elu, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        },
