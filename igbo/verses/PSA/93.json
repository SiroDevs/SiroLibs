          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.93.1",
                "verseOrgIds": [
                  "PSA.93.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na-eyikwasị ịma mma dịka uwe, ọ dịkwa ike nke ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:1"
      },
      "items": [
        {
          "text": "nʼezie, ụwa niile na-eguzosikwa ike; apụghịkwa iwezuga ya nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
