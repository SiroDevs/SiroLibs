                "verseOrgIds": [
                  "PSA.93.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ eze, ọ na-eyikwasị ịma mma dịka uwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.1",
            "verseOrgIds": [
              "PSA.93.1"
            ]
          }
        }
