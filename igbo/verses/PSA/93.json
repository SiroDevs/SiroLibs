          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.93.3",
                "verseOrgIds": [
                  "PSA.93.3"
                ]
              }
            }
          ]
        },
        {
          "text": ";",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "oke osimiri niile eweliela olu ha elu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 93:3"
      },
      "items": [
        {
          "text": "ebili mmiri niile nke oke osimiri na-amali elu na-eme mkpọtụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.93.3",
            "verseOrgIds": [
              "PSA.93.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
