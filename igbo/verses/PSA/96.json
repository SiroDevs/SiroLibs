          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọọnụ isiala nye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.9",
                "verseOrgIds": [
                  "PSA.96.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼịma mma nke ịdị nsọ ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:9"
      },
      "items": [
        {
          "text": "maa jijiji nʼihu ya, unu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.9",
            "verseOrgIds": [
              "PSA.96.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 96:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwusaa nʼetiti mba niile sị, \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.10",
                "verseOrgIds": [
                  "PSA.96.10"
                ]
              }
            }
          ]
        },
        {
          "text": "na-achị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "Elu ụwa kwụ chịm, a pụghị iwezuga ya nʼọnọdụ ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:10"
      },
      "items": [
        {
          "text": "ọ ga-eji ikpe ziri ezi kpee ndị niile ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.10",
            "verseOrgIds": [
              "PSA.96.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 96:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mbara eluigwe ṅụrịa, ka ụwa nwekwa obi ụtọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:11"
      },
      "items": [
        {
          "text": "ka osimiri bigbọọ, na ihe niile dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.11",
            "verseOrgIds": [
              "PSA.96.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 96:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ala ubi niile na ihe niile dị nʼime ha jupụta nʼobi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:12"
      },
      "items": [
        {
          "text": "Ka osisi niile nke oke ọhịa bụọ abụ nʼihi ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.12",
            "verseOrgIds": [
              "PSA.96.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
