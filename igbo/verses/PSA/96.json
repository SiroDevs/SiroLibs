          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.4",
                "verseOrgIds": [
                  "PSA.96.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu, bụrụkwa onye kwesiri ịnata otuto;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:4"
      },
      "items": [
        {
          "text": "onye a na-atụ egwu karịa chi ọzọ niile ka ọ bụkwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.4",
            "verseOrgIds": [
              "PSA.96.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
