          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịma mma na ebube dị nʼihu ya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.6",
            "verseOrgIds": [
              "PSA.96.6"
            ]
          }
        }
