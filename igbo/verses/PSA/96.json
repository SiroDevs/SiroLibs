            "sid": "PSA 96:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwusaanụ ebube ya nʼetiti mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:3"
      },
      "items": [
        {
          "text": "kọsakwanụ banyere oke ọrụ ya niile nʼetiti ndị niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.3",
            "verseOrgIds": [
              "PSA.96.3"
            ]
          }
        }
      ]
    },
    {
