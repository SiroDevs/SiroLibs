      "attrs": {
        "style": "q2",
        "vid": "PSA 96:2"
      },
      "items": [
        {
          "text": "kwupụtanụ nzọpụta ya site nʼotu ụbọchị ruo nʼụbọchị nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.2",
            "verseOrgIds": [
              "PSA.96.2"
            ]
          }
        }
      ]
    },
    {
