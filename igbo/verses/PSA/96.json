            "number": "5",
            "style": "v",
            "sid": "PSA 96:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na chi niile nke mba niile dị iche iche bụ arụsị efu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 96:5"
      },
      "items": [
        {
          "text": "maọbụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.96.5",
                "verseOrgIds": [
                  "PSA.96.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kere eluigwe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.5",
            "verseOrgIds": [
              "PSA.96.5"
            ]
          }
        }
      ]
    },
