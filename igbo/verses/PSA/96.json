                "verseOrgIds": [
                  "PSA.96.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu ezinaụlọ nke mba niile dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.96.7",
            "verseOrgIds": [
