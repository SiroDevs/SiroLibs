      "attrs": {
        "style": "q1",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "Aga m eji obi m niile jaa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        },
        {
