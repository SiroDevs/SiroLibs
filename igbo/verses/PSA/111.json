          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịtụ egwu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.10",
                "verseOrgIds": [
                  "PSA.111.10"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ mmalite amamihe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "ndị niile na-edebe ụkpụrụ ya nwere ezi nghọta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:10"
      },
      "items": [
        {
          "text": "Otuto ya na-adị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.10",
            "verseOrgIds": [
              "PSA.111.10"
            ]
          }
        }
      ]
    }
