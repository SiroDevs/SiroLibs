                "verseOrgIds": [
                  "PSA.111.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:1"
      },
      "items": [
        {
          "text": "nʼime nzukọ ndị ụzọ ha ziri ezi na nʼime ọgbakọ ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.1",
            "verseOrgIds": [
              "PSA.111.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 111:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.2",
                "verseOrgIds": [
                  "PSA.111.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-arụ dị ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:2"
      },
      "items": [
        {
          "text": "ndị niile na-enwe mmasị na ha na-atụgharị uche nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.2",
            "verseOrgIds": [
              "PSA.111.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 111:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ ya jupụtara nʼebube na ịma mma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:3"
      },
      "items": [
        {
          "text": "ezi omume ya na-adịgidekwa ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.3",
            "verseOrgIds": [
              "PSA.111.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 111:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O meela ka e cheta ọrụ ebube ya niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:4"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.111.4",
                "verseOrgIds": [
                  "PSA.111.4"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ onye amara na onye ọmịiko.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.4",
            "verseOrgIds": [
              "PSA.111.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 111:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-egboro ndị na-atụ egwu ya mkpa ihe oriri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:5"
      },
      "items": [
        {
          "text": "ọ na-echetakwa ọgbụgba ndụ ya ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.5",
            "verseOrgIds": [
              "PSA.111.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 111:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O gosila ndị ya ike nke ọrụ ya niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:6"
      },
      "items": [
        {
          "text": "site nʼinye ha ala niile nke ndị mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.6",
            "verseOrgIds": [
              "PSA.111.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 111:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ aka ya niile bụ ihe kwesiri ekwesi na ikpe ziri ezi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:7"
      },
      "items": [
        {
          "text": "ụkpụrụ ya niile bụ ihe kwesiri ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.7",
            "verseOrgIds": [
              "PSA.111.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 111:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E hiwere ha ịdị ruo mgbe niile ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:8"
      },
      "items": [
        {
          "text": "ha bụ ihe e mere nʼikwesị ntụkwasị obi na izi ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.8",
            "verseOrgIds": [
              "PSA.111.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 111:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wetaara ndị ya mgbapụta;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "o meela ka ọgbụgba ndụ ya guzosie ike ruo ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 111:9"
      },
      "items": [
        {
          "text": "aha ya dị nsọ dịkwa oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.111.9",
            "verseOrgIds": [
              "PSA.111.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
