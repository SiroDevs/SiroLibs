  "verseCount": 8,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "61",
        "style": "c",
        "sid": "PSA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ ọma Devid nke eji ụbọ akwara akpọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere nke onye nọ na nsogbu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nụrụ akwa m, O Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:1"
      },
      "items": [
        {
          "text": "gee ntị nʼekpere m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.1",
            "verseOrgIds": [
              "PSA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m akpọku gị site na nsọtụ nke ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "ana m akpọku gị mgbe obi m na-ada mba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:2"
      },
      "items": [
        {
          "text": "duru m gaa nʼoke nkume ahụ nke karịrị m elu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.2",
            "verseOrgIds": [
              "PSA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ị bụrịị ebe mgbaba m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:3"
      },
      "items": [
        {
          "text": "na ụlọ ahụ dịkarịrị elu, sie ike imegide onye iro ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.3",
            "verseOrgIds": [
              "PSA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agụ m ibi nʼụlọ ikwu gị ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:4"
      },
      "items": [
        {
          "text": "ka m gbaba, zere ndụ nʼokpuru nku gị abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.4",
            "verseOrgIds": [
              "PSA.61.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.61.4",
                "verseOrgIds": [
                  "PSA.61.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na gị onwe gị, Chineke, anụla nkwa niile m kwere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:5"
      },
      "items": [
        {
          "text": "i nyela m ihe nketa nke ndị na-atụ egwu aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.5",
            "verseOrgIds": [
              "PSA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụkwasị ọtụtụ ụbọchị na ndụ eze,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:6"
      },
      "items": [
        {
          "text": "mee ka afọ ya ruo ọtụtụ ọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.6",
            "verseOrgIds": [
              "PSA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwere ka ọ nọrọ nʼocheeze nʼihu Chineke ruo mgbe ebighị ebi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:7"
      },
      "items": [
        {
          "text": "zidata ịhụnanya gị na ikwesi ntụkwasị obi gị, ka ha na-echezikwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.7",
            "verseOrgIds": [
              "PSA.61.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, aga m abụ abụ otuto nye aha gị, ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 61:8"
      },
      "items": [
        {
          "text": "Aga m emezukwa nkwa m kwere gị ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.61.8",
            "verseOrgIds": [
              "PSA.61.9"
            ]
          }
        }
      ]
    }
  ],
