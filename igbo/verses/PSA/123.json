      "items": [
        {
          "text": "ịchị ọchị ndị nganga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
        }
      ]
    },
