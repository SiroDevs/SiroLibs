          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nnagide anyị na-anagide",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
          }
