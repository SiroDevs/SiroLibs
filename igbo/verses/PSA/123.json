          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Meere anyị ebere, O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.123.3",
                "verseOrgIds": [
                  "PSA.123.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", meere anyị ebere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:3"
      },
      "items": [
        {
          "text": "nʼihi na anyị abụrụla ndị a na-akọcha akọcha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.3",
            "verseOrgIds": [
              "PSA.123.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
