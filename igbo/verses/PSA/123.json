      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 123:4"
      },
      "items": [
        {
          "text": "na ileda anya ndị mpako adịla ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.123.4",
            "verseOrgIds": [
              "PSA.123.4"
            ]
