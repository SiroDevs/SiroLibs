          "text": "144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 144",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke Devid.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ nke dike nʼagha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 144:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.1",
                "verseOrgIds": [
                  "PSA.144.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye bụ oke nkume m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "onye na-ezi aka m abụọ ibu agha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:1"
      },
      "items": [
        {
          "text": "na mkpịsịaka m ịlụ ọgụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.1",
            "verseOrgIds": [
              "PSA.144.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 144:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ Chineke m, onye jupụtara nʼịhụnanya, bụrụkwa ebe mgbaba m e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ebe m e wusiri ike na onye mgbapụta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "ọ bụ ọta m, onye m na-agbaba nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:2"
      },
      "items": [
        {
          "text": "onye ji aka ike mee ka ndị dị iche iche nọdụ nʼokpuru m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.2",
            "verseOrgIds": [
              "PSA.144.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 144:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.3",
                "verseOrgIds": [
                  "PSA.144.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", gịnị ka mmadụ bụ i ji na-eche echiche banyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:3"
      },
      "items": [
        {
          "text": "gịnị ka nwa nke mmadụ bụ ihe banyere ya ji na-emetụ gị nʼobi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.3",
            "verseOrgIds": [
              "PSA.144.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 144:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ dị ka otu nkuume;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:4"
      },
      "items": [
        {
          "text": "ụbọchị ndụ ya niile na-agafe ngwangwa dịka onyinyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.4",
            "verseOrgIds": [
              "PSA.144.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 144:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.144.5",
                "verseOrgIds": [
                  "PSA.144.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", kewaa eluigwe rịdata;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:5"
      },
      "items": [
        {
          "text": "metụ ugwu niile aka ka ha kwụọ anwụrụ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.5",
            "verseOrgIds": [
              "PSA.144.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 144:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zipụ amụma ka o chụsasịa ndị iro niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:6"
      },
      "items": [
        {
          "text": "gbaa ha àkụ gị niile ma chụsasịa ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.6",
            "verseOrgIds": [
              "PSA.144.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 144:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼelu setịpụ aka gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "gbapụta m, napụtakwa m",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "site nʼoke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:7"
      },
      "items": [
        {
          "text": "site nʼaka ndị si mba ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.7",
            "verseOrgIds": [
              "PSA.144.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 144:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị ọnụ ha jupụtara nʼụgha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:8"
      },
      "items": [
        {
          "text": "ndị aka nri ha jupụtakwara nʼaghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.8",
            "verseOrgIds": [
              "PSA.144.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 144:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, aga m abụku gị abụ ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:9"
      },
      "items": [
        {
          "text": "Une e ji akwara iri mee ka m ga-eji kpọọrọ gị egwu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.9",
            "verseOrgIds": [
              "PSA.144.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 144:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "gị onye na-enye ndị eze mmeri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "onye na-agbapụta ohu ya Devid.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 144:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:10"
      },
      "items": [
        {
          "text": "Site na mma agha dị njọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.10",
            "verseOrgIds": [
              "PSA.144.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 144:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbapụta m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "napụtakwa m site nʼaka ndị si mba ọzọ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "ndị ọnụ ha jupụtara nʼụgha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:11"
      },
      "items": [
        {
          "text": "ndị aka nri ha jupụtakwara nʼaghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.11",
            "verseOrgIds": [
              "PSA.144.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 144:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ụmụ ndị ikom anyị, nʼoge okorobịa ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "ga-adị ka ihe a kụrụ nʼala e lekọtara anya nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "ụmụ anyị ndị inyom ga-adị ka ogidi a pịrị apị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
              "PSA.144.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 144:12"
      },
      "items": [
        {
          "text": "e ji achọ ụlọeze mma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.12",
            "verseOrgIds": [
