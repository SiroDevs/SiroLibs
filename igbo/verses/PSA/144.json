        "vid": "PSA 144:13"
      },
      "items": [
        {
          "text": "Atụrụ anyị ga-amụba nʼọtụtụ puku nʼọnụọgụgụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.144.13",
