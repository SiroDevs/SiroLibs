  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "91",
        "style": "c",
        "sid": "PSA 91"
      },
      "items": [
        {
          "text": "91",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 91",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke onye na-echebe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 91:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ na-ebi nʼebe mgbaba Onye kachasị ihe niile elu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:1"
      },
      "items": [
        {
          "text": "ga-ezu ike nʼokpuru ndo Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.1",
            "verseOrgIds": [
              "PSA.91.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 91:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ka m ga-ekwu maka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.2",
                "verseOrgIds": [
                  "PSA.91.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", \"Ọ bụ ebe mgbaba m na ebe nchebe m e wusiri ike,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:2"
      },
      "items": [
        {
          "text": "Chineke m, onye m na-atụkwasị obi m.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.2",
            "verseOrgIds": [
              "PSA.91.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 91:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, ọ ga-anapụta gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "site nʼọnya nke onye osi ọnya",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:3"
      },
      "items": [
        {
          "text": "na site nʼaka ajọ ọrịa na-efe efe na-eweta ịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.3",
            "verseOrgIds": [
              "PSA.91.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 91:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji nku ya kpuchie gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "Ọ bụkwa nʼokpuru nku ya abụọ, ka ị ga-agbaba zere ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:4"
      },
      "items": [
        {
          "text": "ikwesi ntụkwasị obi ya ga-echebe gị, ghọkwaara gị ọta.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.4",
            "verseOrgIds": [
              "PSA.91.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 91:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gaghị atụ egwu ihe ịtụ oke egwu nke abalị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:5"
      },
      "items": [
        {
          "text": "maọbụ àkụ na-efegharị nʼehihie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.5",
            "verseOrgIds": [
              "PSA.91.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 91:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ ajọ ọrịa na-efe efe, nke na-ejegharị nʼọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:6"
      },
      "items": [
        {
          "text": "ma ọ bụkwanụ ihe mbibi mberede na-eme nʼehihie.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.6",
            "verseOrgIds": [
              "PSA.91.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 91:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Puku mmadụ pụrụ ịda nʼakụkụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "iri puku mmadụ nwekwara ike ịda nʼakụkụ aka nri gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:7"
      },
      "items": [
        {
          "text": "ma ihe ọjọọ ndị a agaghị erute gị nso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.7",
            "verseOrgIds": [
              "PSA.91.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 91:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ naanị anya gị abụọ ka ị ga-eji hụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:8"
      },
      "items": [
        {
          "text": "ntaramahụhụ nke ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.8",
            "verseOrgIds": [
              "PSA.91.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 91:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na i mee Onye kachasị ihe niile elu ebe obibi gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:9"
      },
      "items": [
        {
          "text": "ọ bụladị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.9",
                "verseOrgIds": [
                  "PSA.91.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye bụ ebe mgbaba m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.9",
            "verseOrgIds": [
              "PSA.91.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 91:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, ihe ọjọọ ọbụla enweghị ike ịdakwasị gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:10"
      },
      "items": [
        {
          "text": "ihe ike ọbụla enweghị ike ịbịaru ụlọ obibi gị nso.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.10",
            "verseOrgIds": [
              "PSA.91.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 91:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ ga-enye ndị mmụọ ozi ya iwu banyere gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:11"
      },
      "items": [
        {
          "text": "ka ha chebe gị nʼụzọ gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.11",
            "verseOrgIds": [
              "PSA.91.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 91:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-eji ọbụ aka ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:12"
      },
      "items": [
        {
          "text": "bulie gị elu ime ka ị ghara ịkpọbi ụkwụ gị na nkume.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.12",
            "verseOrgIds": [
              "PSA.91.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 91:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-azọkwasị ọdụm na ajụala ụkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:13"
      },
      "items": [
        {
          "text": "zọgbukwaa ọdụm na-akpa ike, na agwọ ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.13",
            "verseOrgIds": [
              "PSA.91.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 91:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na ọ hụrụ m nʼanya, Mụ onwe m ga-agbapụta ya, ka",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.91.14",
                "verseOrgIds": [
                  "PSA.91.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 91:14"
      },
      "items": [
        {
          "text": "aga m echebe ya, nʼihi na ọ maara aha m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.14",
            "verseOrgIds": [
              "PSA.91.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 91:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-akpọku m, aga m azakwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.91.15",
            "verseOrgIds": [
              "PSA.91.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
