      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:20"
      },
      "items": [
        {
          "text": "nʼihi na ihe ike na-ejupụta ebe niile gbara ọchịchịrị nʼala a.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.20",
            "verseOrgIds": [
              "PSA.74.20"
            ]
          }
        }
