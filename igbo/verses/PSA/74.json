        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.74.18",
                "verseOrgIds": [
                  "PSA.74.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", cheta otu onye iro si chịa gị ọchị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
