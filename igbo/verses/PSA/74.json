          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O Chineke, bilie, kpechitara onwe gị ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
      ]
    },
