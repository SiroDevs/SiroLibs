      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:19"
      },
      "items": [
        {
          "text": "Echefukwala ndụ ndị gị a na-akpagbu ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
