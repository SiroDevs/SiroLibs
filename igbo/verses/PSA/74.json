      "attrs": {
        "style": "q2",
        "vid": "PSA 74:18"
      },
      "items": [
        {
          "text": "na otu ndị nzuzu si kwaa aha gị emo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.18",
            "verseOrgIds": [
              "PSA.74.18"
            ]
          }
