      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:22"
      },
      "items": [
        {
          "text": "Chetakwa otu ndị nzuzu si kọọ gị ọnụ ogologo ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.22",
            "verseOrgIds": [
              "PSA.74.22"
            ]
          }
        }
      ]
    },
