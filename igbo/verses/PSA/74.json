              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elepụla mkpọtụ nke ndị iro gị niile anya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.23",
            "verseOrgIds": [
