            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ gị kewapụtara oke ala niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
        }
      ]
