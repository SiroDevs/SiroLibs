      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:17"
      },
      "items": [
        {
          "text": "Ọ bụ gị mere ka ọkọchị na udu mmiri dị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.17",
            "verseOrgIds": [
              "PSA.74.17"
            ]
          }
