          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwela ka ndị a na-akpagbu gbaghachi azụ nʼihere;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
          }
        }
