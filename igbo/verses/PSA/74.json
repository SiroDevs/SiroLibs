          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewerala ndụ nduru gị nyefee anụ ọhịa ọjọọ nʼaka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.19",
            "verseOrgIds": [
              "PSA.74.19"
            ]
          }
        }
      ]
    },
