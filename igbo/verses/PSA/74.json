      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 74:21"
      },
      "items": [
        {
          "text": "ka ndị ogbenye na ndị nọ na mkpa too aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.74.21",
            "verseOrgIds": [
              "PSA.74.21"
            ]
          }
        }
