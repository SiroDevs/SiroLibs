      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:24"
      },
      "items": [
        {
          "text": "kwaaranụ Sọl akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.24",
            "verseOrgIds": [
              "2SA.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:24"
      },
      "items": [
        {
          "text": "Onye na-eji uwe uhie uhie chọọ unu mma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.24",
            "verseOrgIds": [
              "2SA.1.24"
            ]
          }
        }
      ]
    },
