          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu ugwu Gilboa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "ka igirigi maọbụ mmiri ozuzo ghara ịbịakwasị unu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "Ka mmiri ozuzo gharakwa izokwasị nʼaja mbuli elu unu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "Nʼihi na nʼelu unu ka a nọ merụọ ọta",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        },
        {
          "text": "ndị dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:21"
      },
      "items": [
        {
          "text": "E, ọta Sọl, nke a na-adịghị etekwa mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.21",
            "verseOrgIds": [
              "2SA.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
