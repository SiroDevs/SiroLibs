          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        },
        {
          "text": "i nwere nʼebe m nọ dị omimi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
