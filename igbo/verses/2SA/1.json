      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:24"
      },
      "items": [
        {
          "text": "Onye ji uwe na ihe ịchọ mma ọlaedo chọọ unu mma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.24",
            "verseOrgIds": [
              "2SA.1.24"
            ]
          }
        }
      ]
    },
