      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:26"
      },
      "items": [
        {
          "text": "nʼihi na ihe dị oke ọnụahịa ka ị bụụrụ m.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
