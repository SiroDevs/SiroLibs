          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Site nʼọbara ndị e gburu egbu,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "site nʼanụ ahụ ndị dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "Ụta Jonatan alọghachighị azụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:22"
      },
      "items": [
        {
          "text": "Mma agha Sọl agbaghịkwa aka lọghachi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.22",
            "verseOrgIds": [
              "2SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
