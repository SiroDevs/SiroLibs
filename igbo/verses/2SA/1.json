      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:25"
      },
      "items": [
        {
          "text": "E gbuola Jonatan nʼelu ugwu;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.25",
            "verseOrgIds": [
              "2SA.1.25"
            ]
