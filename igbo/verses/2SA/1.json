              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ana m eruru gị ụjụ, gị Jonatan, nwanne m",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.26",
            "verseOrgIds": [
              "2SA.1.26"
            ]
          }
        }
