          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl na Jonatan,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "na ndụ ha bụ ndị a hụrụ nʼanya. Ndị jupụtara nʼamara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "Ma nʼọnwụ, nkewa ọbụla adịghị nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "Ha dị gara gara karịa ugo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 1:23"
      },
      "items": [
        {
          "text": "Ha dị ike karịa ọdụm.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.1.23",
            "verseOrgIds": [
              "2SA.1.23"
            ]
          }
        }
      ]
    },
