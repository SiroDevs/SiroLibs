  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amnọn na Tama, na ọnwụ Amnọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm nwa Devid nwere otu nwanne nwanyị mara mma, aha ya bụ Tama.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        },
        {
          "text": "Ma Amnọn, otu nʼime ụmụ ndị ikom Devid, hụrụ nwaagbọghọ a nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ịhụnanya a Amnọn hụrụ Tama nwanne ya nwanyị mere ya ka ọ daa ọrịa, nʼihi na ọ bụ ihe rara Amnọn ahụ ịchọpụta ụzọ ya na Tama ga-esi nwee mmekọ, ebe ọ bụ na Tama bụ nwaagbọghọ na-amaghị nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Amnọn nwere otu enyi dị aghụghọ, onye aha ya bụ Jonadab, nwa Shimea, nwanne Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.3",
            "verseOrgIds": [
              "2SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, Jonadab bịakwutere Amnọn jụọ ya sị, \"Gịnị mere, gị bụ nwa eze ji na-ata ahụ ụtụtụ niile? Ọ bụ na ị gaghị akọrọ m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:4"
      },
      "items": [
        {
          "text": "Amnọn gwara ya sị, \"Ahụrụ m Tama nʼanya, bụ nwanne Absalọm, nwanne m nwoke.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonadab gwara ya sị, \"Ọ dị mma. Lee ihe ị ga-eme. Gaa dinaa ala, dịka a ga-asị na ahụ adịghị gị. Mgbe nna gị bịara ileta gị, gwa ya okwu sị ya, 'Achọrọ m ka nwanne m nwanyị bụ Tama bịa nye m ihe oriri. Achọrọ m ka ọ nọdụ nʼihu m sie nri ahụ, mgbe m na-ele ya anya, ka o jirikwa aka ya nye m nri ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.5",
            "verseOrgIds": [
              "2SA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amnọn mere otu a. Mgbe eze bịara ileta ya, Amnọn rịọrọ ya sị, \"Biko, ka Tama bịa ebe a gheere m achịcha ole na ole ebe m ga-ahụ ya anya. Ka o jirikwa aka ya dozie ya nʼihu m ka m rie ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kwenyere, zie Tama ka ọ gaa nʼụlọ Amnọn gaa siere ya nri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tama gara nʼụlọ Amnọn, banyekwa nʼime ụlọ ebe o dinaa, ka Amnọn na-ele ya anya mgbe ọ na-agwọgharị ụtụ ọka. Emesịa, Tama gheere ya achịcha mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.8",
            "verseOrgIds": [
              "2SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o cheziri achịcha ahụ nʼihu Amnọn, Amnọn jụrụ iri ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:9"
      },
      "items": [
        {
          "text": "Ihe o mere mgbe ahụ bụ inye ndị na-ejere ya ozi nọ nʼebe ahụ iwu sị ha niile pụọ ngwangwa. Ha niile pụkwara.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Amnọn gwara Tama okwu sị, \"Ugbu a, wetara m nri ahụ nʼime ụlọ ndina m, bịa jiri aka gị nye m ya.\" Tama bugaara ya achịcha ahụ nʼime ụlọ ebe ihe ndina ya dị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.10",
            "verseOrgIds": [
              "2SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe Tama guzo nʼihu ya, Amnọn jidere ya nʼike sị ya, \"Bịa, soro m dinaa, nwanne m nwanyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tama zara sị ya, \"Mba! Nwanne m nwoke. Emerụla m. Ihe dị otu a ekwesighị ime nʼala Izrel. Emela ihe ọjọọ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ihe ga-abụ ọnọdụ m? Oleekwanụ ihe ga-abụ ọnọdụ gị? Olee ebe m ga-agbala izo onwe m nʼihi ihe ihere ga-adịrị m ma i mee ihe dị otu a? Ị ga-adị ka otu nʼime ndị nzuzu ọjọọ dị nʼIzrel. Biko, gwa eze, ọ ga-ekwe ka ị lụọ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Amnọn egeghị ntị. Ebe ọ bụ na ọ ka Tama ike, o jidere ya dinaa ya nʼike merụọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Amnọn kpọrọ Tama asị. Nʼezie, ọ kpọrọ ya asị ugbu a karịa ịhụnanya ọ hụrụ ya na mbụ. Ọ gwara Tama okwu sị ya, \"Bilie si nʼebe a pụọ ọsịịsọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Tama kwara akwa sị ya, \"Mba! Ịjụ m otu a ka njọ karịa ihe ọjọọ i mere m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:16"
      },
      "items": [
        {
          "text": "Ma Amnọn egeghị ya ntị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọrọ nwokorobịa na-ejere ya ozi sị ya, \"Chụpụ nwanyị a nʼezi, kpachiere m ụzọ nʼazụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.17",
            "verseOrgIds": [
              "2SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyeozi ya chụpụrụ ya nʼezi, kpachie ụzọ nʼazụ ya. Uwe mwụda nwere aka ogologo ka Tama yi, nʼihi na ọ bụ ụdị nke ụmụ ndị inyom eze na-amaghị nwoke na-eyi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tama dọwara uwe",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        },
        {
          "text": "mwụda ahụ o yi nʼahụ, werekwa ntụ kpokwasị onwe ya nʼisi, buru aka ya nʼisi na-eti mkpu akwa dịka ọ na-ala.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanne ya nwoke, Absalọm jụrụ ya sị, \"Amnọn, nwanne gị nwoke, o dinakwuuru gị? Ma ugbu a, nwanne m, gba nkịtị, nwanne gị nwoke ka ọ bụ. Etinyela ihe a mere nʼobi.\" Tama nọrọ dịka onye mmadụ niile jụrụ ajụ nʼụlọ nwanne ya nwoke, bụ Absalọm.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze Devid nụrụ ihe ndị a niile, iwe were ya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm agwaghị Amnọn okwu ọbụla, maọbụ nke dị mma, maọbụ okwu ọjọọ. Ma ọ kpọrọ Amnọn asị nke ukwuu nʼihi ọnọdụ iweda nʼala o wedara nwanne ya Tama, mee ya ihe ihere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Absalọm egbuo Amnọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe afọ abụọ gasịrị, mgbe ndị na-akpụchara Absalọm ajị ụmụ atụrụ ya nọ na Baal-Hazọ, nʼoke ala Ifrem, ọ kpọkọtara ụmụ ndị ikom eze niile ka ha bịa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm jekwuuru eze sị ya, \"Ndị na-akpụcha ajị ụmụ atụrụ ohu gị bịara. Eze na ndịisi ozi ya, ha ga-abịa sonyere m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze zara sị ya, \"Mba, nwa m, anyị niile agaghị abịa, anyị ga-abụ ibu dị arọ nye gị.\" Nʼagbanyeghị na Absalọm rugidere ya ma o kweghị aga, kama ọ gọziri ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Absalọm rịọrọ nna ya sị, \"Ọ dị mma, ọ bụrụ na ị gaghị abịa, ị ga-emekwa ka nwanna m nwoke Amnọn, na ụmụ eze ndị ọzọ bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:26"
      },
      "items": [
        {
          "text": "Eze jụrụ ya sị, \"Nʼihi gịnị ka Amnọn ga-eji soro gị gaa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Absalọm rụgidere ya, ya mere o zipụrụ Amnọn na ụmụ eze ndị ọzọ ka ha soro ya gaa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Absalọm nyere ndị na-ejere ya ozi iwu banyere Amnọn sị, \"Cherenụ ruo mgbe mmanya bidoro igbu ya, mgbe m sịkwara unu tigbuo ya, unu atụla egwu, tigbuonụ ya. Ọ bụ m na-ekwu ihe ga-eme nʼebe a. Nweenụ obi ike, meekwanụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oge ruru, ndị ozi Absalọm tigburu Amnọn. Mgbe ahụ, ụmụ eze niile biliri makwasị nʼịnyịnya ha gbalaga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ka nọ nʼụzọ na-agbaga Jerusalem, ozi eruolarị Devid ntị sị, \"Absalọm egbuchaala ụmụ eze niile, ọ dịkwaghị otu onye nʼime ha fọdụrụ ndụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze biliri ọtọ, dọwaa uwe ya, daa nʼala, gbatịa onwe ya nʼihi obi ọjọọ. Ndị na-ejere ya ozi dọwakwara uwe ha nʼihi egwu na obi ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jonadab, nwa Shimea, nwanne Devid, sịrị, \"Onyenwe m, echekwala na e gburu ụmụ ndị ikom eze niile, kama ọ bụ naanị Amnọn! Nke a bụ ihe Absalọm jikere ime site mgbe Amnọn wakporo nwanne ya nwanyị bụ Tama, dina ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ka onyenwe m bụ eze ghara itinye akụkọ banyere ọnwụ ụmụ ndị ikom eze niile, nʼobi ya. Ọ bụ naanị Amnọn nwụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Absalọm gbara ọsọ gbalaga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 13:34"
      },
      "items": [
        {
          "text": "Ọ dịghị anya nwoke na-anọ nʼelu mgbidi Jerusalem na-eche nche, lepụrụ anya hụ ndị mmadụ ka ha si nʼụzọ dị nʼakụkụ ugwu nta na-abịa. Nwoke ahụ gara gwa eze sị ya, \"Ahụrụ m ndị si nʼakụkụ Horonaim, nʼakụkụ ugwu na-abịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonadab gwara eze sị, \"Lee, ọ bụ ụmụ ndị ikom eze na-alọta dịka m kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha lọbatara, ha bidoro ịkwa akwa nke ukwuu. Eze na ndị na-ejere ya ozi sokwa kwaa akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm gbara ọsọ gbakwuru Talmai nwa Amihud, eze Geshua. Ma eze Devid ruru ụjụ nke ukwuu maka ọnwụ Amnọn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Absalọm gbara ọsọ gbaga Geshua, ọ nọrọ nʼebe ahụ afọ atọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gụrụ eze bụ Devid agụụ ịgakwuru Absalọm, nʼihi ọ kasịela obi maka ọnwụ Amnọn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
    }
  ],
