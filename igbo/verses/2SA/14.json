  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2SA 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Absalọm alọghachi Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab, nwa Zeruaya matara na obi eze dị nʼebe Absalọm nọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.1",
            "verseOrgIds": [
              "2SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab zigara ozi na Tekoa, si nʼebe ahụ kpọta otu nwanyị maara ihe. Mgbe nwanyị ahụ bịaruru, Joab gwara ya sị, \"Mee onwe gị dịka onye na-eru ụjụ. Yiri akwa mkpe, etekwala mmanụ otite. Kpaa agwa dịka nwanyị nọ nʼiru ụjụ ogologo oge.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, jekwuru eze, gwa ya okwu ndị a m na-agwa gị.\" Joab tinyere okwu ndị ahụ nʼọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwanyị ahụ si Tekoa gara na nke eze, ọ dara nʼala kpuo ihu ya nʼala ịsọpụrụ eze. Ọ sịrị, \"Biko nyere m aka, gị onye a na-asọpụrụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.4",
            "verseOrgIds": [
              "2SA.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ya ajụjụ sị, \"Gịnị bụ mkpa gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:5"
      },
      "items": [
        {
          "text": "Ọ zara sị, \"Abụ m nwanyị isi mkpe, di m anwụọla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.5",
            "verseOrgIds": [
              "2SA.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enwere m ụmụ ndị ikom abụọ ndị gara lụọ ọgụ nʼọhịa. Mgbe ha na-alụ ọgụ ahụ, o nweghị onye pụtara gboo ha. Nʼihi ya, otu nʼime ha tigburu ibe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.6",
            "verseOrgIds": [
              "2SA.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, ndị ikwu di m na-esogbu m na-asị 'Kpọpụta onye ahụ gburu nwanne ya ka anyị gbuo ya nʼihi ndụ nwanne ya o wepụrụ, ka anyị si otu a memilaa onye nke fọdụrụ ga-erita oke ezinaụlọ.' Ha chọrọ isi otu a menyụọ icheku ọkụ nke fọdụụrụ m, nke bụ na di m agaghị enwezikwa aha maọbụ onye fọdụụrụ ya nʼelu ụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.7",
            "verseOrgIds": [
              "2SA.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sịrị nwanyị ahụ, \"Laa nʼụlọ gị, aga m ahụ na o nweghị onye metụrụ ya aka.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.8",
            "verseOrgIds": [
              "2SA.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwanyị ahụ si Tekoa sịrị ya, \"Ka onyenwe m, bụ eze, gbaghara mụ na ezinaụlọ m, ka ikpe ọmụma ọbụla ghara ịdịrị eze na ocheeze ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.9",
            "verseOrgIds": [
              "2SA.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze zara ya, \"Enyela onwe gị nsogbu maka nke ahụ. Ọ bụrụ na onye ọbụla agwa gị okwu ọbụla, kpọtara m ya. Onye dị otu a agaghị enyekwa gị nsogbu ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.10",
            "verseOrgIds": [
              "2SA.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ọ zara, \"Biko, ka eze kpọkuo aha",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.14.11",
                "verseOrgIds": [
                  "2SA.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya ka ọ kwụsị onye na-agwa ọchụ, ka ọ ghara igbu onye ọzọ, ka a gharakwa ịla nwa m nwoke nʼiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:11"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.14.11",
                "verseOrgIds": [
                  "2SA.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        },
        {
          "text": "otu agịrị isi agaghị esi nʼisi nwa gị dapụ nʼala.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.11",
            "verseOrgIds": [
              "2SA.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwanyị ahụ sịrị, \"Biko kwere ka ohu gị nwanyị gwa onyenwe m eze otu mkpụrụ okwu ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:12"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"Gaa nʼihu kwuo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.12",
            "verseOrgIds": [
              "2SA.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị ahụ sịrị, \"Ọ bụ nʼihi gịnị ka ị chere ihe dị otu a megide ndị nke Chineke? Mgbe eze na-ekwu otu a, ọ bụ na ọ dịghị ama onwe ya ikpe, nʼihi na eze a jụla ịkpọghachi nwa ya a chụpụrụ achụpụ?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.13",
            "verseOrgIds": [
              "2SA.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị niile ga-anwụ. Anyị dịkwa ka mmiri a wụsara nʼala, nke a na-apụghị ịchịkọtakwa ọzọ. Ma Chineke adịghị anapụ mmadụ ndụ ya, ma ọ na-emeghepụ ụzọ ga-eme ka onye ọ chụpụrụ achụpụ lọghachikwutekwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, ebe m bịara ịgwa onyenwe m bụ eze, okwu a, nʼihi na ndị mmadụ emenyela m egwu. Ohu gị chere nʼobi ya, 'Aga m agwa eze okwu; ma eleghị anya, ọ ga-emezuru ohu ya nwanyị ihe ọ rịọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eleghị anya eze ga-anapụta ohu ya nwanyị site nʼaka nwoke ahụ na-agbalị ibipụ mụ na nwa m nwoke site nʼihe nketa nke Chineke.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, ohu gị nwanyị na-asị, 'Ka okwu onyenwe m eze kwuru wetara m izuike, nʼihi onyenwe m eze na-enyochapụta ihe ọma maọbụ ihe ọjọọ dịka mmụọ ozi Chineke. Ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.14.17",
                "verseOrgIds": [
                  "2SA.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nọnyere gị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze gwara nwanyị ahụ okwu sị, \"Achọrọ m ka ị gwa m eziokwu nʼajụjụ a m na-aga ịjụ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:18"
      },
      "items": [
        {
          "text": "Nwanyị ahụ zara sị, \"Ka onyenwe m, bụ eze kwuo ihe dị ya nʼobi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.18",
            "verseOrgIds": [
              "2SA.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ ya sị, \"Aka Joab ọ dị nʼokwu ndị a niile?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 14:19"
      },
      "items": [
        {
          "text": "Nwanyị ahụ zara sị ya, \"Dịka ị na-adị ndụ, onyenwe m, bụ eze, ọ dịghị onye ọbụla ga-esi nʼihe onyenwe m bụ eze kwuru, chee ihu nʼaka nri maọbụ nʼaka ekpe. E, ọ bụ ohu gị Joab nyere m iwu ime nke a, ya gwakwara ohu gị nwanyị okwu niile ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.19",
            "verseOrgIds": [
              "2SA.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohu gị bụ Joab mere ihe a ka ọ gbanwee otu ọnọdụ ihe dị ugbu a. Onyenwe m nwere amamihe dịka ndị mmụọ ozi Chineke. Ọ maakwara ihe niile na-eme nʼala.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.20",
            "verseOrgIds": [
              "2SA.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze sịrị Joab, \"Ọ dị mma, aga m eme ya. Gaa kpọghachite nwokorobịa ahụ bụ Absalọm.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.21",
            "verseOrgIds": [
              "2SA.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab dara nʼala kpuo ihu ya nʼala, kpọọ isiala, gọzie eze. Joab sịrị, \"Taa ka ohu gị maara na ahụtala m amara nʼihu gị, onyenwe m bụ eze, nʼihi na eze e merela ohu ya ihe ọ rịọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.22",
            "verseOrgIds": [
              "2SA.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab biliri gaa Geshua, kpọlata Absalọm na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.23",
            "verseOrgIds": [
              "2SA.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịaruru, eze gwara Joab okwu sị, \"Gwa ya ka ọ laa nʼụlọ ya. Ọ gaghị abịa nʼihu m, nʼihi na-achọghị m ịhụ ya anya.\" Ya mere, Absalọm lara nʼụlọ ya. Ọ hụkwaghị eze anya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.24",
            "verseOrgIds": [
              "2SA.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị nwoke mara mma dịka Absalọm nʼala Izrel niile. Ọ dịkwaghị onye na-adịghị ekwu okwu banyere ịma mma ya. Nʼihi na ntụpọ ọbụla adịghị ya nʼahụ site nʼopi isi ya ruo nʼọbọ ụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.25",
            "verseOrgIds": [
              "2SA.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla ọ kpụchara ntutu isi ya, nʼihi na ọ bụ otu ugboro nʼafọ ka ọ na-akpụcha agịrị isi mgbe o bidoro ịnyị ya arọ. Ọ na-atụ agịrị isi a na-akpụchapụta ya nʼisi, ịdị arọ ya na-eru narị shekel abụọ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        },
        {
          "text": "ma a tụọ ya nʼihe ọtụtụ eze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.26",
            "verseOrgIds": [
              "2SA.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm mụtara ụmụ ndị ikom atọ, na otu nwanyị, aha ya bụ Tama. Nwaagbọghọ a mara mma nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.27",
            "verseOrgIds": [
              "2SA.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Absalọm nọrọ afọ abụọ na Jerusalem na-ahụghị eze anya,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.28",
            "verseOrgIds": [
              "2SA.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "o ziri ozi ka Joab bịa, ka ọ gaa ziere ya eze ozi, ma Joab abịaghị. Absalọm zigakwara ozi ọzọ ka ọ bịa ma Joab ekweghị ịbịa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.29",
            "verseOrgIds": [
              "2SA.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, Absalọm gwara ndị na-ejere ya ozi okwu sị ha, \"Gaanụ sunye ubi ọka balị Joab dị nʼakụkụ nke m ọkụ.\" Ha mekwara dịka a gwara ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.30",
            "verseOrgIds": [
              "2SA.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joab biliri jee nʼụlọ Absalọm, ma sị ya, \"Gịnị mere ndị na-ejere gị ozi ji gbaa ubi m ọkụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.31",
            "verseOrgIds": [
              "2SA.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm sịrị ya, \"Lee ezitere m gị ozi, sị, 'Bịa nʼebe a ka m ziga gị na nke eze ka ị jụta, \"Nʼihi gịnị ka m ji site na Geshua lọghachita? Ọ gara a kara m mma ma a sị na m nọ nʼebe ahụ ruo ugbu a.\" ' Ugbu a, achọrọ m ka mụ hụ ihu eze, ọ bụrụ na onwe ajọ omume dị nʼime m, ya mee ka m nwụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.32",
            "verseOrgIds": [
              "2SA.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab gakwuru eze, gwa ya ihe Absalọm kwuru. Mgbe ahụ, eze kpọrọ Absalọm, onye batara ma kpọọ isiala nʼihu eze. Eze sutukwara ya ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.33",
            "verseOrgIds": [
              "2SA.14.33"
            ]
          }
        }
      ]
    }
  ],
