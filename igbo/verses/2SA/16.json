  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "2SA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid na Ziba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid gafechara elu ugwu ahụ na-agbada nʼakụkụ nke ọzọ ya, Ziba, onye na-elekọta akụ Mefiboshet, guzo na-eche ya. Ọ chị ịnyịnya ibu bu narị ogbe achịcha abụọ, na otu narị ụyọkọ mkpụrụ vaịnị a mịkpọrọ amịkpọ na narị ụyọkọ mkpụrụ osisi ndị ọzọ, na karama akpụkpọ buru ibu mmanya juru nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.1",
            "verseOrgIds": [
              "2SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ Ziba sị, \"Gịnị mere i ji bute ihe ndị a?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:2"
      },
      "items": [
        {
          "text": "Ziba zara sị, \"Ịnyịnya ibu ndị a bụ nke ndị ụlọeze ga-anọkwasị. Achịcha na mkpụrụ osisi ndị a bụ nke ndị ikom gị ga-eri. Mmanya a bụ nke ndị na-ada mba nʼọzara ga-aṅụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ya sị, \"Ebeekwanụ ka nwa nna gị ukwu nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:3"
      },
      "items": [
        {
          "text": "Ziba zara ya sị, \"Ọ nọ na Jerusalem nʼihi na ọ sịrị, 'Taa ụlọ Izrel ga-enyeghachi m alaeze nna nna m.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze gwara Ziba sị ya, \"Nʼihi ya, enyela m gị ihe niile Mefiboshet nwere, ha ga-abụkwa nke gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 16:4"
      },
      "items": [
        {
          "text": "Ziba sịrị, \"Ka m hụta amara nʼihu eze, bụ onyenwe m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Shimei abụọ Devid ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka eze bụ Devid na-abịaru obodo Bahurim,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "text": "lee, otu nwoke sitere nʼagbụrụ ụlọ Sọl sitere nʼebe ahụ pụta. Ọ bụ Shimei",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "text": "nwa Gera. Ọ na-akọcha mgbe ọ na-apụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịịrị nkume na-atụ Devid na ndị ozi eze niile. Ọ bụ ezie na ndị agha Izrel na ndị na-eche Devid nche gbara ya gburugburu nʼaka nri na aka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka Shimei na-akọcha, ọ sịrị, \"Si nʼebe a pụọ, si nʼebe a pụọ, gị ogbu mmadụ, gị onye ọjọọ!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.8",
                "verseOrgIds": [
                  "2SA.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "akwụghachila gị ụgwọ ọbara niile ị wụsiri nʼezinaụlọ Sọl, onye ị nọchiri ọnọdụ ya dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.8",
                "verseOrgIds": [
                  "2SA.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "anapụla gị alaeze ahụ, were ya nye Absalọm nwa gị! Ugbu a, ihe i metara abịala gị ụgwọ, gị ogbu mmadụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.8",
            "verseOrgIds": [
              "2SA.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abishai, nwa Zeruaya",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        },
        {
          "text": "gwara eze okwu sị, \"Nʼihi gịnị ka nkịta a nwụrụ anwụ ga-eji na-akọcha onyenwe m bụ eze? Biko, ka m gafee gaa bipụ ya isi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze zara sị, \"Gịnị jikọrọ mụ na unu, unu ụmụ ndị ikom Zeruaya. Ọ bụrụ na ọ na-akọcha m nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.10",
                "verseOrgIds": [
                  "2SA.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "sị ya 'Kọchaa Devid,' onye pụrụ ịjụ ajụjụ sị, 'Gịnị mere ị ji na-eme ihe dị otu a?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid gwara Abishai na ndị ozi ya okwu sị, \"Nwa m nwoke, onye si nʼahụ m na-agbalị ịnapụ m ndụ m. Gịnị ga-eme ka onye Benjamin a ghara ime karịa? Hapụ ya, ya kọchaa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.11",
                "verseOrgIds": [
                  "2SA.16.11"
                ]
              }
            }
          ]
        },
        {
          "text": "agwala ya ka ọ kọchaa m.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eleghị anya,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.12",
                "verseOrgIds": [
                  "2SA.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahụ ọnọdụ ahụhụ m, nyeghachikwa m ngọzị nʼọnọdụ nkọcha ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Devid na ndị ya gakwara nʼihu ije ha nʼụzọ ahụ ma Shimei sokwara ha na-aga nʼakụkụ ugwu ahụ na-akọcha ha. Ọ nọgidekwara na-atụ Devid nkume, na-ekpolikwa aja elu ka ọ na-awụsa ha nʼahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.13",
            "verseOrgIds": [
              "2SA.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze na ndị niile so ya gagidere bịaruo nʼakụkụ Jọdan nʼọnọdụ ike ọgwụgwụ. Nʼihi ya, ha nọdụrụ nʼebe ahụ zuo ike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.14",
            "verseOrgIds": [
              "2SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndụmọdụ Hushaị na Ahitofel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Absalọm na ndị Izrel abatalarị Jerusalem. Ahitofel sokwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.15",
            "verseOrgIds": [
              "2SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hushaị, enyi Devid, onye Akai bịaruru, ọ gara hụ Absalọm sị ya, \"Ka eze dị ogologo ndụ, ka eze dị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
            "verseOrgIds": [
              "2SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm sịrị Hushaị, \"Ọ bụ otu a ka i si egosi ịhụnanya i nwere na-ebe enyi gị nọ? Gịnị mere i soghị ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.17",
            "verseOrgIds": [
              "2SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushaị zara Absalọm sị, \"Mba! Onye ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.16.18",
                "verseOrgIds": [
                  "2SA.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "na ọha mmadụ na ndị Izrel niile họpụtara, nke onye ahụ ka m ga-abụ. Ọ bụkwa onye ahụ ka m ga-adịnyere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.18",
            "verseOrgIds": [
              "2SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye kwanụ ka m kwesiri ijere ozi? Ọ bụghị nwa eze? Ejeere m nna gị ozi, ugbu a anọkwa m jikere ijere gị ozi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
            "verseOrgIds": [
              "2SA.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm tụgharịrị gwa Ahitofel okwu sị, \"Gịnị ọzọ ka m ga-eme? Nye anyị ndụmọdụ gị. Gịnị ka anyị kwesiri ime?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.20",
            "verseOrgIds": [
              "2SA.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahitofel zara, \"Ga dinaa ndị iko nwanyị nna gị ndị ahụ ọ hapụrụ ka ha lekọtaa ụlọ. Mgbe ahụ, Izrel niile ga-anụ na ị meela onwe gị ihe na-asọ oyi nʼebe nna gị nọ, aka ndị niile nọnyere gị ga-akwụkwa chịm.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.21",
            "verseOrgIds": [
              "2SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha manyeere Absalọm ụlọ ikwu nʼelu ụlọ; ọ kpọkwaara ndị iko nwanyị nna ya dinaa ha nʼotu nʼotu, nʼihu ndị Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ndụmọdụ ọbụla Ahitofel dụrụ dị ka a ga-asị na ọ bụ ozi si nʼọnụ Chineke nʼonwe ya bịa. Ọ bụladị nʼebe Devid nọ, na nʼebe Absalọm nọkwa, otu a ka esi bulie ndụmọdụ ọbụla Ahitofel nyere elu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.23",
            "verseOrgIds": [
              "2SA.16.23"
            ]
          }
        }
      ]
    }
