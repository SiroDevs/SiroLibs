  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1TH 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibi ndụ na-atọ Chineke ụtọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, ụmụnna anyị, anyị na-arịọ ma na-akwagidekwa unu nʼime Onyenwe anyị Jisọs, dị ka unu mụtara site nʼaka anyị otu unu kwesiri isi bie ndụ, nakwa ime ihe ga-atọ Chineke ụtọ. Unu na-eme nke a karịa.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na unu maara ụdị ndụmọdụ ahụ sị nʼaka Onyenwe anyị Jisọs nke anyị nyere unu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke a bụ ọchịchọ Chineke, bụ ị dị nsọ unu. Ka unu wezuga onwe unu site na ịkwa iko,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.3",
            "verseOrgIds": [
              "1TH.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka onye ọbụla nʼime unu mata ido ahụ nke onwe ya nʼugwu na nʼịdị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.4",
            "verseOrgIds": [
              "1TH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị nʼụzọ imejupụta ọchịchọ ọjọọ nke anụ ahụ dị ka ndị mba ọzọ na-amaghị Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka onye ọbụla ghara imegbu maọbụ ịghọgbu nwanna ya nʼokwu a. Nʼihi na Onyenwe anyị ga-ata onye na-eme ihe dị otu a ahụhụ, dị ka anyị gwara unu na mbụ, na-adọsikwa unu aka na ntị ike.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọkpụkpọ Chineke kpọrọ anyị abụghị ka anyị na-ebi ndụ adịghị ọcha kama ọ chọrọ ka anyị dịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.7",
            "verseOrgIds": [
              "1TH.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, onye ọbụla nke jụrụ ịnara ntụziaka a, ọ bụghị mmadụ ka ọ jụrụ, kama ọ bụ Chineke onye na-enye unu Mmụọ Nsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
            "verseOrgIds": [
              "1TH.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ihe gbasara ịhụnanya nke kwesiri ịdị nʼetiti ụmụnna, o kwesighị ka anyị gwa unu ihe ọzọ banyere ya. Nʼihi na unu onwe unu bụ ndị Chineke kuziri ka unu nwee ịhụnanya nʼebe ibe unu nọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
            "verseOrgIds": [
              "1TH.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼezie, unu na-ahụ ụmụnna anyị niile bi na Masidonia nʼanya. Ma anyị na-arịọsịkwa unu arịrịọ ike sị unu na-ahụkwa ha nʼanya karịa ka unu hụrụ ha ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.10",
            "verseOrgIds": [
              "1TH.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nweenụ agụụ ibi ndụ nwayọọ, na-arụkwanụ ọrụ dịịrị unu. Jirikwanụ aka unu na-arụ ọrụ dịka anyị gwara unu,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.11",
            "verseOrgIds": [
              "1TH.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke a ga-eme ka ndụ unu na-ebi kwa ụbọchị wetara unu nsọpụrụ nʼebe ndị na-ekweghị ekwe nọ, meekwa ka unu ghara i dabere nʼonye ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.12",
            "verseOrgIds": [
              "1TH.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọbịbịa nke Onyenwe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnna m, anyị chọrọ ka unu mata ihe banyere ndị otu anyị ndị dara nʼụra ọnwụ, ya ewutela unu dịka o si ewute ndị ọzọ ndị na-enweghị olileanya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.13",
            "verseOrgIds": [
              "1TH.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ebe ọ bụ na anyị kweere na Jisọs nwụrụ ma sitekwa nʼọnwụ bilie, nʼotu aka ahụ, anyị kwenyekwara na site na Jisọs, Chineke ga-akpọlite ndị niile nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.14",
            "verseOrgIds": [
              "1TH.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na okwu nke Onyenwe anyị nke anyị na-akụziri unu bụ nke a, na anyị ndị dị ndụ ruo ọbịbịa Onyenwe anyị agaghị ebu ndị dara nʼụra ọnwụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.15",
            "verseOrgIds": [
              "1TH.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Onyenwe anyị nʼonwe ya ga-esi nʼeluigwe rịdata, ọ ga-ewere olu ike kpọọ oku, werekwa olu nke onyeisi ndị mmụọ ozi na ụda opi ike nke Chineke. Mgbe ahụ ndị niile nwụrụ nʼime Kraịst ga-ebu ụzọ bilie.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.16",
            "verseOrgIds": [
              "1TH.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anyị onwe anyị, ndị dị ndụ, ndị fọdụrụ nʼụwa, ka a ga-eweli anyị na ha elu nʼime igwe ojii, ịga izute Onyenwe anyị na mbara eluigwe, ebe anyị na Onyenwe anyị ga-anọ ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.17",
            "verseOrgIds": [
              "1TH.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, werenụ okwu ndị a, na-agba onwe unu ume mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.18",
            "verseOrgIds": [
              "1TH.4.18"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1TH.5",
