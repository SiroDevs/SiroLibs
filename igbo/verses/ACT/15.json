{
  "id": "ACT.15",
  "number": "15",
  "bookId": "ACT",
  "reference": "Ọrụ Ndị Ozi 15",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "ACT 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzukọ dị mkpa na Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ ndị ikom sitere Judịa bịa malitere izi ụmụnna ozi, \"Ọ bụrụ na e bighị unu ugwu dịka Mosis nyere nʼiwu, a pụghị ịzọpụta unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.1",
            "verseOrgIds": [
              "ACT.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na Pọl na Banabas rụrịtara ụka nke ukwuu. Nʼihi nke a, ha kpebiri ka Pọl na Banabas, na ụfọdụ ndịisi ndị ọzọ soro gaa Jerusalem hụ ndị ozi na ndị okenye nke nzukọ maka okwu a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.2",
            "verseOrgIds": [
              "ACT.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzukọ ahụ zipụrụ ha nʼụzọ ha, mgbe ha sitere Fonisia na Sameria na-agafe, ha kọrọ otu ndị mba ọzọ siri chegharịa. Nke a wetara ndị niile kwere ekwe oke ọṅụ dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.3",
            "verseOrgIds": [
              "ACT.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịaruru Jerusalem, nzukọ, ndị ozi na ndị okenye nabatara ha, ha kọkwara ha ihe niile Chineke sitere nʼaka ha mee.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.4",
            "verseOrgIds": [
              "ACT.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụfọdụ ndị kwere ekwe si nʼotu ndị Farisii biliri na-ekwu sị, \"Na ọ dị mkpa ka e bie ha ugwu ma gwakwa ha ka ha dobe iwu Mosis.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.5",
            "verseOrgIds": [
              "ACT.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ozi na ndị okenye zukọtara itule okwu a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.6",
            "verseOrgIds": [
              "ACT.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nọ tulegide okwu ahụ ruo oge dị anya, Pita guzoro ọtọ sị ha, \"Ụmụnna m, unu niile maara na site na mbụ Chineke họpụtara m site nʼetiti unu, ka m zisaa oziọma ahụ nye ndị mba ọzọ ka ha nụrụ, ma kwerekwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.7",
            "verseOrgIds": [
              "ACT.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke a, onye maara obi mmadụ niile gbaara ha akaebe site nʼinye ha onyinye Mmụọ Nsọ dịka anyị si nata ya na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.8",
            "verseOrgIds": [
              "ACT.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O gosighị na o nwere ihe dị iche nʼetiti anyị na ha. Nʼihi na o mere ka obi ha dị ọcha site nʼokwukwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.9",
            "verseOrgIds": [
              "ACT.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, gịnị mere unu ji anwa Chineke ọnwụnwa site na-itinye nʼolu ndị na-eso ụzọ ya ibu arọ nke anyị maọbụ nna nna anyị ha na-enweghị ike ịdọkpụ?",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.10",
            "verseOrgIds": [
              "ACT.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba, anyị kwenyere na ọ bụ site nʼamara nke Onyenwe anyị Jisọs ka a ga-eji zọpụta anyị, dịka a ga-esi zọpụtakwa ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.11",
            "verseOrgIds": [
              "ACT.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ niile nọdụrụ nwayọọ, ha bidoro ige ntị nʼakụkọ Banabas na Pọl na-akọrọ ha banyere ihe ịrịbama niile na ọrụ ebube niile Chineke jiri ha rụọ nʼetiti ndị mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.12",
            "verseOrgIds": [
              "ACT.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha kwusiri okwu ndị a, Jemis sịrị, \"Ụmụnna m geenụ ntị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.13",
            "verseOrgIds": [
              "ACT.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn akọọlara anyị otu Chineke si buru ụzọ lekọta ndị mba ọzọ site na isite nʼetiti ha họpụtara onwe ya ndị ga-ekwere na aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.14",
            "verseOrgIds": [
              "ACT.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a na okwu ndị amụma dakọtara, dịka e dere ya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.15",
            "verseOrgIds": [
              "ACT.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe nke a gasịrị, aga m alọghachi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "aga m ewughachikwa ụlọ ikwu Devid nke dara ada.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "Ebe ya niile dakpọsịrị adakpọsị ka m ga-ewugharịkwa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:16"
      },
      "items": [
        {
          "text": "aga m emekwa ka ọ guzozie,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.16",
            "verseOrgIds": [
              "ACT.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ndị fọdụrụ nʼetiti mmadụ nwe ike chọọ Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 15:17"
      },
      "items": [
        {
          "text": "ọ bụladị ndị mba ọzọ niile ndị a kpọkwasịrị aha m,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 15:17"
      },
      "items": [
        {
          "text": "ka Onyenwe anyị kwuru, onye na-emekwa ihe ndị a.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.17",
            "verseOrgIds": [
              "ACT.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a amaara site na mgbe ochie.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.18",
            "verseOrgIds": [
              "ACT.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi nke a, mkpebi ikpe m bụ nke a, ka anyị ghara isogbu ndị mba ọzọ lọghachikwutere Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.19",
            "verseOrgIds": [
              "ACT.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama o kwesiri ka anyị degara ha akwụkwọ gwa ha sị ha hapụ iri nri ọbụla e ji chụọrọ arụsị aja. Ka ha wezugakwa onwe ha site na mmehie ịkwa iko, ya na iri anụ a nyagburu anyagbu, maọbụ ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.20",
            "verseOrgIds": [
              "ACT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na mbụ, Mosis nwere ndị na-ekwusa iwu nʼobodo niile. A na-agụkwa ya nʼụlọ nzukọ nʼụbọchị izuike niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwụkwọ e degaara ndị mba ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị ozi na ndị okenye, ha na nzukọ niile, kpebiri ka a họpụta ndị ikom a ga-eziga Antiọk ha na Pọl na Banabas. Ha họpụtara Judas onye a na-akpọkwa Basabas, na Saịlas, ndị ndu so nʼetiti ụmụnna.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nyekwara ha nʼakwụkwọ ozi dị otu a,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "Akwụkwọ a sitere nʼaka ndị ozi, na ndị okenye ndị bụ ụmụnna unu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "A na-edetara ya unu ndị sitere na mba ọzọ kwere bụ ndị nọ nʼAntiọk, Siria na Silisia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 15:23"
      },
      "items": [
        {
          "text": "Ekele.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mere ka anyị mata na ụfọdụ ndị otu anyị ebuterela unu nsogbu na ọgbaaghara, mee ka obi lọọ unu mmiri, na-emebi mkpụrụobi unu. Ma nʼezie, ha anataghị ike nʼaka anyị ime nke a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.24",
            "verseOrgIds": [
              "ACT.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, anyị zukọrọ, sitekwa nʼotu obi kpebie ịhọpụta ụfọdụ ndị ikom na izitere unu ha, ha na ndị anyị hụrụ nʼanya, bụ Pọl na Banabas,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.25",
            "verseOrgIds": [
              "ACT.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị ikom werela ndụ ha tụnye nʼaha Onyenwe anyị Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.26",
            "verseOrgIds": [
              "ACT.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anyị na-ezite Judas na Saịlas ndị ga-akọwara unu nʼihu nʼihu, ihe anyị dere nʼakwụkwọ a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.27",
            "verseOrgIds": [
              "ACT.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ ihe ziri ezi nʼanya Mmụọ Nsọ na nʼanya anyị kwa, na o kwesighị ka anyị bokwasị unu ibu arọ karịa ihe ndị a dị mkpa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.28",
            "verseOrgIds": [
              "ACT.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o kwesiri ka unu hapụ iri ihe ọbụla e jiri chụọ aja nye arụsị, ya na iri anụ ọbụla a nyagburu anyagbu, maọbụ ọbara. Kewapụkwanụ onwe unu site nʼịkwa iko. Ọ bụrụ na unu eme ihe ndị a, unu mere nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmc",
        "vid": "ACT 15:29"
      },
      "items": [
        {
          "text": "Nọọnụ nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.29",
            "verseOrgIds": [
              "ACT.15.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e zipụrụ ha, ha jeruokwa Antiọk. Mgbe ha kpọkọrọ nzukọ ahụ, ha nyere ha akwụkwọ ozi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.30",
            "verseOrgIds": [
              "ACT.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị otu ọgbakọ ahụ gụsịrị ya, ha ṅụrịrị ọṅụ nke ukwuu nʼihi agbamume ha natara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.31",
            "verseOrgIds": [
              "ACT.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Judas na Saịlas, ndị ha onwe ha bụ ndị amụma, kwuru ọtụtụ okwu, iji gbaa ha ume na ime ka okwukwe ndị kwere ekwe guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.32",
            "verseOrgIds": [
              "ACT.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nọnyesịrị ha nwa oge nta, ndị kwere ekwe ji ngọzị nke udo zilaga ha ka ha laghachikwuru ndị zitere ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.33",
            "verseOrgIds": [
              "ACT.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ masịrị Saịlas ịnọtukwu nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.34",
            "verseOrgIds": [
              "ACT.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl na Banabas nọgidere nʼAntiọk, ebe ha na ndị ọzọ kuziri ihe ma kwusakwa okwu Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.35",
            "verseOrgIds": [
              "ACT.15.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkewa nke dị nʼetiti Pọl na Banabas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ole na ole gasịrị, Pọl gwara Banabas, \"Ka anyị gaghachi nʼobodo niile anyị kwusara okwu Onyenwe anyị nʼotu nʼotu, mata ka ndị kwere ekwe si agbalị nʼebe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banabas chọrọ ka ha na Jọn onye a na-akpọ Mak soro gaa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.37",
            "verseOrgIds": [
              "ACT.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl echeghị na o ziri ezi iduru ya nʼihi na ọ hapụrụ ha na Pamfilia. O sokwaghị ha jezuo ozi ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.38",
            "verseOrgIds": [
              "ACT.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịrụ ụka dapụtara nʼetiti ha siri ike nke mere na ha kewara. Banabas kpọrọ Jọn Mak banye nʼụgbọ gawa Saiprọs.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.39",
            "verseOrgIds": [
              "ACT.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl họọrọ Saịlas, kpọrọ ya gawa njem, mgbe ụmụnna kpesịrị ha ekpere raara ha nye nʼamara Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.40",
            "verseOrgIds": [
              "ACT.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jegharịrị nʼime obodo Siria na Silisia na-agba nzukọ nọ nʼebe ahụ ume.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.41",
            "verseOrgIds": [
              "ACT.15.41"
            ]
          }
        }
      ]
    }
  ],
