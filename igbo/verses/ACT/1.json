{
  "id": "ACT.1",
  "number": "1",
  "bookId": "ACT",
  "reference": "Ọrụ Ndị Ozi 1",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "ACT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs alaa nʼeluigwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezigbo enyi m Tiofilọs, nʼakwụkwọ m nke mbụ m dere gị banyere ihe niile Jisọs malitere ime nakwa ikuzi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.1",
            "verseOrgIds": [
              "ACT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruo nʼụbọchị e mere ka ọ laghachi nʼeluigwe mgbe o sitere nʼike Mmụọ nsọ nyesịa ndị na-eso ụzọ ya iwu, bụ ndị ọ họpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.2",
            "verseOrgIds": [
              "ACT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụsịrị ahụhụ nke ọnwụ, o gosiri ha onwe ya nʼụzọ dị iche iche nʼebe o doro anya na ya dị ndụ. O mere ka ha hụ ya anya nʼime iri ụbọchị anọ, na-akụziri ha banyere alaeze Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.3",
            "verseOrgIds": [
              "ACT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu oge, ọ nọnyeere ha na nri, o nyere ha iwu a,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu esila na Jerusalem pụọ, kama cherenụ nkwa nke Nna m, nke unu nụrụ site nʼọnụ m.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.1.4",
                "verseOrgIds": [
                  "ACT.1.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.4",
            "verseOrgIds": [
              "ACT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na Jọn jiri mmiri mee unu baptizim, ma nʼoge na-adịghị anya, a ga-eji Mmụọ Nsọ mee unu baptizim.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.1.5",
                "verseOrgIds": [
                  "ACT.1.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gbakọrọ, ha jụrụ ya, \"Onyenwe anyị, ọ bụ ugbu a ka i ga-enyeghachi Izrel alaeze ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụghị ọrụ unu ịmata oge na mgbe Nna m na-akwado ihe o zubere ime nʼikike nke onwe ya.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.1.7",
                "verseOrgIds": [
                  "ACT.1.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mgbe Mmụọ Nsọ bịakwasịrị unu, unu ga-anata ike. Mgbe ahụ, unu ga-agbara m ama na Jerusalem, na Judịa niile ya na Sameria ruokwa ebe niile ụwa sọtụrụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.1.8",
                "verseOrgIds": [
                  "ACT.1.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwusiri nke a, e weliri ya elu mgbe ha na-ele anya, igwe ojii kpuchikwara ya, zopu ya nʼanya ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
              "ACT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-elegidesi anya ike nʼeluigwe dịka ọ na-ala, na mberede, ụmụ nwoke abụọ yi uwe ọcha guzooro ha nso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.10",
            "verseOrgIds": [
              "ACT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị, \"Ndị ikom Galili, gịnị mere unu jiri guzoro ebe a na-ele anya nʼeluigwe? Jisọs a onye e sitere nʼetiti unu kpọrọ laa nʼeluigwe ga-alọghachikwa otu ahụ unu si hụ ya o siri laa nʼeluigwe.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.11",
            "verseOrgIds": [
              "ACT.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mataias, onye nọchiri anya Judas",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sitere nʼUgwu a na-akpọ Oliv nke dị Jerusalem nso, njem nke otu ụbọchị izuike, laghachi na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha batara nʼobodo, ha rigoro nʼime ụlọ ahụ dị nʼụlọ elu, ebe ha na-anọ. Ndị a bụ ndị nọ nʼụlọ ahụ:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "ACT 1:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Pita, Jọn, Jemis na Andru,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Filip na Tọmọs,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Batalomi na Matiu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "ACT 1:13"
      },
      "items": [
        {
          "text": "Jemis nwa Alfiọs, Saimọn onye a na-akpọ Zilọt na Judas nwa Jemis.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a niile ji otu obi nọgidesie ike nʼekpere. Ndị sonyere ha bụ ụfọdụ ndị inyom na Meri nne Jisọs, na ụmụnna ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
            "verseOrgIds": [
              "ACT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Pita bilitere nʼetiti ndị kwere ekwe ọnụọgụgụ ha dị ihe dị ka narị na iri abụọ, sị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
            "verseOrgIds": [
              "ACT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụmụnna m, ọ dị mkpa ka ihe e dere nʼakwụkwọ nsọ mezuo banyere Judas onye duuru ndị jidere Jisọs bịa. Mmụọ Nsọ kwuru na nke a ga-eme mgbe o sitere nʼọnụ Devid kwuo okwu nʼoge gara aga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.16",
            "verseOrgIds": [
              "ACT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ otu nʼime anyị. O nwere oke nʼime ọrụ a.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.17",
            "verseOrgIds": [
              "ACT.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ego ọ natara nʼihi ọrụ ọjọọ ya ka o jiri zụọ ala. Nʼala ahụ ka ọ dara sụọ isi nʼala, afọ ya etipuo, eriri afọ ya awụsịakwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.18",
            "verseOrgIds": [
              "ACT.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile bi na Jerusalem nụrụ akụkọ banyere ya. Nʼihi ya, ha kpọrọ ala ahụ nʼasụsụ ha Akeldama, nke pụtara Ala Ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.19",
            "verseOrgIds": [
              "ACT.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita sịrị, \"Nʼihi na e dere ya nʼakwụkwọ Abụ Ọma:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "\" 'Ka ebe obibi ya tọgbọrọ nʼefu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "ka mmadụ ọbụla gharakwa ibi nʼime ya,'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "na,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ACT 1:20"
      },
      "items": [
        {
          "text": "\" 'Ka onye ọzọ nọchiekwa ọnọdụ ya ka onyeisi.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.20",
            "verseOrgIds": [
              "ACT.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, otu onye nʼime ndị anyị na ha nọ nʼoge niile Onyenwe anyị Jisọs nọ nʼetiti anyị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.21",
            "verseOrgIds": [
              "ACT.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
