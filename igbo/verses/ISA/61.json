  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "61",
        "style": "c",
        "sid": "ISA 61"
      },
      "items": [
        {
          "text": "61",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afọ ngosi ihuọma Onyenwe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 61:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ nke Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.61.1",
                "verseOrgIds": [
                  "ISA.61.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dị nʼahụ m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.61.1",
                "verseOrgIds": [
                  "ISA.61.1"
                ]
              }
            }
          ]
        },
        {
          "text": "eteela m mmanụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "ka m kwusaa oziọma nye ndị ogbenye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "O zitela m ịkasị ndị obi ha tiwara etiwa obi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "ikwupụta inwere onwe nye ndị a dọtara nʼagha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:1"
      },
      "items": [
        {
          "text": "na ntọghapụ site nʼọchịchịrị nye ndị mkpọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 61:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zitere m ikwupụta afọ mgbe Onyenwe anyị ga-eji ihuọma leta ndị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "na ụbọchị ịbọ ọbọ nke Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:2"
      },
      "items": [
        {
          "text": "O zitekwara m ịkasị ndị niile na-eru ụjụ obi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 61:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na igboro ndị niile na-eru ụjụ na Zayọn ihe na-akpa ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "O zitere m inye ha okpueze mara mma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "nʼọnọdụ ntụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "inye ha ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "nʼọnọdụ ịkwa akwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "na iyikwasị ha mmụọ otuto",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "nʼọnọdụ mmụọ ịda mba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "Nʼihi na Chineke akụọla ezi omume nʼime ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "dịka osisi ook siri ike,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:3"
      },
      "items": [
        {
          "text": "igosi ịma mma",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.61.3",
                "verseOrgIds": [
                  "ISA.61.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ewugharịkwa ebe niile e tikpọrọ etikpọ nʼoge ochie,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "doziekwa ebe niile tọgbọrọ nʼefu site nʼoge dị anya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "ha ga-eme ka obodo e tikpọrọ etikpọ dị ọhụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:4"
      },
      "items": [
        {
          "text": "bụ ebe tọgbọrọrị nʼefu nke ọtụtụ ọgbọ gara aga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 61:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbịa ga-azụrụ gị igwe ewu na atụrụ unu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:5"
      },
      "items": [
        {
          "text": "ndị mba ọzọ ga-akọrọ unu ala ubi unu, lekọtakwa ubi vaịnị unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 61:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-akpọ unu ndị nchụaja",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.61.6",
                "verseOrgIds": [
                  "ISA.61.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "kpọkwa unu ndị ozi Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "A ga-eji akụ niile si na mba dị iche iche zụọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:6"
      },
      "items": [
        {
          "text": "Ọ bụkwa akụnụba ha ka unu ga-eji nyaa isi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.6",
            "verseOrgIds": [
              "ISA.61.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 61:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnọdụ ihere dịịrị ha ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "ndị m ga-enweta ngọzị okpukpu abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "nʼọnọdụ nkọcha dịịrị ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "ha ga-aṅụrị ọṅụ nʼihi ihe nketa ha nwetara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "Ha ga-enweta okpukpu ihe nketa ala abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 61:7"
      },
      "items": [
        {
          "text": "ketakwa ọṅụ nke ga-adịgidere ha ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.7",
            "verseOrgIds": [
              "ISA.61.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 61:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi na mụ onwe m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.8",
            "verseOrgIds": [
              "ISA.61.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
