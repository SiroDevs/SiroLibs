      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amụma e buru banyere Moab",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amụma megide Moab:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Ar dị na Moab a laala nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "a lara ya nʼiyi naanị nʼotu abalị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "Kia dị na Moab a laala nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:1"
      },
      "items": [
        {
          "text": "a lara ya nʼiyi naanị nʼotu abalị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.1",
            "verseOrgIds": [
              "ISA.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile bi na Dibọn",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "na-aga nʼihu ụlọ mmụọ ha ịkwa akwa. Ndị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Moab na-akwa akwa nʼihi Nebo na Medeba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "Isi ha niile bụ isi nkwọcha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:2"
      },
      "items": [
        {
          "text": "afụọnụ ha niile ka akpụchakwara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.2",
            "verseOrgIds": [
              "ISA.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eyi akwa mkpe na-agagharị nʼezi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "mkpu akwa na-ada nʼelu ụlọ, na nʼama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "Ha niile ji iti mkpu na ịkwa akwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:3"
      },
      "items": [
        {
          "text": "na-ada nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.3",
            "verseOrgIds": [
              "ISA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshbọn na Eleale na-eti mkpu akwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "a na-anụ olu akwa ha ọ bụladị ruo Jehaz.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "Nʼihi nke a, ndị agha Moab na-eti mkpu akwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:4"
      },
      "items": [
        {
          "text": "mkpụrụobi ha na-amakwa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.4",
            "verseOrgIds": [
              "ISA.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ewute mkpụrụobi m nʼihi Moab,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "ndị ya na-agba ọsọ ruo ọ bụladị nʼobodo Zoa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "na Eglat Shelishiya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "Ha na-akwa akwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "dịka ha na-arịgo Luhit.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "Mgbe ha na-agbago ụzọ Heronaim,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:5"
      },
      "items": [
        {
          "text": "ha na-ebe akwa mwute nʼihi mbibi bịakwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.5",
            "verseOrgIds": [
              "ISA.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri Nimrim atachaala!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "Ahịhịa akpọnwụọkwala;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "ahịhịa ndụ niile agwụkwala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:6"
      },
      "items": [
        {
          "text": "o nwekwaghị akwụkwọ ndụ nke fọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.6",
            "verseOrgIds": [
              "ISA.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere akụnụba ha kpakọbara ndị ha chekwara",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:7"
      },
      "items": [
        {
          "text": "ka ha buuru gafee ofe ndagwurugwu warawara nke ọdọ mmiri osisi pọpla niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.7",
            "verseOrgIds": [
              "ISA.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpu akwa ha na-ada ụda gburugburu oke ala Moab niile;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:8"
      },
      "items": [
        {
          "text": "akwa ha na-ebesi ike na-ada ruo obodo Eglaim;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:8"
      },
      "items": [
        {
          "text": "abụ akwa ha na-erukwa Bịa-Elim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.8",
            "verseOrgIds": [
              "ISA.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi Dibọn jupụtara nʼọbara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "ma aga m atụkwasịkwa ọ bụladị ọtụtụ ihe ndị ọzọ nʼelu Dibọn!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "Ọdụm ka a ga-atụkwasịrị ndị Moab",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        },
        {
          "text": "gbapụrụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 15:9"
      },
      "items": [
        {
          "text": "tụkwasịkwara ndị fọdụrụ nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.15.9",
            "verseOrgIds": [
              "ISA.15.9"
            ]
          }
        }
      ]
    }
  ],
