  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "ISA 46"
      },
      "items": [
        {
          "text": "46",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chi dị iche iche nke ndị Babilọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bel na Nebo, arụsị ndị Babilọn makpu amakpu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Lee, arụsị niile ha ka ebukwasịrị ha nʼazụ ịnyịnya ibu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "Arụsị niile apịrị apị bụ nke a na-ebugharị bụ ibu dị arọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:1"
      },
      "items": [
        {
          "text": "ibu arụ nye ụmụ anụmanụ na-ada mba!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha makpuuru, rudakọkwa ala nʼotu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "ha enweghị ike iwezuga ibu ndị a nʼonwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:2"
      },
      "items": [
        {
          "text": "ha onwe ha kwa, a dọtala ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Geenụ m ntị, unu ụmụ ụmụ Jekọb,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "unu ndị fọdụrụ nʼụlọ Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "unu bụ ndị m na-elekọta siterị na mgbe a mụrụ unu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:3"
      },
      "items": [
        {
          "text": "na-akpọgharịkwa unu siterị na mgbe amụpụtara unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.3",
            "verseOrgIds": [
              "ISA.46.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m, bụ onye ahụ, ọ bụ m ga-elekọtakwa unu anya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "ọ bụladị ruo mgbe isi awọ jupụtara unu nʼisi, nʼagadi unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Nʼihi na ọ bụ m kere unu, aga m elekọtakwa unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:4"
      },
      "items": [
        {
          "text": "Aga m agba unu ume, bụrụkwa onye nzọpụta unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.4",
            "verseOrgIds": [
              "ISA.46.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ka unu ga-asị na o yiri m? Onye kwa ka mụ na ya ha?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:5"
      },
      "items": [
        {
          "text": "Onye ka unu ga-eji tụnyere m?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.5",
            "verseOrgIds": [
              "ISA.46.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ mmadụ na-emeghe akpa ego ha wụpụta ọlaedo dị nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "na-atụpụtakwa ọlaọcha nʼihe ọtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "were ya goo onye ọkpụ ụzụ ọlaedo ka o jiri ya kpụọrọ ha chi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:6"
      },
      "items": [
        {
          "text": "emesịa, ha na-akpọ isiala na-efe arụsị ahụ ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.6",
            "verseOrgIds": [
              "ISA.46.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-ebuli arụsị ahụ buru ya nʼubu ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "buru ya debe ya nʼọnọdụ ya, nʼebe ahụ ka ọ na-akwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Ọ dịghị apụ site nʼebe ahụ jegharịa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "Ọ bụrụ na mmadụ e tikuo ya mkpu, ọ gaghị aza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:7"
      },
      "items": [
        {
          "text": "ọ pụghị ịzọpụtakwa ha pụọ na nsogbu ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.7",
            "verseOrgIds": [
              "ISA.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chetanụ nke a, ma tuleekwa ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:8"
      },
      "items": [
        {
          "text": "ka ọ dịgidekwa unu nʼobi, unu ndị na-enupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.8",
            "verseOrgIds": [
              "ISA.46.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chetakwanụ ihe ndị ahụ niile mere nʼoge gara aga,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "nʼihi na abụ m Chineke, chi ọzọ adịghịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:9"
      },
      "items": [
        {
          "text": "Naanị m bụ Chineke, ọ dịkwaghị onye ọzọ dị ka m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.9",
            "verseOrgIds": [
              "ISA.46.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ m na-egosi ikpeazụ site na mmalite,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "ọ bụ m na-ekwu site na mgbe ochie ihe ga-eme nʼọdịnihu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Ana m asị, 'nzube m ga-eguzogide.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:10"
      },
      "items": [
        {
          "text": "Ọ bụkwa ihe dị m mma nʼobi ka m ga-eme.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m esite nʼọwụwa anyanwụ kpọọ anụ ufe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "e, sitekwa nʼala ebe dị anya kpọọ nwoke",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        },
        {
          "text": "ahụ ga-abịa mee nzube m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "Nʼihi na ihe m kwuru ya ka m ga-eme ka o mezuo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 46:11"
      },
      "items": [
        {
          "text": "ọ bụkwa atụmatụ m ka m ga-emekwa.",
