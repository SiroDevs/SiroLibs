  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "50",
        "style": "c",
        "sid": "ISA 50"
      },
      "items": [
        {
          "text": "50",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmehie Izrel na nrube isi nke ohu ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.50.1",
                "verseOrgIds": [
                  "ISA.50.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "\"Olee ebe akwụkwọ m ji gbaa nne unu alụkwaghị m dị",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "bụ nke m ji chụpụ ya?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Ma ọ bụ onye nʼime ndị m ji ụgwọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "ka m resiri unu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "Ọ bụ nʼihi mmehie unu ka e ji ree unu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:1"
      },
      "items": [
        {
          "text": "nʼihi mmebi iwu unu ka e jiri chụọ nne unu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.1",
            "verseOrgIds": [
              "ISA.50.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere o ji bụrụ na o nweghị onye nọ ya mgbe m bịara?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Gịnị mere o nweghị onye zara m mgbe m kpọrọ oku?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Ọ pụtara na aka m dị mkpụmkpụ ịzọpụta unu?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Ọ ga-abụ na m enwekwaghị ike ịzọpụta?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Nʼihi na enwere m ike ịbara osimiri mba mee ya ka ọ ghọọ ala akọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "Enwere m ike ime ka osimiri ghọrọ ọzara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "ka azụ niile dị nʼime ya nwụọ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:2"
      },
      "items": [
        {
          "text": "nʼihi enweghị mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.2",
            "verseOrgIds": [
              "ISA.50.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ mụ bụ onye ahụ na-eme ka ọchịchịrị kpuchie ihu eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:3"
      },
      "items": [
        {
          "text": "ka ihu eluigwe dịrị ka ihu onye na-eru ụjụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.3",
            "verseOrgIds": [
              "ISA.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.50.4",
                "verseOrgIds": [
                  "ISA.50.4"
                ]
              }
            }
          ]
        },
        {
          "text": "enyela m amamihe ya",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "ka m nwee ike ịmata ihe m ga-agwa ndị a ike gwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "Ụtụtụ niile ka ọ na-akpọte mmụọ m,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:4"
      },
      "items": [
        {
          "text": "meghee akpa uche m, ime ka m ghọta uche ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.4",
            "verseOrgIds": [
              "ISA.50.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.50.5",
                "verseOrgIds": [
                  "ISA.50.5"
                ]
              }
            }
          ]
        },
        {
          "text": "emeghela ntị m abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "ma enupughị m isi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:5"
      },
      "items": [
        {
          "text": "a tụgharịkwaghị m azụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.5",
            "verseOrgIds": [
              "ISA.50.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụ m ka m megheere ndị tiri m ihe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "agba nti m abụọ ka m hapụụrụ ndị hopusiri m afụọnụ m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "Ezopụghị m ihu m",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:6"
      },
      "items": [
        {
          "text": "nʼebe ndị na-akwa emo, na ndị na-agbụ ọnụ mmiri nọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.6",
            "verseOrgIds": [
              "ISA.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.50.7",
                "verseOrgIds": [
                  "ISA.50.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na-enyere m aka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "ihere agaghị eme m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "Nʼihi ya, ejikerela m onwe m ime uche ya; agaghị m elekwa anya nʼazụ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:7"
      },
      "items": [
        {
          "text": "a maara m na ihere agaghị eme m.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.7",
            "verseOrgIds": [
              "ISA.50.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye na-agụ m nʼonye ezi omume nọ nso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Onye ga-apụta ibo m ebubo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ya pụta ka anyị guzo ihu na ihu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Onye nwere ebubo megide m?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 50:8"
      },
      "items": [
        {
          "text": "Ya bịa ka anyị kwuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.50.8",
            "verseOrgIds": [
              "ISA.50.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
