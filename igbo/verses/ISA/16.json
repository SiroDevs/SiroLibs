        {
          "text": "na-ekwu, sị, \"Tupu afọ atọ agachaa, dịka onye e goro ọrụ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.14",
            "verseOrgIds": [
              "ISA.16.14"
            ]
