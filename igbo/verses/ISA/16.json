        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "nʼihi na emeela m ka iti mkpu ọṅụ niile kwụsị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
