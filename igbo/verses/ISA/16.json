              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewepụla ọṅụ na obi ụtọ site nʼubi na-amị mkpụrụ ọma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
