      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye na-azọchapụta mmanya m vaịnị nʼebe ịzọcha mmanya;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
