              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m na-enwe mwute nʼihi Moab dịka ụbọ akwara,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
