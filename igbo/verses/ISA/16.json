      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:12"
      },
      "items": [
        {
          "text": "ọ na-eme naanị ka ike gwụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        }
      ]
