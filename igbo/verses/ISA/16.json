        "style": "q2",
        "vid": "ISA 16:11"
      },
      "items": [
        {
          "text": "ime mmụọ m kwa nʼihi Kia Heres.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
