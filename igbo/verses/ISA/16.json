    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 16:10"
      },
      "items": [
        {
          "text": "ọ dịghị onye na-abụ maọbụ tie mkpu ọṅụ nʼubi vaịnị a gbara ogige;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        }
      ]
