      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 19:14"
      },
      "items": [
        {
          "text": "dịka onye ṅụbigara mmanya oke si adagharị nʼihe ọ gbọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.14",
            "verseOrgIds": [
              "ISA.19.14"
            ]
          }
        }
      ]
