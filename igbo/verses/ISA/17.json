{
  "id": "ISA.17",
  "number": "17",
  "bookId": "ISA",
  "reference": "Aịzaya 17",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "ISA 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozi e ziri banyere Damaskọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ amụma megide Damaskọs,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
          "text": "isi obodo Siria.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "\"Lee, Damaskọs agaghị adịkwa! Ọ gaghị abụkwa obodo ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:1"
      },
      "items": [
        {
          "text": "kama ọ ga-aghọ mkpọmkpọ ebe, nke zedara ezeda.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịkwaghị onye ga-ebi nʼime nʼobodo niile nke Aroea,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "ọ ga-adịrị igwe atụrụ na ehi dị iche iche, ndị ga-amakpu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:2"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye ga-eme ka egwu tụọ ha nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe e wusiri ike nke Ifrem agaghị adịkwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "ya na ike alaeze nke sị Damaskọs,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "ndị fọdụrụ nke Aram ga-adị ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "ebube nke ndị Izrel,\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:3"
      },
      "items": [
        {
          "text": "otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.17.3",
                "verseOrgIds": [
                  "ISA.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼụbọchị ahụ, a ga-eme ka nsọpụrụ Jekọb nwere bụrụ ihe e wedara nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:4"
      },
      "items": [
        {
          "text": "Abụba dịkwa ya nʼahụ ga-atalata.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.4",
            "verseOrgIds": [
              "ISA.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-adị ka ubi e si nʼime ya wee ihe mkpụrụ site nʼọka guzoro ọtọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "na-achịkọta mkpụrụ nʼogwe aka ha",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "dịka mgbe mmadụ na-atụtụkọta mkpụrụ site nʼigbo ọka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:5"
      },
      "items": [
        {
          "text": "nʼime Ndagwurugwu Refaim.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.5",
            "verseOrgIds": [
              "ISA.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ ole na ole nʼime mkpụrụ ahụ ga-afọdụkwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "dịka mgbe a kuchasịrị osisi oliv,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "hapụ mkpụrụ abụọ maọbụ atọ, nke dị nʼalaka kachasị elu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "maọbụ mkpụrụ anọ maọbụ ise a hapụrụ nʼọnụ ọnụ alaka nke ahụ mịrị mkpụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:6"
      },
      "items": [
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "ISA.17.6",
                "verseOrgIds": [
                  "ISA.17.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.6",
            "verseOrgIds": [
              "ISA.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ha ga-echeta onye kere ha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:7"
      },
      "items": [
        {
          "text": "nweekwa nsọpụrụ nʼebe Onye nsọ nke Izrel nọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.7",
            "verseOrgIds": [
              "ISA.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ha agaghị elekwasịkwa chi ha dị iche iche anya ka ha nyere ha aka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "Ha agakwaghị efe ihe ndị ahụ ha ji aka ha mee.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "Ha agakwaghị asọpụrụ chi nwanyị ha bụ Ashera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:8"
      },
      "items": [
        {
          "text": "maọbụ ebe ịchụ aja ụda na-esi isi ụtọ nke mkpịsịaka kpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, obodo ha niile e wusiri ike, nke ha hapụrụ nʼihi ndị Izrel, ga-adị ka ebe ahapụrụ ahapụ nye oke ọhịa na ahịhịa nke ọhịa. Ebe niile ga-abụ nnọọ mkpọmkpọ ebe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ị chezọla Chineke onye na-azọpụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "I chetaghị Nkume ahụ, nke bụ ebe mgbaba gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "Ya mere, ọ masịkwa gị kụọ ihe ọkụkụ dị iche iche nke dị ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:10"
      },
      "items": [
        {
          "text": "maọbụ manye alaka osisi vaịnị ị si nʼala ọzọ bubata,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụkwa na i mee ka ha too nʼụbọchị ahụ ị kụnyere ha nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "maọbụ na ha mara ifuru nʼụtụtụ ụbọchị ahụ ị kụnyere ha nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "ị gaghị aghọta mkpụrụ ọ mịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:11"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ naanị ọrịa na ihe mgbu ka ha ga-ewetara gị.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaa, lee ụzụ nke ọtụtụ mmadụ na-eme,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:12"
      },
      "items": [
        {
          "text": "nke yiri mkpọtụ oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:12"
      },
      "items": [
        {
          "text": "Ọ bụ mkpọtụ nke mba dị iche iche;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:12"
      },
      "items": [
        {
          "text": "ha na-eme mkpọtụ dị ka nnugharị nke ọtụtụ osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.12",
            "verseOrgIds": [
              "ISA.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ha na-agbọ ụja dịka mkpọtụ nke oke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:13"
      },
      "items": [
        {
          "text": "ma Chineke ga-abara ha mba nke ga-eme ka ha gbaa ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:13"
      },
      "items": [
        {
          "text": "A ga-achụsa ha dịka ifufe si efesa igbugbo ọka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:13"
      },
      "items": [
        {
          "text": "na dịka mpempe akwụkwọ ifufe siri ike na-ebugharị gburugburu gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanyasị, ha na-eme ka oke egwu dịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:14"
      },
      "items": [
        {
          "text": "tutu ruo ụtụtụ, ha adịghịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 17:14"
      },
      "items": [
        {
          "text": "Nke a bụ ihe nketa dịịrị ndị ahụ na-apụnara anyị ihe anyị nwere nʼike.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 17:14"
      },
      "items": [
        {
          "text": "E, ọ bụ ihe nza ruru ndị ahụ ji ike na-anakọrọ anyị ihe anyị nwere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
      ]
    }
