  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HAB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m arịgoro nʼelu ebe nche m,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "guzo onwe m nʼebe nchekwa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "Aga m echerekwa ịhụ ihe ọ ga-agwa m,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "na ihe m ga-asa, banyere mkpesa ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọsịsa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.2",
                "verseOrgIds": [
                  "HAB.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "zara m sị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "\"Dee ọhụ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
          "text": "ahụ nʼelu mbadamba nkume e ji ede ihe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "Depụta ya nke ọma,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "ka onye na-agba ọsọ nwee ike ịgụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e nwere ọhụ nke ga-adị ruo oge a kara aka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "ọ na-ekwu banyere oge ọgwụgwụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Ọ gaghị abụkwa ụgha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Ọ bụrụ na ọ dịka mmezu ya adịghị abịaru ọsịịsọ, chere mmezu ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "nʼihi na ọ ga-emesịa mezuo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "ọ gaghị anọ tee aka.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, onye iro na-afụli onwe ya elu;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "ọchịchọ ya ezikwaghị ezi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "ma onye ezi omume ga-esite nʼokwukwe",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        },
        {
          "text": "ya dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, mmanya",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        },
        {
          "text": "na-eduhie ya ụzọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "onye jupụtara na nganga, na-adịghị enwe ezumike.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Ebe ọ bụ na o nwere anya ukwu dịka ala mmụọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ọ gaghị enwekwa afọ ojuju dịka ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Nʼihi na ọ na-achịkọta mba niile nye onwe ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ọ na-adọtakwa ọtụtụ ndị mmadụ nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị a niile ha agaghị eji ịkwa emo na nkọcha sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "\" 'Ahụhụ dịrị onye ahụ na-atụkọta ihe e zutere nʼohi,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "ruo ole mgbe ka ị ga-anọ na-eme onwe gị ọgaranya",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "site nʼịnara ndị mmadụ ụgwọ nʼike?'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ndị i ji ụgwọ agaghị abịakwasị gị na mberede?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Ọ bụ na ha agaghị eteta nʼụra, mee gị ka ị maa jijiji?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Mgbe ahụ ka ha ga-eji gị mee ihe ha chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ị kwakọtala akụ nke ọtụtụ mba dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "ndị ahụ fọdụrụ ga-abịakwa kwakọrọ ihe niile i nwere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "Nʼihi na ị wụsịala ọbara ndị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "i bibiela ọtụtụ ala na obodo na ndị niile bi nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ahụhụ na-adịrị onye ahụ na-ewu ụlọ ya site nʼuru ọjọọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "nke na-ewukwasị akwụ ya nʼebe dị elu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "nʼihi ịgbanarị mbibi nke ga-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I sitela nʼizuzu ọjọọ gị mee ka mbibi bịakwasị ọtụtụ mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:10"
      },
      "items": [
        {
          "text": "sị otu a tufuo ndụ gị, ma wetakwara ezinaụlọ gị ihere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị nkume ahụ e ji wuo mgbidi ga-eti mkpu megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:11"
      },
      "items": [
        {
          "text": "Osisi e ji doo elu ụlọ ga-etikwa mkpu akwa za nkume ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ahụhụ dịrị onye ahụ na-eji ọbara ewu obodo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:12"
      },
      "items": [
        {
          "text": "nke na-ejikwa ajọ omume eme ka obodo ahụ guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na ọ bụghị uche",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.13",
                "verseOrgIds": [
                  "HAB.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "na ndọgbu nʼọrụ niile nke mmadụ bụ na nkịtị, ihe e ji afụnwu ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "na oke ọrụ niile nke mba dị iche iche bụ ihe lara nʼiyi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ụwa niile ga-ejupụta na ihe ọmụma nke ebube",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.14",
                "verseOrgIds": [
                  "HAB.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:14"
      },
      "items": [
        {
          "text": "dịka mmiri si ekpuchi oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ahụhụ dịrị onye ahụ na-enye onye agbataobi ya mmanya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "nke na-anọgide na-agbanyere ya mmanya tutu ruo mgbe mmanya bidoro igbu ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "ka o si otu a hụ ọtọ ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihere ga-anọchi otuto na nsọpụrụ i nwere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Ṅụọ ka ị bụrụ onye mmanya na-egbu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Nʼihi na iko dị nʼaka nri",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.16",
                "verseOrgIds": [
                  "HAB.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "na-abịakwute gị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Ihere ga-anọchikwa anya otuto gị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ike ahụ i mere Lebanọn ga-abịakwasịkwa gị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "Mbibi i bibiri anụmanụ dị iche iche ga-emekwa ka egwu ju gị obi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "Nʼihi na ị wụsịala ọbara ọtụtụ mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "bibie ala na obodo dị iche iche, bibiekwa ndị niile bi nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị bụ uru arụsị bara ebe ọ bụ aka mmadụ kpụrụ ya?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "Kedụ uru igwe a kpụrụ akpụ bara, bụ nke na-ekwu okwu ụgha?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "Nʼihi na onye na-atụkwasị ha obi na-atụkwasị obi ya nʼihe ahụ aka ya rụpụtara,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ arụsị na-enweghị ike ikwu okwu ka o mere.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HAB 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịrị onye ahụ na-agwa osisi okwu sị, 'Dịrị ndụ.'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Ma ọ bụ nkume nke na-apụghị ikwu okwu, 'Teta nʼụra.'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "O nwere ike izi mmadụ ihe?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Lee, ọ bụ ihe eji ọlaọcha na ọlaedo machie,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "ma ọ dịghị nkuume ọbụla dị nʼime ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAB 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.2.20",
                "verseOrgIds": [
                  "HAB.2.20"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ nʼime ụlọnsọ ukwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:20"
      },
      "items": [
        {
          "text": "Ya mere, ka ụwa niile dere duu nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        }
      ]
    }
