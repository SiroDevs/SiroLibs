          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịdị ọcha nke nwanyị mụrụ nwa ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.12.1",
                "verseOrgIds": [
                  "LEV.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.1",
            "verseOrgIds": [
              "LEV.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye ụmụ Izrel iwu ndị a sị ha, 'Mgbe nwanyị tụụrụ ime mesịa mụọ nwa nwoke, ọ ga-abụ onye na-adịghị ọcha ụbọchị asaa, dịka o si adị mgbe ọ nọ nʼadịghị ọcha nke nsọ ya nʼoge a kara aka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asatọ site nʼoge a mụrụ ya, a ga-ebi nwa nwoke ahụ ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime iri abalị atọ na atọ site nʼụbọchị nwanyị ahụ mụsịrị nwa ahụ, ọ ga-anọkwa na-adịghị ọcha nke ọbara gbara ya. Ọ gaghị emetụ ihe dị nsọ aka, maọbụ banye nʼime ebe nsọ, ruo mgbe ụbọchị ime ya ka ọ dị ọcha gasịrị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwanyị dị ime mụrụ nwa nwanyị, ọ ga-abụ onye nʼadịghị ọcha iri ụbọchị na anọ, dịka o si adị mgbe ọ nọ na nsọ ya. Ọ ga-echere tutu iri ụbọchị isii agwụsịa, ime ya ka ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ụbọchị ịdị ọcha ya zuru, ma ọ mụrụ nwa nwoke maọbụ nwa nwanyị, ọ ga-ewetara onye nchụaja nʼọnụ ụzọ ụlọ nzute otu nwa atụrụ gbara otu afọ maka onyinye aja nsure ọkụ, na otu nwa kpalakwukwu maọbụ otu nduru maka onyinye aja mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.6",
            "verseOrgIds": [
              "LEV.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-anarakwa ha chee ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.12.7",
                "verseOrgIds": [
                  "LEV.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", chụọrọ ya aja ikpuchi mmehie. Mgbe ahụ ka ọ ga-adị ọcha site nʼịsọ ọbara ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 12:7"
      },
      "items": [
        {
          "text": "\" 'Nke a bụ usoro iwu dịịrị nwanyị ọbụla mụrụ nwa nwoke, maọbụ nwa nwanyị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.7",
            "verseOrgIds": [
              "LEV.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na aka erughị ya iweta nwa atụrụ, ọ ga-eweta ụmụ kpalakwukwu abụọ, maọbụ ụmụ nduru abụọ. Otu ga-abụ maka aja nsure ọkụ, nke ọzọ ga-abụ maka aja mmehie. Onye nchụaja ga-ewere ha chụọrọ ya aja ikpuchi mmehie, ka ọ dịkwa ọcha ọzọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.8",
            "verseOrgIds": [
              "LEV.12.8"
            ]
          }
        }
      ]
    }
  ],
