          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ iwu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
