                "verseId": "LEV.27.34",
                "verseOrgIds": [
                  "LEV.27.34"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼugwu Saịnaị ka ọ nye ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
