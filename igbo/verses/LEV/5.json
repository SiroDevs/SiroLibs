  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "LEV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na mmadụ ọbụla emehie nʼihi na ọ jụrụ ikwupụta mgbe ọ nụrụ ọkwa amaara nʼọha maka ịgba ama banyere ihe ọ hụrụ maọbụ ihe ọ maara, ọ bụ onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.1",
            "verseOrgIds": [
              "LEV.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye na-amaghị ama metụ ihe rụrụ arụ aka, dịka ozu anụ ọbụla iwu megidere, maọbụ anụ ụlọ, maọbụ anụ ọhịa, maọbụ anụ ọbụla na-akpụ akpụ nʼala. Ọ ghọọla onye rụrụ arụ, na onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.2",
            "verseOrgIds": [
              "LEV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ha emetụ ihe ọbụla rụrụ arụ si nʼahụ mmadụ pụta aka, ihe ọbụla ga-eme ya ka ọ hapụ ịdị ọcha, ọ bụ ezie na ha amaghị na ọ bụ ihe rụrụ arụ, mgbe ọ matara ya, ọ ga-abụ onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.3",
            "verseOrgIds": [
              "LEV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na mmadụ a ṅụọ iyi nzuzu, nke ga-akwagide ya ime ihe ọbụla maọbụ ihe dị mma, maọbụ ihe dị njọ, mgbe onye ahụ ghọtara na ọ bụ iyi nzuzu ka ọ ṅụrụ, ọ bụrụla onye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.4",
            "verseOrgIds": [
              "LEV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla sitere nʼụzọ dị otu a bụrụ onye ikpe mara, ga-ekwupụta mmehie ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "text": "dịka o si dị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.5",
            "verseOrgIds": [
              "LEV.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.6",
                "verseOrgIds": [
                  "LEV.5.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nne atụrụ, maọbụ nne ewu site nʼigwe ewu na atụrụ, dịka aja ikpe ọmụma maka mmehie ha mere. Onye nchụaja ga-achụrụ ha aja mkpuchi mmehie maka mmehie ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.6",
            "verseOrgIds": [
              "LEV.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na o nweghị ike iweta atụrụ, ọ ga-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.7",
                "verseOrgIds": [
                  "LEV.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nduru abụọ, maọbụ kpalakwukwu abụọ, dịka ihe ikpe ọmụma mmehie ha. Otu nʼime nnụnụ ndị a ga-abụ maka aja mmehie, nke ọzọ ga-abụ maka aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.7",
            "verseOrgIds": [
              "LEV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eweta ha nye onye nchụaja. Onye ga-ewere nnụnụ nke mbụ chụọ aja mmehie. Ọ ga-atụbipụ olu ya, kama ọ gaghị ekewapụcha isi nnụnụ ahụ site nʼahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.8",
            "verseOrgIds": [
              "LEV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-efesa ụfọdụ ọbara aja mmehie ahụ nʼakụkụ ebe ịchụ aja, ma ọbara fọdụrụ ka ọ ga-awụsa nʼụkwụ ala ala ebe ịchụ aja. Nke a ga-abụ aja mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.9",
            "verseOrgIds": [
              "LEV.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-eji nnụnụ nke ọzọ chụọ aja nsure ọkụ. Ọ ga-agbaso usoro e debere maka ịchụ aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        },
        {
          "text": "Ọ ga-ekpuchikwara ha mmehie ha mere. A ga-agbagharakwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.10",
            "verseOrgIds": [
              "LEV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na onye ahụ enweghị ike iweta nduru abụọ, maọbụ kpalakwukwu abụọ, ọ ga-eweta iko ọka asaa a kwọrọ nke ọma ka ọ bụrụ onyinye aja mmehie. Ọ gaghị etinye ya mmanụ oliv na ụda na-esi isi ụtọ, nʼihi na ọ bụ aja mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.11",
            "verseOrgIds": [
              "LEV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ewere ya bịakwute onye nchụaja, onye ga-ekporo nke ga-eju ya aka ya dịka oke ncheta. Kpọọ ya ọkụ nʼebe ịchụ aja nke onyinye nsure ọkụ e chere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.12",
                "verseOrgIds": [
                  "LEV.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nke a ga-abụkwa aja mmehie ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.12",
            "verseOrgIds": [
              "LEV.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, onye nchụaja ga-achụrụ ya aja ikpuchi mmehie ya niile. A ga-agbagharakwa ya. Ụtụ ọka fọdụrụ ga-abụ nke onye nchụaja, dịka e si mee ya nʼaja onyinye mkpụrụ ọka.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.13",
            "verseOrgIds": [
              "LEV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aja ikpe ọmụma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.14",
                "verseOrgIds": [
                  "LEV.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.14",
            "verseOrgIds": [
              "LEV.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe onye ọbụla sitere na-amaghị ama mehie, merụọ ihe nsọ niile nke",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụrụ onye nke nʼekwesighị ntụkwasị obi nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ ga-ewetara",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.15",
                "verseOrgIds": [
                  "LEV.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "otu ebule na-enweghị ntụpọ site nʼigwe anụ, dịka ọnụahịa ya si dị nʼọlaọcha, nʼusoro shekel nke ebe nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "text": "Ọ bụ aja ikpe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.15",
            "verseOrgIds": [
              "LEV.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-akwụghachikwa ụgwọ ihe nsọ ndị ahụ niile nke ọ na-emezughị. Ọ ga-atụkwasị otu ụzọ nʼime ụzọ ise nke ọnụahịa ya nʼelu ya, were ha niile nye onye nchụaja. Onye nchụaja ahụ ga-ewere ebule ahụ na ihe ndị a chụọrọ ya aja mkpuchi mmehie, nʼihi ikpe ọmụma ya. A ga-agbagharakwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na mmadụ ọbụla emehie, mee ihe ọbụla megidere iwu ọbụla",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.17",
                "verseOrgIds": [
                  "LEV.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere, ọ bụ ezie na e mere mmehie a na-amaghị ama, ma ikpe mara ha, ọ ga-atakwa ahụhụ soo ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetara onye nchụaja ihe aja ikpe ọmụma nke bụ otu ebule na-enweghị ntụpọ site nʼigwe anụ, nke ọnụahịa ga-abụ ihe o ruru. Nʼụzọ dị otu a, onye nchụaja ga-achụrụ ya aja mkpuchi mmehie nʼihi ihe ọjọọ o mere na-amaghị ama. A ga-agbaghara ya mmehie ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ aja ikpe ọmụma, nʼihi na onye mehiere megide",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.5.19",
                "verseOrgIds": [
                  "LEV.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ọ bụ.\"",
          "type": "text",
          "attrs": {
