  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "34",
        "style": "c",
        "sid": "2CH 34"
      },
      "items": [
        {
          "text": "34",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgbanwe Josaya wetara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya gbara afọ asatọ mgbe e mere ya eze. Ọ chịrị iri afọ atọ na otu na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.2",
                "verseOrgIds": [
                  "2CH.34.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbasookwa ụzọ niile nke nna nna ya Devid, o sighị nʼụzọ a wezuga onwe ya gaa nʼaka nri maọbụ nʼaka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke asatọ nke ọchịchị ya, mgbe ọ ka bụ okorobịa, o bidoro iji obi ya niile na-achọ Chineke nke nna ya Devid. Nʼafọ iri na abụọ nke ọchịchị ya, ọ malitere ime ka Juda na Jerusalem dị ọcha site nʼiwezuga ebe ịchụ aja niile dị elu, na ogidi Ashera niile, na arụsị a pịrị apị na nke a kpụrụ akpụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu ya o mere ka a kwatuo ebe ịchụ aja Baal nʼike. Ọ kụdara ebe ịchụ aja ihe nsure ọkụ na-esi isi ụtọ dị nʼelu ebe ịchụ aja Baal ndị ahụ, tijisie ogidi Ashera niile, na arụsị na oyiyi niile. Ọ kụjasịrị ha niile, kpokọrọ ha ghasaa ha nʼelu ili ndị na-efe ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọrọ ọkpụkpụ ndị nchụaja ahụ ọkụ nʼelu ebe ịchụ aja arụsị ha, si otu a mee ka Juda na Jerusalem dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼobodo ndị Manase, na Ifrem na Simiọn, ruo na Naftalị, na mkpọmkpọ ebe ha niile gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O titụrụ ebe ịchụ aja nke arụsị niile na ogidi arụsị Ashera, gwepịa arụsị ndị a niile dịka ntụ. Otu a ka o mere nʼala Izrel niile tupu ọ laghachi Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na asatọ nke ọchịchị Josaya, mgbe o mere ka ala ahụ na ụlọnsọ dị ọcha, o zigara Shefan nwa Azalaya, Maaseia onye na-achị obodo, na Joa nwa Joahaz, onye na-edekọ akụkọ, ka ha wuzie ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.8",
                "verseOrgIds": [
                  "2CH.34.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jekwuru Hilkaya onyeisi nchụaja nye ya ego nke e webatara nʼụlọnsọ Chineke, nke ndị Livayị bụ ndị na-eche ọnụ ụzọ nakọtara site nʼaka ndị Manase na Ifrem, na ndị niile fọdụrụ nʼIzrel, na sitekwa nʼaka ndị Juda na Benjamin, na ndị niile bi na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha nyefere ya nʼaka ndị ikom ahọpụtara maka ilekọta ọrụ nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.10",
                "verseOrgIds": [
                  "2CH.34.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ndị ikom a kwụrụ ndị ọrụ rụziri ma mezie ụlọnsọ ahụ ụgwọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nyekwara ndị ọkpọ ǹtu na ndị na-ewu ụlọ ego iji zụta nkume a wara awa, osisi iji mee ihe njikọta na osisi ịkwado ụlọ, maka iji rụzie ụlọ a nke ndị eze Juda hapụrụ ka ọ dakasịa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọrụ a rụrụ ọrụ ha nʼikwesị ntụkwasị obi. Ndị nlekọta ha bụ ndị Livayị ndị a: Jahat na Ọbadaya ndị si nʼikwu Merari, na Zekaraya na Meshulam ndịisi nʼikwu Kohat. Ndị Livayị ndị ọzọ, ndị bụ ndị nwere nghọta nʼiti ngwa egwu dị iche iche",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka e mere ndị nlekọta ndị na-ebu ibu. Ha lekọtakwara ndị niile rụrụ ọrụ dị iche iche. Ụfọdụ nʼime ndị Livayị ndị a bụ ndị ode akwụkwọ na ndị na-edekọ ihe, na ndị na-eche ọnụ ụzọ nche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nchọta Akwụkwọ iwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-ewepụta ego anabatara nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Hilkaya onye nchụaja chọtara akwụkwọ Iwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.14",
                "verseOrgIds": [
                  "2CH.34.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ nke o nyere site nʼaka Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkaya sịrị Shefan ode akwụkwọ, \"Achọtala m Akwụkwọ Iwu nʼime ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.15",
                "verseOrgIds": [
                  "2CH.34.15"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" O nyere ya Shefan.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Shefan buuru akwụkwọ ahụ wegara ya eze, gwa ya sị, \"Ndị ozi gị na-eje ozi ha dịka ihe niile i tinyere ha nʼaka si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha enyefela ego niile nke dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.17",
                "verseOrgIds": [
                  "2CH.34.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼaka ndị nlekọta ọrụ, na ndị ọrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Shefan ode akwụkwọ gwara eze okwu ọzọ sị ya, \"O nwere akwụkwọ Hilkaya nyere m.\" Shefan wepụtara ya gụọ ya na ntị eze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nụrụ ihe niile e dere nʼakwụkwọ iwu ahụ, ọ dọwara uwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere Hilkaya, Ahikam nwa Shefan, Abdon nwa Maịka, Shefan ode akwụkwọ na Asaya, bụ onye ọrụ eze, iwu, sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaanụ jụta",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ase, nʼisi m na nʼisi ndị fọdụrụ nʼIzrel na Juda, banyere ihe niile e dere nʼakwụkwọ a bụ nke achọtara. Nʼihi na ọnụma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu bụ nke a wụkwasịrị anyị, nʼihi na ndị bu anyị ụzọ edebeghị okwu nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.21",
                "verseOrgIds": [
                  "2CH.34.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", ha agbasoghị ihe niile e dere nʼime akwụkwọ a banyere anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Hilkaya na ndị ahụ eze zipụrụ ya na ha, jekwuuru Hulda, onye amụma nwanyị, onye bụ nwunye Shalum, nwa Tokhat, nwa Hasra. Onye nlekọta ebe a na-edebe uwe. Hulda na-ebi na mpaghara Jerusalem e wuru ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha, \"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.23",
                "verseOrgIds": [
                  "2CH.34.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nke Izrel, kwuru: Gwanụ nwoke ahụ ziri unu ka unu bịakwutem, sị",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.24",
                "verseOrgIds": [
                  "2CH.34.24"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu: Ana m aga iweta mbibi ga-adakwasị ebe a na ndị niile bi nʼime ya, ọbụbụ ọnụ niile e dere nʼime akwụkwọ a, bụ nke a gụpụtara nʼihu eze Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ajụla m, gbakụta m azụ, chụọ aja nsure ọkụ na-esi isi ụtọ nye chi ndị ọzọ, kpasuo m iwe site na ihe niile nke aka ha mepụtara, a ga-awụkwasị iwe m nʼebe a, ọ gaghị akwụsịkwa.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwanụ eze Juda, onye ahụ zitere unu ịjụta ase site nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.26",
                "verseOrgIds": [
                  "2CH.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": "sị ya, 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.26",
                "verseOrgIds": [
                  "2CH.34.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel na-ekwu banyere okwu ndị ahụ ị nụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o wutere gị nʼobi, na i wedakwara onwe gị nʼala nʼihu Chineke, mgbe ị nụrụ ihe o kwuru megide ebe a na ndị bi nʼime ya, nʼihi na i wedara onwe gị nʼala nʼihu m, ma dọwaakwa uwe gị, bekwaa akwa nʼihu m. Mụ onwe m anụla, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.27",
                "verseOrgIds": [
                  "2CH.34.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, aga m achịkọta gị nye nna nna gị ha, a ga-eli gị nʼudo. Anya gị agaghị ahụ mbibi nke m ga-eme ka ọ bịakwasị ebe a na ndị bi nʼime ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 34:28"
      },
      "items": [
        {
          "text": "Ha laghachiri inye eze ọsịsa ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze kpọrọ ndị okenye Juda na Jerusalem niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya na ndị ikom Juda niile, ndị niile bi na Jerusalem, na ndị nchụaja, na ndị Livayị, na ndị mmadụ niile, site nʼonye nta ruo na onye ukwu. Ọ gụpụtara na ntị onye ọbụla okwu niile si nʼakwụkwọ ọgbụgba ndụ ahụ, bụ nke achọtara nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.30",
                "verseOrgIds": [
                  "2CH.34.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze guzoro nʼakụkụ ogidi, kwee nkwa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", ịgbaso",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.31",
                "verseOrgIds": [
                  "2CH.34.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", na idebe iwu ya na ụkpụrụ ya niile, na iji obi ya niile, na mkpụrụobi ya niile rube isi nʼokwu ọgbụgba ndụ ahụ e dere nʼakwụkwọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mekwara ka ndị niile nọ na Jerusalem na Benjamin kwee Onyenwe anyị otu nkwa ahụ. Ndị niile bi na Jerusalem mezukwara ihe ndị a dịka ọgbụgba ndụ Chineke, bụ Chineke nna nna ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya sitere nʼala niile bụ nke ndị Izrel wezuga ihe arụ niile bụ arụsị, o mere ndị niile nọ nʼIzrel nʼoge ahụ ka ha fee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha. Nʼụbọchị ndụ ya niile, ha esiteghị nʼiso",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.34.33",
                "verseOrgIds": [
                  "2CH.34.33"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nke nna nna wezuga onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
  ],
