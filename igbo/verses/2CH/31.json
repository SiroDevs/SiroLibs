  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe niile a gwụsịrị, ndị Izrel bụ ndị nọ nʼebe ahụ pụrụ gaa nʼobodo niile dị na Juda, kurisie ogidi nsọ niile, gbutukwa ogidi Ashera niile. Ha kwatụrụ ebe niile dị elu na ebe ịchụ aja niile dị na Juda, Benjamin, Ifrem na Manase. Mgbe ha lachara ha niile nʼiyi, ndị Izrel niile laghachiri nʼobodo nke aka ha nakwa nʼihe onye ọbụla nwere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyinye maka ife ofufe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya kenyekwara ndị nchụaja na ndị Livayị nʼusoro ịrụ ọrụ ha nʼụlọnsọ ukwu Chineke ụbọchị niile, maka ọrụ ịchụ aja nsure ọkụ na aja udo, na inye ekele, na ito",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.2",
                "verseOrgIds": [
                  "2CH.31.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼọnụ ụzọ ama ebe obibi ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nyekwara ụtụ nke ya site nʼihe nweta ya maka iji chụọ aja nsure ọkụ, nke ụtụtụ na abalị, ya na aja nsure ọkụ nke ụbọchị izuike niile na ọnwa ọhụrụ, na nke mmemme niile a kara aka a na-eme dịka ọ dị nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.3",
                "verseOrgIds": [
                  "2CH.31.3"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyekwara ndị bi na Jerusalem iwu ka ha na-ewebatara ndị nchụaja na ndị Livayị oke nke ruuru ha, ka ha nwee ike lebanye anya nke ọma nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.4",
                "verseOrgIds": [
                  "2CH.31.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa e kwusara okwu a, ụmụ Izrel niile wetara onyinye ha nʼebe ọ bara ụba. Ha wetara mkpụrụ mbụ nke ọka ha, na mmanya vaịnị ọhụrụ ha, na mmanụ oliv, na mmanụ aṅụ, na ihe omume niile nke ubi. Ha wetakwara nʼụba otu ụzọ nʼụzọ iri nke ihe niile ọzọ ha nwere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel na Juda niile bi nʼobodo Juda bubatakwara otu ụzọ nʼime ụzọ iri nke igwe ehi, na igwe ewu na atụrụ, na otu ụzọ nʼụzọ iri nke ihe nsọ niile edoro nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.6",
                "verseOrgIds": [
                  "2CH.31.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha. Ha doro ha niile nʼukwu nʼukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bidoro iwebata ihe ndị a site nʼọnwa nke atọ nʼafọ ruo nʼọnwa nke asaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hezekaya na ndịisi ya bịara hụ ukwu ihe ndị ahụ niile, ha toro",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.8",
                "verseOrgIds": [
                  "2CH.31.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", gọziekwa ndị ya bụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya jụrụ ndị nchụaja na ndị Livayị banyere onyinye ndị ahụ e bubatara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaraya, onyeisi nchụaja, onye sitere nʼikwu Zadọk zara sị ya; \"Lee, kemgbe ndị mmadụ malitere iwebata onyinye ha nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "o nwebeghị ihe kọrọ anyị. Nʼezie, anyị nwere karịa, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.10",
                "verseOrgIds": [
                  "2CH.31.10"
                ]
              }
            }
          ]
        },
        {
          "text": "agọziela ndị ya. Leekwa ihe dị ukwuu ka fọdụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya nyere iwu ka e edozie ụlọ ịchịkọba ihe nʼime ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.11",
                "verseOrgIds": [
                  "2CH.31.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ. Ha mekwara otu a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ha jiri ikwesi ntụkwasị obi bubata onyinye ndị ahụ, na onyinye nke otu ụzọ nʼime ụzọ iri, na onyinye e doro nsọ, tifee ha nʼaka Konanaya, onye Livayị. Shimei nwanne ya nwoke bụ onye na-esote ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehiel, Azazaya, Nahat, Asahel, Jerimot, Jozabad, Eliel, Ismakaya, Mahat na Benaya, bụ ndị nlekọta ọrụ ndị nọ nʼokpuru Konanaya na Shimei nwanne ya. Ndị a niile bụ ndị eze Hezekaya na Azaraya onye nlekọta ụlọnsọ ukwu Chineke họpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kore nwa Imna, onye Livayị, onye bụkwa onye na-elekọta ọnụ ụzọ ama dị nʼọwụwa anyanwụ, ka e tinyere ọrụ ilekọta onyinye afọ ofufu niile e wetaara Chineke. Ọ bụ ya nwekwa ọrụ ikesa onyinye ndị ahụ niile e bubataara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.14",
                "verseOrgIds": [
                  "2CH.31.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ha na onyinye ndị ọzọ e doro nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-enyere ya aka bụ Eden, Miniamin, Jeshua, Shemaya, Amaraya na Shekanaya. Ha na-eke onyinye ahụ nye ndị nchụaja niile nʼobodo ahụ, onye ukwu na onye nta, dịka usoro ịrụ ọrụ ha si dị. Ha ji ikwesi ntụkwasị obi na-enyere ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, ndị ikom niile si nʼezinaụlọ ndị nchụaja, ndị gbara site nʼafọ atọ gbagoo, ndị aha ha dị nʼakwụkwọ usoro ọmụmụ, bụ ndị na-arụ ọrụ nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.16",
                "verseOrgIds": [
                  "2CH.31.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", na-eketa oke ihe oriri ha na-eri mgbe ọbụla ha bịara ịrụ ọrụ dịka usoro ọrụ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-ekenye ndị nchụaja niile e dere aha ha nʼakwụkwọ usoro ọmụmụ, kenyekwa ndị Livayị niile gbara site iri afọ abụọ gbagoo ihe oriri dịka usoro ọrụ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-esokwa keta oke ndị a bụ ụmụntakịrị, na ndị inyom, na ụmụ ndị ikom na ndị inyom na-etolite etolite, bụ ndị niile e depụtara aha ha nʼakwụkwọ usoro ọmụmụ. Ndị a bụ ndị kwesiri ntụkwasị obi nʼido onwe ha nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara ụfọdụ ndị ikom ndị ọrụ ha bụ ike nri nye ndị nchụaja niile bụ ụmụ ụmụ Erọn. Ndị nchụaja a na-ekwu ihe banyere ha nʼebe a bụ ndị ahụ bi nʼala ubi nke gbara obodo ndị nchụaja gburugburu, maọbụ ndị bi nʼobodo ndị ọzọ. Ndị a bụkwa ndị e dere aha ha niile nʼakwụkwọ usoro ọmụmụ ndị Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ihe ndị Hezekaya mere nʼime Juda niile, ọ na-eme ihe dị mma, na nke ziri ezi, nʼikwesị ntụkwasị obi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.31.20",
                "verseOrgIds": [
                  "2CH.31.20"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ihe niile o mere, nke metụtara ije ozi nke ụlọ ukwu Chineke, na idebe iwu niile na ụkpụrụ niile Onyenwe anyị nyere, Hezekaya ji obi ya niile gbasoo Chineke. O jikwa obi ya niile jee ozi niile o jere. Nke a mekwara ka ihe gaara ya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
