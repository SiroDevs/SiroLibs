  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "2CH 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Josaya emee Mmemme Ngabiga",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya mere Mmemme Ngabiga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.1",
                "verseOrgIds": [
                  "2CH.35.1"
                ]
              }
            }
          ]
        },
        {
          "text": "na Jerusalem nʼụbọchị iri na anọ nke ọnwa mbụ nʼafọ. Ha gburu atụrụ Mmemme Ngabiga nʼụbọchị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O debekwara ndị nchụaja nʼime ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.2",
                "verseOrgIds": [
                  "2CH.35.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbaa ha ume ka ha bidokwa ịrụ ọrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ndị Livayị, bụ ndị e doro nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.3",
                "verseOrgIds": [
                  "2CH.35.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndị na-emekwa ka ndị Izrel ghọta ihe, \"Dọnyenụ igbe nsọ ahụ nʼụlọnsọ ukwu ahụ Solomọn, nwa Devid, bụ eze Izrel wuru. Unu ekwesịkwaghị ị na-ebugharị ya nʼubu unu ọzọ. Ugbu a jeerenụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.3",
                "verseOrgIds": [
                  "2CH.35.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, na ndị ya Izrel ozi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwadoonụ onwe unu nʼusoro ezinaụlọ unu nʼotu nʼotu, dịka ntụziaka ihe Devid, eze Izrel dere nʼakwụkwọ si dị, ya na nke Solomọn nwa ya si dịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Werenụ ọnọdụ nʼebe nsọ unu na otu ndị Livayị, maka nkewa nke ezinaụlọ nna nna unu ha si dị, bụ ikwu ndị Izrel, ndị na-abụghị ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbuonụ atụrụ ngabiga ndị ahụ, doonụ onwe unu nsọ, doziekwaranụ ụmụnna unu ndị Izrel aja ha, ime dịka ihe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.6",
                "verseOrgIds": [
                  "2CH.35.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya nyere ndị niile nọ nʼebe ahụ onyinye igwe ewu na atụrụ ọnụọgụgụ ya dị iri puku atọ, nke ha ga-eji chụọ aja Mmemme Ngabiga. O nyekwara ha puku oke ehi atọ site nʼakụ eze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi ya nyekwara ndị nchụaja na ndị Livayị onyinye afọ ofufu. Otu a kwa, Hilkaya na Zekaraya, na Jehiel, ndị na-elekọta ụlọnsọ Chineke nyere ndị nchụaja puku ewu na atụrụ abụọ na narị isii, nyekwa ha narị oke ehi atọ, maka iji chụọ aja Ngabiga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị bụ ndị ndu nʼebo Livayị aha ha bụ Konanaya, na Shemaya, na Netanel, na nwanne ya Hashabaya, na Jeiel, na Jozabad, nyere ndị Livayị puku ewu na atụrụ ise, na narị oke ehi ise maka iji ha chụọ aja Ngabiga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e dozichara usoro ije ozi ahụ niile, ndị nchụaja weere ọnọdụ ha, ha na ndị Livayị nʼoke ọrụ ha nʼusoro dịka eze nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ndị Livayị gburu atụrụ ngabiga ahụ niile, were ọbara ha nye ndị nchụaja. Ha fesara ya nʼebe ịchụ aja mgbe ndị Livayị nọ na-agba anụ ndị ahụ akpụkpọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kenyere ezinaụlọ ọbụla anụ ndị ahụ niile ka ha jiri nke ha ketara chụọ aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.12",
                "verseOrgIds": [
                  "2CH.35.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼusoro dịka e dere nʼime akwụkwọ Mosis. Otu a ka ha mekwara banyere ehi ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, dịka e dere ya nʼiwu Mosis, ha hụrụ anụ aja ngabiga ahụ nʼọkụ, sie aja ndị dị nsọ nʼite, buputa ha ngwangwa kee ha ndị mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ha kwadooro onwe ha ihe, ma kwadokwara ndị nchụaja, nʼihi na ndị nchụaja, bụ ụmụ Erọn, nọọrị na-achụ aja nsure ọkụ na abụba anụ ruo abalị. Ya mere, ndị Livayị ji kwadoro onwe ha ma kwadokwara ndị nchụaja, bụ ụmụ Erọn ihe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikwu Asaf ndị a, bụ ndị na-abụ abụ, nọkwa nʼọnọdụ ha nʼusoro dịka ihe Devid, na Asaf, na Heman, na Jedutun onye amụma eze nyere nʼiwu. Ndị na-eche nche nʼọnụ ụzọ ama ahapụghị ọnọdụ ha, nʼihi na ndị Livayị ibe ha doziri ihe debere ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e doziri ofufe niile nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.16",
                "verseOrgIds": [
                  "2CH.35.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼotu ụbọchị ahụ, maka ime Mmemme Ngabiga na ịchụ aja nsure ọkụ niile nʼebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.16",
                "verseOrgIds": [
                  "2CH.35.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịka eze Josaya nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel bụ ndị nọ nʼebe ahụ mere Mmemme Ngabiga nʼoge ahụ, meekwa mmemme achịcha ekoghị eko ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mebeghị Mmemme Ngabiga nʼụdị a nʼIzrel, site nʼụbọchị Samuel onye amụma, o nwebekwaghị eze Izrel ọbụla nke merela mmemme a dịka Josaya mere, ya na ndị nchụaja, ndị Livayị na ndị Juda niile na ndị Izrel niile bụ ndị nọ nʼebe ahụ tinyere ndị Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼafọ nke iri na asatọ nke ọchịchị Josaya, ka e mere Mmemme Ngabiga a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Josaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, mgbe Josaya hazisịrị ihe nʼụlọnsọ ahụ, Neko eze Ijipt gbagoro ịga buo agha na Kakemish, nke dị nʼakụkụ osimiri Yufretis. Mgbe ahụ, Josaya pụkwara izute ya nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Neko zipụrụ ndị ozi bịara zie Josaya ozi, sị ya, \"Olee esemokwu dị ugbu a nʼetiti mụ na gị, gị eze Juda? Ọ bụghị ibuso gị agha ka m bịara, kama ọ bụ naanị ụlọ mụ na ha nọ nʼagha. Chineke sịrị m ka m mee ngwa; ya mere, egbochikwala Chineke onye nọnyeere m, ka ọ ghara iji iwe bibie gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Josaya esiteghị nʼebe ọ nọ chigharịa, kama o nwogharịrị onwe ya, ka a ghara ịmata onye ọ bụ, maka ịga buso ya agha. O geghịkwa ntị na okwu ahụ eze Neko kwuru nke si nʼaka Chineke bịa, kama ọ pụrụ ibuso ya agha nʼala Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị nʼagba ụta gbatara eze, bụ Josaya ụta, eze gwara ndị ozi ya sị, \"Bupunụ m, nʼihi na emerụọla m ahụ nʼebe ọ dị ukwuu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha sitere nʼụgbọ agha ya bulie ya bubanye ya nʼime ụgbọ agha ọzọ, bulata ya na Jerusalem, ebe ọ nọ nwụọ. E liri ya nʼili nna nna ya ha, ndị Juda na Jerusalem niile ruuru ya uju.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremaya bụụrụ Josaya abụ akwa, ruo taa ndị ikom na ndị inyom na-abụ abụ a iji na-echeta Josaya. Nke a ghọrọ omenaala nʼIzrel, e dekwara ya nʼakwụkwọ abụ akwa dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị ọzọ niile Josaya mere, na ọrụ ebere niile ọ rụrụ nʼusoro ihe e dere nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.35.26",
                "verseOrgIds": [
                  "2CH.35.26"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na akụkọ ndụ ya site na mmalite ruo nʼọgwụgwụ, ka e depụtara nʼakwụkwọ akụkọ ndị eze Izrel na Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
            "verseOrgIds": [
              "2CH.35.27"
            ]
          }
        }
      ]
    }
