  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2CH 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abija sooro nna nna ya ha dina nʼọnwụ, e lie ya nʼobodo Devid. Asa, nwa ya nwoke ghọrọ eze nʼọnọdụ ya. Udo dịkwa afọ iri nʼụbọchị ịbụ eze ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asa eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa mere ihe dị mma na nke ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.2",
                "verseOrgIds": [
                  "2CH.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wezugakwara ebe ịchụ aja nke chi ọzọ niile dị nʼugwu, tipịa ogidi nsọ niile, gbujasịakwa ogidi Ashera.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere Juda iwu ka ha chọọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.4",
                "verseOrgIds": [
                  "2CH.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nke nna ha, ka ha debekwa iwu ya na ụkpụrụ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wezugakwara ebe niile a na-efe arụsị nʼelu ugwu, bibiekwa ebe niile a na-esure ihe nsure ọkụ na-esi isi ụtọ nʼobodo Juda. Alaeze ahụ nwekwara udo nʼokpuru ọchịchị ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ọtụtụ obodo e ji mgbidi gbaa gburugburu nʼala Juda niile. O nweghị onye busoro ya agha, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.6",
                "verseOrgIds": [
                  "2CH.14.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya udo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ọ gwara ndị Juda sị ha, \"Ugbu a ka anyị kwesiri iwu obodo ndị a. Ka anyị wuokwa mgbidi gburugburu ha, wuokwa ụlọ elu nche, tinyesịa ha niile ibo ọnụ ụzọ ama, na mkpọrọ e ji akpọchi ya, ala a bụ nke anyị, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.7",
                "verseOrgIds": [
                  "2CH.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke onye anyị ji obi anyị chọsie ike enyela anyị udo.\" Ya mere, ha wuru ihe ndị a niile nwekwa ọganihu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ ndị agha Asa ndị si Juda nʼoge ahụ bụ narị puku atọ. Ngwa agha ha ji bụ ọta ukwu na ùbe. Ndị agha ya ọzọ si Benjamin dị narị puku abụọ na iri puku mmadụ asatọ. Ndị a jikwa ọta na ụta. Ndị agha ndị a niile bụ ndị a zụziri azụzi, bụrụkwa ndị dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zera, bụ onye Kush duru puku kwụrụ puku,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        },
        {
          "text": "na narị ụgbọ agha atọ, bịaruo Maresha ibuso Juda agha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.9",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa pụrụ izute ya. Ha doro onwe ha nʼusoro ibu agha na Ndagwurugwu Zefata nke dị Maresha nso.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.10",
            "verseOrgIds": [
              "2CH.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Asa kpọkuru",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, si, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ọ dịghị onye dịka gị nʼinyere onye na-adịghị ike aka nʼihu onye dị ike nke ukwuu. Nyere anyị aka, O",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị, nʼihi na anyị dabere na gị. Ọ bụkwa nʼaha gị ka anyị na-apụ ibuso igwe a agha. O",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.11",
                "verseOrgIds": [
                  "2CH.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "i bụ Chineke anyị. Ekwela ka ọ bụrụ na mmadụ efu meriri gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.11",
            "verseOrgIds": [
              "2CH.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.12",
                "verseOrgIds": [
                  "2CH.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "tigbukwara ndị Kush niile ahụ nʼihu Asa na Juda. Ndị Kush gbakwara ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa na ndị agha ya chụrụ ha ọsọ chụruo ha obodo Gera ebe ọtụtụ ndị Kush dara, ruo na o nwekwaghị onye fọdụrụ ndụ nʼime ha. E tigburu ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.13",
                "verseOrgIds": [
                  "2CH.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "na ndị agha ya. Ndị Juda bukọọrọ ọtụtụ ihe nkwata nʼagha dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bibiri obodo niile gbara Gera gburugburu, nʼihi na egwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.14.14",
                "verseOrgIds": [
                  "2CH.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dakwasịrị obodo ndị ahụ niile. Ndị Juda bukọọrọ ọtụtụ ihe nkwata nʼihi na ọtụtụ ihe dị nʼobodo ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha busokwara ebe obibi ndị na-azụ anụ ụlọ agha, chikọrọ igwe atụrụ na ewu na ịnyịnya kamel. Emesịa ha laghachiri Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        }
      ]
    }
  ],
