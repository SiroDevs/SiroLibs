        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.19",
                "verseOrgIds": [
                  "2CH.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", igbochi ka onye ọbụla nke na-adịghị ọcha nʼụzọ ọbụla ghara ịbanye.",
          "type": "text",
          "attrs": {
