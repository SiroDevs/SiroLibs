  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2CH 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke asaa, Jehoiada gosiri ịdị ike nke obi ya. Ya na ndị ọchịagha na-achị narị ndị agha gbara ndụ. Ndị a bụ: Azaraya nwa Jeroham, Ishmel nwa Jehohanan, Azaraya nwa Obed, Maaseia nwa Adaya na Elishafat nwa Zikri.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.1",
            "verseOrgIds": [
              "2CH.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha pụrụ gaa akụkụ niile nke ala Juda kpọkọta ndị Livayị na ndịisi ezinaụlọ Izrel site nʼobodo niile. Mgbe ha bịarutere Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.2",
            "verseOrgIds": [
              "2CH.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọgbakọ ahụ niile na eze gbara ndụ nʼụlọnsọ ukwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 23:3"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Jehoiada sịrị ha, \"Nwa eze ga-achị dịka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.3",
                "verseOrgIds": [
                  "2CH.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere na nkwa banyere agbụrụ Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.3",
            "verseOrgIds": [
              "2CH.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, nke a bụ ihe unu ga-eme: Otu ụzọ nʼime ụzọ atọ nke ndị nchụaja na ndị Livayị, bụ ndị ga-abịa ọrụ nʼụbọchị izuike ga-abụ ndị ga-eche ọnụ ụzọ niile nche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.4",
            "verseOrgIds": [
              "2CH.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụzọ nʼime ụzọ atọ nke ọzọ ga-anọ nʼụlọeze, ebe otu ụzọ ga-anọ nʼọnụ ụzọ Ntọala. Ndị ọzọ niile ga-anọ gburugburu mpụta ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.5",
                "verseOrgIds": [
                  "2CH.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.5",
            "verseOrgIds": [
              "2CH.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye ọbụla ga-abata nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "karịa naanị ndị nchụaja na ndị Livayị ndị nọ ọrụ, ha ga-abata nʼihi ha bụ ndị edoro nsọ, ma ndị ọzọ niile ga-edebe iwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.6",
                "verseOrgIds": [
                  "2CH.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", ghara ịbata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.6",
            "verseOrgIds": [
              "2CH.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị ga-edo onwe ha gburugburu eze, onye ọbụla ga e jide ihe agha nʼaka ya. Onye ọbụla batara nʼime ụlọnsọ ahụ ka a ga-egbu. Nọrọnụ eze nso, ebe ọbụla ọ gara, mgbe ọ na-apụ nʼezi na mgbe ọ na-aba nʼime.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.7",
            "verseOrgIds": [
              "2CH.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Livayị na ndị ikom Juda niile mere dịka Jehoiada, onye nchụaja nyere nʼiwu. Onye ọbụla kpọọrọ ndị ikom ya, ma ndị na-abata ịrụ ọrụ nʼụbọchị izuike ma ndị na-emechi ọrụ. Nʼihi na Jehoiada onye nchụaja ezipụghị otu ọbụla nʼime ndị ọrụ ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.8",
            "verseOrgIds": [
              "2CH.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere ndị ọchịagha ahụ na-elekọta narị ndị agha, ùbe na ọta ukwu na ọta nta niile, ndị bụrịị nke eze Devid, bụ ndị dị nʼụlọnsọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.9",
            "verseOrgIds": [
              "2CH.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O guzobere ndị ikom niile ahụ, onye ọbụla ji ngwa agha ya nʼaka ya, nọdụ eze gburugburu na nso ebe ịchụ aja na ụlọnsọ ukwu ahụ. Site nʼakụkụ ndịda ruo nʼakụkụ ugwu nke ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.10",
            "verseOrgIds": [
              "2CH.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada na ụmụ ya ndị ikom kpọpụtara nwa eze, kpube ya okpueze nʼisi, ha nyere ya otu akwụkwọ nke ihe ọgbụgba ndụ ahụ, chie ya eze. Ha tekwara ya mmanụ ịbụ eze, tie mkpu sị, \"Ka eze dịrị ndụ ruo mgbe ebighị ebi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.11",
            "verseOrgIds": [
              "2CH.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Atalaya nụrụ mkpọtụ ndị mmadụ, ndị na-agba ọsọ na-eto eze, ọ gakwuru ha nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.12",
                "verseOrgIds": [
                  "2CH.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.12",
            "verseOrgIds": [
              "2CH.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "O lepụrụ anya, ma lee eze, ka o guzo nʼakụkụ ogidi ya dị na mbata. Ndịisi na ndị na-afụ opi nọ nʼakụkụ eze, ndị niile nke ala ahụ nọkwa na-aṅụrị ọṅụ na-afụ opi. Ndị ọbụ abụ jikwa iti egwu na-edu nʼabụ otuto. Mgbe ahụ, Atalaya dọwara uwe ya, sị, \"Nke a bụ nnupu isi megide eze! Nke a bụ nnupu isi megide ọchịchị!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.13",
            "verseOrgIds": [
              "2CH.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada, bụ onye nchụaja zipụrụ ndị ọchịagha na-achị narị ndị agha, bụ ndị na-elekọta usuu ndị agha, sị ha, \"Sitenụ nʼetiti ahịrị ahụ kpụpụta ya nʼetiti ahịrị unu, onye ọbụla nke gbasoro ya, werenụ mma agha gbuo onye ahụ.\" Nʼihi na onye nchụaja sịrị, \"Ka egbula ya na ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.14",
                "verseOrgIds": [
                  "2CH.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.14",
            "verseOrgIds": [
              "2CH.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha jidere ya mgbe o rutere na mbata nke ọnụ ụzọ ịnyịnya nʼogige ụlọeze, ebe ahụ ka ha gburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.15",
            "verseOrgIds": [
              "2CH.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada mere ka ọgbụgba ndụ dị, na ya, na ndị mmadụ, na eze, ga-abụ ndị nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.16",
                "verseOrgIds": [
                  "2CH.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.16",
            "verseOrgIds": [
              "2CH.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile ahụ gara nʼụlọ nchụaja Baal kwatuo ya. Ha tidasịrị ebe nchụaja na arụsị niile dị nʼebe ahụ, gbukwaa Matan onye nchụaja Baal nʼihu ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.17",
            "verseOrgIds": [
              "2CH.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jehoiada nyefere nlekọta nke ụlọnsọ ukwuu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.18",
                "verseOrgIds": [
                  "2CH.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼaka ndị nchụaja bụ ndị Livayị, bụ ndị Devid nyere ọrụ ịchụ aja nsure ọkụ nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.23.18",
                "verseOrgIds": [
                  "2CH.23.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼime ụlọnsọ, dịka e dere ya nʼiwu Mosis, nʼiji ọṅụ na ịbụ abụ dịka Devid nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.18",
            "verseOrgIds": [
              "2CH.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O debekwara ndị nche nʼọnụ ụzọ ama ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.19",
            "verseOrgIds": [
