              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọọrọ ndị ọchịagha na-achị narị ndị agha, na ndị a na-asọpụrụ, na ndị na-achị achị, na ndị ala ahụ niile, dupụta eze site nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
