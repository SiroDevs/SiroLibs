                "verseOrgIds": [
                  "2CH.23.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha bara nʼụlọeze site nʼọnụ ụzọ ama nke dị Elu, mee ka eze nọkwasị nʼelu ocheeze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.23.20",
            "verseOrgIds": [
              "2CH.23.20"
