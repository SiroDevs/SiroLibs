  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "1PE 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita, onyeozi Jisọs Kraịst,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:1"
      },
      "items": [
        {
          "text": "Na-edegara unu ndị niile ndị a họpụtara, ndị gbara ọsọ ndụ gaa biri na Pọntọs, na Galeshịa, na Kapadosia, Eshịa na Bitinia, akwụkwọ a.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.1",
            "verseOrgIds": [
              "1PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ndị Chineke bụ Nna họpụtara dị ka o bururị ụzọ mata na ọ ga-eme, jirikwa Mmụọ Nsọ ya doo unu nsọ, ka unu na-erubere Jisọs Kraịst isi, ka ewerekwa ọbara ya sachaa unu:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "1PE 1:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1PE 1:2"
      },
      "items": [
        {
          "text": "Ka amara na udo baara unu ụba.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olileanya dị ndụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otuto dịrị Chineke Nna Onyenwe anyị Jisọs Kraịst! Site nʼịba ụba nke ebere ya, o nyela anyị ndụ ọhụrụ baa nʼolileanya dị ndụ site na mbilite nʼọnwụ Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nwekwara ihe nketa nke na-apụghị imebi emebi, nke na-agaghị ere ure, maọbụ gbanwee ụdịdị ya, nke e debeere anyị nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị bụ ndị e sitere nʼokwukwe na-echekwa nʼike Chineke, tutu ruo ọbịbịa nzọpụta ahụ, nke a na-ejikere ime ka ọ pụta ìhè nʼọgwụgwụ oge.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ihe ndị a ka unu na-aṅụrị oke ọṅụ, ọ bụ ezie na nʼoge ndị a dị nta, unu agabigala ọtụtụ ihe mgbu nʼihi ụdị ọnwụnwa dị iche iche bịakwasịrị unu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnwụnwa ndị a na-abịa ime ka okwukwe unu, nke dị oke ọnụahịa karịa ọlaedo na-ala nʼiyi nʼagbanyeghị na e ji ọkụ nụchaa ya; bụrụ nke ga-eweta otuto, na ebube, na nsọpụrụ, mgbe e mere ka Jisọs Kraịst pụta ìhè.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na unu ejibeghị anya unu hụ ya mgbe ọbụla, ma unu hụrụ ya nʼanya, ọ bụkwa ezie na unu adịghị ahụ ya anya ugbu a, ma unu kwere na ya. Unu jupụtakwara nʼọṅụ ahụ dị ebube nke ọnụ na-apụghị ịkọwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụgwọ ọrụ ọzọ unu ga-enweta nʼihi okwukwe unu nʼime ya ga-abụ nzọpụta a ga-azọpụta mkpụrụobi unu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyere nzọpụta a, ndị amụma ahụ kwuru ihe banyere amara ahụ gaje ịbịara unu jiri nnọọ nwayọọ nyochasịa",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gbalịsie ike ịchọpụta oge na ọnọdụ ahụ bụ nke Mmụọ Kraịst dị nʼime ha kwuru banyere ya, mgbe ọ gbara ama maka ahụhụ Kraịst na ebube nke ga-eso ya.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "E mere ka ha mata na ọrụ ha na-arụ abụghị maka ọdịmma nke ha onwe ha, kama ọ bụ nʼihi ọdịmma nke unu, mgbe ha kwuru okwu banyere ihe ndị a ahụ bụ ndị a gwarala unu ugbu a site nʼọnụ ndị ziri unu oziọma nʼike Mmụọ Nsọ nke e si nʼeluigwe zite. Ọ bụladị ndị mmụọ ozi ka ọ gụrụ agụụ ịmata ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bụrụnụ ndị dị nsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, werenụ uche unu niile jikere ịrụ ọrụ, anya dokwaa unu. Nweenụ olileanya zuruoke nʼamara nke a ga-ewetara unu mgbe a ga-ekpughe Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dị ka ụmụ na-erube isi, unu ekwela ka ihe ọjọọ ndị ahụ na-agụ unu agụụ mgbe unu nọ nʼọchịchịrị, na-achị ndụ unu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama bụrụnụ ndị dị nsọ nʼihe niile unu na-eme, dịka onye kpọrọ unu si dị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e dere ya ede, \"Dịnụ nsọ, nʼihi na adị m nsọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe unu na-akpọku Nna ahụ na-ekpe onye ọbụla ikpe dị ka ọrụ ya sịrị dị na-eleghị mmadụ anya nʼihu, bienụ ndụ unu nʼịtụ egwu Chineke, dịka ndị mbịarambịa nʼụwa a.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na unu matara na-ejighị ihe pụrụ imebi emebi, dịka ọlaọcha na ọlaedo gbapụta unu site nʼibi ndụ ọjọọ ahụ nna nna unu ha nyefere unu nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kama ọ bụ ọbara dị oke ọnụahịa nke Kraịst bụ nwa atụrụ na-enweghị ntụpọ ọbụla maọbụ ọrụsị.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara ya tupu e kee ụwa. Kama, ọ bụ nʼọgwụgwụ oge ndị a ka e mere ka ọ pụta ìhè nʼihi unu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa site nʼaka ya ka unu ji bụrụ ndị kwere na Chineke, onye mere ka o si nʼọnwụ bilie, na onye nyekwara ya ebube. Ya mere, okwukwe unu na olileanya unu dị na Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ebe unu sitere nʼirubere eziokwu ahụ isi mee ka obi unu dị ọcha, nke mere na unu nwere ịhụnanya nke ihu abụọ nʼadịghị nʼebe ụmụnna unu nọ, sitenụ nʼobi unu na-ahụrịtanụ onwe unu nʼanya nʼebe ọ dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amụọla unu ọzọ ugbu a, ọ bụghị site na mkpụrụ nke na-emebi emebi, kama site na nke na-apụghị imebi emebi, site nʼokwu Chineke nke dị ndụ ma na-adịgidekwa.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "\"Mmadụ niile dị ka ahịhịa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1PE 1:24"
      },
      "items": [
        {
          "text": "ma ebube ha niile dị ka okoko osisi nke ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1PE 1:24"
      },
      "items": [
        {
