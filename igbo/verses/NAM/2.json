  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "NAM 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ninive ga-ada",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NAM 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-ebuso gị agha na-abịakwasị gị.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Chee ebe gị niile e wusiri ike nche.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Chee ụzọ niile nche,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "mee ka ụkwụ gị sie ike nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:1"
      },
      "items": [
        {
          "text": "Chịkọtakwa ike gị niile.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.1",
            "verseOrgIds": [
              "NAM.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NAM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NAM.2.2",
                "verseOrgIds": [
                  "NAM.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eme ka ịma mma Jekọb laghachi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "dịka ịma mma nke Izrel",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "ọ bụ ezie na ndị mbibi ebibiela ha,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:2"
      },
      "items": [
        {
          "text": "lakwaa alaka osisi vaịnị ha niile nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.2",
            "verseOrgIds": [
              "NAM.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NAM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọta ndị agha ya na-acha ọbara ọbara,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "ndị bụ dike nʼagha yikwa uwe na-acha uhie uhie.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "Igwe e ji wuo ụgbọ agha na-egbu amụma",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "nʼụbọchị ahụ ha na-ejikere agha,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:3"
      },
      "items": [
        {
          "text": "otu a kwa, ha na-efegharịkwa ùbe ha eji osisi fịa mee.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.3",
            "verseOrgIds": [
              "NAM.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NAM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụgbọ agha na-eme mkpọtụ dị ukwuu nʼezi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "ha na-agbagharị ihu na azụ nʼama niile.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "Ha na-enwu dịka ire ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:4"
      },
      "items": [
        {
          "text": "na-agbagharịkwa dịka amụma.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.4",
            "verseOrgIds": [
              "NAM.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NAM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-akpọkọta ndị agha ya a zụziri azụzi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "ma ha na-asọ ngọngọ nʼije ha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "Ha ji ọsọ gbaga ruo nʼelu mgbidi ha,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:5"
      },
      "items": [
        {
          "text": "dozie ọta nche ha niile nʼusoro.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.5",
            "verseOrgIds": [
              "NAM.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NAM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e megheela ọnụ ụzọ ama nke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:6"
      },
      "items": [
        {
          "text": "ụlọeze na-amakwa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.6",
            "verseOrgIds": [
              "NAM.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NAM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyela ya ka ọ bụrụ iwu na obodo a",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "aghaghị ịbụ obodo a dọtara nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "Ndị ohu ha ndị inyom so ha nʼazụ na-akwa akwa dịka nduru,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:7"
      },
      "items": [
        {
          "text": "na-etikwa aka nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.7",
            "verseOrgIds": [
              "NAM.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NAM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninive dịka ọdọ mmiri",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "nke mmiri ya na-ehifusị.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "\"Kwụsị! Kwụsị!\" ka ha na-ebe,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:8"
      },
      "items": [
        {
          "text": "ma ọ dịghị onye ga-ele anya nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.8",
            "verseOrgIds": [
              "NAM.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NAM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwakọrọnụ ọlaọcha,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "kwakọrọnụ ọlaedo dịka ihe a kwatara nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "Akụnụba dị nʼụlọakụ ya na ihe ndị ọzọ bara uru nʼobodo ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:9"
      },
      "items": [
        {
          "text": "enweghị ọgwụgwụ.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.9",
            "verseOrgIds": [
              "NAM.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NAM 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E bibiela ya. A gbahapụla ya, hapụ ya ka ọ tọgbọrọ nʼefu.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "Obi ndị nọ nʼime ya na-alọ mmiri, ikpere ha niile na-ama jijiji,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 2:10"
      },
      "items": [
        {
          "text": "anụ ahụ ha niile na-amakwa jijiji, ihu niile achagharịakwala.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.10",
            "verseOrgIds": [
              "NAM.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NAM 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebeekwa ka ọgba ọdụm ahụ dị ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.11",
            "verseOrgIds": [
