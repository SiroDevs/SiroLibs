        },
        {
          "text": "Ọdụm ahụ na-adọgbu anụ na-ezuru ụmụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.12",
            "verseOrgIds": [
              "NAM.2.13"
            ]
          }
