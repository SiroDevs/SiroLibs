        "style": "q2",
        "vid": "NAM 3:13"
      },
      "items": [
        {
          "text": "ha niile bụ ụmụ nwanyị nʼetiti gị.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.13",
            "verseOrgIds": [
              "NAM.3.13"
            ]
          }
        }
      ]
    },
    {
