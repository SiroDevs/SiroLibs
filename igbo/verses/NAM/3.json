        "style": "q2",
        "vid": "NAM 3:10"
      },
      "items": [
        {
          "text": "e kekwara ndị ukwu ya niile mkpọrọ igwe.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
