      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NAM 3:17"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye maara ebe ha feere gaa.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.17",
            "verseOrgIds": [
              "NAM.3.17"
            ]
          }
        }
