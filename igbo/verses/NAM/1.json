      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:14"
      },
      "items": [
        {
          "text": "Aga m ala arụsị unu niile a pịrị apị na ndị a kpụrụ akpụ nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.14",
