      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NAM 1:12"
      },
      "items": [
        {
          "text": "\"Ọ bụ ezie na ha siri ike, ma bakwaa ụba nʼọnụọgụgụ,",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.12",
            "verseOrgIds": [
