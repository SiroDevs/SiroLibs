                "verseId": "EXO.6.28",
                "verseOrgIds": [
                  "EXO.6.28"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu nʼIjipt,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.28",
            "verseOrgIds": [
              "EXO.6.28"
            ]
