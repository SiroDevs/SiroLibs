              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị ya, \"Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.29",
                "verseOrgIds": [
                  "EXO.6.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", gaa gwa Fero eze Ijipt ihe niile m gwara gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.29",
            "verseOrgIds": [
              "EXO.6.29"
            ]
          }
        }
      ]
