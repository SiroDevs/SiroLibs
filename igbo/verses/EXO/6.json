        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.6.26",
                "verseOrgIds": [
                  "EXO.6.26"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara okwu sị, \"Sitenụ nʼala Ijipt dupụta ụmụ Izrel dịka ọnụọgụgụ ha si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
          }
