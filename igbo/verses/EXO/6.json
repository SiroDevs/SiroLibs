      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EXO 6:18"
      },
      "items": [
        {
          "text": "Kohat gbara narị afọ na iri afọ atọ na atọ mgbe ọ nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.18",
            "verseOrgIds": [
