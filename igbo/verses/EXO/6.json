          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ ndị gwara Fero, eze Ijipt okwu banyere ime ka ụmụ Izrel site nʼala Ijipt pụọ. Ọ bụkwa otu Mosis na Erọn ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.27",
            "verseOrgIds": [
              "EXO.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Erọn ga-ekwuchitere Mosis ọnụ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
