              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa Mosis na Erọn ka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.6.26",
            "verseOrgIds": [
              "EXO.6.26"
            ]
