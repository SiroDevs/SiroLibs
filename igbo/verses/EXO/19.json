                "verseOrgIds": [
                  "EXO.19.23"
                ]
              }
            }
          ]
        },
        {
          "text": "sị, \"Ndị mmadụ agaghị arịgota nʼugwu Saịnaị nʼihi na gị onwe gị adọọla anyị aka na ntị sị, 'Kpaanụ oke gburugburu ugwu a, doo ya nsọ.' \"",
