  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "EXO 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebe ịchụ aja ihe nsure ọkụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji osisi akashia wuo ebe ịchụ aja nke aja nsure ọkụ. Nke ịla elu ya dị otu mita na iri sentimita atọ. Ogologo ya na obosara ya ha nʼotu. Ha dị mita abụọ na iri sentimita atọ, mita abụọ na iri sentimita atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.1",
            "verseOrgIds": [
              "EXO.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha rụnyekwara mpi nʼakụkụ anọ nke ebe ịchụ aja ahụ nʼotu nʼotu. Mee ka mpi ndị a na ebe ịchụ aja ahụ ghọọ nke e jikọtara nʼotu. Ha jikwa bronz machie ebe ịchụ aja a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.2",
            "verseOrgIds": [
              "EXO.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji bronz kpụọ ngwongwo niile dị iche iche, ya bụ efere ikpofu ntụ, shọvel ya niile, efere ịkwọsa mmiri niile, ngaji eze ịdụta anụ na efere ndị e ji agụ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.3",
            "verseOrgIds": [
              "EXO.38.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mere ngịga mbadamba maka ebe ịchụ aja ahụ, ihe ọkpụkpa bronz, nke ga-adị nʼokpuru oghere ọnụ ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.4",
            "verseOrgIds": [
              "EXO.38.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpụrụ mgbaka bronz ndị a ga-eji jide mkpara ndị ahụ maka akụkụ anọ nke ngịga bronz ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.5",
            "verseOrgIds": [
              "EXO.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mere mkpara osisi akashia ndị a, were bronz machie ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.6",
            "verseOrgIds": [
              "EXO.38.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mere ka mkpara ndị ahụ baa nʼime mgbaaka ndị ahụ, ime ka ha dịrị nʼakụkụ abụọ nke ebe ịchụ aja ahụ maka iji nʼebu ya. Ha ji obodobo osisi rụọ ya dịka igbe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.7",
            "verseOrgIds": [
              "EXO.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efere ịsa ihe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji bronz kpụọ efere ukwu na ihe ndọkwasị ya. Ọ bụ enyo nke ndị inyom ahụ ndị na-eje ozi nʼọnụ ụzọ ụlọ nzute ka e ji kpụọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.8",
            "verseOrgIds": [
              "EXO.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogige ụlọ nzute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọ, ha mere ogige ahụ. Ịdị ogologo nke nʼakụkụ ndịda dị iri mita anọ na ise. O nwere akwa mgbochi nke e ji ezi akwa ọcha a kpara nke ọma mee.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.9",
            "verseOrgIds": [
              "EXO.38.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ogidi abụọ ga-adị na iri ebe ndọkwasị abụọ nke e ji bronz kpụọ. Anya nko ogidi ndị ahụ ha na ihe ikegide ha ga-abụ ọlaọcha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.10",
            "verseOrgIds": [
              "EXO.38.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, akụkụ ugwu dịkwa iri mita anọ na ise. O nwere iri ogidi abụọ na iri ebe ndọkwasị abụọ nke e ji bronz kpụọ, na anya nko nke ọlaọcha na ihe e ji ekegide ha nʼogidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.11",
            "verseOrgIds": [
              "EXO.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkụ ọdịda anyanwụ dị iri mita abụọ na atọ. Nwekwaa akwa mgbochi, nwere ogidi iri na ebe ndọkwasị iri, tinyere anya nko ọlaọcha na ihe e ji ekegide ha nʼogidi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.12",
            "verseOrgIds": [
              "EXO.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ọwụwa anyanwụ, ebe anwụ na-awalite dịkwa iri mita abụọ na atọ nʼobosara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.13",
            "verseOrgIds": [
              "EXO.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi nke ogologo ya dị mita isii na sentimita iri asatọ bụ ihe dị nʼotu akụkụ nke ọnụ ụzọ mbata ahụ. O nwere ogidi atọ na ebe ndọkwasị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.14",
            "verseOrgIds": [
              "EXO.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, akwa mgbochi nke ịdị ogologo ya dị mita asaa bụ ihe dị nʼakụkụ nke ọzọ nke ọnụ ụzọ mbata nke ogige ahụ. Ọ ga-enwekwa ogidi atọ na ebe ndọkwasị atọ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.15",
            "verseOrgIds": [
              "EXO.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi niile nke ogige ahụ gburugburu bụ ezi akwa ọcha a kpara nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.16",
            "verseOrgIds": [
              "EXO.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogidi ọbụla nwere ihe ndọkwasị bronz. Nko niile na ihe njikọta niile ka e jikwa ọlaọcha machie. Ọ bụkwa naanị ọlaọcha ka e ji mee okporo osisi ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.17",
            "verseOrgIds": [
              "EXO.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwa mgbochi nke ọnụ ụzọ mbata nke ogige ahụ bụ ihe e ji ogho na-acha anụnụ anụnụ, ngwakọta anụnụ na uhie, uhie uhie na nke ezi akwa ọcha a kpara nke ọma mee; akaọrụ nke onye na-akpa ihe ịchọ mma. Ọ dị mita itoolu nʼogologo, yikwaa akwa mgbochi nke ebe ogige ahụ, dị mita abụọ na iri sentimita atọ nʼịdị elu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.18",
            "verseOrgIds": [
              "EXO.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ogidi anọ ka e ji jidesie ha ike na ihe ndọkwasị bronz anọ, nko na okporo osisi ha niile bụ ọlaọcha. E jikwa ọlaọcha machie isi ogidi ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.19",
            "verseOrgIds": [
              "EXO.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ǹtu niile nke ụlọ nzute ahụ nakwa nʼogige ya gburugburu bụ bronz ka e ji kpụọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.20",
            "verseOrgIds": [
              "EXO.38.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ngwongwo e ji wuo ụlọ nzute",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ngwongwo niile e ji wuo ụlọ nzute ahụ; ebe a ga-edebe Ihe Ama ahụ. Ọ bụ ndị Livayị depụtara ihe niile ndị a nʼusoro dịka Mosis si nye ha nʼiwu. Ọ bụkwa Itama, nwa Erọn onye nchụaja, lekọtara ndị niile rụrụ ọrụ idekọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.21",
            "verseOrgIds": [
              "EXO.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bezalel, nwa Uri, nwa Hua, onye si nʼebo Juda, rụzuru ihe niile dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.38.22",
                "verseOrgIds": [
                  "EXO.38.22"
                ]
              }
            }
          ]
        },
        {
          "text": "si nye ya Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.22",
            "verseOrgIds": [
              "EXO.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-enyere ya aka bụ Oholiab nwa Ahisamak, onye ebo Dan, bụ onye ọka a maara aha ya, ọ bụ onye ọka ihe ọtụtụ, na onye ọka ịdụnye ihe ịchọ mma dị iche iche nʼakwa na-acha anụnụ anụnụ, nke ngwakọta anụnụ na uhie, uhie uhie nakwa ezi akwa ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.23",
            "verseOrgIds": [
              "EXO.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke onyinye ọlaedo niile sitere nʼaja mfufe ahụ nke ndị mmadụ wetara maka ịrụ ebe nsọ ahụ, bụ otu puku na narị kilogram ise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.24",
            "verseOrgIds": [
              "EXO.38.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke ọlaọcha enwetara nʼaka ọgbakọ ahụ, bụ puku kilogram anọ, na narị kilogram isii na iri ise dịka shekel ebe nsọ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile tụrụ otu beka, otu isi, dịka ụtụ mgbe e kere ụtụ ọkara shekel dịka ọtụtụ shekel ebe nsọ si dị, e nyere nʼisi onye ọbụla nke gabigara nʼebe ndị a gụrụ ọnụ nọ, bụ ndị gbara iri afọ abụọ rigoo. Ọnụọgụgụ ha dị narị isii, na puku atọ, na narị ise, na iri ise.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke ọlaọcha niile e ji rụọ ụkwụ ibo niile nke ebe nsọ ahụ, na ụkwụ ogidi niile e ji jidesie akwa mgbochi ndị ahụ ike bụ puku kilogram atọ, na narị kilogram isii. Ịdị arọ nke ọlaọcha e ji wuo ụkwụ ọbụla bụ iri kilogram atọ na isii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke ọlaọcha e ji menye nko nʼibo osisi niile, na nke e ji machie okporo osisi niile, na nke e ji techie isi ogidi osisi niile, bụ iri kilogram abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 38:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị arọ nke bronz niile ndị mmadụ wetara dịka onyinye aja mfufe bụ puku kilogram atọ, na narị kilogram atọ, na iri isii.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.29",
            "verseOrgIds": [
              "EXO.38.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 38:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji bronz ndị a wuo ụkwụ ogidi niile a manyere nʼihu ụzọ e si abata ogige ụlọ nzute ahụ. E jikwa ya wuo ebe ịchụ aja bronz ahụ, na ihe ọkpụkpụ bronz ahụ, na ngwongwo niile e ji eje ozi nʼebe ịchụ aja,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.30",
            "verseOrgIds": [
              "EXO.38.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 38:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ụkwụ ogidi a manyere nʼihu ụlọ nzute, na ǹtu niile e ji wuo ụlọ nzute ahụ, na ogige gbara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.31",
            "verseOrgIds": [
              "EXO.38.31"
            ]
          }
        }
      ]
