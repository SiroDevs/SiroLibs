            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.18",
                "verseOrgIds": [
                  "EXO.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ekpere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.19",
                "verseOrgIds": [
                  "EXO.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "zitere ikuku nke si nʼebe anyanwụ na-ada bịa, nke bupụrụ igurube ndị ahụ site nʼala Ijipt, buba ha nʼOsimiri Uhie. Ọ dịkwaghị otu igurube fọdụrụ nʼala Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.10.20",
                "verseOrgIds": [
                  "EXO.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka obi Fero sie ike, o kweghị ka ụmụ Izrel gaa fee Chineke ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
