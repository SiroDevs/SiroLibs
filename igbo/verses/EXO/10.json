            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis hapụrụ Fero pụọ gaa kpeere",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
        {
          "name": "char",
