  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "EXO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebe ịchụ aja ụda na-esi isi ụtọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jiri osisi akashia rụọ ebe ịchụ aja ihe nsure ọkụ na-esi isi ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.1",
            "verseOrgIds": [
              "EXO.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkụ anọ ya ga-aha nʼotu. Ogologo ya na obosara ya ga-adị iri sentimita anọ na ise. Ịdị elu ya ga-adị iri sentimita itoolu. Mpi ya niile ga-esi na ya pụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.2",
            "verseOrgIds": [
              "EXO.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jiri ọlaedo a nụchara anụcha machie elu ya, akụkụ ya niile nakwa mpi ya niile. Ị ga-ejikwa ọlaedo kpụlite ọnụ ọnụ ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.3",
            "verseOrgIds": [
              "EXO.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpụnye mgbaaka ọlaedo abụọ nʼokpuru ihe ahụ akpụlitere akpụlite, abụọ na ncherita ihu akụkụ ọbụla, ebe ga na-ejide mkpara e ji ebu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.4",
            "verseOrgIds": [
              "EXO.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji osisi akashia mee mkpara, jiri ọlaedo machie ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.5",
            "verseOrgIds": [
              "EXO.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-adọba ebe ịchụ aja ahụ nʼihu akwa mgbochi nke kpuchiri igbe iwu ọgbụgba ndụ ahụ, nʼihu oche ebere ahụ dị nʼelu igbe iwu ọgbụgba ndụ, nʼebe m ga-ezute gị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.6",
            "verseOrgIds": [
              "EXO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụtụtụ niile, mgbe Erọn doziri oriọna, ọ ga-esure ihe nsure ọkụ na-esi isi ụtọ nʼelu ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.7",
            "verseOrgIds": [
              "EXO.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanyasị kwa, mgbe ọ na-amụnye ọkụ nʼoriọna ahụ, ọ ga-esurekwa ihe nsure ọkụ. Ihe nsure ọkụ na-esi isi ụtọ nke ga-adị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.8",
                "verseOrgIds": [
                  "EXO.30.8"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.8",
            "verseOrgIds": [
              "EXO.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu echekwala ihe nsure ọkụ na-esi isi ụtọ na-adịghị nsọ nʼelu ya, maọbụ aja nsure ọkụ, maọbụ aja ihe oriri, unu awụpụla onyinye ihe ọṅụṅụ nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.9",
            "verseOrgIds": [
              "EXO.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ugbo nʼafọ Erọn ga-ekpuchi mmehie nʼelu mpi ya. Mmemme mkpuchi mmehie a nke a na-eme otu ugbo nʼafọ, aghaghị ịbụ nke e ji ọbara nke si nʼaja a chụrụ nʼihi mkpuchi mmehie,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "text": "nʼihi ọgbọ niile nke na-abịa. A ga na-edo ebe ịchụ aja nsọ otu a. Nke a bụ ebe dịkarịsịrị nsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.10",
                "verseOrgIds": [
                  "EXO.30.10"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.10",
            "verseOrgIds": [
              "EXO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụtụ nʼihi ikpuchi mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nke a gasịrị,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.11",
                "verseOrgIds": [
                  "EXO.30.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ọbụla a gụrụ mmadụ ọnụ, onye Izrel ọbụla ga-akwụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.12",
                "verseOrgIds": [
                  "EXO.30.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ụgwọ o ji gbara mkpụrụobi ya. Nke a dị mkpa, ka ihe otiti ọbụla ghara ịbịakwasị ha mgbe ị ga-agụ ha ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.12",
            "verseOrgIds": [
              "EXO.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe onye a gụrụ ọnụ ga-akwụ bụ ọkara shekel, dịka shekel nke ebe nsọ si dị. Ọkara shekel bụ iri gera abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "text": "Ọkara shekel a bụ onyinye nye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.13",
                "verseOrgIds": [
                  "EXO.30.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị kwesiri inye onyinye a bụ ndị niile gbara iri afọ abụọ gbagoo. Ọ bụ ndị a kwesiri inye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.14",
                "verseOrgIds": [
                  "EXO.30.14"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye a.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọgaranya agaghị enye karịa ọkara shekel. Otu a kwa ndị ogbenye agaghị enye ihe dị ntakịrị karịa ọkara shekel. Nʼihi na onyinye a bụ onyinye unu na-enye",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.15",
                "verseOrgIds": [
                  "EXO.30.15"
                ]
              }
            }
          ]
        },
        {
          "text": "maka ikpuchiri mkpụrụobi unu mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabata ego niile ndị a site nʼaka ụmụ Izrel, ma jiri ya jee ozi dị nʼụlọ nzute. Ihe onyinye a ga-eme bụ ịkpọtụ uche",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.16",
                "verseOrgIds": [
                  "EXO.30.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼebe unu nọ nʼihi mkpuchi mmehie maka ndụ unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Efere mmiri ọsịsa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.17",
                "verseOrgIds": [
                  "EXO.30.17"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.17",
            "verseOrgIds": [
              "EXO.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jiri bronz kpụọ efere ukwu na ihe ndọkwasị ya, maka ịsa ihe. Wụnye mmiri nʼime ya, dọsa ya nʼetiti ụlọ nzute na ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erọn na ụmụ ya ndị ikom ga na-asa ụkwụ na aka ha site na ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla ha na-aba nʼụlọ nzute ahụ, ha ga-eji mmiri saa onwe ka ha ghara ịnwụ. Ọzọkwa, mgbe ha na-abịaru nso nʼebe ịchụ aja, maka ije ozi iche onyinye nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.20",
                "verseOrgIds": [
                  "EXO.30.20"
                ]
              }
            }
          ]
        },
        {
          "text": "site nʼọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha ga-asa aka ha na ụkwụ ha, ka ha ghara ịnwụ. Nke a ga-abụ ụkpụrụ dịrị Erọn na ụmụ ya ndị ikom site nʼọgbọ ruo nʼọgbọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmanụ Nsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.22",
                "verseOrgIds": [
                  "EXO.30.22"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.22",
            "verseOrgIds": [
              "EXO.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Were eso osisi na-esi isi ụtọ ndị a dị iche iche: máá, nke ọtụtụ ya ruru kilo isii, na ihe ruru kilo sinamọn abụọ na ụma itoolu, na kilo kalamus atọ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.23",
            "verseOrgIds": [
              "EXO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "na kilo kashia isii, na lita anọ na ụma asatọ nke mmanụ oliv,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "text": "dịka ọtụtụ shekel ebe nsọ ahụ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.24",
            "verseOrgIds": [
              "EXO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-eji ya mepụta mmanụ nsọ, nke dị nsọ, nke a gwakọtara nke ọma dịka nke onye na-eme mmanụ na-esi isi ụtọ mere. Ọ ga-abụ mmanụ otite dị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.25",
            "verseOrgIds": [
              "EXO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ewere mmanụ ahụ tee ụlọ nzute ahụ niile na igbe iwu ọgbụgba ndụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.26",
            "verseOrgIds": [
              "EXO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "na tebul ahụ, na ngwongwo ya niile, na nʼihe ịdọsa oriọna, na nʼihe niile dị ya nʼahụ, na nʼebe ịdọsa ihe nsure ọkụ na-esi isi ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.27",
            "verseOrgIds": [
              "EXO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "na nʼebe ịchụ aja nke aja nsure ọkụ, na ngwongwo ya niile, na nʼite ịsa ụkwụ na aka, na nʼebe a na-adọba ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.28",
            "verseOrgIds": [
              "EXO.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-edo ha nsọ, ka ha bụrụ ihe dịkarịrị nsọ. Ihe ọbụla metụrụ ha ahụ ga-adịkwa nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.29",
            "verseOrgIds": [
              "EXO.30.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị ga-eji mmanụ otite a tee Erọn na ụmụ ya ndị ikom. Ha niile ga-adịkwa nsọ, bụrụ ndị na-ejere m ozi dịka ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.30",
            "verseOrgIds": [
              "EXO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ụmụ Izrel okwu sị ha, 'Nke a bụ mmanụ nsọ m, nke dị nsọ site nʼọgbọ ruo nʼọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.31",
            "verseOrgIds": [
              "EXO.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agaghị awụsa ya nʼahụ mmadụ. O nwekwaghị onye kwesiri imepụta mmanụ otite dị otu a. Ọ dị nsọ, unu kwesikwara ido ya nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.32",
            "verseOrgIds": [
              "EXO.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esite nʼetiti ndị m wezuga onye ọbụla mere ụdị mmanụ isi ọma a, maọbụ tee ya onye na-abụghị onye nchụaja m.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.33",
            "verseOrgIds": [
              "EXO.30.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe nsure ọkụ na-esi isi ụtọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.34",
                "verseOrgIds": [
                  "EXO.30.34"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị, \"Were ụda na-esi isi ụtọ, dịka eso osisi stakit, na ọnyịcha, na galbanọm, na ezigbo frankisens a na-agwaghị ihe, nke ọtụtụ ha niile ga-abụ otu ihe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.34",
            "verseOrgIds": [
              "EXO.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ihe nsure ọkụ na-esi isi ụtọ, nke a gwakọtara nke ọma, bụ ọrụ onye na-eme mmanụ isi ụtọ. Tinyekwa ya nnu, ka ọ bụrụ ihe nsure ọkụ a nụchara anụcha, nke dịkwa nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.35",
            "verseOrgIds": [
              "EXO.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwerie ụfọdụ nʼime ya ka ọ dịka uzuzu. Wụsa ya nʼihu igbe iwu ọgbụgba ndụ ahụ nʼime ụlọ nzute, ebe m ga-ezute gị. Ọ ga-abụ ihe dịkarịsịrị nsọ nye unu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.36",
            "verseOrgIds": [
              "EXO.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu emerela onwe unu nke dịka ọtụtụ ụdị ihe nsure ọkụ a. Hụta ya ka ihe dị nsọ nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.30.37",
                "verseOrgIds": [
                  "EXO.30.37"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.37",
            "verseOrgIds": [
              "EXO.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla meere onwe ya ụdị ihe nsure ọkụ a, ịnụ isisi ya, a ga-ekewapụ onye ahụ site nʼetiti ụmụnna ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.38",
            "verseOrgIds": [
              "EXO.30.38"
            ]
          }
        }
      ]
    }
  ],
