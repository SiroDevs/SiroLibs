  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EXO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe ịrịbama dị iche iche",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.1",
                "verseOrgIds": [
                  "EXO.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu sị, \"Emeela m gị ka ị dịrị ka Chineke nʼebe Fero nọ. Nwanne gị Erọn ga-abụkwa onye amụma gị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-agwa Erọn ihe niile m gwara gị. Ọ ga-ekwukwa ha nʼihu Fero, rịọọ ya ka o kwere ka ụmụ Izrel hapụ ala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m eme ka obi Fero sie ike. Ọ bụ ezie na m ga-eme ọtụtụ ihe ịrịbama nʼihe ebube nʼala Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma Fero agaghị ege unu ntị. Mgbe ahụ aga m eme ka aka m bịakwasị Ijipt. Aga m esite nʼoke ọrụ nke ikpe ọmụma dị oke egwu, mee ka ndị m, Izrel, dịka usuu ha niile si dị, site nʼala Ijipt pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Ijipt ga-amata nʼezie na m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.5",
                "verseOrgIds": [
                  "EXO.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", mgbe m setịpụrụ aka nʼIjipt, ma site nʼetiti ha kpọpụta ụmụ Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis na Erọn mere dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.6",
                "verseOrgIds": [
                  "EXO.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ha iwu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, mgbe ha gwara Fero okwu, Mosis agbaala iri afọ asatọ. Ma Erọn agbaala iri afọ asatọ na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpanaka Erọn aghọọ agwọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.8",
                "verseOrgIds": [
                  "EXO.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn sị,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe Fero ga-agwa unu okwu sị, 'Meenụ ihe ebube.' Ị ga-agwa Erọn okwu sị ya, 'Were mkpanaka gị tụpụ ya nʼala nʼihu Fero.' Ọ ga-aghọ agwọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mosis na Erọn jekwuuru Fero mee dịka Onyenwe anyị nyere ha nʼiwu. Erọn tụpụrụ mkpanaka ya nʼala nʼihu Fero na ndị ozi ya. Ọ ghọrọ agwọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Fero kpọkọtara ndị maara ihe, na ndị mgbaasị, na ndị majiki nọ nʼIjipt. Ha bịara mee ụdị ihe ịrịbama ahụ Mosis na Erọn mere site nʼihe nzuzo nke akaọrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nʼime ha tụpụrụ mkpanaka ya, nke ghọkwara agwọ. Ma mkpanaka ahụ Erọn tụpụrụ, nke ghọrọ agwọ, loro mkpanaka ndị ahụ niile ndị Ijipt tụpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero nyịchiri obi ya, mee ka o sie ike. O geghị Erọn na Mosis ntị dịka Onyenwe anyị kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmiri aghọọ ọbara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.14",
                "verseOrgIds": [
                  "EXO.7.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị, \"Obi Fero siri ike. Ọ bụ nke a mere o ji na-aga nʼihu na-ajụ ka ndị m laa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị; nʼisi ụtụtụ echi, jekwuru Fero tupu ọ gaa nʼosimiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "text": "Guzoro nʼakụkụ osimiri Naịl, jidekwa mkpanaka ahụ ghọrọ agwọ nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-agwa Fero sị, '",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.16",
                "verseOrgIds": [
                  "EXO.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke ndị Hibru, ezitela m ka m gwa gị sị, hapụ ndị m ka ha gaa nʼọzara fee m ofufe. Tutu ruo ugbu a, ị jụrụ ige ntị.'",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.17",
                "verseOrgIds": [
                  "EXO.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru nke a sị, 'Ị ga-amata site na nke a na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.17",
                "verseOrgIds": [
                  "EXO.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": ". Aga m ewere mkpanaka a nke m ji nʼaka tie nʼosimiri Naịl. Ọ ga-agbanwe ghọọ ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụ niile dị nʼime ya ga-anwụ. Osimiri ahụ ga-esikwa isi dịka ihe rere ure. Nke a ga-eme ka ọ bụrụ ihe rara ahụ nye ndị Ijipt ịṅụ mmiri site na ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.19",
                "verseOrgIds": [
                  "EXO.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis sị ya, \"Gwa Erọn ka o setịpụ mkpanaka ya nʼelu mmiri niile dị nʼIjipt. Nke a metụtara osimiri ha niile, mmiri ntakịrị ha niile, ọdọ mmiri ha niile, na ebe niile ha na-echekọta mmiri. Ọbara ga-ejupụta ebe niile nʼIjipt, ite mmiri na ite aja na ite osisi niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis na Erọn mere dị ka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.20",
                "verseOrgIds": [
                  "EXO.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ha nʼiwu ime. Nʼihu Fero na ndịisi ọrụ ya, Erọn weliri mkpanaka ya tie ya nʼelu mmiri dị nʼosimiri Naịl. Nʼotu ntabi anya, mmiri ahụ gbanwere ghọọ ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka azụ dị nʼime mmiri Naịl nwụsịrị, mmiri ahụ malitere na-esi isi ọjọọ, nke mere ka ndị Ijipt hapụ inwe ike ịṅụ mmiri sitere na ya. Ọbara jupụtakwara nʼala Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị majiki Ijipt jikwa ihe nzuzo ha mee ka mmiri chaa ọbara ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "text": "Nke a mere ka Fero nyịchie obi ya. Ọ ṅaghị Mosis na Erọn ntị, dịka",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.22",
                "verseOrgIds": [
                  "EXO.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ha na ọ ga-eme.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero tụgharịrị laghachi nʼụlọeze ya, na-echeghị echiche banyere ihe niile ahụ e mere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị Ijipt niile gwuru olulu mmiri nʼakụkụ osimiri ahụ ịchọ mmiri ọṅụṅụ ebe ha na-enweghị ike ịṅụ mmiri sitere nʼosimiri Naịl.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Awọ ejupụta nʼala Ijipt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị asaa gasịrị, site nʼụbọchị",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.7.25",
                "verseOrgIds": [
                  "EXO.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "tichara ihe otiti ahụ na Naịl.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
