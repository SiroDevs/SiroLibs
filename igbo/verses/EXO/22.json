  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "EXO 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nchekwa akụ na nkwụghachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na mmadụ ezuru ehi maọbụ atụrụ gbuo ya, maọbụ ree ya, ọ ga-akwụghachi ehi ise nʼọnọdụ ehi ahụ. Nʼọnọdụ otu atụrụ o zuuru, ọ ga-akwụghachi atụrụ anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na e jide onye ohi mgbe ọ na-egbuka ụlọ onye ọzọ, ọ bụrụkwa na e tigbuo ya, mee ka ọ nwụọ, iwu ejideghị onye ahụ gburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ọ bụrụ na e tigburu onye ahụ mgbe chi bọcharala, ọmụma ikpe ga-adịrị onye ahụ tigburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:3"
      },
      "items": [
        {
          "text": "\"Ọ bụrụ na e jide onye ohi, a ga-eme ka ọ kwụghachi ihe o zuru nʼohi. Ọ bụrụ na o nweghị ike kwụghachi, a ga-ere ya dịka ohu, jiri ego e retara kwụọ ụgwọ o ji.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a chọta ihe o zuru nʼaka ya, maọbụ ehi, maọbụ ịnyịnya ibu, maọbụ atụrụ, ọ ga-akwụghachi ọnụahịa ya okpukpu abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na mmadụ akpachara anya hapụ anụ ụlọ ya ka ọ gaa taa nri nʼubi maọbụ nʼubi vaịnị, maọbụ nʼubi onye ọzọ, onyenwe anụ ụlọ ahụ ga-akwụ ụgwọ ihe niile anụ ụlọ ya mebiri, ma ihe ọ ga-eji kwụọ ụgwọ ahụ aghaghị ịbụ ihe ọrụ ubi dị mma nke o si nʼubi ya maọbụ nʼubi vaịnị ya wepụta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ọkụ na-agba banye nʼogwu, repịa ogbo ọka dị nʼubi mmadụ maọbụ ọka guzoro eguzo, ma ọ bụkwanụ ọhịa niile, onye ahụ tinyere ọkụ ahụ ga-akwụghachi ụgwọ ihe ahụ niile nke ọkụ repịara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na mmadụ enye enyi ya maọbụ onye agbataobi ya ego, maọbụ ihe ọbụla ka o debere ya, ma onye ohi agaa zuru ya site nʼụlọ ya, a si na e jide onye ohi dị otu a, ọ ga-akwụghachi ụgwọ ihe o zuru okpukpu abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a chọpụtaghị onye ohi ahụ, onye nwe ụlọ ahụ aghaghị ịbịa nʼihu Chineke, ka a chọpụta maọbụ ya nʼonwe ya setịpụrụ aka were ihe ahụ, bụ akụ nke onye ọzọ kpatara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ehi ya, maọbụ ịnyịnya ibu ya, maọbụ atụrụ ya, maọbụ uwe, maọbụ ihe ọbụla furu efu, nke mmadụ na-asị, 'Nke a bụ ya.' Mmadụ abụọ ndị a ga-aga nʼihu ndị ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        },
        {
          "text": "Onye ọbụla ndị ikpe a mara ikpe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        },
        {
          "text": "ga-akwụghachi ibe ya ụgwọ okpukpu abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na anụ ụlọ mmadụ nyere onye agbataobi ya nʼaka idebe anwụọ, maọbụ merụọ ahụ, maọbụ gbafuo, ma anụ ụlọ ahụ ọ bụ ịnyịnya ibu, maọbụ ehi, maọbụ atụrụ, maọbụ anụ ụlọ ọzọ, ọ bụrụ na ọ dịghị onye hụrụ mgbe ihe ndị a dakwasịrị anụ ụlọ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, onye agbataobi ahụ e nyere anụ ndị a nʼaka idebe ga-aṅụ iyi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.11",
                "verseOrgIds": [
                  "EXO.22.10"
                ]
              }
            }
          ]
        },
        {
          "text": ". Iyi ahụ ọ ṅụrụ ga-egosi onyenwe anụ ụlọ ahụ na o zughị ya nʼohi. Nʼihi nke a, ọ gaghị akwụghachi ụgwọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na o zuru anụ ụlọ ahụ nʼohi site na nke agbataobi ya, ọ ghaghị ịkwụghachi ụgwọ niile nye onyenwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na anụ ọhịa gburu ya, ọ ga-eweta ụfọdụ nʼime anụ ahụ a dọgburu adọgbu, iji gosi na anụ ọhịa dọgburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        },
        {
          "text": "Ọ ga-esikwa otu a gbanarị ikpe ọmụma. Nʼihi nke a, ọ gaghị akwụkwa ụgwọ ọbụla nʼihi anụ ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na mmadụ agbaziri anụ ụlọ site nʼaka onye agbataobi ya, ọ bụrụ na anụ ụlọ ahụ anwụọ, maọbụ merụọ ahụ mgbe onyenwe ya na-anọghị nʼebe ahụ, onye ahụ a gbazinyere anụ ụlọ ahụ ga-akwụ ụgwọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na anụ ụlọ ahụ nọ na nke onyenwe ya, onye gbaziri ya agaghị akwụ ụgwọ ọbụla. Ọ bụrụ na a kwụrụ ego mgbazi ọbụla nʼisi anụmanụ a, onye gbaziri ya agaghị akwụghachi ego ọbụla, nʼihi na ego mgbazi ọ kwuru ka a ga-ewere dịka ụgwọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ibi ndụ dị ka o kwesiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na nwoke arafuo nwaagbọghọ na-amaghị nwoke,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "text": "site nʼime ka ha abụọ dinaa, nwoke ahụ ga-akwụ ụgwọ isi nwaagbọghọ ahụ. Ọ ga-alụkwa ya dịka nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.16",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na nna nwaagbọghọ ahụ ekwenyeghị ka nwoke ahụ lụọ ya, nwoke ahụ aghaghị ịkwụ ụgwọ isi nwaagbọghọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.17",
            "verseOrgIds": [
              "EXO.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"E kwesighị ịhapụ nwanyị mgbaasị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.18",
            "verseOrgIds": [
              "EXO.22.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ọbụla ya na anụ ọbụla dinakọrọ, e kwesiri ime ka ọ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.19",
            "verseOrgIds": [
              "EXO.22.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ọbụla chụrụ aja nye chi ọzọ ma ọ bụghị naanị",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EXO.22.20",
                "verseOrgIds": [
                  "EXO.22.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", a ga-eme ka ọ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.20",
            "verseOrgIds": [
              "EXO.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ kwesighị ka mmadụ ọbụla mesie onye ọbịa ihe ike nʼụzọ ọbụla. Unu aghaghị icheta na unu bụ ndị ọbịa nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu emegbula nwanyị ọbụla di ya nwụrụ, maọbụ onye ọbụla na-enweghị nne na nna.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.22",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu megbuo ha, mee ka ha tikuo m, aga m anụ mkpu akwa ha, nyere ha aka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.23",
            "verseOrgIds": [
              "EXO.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, iwe m dị oke ọkụ ga-eripịa unu. Aga m ejikwa mma agha tigbuo unu. Ndị nwunye unu ga-aghọkwa ndị inyom na-enweghị di, ụmụ unu ga-abụkwa ndị na-enweghị nna.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.24",
            "verseOrgIds": [
              "EXO.22.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ị gbazinyere onye Hibru ego, onye bụ nwa mgbei, ị gaghị anara ya ọmụrụnwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ị nara ya uwe ya nʼihi ego ahụ ị gbazinyere ya, ekwela ka uwe ahụ nọgide nʼaka gị ruo mgbe anwụ dara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na uwe ahụ nwere ike bụrụ naanị ihe o nwere, maọbụ uwe ọ ga-eji rahụ ụra. Ọ bụrụ na i zighachighị ya, o tikuo m site nʼịkwa akwa, aga m anụrụ mkpu akwa ya, nʼihi na abụ m onye obi ebere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekwulula aha Chineke, abụkwala onye na-achị ndị gị ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Atụfukwala oge ọbụla nʼịkwụghachi onyinye unu kwesiri inye. Maọbụ nke mkpụrụ ala ubi gị, na nke mmanya vaịnị gị, na ụgwọ i kwesiri ịkwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EXO 22:29"
      },
      "items": [
        {
          "text": "\"Ị ghaghị inye m nwa gị nwoke e buru ụzọ mụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.29",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ị ga-emekwa banyere mkpụrụ mbụ nke ehi gị na atụrụ gị. Ị ga-ewebata ya nye m nʼụbọchị nke asatọ site nʼoge a mụrụ ha, mgbe ị hapụsịrị ha nne ha ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.30",
            "verseOrgIds": [
              "EXO.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu ga na-abụrụ m ndị dị nsọ. Nʼihi nke a, wezuganụ onwe unu nʼebe anụ a dọgburu adọgbu dị. Unu erikwala anụ dị otu a, kama tụpụrụnụ ya nkịta.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.31",
            "verseOrgIds": [
              "EXO.22.30"
            ]
          }
        }
      ]
    }
  ],
