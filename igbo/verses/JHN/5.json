            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enwere m onye ọzọ na-agbara m ama, amatakwara m na ama ya banyere m bụ eziokwu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.32",
                "verseOrgIds": [
                  "JHN.5.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
