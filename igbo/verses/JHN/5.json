                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Enweghị m ike ime ihe ọbụla nʼonwe m, ikpe m na-ekpe bụ naanị dị ka m nụrụ, ikpe m bụkwa nke ziri ezi, nʼihi na anaghị m eme ihe ga-amasị m, kama ọ bụ ihe ga-amasị onye ahụ zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
                "verseOrgIds": [
                  "JHN.5.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbụgba ama maka Jisọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
