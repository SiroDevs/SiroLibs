          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na m na-agba ama banyere onwe m, ama m abụghị eziokwu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.31",
                "verseOrgIds": [
                  "JHN.5.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
