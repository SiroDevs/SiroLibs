        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ma pụta, ndị mere ihe dị mma ga-ebili dịrị ndụ. Ma ndị mere ihe ọjọọ ga-ebili bụrụ ndị a ga-ama ikpe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.29",
                "verseOrgIds": [
