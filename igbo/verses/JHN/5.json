              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu zigaara Jọn ndị ozi, ọ gbakwaala ama maka eziokwu ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.33",
                "verseOrgIds": [
                  "JHN.5.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụghị na m na-anabata ama nke mmadụ, kama a na m ekwu ya ka enwe ike ịzọpụta unu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.34",
                "verseOrgIds": [
                  "JHN.5.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụ oriọna nke na-enwu na-amụkekwa, unu họrọkwara ịṅụrị ọṅụ nʼìhè ya nʼoge nta.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.35",
                "verseOrgIds": [
                  "JHN.5.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma e nwere m ama dị ukwuu karịa nke Jọn, nʼihi na ọrụ ahụ ya bụ Nna nyere m ka m rụchapụ, bụkwa nke m na-arụ, na-agbara m ama na ọ bụ Nna ahụ zitere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.36",
                "verseOrgIds": [
                  "JHN.5.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya bụ Nna ahụ zitere m na-agbakwa ama nʼonwe ya banyere m. Unu anụbeghị olu maọbụ hụ ụdịdị ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
                "verseOrgIds": [
                  "JHN.5.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Okwu ya anọkwaghị nʼime unu nʼihi na unu ekweghị nʼonye o zitere.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.38",
                "verseOrgIds": [
                  "JHN.5.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu na-enyocha akwụkwọ nsọ nʼihi na unu chere na unu ga-esite na ha nwee ndụ ebighị ebi maọbụ ha na-agba ama banyere m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.39",
                "verseOrgIds": [
                  "JHN.5.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma unu jụrụ ịbịakwute m ka unu nwee ndụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.40",
                "verseOrgIds": [
                  "JHN.5.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Anaghị m anabata otuto nke ụmụ mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.41",
                "verseOrgIds": [
                  "JHN.5.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma amatara m na unu enweghị ịhụnanya Chineke nʼobi unu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.42",
                "verseOrgIds": [
                  "JHN.5.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abịala m nʼaha Nna m ma unu anabataghị m. Ma ọ bụrụ na onye ọzọ abịa nʼaha nke onwe ya, unu ga-anabata ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
                "verseOrgIds": [
                  "JHN.5.43"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee otu unu ga-esi kwere ebe unu na-anara otuto site nʼaka ibe unu, ma unu adịghị achọ otuto nke si nʼaka onye naanị ya bụ Chineke?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
                "verseOrgIds": [
                  "JHN.5.44"
