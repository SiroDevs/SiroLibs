        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ka mmadụ niile nye Ọkpara ahụ nsọpụrụ dị ka ha na-asọpụrụ Nna ahụ. Onye ọbụla nke na-adịghị asọpụrụ Ọkpara ahụ adịghị asọpụrụ Nna nke zitere ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.23",
                "verseOrgIds": [
                  "JHN.5.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie, nʼezie agwa m unu, onye ọbụla na-anụ okwu m ma kwerekwa nʼonye zitere m nwere ndụ ebighị ebi, a gaghị amakwa ya ikpe, ọ gafeela site nʼọnwụ banye na ndụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.24",
                "verseOrgIds": [
                  "JHN.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼezie, nʼezie agwa m unu, oge na-abịa, ọ bịakwala ugbu a mgbe ndị nwụrụ anwụ ga-anụ olu Ọkpara Chineke, ndị ahụ nụrụ ya ga-adịkwa ndụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.25",
                "verseOrgIds": [
                  "JHN.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.25",
            "verseOrgIds": [
              "JHN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dị ka Nna ahụ nwere ndụ nʼime onwe ya, otu a ka o nyekwara Ọkpara ahụ ike inwe ndụ nʼime onwe ya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.26",
                "verseOrgIds": [
                  "JHN.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.26",
            "verseOrgIds": [
              "JHN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O nyekwala ya ikike ikpe ikpe nʼihi na ọ bụ Nwa nke Mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.27",
                "verseOrgIds": [
                  "JHN.5.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 5:28"
          },
          "items": [
