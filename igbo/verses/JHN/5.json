              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ka nke a hapụ iju unu anya, nʼihi na oge na-abịa, mgbe ndị niile nọ nʼili ha ga-anụ olu ya",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.28",
                "verseOrgIds": [
                  "JHN.5.28"
                ]
