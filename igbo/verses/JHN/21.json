  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "JHN 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs na ọrụ ebube nke igbute azụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, Jisọs gosiri ndị na-eso ụzọ ya onwe ya ọzọ. O mere nke a nʼakụkụ osimiri nke Tiberịas,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.1",
            "verseOrgIds": [
              "JHN.21.1"
            ]
          }
        },
        {
          "text": "lee otu o si mee.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.1",
            "verseOrgIds": [
              "JHN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụfọdụ nʼime ndị na-eso ụzọ ya nọkọrọ otu ebe. Ndị a bụ Saimọn Pita na Tọmọs (onye a na-akpọ Didimọs), na Nataniel, onye Kena nke Galili na ụmụ Zebedi, na mmadụ abụọ ndị ọzọ bụkwa ndị ozi ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.2",
            "verseOrgIds": [
              "JHN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn Pita sịrị ha, \"Ana m aga igbu azụ.\" Ha sịrị, \"Anyị ga-eso gị.\" Ha biliri gaa, banye nʼime ụgbọ mmiri. Ma nʼabalị ahụ niile ha egbuteghị ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.3",
            "verseOrgIds": [
              "JHN.21.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe chi na-abọ Jisọs guzoro nʼakụkụ mmiri. Ma ndị na-eso ụzọ ya amataghị na ọ bụ Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.4",
            "verseOrgIds": [
              "JHN.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ụmụntakịrị, unu gbutere azụ ọbụla?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.5",
                "verseOrgIds": [
                  "JHN.21.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:5"
      },
      "items": [
        {
          "text": "Ha zara ya, \"Mba.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.5",
            "verseOrgIds": [
              "JHN.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wụnyenụ ụgbụ unu nʼakụkụ aka nri nke ụgbọ. Unu ga-egbutekwa azụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.6",
                "verseOrgIds": [
                  "JHN.21.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Mgbe ha mere nke a, ha enwekwaghị ike ịdọpụta ụgbụ ha, nʼihi ọtụtụ azụ nke dị nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.6",
            "verseOrgIds": [
              "JHN.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ onye ahụ na-eso ụzọ ya Jisọs hụrụ nʼanya gwara Pita, \"Ọ bụ Onyenwe anyị!\" Ngwangwa Saimọn Pita nụrụ na \"ọ bụ Onyenwe anyị,\" ọ yiiri uwe ya (nʼihi na ọ gba ọtọ), wụba nʼime mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.7",
            "verseOrgIds": [
              "JHN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọzọ ndị na-eso ụzọ ya bịara nʼụgbọ mmiri nta ahụ, na-adọpụta ụgbụ ha nke azụ juru nʼime ya, nʼihi na ha nọ nso nʼala ihe dị ka narị nzọ ụkwụ na ise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.8",
            "verseOrgIds": [
              "JHN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha pụtara nʼelu ala, ha hụrụ ọkụ a kwanyere, nke a hụkwasịrị azụ nʼelu ya na ogbe achịcha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.9",
            "verseOrgIds": [
              "JHN.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs gwara ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.10",
            "verseOrgIds": [
              "JHN.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wetanụ ụfọdụ nʼime azụ ndị ahụ unu gbutere ugbu a.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.10",
                "verseOrgIds": [
                  "JHN.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.10",
            "verseOrgIds": [
              "JHN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn Pita pụrụ gaa dọgota ụgbụ azụ ahụ nʼelu ala. Ihe juru ya bụ azụ ndị ukwuu nke ọnụọgụgụ ya dị narị na iri ise na atọ. Ma ụgbụ ahụ adọwaghị nʼagbanyeghị na azụ juru nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.11",
            "verseOrgIds": [
              "JHN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.12",
            "verseOrgIds": [
              "JHN.21.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bịanụ rie nri ụtụtụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.12",
                "verseOrgIds": [
                  "JHN.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ dịghị onye ọbụla nʼime ndị ahụ na-eso ụzọ ya jụrụ ya, \"Ị bụ onye?\" Nʼihi na ha maara na ọ bụ Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.12",
            "verseOrgIds": [
              "JHN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs bịara were achịcha ahụ nye ha. Otu ahụ ka o mekwara azụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.13",
            "verseOrgIds": [
              "JHN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ugboro atọ Jisọs gosiri ndị na-eso ụzọ ya onwe ya mgbe e mere ka o si nʼọnwụ bilie.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.14",
            "verseOrgIds": [
              "JHN.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs akpọghachite Pita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha risiri nri ụtụtụ, Jisọs sịrị Saimọn Pita,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.15",
            "verseOrgIds": [
              "JHN.21.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saimọn nwa Jọn, ị hụrụ m nʼanya karịa ndị a niile?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.15",
                "verseOrgIds": [
                  "JHN.21.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:15"
      },
      "items": [
        {
          "text": "Ọ sịrị ya, \"E, Onyenwe anyị, ị maara na m hụrụ gị nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.15",
            "verseOrgIds": [
              "JHN.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:15"
      },
      "items": [
        {
          "text": "Jisọs sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.15",
            "verseOrgIds": [
              "JHN.21.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na-azụ ụmụ atụrụ m.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.15",
                "verseOrgIds": [
                  "JHN.21.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ya nke ugboro abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.16",
            "verseOrgIds": [
              "JHN.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saimọn nwa Jọn, ị hụrụ m nʼanya?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.16",
                "verseOrgIds": [
                  "JHN.21.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:16"
      },
      "items": [
        {
          "text": "Ọ sịrị, \"E, Onyenwe anyị, ị maara na m hụrụ gị nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.16",
            "verseOrgIds": [
              "JHN.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:16"
      },
      "items": [
        {
          "text": "Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.16",
            "verseOrgIds": [
              "JHN.21.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na-elekọta atụrụ m.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.16",
                "verseOrgIds": [
                  "JHN.21.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ya nke ugboro atọ,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.17",
            "verseOrgIds": [
              "JHN.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saimọn nwa Jọn, ị hụrụ m nʼanya?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.17",
                "verseOrgIds": [
                  "JHN.21.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:17"
      },
      "items": [
        {
          "text": "O wutere Pita na ọ sịrị ya nke ugboro atọ,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.17",
            "verseOrgIds": [
              "JHN.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"ị hụrụ m nʼanya?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.17",
                "verseOrgIds": [
                  "JHN.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ sịrị ya, \"Onyenwe anyị, ị mazuru ihe niile, ị makwaara na m hụrụ gị nʼanya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.17",
            "verseOrgIds": [
              "JHN.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 21:17"
      },
      "items": [
        {
          "text": "Jisọs sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.17",
            "verseOrgIds": [
              "JHN.21.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Na-azụ atụrụ m.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.17",
                "verseOrgIds": [
                  "JHN.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.17",
            "verseOrgIds": [
              "JHN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼezie, nʼezie asị m gị, mgbe ị bụ okorobịa ị na-eke ajị nʼukwu, gaa ebe ị chọrọ ịga. Ma mgbe ị ghọrọ agadi, ị ga-esetipụ aka gị, onye ọzọ ga-ekee gị ihe okike nʼukwu ma duru gị gaa ebe ị na-achọghị ịga.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.18",
                "verseOrgIds": [
                  "JHN.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.18",
            "verseOrgIds": [
              "JHN.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwuru nke a iji gosi ụdị ọnwụ ọ ga-anwụ iji nye Chineke otuto. Mgbe nke a mesịrị, ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.19",
            "verseOrgIds": [
              "JHN.21.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soro m.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.19",
                "verseOrgIds": [
                  "JHN.21.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita chigharịrị hụ onye ahụ na-eso ụzọ ya nke Jisọs hụrụ nʼanya ka ọ na-esokwa ha nʼazụ. (Ọ bụ onyeozi ahụ dabeere ya nʼobi na nri anyasị, nke sịrị, \"Onyenwe anyị, onye ga-arara gị nye?\")",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.20",
            "verseOrgIds": [
              "JHN.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Pita hụrụ ya, ọ sịrị Jisọs, \"Onyenwe anyị kedụ maka onye a?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.21",
            "verseOrgIds": [
              "JHN.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na m achọọ ka ọ nọgide ruo mgbe m ga-alọghachi gịnị ka nke a bụ nye gị? Soro m.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.22",
                "verseOrgIds": [
                  "JHN.21.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.22",
            "verseOrgIds": [
              "JHN.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, akụkọ a gbasara nʼetiti ụmụnna na onye a na-eso ụzọ ya agaghị anwụ. Ma Jisọs asịghị ya na ọ gaghị anwụ anwụ, kama,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.23",
            "verseOrgIds": [
              "JHN.21.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na m chọrọ ka ọ nọgide ruo mgbe m ga-abịa, ọ gbasara gị?\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.21.23",
                "verseOrgIds": [
                  "JHN.21.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ onye ahụ na-eso ụzọ ya onye na-agba ama ihe ndị a niile, ma deekwa ha nʼakwụkwọ. Anyị makwaara na ama ya bụ eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.24",
            "verseOrgIds": [
              "JHN.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ dị ọtụtụ ihe ndị ọzọ Jisọs mere. Ọ bụrụ na e dee ha niile nʼakwụkwọ, ọ dịghị m ka ụwa niile ọ ga-aba akwụkwọ a ga-ede banyere ha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.21.25",
            "verseOrgIds": [
              "JHN.21.25"
            ]
          }
        }
      ]
    }
  ],
