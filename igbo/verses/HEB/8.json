  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "HEB 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyeisi nchụaja nke ọgbụgba ndụ ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi okwu dị nʼihe niile anyị na-ekwu bụ nke a, na anyị nwere onyeisi nchụaja dị otu a, bụ onye na-anọdụ ala nʼaka nri nke ocheeze onye ahụ kachasị ihe niile elu nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.1",
            "verseOrgIds": [
              "HEB.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-eje ozi nʼebe nsọ ahụ, bụ ezi ụlọ ikwu ahụ Onyenwe anyị ji aka ya wuo, ọ bụghị mmadụ wuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.2",
            "verseOrgIds": [
              "HEB.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara onyeisi nchụaja ọbụla ka ọ na-achụ aja na-enyekwa onyinye. Nʼihi nke a, o kwesikwara ka ọ nwee ihe ọ ga-eji na-achụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.3",
            "verseOrgIds": [
              "HEB.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na ọ nọ nʼụwa, o garaghị a bụ onye nchụaja nʼihi na e nwere ndị nchụaja na-achụ aja dị ka usoro iwu si dị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.4",
            "verseOrgIds": [
              "HEB.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-eje ozi nʼebe nsọ ahụ nke bụ oyiyi na onyinyo banyere ihe nke dị nʼeluigwe. Ọ bụ nke a mere e ji dọọ Mosis aka na ntị mgbe ọ na-akwado iwu ụlọ ikwu ahụ, \"Lezie anya hụ na i mere ihe niile nʼusoro dị ka e si gosiri gị nʼelu ugwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.5",
            "verseOrgIds": [
              "HEB.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ọ natara ọrụ ije ozi karịrị nke ha, dị ka onye ogbugbo nke ọgbụgba ndụ dị elu karịa nke ochie, ebe ọgbụgba ndụ nke ọhụrụ a o mere ka ọ dịrị nʼetiti ya na mmadụ dabeere na nkwa dị mma karịa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.6",
            "verseOrgIds": [
              "HEB.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọgbụgba ndụ ochie ahụ zuruoke, ọ garaghị aba uru ka achọwa ọgbụgba ndụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.7",
            "verseOrgIds": [
              "HEB.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke chọpụtara ezughị oke ha mgbe ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "\"Lee, oge na-abịa, ka Onyenwe anyị kwupụtara,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "mgbe m ga-eme ka ọgbụgba ndụ ọhụrụ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "dịrị nʼetiti mụ na ụlọ Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:8"
      },
      "items": [
        {
          "text": "nakwa ụlọ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.8",
            "verseOrgIds": [
              "HEB.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị ụdị ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "mụ na nna nna ha gbara,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "mgbe m jidere ha nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "site nʼala Ijipt dupụta ha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "nʼihi na ha anọgideghị bụrụ ndị kwesiri ntụkwasị obi idebe ọgbụgba ndụ m.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "Nʼihi ya, echepụrụ ihu m nʼebe ha nọ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:9"
      },
      "items": [
        {
          "text": "ka Onyenwe anyị kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.9",
            "verseOrgIds": [
              "HEB.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nke a bụ ọgbụgba ndụ m ga-eme ka ọ dịrị nʼetiti mụ onwe m na ụlọ Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "mgbe oge ndị ahụ gasịrị, otu a ka Onyenwe anyị kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "Aga m etinye iwu m nʼime uche ha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "dekwasị ya nʼobi ha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "Aga m abụ Chineke ha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:10"
      },
      "items": [
        {
          "text": "ha onwe ha ga-abụkwa ndị m.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.10",
            "verseOrgIds": [
              "HEB.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye ọbụla nʼetiti ha ga-akụziri onye agbataobi ya ihe,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "maọbụ otu onye asị ibe ya, 'Mara Onyenwe anyị,'",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "nʼihi na ha niile ga-ama onye m bụ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:11"
      },
      "items": [
        {
          "text": "site nʼonye dịkarịsịrị nta ruo nʼonye dịkarịsịrị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.11",
            "verseOrgIds": [
              "HEB.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na aga m agbaghara ajọ omume ha,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 8:12"
      },
      "items": [
        {
          "text": "agaghị m echetakwa mmehie ha niile ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.12",
            "verseOrgIds": [
              "HEB.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwuru okwu banyere ọgbụgba ndụ ọhụrụ, ọ pụtara na nke ochie ahụ abụrụla ihe gabigara agabiga. Ihe dị ochie nke gabigara ga-emesịa ghara ịdịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
        }
      ]
    }
  ],
