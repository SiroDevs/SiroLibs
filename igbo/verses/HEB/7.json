  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "HEB 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Melkizedek onye nchụaja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melkizedek a bụ eze Salem, bụrụkwa onye nchụaja Chineke Onye kachasị ihe niile elu. Ọ zutere Ebraham mgbe o si na mmeri o meriri ọtụtụ ndị eze ahụ na-alọghachi, gọziekwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.1",
            "verseOrgIds": [
              "HEB.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham nyekwara ya otu ụzọ nʼime ụzọ iri nke ihe niile. Ihe mbụ aha ya pụtara bụ, \"eze ezi omume,\" ọzọkwa bụ \"eze nke Salem,\" nke pụtara, \"eze udo.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.2",
            "verseOrgIds": [
              "HEB.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị nna, o nwekwaghị nne, nke ọ na-enwe agbụrụ. O nweghị mmalite nke ụbọchị a mụrụ ya, maọbụ ọgwụgwụ ndụ, e mere ya dị ka Ọkpara Chineke. Ọ na-anọgide bụrụ onye nchụaja ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.3",
            "verseOrgIds": [
              "HEB.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leenụ otu o siri bụrụ onye dị ukwuu, ọ bụladị Ebraham bụ nna nna anyị nyere ya otu ụzọ nʼime ụzọ iri site nʼihe ọ kwatara nʼagha!",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.4",
            "verseOrgIds": [
              "HEB.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, iwu kwadoro ka ụmụ Livayị bụ ndị ghọrọ ndị nchụaja na-anakọta otu ụzọ nʼime ụzọ iri site nʼaka ndị ọzọ, ya bụ, site nʼaka ndị ụmụnna ha ndị Izrel, nʼagbanyeghị na ụmụnna ha ndị ahụ bụkwa ụmụ ụmụ Ebraham.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.5",
            "verseOrgIds": [
              "HEB.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwoke a bụ onye na-esiteghị nʼagbụrụ naara otu ụzọ nʼụzọ iri site nʼaka Ebraham ma gọziekwa ya bụ onye ahụ nke natara nkwa ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.6",
            "verseOrgIds": [
              "HEB.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ịrụrịta ụka ọbụla dị ya, na onye dị ukwuu na-agọzi onye dị nta.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.7",
            "verseOrgIds": [
              "HEB.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu aka ahụ, ndị na-anata otu ụzọ nʼụzọ iri bụ mmadụ na-anwụ anwụ, ma nʼaka nke ọzọ, onye na-anata ya bụ onye ahụ e kwupụtara na ọ na-adị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.8",
            "verseOrgIds": [
              "HEB.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ pụrụ isi na Livayị onye natara otu ụzọ nʼụzọ iri kwụrụ otu ụzọ nʼụzọ iri nke ya site nʼaka Ebraham.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.9",
            "verseOrgIds": [
              "HEB.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mgbe Melkizedek zutere ya, ọ ka nọ nʼafọ nna nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.10",
            "verseOrgIds": [
              "HEB.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs dị ka Melkizedek",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a pụrụ ime ka mmadụ zuo oke site nʼọnọdụ ndị nchụaja ndị Livayị, nʼihi na ọ bụ site nʼiwu e nyere ndị mmadụ ka e ji hiwee ọnọdụ ndị nchụaja. Olee uru ọ bara ka onye nchụaja ọzọ bịa, dị ka usoro Melkizedek si dị, na-abụghị dị ka usoro nke Erọn?",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.11",
            "verseOrgIds": [
              "HEB.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe a gbanwere ọnọdụ ndị nchụaja, nʼotu aka ahụ, a ghaghị ịgbanwekwa iwu.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.12",
            "verseOrgIds": [
              "HEB.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye ahụ e kwuru ihe ndị a banyere ya sitere nʼagbụrụ ọzọ, nke ọ dịbeghị onye ọbụla sitere na ya rụrụ ọrụ dị nʼebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.13",
            "verseOrgIds": [
              "HEB.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ihe a mara nke ọma na Onyenwe anyị si nʼagbụrụ Juda pụta, Mosis nʼonwe ya akpọtụghị agbụrụ ahụ aha mgbe ọ na-ekwu banyere ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.14",
            "verseOrgIds": [
              "HEB.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E meela ka a ghọta okwu anyị na-ekwu nke ọma, mgbe onye nchụaja ọzọ yiri Melkizedek pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.15",
            "verseOrgIds": [
              "HEB.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ghọrọ onye nchụaja ma ọ bụghị site nʼusoro iwu nke ọmụmụ ndị nchụaja, kama site nʼike dị na ndụ nke na-apụghị ịla nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.16",
            "verseOrgIds": [
              "HEB.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na-agbara akaebe banyere ya, sị,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 7:17"
      },
      "items": [
        {
          "text": "\"Gị onwe gị, bụ onye nchụaja ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 7:17"
      },
      "items": [
        {
          "text": "dị ka usoro Melkizedek si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.17",
            "verseOrgIds": [
              "HEB.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu aka ahụ, e wezugala usoro iwu ochie ahụ nʼihi adịghị ike ya na nʼihi abaghị uru ya",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.18",
            "verseOrgIds": [
              "HEB.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "(nʼihi na iwu ahụ emeghị ka ihe ọbụla zuo oke), ma nʼaka nke ọzọ, e webatala olileanya ka mma, bụ nke anyị na-esite na ya bịaruo Chineke nso.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.19",
            "verseOrgIds": [
              "HEB.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e ji ịṅụ iyi mee ka ọnọdụ onyeisi nchụaja a guzosie ike. O nweghị iyi a ṅụrụ mgbe ndị ọzọ ghọrọ ndị nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.20",
            "verseOrgIds": [
              "HEB.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HEB 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye nke a ghọrọ onye nchụaja site nʼịṅụ iyi mgbe onye ahụ gwara ya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HEB 7:21"
      },
      "items": [
        {
          "text": "\"Onyenwe anyị aṅụọla iyi,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 7:21"
      },
      "items": [
        {
          "text": "ọ gaghị agbanwe obi ya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HEB 7:21"
      },
      "items": [
        {
          "text": "'Ị bụ onye nchụaja ruo mgbe ebighị ebi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.21",
            "verseOrgIds": [
              "HEB.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HEB 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Jisọs aghọọla onye na-akwagide ọgbụgba ndụ ka mma.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.22",
            "verseOrgIds": [
              "HEB.7.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "HEB 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọzọ, ndị nchụaja nke ochie ahụ dị ọtụtụ nʼọnụọgụgụ nʼihi na ọnwụ gbochiri ha ịga nʼihu nʼọrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.23",
            "verseOrgIds": [
              "HEB.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "HEB 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ebe ọ na-adị ndụ ruo mgbe ebighị ebi, ọ na-abụkwa onyeisi nchụaja mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.24",
            "verseOrgIds": [
              "HEB.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "HEB 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere o nwere ike ịzọpụta ruo mgbe niile ndị ahụ na-abịakwute Chineke site na ya, nʼihi na ọ na-adị ndụ ruo mgbe niile ịrịọ arịrịọ nʼihi ha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.7.25",
            "verseOrgIds": [
              "HEB.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
