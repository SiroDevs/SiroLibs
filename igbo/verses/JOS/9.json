  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOS 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aghụghọ ndị Gibiọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze ndị niile bi nʼakụkụ ọdịda anyanwụ osimiri Jọdan, nụrụ banyere ihe ndị a, ya bụ, ndị niile bi nʼala ugwu ugwu nʼọdịda anyanwụ ndagwurugwu, na ndị bi ogologo akụkụ osimiri Mediterenịa ruo Lebanọn, eze ndị Het na nke ndị Amọrait na nke ndị Kenan na nke ndị Periz na nke ndị Hiv na nke ndị Jebus,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha niile zukọtara ibu agha megide Joshua na ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Gibiọn",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
              "JOS.9.3"
            ]
          }
        },
        {
          "text": "nụrụ ihe Joshua mere Jeriko na Ai,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.3",
            "verseOrgIds": [
              "JOS.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha sitere nʼaghụghọ chọọ ụzọ ha ga-esi zọpụta onwe ha. Ha zipụrụ ndị ozi, ndị bokwasịrị ịnyịnya ibu ha akpa mere ochie, na karama akpụkpọ mere ochie, nke a duchiri ebe dị iche iche nʼahụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.4",
            "verseOrgIds": [
              "JOS.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ yikwasịrị nʼụkwụ ha akpụkpọụkwụ kara nka nke a kwachiri akwachi, na uwe mere nnọọ ochie. Achịcha niile ha ji bụ nri ha, kpọrọ nkụ maakwa ebu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.5",
            "verseOrgIds": [
              "JOS.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịaruru nʼebe ndị Izrel mara ụlọ ikwu ha na Gilgal, ha jekwuuru Joshua, gwa ya na ndị Izrel okwu sị ha, \"Anyị si nʼala dị anya bịa. Ugbu a, biko anyị chọrọ ka anyị na unu gbaa ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.6",
            "verseOrgIds": [
              "JOS.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom Izrel zaghachiri sị ndị Hiv",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "text": "ahụ, \"Olee otu anyị si amata na unu ebighị anyị nso? Ma eleghị anya unu bi anyị nso, anyị na unu ọ ga-esi aṅaa gbaa ndụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara Joshua sị ya, \"Anyị bụ ndị ohu unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:8"
      },
      "items": [
        {
          "text": "Ma Joshua jụrụ ha ajụjụ sị, \"Olee ndị unu bụ? Ebee ka unu si bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara ya sị, \"Ala anyị, ebe ndị ohu gị si bịa dị anya nke ukwuu. Anyị bịara nʼihi na anyị anụla akụkọ banyere",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.9",
                "verseOrgIds": [
                  "JOS.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, na ihe niile o mere nʼIjipt.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị anụkwala ihe niile o mere eze abụọ ndị Amọrait, ndị nọ nʼọwụwa anyanwụ Jọdan, Saịhọn eze Heshbọn, na Ọg eze Bashan, onye chịrị nʼAshtarọt.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị okenye anyị na ndị niile bi nʼala anyị sịrị anyị, 'Werenụ ihe unu ji aga njem, jekwurunụ ndị Izrel sị ha, \"Anyị bụ ndị ohu unu, kwerenụ ka anyị na unu gbaa ndụ.\" '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.11",
            "verseOrgIds": [
              "JOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee achịcha ndị a bụ nke anyị ji mgbe anyị hapụrụ ala anyị. Ha dị ọkụ mgbe anyị hapụrụ ụlọ anyị ịbịa njem a, nʼihi na e si nʼebe a na-eghe ya wepụta ya, ma ugbu a, dịka unu hụrụ, ha akpọọla nkụ, bidokwa ịma ebu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.12",
            "verseOrgIds": [
              "JOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gbajuru karama akpụkpọ anyị ndị a mmanya ọhụrụ mgbe anyị hapụrụ, ma ugbu a, karama ndị a adọwaala. Uwe anyị, na akpụkpọụkwụ anyị, emeela ochie nʼihi ịga ije dị anya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom Izrel ritụrụ ụfọdụ nʼime ihe oriri ha ji bịa, ma ha ajụtaghị ihe bụ uche",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.14",
                "verseOrgIds": [
                  "JOS.9.14"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua na ndị ahụ gbara ndụ udo ikwe ka ha dị ndụ. Ndịisi nzukọ Izrel mesiri ọgbụgba ndụ ahụ ike site nʼịṅụ iyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị atọ gasịrị site na mgbe ụmụ Izrel na ndị Gibiọn gbara ndụ, ndị Izrel nụrụ na ndị Gibiọn bụ ndị agbataobi ha, ndị bi ha nso.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị Izrel buliri ije gaa ịchọpụta ebe ndị a si bịa, si otu a bịaruo obodo ha niile nʼụbọchị nke atọ. Aha obodo ha bụ Gibiọn, Kefira, Beerọt na Kiriat Jearim.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Izrel ebusoghị ha agha nʼihi na ndịisi nzukọ Izrel ejirila aha",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.18",
                "verseOrgIds": [
                  "JOS.9.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel ṅụọ iyi idebe ha ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JOS 9:18"
      },
      "items": [
        {
          "text": "Ma nzukọ Izrel niile tamuru ntamu megide ndịisi ha nʼihi ọgbụgba ndụ a.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndịisi Izrel kwuru sị, \"Anyị aṅụọla iyi nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.19",
                "verseOrgIds": [
                  "JOS.9.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel sị, na anyị agaghị emetụ ha aka, ugbu a kwa anyị agaghị eme ha ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nke a ka anyị ga-eme. Anyị ga-ekwe ka ha dị ndụ, nʼihi na ọ bụrụ na anyị emezughị iyi anyị ṅụrụ, iwe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.20",
                "verseOrgIds": [
                  "JOS.9.20"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-adakwasị anyị niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndịisi kwukwara sị, \"Anyị ga-ahapụ ha ka ha dịrị ndụ, kama ha ga-aghọ ohu ndị Izrel, ndị ga na-awara anyị nkụ na ndị ga na-ekutere anyị mmiri.\" Nʼụzọ dị otu a, e mere ka ha dịrị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Joshua ziri ozi kpọọ ndịisi obodo Gibiọn jụọ ha ajụjụ sị, \"Gịnị mere unu ji ghọgbuo anyị site nʼịgwa anyị, 'Anyị bi nʼebe dịpụrụ anya, site nʼebe unu bi,' ebe ọ bụ na unu bi anyị nso?",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, unu ga-abụ ndị a bụrụ ọnụ. Site nʼụbọchị taa gaa nʼihu, unu aghọọla ndị ohu anyị, ndị ga na-awara anyị nkụ mgbe niile, na ndị ga na-ekutere anyị mmiri nke anyị ga-eji rụọ ọrụ nʼụlọnsọ Chineke m.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara Joshua sị, \"Anyị mere nke a nʼihi na agwala anyị na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.24",
                "verseOrgIds": [
                  "JOS.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nyere Mosis iwu sị ya merie ala ndị a niile, ma kpochapụ ndị niile bi nʼime ya. Ọ bụ nke a mere ụjọ ji tụọ anyị. Ọ bụkwa ya mere anyị ji mee ihe dị otu a, nʼihi ichebe ndụ anyị.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, anyị dị unu nʼaka. Unu nwere ike ime anyị ihe dị unu mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Joshua ekweghị ka ndị Izrel gbuo ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua mere ha ndị ọwa nkụ na ndị ose mmiri nye ụmụ Izrel, na ịhụkwa banyere ihe ndị dị mkpa nʼebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.27",
                "verseOrgIds": [
                  "JOS.9.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼebe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.9.27",
                "verseOrgIds": [
                  "JOS.9.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ahọpụta. Ọ bụkwa nke a ka ha bụ ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
