    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obodo mgbaba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.20.1",
                "verseOrgIds": [
                  "JOS.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Joshua okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.1",
            "verseOrgIds": [
              "JOS.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha họpụtara onwe unu obodo mgbaba dịka m gwara unu site nʼaka Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
              "JOS.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka obodo ndị a bụrụ ebe onye gburu mmadụ nʼọghọm na-amaghị ama ga-agbaga nʼihi izere ndụ ya site nʼaka onye ahụ ga-achọ ịbọrọ ọbọ ọchụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye gburu mmadụ ahụ na-amaghị ama gbabara nʼime otu obodo ndị a, ọ ga-eguzo nʼọnụ ụzọ ama obodo ahụ gwa ndị okenye obodo ahụ ihe niile mere. Ndị okenye ahụ ga-akpọbata ya nʼime obodo ahụ, nye ya ebe ọ ga-ebi nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na onye ikwu onye ahụ nwụrụ anwụ abịa ịbọrọ ọbọ ọchụ ahụ, ndị okenye obodo ahụ agaghị ekwe ka e gbuo onye ahụ gburu mmadụ na-amaghị ama, nʼihi na onye ahụ akpachaghị anya mee ihe o mere.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ gburu mmadụ na-amaghị ama ga-anọgide nʼobodo ahụ ruo mgbe ọ ga-akwụrụ nʼihu nzukọ maka ikpe ruokwa mgbe onyeisi nchụaja nọ nʼoge ahụ nwụrụ. Mgbe ahụ, o nwere ike laghachi nʼụlọ nke aka ya na nʼobodo ya bụ ebe o si gbapụ ọsọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.6",
            "verseOrgIds": [
              "JOS.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị ha kewapụtara iche dịka obodo mgbaba bụ, Kedesh,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "text": "nke dị nʼime Galili, nʼala ugwu ugwu ndị Naftalị; na Shekem,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "text": "nke dị nʼala ugwu ugwu Ifrem na Kiriat Aba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "text": "nke a na-akpọkwa Hebrọn. Ọ dị nʼala ugwu ugwu Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.7",
            "verseOrgIds": [
              "JOS.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kewapụtara obodo atọ ọzọ nʼihi otu ihe ahụ, nʼakụkụ ọwụwa anyanwụ osimiri Jọdan nʼofe Jeriko. Obodo atọ ndị a bụ, Beza, nke dị nʼọzara, nʼala larịị ahụ e nyere ebo Ruben, na Ramọt; nke dị nʼime Gilead bụ ala ebo Gad; na Golan, nʼime Bashan, nke e si nʼala ebo Manase wepụta.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo mgbaba ndị a a họpụtara bụ maka ndị ọbịa bi nʼetiti ụmụ Izrel, na maka ụmụ Izrel. Ọ bụ ebe onye ọbụla gburu mmadụ na-amaghị ama ga-agbaga. Onye na-abọrọ ọbọ ọchụ agaghị egbukwa onye ahụ tupu e kpee ya ikpe nʼọgbakọ ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.9",
            "verseOrgIds": [
              "JOS.20.9"
            ]
          }
        }
      ]
    }
  ],
