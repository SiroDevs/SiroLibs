  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "JOS 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyere Joshua",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mosis, bụ odibo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.1",
            "verseOrgIds": [
              "JOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.1",
                "verseOrgIds": [
                  "JOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nwụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.1",
            "verseOrgIds": [
              "JOS.1.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.1",
                "verseOrgIds": [
                  "JOS.1.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Joshua nwa Nun, onye na-enyere Mosis aka okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.1",
            "verseOrgIds": [
              "JOS.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mosis, odibo m anwụọla.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.2",
            "verseOrgIds": [
              "JOS.1.2"
            ]
          }
        },
        {
          "text": "Ugbu a, jikere onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.2",
            "verseOrgIds": [
              "JOS.1.2"
            ]
          }
        },
        {
          "text": "meekwa ka ndị m jikere ịgafe ofe ọzọ nke osimiri Jọdan, ịbanye nʼala ahụ m na-aga inye ha, bụ ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.2",
            "verseOrgIds": [
              "JOS.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m agwa gị ihe m gwara Mosis mgbe ọ dị ndụ sị, Ebe ọbụla unu ga-azọkwasị ụkwụ unu nʼala, ala ahụ ga-abụ nke unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.3",
            "verseOrgIds": [
              "JOS.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala unu ga-abụ site nʼọzara dị na ndịda ruo Lebanọn, ma site nʼiyi ukwu Yufretis, tinyere ala niile nke ndị Het, ruo nʼosimiri ukwu ahụ dị nʼọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.4",
            "verseOrgIds": [
              "JOS.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye ọbụla pụrụ iguzo imegide gị ụbọchị niile nke ndụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.5",
            "verseOrgIds": [
              "JOS.1.5"
            ]
          }
        },
        {
          "text": "Aga m anọnyere gị dịka m si nọnyere Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.5",
            "verseOrgIds": [
              "JOS.1.5"
            ]
          }
        },
        {
          "text": "Agaghị m ahapụ gị aka. Agaghị m agbakụtakwa gị azụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.5",
            "verseOrgIds": [
              "JOS.1.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.5",
            "verseOrgIds": [
              "JOS.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịrị ike, nweekwa ume, nʼihi na ị ga-abụ onye ga-edu ndị a iketa ala ahụ m ṅụrụ nʼiyi inye nna nna ha ochie.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.6",
            "verseOrgIds": [
              "JOS.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naanị dịrị ike, nweekwa ume. Lezie anya ime ihe niile Mosis bụ odibo m nyere gị nʼiwu. Ewezugala onwe gị na ya gaa aka nri maọbụ aka ekpe, ka ihe si otu a gaara gị nke ọma nʼebe ọbụla ị na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.7",
            "verseOrgIds": [
              "JOS.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esitela nʼọnụ gị wezuga ihe dị nʼAkwụkwọ Iwu a. Kama na-atụgharị uche gị na ya ehihie na abalị, ka i si otu a lezie anya imezu ihe niile e dere nʼime ya. Mgbe ahụ ị ga-aba ụba, ihe ga-agakwara gị nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.8",
            "verseOrgIds": [
              "JOS.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ na m enyebeghị gị iwu sị gị, Nwee obi ike, dịrịkwa ike! Wezuga ụjọ niile na ịda mba nke obi. Cheta na mụ, bụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.9",
                "verseOrgIds": [
                  "JOS.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, nọnyeere gị ebe ọbụla ị na-aga.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.9",
            "verseOrgIds": [
              "JOS.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua nyere ndịisi Izrel niile iwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.10",
            "verseOrgIds": [
              "JOS.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Jegharịanụ nʼetiti ebe obibi ụmụ Izrel gwa mmadụ niile okwu sị ha 'Dozierenụ onwe unu ihe unu ga-eri nʼụzọ, nʼihi na nʼime ụbọchị atọ, anyị ga-agafe osimiri Jọdan, imeri na inweta ala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.11",
                "verseOrgIds": [
                  "JOS.1.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke na-enye unu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.11",
            "verseOrgIds": [
              "JOS.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua kpọkọtara ndịisi ebo Ruben, na Gad, na ọkara ebo Manase, gwa ha okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.12",
            "verseOrgIds": [
              "JOS.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chetanụ iwu ahụ Mosis odibo",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.13",
                "verseOrgIds": [
                  "JOS.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere unu, mgbe ọ sịrị, '",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.13",
                "verseOrgIds": [
                  "JOS.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu na-enye unu izuike. O nyekwala unu ala a.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.13",
            "verseOrgIds": [
              "JOS.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ndị nwunye unu, na ụmụntakịrị unu, na anụ ụlọ unu, ga-anọ nʼala a dị nʼọwụwa anyanwụ nke Mosis nyere unu. Ma ndị agha unu, ndị jikeere ejike, ga-eduru ndị Izrel ndị ọzọ gafee osimiri Jọdan inyere ụmụnna ha aka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.14",
            "verseOrgIds": [
              "JOS.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tutu ruo mgbe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.15",
                "verseOrgIds": [
                  "JOS.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nyere ha izuike, dịka o si nye unu, na tutu ruo mgbe ha nwetara ala niile bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.15",
                "verseOrgIds": [
                  "JOS.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu ga-enye ha. Mgbe nke a mezuru, unu ga-alaghachi azụ, nweta ala ahụ Mosis onyeozi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.15",
                "verseOrgIds": [
                  "JOS.1.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere unu nʼakụkụ ọwụwa anyanwụ osimiri Jọdan.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.15",
            "verseOrgIds": [
              "JOS.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha zara Joshua, \"Ihe ọbụla nke ị nyere anyị nʼiwu anyị ga-eme ha, ebe ọbụla i zigara anyị ka anyị ga-aga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.16",
            "verseOrgIds": [
              "JOS.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ga-ege gị ntị dịka anyị si gee Mosis ntị. Ka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.17",
            "verseOrgIds": [
              "JOS.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.1.17",
                "verseOrgIds": [
                  "JOS.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nọnyere gị dịka o si nọnyere Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.17",
            "verseOrgIds": [
              "JOS.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nupuru isi nʼiwu i nyere anyị, ọ ga-anwụ. Naanị dịrị ike, nweekwa obi ike.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.1.18",
            "verseOrgIds": [
              "JOS.1.18"
            ]
          }
        }
      ]
    }
  ],
