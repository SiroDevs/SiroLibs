{
  "id": "JOS.4",
  "number": "4",
  "bookId": "JOS",
  "reference": "Joshua 4",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JOS 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mba ahụ niile gafesịrị osimiri Jọdan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.1",
                "verseOrgIds": [
                  "JOS.4.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Joshua okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.1",
            "verseOrgIds": [
              "JOS.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Site nʼetiti ndị ụmụ Izrel họpụta ndị ikom iri na abụọ, otu onye site nʼebo ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.2",
            "verseOrgIds": [
              "JOS.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka onye ọbụla nʼime ha site nʼebe ahụ ndị nchụaja guzoro nʼetiti osimiri Jọdan buputa otu nkume, otu nkume, gwa ha ka ha debe nkume ndị a ha buputara nʼebe unu ga-anọ ọnọdụ abalị taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.3",
            "verseOrgIds": [
              "JOS.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua kpọrọ ndị ikom iri na abụọ ndị ahụ, ndị ọ họpụtara, site nʼetiti ndị Izrel, otu onye site nʼebo ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha sị, \"Sitenụ nʼetiti osimiri Jọdan, ebe ndị bu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.5",
                "verseOrgIds": [
                  "JOS.4.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu guzoro, buputa nkume. Onye ọbụla nʼime unu ga-ebuputa otu nkume, tụkwasị nʼubu ya, dịka ọnụọgụgụ ebo Izrel niile si dị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ha bụrụ ihe ịrịbama nʼetiti unu. Nʼoge dị nʼihu, mgbe ụmụ unu ga-ajụ unu ajụjụ sị, 'Gịnị bụ isi ogidi nkume a dị nʼebe a?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-asịkwa ha, 'Ọ bụ ihe na-echetara anyị otu osimiri Jọdan si kwụsị ịsọ, mgbe ndị bụ igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.7",
                "verseOrgIds": [
                  "JOS.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "zọnyere ụkwụ ha nʼosimiri ahụ.' Nkume a ga-abụkwara ụmụ Izrel niile ihe ncheta ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel mere dịka Joshua gwara ha. Ha buputara nkume iri na abụọ site nʼetiti osimiri Jọdan, dịka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.8",
                "verseOrgIds": [
                  "JOS.4.8"
                ]
              }
            }
          ]
        },
        {
          "text": "si nye Joshua nʼiwu sị na otu onye, nʼebo Izrel ọbụla, ga-ebuputa otu nkume. Ha buuru nkume iri na abụọ ndị ahụ gaa nʼebe ha nọrọ ọnọdụ abalị, debe ha nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.8",
            "verseOrgIds": [
              "JOS.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua nʼonwe ya kwa ji nkume iri na abụọ ahụ nke si nʼetiti osimiri Jọdan wuo ogidi ịrịbama, nʼebe ahụ ndị nchụaja bu igbe ọgbụgba ndụ ahụ guzoro. Ha dịkwa nʼebe ahụ ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.9",
            "verseOrgIds": [
              "JOS.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja, ndị bụ igbe ọgbụgba ndụ ahụ, guzoro nʼetiti osimiri Jọdan, tutu ruo mgbe e mezuru iwu ahụ niile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.10",
                "verseOrgIds": [
                  "JOS.4.10"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Joshua site nʼọnụ Mosis. Mgbe ahụ kwa, ndị Izrel mere ngwangwa gafee osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.10",
            "verseOrgIds": [
              "JOS.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ha niile gafetasịrị, igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.11",
                "verseOrgIds": [
                  "JOS.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na ndị nchụaja gafetakwara nʼakụkụ nke ọzọ, ka ndị mmadụ na-ele ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.11",
            "verseOrgIds": [
              "JOS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha ụmụ Ruben, na ụmụ Gad, na ọkara ebo Manase, buuru ụmụ Izrel niile ụzọ gafee, idu ha nʼagha, dịka Mosis nyere ha nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.12",
            "verseOrgIds": [
              "JOS.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha ọnụọgụgụ ha ruru iri puku anọ (40,000), ndị jikeere nke ọma ibu agha, duuru ebo ndị ọzọ, gafere nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.13",
                "verseOrgIds": [
                  "JOS.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bata nʼobosara ala Jeriko maka ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị ahụ bụ ụbọchị",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.14",
                "verseOrgIds": [
                  "JOS.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "buliri Joshua elu nke ukwuu nʼihi na o mere Joshua ka ọ dị ukwuu nʼanya ndị Izrel niile, si otu a mee ka ha tụọ ya egwu nke ukwuu dịka ha si tụọ Mosis egwu, ma sọpụkwara ya ụbọchị niile nke ndụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.14",
            "verseOrgIds": [
              "JOS.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.15",
                "verseOrgIds": [
                  "JOS.4.15"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Joshua okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.15",
            "verseOrgIds": [
              "JOS.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nye ndị nchụaja, ndị bu igbe ọgbụgba ndụ ahụ iwu ka ha si nʼosimiri Jọdan pụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.16",
            "verseOrgIds": [
              "JOS.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Joshua nyere ndị nchụaja iwu sị ha, \"Sitenụ nʼosimiri Jọdan pụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.17",
            "verseOrgIds": [
              "JOS.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị nchụaja bu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.18",
                "verseOrgIds": [
                  "JOS.4.18"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ si nʼosimiri Jọdan rịpụta, dịka ọbụ ụkwụ ha na-emetụ nʼala akọrọ, mmiri osimiri ahụ sọghachiri nʼọnọdụ ya ruchie akụkụ ya niile, ka ọ dị na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.18",
            "verseOrgIds": [
              "JOS.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ịrịbama a mere nʼụbọchị nke iri, nʼọnwa nke mbụ. Nʼụbọchị ahụ ka ndị Izrel niile gafere osimiri Jọdan, gaa maa ụlọ ikwu ha na Gilgal, ebe dị nʼọwụwa anyanwụ obodo Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.19",
            "verseOrgIds": [
              "JOS.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkume iri na abụọ ahụ ha si nʼosimiri Jọdan buputa, ka Joshua guzobere na Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.20",
            "verseOrgIds": [
              "JOS.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ndị Izrel, \"Nʼoge dị nʼihu, mgbe ụmụ unu ga-ajụ ndị bụ nna ha ajụjụ sị, 'Gịnị ka nkume ndị a pụtara, Gịnịkwa ka ha na-egosi?'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.21",
            "verseOrgIds": [
              "JOS.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha, 'Izrel gafere osimiri Jọdan nʼala akọrọ.'",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.22",
            "verseOrgIds": [
              "JOS.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.23",
                "verseOrgIds": [
                  "JOS.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu mere ka osimiri Jọdan takpọọ nʼihu unu tutu ruo mgbe unu gafesịrị nʼofe nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.23",
                "verseOrgIds": [
                  "JOS.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu mere osimiri Jọdan ihe o mere osimiri Uhie",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "text": "mgbe o mere ka osimiri Uhie takpọọ nʼihu anyị, tutu ruo mgbe anyị gafesịrị nʼofe ya nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.23",
            "verseOrgIds": [
              "JOS.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ndị a niile ka ndị niile bi nʼelu ụwa mata na aka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.24",
                "verseOrgIds": [
                  "JOS.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        },
        {
          "text": "O mekwara ya ka unu onwe unu tụọ egwu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.4.24",
                "verseOrgIds": [
                  "JOS.4.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, mgbe niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.24",
            "verseOrgIds": [
              "JOS.4.24"
            ]
          }
        }
      ]
