  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "JOS 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu ikpeazụ Joshua kwuru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ọtụtụ oge gasịrị, site nʼoge",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.1",
                "verseOrgIds": [
                  "JOS.23.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka Izrel nwee ezumike nʼebe ndị iro gbara ha okirikiri nọ, Joshua aghọọla agadi, gbaa ọtụtụ afọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.1",
            "verseOrgIds": [
              "JOS.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua kpọrọ ndị Izrel niile, ndị okenye ha, ndị ndu ha, ndị odozi okwu ha na ndịisi ha, sị ha, \"Emeela m agadi gbaakwa ọtụtụ afọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.2",
            "verseOrgIds": [
              "JOS.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu onwe unu ejirila anya unu hụ ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.3",
                "verseOrgIds": [
                  "JOS.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu mere mba ndị a niile, nʼihi unu. Ọ lụụrụ unu ọgụ, nyere unu aka imeri ndị iro unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.3",
            "verseOrgIds": [
              "JOS.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu hụrụ na ekekwarala m unu ala mba ahụ niile nke fọdụrụnụ ka ha bụrụ ihe nketa ebo unu, site na Jọdan, tinyekwara mba niile ndị ahụ m kpochapụrụ nʼakụkụ osimiri Mediterenịa dị na mpaghara ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.4",
            "verseOrgIds": [
              "JOS.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.5",
                "verseOrgIds": [
                  "JOS.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu ga-akwapụ ndị bi nʼime ha nʼihi unu. Ọ ga-achụpụ ha nʼihu unu, mee ka unu nweta ala ha, dịka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.5",
                "verseOrgIds": [
                  "JOS.23.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu kwere unu nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.5",
            "verseOrgIds": [
              "JOS.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, dịnụ ike, lezienụ anya idebezu na irube isi nʼihe niile e dere nʼAkwụkwọ Iwu Mosis. Unu esila nʼime ya wezuga onwe unu nʼụzọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.6",
            "verseOrgIds": [
              "JOS.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ anya ka unu na mba ndị a fọdụrụ nʼala a ghara inwe mmekọ ọbụla. Unu akpọtụkwala chi ha niile aha. Unu aṅụkwala iyi nʼaha ha, maọbụ fee ha ofufe, maọbụ kpọọ isiala nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.7",
            "verseOrgIds": [
              "JOS.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama raparanụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "text": "nʼahụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.8",
                "verseOrgIds": [
                  "JOS.23.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu dịka unu mere ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.8",
            "verseOrgIds": [
              "JOS.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.9",
                "verseOrgIds": [
                  "JOS.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "achụpụla mba dị ukwuu na mba siri ike site nʼebe unu nọ. O nwekwaghị otu mba nʼime ha o kwere ka ha merie unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.9",
            "verseOrgIds": [
              "JOS.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nwoke nʼime unu achụọla puku ndị ikom ndị iro unu ọsọ. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.10",
                "verseOrgIds": [
                  "JOS.23.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu alụọlara unu ọgụ, dịka ya onwe ya kwere nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.10",
            "verseOrgIds": [
              "JOS.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, lezienụ onwe unu anya nke ọma ka unu hụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.11",
                "verseOrgIds": [
                  "JOS.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.11",
            "verseOrgIds": [
              "JOS.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na unu alaghachi azụ, ma kwere ka e jikọọ unu na mba ndị a fọdụrụ nʼetiti unu. Ọ bụrụ na unu na ha ebido ịlụrịta di na nwunye, na-emekọrịta ihe ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.12",
            "verseOrgIds": [
              "JOS.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "maranụ nke ọma, na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.13",
                "verseOrgIds": [
                  "JOS.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu agaghị achụpụrụ unu mba ndị a site nʼala unu. Kama ha ga-abụrụ unu igbudu na ọnya. Ha ga-abụkwara unu apịpịa nʼakụkụ unu, na ogwu nʼanya unu, ruo mgbe unu ga-ala nʼiyi nʼezi ala a, nke",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.13",
                "verseOrgIds": [
                  "JOS.23.13"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nyere unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.13",
            "verseOrgIds": [
              "JOS.23.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe na-adịghị anya, mụ onwe m ga-agbaso ụzọ ahụ ndị niile bi nʼụwa na-aghaghị ịgbaso. Unu niile maara nʼime obi unu na nʼime mkpụrụobi unu na o nweghị otu nʼime nkwa ọma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.14",
                "verseOrgIds": [
                  "JOS.23.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu kwere nye unu nke na-emezughị. E mezuola nkwa ndị a niile; o nweghị nke ọbụla a na-emezughị.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.14",
            "verseOrgIds": [
              "JOS.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka ezi nkwa niile",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.15",
                "verseOrgIds": [
                  "JOS.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu kwere si bụrụ ihe e mezuru emezu, otu a kwa ka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.15",
                "verseOrgIds": [
                  "JOS.23.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-esi mee ka ihe ọjọọ niile ọ bara mba ya mezuo nʼisi unu, tutu ruo mgbe o mere ka unu laa nʼiyi nʼezi ala ahụ ọ na-enye unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.15",
            "verseOrgIds": [
              "JOS.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu emebie ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.16",
                "verseOrgIds": [
                  "JOS.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, nke o nyere unu iwu idebe, tụgharịa malite ịgbaso na ife chi ndị ọzọ na ịkpọ isiala nye ha, iwe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.23.16",
                "verseOrgIds": [
                  "JOS.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-adị ọkụ megide unu, unu ga-alakwa nʼiyi ngwangwa nʼala ọma ahụ o nyere unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.23.16",
            "verseOrgIds": [
              "JOS.23.16"
            ]
          }
        }
