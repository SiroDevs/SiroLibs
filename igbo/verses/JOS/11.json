  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JOS 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeri nke ndị eze si nʼugwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jabin eze Hazọ nụrụ nke a, o ziri ozi zigara Jobab eze ndị Madọn, zigakwara ndị eze obodo Shịmrọn na Akshaf,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.1",
            "verseOrgIds": [
              "JOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ndị eze bi nʼobodo ugwu ugwu, na ndị bi nʼime Araba, na ndịda Kineret, na ndagwurugwu ọdịda anyanwụ, na nʼime Nafọt Doa, nke dị nʼọdịda anyanwụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.2",
            "verseOrgIds": [
              "JOS.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "zigakwara eze ndị Kenan ndị bi nʼọwụwa anyanwụ, na ọdịda anyanwụ, zigakwara eze ndị Amọrait, na eze ndị Het, na eze ndị Periz, na nke ndị Jebus nke dị nʼala ugwu. O zigakwara eze ndị Hiv ndị bi na ndịda Hemon, na mpaghara Mizpa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.3",
            "verseOrgIds": [
              "JOS.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze a niile kwekọrịtara chịkọtaa ndị agha ha niile nʼotu. Ndị agha ha chịkọtara dị ukwuu dịka aja dị nʼakụkụ osimiri. Ha ji ọtụtụ ịnyịnya na ọtụtụ ụgbọ agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.4",
            "verseOrgIds": [
              "JOS.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze ndị a niile zukọrọ maa ụlọ ikwu ha nʼakụkụ mmiri Merọm, maka ibuso Izrel agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.5",
            "verseOrgIds": [
              "JOS.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.6",
                "verseOrgIds": [
                  "JOS.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Joshua, \"Atụla ha egwu, nʼihi na echi, nʼoge dịka ugbu a, aga m ewere ha niile nʼọnọdụ ndị egburu egbu nyefee ha nʼaka Izrel. Ị ga-ebipụ nkwonkwo ụkwụ ịnyịnya ha niile, kpọọkwa ụgbọ agha ha niile ọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.6",
            "verseOrgIds": [
              "JOS.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua na ndị agha ya niile bịaruru akụkụ mmiri Merọm na mberede, lụso ha agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.7",
            "verseOrgIds": [
              "JOS.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.8",
                "verseOrgIds": [
                  "JOS.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nyefere ndị agha ha nʼaka ndị Izrel, ndị lụgburu ha, chụọ ha ọsọ ruo nʼoke ala Saịdọn, ruokwa ebe a na-akpọ Mizrefot Maim, na ruo nʼakụkụ ọwụwa anyanwụ, nʼime Ndagwurugwu Mizpa. Ya mere, o nweghị ọ bụladị otu onye iro a hapụrụ ndụ nʼagha ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.8",
            "verseOrgIds": [
              "JOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua na ndị agha ya mere ha ihe",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.9",
                "verseOrgIds": [
                  "JOS.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru na a ga-eme ha. Ha gbupụrụ nkwonkwo ụkwụ ịnyịnya ha niile, surekwaa ụgbọ agha ha niile nʼọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.9",
            "verseOrgIds": [
              "JOS.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joshua laghachiri azụ busoo Hazọ agha merie ya, were mma agha gbuo eze ya, nʼihi na Hazọ bụrịị isi obodo alaeze ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.10",
            "verseOrgIds": [
              "JOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji mma agha gbuo ndị niile bi nʼobodo ahụ, bibie ha kpamkpam, ọ dịghị onye a hapụrụ nke na-eku ume. O sukwara Hazọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.11",
            "verseOrgIds": [
              "JOS.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joshua weere obodo niile nke ndị eze ahụ na ndị eze ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "text": "jiri mma agha gbuchapụ ha. Ọ lakwara ha niile nʼiyi, dịka Mosis onyeozi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.12",
                "verseOrgIds": [
                  "JOS.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.12",
            "verseOrgIds": [
              "JOS.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Izrel esughị obodo ọbụla nʼime ndị ahụ niile e wuru na mkputamkpu ala ọkụ, karịakwa obodo Hazọ, nke Joshua kpọrọ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.13",
            "verseOrgIds": [
              "JOS.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile a kwatara nʼagha nʼobodo ndị a, na anụ ụlọ ha niile, ka ndị Izrel weere. Ma ha gburu mmadụ niile. Ha ahapụghị ọ bụladị otu onye ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.14",
            "verseOrgIds": [
              "JOS.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke a bụ iwu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.15",
                "verseOrgIds": [
                  "JOS.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis onyeozi ya. Mosis nyekwara Joshua otu iwu a. Ugbu a Joshua emeela dịka a gwara ya. O mezuru ihe ndị a niile, bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.15",
                "verseOrgIds": [
                  "JOS.11.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.15",
            "verseOrgIds": [
              "JOS.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joshua meriri ala ahụ niile, bụ ala ugwu ugwu ahụ, na ala Negeb, na ala Goshen, na obosara ala ọdịda anyanwụ ahụ niile, na ala Araba, na ala ugwu ahụ niile, na ala ahụ dị na mgbada ugwu Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.16",
            "verseOrgIds": [
              "JOS.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ala ndị Izrel nwere gbasara nʼụzọ niile site nʼugwu Halak, nke dị nso na Sia, ruo Baal-Gad nke dị na Ndagwurugwu Lebanọn, na ndịda ugwu Hemon. Joshua jidere ma gbukwaa ndị eze ndị ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.17",
            "verseOrgIds": [
              "JOS.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O were Joshua ogologo oge imeri obodo ndị a niile na eze ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.18",
            "verseOrgIds": [
              "JOS.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịkwaghị obodo ọzọ e mere ka ha na ụmụ Izrel dị nʼudo karịa naanị ndị Hiv, ndị bi na Gibiọn. Obodo ndị ọzọ niile ka a lara nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.19",
            "verseOrgIds": [
              "JOS.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.20",
                "verseOrgIds": [
                  "JOS.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼonwe ya, mere ka ndị eze ahụ nyịchie obi ha, ka ha lụso Izrel agha, ka o si otu a laa ha nʼiyi, kpochapụkwa ha niile, na-emereghị ha amara, dịka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.11.20",
                "verseOrgIds": [
                  "JOS.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.20",
            "verseOrgIds": [
              "JOS.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ kwa, Joshua gara kpochapụ ndị Anak ahụ bi nʼala ugwu ugwu, ya bụ, na Hebrọn, na Debịa, na Anab, na ala ugwu ugwu Juda, na ala ugwu ugwu Izrel. O gburu ha niile, laa obodo ha nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.11.21",
            "verseOrgIds": [
              "JOS.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
