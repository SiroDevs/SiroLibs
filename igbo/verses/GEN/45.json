  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "45",
        "style": "c",
        "sid": "GEN 45"
      },
      "items": [
        {
          "text": "45",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụnne Josef amara onye ọ bụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Josef enwekwaghị ike ijite onwe ya aka nʼihu ndị na-ejere ya ozi. O welitara olu sị, \"Zipụnụ onye ọbụla site nʼebe m nọ.\" Ya mere, o nweghị onye ya na Josef nọ mgbe ọ kọọrọ ụmụnne ya onye ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tiri mkpu akwa nke ndị Ijipt nụrụ, na nke ndị ụlọ Fero nụkwara.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.2",
            "verseOrgIds": [
              "GEN.45.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef gwara ụmụnne ya sị, \"Mụ onwe m bụ Josef. Nna m ọ ka nọ ndụ ugbu a?\" Ma ụmụnne ya enweghị ọnụ ha ji asa ya, nʼihi na oke egwu jidere ha nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Josef sịrị ụmụnne ya, \"Biko, bịanụ m nso.\" Mgbe ha bịara ya nso, ọ sịrị ha, \"Abụ m nwanne unu, Josef, onye unu rere ree gaa Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ka ọ ghara iwute unu, unu atakwala onwe unu ụta nʼihi orure unu rere m. Nʼihi na ọ bụ nʼihi ichebe ndụ unu ka Chineke ji buru ụzọ zite m nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oge ụnwụ agwụchabeghị. Ọ bụ ezie na afọ abụọ nke oke ụnwụ agafeela, ma ọ fọdụrụ afọ ise ọzọ nʼihu, oge a na-agaghị akọ ihe ọbụla nʼala, maọbụ iwere ihe ọbụla nʼubi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke zitere m ka m buru ụzọ bịa nʼebe a nʼihi ime ka ndụ fọdụrụ unu nʼụwa, na ịzọpụta ndụ unu site nʼụzọ nnapụta dị oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, ọ bụghị unu zitere m nʼebe a, kama ọ bụ Chineke. Ya onwe ya emeela ka m ghọọrọ Fero nna, na onyeisi ezinaụlọ ya niile, na onye na-achị ala Ijipt niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, meenụ ngwa lakwuru nna m, sị ya, 'Ihe ndị a ka Josef nwa gị nwoke kwuru, Chineke emeela m onye na-achị Ijipt niile. Egbula oge ịbịakwute m.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-ebi nʼala Goshen,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "text": "ka i nwee ike ịnọ m nso, gị na ụmụ gị, na ụmụ ụmụ gị, na igwe ewu na atụrụ gị, na igwe ehi gị, na ihe niile i nwere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka m ga-enyekwa gị ihe ị chọrọ, nʼihi na ụnwụ afọ ise ka dị nʼihu na-abịa. Ọ bụrụ na i meghị otu a, gị na ezinaụlọ gị na ihe niile bụ nke gị ga-ada ụkpa.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, anya unu na nʼanya nwanne m Benjamin, ahụla na mụ onwe m ji ọnụ m na-agwa unu okwu ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-akọrọ nna m maka nsọpụrụ niile a na-enye m nʼala Ijipt na ihe niile unu hụrụ. Kpọtakwanụ nna m ọsịịsọ ebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ọ dakwasịrị nʼolu Benjamin, nwanne ya, kwaa akwa. Benjamin jidekwara ya nʼolu kwaa akwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, o suturu ụmụnne ya niile ọnụ, bekwasịkwa ha akwa. Nʼikpeazụ, ụmụnne ya kpanyeere ya ụka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe akụkọ a ruru ụlọ Fero na ụmụnne Josef bịara, ọ tọrọ Fero na ndịisi ozi niile ya ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.16",
            "verseOrgIds": [
              "GEN.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero gwara Josef sị ya, \"Gwa ụmụnne gị, ka ha mee ihe otu a, ha bokwasị ịnyịnya ibu unu ibu laghachikwa nʼala Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.17",
            "verseOrgIds": [
              "GEN.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ruo, ha kpọta nna gị, na ezinaụlọ ha, ka ha lọghachikwute m nʼala Ijipt. Nʼihi na aga m enye ha ala kachasị mma nʼIjipt. Ha onwe ha ga-erikwa uru ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.18",
            "verseOrgIds": [
              "GEN.45.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwakwa ụmụnne gị okwu sị ha, 'Sitenụ nʼala Ijipt were ụgbọala, nke unu ga-eji budata ndị nwunye unu na ụmụntakịrị unu. Dutekwanụ nna unu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
            "verseOrgIds": [
              "GEN.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu esogbula onwe unu banyere ngwa ụlọ unu, nʼihi na ihe niile dị mma nʼala Ijipt bụ nke unu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere ụmụ Izrel mere ihe ndị a. Josef nyere ha ụgbọala dịka Fero nyere nʼiwu. O nyekwara ha nri ha ga-eri nʼụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.21",
            "verseOrgIds": [
              "GEN.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere onye ọ bụla nʼime ha uwe mgbanwe ọhụrụ, ma o nyere Benjamin narị shekel ọlaọcha atọ, na uwe mgbanwe ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zipụụrụ nna ya ihe ndị a: ịnyịnya ibu iri ndị e bokwasịrị ihe mara mma niile si nʼala Ijipt, na nne ịnyịnya ibu iri ndị e bokwasịrị ọka na achịcha, na ihe ndị ọzọ dị iche iche, nʼihi ije ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.23",
            "verseOrgIds": [
              "GEN.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zipụrụ ụmụnne ya. Ma oge ha na-achọ ịhapụ ya, ọ gwara ha sị, \"Unu esekwala okwu nʼụzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
            "verseOrgIds": [
              "GEN.45.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha hapụrụ ala Ijipt mechaa rute ala Kenan, bịakwute Jekọb nna ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gwara ya sị, \"Josef ka nọ ndụ. Nʼezie, ọ bụ ya na-achị ala Ijipt niile.\" Ma o siiri Jekọb ike ịnabata akụkọ a. O kwenyeghị na ọ bụ eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha gwasịrị ya ihe niile Josef gwara ha, mgbe ọ hụkwara ụgbọala niile Josef zitere ka e jiri bute ya, mmụọ nna ha Jekọb lọghachiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Izrel kwuru sị, \"Ekwetala m! Josef nwa m ka dị ndụ. Aga m aga hụ ya anya tupu m nwụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "GEN.46",
    "number": "46",
