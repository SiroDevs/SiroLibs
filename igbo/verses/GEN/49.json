      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:15"
      },
      "items": [
        {
          "text": "hụ otu ala ya si maa mma,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:15"
      },
      "items": [
        {
          "text": "ọ ga-ehudata isi ya ibu ibu arụ;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
              "GEN.49.15"
            ]
          }
        }
      ]
