          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Asha ga-esi nʼubi ya wepụta nri gbara abụba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.20",
            "verseOrgIds": [
              "GEN.49.20"
            ]
          }
        }
      ]
