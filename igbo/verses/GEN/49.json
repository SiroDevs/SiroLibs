          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aka o ji jide ụta nke ya adaghị mba,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:24"
      },
      "items": [
        {
          "text": "ike agwụghị ogwe aka ya,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:24"
      },
      "items": [
        {
          "text": "nʼihi aka Onye dị ike nke Jekọb,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:24"
      },
      "items": [
        {
          "text": "nʼihi Onye ọzụzụ atụrụ, Oke Nkume Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.24",
            "verseOrgIds": [
              "GEN.49.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 49:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi Chineke nna gị, onye na-enyere gị aka,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:25"
      },
      "items": [
        {
          "text": "nʼihi Onye pụrụ ime ihe niile, ka ọ gọzie gị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:25"
      },
      "items": [
        {
          "text": "site na ngọzị nke eluigwe site nʼelu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:25"
      },
      "items": [
        {
          "text": "ngọzị nke osimiri dị nʼokpuru ala,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:25"
      },
      "items": [
        {
          "text": "ngọzị nke ara na akpanwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.25",
            "verseOrgIds": [
              "GEN.49.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 49:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị niile nke nna gị, dị ukwu karịa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "ngọzị niile nke ugwu ukwu mgbe ochie,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "karịakwa ngọzị nke ugwu nta mgbe ochie,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "Ka ngọzị ndị a dị iche dịkwasị nʼisi Josef,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:26"
      },
      "items": [
        {
          "text": "dịkwasị nʼegedege ihu Josef, onye bụ onyendu nʼetiti ụmụnne ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.26",
            "verseOrgIds": [
              "GEN.49.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Benjamin dịka nkịta ọhịa nke na-adọgbu anụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:27"
      },
      "items": [
        {
          "text": "Nʼụtụtụ, ọ na-eri anụ ọ dọgburu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:27"
      },
      "items": [
        {
          "text": "Nʼanyasị ọ na-ekesakwa ihe o gbutere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.27",
            "verseOrgIds": [
              "GEN.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ebo iri na abụọ dị nʼIzrel. Ihe ndị a bụkwa ihe nna ha gwara ha mgbe ọ gọziri ha, nye onye ọbụla nʼime ha ngọzị nke ruuru ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.28",
            "verseOrgIds": [
              "GEN.49.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Jekọb",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, o nyere ha ndụmọdụ sị ha, \"Nʼoge na-adịghị anya site ugbu a, aga m anwụ. Unu aghaghị ili m nʼebe e liri nna m ha, nʼala Kenan, nʼime ọgba ahụ dị nʼọhịa Efrọn, onye Het.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.29",
            "verseOrgIds": [
              "GEN.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ọgba dị nʼọhịa Makipela, nke dị nso na Mamre, nʼala Kenan, ọhịa Ebraham zụtara site nʼaka Efrọn onye Het, maka ili ozu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.30",
            "verseOrgIds": [
              "GEN.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka e liri Ebraham na Sera nwunye ya. Nʼebe ahụ kwa ka e liri Aịzik na Ribeka nwunye ya. Nʼebe ahụ ka m liri Lịa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
              "GEN.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham nna nna m zụrụ ala ahụ na ọgba dị nʼime ya site nʼaka ụmụ Het.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jekọb kwuchara okwu ndụmọdụ ikpeazụ ndị a nye ụmụ ya ndị ikom, ọ chịkọtara ụkwụ ya nʼelu akwa, kuo ume ikpeazụ. A chịkọtara ya na ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        }
      ]
    }
  ],
