      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:19"
      },
      "items": [
        {
          "text": "ma ọ ga-alụso ha ọgụ, chụọkwa ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.19",
            "verseOrgIds": [
              "GEN.49.19"
            ]
          }
        }
      ]
    },
