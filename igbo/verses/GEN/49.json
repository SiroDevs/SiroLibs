      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:17"
      },
      "items": [
        {
          "text": "dịka ajụala dị nʼụzọ ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
