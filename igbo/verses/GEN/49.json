      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:23"
      },
      "items": [
        {
          "text": "ha gbara ya àkụ site nʼịkpọ asị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.23",
            "verseOrgIds": [
              "GEN.49.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
