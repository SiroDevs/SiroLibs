            "style": "v",
            "sid": "GEN 49:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-agbata ụta sitere nʼobi ilu lụso ya agha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.23",
            "verseOrgIds": [
              "GEN.49.23"
            ]
          }
        }
      ]
