          "attrs": {
            "verseId": "GEN.49.18",
            "verseOrgIds": [
              "GEN.49.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.49.18",
                "verseOrgIds": [
                  "GEN.49.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", ana m ele anya nnapụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.18",
            "verseOrgIds": [
              "GEN.49.18"
            ]
          }
        }
      ]
