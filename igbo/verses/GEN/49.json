      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:22"
      },
      "items": [
        {
          "text": "na nke na-amị ezi mkpụrụ, otu a ka Josef dị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.22",
            "verseOrgIds": [
              "GEN.49.22"
            ]
          }
        }
      ]
    },
    {
