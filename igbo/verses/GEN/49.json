            "number": "21",
            "style": "v",
            "sid": "GEN 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Naftalị dịka nne ele a hapụrụ ahapụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.21",
            "verseOrgIds": [
              "GEN.49.21"
            ]
          }
        }
