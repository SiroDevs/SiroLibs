      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 49:17"
      },
      "items": [
        {
          "text": "nke na-ata ịnyịnya nʼikiri ụkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
