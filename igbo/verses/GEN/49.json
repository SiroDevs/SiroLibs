          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gad bụ onye usuu ndị o-ji-egbe-aga ga-abịakwasị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.19",
            "verseOrgIds": [
              "GEN.49.19"
            ]
          }
        }
