          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ otu ebe izuike ya si dị mma,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.15",
            "verseOrgIds": [
