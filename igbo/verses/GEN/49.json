      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:17"
      },
      "items": [
        {
          "text": "si otu a mee ka onye na-agba ịnyịnya dalaa azụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.17",
            "verseOrgIds": [
              "GEN.49.17"
            ]
          }
        }
      ]
