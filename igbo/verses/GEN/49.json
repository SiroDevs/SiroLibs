      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:21"
      },
      "items": [
        {
          "text": "nke na-amụpụta ụmụ ele mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.21",
            "verseOrgIds": [
              "GEN.49.21"
            ]
          }
        }
      ]
