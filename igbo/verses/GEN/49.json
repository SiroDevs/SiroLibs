      "attrs": {
        "style": "q2",
        "vid": "GEN 49:16"
      },
      "items": [
        {
          "text": "dịka otu nʼime ebo Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.16",
            "verseOrgIds": [
              "GEN.49.16"
            ]
          }
        }
      ]
