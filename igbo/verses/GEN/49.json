      "attrs": {
        "style": "q2",
        "vid": "GEN 49:20"
      },
      "items": [
        {
          "text": "nke na-adị ndị eze mma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.20",
            "verseOrgIds": [
              "GEN.49.20"
            ]
          }
        }
      ]
    },
