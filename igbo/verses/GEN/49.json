          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Isaka dị ike dịka ịnyịnya ibu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.14",
            "verseOrgIds": [
