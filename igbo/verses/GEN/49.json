      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 49:22"
      },
      "items": [
        {
          "text": "nke alaka ya na-awasa rigoro nʼelu mgbidi,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.22",
            "verseOrgIds": [
              "GEN.49.22"
            ]
          }
        }
      ]
    },
