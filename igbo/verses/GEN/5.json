  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "GEN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Site nʼAdam ruo Noa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ usoro ihe ndepụta banyere agbụrụ Adam.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 5:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 5:1"
      },
      "items": [
        {
          "text": "Mgbe Chineke kere mmadụ, o kere ya nʼoyiyi Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.1",
            "verseOrgIds": [
              "GEN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kere ha nwoke na nwanyị, gọziekwa ha. Mgbe e kere ha, ọ kpọrọ ha mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.2",
            "verseOrgIds": [
              "GEN.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Adam gbara narị afọ na iri afọ atọ, ọ mụrụ nwa ya nwoke nʼoyiyi nke ya, na nʼụdịdị nke ya. Ọ gụrụ ya Set.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge a mụrụ Set, Adam dịrị ndụ narị afọ asatọ ọzọ, ọ mụrụ ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adam nwụrụ mgbe ọ gbara narị afọ itoolu na iri afọ atọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
            "verseOrgIds": [
              "GEN.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Set gbara narị afọ na ise mgbe ọ ghọrọ nna Enọsh,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.6",
            "verseOrgIds": [
              "GEN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Enọsh, Set dịrị ndụ ruo narị afọ asatọ na asaa ọzọ, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.7",
            "verseOrgIds": [
              "GEN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Set nwụrụ mgbe ọ gbara narị afọ itoolu na iri afọ na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.8",
            "verseOrgIds": [
              "GEN.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Enọsh gbara iri afọ itoolu, ọ ghọrọ nna Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.9",
            "verseOrgIds": [
              "GEN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Kenan, Enọsh dịrị ndụ narị afọ asatọ na iri afọ na ise, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.10",
            "verseOrgIds": [
              "GEN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enọsh nwụkwara mgbe ọ nọzuru narị afọ itoolu na afọ ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.11",
            "verseOrgIds": [
              "GEN.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Kenan gbara iri afọ asaa ka ọ ghọrọ nna Mahalalel.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.12",
            "verseOrgIds": [
              "GEN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Mahalalel, Kenan dịrị ndụ narị afọ asatọ na iri afọ anọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.13",
            "verseOrgIds": [
              "GEN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenan nwụrụ mgbe ọ gbara narị afọ itoolu na afọ iri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.14",
            "verseOrgIds": [
              "GEN.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mahalalel gbara iri afọ isii na afọ ise ka ọ ghọrọ nna Jared.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.15",
            "verseOrgIds": [
              "GEN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Jared, Mahalalel dịrị ndụ narị afọ asatọ na iri afọ atọ, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.16",
            "verseOrgIds": [
              "GEN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahalalel nwụrụ mgbe ọ gbara narị afọ asatọ na iri afọ itoolu na ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.17",
            "verseOrgIds": [
              "GEN.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jared dị narị afọ na iri afọ isii na abụọ ka ọ ghọrọ nna Enọk.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.18",
            "verseOrgIds": [
              "GEN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Enọk, Jared dịrị ndụ narị afọ asatọ ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.19",
            "verseOrgIds": [
              "GEN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jared nwụrụ mgbe ọ gbara narị afọ itoolu na iri afọ isii na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.20",
            "verseOrgIds": [
              "GEN.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Enọk gbara iri afọ isii na afọ ise ka ọ ghọrọ nna Metusela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.21",
            "verseOrgIds": [
              "GEN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Metusela, Enọk soro ụzọ Chineke narị afọ atọ. Nʼoge a, ọ mụtara ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.22",
            "verseOrgIds": [
              "GEN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụọgụgụ nke afọ niile Enọk biri ndụ, bụ narị afọ atọ na iri afọ isii na ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.23",
            "verseOrgIds": [
              "GEN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enọk soro ụzọ Chineke ruo na a hụkwaghị ya nʼihi na Chineke kpọọrọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.24",
            "verseOrgIds": [
              "GEN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Metusela gbara narị afọ na iri afọ asatọ na asaa ka ọ ghọrọ nna Lamek.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.25",
            "verseOrgIds": [
              "GEN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọchara nna Lamek, Metusela dịrị ndụ narị afọ asaa na iri afọ asatọ na abụọ ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.26",
            "verseOrgIds": [
              "GEN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Metusela nwụrụ mgbe ọ gbara narị afọ itoolu na iri afọ isii na itoolu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.27",
            "verseOrgIds": [
              "GEN.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Lamek gbara narị afọ na iri afọ asatọ na abụọ ka ọ mụtara nwa nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.28",
            "verseOrgIds": [
              "GEN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lamek gụrụ ya Noa, nʼihi na ọ sịrị: \"Ọ ga-akasị anyị obi nʼime oke ọrụ na ndọgbu anyị na-adọgbu onwe anyị nʼọrụ nʼala a",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.5.29",
                "verseOrgIds": [
                  "GEN.5.29"
                ]
              }
            }
          ]
        },
        {
          "text": "bụrụ ọnụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.29",
            "verseOrgIds": [
              "GEN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a mụsịrị Noa, Lamek dịrị ndụ narị afọ ise na iri afọ itoolu na ise ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
