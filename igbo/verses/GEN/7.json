  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "GEN 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ahụ zuru,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.1",
                "verseOrgIds": [
                  "GEN.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ Noa sị ya, \"Baa nʼime ụgbọ mmiri, gị na ezinaụlọ gị niile, nʼihi na nʼime ndị niile bi nʼọgbọ a, ọ bụ naanị gị bụ onye ezi omume m hụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.1",
            "verseOrgIds": [
              "GEN.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọrọ ụmụ anụmanụ ndị a a gụrụ dịka ndị dị ọcha, dịka ụdị ha si dị asaa asaa, oke na nwunye. Otu a kwa, kpọrọkwa ụmụ anụmanụ ndị a gụrụ dịka ndị na-adịghị ọcha, dịka ụdị ha si dị, abụọ abụọ, oke na nwunye,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.2",
            "verseOrgIds": [
              "GEN.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ụmụ anụ ufe asaa asaa, dịka ụdị ha si dị, oke na nwunye, maka idebe ụdị ndị a niile ndụ nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.3",
            "verseOrgIds": [
              "GEN.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ụbọchị asaa site taa, aga m ezidata mmiri ozuzo nʼụwa. Mmiri a ga-ezo iri ụbọchị anọ, ehihie na abalị. Aga m ekpochapụ site nʼelu ụwa ihe niile nwere ndụ nke m kere.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.4",
            "verseOrgIds": [
              "GEN.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Noa mere ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.5",
                "verseOrgIds": [
                  "GEN.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.5",
            "verseOrgIds": [
              "GEN.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa gbara narị afọ isii mgbe mmiri ukwu a bidoro izo nʼelu ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.6",
            "verseOrgIds": [
              "GEN.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa banyere nʼụgbọ mmiri ahụ, ya na ụmụ ya ndị ikom na nwunye ya, na ndị nwunye ụmụ ya ndị ikom ịgbanarị uju mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.7",
            "verseOrgIds": [
              "GEN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ anụmanụ ndị dị ọcha, na ndị na-adịghị ọcha, abụọ abụọ, tinyere anụ ufe na ihe niile e kere eke na-akpụgharị nʼala, abụọ abụọ kwa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.8",
            "verseOrgIds": [
              "GEN.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "oke na nwunye, bịakwutere Noa soro ya banye nʼụgbọ mmiri ahụ, dịka Chineke nyere Noa nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.9",
            "verseOrgIds": [
              "GEN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe abalị asaa gafere, uju mmiri ahụ bịakwasịrị ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.10",
            "verseOrgIds": [
              "GEN.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ narị isii nke ndụ Noa, nʼọnwa nke abụọ, nʼụbọchị nke iri na asaa, bụ ụbọchị isi iyi niile dị nʼime ime ala nupụtara nʼelu ala, mmiri niile dị na mbara eluigwe ka a hapụrụ ka ha wụdata nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.11",
            "verseOrgIds": [
              "GEN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri zogịdere na-esepụghị aka iri ụbọchị anọ, ehihie na abalị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.12",
            "verseOrgIds": [
              "GEN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ kpomkwem, Noa banyere nʼụgbọ mmiri ahụ, ya na Shem, Ham na Jafet, bụ ụmụ Noa, na nwunye Noa, na ndị nwunye atọ nke ụmụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.13",
            "verseOrgIds": [
              "GEN.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha onwe ha, na anụ ọhịa ọbụla, nʼụdị ya, na anụ ụlọ ọbụla, nʼụdị ya na ihe ọbụla e kere eke na-akpụgharị nʼala, nʼụdị ya, na anụ ufe ọbụla nʼụdị ya, na aha nnụnụ ọbụla na ihe ọbụla nwere nku.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.14",
            "verseOrgIds": [
              "GEN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bịakwutere Noa nʼime ụgbọ mmiri ahụ, abụọ abụọ site nʼihe niile ọbụla e kere eke, nke nwere ume ndụ nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.15",
            "verseOrgIds": [
              "GEN.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị banyerenụ bụ oke na nwunye, site na ihe niile nwere ndụ dịka Chineke nyere ya nʼiwu. Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.7.16",
                "verseOrgIds": [
                  "GEN.7.16"
                ]
              }
            }
          ]
        },
        {
          "text": "mechiri ọnụ ụzọ dị nʼụgbọ mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.16",
            "verseOrgIds": [
              "GEN.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uju mmiri nọgidere nʼụwa iri ụbọchị anọ. Mgbe mmiri ndị a na-aba ụba, ha buliri ụgbọ mmiri ahụ elu site nʼelu ala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.17",
            "verseOrgIds": [
              "GEN.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri ndị a toro na-ala elu na-abawanyekwa ụba nʼelu ụwa. Ụgbọ mmiri ahụ segooro nʼelu mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.18",
            "verseOrgIds": [
              "GEN.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri ndị ahụ toro laa elu kpuchie ugwu ukwu niile dị nʼokpuru mbara eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.19",
            "verseOrgIds": [
              "GEN.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmiri ndị a toro kpuchiri ugwu niile, ruo na ịla elu mmiri ndị a site nʼelu ugwu ukwu niile ruru mita asaa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.20",
            "verseOrgIds": [
              "GEN.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile nwere ndụ nke na-ejegharị nʼelu ụwa kubiri ume. Anụ ufe, na anụ ụlọ, na anụ ọhịa, na ihe niile e kere eke jupụtara nʼụwa, na ụmụ mmadụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.21",
            "verseOrgIds": [
              "GEN.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ee, ihe niile na-eku ume nke bi nʼelu ala nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.22",
            "verseOrgIds": [
              "GEN.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile nwere ume ndụ nʼelu ụwa ka e kpochapụrụ. Mmadụ na anụmanụ, na anụ na-akpụgharị nʼala na nnụnụ niile. A lara ha niile nʼiyi. Ma ọ bụ naanị Noa na ndị niile so ya nọdụ nʼụgbọ mmiri ahụ ka a hapụrụ ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narị ụbọchị na iri ụbọchị ise ka mmiri dọọrọ nʼelu ụwa dum.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
  ],
