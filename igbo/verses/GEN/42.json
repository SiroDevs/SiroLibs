  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "GEN 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụnne Josef abịaruo Ijipt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, Jekọb nụrụ na ọka dị nʼIjipt. Ọ sịrị ụmụ ya, \"Kedụ ihe anyị jiri nọrọ na-elerịta onwe anyị anya\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Lee anụrụ m na ọka dị nʼIjipt. Gbadatanụ nʼebe ahụ zụtara anyị ọka ka anyị dị ndụ ghara ịnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnne Josef iri ndị ahụ gbadara Ijipt ịzụta ọka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jekọb ekweghị ka Benjamin nwanne nta Josef soro ha gaa, nʼihi na ọ tụrụ egwu na ihe ndaba ọjọọ nwere ike ịbịakwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a, ụmụ Izrel so nʼọtụtụ ndị ọzọ ndị jekwara ịzụrụ nri nʼIjipt, nʼihi na ụnwụ ahụ dị njọ nʼala Kenan.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Josef na-achị ala Ijipt, bụrụkwa onye iresi ndị obodo ọka dị nʼaka. Ya mere, mgbe ụmụnne Josef rutere, ha bịara hulata kpọọ isiala nye Josef.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.6",
            "verseOrgIds": [
              "GEN.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Josef hụrụ ụmụnne ya, ọ matara ndị ha bụ. Ma ọ kpara agwa dịka onye na-amaghị ha, gwa ha okwu nʼolu ike, sị ha, \"Ebee ka unu si bịa?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 42:7"
      },
      "items": [
        {
          "text": "Ha zara, \"Anyị si ala Kenan bịa. Anyị bịara ịzụrụ nri.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef matara ụmụnne ya, ma ha onwe ha amataghị onye ọ bụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.8",
            "verseOrgIds": [
              "GEN.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef chetakwara nrọ ndị ahụ ọ rọrọ banyere ha. Ọ gwara ha okwu sị ha, \"Unu bụ ndị nnyocha. Ịchọpụta adịghị ike ala anyị mere unu ji bịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara sị, \"Nna anyị ukwu, anyị bụ ndị ohu gị bịara ịzụrụ nri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.10",
            "verseOrgIds": [
              "GEN.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị niile bụ ụmụ otu nna. Ndị ohu gị bụ ndị kwesiri ntụkwasị obi. Anyị abụghị ndị nnyopụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Josef gwara ha sị, \"Mba! Unu bịara ịchọpụta akụkụ obodo anyị nke a na-echezighị nke ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara sị ya, \"Ndị ohu gị dị ụmụnne iri na abụọ. Ọ bụkwa otu nna mụrụ anyị niile. Nna anyị na nwanne anyị nta, onye ikpeazụ ọ mụrụ nọ na Kenan ugbu a. Ma otu onye nʼime anyị anwụọla.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef sịrị, \"Ihe unu na-akọ na-egosi na unu bụ ndị nnyopụta, dịka m gwara unu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.14",
            "verseOrgIds": [
              "GEN.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a ka a ga-eji anwale unu. Nʼaha Fero dị ndụ, unu agaghị esi nʼebe a laa tutu nwanne unu nke nta ahụ abịa nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.15",
            "verseOrgIds": [
              "GEN.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zipụnụ otu onye nʼime unu ka ọ gaa kpọta nwanne unu nwoke. Ma aga m etinye ndị fọdụrụ nʼụlọ mkpọrọ, tutu m chọpụta ma ihe unu kwuru ọ bụ eziokwu maọbụ ụgha. Ọ bụrụ ụgha nʼezie, dịka Fero na-adị ndụ, unu bụ ndị nnyopụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tinyere ha niile nʼụlọ mkpọrọ, hapụ ha nʼebe ahụ abalị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef gwara ha, nʼụbọchị nke atọ, \"Nke a bụ ihe unu ga-eme ma dị ndụ, nʼihi na abụ m onye na-atụ egwu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na unu bụ ndị ezi mmadụ, ka otu onye nʼime unu nọdụ nʼebe a, nʼụlọ mkpọrọ, ka ndị fọdụrụ buru ọka bulaara ndị ezinaụlọ unu nọ nʼagụụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma kpọtaranụ m nwanne unu nke nta nʼebe a, nke a ga-egosi na okwu unu bụ eziokwu, na unu agaghịkwa anwụ.\" Ha mere otu a.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gwarịtara onwe ha okwu sị, \"Nʼezie, ọ bụ nʼihi nwanne anyị nwoke ka ahụhụ ndị a ji abịakwasị anyị. Anyị hụrụ obi mgbawa ya, mgbe ọ na-arịọ ka anyị chebe ndụ ya, ma anyị egeghị ya ntị. Ọ bụ nke a mere mmekpa ahụ ndị a ji bịakwasị anyị ugbu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruben zara sị ha, \"Ọ bụ na mụ agwaghị unu sị unu hapụ imejọ nwantakịrị ahụ, ma unu egeghị ntị? Ugbu a, anyị na-asa ajụjụ banyere ọbara ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
              "GEN.42.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha amataghị na Josef na-anụ ihe ha na-ekwu, nʼihi na onye nsụgharị okwu nọ nʼetiti ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
            "verseOrgIds": [
              "GEN.42.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼebe ha nọ tụgharịa gaa kwaa akwa. Ọ lọghachikwutere ha ọzọ gwakwa ha okwu. O si nʼetiti ha kpọpụta Simiọn kee ya agbụ ka ha na-ele ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.24",
            "verseOrgIds": [
              "GEN.42.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josef nyere iwu ka e kpojuo ọka nʼakpa ha, tinyekwara onye ọbụla ego ọ kwụrụ nʼakpa ya. Ọ nyere iwu ka e nye ha ihe ha ga-eri nʼụzọ. Mgbe e mesịrị ihe ndị a,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 42:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha bokwasịrị ịnyịnya ibu akpa ọka ha nʼotu nʼotu. Ha hapụrụ Ijipt lawa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.26",
            "verseOrgIds": [
              "GEN.42.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 42:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ruru ebe ha nọrọ ọnọdụ abalị, otu nʼime ha meghere akpa ya ka o nye ịnyịnya ibu ya ọka, ọ hụrụ ego ya nʼọnụ akpa ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.27",
            "verseOrgIds": [
              "GEN.42.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ụmụnne ya sị, \"Lee, e tighachiri ego m kwụrụ. Lee ya nʼakpa ọka m.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 42:28"
      },
      "items": [
        {
          "text": "Ike gwụrụ onye ọbụla nʼime ha. Site nʼahụ ịma jijiji ha lerịtara onwe ha anya sị, \"Gịnị bụ ihe a Chineke mere anyị?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 42:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha lakwutere nna ha Jekọb nʼala Kenan, ha kọọrọ ya ihe niile dakwasịrị ha. Ha gwara ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
            "verseOrgIds": [
              "GEN.42.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 42:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwoke na-achị ala ahụ gwara anyị okwu nʼolu ike. O mesoro anyị mmeso dịka anyị bụ ndị bịara inyochapụta obodo ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 42:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anyị gwara ya sị, 'Anyị bụ ndị kwesiri ntụkwasị obi, ndị na-abụghị ndị nnyopụta obodo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.31",
            "verseOrgIds": [
              "GEN.42.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 42:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị dị ụmụnne iri na abụọ ndị nwere otu nna. Otu nʼime anyị anọkwaghị, ma nke ntakịrị na nna anyị nọ na nʼala Kenan taa.'",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 42:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, nwoke a, onye na-achị ala ahụ, sịrị anyị, 'Nke a ka m ga-eji mata ma unu bụ ndị ezi mmadụ. Hapụrụnụ m otu nwanne unu. Burunu ọka, bulaara ndị ezinaụlọ unu agụụ na-agụgbu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 42:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma kpọtara m nwanne unu nke nta. Mgbe ahụ ka m ga-ama ihe unu bụ. Ma unu bụ ndị nnyopụta maọbụ ndị ezi mmadụ. Mgbe ahụ, aga m ahapụrụ unu nwanne unu. Unu ga na-azụkwa ahịa nʼala a.' \"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bidoro ịwụpụtasị ọka dị nʼakpa ha, lee, nʼime akpa ọka onye ọbụla, a chọtara ego ọ kwụrụ nʼakpa ya. Mgbe ha na nna ha hụrụ ego ndị a, ha tụrụ egwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nna ha Jekọb gwara ha sị, \"Unu agbawala m aka ụmụ. Josef anọghị, Simiọn anọkwaghị. Ma unu na-achọ iwezuga Benjamin. Naanị m ka ihe niile ndị a na-emegide!\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ruben gwara nna ya sị, \"I nwere ike gbuo ụmụ m ndị ikom abụọ ma ọ bụrụ na m akpọghachighị Benjamin. Tifee ya nʼaka m, aga m akpọghachikwara gị ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jekọb sịrị, \"Nwa m agaghị eso unu gaa. Nʼihi na nwanne ya anwụọla, ọ bụkwa naanị ya ka ọ fọdụrụ. Ọ bụrụ na nsogbu ezute ya nʼụzọ nʼije a, unu ga-eme ka m jiri isi awọ m laa nʼili nʼọnọdụ mwute.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
      ]
    }
  ],
