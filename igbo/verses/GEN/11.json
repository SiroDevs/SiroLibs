  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "GEN 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụlọ elu Babel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ụwa niile nwere naanị otu asụsụ, okwu niile bụkwa otu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.1",
            "verseOrgIds": [
              "GEN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị mmadụ gbasara nʼakụkụ ọwụwa anyanwụ ha chọtara ala dị larịị na Shaịna biri nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.2",
            "verseOrgIds": [
              "GEN.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gwarịtara onwe ha okwu sị, \"Bịanụ ka anyị kpụọ brik,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.3",
            "verseOrgIds": [
              "GEN.11.3"
            ]
          }
        },
        {
          "text": "kpọọ ha ọkụ nke ọma.\" Ya mere, ha kpụrụ brik kama nkume, jirikwa bitumen kama ụrọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.3",
            "verseOrgIds": [
              "GEN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha kwuru sị, \"Bịanụ ka anyị wuore onwe anyị obodo na ụlọ elu, nke elu ya ga-eru nʼeluigwe, ka anyị si otu a meere onwe anyị aha, ka anyị ghara ịbụ ndị a ga-agbasa nʼụwa niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.5",
                "verseOrgIds": [
                  "GEN.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "rịdatara hụ obodo ahụ na ụlọ elu ahụ ndị mmadụ na-ewu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.6",
                "verseOrgIds": [
                  "GEN.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Lee! Ọ bụrụ na ha malitere ime ihe dị otu a, ugbu a ha bụ otu ndị, nweekwa otu asụsụ, o nweghị ihe ha zubere ime nke ha na-apụghị ime.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.6",
            "verseOrgIds": [
              "GEN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwa, ka anyị rịda gaa gbarụọ asụsụ ha, ka onye o bụla ghara ịghọta asụsụ ibe ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
            "verseOrgIds": [
              "GEN.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.8",
                "verseOrgIds": [
                  "GEN.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ha gbasaa nʼelu ụwa niile. Ha kwụsịkwara iwu obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa nke a mere e ji kpọọ obodo ahụ Babel",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "text": "nʼihi na ọ bụ nʼebe ahụ ka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.9",
                "verseOrgIds": [
                  "GEN.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "wetara ọgbaaghara nʼasụsụ ndị niile bi nʼụwa. Ọ bụkwa nʼebe ahụ ka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.11.9",
                "verseOrgIds": [
                  "GEN.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "si gbasasịa ha nʼelu ụwa dum.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Site na Shem ruo Ebram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro ezinaụlọ Shem.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 11:10"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 11:10"
      },
      "items": [
        {
          "text": "Mgbe afọ abụọ gafechara site nʼoge uju mmiri ahụ, nʼoge Shem gbara narị afọ, ọ mụtara Apakshad.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shem dịrị ndụ, mgbe ọ mụsịrị Apakshad, narị afọ ise ọzọ, mụtakwa ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Apakshad gbara iri afọ atọ na ise, ọ mụtara Shela.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ mụchara Shela, ọ dịrị ndụ narị afọ anọ na atọ ọzọ, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shela gbara iri afọ atọ mgbe ọ mụrụ nwa ya nwoke Eba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.14",
            "verseOrgIds": [
              "GEN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọrọ nna Eba, ọ dịrị ndụ narị afọ anọ na atọ, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.15",
            "verseOrgIds": [
              "GEN.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eba gbara iri afọ atọ na anọ mgbe ọ mụrụ Peleg.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.16",
            "verseOrgIds": [
              "GEN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ghọrọ nna Peleg, ọ dịrị ndụ narị afọ anọ na iri atọ ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.17",
            "verseOrgIds": [
              "GEN.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Peleg gbara iri afọ atọ mgbe ọ mụrụ Reu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.18",
            "verseOrgIds": [
              "GEN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, mgbe ọ ghọrọ nna Reu, ọ dịrị ndụ narị afọ abụọ na itoolu ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.19",
            "verseOrgIds": [
              "GEN.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reu gbara iri afọ atọ na abụọ mgbe ọ mụrụ Serug.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.20",
            "verseOrgIds": [
              "GEN.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ọ dịrị ndụ narị afọ abụọ na asaa ọzọ, mgbe ọ mụsịrị Serug, ọ mụtakwara ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.21",
            "verseOrgIds": [
              "GEN.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Serug gbara iri afọ atọ mgbe ọ mụrụ Nahọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.22",
            "verseOrgIds": [
              "GEN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, mgbe ọ ghọrọ nna Nahọ, ọ dịrị ndụ narị afọ abụọ ọzọ mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.23",
            "verseOrgIds": [
              "GEN.11.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahọ gbara iri afọ abụọ na itoolu mgbe ọ mụrụ Tera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.24",
            "verseOrgIds": [
              "GEN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, mgbe ọ ghọrọ nna Tera, ọ dịrị ndụ narị afọ na afọ iri na itoolu ọzọ, mụta ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.25",
            "verseOrgIds": [
              "GEN.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Tera gbara iri afọ asaa, ọ ghọrọ nna Ebram, Nahọ na Haran.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.26",
            "verseOrgIds": [
              "GEN.11.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezinaụlọ Ebram",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ gbasara usoro ezinaụlọ Tera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 11:27"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 11:27"
      },
      "items": [
        {
          "text": "Tera ghọrọ nna Ebram, Nahọ na Haran. Haran ghọrọ nna Lọt.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haran nwụrụ nʼihu nna ya Tera nʼala ebe a nọ mụọ ya, nke bụ na Ụọ, obodo ndị Kaldịa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
              "GEN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebram na Nahọ lụrụ nwunye. Aha nwunye Ebram bụ Serai ma aha nwunye Nahọ bụ Milka. Milka bụ nwa Haran, onye bụ nna Milka na Iska.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
            "verseOrgIds": [
              "GEN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Serai bụ nwanyị aga, ọ mụtaghị nwa ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.30",
            "verseOrgIds": [
              "GEN.11.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tera kpọrọ nwa ya Ebram, na nwa nwa ya Lọt, onye bụ nwa Haran,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "text": "na nwunye nwa ya Serai, bụ nwunye Ebram, duru ha hapụ Ụọ, obodo ndị Kaldịa, pụọ gawa nʼala Kenan. Ma mgbe ha bịarutere nʼobodo Haran, ha kwụsịrị biri nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼobodo Haran ka Tera nọ nwụọ, mgbe ọ gbara narị afọ abụọ na ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
            "verseOrgIds": [
              "GEN.11.32"
            ]
          }
        }
      ]
    }
