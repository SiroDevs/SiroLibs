  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "GEN 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Ebraham",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham lụrụ nwunye ọzọ, onye aha ya bụ Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.1",
            "verseOrgIds": [
              "GEN.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ mụụrụ ya Zimran, Jokshan, Medan, Midian, Ishbak na Shua.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.2",
            "verseOrgIds": [
              "GEN.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jokshan bụ nna Sheba na Dedan. Ụmụ ndị ikom Dedan bụ Ashurim, Letushim, na Leumim.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.3",
            "verseOrgIds": [
              "GEN.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Midian bụ Efaa, Efe, Hanok, Abida, na Eldaa. Ndị a niile bụ ụmụ Ketura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.4",
            "verseOrgIds": [
              "GEN.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham nyere Aịzik ihe niile o nwere.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham nyere ụmụ ndị ikom ndị iko ya nwanyị mụtara onyinye dị iche iche, zipụ ha nʼala dị nʼebe ọwụwa anyanwụ, mgbe ọ ka nọ ndụ, ka ha ghara ịnọ nwa ya nwoke Aịzik nso.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham dị ndụ ruo narị afọ na iri afọ asaa na ise.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham kubiri ume ndụ nwụọ mgbe o mere nnọọ ezigbo agadi, agadi nwoke nke ndụ juru afọ, e mere ka ọ lakwuru ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ya, Aịzik na Ishmel, liri ya nʼọgba Makipela nʼakụkụ Mamre, nʼala ubi Efrọn nwa Zoha onye Het,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ala ahụ Ebraham zụrụ site nʼaka ndị Het. Ebe ahụ ka e liri Ebraham ya na Sera nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ebraham nwụrụ, Chineke gọziri nwa ya nwoke Aịzik onye bi nʼoge ahụ na nso nso Bịa-Lahai-Rọị.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Ishmel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro ezinaụlọ Ishmel nwa Ebraham onye Hega, nwanyị Ijipt ahụ na-ejere Sera ozi mụụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.12",
            "verseOrgIds": [
              "GEN.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ aha ụmụ ndị ikom Ishmel nʼusoro ọmụmụ ha.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 25:13"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:13"
      },
      "items": [
        {
          "text": "Nebaiot bụ nwa mbụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:13"
      },
      "items": [
        {
          "text": "Ndị ọzọ bụ Keda, Adbel, Mibsam,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.13",
            "verseOrgIds": [
              "GEN.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mishma, Duma, Masa,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.14",
            "verseOrgIds": [
              "GEN.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadad, Tema, Jetua,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "GEN 25:15"
      },
      "items": [
        {
          "text": "Nafish na Kedema.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.15",
            "verseOrgIds": [
              "GEN.25.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ụmụ Ishmel, ndị a bụkwa aha ndịisi ikwu iri na abụọ ha, dịka ebe obibi ha si dị, na dịka ọmụma ụlọ ikwu ha si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel biri ndụ ruo narị afọ na iri afọ na asaa. Ọ nwụrụ, e mere ka ọ lakwuru ndị ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.17",
            "verseOrgIds": [
              "GEN.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ụmụ ya bi nʼala dị site na Havila ruo Shua nso nso oke ala ndị Ijipt, nʼụzọ e si aga Ashọ. Ha na ụmụnna ha ndị ọzọ ebighị nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.18",
            "verseOrgIds": [
              "GEN.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jekọb na Ịsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ akụkọ banyere usoro agbụrụ Aịzik nwa Ebraham.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "GEN 25:19"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:19"
      },
      "items": [
        {
          "text": "Ebraham bụ nna Aịzik.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aịzik gbara iri afọ anọ mgbe ọ lụrụ Ribeka, nwa Betuel, onye Aram si nʼobodo Padan Aram, nwanne Leban, onye Aram.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.20",
            "verseOrgIds": [
              "GEN.25.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aịzik kpere ekpere rịọọ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.25.21",
                "verseOrgIds": [
                  "GEN.25.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o nye nwunye ya nwa nʼihi na ọ bụ nwanyị aga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.25.21",
                "verseOrgIds": [
                  "GEN.25.21"
                ]
              }
            }
          ]
        },
        {
          "text": "zara ekpere ya. Nwunye ya, Ribeka dịịrị ime.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.21",
            "verseOrgIds": [
              "GEN.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ o bu nʼafọ bidoro na-alụ ọgụ nʼime afọ ya. Nʼihi nke a, o kwuru sị, \"Gịnị mere ihe dị otu a ji eme m?\" Ya mere, ọ gara jụta ase nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.25.22",
                "verseOrgIds": [
                  "GEN.25.22"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.22",
            "verseOrgIds": [
              "GEN.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "GEN.25.23",
                "verseOrgIds": [
                  "GEN.25.23"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "\"Mba abụọ dị gị nʼafọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "ụzọ mba abụọ dị nʼime gị ka a ga-ekewa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "Otu ụzọ ga-adị ike karịa nke ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "GEN 25:23"
      },
      "items": [
        {
          "text": "nke okenye ga-ejere nke nta ozi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.23",
            "verseOrgIds": [
              "GEN.25.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oge ime ya zuru, ụmụ abụọ dị nʼakpanwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.24",
            "verseOrgIds": [
              "GEN.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụ nwa nke mbụ buru ụzọ pụta na-acha uhie uhie, ahụ ya niile dịka uwe ajị. Nʼihi ya, ha kpọrọ aha ya Ịsọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.25",
            "verseOrgIds": [
              "GEN.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, nwanne ya pụtara, ma aka ya jidere ikiri ụkwụ Ịsọ. Nʼihi ya, a kpọrọ aha ya Jekọb. Aịzik gbara iri afọ isii mgbe Ribeka mụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.26",
            "verseOrgIds": [
              "GEN.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha abụọ toro, Ịsọ ghọrọ onye ọka nʼịchụ nta, onye na-epiogharị nʼọhịa, ebe Jekọb bụ nwoke dị nwayọọ, onye na-anọ nʼetiti ụlọ ikwu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.27",
            "verseOrgIds": [
              "GEN.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aịzik hụrụ Ịsọ nʼanya nʼihi na ụtọ anụ Ịsọ na-egbute nʼọhịa na-adị ya mma, ma Ribeka hụrụ Jekọb nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.28",
            "verseOrgIds": [
              "GEN.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịsọ eree ọnọdụ ọkpara ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, Jekọb nọ na-esi ofe mgbe Ịsọ si nʼọhịa bata. Agụụ na-agụkwa ya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.29",
            "verseOrgIds": [
              "GEN.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịsọ rịọrọ Jekọb sị, \"Nyetụ m ụfọdụ nʼime nri a na-acha uhie uhie ị na-esi ka m rie, nʼihi na agụụ na-agụ m hie nne.\" (Ọ bụ ihe a mere e ji na-akpọ ya Edọm.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        },
        {
          "text": ")",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.30",
            "verseOrgIds": [
              "GEN.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jekọb zara ya, \"Buru ụzọ resi m ọnọdụ ịbụ ọkpara gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.31",
            "verseOrgIds": [
              "GEN.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịsọ sịrị, \"Gịnị bụ uru ọnọdụ ịbụ ọkpara bara mgbe m na-anwụ nʼagụụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.32",
            "verseOrgIds": [
              "GEN.25.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jekọb sịrị ya, \"Buru ụzọ ṅụọrọ m iyi.\" Ya mere, ọ ṅụụrụ ya iyi, sị otu a resi Jekọb ọnọdụ ọkpara ya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jekọb nyere Ịsọ achịcha na ofe lentil o siri. O riri, ṅụọkwa, bilie ọtọ pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "GEN 25:34"
      },
      "items": [
        {
          "text": "Ya mere Ịsọ ledara ọnọdụ ịbụ ọkpara nna ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
          }
        }
      ]
    }
  ],
