  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "MAT 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs ezipu ndị ozi iri na abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs kpọrọ ndị na-eso ụzọ ya iri na abụọ nye ha ikike ịchụpụ mmụọ na-adịghị ọcha, na ịgwọ nrịa nrịa na ọrịa niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.1",
            "verseOrgIds": [
              "MAT.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ aha ndị ozi iri na abụọ ahụ:",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "MAT 10:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "Saimọn (onye a na-akpọkwa Pita) na Andru nwanne Saimọn;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:2"
      },
      "items": [
        {
          "text": "Jemis nwa Zebedi, na Jọn nwanne ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.2",
            "verseOrgIds": [
              "MAT.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filip na Batalomi;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Tọmọs na Matiu onye ọna ụtụ;",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "MAT 10:3"
      },
      "items": [
        {
          "text": "Jemis nwa Alfiọs, na Tadiọs.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.3",
            "verseOrgIds": [
              "MAT.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saimọn onye a na-akpọ Zilọt",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        },
        {
          "text": "na Judas Iskarịọt, onye raara ya nye nʼaka ndị gburu ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.4",
            "verseOrgIds": [
              "MAT.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom iri na abụọ ndị a ka Jisọs nyere ikike zipụ. Maara ha ọkwa sị ha:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu agala nʼebe ndị mba ọzọ, maọbụ nʼebe ndị Sameria nọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.5",
                "verseOrgIds": [
                  "MAT.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.5",
            "verseOrgIds": [
              "MAT.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kama jekwurunụ ụmụ Izrel, ndị bụ atụrụ furu efu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.6",
                "verseOrgIds": [
                  "MAT.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.6",
            "verseOrgIds": [
              "MAT.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe unu na-aga, na-ekwusaaranụ ha sị, 'alaeze eluigwe a dịla nso.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.7",
                "verseOrgIds": [
                  "MAT.10.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.7",
            "verseOrgIds": [
              "MAT.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gwọọnụ ndị ọrịa, kpọteenụ ndị nwụrụ anwụ, meenụ ka ahụ ndị ekpenta dị ọcha,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.8",
                "verseOrgIds": [
                  "MAT.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.8",
            "verseOrgIds": [
              "MAT.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "chụpụkwanụ mmụọ ọjọọ. Nʼefu ka unu natara. Ya mere, nyenụ nʼefu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.8",
                "verseOrgIds": [
                  "MAT.10.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe unu na-aga, unu anatala ọlaọcha maọbụ ọlaedo, maọbụ ọla ọbụla tinye nʼime belịt unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.9",
                "verseOrgIds": [
                  "MAT.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.9",
            "verseOrgIds": [
              "MAT.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu ejikwala akpa maka njem unu, maọbụ uwe abụọ, maọbụ akpụkpọụkwụ, maọbụ mkpanaka. Nʼihi na onye ọrụ kwesiri ihe e ji azụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.10",
                "verseOrgIds": [
                  "MAT.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.10",
            "verseOrgIds": [
              "MAT.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma obodo ọbụla maọbụ ogbe ọbụla unu bara nʼime ya, chọọnụ ụfọdụ ndị kwesiri nsọpụrụ bi nʼobodo ahụ. Nọgidekwanụ nʼụlọ ha ruo mgbe unu ga-ahapụ obodo ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.11",
                "verseOrgIds": [
                  "MAT.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.11",
            "verseOrgIds": [
              "MAT.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe unu na-abanye nʼụlọ ahụ, keleenụ ndị bi na ya sị, udo dịrị unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.12",
                "verseOrgIds": [
                  "MAT.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.12",
            "verseOrgIds": [
              "MAT.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na ndị nọ nʼụlọ ahụ anabata unu, meenụ ka udo unu bịakwasị nʼụlọ ahụ. Ọ bụrụkwanụ na ha anabataghị unu, ka udo unu lọghachikwute unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.13",
                "verseOrgIds": [
                  "MAT.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.13",
            "verseOrgIds": [
              "MAT.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na onye ọbụla anabataghị unu, maọbụ jụ ịnụrụ okwu unu, mgbe unu na-ahapụ ụlọ ahụ maọbụ obodo ahụ kụchapụnụ aja dị nʼụkwụ unu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.14",
                "verseOrgIds": [
                  "MAT.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.14",
            "verseOrgIds": [
              "MAT.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼeziokwu, ọ ga-adịrị obodo ahụ njọ nʼụbọchị ikpe karịa obodo Sọdọm na Gọmọra.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.15",
                "verseOrgIds": [
                  "MAT.10.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Mkpagbu nke oge dị nʼihu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ana m ezipu unu dị ka atụrụ nʼetiti agụ. Ya mere, nweenụ uche dịka agwọ. Burunu ndị a na-apụghị ịta ụta dịka nduru.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.16",
                "verseOrgIds": [
                  "MAT.10.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.16",
            "verseOrgIds": [
              "MAT.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kpachapụnụ anya. Nʼihi na a ga-enyefe unu nʼaka nzukọ ndị ụlọ ikpe, pịaakwa unu ihe nʼụlọ ekpere ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.17",
                "verseOrgIds": [
                  "MAT.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.17",
            "verseOrgIds": [
              "MAT.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "A ga-ekpe unu ikpe nʼihu ndị na-achị achị na nʼihu ndị eze nʼihi m. Ma nke a ga-enye unu ohere ịgwa ha ihe banyere m. E, nke a ga-enye unu ohere ịgba ama banyere m nye ndị mba ọzọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.18",
                "verseOrgIds": [
                  "MAT.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.18",
            "verseOrgIds": [
              "MAT.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ha jidere unu na-ekpe unu ikpe, unu echegbula onwe unu banyere ihe unu ga-ekwu, maọbụ otu unu ga-esi kwuo ya. Nʼihi na a ga-eme ka unu mata ihe unu ga-ekwu nʼoge ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.19",
                "verseOrgIds": [
                  "MAT.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.19",
            "verseOrgIds": [
              "MAT.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na ọ bụghị unu ga-ekwu nʼonwe unu. Kama Mmụọ nke Nna unu bi nʼeluigwe ga-esite nʼọnụ unu kwuo okwu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.20",
                "verseOrgIds": [
                  "MAT.10.20"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwanne ga-arara nwanne ya nye ka e gbuo ya, nna ga-ararakwa nwa ya nye. Ụmụ ga-ebili megide ndị mụrụ ha mee ka e gbuo ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.21",
                "verseOrgIds": [
                  "MAT.10.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.21",
            "verseOrgIds": [
              "MAT.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mmadụ niile ga-akpọ unu asị nʼihi m. Ma onye ga-eguzosi ike ruo ọgwụgwụ ka a ga-azọpụta.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.22",
                "verseOrgIds": [
                  "MAT.10.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.22",
            "verseOrgIds": [
              "MAT.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ọbụla ndị mmadụ sogburu unu nʼotu obodo gbalaganụ nʼobodo ọzọ. Nʼezie, asị m unu, unu agaghị agazucha obodo niile nke Izrel tupu Nwa nke Mmadụ alọghachi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.23",
                "verseOrgIds": [
                  "MAT.10.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwata akwụkwọ adịghị akarị onye nkuzi ya. Ohu adịghị akarịkwa nna ya ukwu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.24",
                "verseOrgIds": [
                  "MAT.10.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.24",
            "verseOrgIds": [
              "MAT.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "O zuorela onye na-eso ụzọ onye nkuzi ka ọ dị ka onye nkuzi ya, na ohu ahụ ka ọ dị ka onyenwe ya. Ọ bụrụ na a kpọrọ nna nwe ụlọ Belzebub, a ga-esi aṅaa ghara ịkpọ ndị ezinaụlọ ya ihe karịrị nke a?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.25",
                "verseOrgIds": [
                  "MAT.10.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Onye e kwesiri ịtụ egwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere unu atụla ha egwu. O nweghị ihe ọbụla e kpuchiri ekpuchi nke a na-agaghị ekpughe, maọbụ ihe e zoro ezo nke a na-agaghị eme ka ọ pụta ìhè.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.26",
                "verseOrgIds": [
                  "MAT.10.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.26",
            "verseOrgIds": [
              "MAT.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ihe m na-agwa unu ugbu a na nzuzo, kọsaanụ ya mgbe chi bọrọ. Ihe m ji nwayọọ mee ka ọ baa unu na ntị, nọdụnụ nʼelu ụlọ kwusaa ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.27",
                "verseOrgIds": [
                  "MAT.10.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.27",
            "verseOrgIds": [
              "MAT.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Unu atụla egwu ndị pụrụ igbu naanị anụ ahụ unu, ma ha enweghị ike ịmetụ mkpụrụobi unu aka. Kama onye unu ga-atụ egwu bụ Onye ahụ nwere ike imebi anụ ahụ unu na mkpụrụobi, tụbakwa ha nʼọkụ ala mmụọ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.28",
                "verseOrgIds": [
                  "MAT.10.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.28",
            "verseOrgIds": [
              "MAT.10.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 10:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụghị otu kobo ka a na-ere ụmụ nza abụọ? Ma otu nʼime ha agaghị ada nʼala ma ọ bụrụ na Nna unu bi nʼeluigwe amaghị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.29",
                "verseOrgIds": [
                  "MAT.10.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.29",
            "verseOrgIds": [
              "MAT.10.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 10:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụladị agịrị isi dị nʼisi unu ka a maara ọnụọgụgụ ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.30",
                "verseOrgIds": [
                  "MAT.10.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.30",
            "verseOrgIds": [
              "MAT.10.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 10:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, unu atụla egwu. Unu dị oke ọnụ karịa ọtụtụ ụmụ nza.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.31",
                "verseOrgIds": [
                  "MAT.10.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 10:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere, onye ọbụla kwupụtara m nʼihu ụmụ mmadụ, ka mụ onwe m ga-ekwupụta nʼihu Nna m bi nʼeluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.32",
                "verseOrgIds": [
                  "MAT.10.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.32",
            "verseOrgIds": [
              "MAT.10.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 10:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma onye ọbụla na-agọnarị m nʼihu ndị mmadụ, mụ onwe m ga-agọnarịkwa ya nʼihu Nna m bi nʼeluigwe.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.33",
                "verseOrgIds": [
                  "MAT.10.33"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 10:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu echekwala na m bịara iweta udo nʼụwa. Abịaghị m iweta udo, kama ọ bụ iwebata mma agha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.34",
                "verseOrgIds": [
                  "MAT.10.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.34",
            "verseOrgIds": [
              "MAT.10.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 10:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abịara m ime,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Ka nwoke megide nna ya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ka nwa nwanyị megide nne ya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 10:35"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ka nwunye nwa megide nne di ya,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.35",
                "verseOrgIds": [
                  "MAT.10.35"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 10:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndị iro mmadụ ga-abụ ndị ezinaụlọ ya.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.36",
                "verseOrgIds": [
                  "MAT.10.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na ị hụrụ nne gị maọbụ nna gị nʼanya karịa m, i kwesighị ịbụ onye nke m. Ọ bụrụ na ị hụrụ nwa gị nwoke, maọbụ nwa gị nwanyị nʼanya karịa m, i kwesighị ịbụ onye nke m.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.37",
                "verseOrgIds": [
                  "MAT.10.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.37",
            "verseOrgIds": [
              "MAT.10.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 10:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla na-eburughị obe ya soro m, ekwesighị ị bụ onye nke m.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.10.38",
                "verseOrgIds": [
                  "MAT.10.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.10.38",
            "verseOrgIds": [
              "MAT.10.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MAT 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
