        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụ na unu anabata onye amụma nʼihi na ọ bụ onye amụma, unu na onye amụma ahụ ga-enwekọ otu ụgwọ ọrụ. Ọ bụrụkwa na unu anabata onye ezi omume nʼihi ezi omume ya, unu ga-esorokwa ya nata ụgwọ ọrụ nke onye ezi omume.",
              "type": "text",
