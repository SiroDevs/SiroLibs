{
  "id": "MAT.20",
  "number": "20",
  "bookId": "MAT",
  "reference": "Matiu 20",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "MAT 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ilu banyere ndị ọrụ ubi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ihe ọzọ a ga-eji tụnyere alaeze eluigwe bụ nwoke nwere ala ubi, onye pụrụ nʼisi ụtụtụ ịkpọta ndị ọrụ ga-arụ ọrụ nʼubi vaịnị ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.1",
                "verseOrgIds": [
                  "MAT.20.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.1",
            "verseOrgIds": [
              "MAT.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya na ndị ọrụ ahụ kwekọtara na ọ ga-akwụ ha otu denarị, nʼihi ọrụ ụbọchị ahụ. Emesịa o zigara ha nʼubi vaịnị ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.2",
                "verseOrgIds": [
                  "MAT.20.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ọ pụrụ nʼihe dị ka elekere itoolu nke ụtụtụ, o sitere nʼebe a na-akpọta ndị ọrụ na-agafe hụ ndị ọzọ ka ha guzoro nʼọma ahịa na-enweghị ọrụ ha na-arụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.3",
                "verseOrgIds": [
                  "MAT.20.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.3",
            "verseOrgIds": [
              "MAT.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ sịrị ha, 'Unu onwe unu gaakwanụ rụọ ọrụ nʼubi vaịnị m, ihe ọbụla ziri ezi ka m ga-akwụ unu.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.4",
                "verseOrgIds": [
                  "MAT.20.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.4",
            "verseOrgIds": [
              "MAT.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere ha gara.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ pụkwara nʼelekere iri na abụọ na elekere atọ nke ehihie, ma meekwa otu ihe ahụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.5",
                "verseOrgIds": [
                  "MAT.20.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.5",
            "verseOrgIds": [
              "MAT.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe o ruru elekere ise nke anyasị, ọ pụrụ hụ ndị ọzọ ka ha guzoro. Ọ jụrụ ha ajụjụ sị, 'Gịnị mere unu ji guzoro nʼebe a taa niile na-arụghị ọrụ?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.6",
                "verseOrgIds": [
                  "MAT.20.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ha zara sị ya, 'Nʼihi na ọ dịghị onye kpọrọ anyị ọrụ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ gwara ha sị, 'Unu onwe unu gaakwanụ rụọ ọrụ nʼubi vaịnị m. Aga m akwụkwa unu ihe dị mma.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.7",
                "verseOrgIds": [
                  "MAT.20.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe o ruru oge anyasị, onye nwe ubi vaịnị ahụ gwara onye na-elekọtara ya ndị ahụ anya sị, 'Kpọkọta ndị ọrụ ahụ kwụọ ha ụgwọ, site na ndị ikpeazụ bịara ọrụ ruo na ndị bu ụzọ.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.8",
                "verseOrgIds": [
                  "MAT.20.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe ndị a kpọrọ ọrụ nʼelekere ise anyasị naara ego ha, a kwụrụ ha otu denarị, otu denarị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.9",
                "verseOrgIds": [
                  "MAT.20.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.9",
            "verseOrgIds": [
              "MAT.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma mgbe ndị a kpọrọ ọrụ nʼisi ụtụtụ bịara ịnara ego ha, ha lere anya na a ga-akwụ ha karịa. Ma a kwụkwara ha niile otu denarị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.10",
                "verseOrgIds": [
                  "MAT.20.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.10",
            "verseOrgIds": [
              "MAT.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mgbe ha naara ego ahụ, ha tamuru ntamu megide nna nwe ụlọ,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.11",
                "verseOrgIds": [
                  "MAT.20.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.11",
            "verseOrgIds": [
              "MAT.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "na-asị, 'Ndị a bịara nʼikpeazụ rụrụ ọrụ naanị otu awa, ma i meela ka anyị na ha hara. Anyị bụ ndị buru ihe mgbu nke ọrụ ma okpomọkụ nke anwụ niile chara nʼụbọchị taa.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.12",
                "verseOrgIds": [
                  "MAT.20.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ma ọ zara otu nʼime ha sị, 'Enyi m, emeghị m gị ihe ọjọọ ọbụla. Ọ bụ na mụ na gị ekwughị na m ga-akwụ gị otu denarị nʼụbọchị?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.13",
                "verseOrgIds": [
                  "MAT.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.13",
            "verseOrgIds": [
              "MAT.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nara nke ruru gị laa. A chọrọ m ịkwụ ndị a bịara nʼikpeazụ ụgwọ dị ka m si kwụọ gị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.14",
                "verseOrgIds": [
                  "MAT.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.14",
            "verseOrgIds": [
              "MAT.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụ na m enweghị ike iji ihe m nwere mee otu ọ masịrị m? Ọ bụ anya ukwu ka ị na-enwe nʼihi afọ ofufu m?'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.15",
                "verseOrgIds": [
                  "MAT.20.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere, onye ikpeazụ ga-abụ onye bu ụzọ, ma onye bu ụzọ ga-abụkwa onye ikpeazụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.16",
                "verseOrgIds": [
                  "MAT.20.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs ekwuokwa okwu banyere ọnwụ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs na-aga Jerusalem, ọ kpọpụrụ mmadụ iri na abụọ ahụ na-eso ụzọ ya nʼakụkụ sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Lee, anyị na-aga Jerusalem ebe a ga-arara Nwa nke Mmadụ nyefee nʼaka ndịisi nchụaja na ndị ozizi iwu. Ha ga-ama ya ikpe ọnwụ,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.18",
                "verseOrgIds": [
                  "MAT.20.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nyefekwa ya nʼaka ndị mba ọzọ, ndị ga-eji ya mee ihe ọchị, pịa ya ihe, ma kpọgide ya nʼobe. Ma nʼụbọchị nke atọ, a ga-eme ka ọ site nʼọnwụ bilie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.19",
                "verseOrgIds": [
                  "MAT.20.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ nne Jemis na Jọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nne ụmụ Zebedi, duuru ụmụ ya ndị ikom abụọ bịakwute ya, o gburu ikpere nʼala nʼihu ya, rịọ ya ihe ọ chọrọ ka o meere ha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
              "MAT.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka ị chọrọ ka m meere gị?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.21",
                "verseOrgIds": [
                  "MAT.20.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:21"
      },
      "items": [
        {
          "text": "Ọ zara ya sị, \"Kwee m nkwa na ụmụ abụọ ndị a ga-anọdụ otu nʼaka nri gị, nke ọzọ nʼaka ekpe gị nʼalaeze gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.21",
            "verseOrgIds": [
              "MAT.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jisọs zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu amaghị ihe unu na-arịọ. Unu pụrụ ịṅụ iko ahụ nke mụ onwe m ga-aṅụ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.22",
                "verseOrgIds": [
                  "MAT.20.22"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 20:22"
      },
      "items": [
        {
          "text": "Ha zara ya sị, \"Ee, anyị nwere ike ịṅụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.22",
            "verseOrgIds": [
              "MAT.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.23",
            "verseOrgIds": [
              "MAT.20.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼezie unu ga-aṅụ iko m ga-aṅụ, ma ịnọdụ nʼaka nri maọbụ nʼaka ekpe m, abụghị ihe dịrị m inye, kama ọ dịịrị ndị ahụ Nna m kwadooro ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.23",
                "verseOrgIds": [
                  "MAT.20.23"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmadụ iri ndị ọzọ nʼime ndị na-eso ụzọ ya nụrụ nke a, iwe were ha nke ukwuu megide ụmụnne abụọ a.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.24",
            "verseOrgIds": [
              "MAT.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jisọs kpọkọtara ha niile, sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nʼetiti ndị na-ekweghị ekwe,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.25",
                "verseOrgIds": [
                  "MAT.20.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndịisi ha na-emeso ndị ha na-achị mmeso dị ka o si dị ha mma nʼuche. Ndị ukwu nʼetiti ha na-ejikwa aka ike na-achị ndị nọ nʼokpuru ha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.25",
                "verseOrgIds": [
                  "MAT.20.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.25",
            "verseOrgIds": [
              "MAT.20.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma nʼetiti unu ọ gaghị adị otu a. Kama, onye ọbụla nʼetiti unu chọrọ ịbụ onyeisi, ga-ebu ụzọ bụrụ onye na-ejere unu niile ozi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.26",
                "verseOrgIds": [
                  "MAT.20.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.26",
            "verseOrgIds": [
              "MAT.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma onye ọbụla nke chọrọ ịbụ onye mbụ nʼetiti unu ga-abụ ohu unu niile.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.27",
                "verseOrgIds": [
                  "MAT.20.27"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụladị dị ka Nwa nke Mmadụ na-abịaghị ka e jeere ya ozi, kama ka o jee ozi, ma nyekwa ndụ ya ka ọ bụrụ ihe mgbapụta nke ọtụtụ mmadụ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.28",
                "verseOrgIds": [
                  "MAT.20.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ìsì abụọ Jisọs gwọrọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-ahapụ Jeriko, ọtụtụ igwe mmadụ sooro ya nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.29",
            "verseOrgIds": [
              "MAT.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ìsì abụọ nọ nʼakụkụ ụzọ ahụ. Mgbe ha nụrụ na ọ bụ Jisọs na-abịa, ha malitere iti mkpu nʼoke olu na-asị, \"Onyenwe anyị, Nwa Devid, meere anyị ebere!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.30",
            "verseOrgIds": [
              "MAT.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwe mmadụ ahụ baara ha mba ka ha mechie ọnụ ha. Ma ndịisi ahụ nọgidesịrị ike na-eti mkpu nʼoke olu na-asị, \"Onyenwe anyị, Nwa Devid, meere anyị ebere!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.31",
            "verseOrgIds": [
              "MAT.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs bịaruru nʼebe ha nọ, o guzoro kpọọ ha, jụọ ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.32",
            "verseOrgIds": [
              "MAT.20.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka unu chọrọ ka m meere unu?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.20.32",
                "verseOrgIds": [
                  "MAT.20.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara sị ya, \"Onyenwe anyị, biko, anyị chọrọ ka i mee ka anyị hụ ụzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.33",
            "verseOrgIds": [
              "MAT.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs nwere ọmịiko nʼahụ ha. O metụrụ ha aka nʼanya. Ngwangwa ha bidoro ịhụ ụzọ, ma sorokwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.34",
            "verseOrgIds": [
              "MAT.20.34"
            ]
          }
        }
      ]
    }
  ],
