{
  "id": "MAT.11",
  "number": "11",
  "bookId": "MAT",
  "reference": "Matiu 11",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "MAT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozi Jọn ziri ka e zie Jisọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs nyesịrị ndị na-eso ụzọ ya ndụmọdụ ndị a, ọ hapụrụ ebe ahụ pụọ. Bido na-ejegharị nʼobodo dị iche iche na-ezisa oziọma.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jọn omee baptizim nọkwa nʼụlọ mkpọrọ nʼoge ahụ. Mgbe ọ nụrụ akụkọ ọrụ ebube niile nke Kraịst na-arụ, o zipụrụ ndị na-eso ụzọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara ha ka ha jụọ ya ajụjụ sị, \"Ọ bụ gị bụ onye ahụ anyị na-ele anya ọbịbịa ya, ka ọ bụ onye ọzọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs zara ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Laghachinụ azụ gwa Jọn banyere ihe unu nụrụ na ihe anya unu hụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.4",
                "verseOrgIds": [
                  "MAT.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gwanụ ya na a na-eme ka ndị ìsì hụ ụzọ, ka ndị ngwụrọ gaa ije. A na-emekwa ka ahụ ndị ekpenta dị ọcha.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.5",
                "verseOrgIds": [
                  "MAT.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndị ogbi na-anụ ihe, na-ekwu okwu. Ndị nwụrụ anwụ ka a na-akpọte. Gwakwanụ ya ihe banyere oziọma a na-ezisara ndị ogbenye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.5",
                "verseOrgIds": [
                  "MAT.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ziekwanụ ya ozi a, na ngọzị na-adịrị onye ahụ na-enweghị ihe mkpasu iwe nʼihi m.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.6",
                "verseOrgIds": [
                  "MAT.11.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ahụ Jọn zitere lara, Jisọs bidoro ịgwa igwe mmadụ nọ nʼebe ahụ okwu banyere Jọn. Ọ jụrụ ha ajụjụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mgbe unu gara nʼọzara ịhụ Jọn, gịnị ka unu lere anya na unu ga-ahụ? Ọ bụ ahịhịa achara nke ikuku na-ebugharị?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.7",
                "verseOrgIds": [
                  "MAT.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ bụghị otu a, gịnị ka unu pụrụ ịga ịhụ? Ọ bụ nwoke yi uwe mara mma? Ma lee ndị na-eyi uwe dị oke ọnụahịa na-anọ nʼụlọ eze.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.8",
                "verseOrgIds": [
                  "MAT.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.8",
            "verseOrgIds": [
              "MAT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma gịnị ka unu lere anya na unu ga-ahụ? Ọ bụ onye amụma? E, asị m unu, ọ bụ onye karịrị onye amụma.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.9",
                "verseOrgIds": [
                  "MAT.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.9",
            "verseOrgIds": [
              "MAT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye bụ onye ahụ e dere ihe banyere ya nʼakwụkwọ nsọ sị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Lee, aga m ezipu onyeozi m nʼihu gị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "onye ga-edozi ụzọ gị nʼihu gị.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼezie, ọ dịghị nwoke ọbụla nʼetiti ndị nwanyị mụrụ dị ukwuu karịa Jọn omee baptizim. Ma onye dịkarịsịrị nta nʼalaeze eluigwe dị ukwuu karịa ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.11",
                "verseOrgIds": [
                  "MAT.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Site nʼụbọchị ndị ahụ Jọn omee baptizim malitere ọrụ ya ruo ugbu a, ihe banyere alaeze eluigwe na-agabiga ihe ike. Otu a kwa ndị dị ike na-abagidekwa ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.12",
                "verseOrgIds": [
                  "MAT.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na tupu Jọn abịa, iwu na ndị amụma niile buru amụma banyere alaeze a.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.13",
                "verseOrgIds": [
                  "MAT.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụkwa na unu jikeere ịnabata ya, ọ bụ ya bụ Ịlaịja ahụ, nke na a ga ịbịa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.14",
                "verseOrgIds": [
                  "MAT.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla nwere ntị ịnụ ihe, ya nụrụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.15",
                "verseOrgIds": [
                  "MAT.11.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị ka m ga-eji tụnyere ndị bi nʼọgbọ a? Gịnị ka ha yiri? Ha dị ka ụmụntakịrị na-egwuri egwu nʼama, ndị na-asị ibe ha,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.16",
                "verseOrgIds": [
                  "MAT.11.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Anyị gburu unu ọja,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ma unu ekweghị ete egwu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Anyị bụụrụ unu abụ ịkwa ozu,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ma unu akwaghị akwa.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Jọn bịara na-erighị achịcha maọbụ ihe ọṅụṅụ. Ha sịrị, 'Mmụọ ọjọọ bi nʼime ya.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.18",
                "verseOrgIds": [
                  "MAT.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma Nwa nke Mmadụ bịara na-eri ihe oriri, na-aṅụkwa ihe ọṅụṅụ. Ha sị, 'Lee, onye oke oriri na onye oke aṅụmaṅụ abịala, enyi ndị ọna ụtụ na ndị mmehie.' Ma amamihe na-esite nʼọrụ ya gosiri na ihe o mere dị mma.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.19",
                "verseOrgIds": [
                  "MAT.11.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụmọnụ nye obodo ndị na-ekwenyeghị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ọ bidoro ịbụ obodo niile ebe ọ rụrụ ọtụtụ ọrụ ebube ọnụ, nʼihi na obodo ndị a echegharịghị.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ahụhụ ga-adịrị gị Korazin. Ahụhụ ga-adịkwara gị Betsaida. Nʼihi na a sị na ọ bụ nʼime Taịa na Saịdọn ka a rụrụ ọrụ ebube niile a rụrụ nʼime unu, ha gaara echegharị ma gosikwa nchegharị ha site nʼiyi uwe mkpe na ikpokwasị onwe ha ntụ nʼisi.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.21",
                "verseOrgIds": [
                  "MAT.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼezie asị m unu na ọ ga-adịrị unu njọ nʼụbọchị ikpe ahụ karịa obodo Taịa na Saịdọn.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.22",
                "verseOrgIds": [
                  "MAT.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma gị Kapanọm bụ obodo a na-asọpụrụ, a ga-ebuli gị elu ruo eluigwe? Mba, ị ga-arịdaru ọkụ ala mmụọ. Nʼihi na a sị na a rụrụ ọrụ ebube m rụrụ nʼime gị nʼobodo Sọdọm, a garaghị ala ya nʼiyi. Ọ gaara adịrị ruo taa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼezie asị m unu, ọ ga-adịrị unu njọ nʼụbọchị ikpe ahụ karịa obodo Sọdọm.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.24",
                "verseOrgIds": [
                  "MAT.11.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izuike nye ndị ike gwụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Jisọs kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna, Onyenwe eluigwe na ụwa, ana m ekele gị,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nʼihi na ị zonarịrị ndị ọkachamara eziokwu ahụ, ma kpughee ya nye ụmụntakịrị.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "E, Nna m, ọ tọrọ gị ụtọ ime ya nʼụzọ dị otu a.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.26",
                "verseOrgIds": [
                  "MAT.11.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nna m enyefeela m ihe niile nʼaka. Ọ dịghị onye maara Ọkpara ahụ ma ọ bụghị Nna ya. Ọ dịkwaghị onye maara Nna karịa Ọkpara ahụ na ndị Ọkpara ahụ kwadoro igosi Nna ya.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.27",
                "verseOrgIds": [
                  "MAT.11.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bịakwutenụ m unu niile ndị na-adọgbu onwe unu nʼọrụ, ndị e bokwasịrị ibu dị arọ. Aga m enyekwa unu izuike.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.28",
                "verseOrgIds": [
                  "MAT.11.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nyaranụ yoku",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "nke m nʼolu unu, mụtakwanụ ihe site nʼaka m. Nʼihi na adị m nwayọọ, bụrụkwa onye dị umeala nʼobi. Unu ga-achọtakwara mkpụrụobi unu izuike.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na yoku m dị mfe, ibu m adịghịkwa arọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.30",
                "verseOrgIds": [
                  "MAT.11.30"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
