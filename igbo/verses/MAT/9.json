{
  "id": "MAT.9",
  "number": "9",
  "bookId": "MAT",
  "reference": "Matiu 9",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "MAT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agwọọ onye ahụ ya kpọnwụrụ akpọnwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs banyekwara nʼụgbọ mmiri nke kwọọrọ ya bịaruo nʼobodo nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.1",
            "verseOrgIds": [
              "MAT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom ụfọdụ butere ya otu nwoke akụkụ ahụ ya kpọnwụrụ akpọnwụ, bụ onye dina nʼute. Mgbe Jisọs hụrụ okwukwe ndị ahụ, ọ gwara onye ọrịa ahụ okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.2",
            "verseOrgIds": [
              "MAT.9.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwee obi ike nwa m nwoke nʼihi na a gbagharala gị mmehie gị niile.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.2",
                "verseOrgIds": [
                  "MAT.9.2"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, ụfọdụ ndị ozizi iwu nke ndị Juu nọ nʼebe ahụ sịrịtara onwe ha, \"Nwoke a na-ekwulu Chineke.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.3",
            "verseOrgIds": [
              "MAT.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ebe Jisọs matara ihe ha na-eche nʼobi ha, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gịnị mere unu ji na-eche ajọ echiche nʼobi unu?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.4",
                "verseOrgIds": [
                  "MAT.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.4",
            "verseOrgIds": [
              "MAT.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Olee nke ka mfe ikwu? Ọ bụ ị sị, 'A gbagharala gị mmehie gị niile,' ka ọ bụ ị sị, 'Bilie jee ije'?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.5",
                "verseOrgIds": [
                  "MAT.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.5",
            "verseOrgIds": [
              "MAT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ka unu mata na Nwa nke Mmadụ nwere ikike nʼụwa ịgbaghara mmehie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Ọ sịrị onye ahụ akụkụ ahụ ya kpọnwụrụ akpọnwụ,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bilie, chịrị ute gị laa!\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.6",
                "verseOrgIds": [
                  "MAT.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.6",
            "verseOrgIds": [
              "MAT.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ biliri, chịrị ute ya laa nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.7",
            "verseOrgIds": [
              "MAT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe igwe mmadụ a hụrụ ihe ahụ mere, akpata oyi jụrụ ha nʼahụ nʼihi egwu. Ha tokwara Chineke onye na-enye ụmụ mmadụ ikike dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.8",
            "verseOrgIds": [
              "MAT.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọkpụkpọ Matiu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs si nʼebe ahụ na-aga, ọ hụrụ otu nwoke a na-akpọ Matiu ka ọ nọdụrụ ala nʼụlọ ịnakọta ụtụ. Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Soro m.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.9",
                "verseOrgIds": [
                  "MAT.9.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Na-atụfughị oge, ọ hapụrụ ihe niile soro ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.9",
            "verseOrgIds": [
              "MAT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dị ka ọ nọdụrụ ala iri nri uhuruchi nʼụlọ Matiu, ọtụtụ ndị ọna ụtụ na ndị mmehie sooro ya na ndị na-eso ụzọ ya nọdụ na-eri nri.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.10",
            "verseOrgIds": [
              "MAT.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Farisii hụrụ nke a, ha jụrụ ndị na-eso ụzọ ya ajụjụ sị ha, \"Gịnị mere onye ozizi unu ji eso ndị ọna ụtụ na ndị mmehie na-eri nri?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.11",
            "verseOrgIds": [
              "MAT.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nụrụ nke a, Jisọs sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mkpa dibịa adịghị akpa ndị ahụ dị ike, kama ọ bụ ndị ahụ na-esighị ike ka mkpa dibịa na-akpa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.12",
                "verseOrgIds": [
                  "MAT.9.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.12",
            "verseOrgIds": [
              "MAT.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma gaanụ mụta ihe okwu a pụtara, 'Ana m achọ ebere, ọ bụghị aja.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.13",
                "verseOrgIds": [
                  "MAT.9.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.13",
            "verseOrgIds": [
              "MAT.9.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na abịaghị m ịkpọ ndị ezi omume, kama abịara m ịkpọ ndị mmehie.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.13",
                "verseOrgIds": [
                  "MAT.9.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajụjụ banyere ibu ọnụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị na-eso ụzọ Jọn bịara jụọ ya ajụjụ sị, \"Gịnị mere ndị na-eso ụzọ gị adịghị ebu ọnụ dị ka anyị onwe anyị na ndị Farisii na-eme?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.14",
            "verseOrgIds": [
              "MAT.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs jụrụ ha sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.15",
            "verseOrgIds": [
              "MAT.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"O kwesiri ka ndị enyi onye na-alụ nwunye ọhụrụ nọrọ na mwute na-erighị nri, mgbe ha na di nwanyị ọhụrụ nọ? Oge na-abịa mgbe a ga-ewepụ di nwanyị ọhụrụ nʼetiti ha, mgbe ahụ ka ha ga-ebu ọnụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.15",
                "verseOrgIds": [
                  "MAT.9.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ dịghị onye na-eji akwa ọhụrụ kwachie ebe akwa ochie siri dọkaa, nʼihi na akwa ahụ ga-esi nʼebe a kwachiri ya dọwaa; mee ka ọ dị njọ karịa ka ọ dị na mbụ.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.16",
                "verseOrgIds": [
                  "MAT.9.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.16",
            "verseOrgIds": [
              "MAT.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ dịkwaghị onye ga-etinye mmanya ọhụrụ nʼime karama akpụkpọ ochie, nʼihi na karama ochie ahụ ga-agbawa mee ka mmanya ọhụrụ ahụ wufuo. Kama ọ dị mma itinye mmanya ọhụrụ nʼime karama akpụkpọ ọhụrụ, nke ga-echekwa ha abụọ nke ọma.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.17",
                "verseOrgIds": [
                  "MAT.9.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwata nwanyị na ọtụtụ ndị ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nọ na-ekwu okwu, otu onyeisi ụlọ ekpere bịara kpọọ isiala nye ya, sị, \"Ọ dịbeghị anya nwa m nwanyị nwụrụ. Otu ọ dị, bịa ka ị bikwasị ya aka gị. Ọ ga-ebili dịkwa ndụ ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Jisọs soro ya gawa. Ndị na-eso ụzọ ya sokwara ha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o nwere otu nwanyị onye ahụ na-esighị ike. Nwanyị a anọọla nʼọrịa a afọ iri na abụọ. Ọ bụkwa ọrịa oruru ọbara nke na-adịghị akwụsị akwụsị ka ọ na-arịa. Nwanyị a sitere nʼazụ bịaruo ya nso, metụ ọnụ uwe ya aka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.20",
            "verseOrgIds": [
              "MAT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o kwuolarị nʼime obi ya sị, \"Ọ bụrụ nnọọ na m ga-enwe ike metụ ọnụ uwe ya aka, a ga-agwọ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.21",
            "verseOrgIds": [
              "MAT.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs chigharịrị lee ya anya sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ada m, nwee obi ike, nʼihi na e sitela nʼokwukwe gị mee ka ahụ dị gị mma.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.22",
                "verseOrgIds": [
                  "MAT.9.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Ahụ dịkwara nwanyị ahụ mma site nʼoge ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.22",
            "verseOrgIds": [
              "MAT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs batara nʼụlọ onyendu ụlọ ekpere ndị Juu ahụ, hụ igwe mmadụ ka ha na-atụ ụzụ na ndị na-egbu ọja.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.23",
            "verseOrgIds": [
              "MAT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Sinụ ebe a pụọ, nwata nwanyị a anwụghị anwụ, kama ọ nọ nʼụra.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.24",
                "verseOrgIds": [
                  "MAT.9.24"
                ]
              }
            }
          ]
        },
        {
          "text": "Ma ha chịrị ya ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.24",
            "verseOrgIds": [
              "MAT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe achụpụsịrị igwe mmadụ ahụ, ọ banyere nʼime ụlọ, jide nwata nwanyị ahụ nʼaka, o bilie ọtọ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.25",
            "verseOrgIds": [
              "MAT.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ ọrụ ebube a gbasara nʼebe niile nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.26",
            "verseOrgIds": [
              "MAT.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jisọs agwọọ ndị ìsì na onye ogbi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jisọs si nʼebe ahụ na-apụ, ụmụ nwoke abụọ ndị kpuru ìsì sooro ya. Ha tikuru ya mkpu na-asị, \"Nwa Devid, meere anyị ebere!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.27",
            "verseOrgIds": [
              "MAT.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sooro ya bata nʼụlọ ebe ọ nọ. Ọ jụrụ ha ajụjụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu kwere na m nwere ike ime ka unu hụ ụzọ?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.28",
                "verseOrgIds": [
                  "MAT.9.28"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 9:28"
      },
      "items": [
        {
          "text": "Ha zara sị ya, \"E, Onyenwe anyị, anyị kweere.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.28",
            "verseOrgIds": [
              "MAT.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "O metụrụ ha aka nʼanya sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya dịrị unu dị ka okwukwe unu si dị.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.29",
                "verseOrgIds": [
                  "MAT.9.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.29",
            "verseOrgIds": [
              "MAT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ndị ìsì ahụ bidoro ịhụ ụzọ. Jisọs maara ha ọkwa sị ha",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Unu agwakwala onye ọbụla.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.30",
                "verseOrgIds": [
                  "MAT.9.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.30",
            "verseOrgIds": [
              "MAT.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha pụrụ gbasaa akụkọ a ebe niile nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.31",
            "verseOrgIds": [
              "MAT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị a sitere nʼebe ahụ pụọ, ndị ọzọ buteere ya nwoke dara ogbi, onye mmụọ ọjọọ bikwa nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.32",
            "verseOrgIds": [
              "MAT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ chụpụrụ mmụọ ọjọọ ahụ, onye ogbi ahụ bidoro ikwu okwu. Ibubo nwụrụ igwe mmadụ nọ nʼebe ahụ. Ha sịrị, \"Anyị ahụtụbeghị ihe dị otu a nʼala Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.33",
            "verseOrgIds": [
              "MAT.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Farisii sịrị, \"Ọ bụ ekwensu, eze ndị mmụọ ọjọọ, na-enye ya ike ịchụpụ mmụọ ọjọọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.34",
            "verseOrgIds": [
              "MAT.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ọrụ adịghị ukwuu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs jegharịrị nʼobodo niile na ogbe niile dị nʼebe ahụ, ma ndị ukwu na ndị nta, na-ezi ihe nʼụlọ ekpere ndị Juu, na-ekwusakwa oziọma nke alaeze ahụ. Ọ na-agwọkwa ọrịa na nrịa nrịa niile dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.35",
            "verseOrgIds": [
              "MAT.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ igwe mmadụ niile na-abịakwute ya, ọmịiko ha mere ya, nʼihi na ha bụ ndị a na-esogbu. Ndị na-enweghị onye inyeaka. Ndị dị ka atụrụ na-enweghị onye na-azụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.36",
            "verseOrgIds": [
              "MAT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MAT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị ndị na-eso ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Owuwe ihe ubi hiri nne nʼezie. Ma ndị ọrụ dị ole na ole.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.37",
                "verseOrgIds": [
                  "MAT.9.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.37",
            "verseOrgIds": [
              "MAT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MAT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ya mere, rịọọnụ Onyenwe owuwe ihe ubi ka o zite ndị ọrụ nʼowuwe ihe ubi ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.9.38",
                "verseOrgIds": [
                  "MAT.9.38"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
