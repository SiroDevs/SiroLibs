  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "HOS 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HOS 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akaọrụ Ifrem bụ naanị ịchụso ikuku,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "ọ na-achụso ikuku si nʼọwụwa anyanwụ bido nʼụtụtụ ruo nʼabalị.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "Otu a ka ha si eme ka ịgha ụgha, na ime ihe ike na-abawanye ụba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "Ha na Asịrịa na-agbakwa ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:1"
      },
      "items": [
        {
          "text": "ha na-ebugakwa mmanụ nʼIjipt.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.12.2",
                "verseOrgIds": [
                  "HOS.12.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpọ Juda ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "Ọ ga-ata Jekọb",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        },
        {
          "text": "ahụhụ dịka ụzọ ya si dị,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:2"
      },
      "items": [
        {
          "text": "kwụghachikwa ya dịka omume ya si dị.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ nọ nʼafọ nne ya ka o jidere nwanne ya nwoke nʼikiri ụkwụ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:3"
      },
      "items": [
        {
          "text": "Mgbe ọ ghọrọ dimkpa, ya na Chineke gbara mgba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, ya na mmụọ ozi gbara mgba.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:4"
      },
      "items": [
        {
          "text": "Nʼoge ahụ, o jidesiri ya aka ike, kwaa akwa, rịọọ ngọzị site nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:4"
      },
      "items": [
        {
          "text": "Ọ hụrụ ya na Betel,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:4"
      },
      "items": [
        {
          "text": "gwaakwa ya okwu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.12.5",
                "verseOrgIds": [
                  "HOS.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.12.5",
                "verseOrgIds": [
                  "HOS.12.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịghaghị ịlọghachikwute Chineke gị,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:6"
      },
      "items": [
        {
          "text": "guzosie ike nʼịhụnanya na ikpe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:6"
      },
      "items": [
        {
          "text": "na-elekwa anya Chineke gị mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahịa na-eji ihe ọtụtụ aghụghọ na-erenye ndị mmadụ ahịa,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:7"
      },
      "items": [
        {
          "text": "ọ hụrụ imegbu emegbu nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifrem kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:8"
      },
      "items": [
        {
          "text": "\"Abaala m ọgaranya! Abụrụla m onye nwere akụnụba dị ukwuu!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:8"
      },
      "items": [
        {
          "text": "Ọ bụ ezie na m bụ onye nwere akụ dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:8"
      },
      "items": [
        {
          "text": "ma agaghị achọta njehie maọbụ mmehie ọbụla nʼime m.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HOS.12.9",
                "verseOrgIds": [
                  "HOS.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "na Chineke gị,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "onye si nʼIjipt kpọpụta unu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "Aga m emekwa ka ị biri nʼụlọ ikwu ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:9"
      },
      "items": [
        {
          "text": "dịka ọ dị nʼoge mmemme ndị ahụ niile a kara aka.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gwara m ndị amụma,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:10"
      },
      "items": [
        {
          "text": "ọ bụ m mere ka ha hụ ọhụ dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:10"
      },
      "items": [
        {
          "text": "sitekwa nʼọnụ ndị amụma tụọ ilu dị iche iche.\"",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gilead ọ na-eme ajọ ihe?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:11"
      },
      "items": [
        {
          "text": "Ndị ya bụ ndị efulefu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HOS 12:11"
      },
      "items": [
        {
          "text": "Ha na-achụ aja oke ehi dị iche iche na Gilgal?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HOS 12:11"
      },
      "items": [
        {
          "text": "Ebe ịchụ aja ha niile ga a dịka ebe a chịkọtara ukwu nkume,",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        }
      ]
    },
