  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "RUT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rut na Naomi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ndị ahụ, mgbe ndị ikpe na-achị, oke ụnwụ dara nʼala Izrel. Nʼihi ụnwụ a, otu nwoke, onye Betlehem, obodo dị na Juda, kwakọọrọ ihe ya niile, duru nwunye ya, na ụmụ ya ndị ikom abụọ, hapụ obodo ya gaa biri dịka ọbịa nʼala Moab.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.1",
            "verseOrgIds": [
              "RUT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nwoke a bụ Elimelek. Aha nwunye ya bụ Naomi, ma aha ụmụ ya ndị ikom abụọ bụ Mahlọn na Kilịọn. Ha bụ ndị Efrat",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        },
        {
          "text": "si Betlehem nke dị na Juda. Ha bịarutere nʼala Moab biri nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.2",
            "verseOrgIds": [
              "RUT.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Elimelek di Naomi nwụrụ, hapụ naanị Naomi, na ụmụ ya ndị ikom abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.3",
            "verseOrgIds": [
              "RUT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha lụrụ ndị nwunye site nʼetiti ndị inyom Moab. Aha nke mbụ bụ Ọpa, ebe aha nke abụọ bụ Rut. Ha biri nʼebe ahụ ihe dị ka afọ iri.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.4",
            "verseOrgIds": [
              "RUT.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mahlọn na Kilịọn mechara nwụọ. Ya mere, Naomi ghọrọ onye gba aka di, na onye gba aka ụmụ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.5",
            "verseOrgIds": [
              "RUT.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Naomi na Rut alaghachi nʼobodo Betlehem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Naomi nọ nʼala Moab nụ na",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.6",
                "verseOrgIds": [
                  "RUT.1.6"
                ]
              }
            }
          ]
        },
        {
          "text": "eletala ndị Izrel site nʼinye ha ihe oriri, Naomi na ndị nwunye ụmụ ya abụọ kwadoro ịlaghachi azụ nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.6",
            "verseOrgIds": [
              "RUT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Naomi na ndị nwunye ụmụ ya abụọ hapụrụ ala Moab ebe ha bi kemgbe, malite ịgbaso ụzọ ha ga-esi laghachi nʼala Juda.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.7",
            "verseOrgIds": [
              "RUT.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Naomi gwara ndị nwunye ụmụ ya abụọ okwu sị ha, \"Ngwa, onye ọbụla nʼime unu laghachi nʼụlọ nne ya.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.8",
                "verseOrgIds": [
                  "RUT.1.8"
                ]
              }
            }
          ]
        },
        {
          "text": "gosi unu obiọma dịka unu si gosi mụ onwe m, na ndị unu nwụrụ anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.8",
            "verseOrgIds": [
              "RUT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.9",
                "verseOrgIds": [
                  "RUT.1.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nyekwa unu di ọzọ ma meekwa ka unu chọta udo nʼezinaụlọ ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 1:9"
      },
      "items": [
        {
          "text": "Mgbe ahụ Naomi suturu ha ọnụ, ha niile kwara akwa.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.9",
            "verseOrgIds": [
              "RUT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ọpa na Rut zara Naomi sị ya, \"E, anyị agaghị ala. Anyị ga-esoro gị laghachikwuru ndị gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.10",
            "verseOrgIds": [
              "RUT.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi zara sị ha, \"Laghachinụ ụmụ m, ọ bụ nʼihi gịnị ka unu ga-eji soro m laa? E nwere m ike ịmụta ụmụ ndị ikom ọzọ ndị ga-abụ di unu?",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.11",
            "verseOrgIds": [
              "RUT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Laghachinụ azụ ụmụ m. Emeela m agadi ịlụ di ọzọ. A sịkwarị na olileanya fọdụụrụ m ịlụ di na ịmụta ụmụ ndị ikom nʼabalị taa,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.12",
            "verseOrgIds": [
              "RUT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "unu ga-echere ruo mgbe ha tolitere? Unu ga-anọ na-alụghị di ọzọ? Mba, ụmụ m ndị inyom, ọnọdụ m dị ilu karịa nke unu, nʼihi",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "text": "na",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.13",
                "verseOrgIds": [
                  "RUT.1.13"
                ]
              }
            }
          ]
        },
        {
          "text": "esepụtala aka ya imegide m.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.13",
            "verseOrgIds": [
              "RUT.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha welitere olu ha kwaa akwa ọzọ. Mgbe ahụ Ọpa suturu nne di ya ọnụ ma Rut kwusịrị ike nʼebe ọ nọ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.14",
            "verseOrgIds": [
              "RUT.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Naomi gwara ya sị, \"Lee, nwunye nwanne di gị alaghachikwurula ndị nwe ya na chi ya niile, soro ya laa.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.15",
            "verseOrgIds": [
              "RUT.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Rut zara, \"Akwagidela m ka m hapụ gị, maọbụ ime ka m site nʼiso gị chigharịa. Aga m esoro gị gaa ebe ọbụla ị na-aga. Aga m esokwa gị biri nʼebe ọbụla ị ga-ebi; ndị gị ga-abụ ndị m, Chineke gị ga-abụkwa Chineke m,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.16",
            "verseOrgIds": [
              "RUT.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebe ị nwụrụ ka m ga-anwụ, ebe ahụ kwa ka a ga-eli m. Ka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.17",
                "verseOrgIds": [
                  "RUT.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "mesoo m mmeso, otu ọbụla mmeso ahụ si dị njọ, ma ọ bụrụ na m ekwere ka ihe ọzọ, ma ọ bụghị ọnwụ, kewaa mụ na gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.17",
            "verseOrgIds": [
              "RUT.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Naomi hụrụ na Rut ekpebiela nʼime onwe ya iso ya, ọ kwụsịrị ịgwa ya okwu ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.18",
            "verseOrgIds": [
              "RUT.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha abụọ gagidere ije rute Betlehem. Mgbe ha batara Betlehem, obodo ahụ mere mkpọtụ, nʼihi nlọta ha. Ndị inyom jụrụ sị, \"Ọ bụ Naomi bụ nke a nʼezie?\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.19",
            "verseOrgIds": [
              "RUT.1.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Naomi zara ha sị, \"Unu akpọkwala m Naomi, kama kpọọnụ m Mara, nʼihi na Onye pụrụ ime ihe niile emeela ka ndụ m jupụta nʼihe ilu.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.20",
            "verseOrgIds": [
              "RUT.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka m juru eju mgbe m si nʼebe a pụọ, ma",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
            "verseOrgIds": [
              "RUT.1.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.1.21",
                "verseOrgIds": [
                  "RUT.1.21"
                ]
              }
            }
          ]
        },
        {
          "text": "emeela ka m gbara aka lọta. Gịnị mere unu ji akpọ m Naomi ebe ọ bụ na",
          "type": "text",
          "attrs": {
            "verseId": "RUT.1.21",
