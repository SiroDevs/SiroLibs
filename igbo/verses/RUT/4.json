  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "RUT 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Boaz alụọ Rut",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Boaz pụrụ gaa nʼọnụ ụzọ ama obodo ahụ, nọdụ ala nʼebe ahụ. Ọ dịghị anya onye mgbapụta ahụ dị nso nke Boaz kwuru okwu banyere ya si nʼebe ahụ na-agafe. Boaz kpọrọ ya sị, \"Enyi m bịa nọdụ ala.\" Ọ bịara nọdụ ala.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.1",
            "verseOrgIds": [
              "RUT.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boaz kpọrọ mmadụ iri, ndị bụ ndị okenye obodo ahụ, gwa ha, \"Nọdụnụ ala nʼebe a.\" Ha mere otu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwara nwoke onye mgbapụta ahụ dị nso sị, \"Naomi, onye si nʼala ndị Moab lọta, na-achọ ire ala nwanna anyị nwoke Elimelek.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m na o kwesiri ka m buru ụzọ gwa gị ka ị zụọ ya nʼihu ndị a nọ ọdụ nʼebe a, na nʼihu ndị okenye obodo anyị. Ọ bụrụ na ị ga-agbara ya, gwa m, ọ bụrụkwanụ na ị gaghị agbara ya, gwa m, ka m mara ihe m ga-eme. Nʼihi na ọ bụ gị ka ọ dịrị ịgbapụta ya. Mụ onwe m na-esote gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "RUT 4:4"
      },
      "items": [
        {
          "text": "Ọ zara sị, \"Aga m agbapụta ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Boaz sịrị, \"Nʼụbọchị ị ga-azụrụ ala ahụ site nʼaka Naomi ka ị ga-enwetakwa Rut onye Moab bụ nwunye onye ahụ nwụrụ anwụ, ime ka aha onye ahụ nwụrụ anwụ na ihe nketa ya na-adịgide.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na nke a, onye nchekwa mgbapụta ahụ sịrị, \"Apụghị m ịgbapụta ya nʼihi na e nwere m ike itinye ihe nketa m na nsogbu. Gị onwe gị gbapụta ya. Nke a agaghị ekwe m omume.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mgbe ochie nʼala Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "text": "ime ka mgbapụta ihe na iwefe ihe site nʼaka baa nʼaka zuo oke, otu onye ga-eyipụ akpụkpọụkwụ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "text": "ya were ya nye onye nke ọzọ. Otu a ka e si ekpebi okwu gbasara orire na ọzụzụ, na-ime ka ihe ndị ọzọ guzosie ike nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, mgbe nwoke ahụ gwara Boaz sị ya, \"Zụrụ ala ahụ nʼonwe gị,\" o yipụtara akpụkpọụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Boaz kwupụtara na ntị ndị okenye ndị ahụ na ndị mmadụ nọ nʼebe ahụ sị ha, \"Unu bụ ndị akaebe na esitela m nʼaka Naomi zụrụ ala niile Elimelek, na Kilịọn na Mahlọn nwere.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.9",
            "verseOrgIds": [
              "RUT.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụrụkwala m Rut onye Moab, nwunye Mahlọn ka ọ bụrụ nwunye m, ime ka aha onye nwụrụ anwụ na ihe nketa ya na-adịgide, ka aha ha hapụ ifu nʼetiti ndị ikwu ya maọbụ site nʼobodo ebe amụrụ ya. Taa unu niile bụ ndị akaebe m.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.10",
            "verseOrgIds": [
              "RUT.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị okenye na ndị niile nọ nʼọnụ ụzọ ama kwuru sị, \"Anyị bụ ndị akaebe. Ka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.4.11",
                "verseOrgIds": [
                  "RUT.4.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mee nwanyị a na-abata nʼezinaụlọ gị ka ọ dịrị ka Rechel na Lịa,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "text": "ndị ebo Izrel niile sitere na ha pụta! Ka ị bụrụkwa ọgaranya nʼagbụrụ Efrata, ghọọkwa onye a ma ama na Betlehem.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.11",
            "verseOrgIds": [
              "RUT.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụmụ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.4.12",
                "verseOrgIds": [
                  "RUT.4.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enye gị site na nwanyị a, ka ezinaụlọ gị dịrị ka nke Perez",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        },
        {
          "text": "onye Tama mụụrụ Juda.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.12",
            "verseOrgIds": [
              "RUT.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nwa nwoke a mụtara Naomi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boaz kpọọrọ Rut ka ọ bụrụ nwunye ya. Mgbe ya na Rut dinakọrọ,",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.4.13",
                "verseOrgIds": [
                  "RUT.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nyeere ya aka ịtụrụ ime. Ọ mụkwara nwa nwoke.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.13",
            "verseOrgIds": [
              "RUT.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị inyom obodo ahụ bịakwutere Naomi sị ya, \"Onye a gọziri agọzi ka",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "RUT.4.14",
                "verseOrgIds": [
                  "RUT.4.14"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ, onye na-agbawaghị gị aka onye agbụrụ mgbapụta dị nso. Ka aha ya bụrụ ihe ga-ada ụda nʼala Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.14",
            "verseOrgIds": [
              "RUT.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya wetakwara gị ntute na ndụ gị ma bụrụkwa onye ga-azụ gị nʼisi awọ gị. Nʼihi na nwunye nwa gị, onye hụrụ gị nʼanya, onye baara gị uru karịa ndị ikom asaa, amụọrala gị nwa nwoke.\"",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi kuuru nwantakịrị ahụ, jikụọ ya nʼapata ya, lekọtaa ya.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị inyom ndị agbataobi ya sịrị, \"Ugbu a, nʼikpeazụ, Naomi enwetala nwa nwoke ọzọ!\" Ha gụrụ ya Obed. Ọ bụkwa onye ahụ bụ nna Jesi, onye bụ nna Devid.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.17",
            "verseOrgIds": [
              "RUT.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro ọmụmụ Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ usoro ndị a mụrụ site na Perez.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "RUT 4:18"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:18"
      },
      "items": [
        {
          "text": "Perez mụrụ Hezrọn",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
              "RUT.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezrọn mụrụ Ram",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "RUT 4:19"
      },
      "items": [
        {
          "text": "Ram mụrụ Aminadab",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
              "RUT.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
