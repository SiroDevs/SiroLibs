  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "MRK 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbilite nʼọnwụ Jisọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị izuike gafere, Meri Magdalin na Meri nne Jemis na Salomi zụtara ụda dị iche iche ha ga-eji tee ahụ ya mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.1",
            "verseOrgIds": [
              "MRK.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ ụbọchị mbụ nke izu, mgbe anyanwụ wara, ha biliri gawa nʼili ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.2",
            "verseOrgIds": [
              "MRK.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jụrịtara onwe ha na-asị, \"Onye ga-enupuru anyị nkume ahụ dị nʼọnụ ụzọ ili ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.3",
            "verseOrgIds": [
              "MRK.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha leliri anya, ha hụrụ na e nupụla nkume ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.4",
            "verseOrgIds": [
              "MRK.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha banyere nʼime ili ahụ, ha hụrụ otu nwokorobịa yi uwe ọcha ka ọ nọdụrụ ala nʼakụkụ aka nri nke ili ahụ. Ha tụrụ oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.5",
            "verseOrgIds": [
              "MRK.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ sịrị ha, \"Unu atụla egwu. Unu na-achọ Jisọs onye Nazaret a kpọgidere nʼobe. E meela ka o site nʼọnwụ bilie! Ọ nọkwaghị nʼebe a. Lee ebe e nibere ya.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.6",
            "verseOrgIds": [
              "MRK.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gaanụ gwa ndị na-eso ụzọ ya nakwa Pita, 'O burula unu ụzọ gawa Galili. Ebe ahụ ka unu ga-ahụ ya dị ka ọ gwararịị unu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.7",
            "verseOrgIds": [
              "MRK.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gbapụtara site nʼili ahụ, nʼọnọdụ mgbagwoju anya na ahụ ịma jijiji. Ha akọrọghị onye ọbụla ihe ọbụla, nʼihi na egwu jupụtara ha obi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.8",
            "verseOrgIds": [
              "MRK.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "iex"
      },
      "items": [
        {
          "text": "[Ọtụtụ akwụkwọ mbụ na ụfọdụ ndị mgbe ochie enweghị amaokwu itoolu ruo na nke iri abụọ 9–20.]",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Mgbe Jisọs biliri nʼọnwụ nʼisi ụtụtụ nʼụbọchị mbụ nke izu, onye mbụ o gosiri onwe ya bụ Meri Magdalin, onye ahụ o siri nʼahụ ya chụpụ mmụọ ọjọọ asaa.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.9",
                "verseOrgIds": [
                  "MRK.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Ọ lara gaa kọrọ ndị ya na ha na-anọ na mbụ, bụ ndị nọrịị na-ebe akwa ma na-erukwa ụjụ.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.10",
                "verseOrgIds": [
                  "MRK.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Mgbe ha nụrụ na ọ dị ndụ, na ọ hụkwala ya, ha ekweghị.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.11",
                "verseOrgIds": [
                  "MRK.16.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Mgbe ihe ndị a gasịrị, o gosiri mmadụ abụọ nʼime ha onwe ya nʼụdị ọzọ, mgbe ha na-abanye nʼime obodo.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.12",
                "verseOrgIds": [
                  "MRK.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Ndị a laghachiri bịa kọọrọ ndị nke ọzọ ma ha ekwetakwaghị.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.13",
                "verseOrgIds": [
                  "MRK.16.13"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Emesịa, Jisọs gosiri ndị na-eso ụzọ ya iri na otu ahụ onwe ya, mgbe ha nọkọrọ na-eri nri. Ọ baara ha mba nʼihi enweghị okwukwe ha nakwa mkpọchi obi ha, nʼihi na ha jụrụ ikwenye nʼihe ndị ọzọ hụrụ ya gwara ha mgbe e mesịrị ka ọ si nʼọnwụ bilite.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.14",
                "verseOrgIds": [
                  "MRK.16.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Ọ gwara ha sị,",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.15",
                "verseOrgIds": [
                  "MRK.16.15"
                ]
              }
            },
            {
              "name": "char",
              "type": "tag",
              "attrs": {
                "style": "wj"
              },
              "items": [
                {
                  "text": "\"Gaanụ nʼime ụwa niile kwusaara ihe niile e kere eke oziọma.",
                  "type": "text",
                  "attrs": {
                    "verseId": "MRK.16.15",
                    "verseOrgIds": [
                      "MRK.16.15"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "name": "char",
              "type": "tag",
              "attrs": {
                "style": "wj"
              },
              "items": [
                {
                  "text": "Onye ọbụla kweerenụ na onye e mekwara baptizim ka a ga-azọpụta. Ma a ga-ama onye ọbụla na-ekwereghị ikpe.",
                  "type": "text",
                  "attrs": {
                    "verseId": "MRK.16.16",
                    "verseOrgIds": [
                      "MRK.16.16"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.16",
            "verseOrgIds": [
              "MRK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "name": "char",
              "type": "tag",
              "attrs": {
                "style": "wj"
              },
              "items": [
                {
                  "text": "Ihe ịrịbama ndị a ga-esokwa ndị kwerenụ. Site nʼaha m, ha ga-achụpụ mmụọ ọjọọ; kwuokwa okwu nʼasụsụ ọhụrụ dị iche iche.",
                  "type": "text",
                  "attrs": {
                    "verseId": "MRK.16.17",
                    "verseOrgIds": [
                      "MRK.16.17"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
            "verseOrgIds": [
              "MRK.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "name": "char",
              "type": "tag",
              "attrs": {
                "style": "wj"
              },
              "items": [
                {
                  "text": "Ha ga-eji aka ha abụọ atụtụlie agwọ, ṅụọkwa nsi ma ọ gaghị emerụ ha ahụ ma otu. Ha ga-ebikwasị ndị ọrịa aka, ahụ ga-adịkwa ha mma.\"",
                  "type": "text",
                  "attrs": {
                    "verseId": "MRK.16.18",
                    "verseOrgIds": [
                      "MRK.16.18"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Mgbe Onyenwe anyị Jisọs gwasịrị ha okwu ndị a, e weliri ya elu, baa nʼeluigwe, ebe ọ nọdụ ala nʼakụkụ aka nri Chineke.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.19",
                "verseOrgIds": [
                  "MRK.16.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.19",
            "verseOrgIds": [
              "MRK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "it"
          },
          "items": [
            {
              "text": "Ha pụrụ kwusaa oziọma nʼebe niile. Onyenwe anyị nọnyekwaara ha, mee ka okwu ya guzosie ike site nʼihe ịrịbama dị iche iche nke na-eso ya.",
              "type": "text",
              "attrs": {
                "verseId": "MRK.16.20",
                "verseOrgIds": [
                  "MRK.16.20"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
