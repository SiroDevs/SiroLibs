  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "2CO 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl, onyeozi nke Jisọs Kraịst dịka ọchịchọ nke Chineke si dị, na Timoti nwanne anyị nwoke,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2CO 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CO 1:1"
      },
      "items": [
        {
          "text": "Na-edegara chọọchị Chineke nke dị na Kọrint, na ndị nsọ niile ndị nọ nʼala Akaịa akwụkwọ:",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.1",
            "verseOrgIds": [
              "2CO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka amara na udo nke sitere na Chineke Nna anyị, na Onyenwe anyị Jisọs Kraịst dịrị unu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.2",
            "verseOrgIds": [
              "2CO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekele dịrị Chineke onye nkasiobi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otuto dịrị Chineke na Nna nke Onyenwe anyị Jisọs Kraịst, bụ Nna nke obi ebere, nakwa Chineke nke nkasiobi niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.3",
            "verseOrgIds": [
              "2CO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-akasị anyị obi nʼime nsogbu anyị niile, ka anyị site nʼụzọ dị otu a nwee ike ịkasị ndị ọzọ niile nọ na nsogbu dị iche iche obi. Inyere ha aka dịka anyị onwe anyị si nata inyeaka site nʼaka Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.4",
            "verseOrgIds": [
              "2CO.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na dịka anyị si eketa oke nʼime ọtụtụ ahụhụ nke Kraịst, otu a nkasiobi anyị na-ababiga ụba site na Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.5",
            "verseOrgIds": [
              "2CO.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na anyị na-ahụ ahụhụ, ọ bụ nʼihi na nkasiobi unu, nakwa nzọpụta unu. Ọ bụrụkwa na a na-akasị anyị obi, ọ bụkwa nʼihi nkasiobi unu, nke na-arụpụta ike na ume iji ntachiobi die ụdị ahụhụ nke anyị onwe anyị na-edikwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.6",
            "verseOrgIds": [
              "2CO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olileanya anyị nwere nʼebe unu nọ sịrị ike, ebe anyị maara na dịka unu si eketa oke nʼịta ahụhụ anyị, otu ahụkwa ka unu ga-esi keta oke na nkasiobi ahụ anyị na-anata.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.7",
            "verseOrgIds": [
              "2CO.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị chọrọ ka unu mara ụmụnna m, ihe banyere nsogbu e sogburu anyị nʼEshịa. Nʼezie, nsogbu ahụ karịrị anyị ike, mee ka anyị hapụ inwekwa olileanya na anyị ga-emesi dịrị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.8",
            "verseOrgIds": [
              "2CO.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, ọ dị nnọọ nʼoge ahụ, dịka a ga-asị na a mara anyị ikpe ọnwụ. Ma anyị maara na o si otu a mee ka anyị nwee ike ịmụta na o kwesighị ka anyị tụkwasị obi nʼike nke aka anyị, kama ka anyị nwee olileanya nʼime Chineke, onye pụrụ ime ka ndị nwụrụ anwụ si nʼọnwụ bilie.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.9",
            "verseOrgIds": [
              "2CO.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ Chineke bụ onye zọpụtara anyị site nʼime oke ọnwụ dị otu a. Anyị nwekwara ntụkwasị obi na ọ ga-aga nʼihu na-azọpụtakwa anyị,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.10",
            "verseOrgIds": [
              "2CO.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka unu ga-enyekwara anyị aka site nʼekpere unu, ka ọtụtụ nwere ike nye ekele nʼihi anyị maka onyinye amara anyị natara na nzaghachi ekpere ọtụtụ mmadụ ndị a na-ekpere anyị.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.11",
            "verseOrgIds": [
              "2CO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgbanwe nzube Pọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịnya isi anyị bụ nke a, na akọnuche anyị na-agbara anyị akaebe na anyị kpara agwa ọma nʼụwa, karịchasịa nʼebe unu nọ, nʼịdị nsọ na izi ezi nke si nʼaka Chineke. Nke a bụ site nʼamara o nyere anyị, ọ bụghị site nʼamamihe nke mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.12",
            "verseOrgIds": [
              "2CO.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe anyị na-edere unu abụghị ihe unu na agaghị agụta maọbụ ghọta. Enwere m nchekwube na unu ga-aghọta ya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.13",
            "verseOrgIds": [
              "2CO.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka unu ghọtarala anyị nwa nke nta ugbu a, unu ga-eji anyị anya isi nʼụbọchị nke Onyenwe anyị Jisọs.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.14",
            "verseOrgIds": [
              "2CO.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe m na-ekwu were m anya, nke mere m ji chọọ ibu ụzọ bịa leta unu ka unu nwee uru abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.15",
            "verseOrgIds": [
              "2CO.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebu m ya nʼobi na m ga-akwụsị hụ unu mgbe m na-agafe ịga Masidonia. Ebukwa m ya nʼobi m na mgbe m si Masidonia na-alaghachi na m ga-akwụsịkwa ileta unu, ka unu nweekwa ike inyere anyị aka mgbe anyị bidoro ịlaghachi Judịa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.16",
            "verseOrgIds": [
              "2CO.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere m obi abụọ mgbe m chọrọ ime nke a? Ana m ezube nzube m dịka mmadụ nkịtị, onye dị nkwadobe ikwu \"E,\" na \"E e,\" nʼotu oge ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.17",
            "verseOrgIds": [
              "2CO.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka Chineke si bụrụ onye kwesiri ntụkwasị obi, okwu anyị gwara unu abụghị \"E,\" na \"E e.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.18",
            "verseOrgIds": [
              "2CO.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CO 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Ọkpara Chineke, Jisọs Kraịst, onye e sitere nʼọnụ Saịlas na Timoti na mụ onwe m kwusaa abụghị \"E\" na \"E e,\" kama nʼime ya ọ bụ naanị \"E.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.19",
            "verseOrgIds": [
              "2CO.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CO 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime Kraịst ka anyị hụrụ \"E\" na nkwa niile nke Chineke kwere ụmụ mmadụ. Nke a mere anyị ji site na ya kwee \"Amen\" nʼinye Chineke otuto.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.20",
            "verseOrgIds": [
              "2CO.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CO 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ Chineke nʼonwe ya mere ka anyị na unu guzosie ike nʼime Kraịst. O meela ka anyị bụrụ ndị e tere mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.21",
            "verseOrgIds": [
              "2CO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kara anyị akara nʼihu, nyekwa anyị Mmụọ Nsọ ya ka o biri nʼobi anyị, dịka onye ga-ahụ na anyị ga-emezu nkwa ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.22",
            "verseOrgIds": [
              "2CO.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CO 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m akpọku Chineke dịka onye akaebe m, ọ bụ nʼihi ịnapụta unu mere m ji hapụ ịbịa Kọrint.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.23",
            "verseOrgIds": [
              "2CO.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CO 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị na anyị bụ ndị ọchịchị nke okwukwe unu, kama anyị so unu na-arụkọ ọrụ ka unu nwe ọṅụ nʼihi na ọ bụ site nʼokwukwe ka unu ga-esi kwụrụ chịm.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.1.24",
            "verseOrgIds": [
              "2CO.1.24"
            ]
          }
        }
      ]
    }
  ],
