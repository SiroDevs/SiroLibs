{
  "id": "1CH.7",
  "number": "7",
  "bookId": "1CH",
  "reference": "1 Ihe E Mere 7",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "1CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Isaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka mụrụ ụmụ anọ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:1"
      },
      "items": [
        {
          "text": "Tola, na Pua, na Jashub, na Shịmrọn.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Tola ndị ghọrọ ndịisi ezi bụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:2"
      },
      "items": [
        {
          "text": "Uzi, na Refaya, na Jeriel, na Jamai, na Ibsam, na Samuel. Nʼoge Devid bụ eze, ọnụọgụgụ ndị agha sitere nʼetiti ha dị iri puku abụọ na abụọ, na narị isii. (22,600).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.2",
            "verseOrgIds": [
              "1CH.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzi mụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izrahaya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Izrahaya amụta ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:3"
      },
      "items": [
        {
          "text": "Maikel, Ọbadaya, Juel na Ishaya. Ha niile bụkwa ndịisi ikwu ha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.3",
            "verseOrgIds": [
              "1CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị bụ ndị agha nʼetiti ụmụ ụmụ ha nʼoge Devid bụ eze ruru iri puku atọ na isii (36,000), nʼihi na ha niile lụrụ ọtụtụ ndị inyom, mụọ ọtụtụ ụmụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.4",
            "verseOrgIds": [
              "1CH.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụnne ha bụ ndị na-alụ agha bụ ndị agbụrụ Isaka dị iri puku asatọ na asaa (87,000) nʼọnụọgụgụ, dịka e depụtara aha ha nʼakwụkwọ usoro ọmụmụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Benjamin",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benjamin mụrụ ndị ikom atọ:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:6"
      },
      "items": [
        {
          "text": "Bela, Beka na Jediael,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.6",
            "verseOrgIds": [
              "1CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela mụrụ ụmụ ise:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:7"
      },
      "items": [
        {
          "text": "Ezbon, Uzi, Uziel, Jerimot na Iri. Ha niile bụ ndịisi ezi. Ọnụọgụgụ ndị agha ha dị iri puku abụọ na abụọ na iri atọ na anọ (22,034). E dekwara aha ndị a niile nʼakwụkwọ usoro ọmụmụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.7",
            "verseOrgIds": [
              "1CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Beka mụrụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:8"
      },
      "items": [
        {
          "text": "Zemira, Joash, Elieza, Elioenai, Omri, Jeremot, Abija, Anatot na Alemet.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.8",
            "verseOrgIds": [
              "1CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwụkwọ ebe e dere usoro ọmụmụ ha depụtara aha ndịisi ezinaụlọ, na iri puku ndị agha abụọ na narị abụọ (20,200).",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.9",
            "verseOrgIds": [
              "1CH.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jediael mụrụ otu nwa nwoke:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "aha ya bụ Bilhan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Ụmụ Bilhan bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:10"
      },
      "items": [
        {
          "text": "Jeush, Benjamin, Ehud, Kenaana, Zetan, Tashish na Ahishaha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.10",
            "verseOrgIds": [
              "1CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Jediael ndị a bụ ndịisi ezinaụlọ. E nwere nʼetiti ha ndị agha ọnụọgụgụ ha dị puku iri na asaa na narị abụọ (17,200), ndị nọ na njikere ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.11",
            "verseOrgIds": [
              "1CH.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Shupim na ndị Hupim bụ ụmụ ụmụ Er ebe ndị Hushim bụ ụmụ ụmụ Aha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.12",
            "verseOrgIds": [
              "1CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Naftalị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Naftalị mụtara bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:13"
      },
      "items": [
        {
          "text": "Jaziel, Guni, Jeza na Shalum bụ ụmụ Bilha.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.13",
            "verseOrgIds": [
              "1CH.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Manase:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:14"
      },
      "items": [
        {
          "text": "Asriel, onye iko ya nwanyị bụ onye Aram mụtara, na Makia. Makia bụ nna Gilead.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.14",
            "verseOrgIds": [
              "1CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makia sitere nʼetiti ndị Hupim na Shupim lụọ nwunye. Aha nwanne ya nwanyị bụ Maaka. Otu onye ọzọ si nʼagbụrụ Manase bụ Zelofehad, onye mụtara naanị ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.15",
            "verseOrgIds": [
              "1CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maaka nwunye Makia mụtara otu nwa nwoke ọ gụrụ Peresh. Aha nwanne ya bụ Sheresh, onye mụtara Ụlam na Rakem.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.16",
            "verseOrgIds": [
              "1CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa nwoke Ụlam mụtara",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "bụ Bedan.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 7:17"
      },
      "items": [
        {
          "text": "Ndị a bụ ụmụ Gilead, nwa nwa Makia, nwa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.17",
            "verseOrgIds": [
              "1CH.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamoleket, nwanne nwanyị Makia mụrụ Ishod, Abieza na Mahla.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.18",
            "verseOrgIds": [
              "1CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemida mụrụ ụmụ ikom ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:19"
      },
      "items": [
        {
          "text": "Ahian, Shekem, Liiki na Aniam.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.19",
            "verseOrgIds": [
              "1CH.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Ifrem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Ifrem bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Shutela, Bered,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Tahat, Eleada,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:20"
      },
      "items": [
        {
          "text": "Tahat",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.20",
            "verseOrgIds": [
              "1CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Zabad nwa ya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "na Shutela nwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:21"
      },
      "items": [
        {
          "text": "Eza na Elead bụ ndị gara ịchịkọrọ anụ ụlọ ndị Gat, ndị ikom nwe obodo ahụ jidere ha gbuo ha nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.21",
            "verseOrgIds": [
              "1CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifrem nna ha ruru ụjụ nke ukwuu nʼihi ọnwụ ha, ma ụmụnna ya kasịrị ya obi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwunye ya mụrụ nwa nwoke ọzọ, ọ kpọrọ aha ya Beriya, nke pụtara, Ihe ndaba ọjọọ, nʼihi ọnwụ Elead na Eza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha nwa Ifrem nke nwanyị bụ Sheera. Sheera bụ onye wuru akụkụ ugwu na ndịda Bet-Horon, wuokwa Uzen-Sheera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
            "verseOrgIds": [
              "1CH.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụkwa ụmụ Ifrem: Refa, nna Reshef,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:25"
      },
      "items": [
        {
          "text": "onye bụ nna Tela. Tela bụ nna Tahan,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.25",
            "verseOrgIds": [
              "1CH.7.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye bụ nna Ladan, Ladan bụ nna Amihud,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:26"
      },
      "items": [
        {
          "text": "onye bụ nna Elishama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.26",
            "verseOrgIds": [
              "1CH.7.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elishama bụ nna Nun,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:27"
      },
      "items": [
        {
          "text": "onye bụ nna Joshua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betel na obodo ndị ọzọ gbara ya gburugburu, ya bụ Naaran, nʼakụkụ ọwụwa anyanwụ, na Gaza na obodo nta ya, ndị dị nʼọdịda anyanwụ, na Shekem, na obodo ndị ọzọ, tutu ruo Aya, na obodo nta ya niile, so nʼala ha.",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Manase, nwa Josef, nwa nwa Izrel, bikwa nʼobodo ndị a dị nʼoke ala ha: Bet-Shan, na Teanak, na Megido, na Doa, tinyere obodo nta ha niile.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ ụmụ Asha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 7:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asha mụrụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:30"
      },
      "items": [
        {
          "text": "Imna, Ishva, Ishvi na Beriya. Nwa ya nwanyị bụ Sera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.30",
            "verseOrgIds": [
              "1CH.7.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 7:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beriya amụta ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:31"
      },
      "items": [
        {
          "text": "Heba na Malkiel, onye bụ nna Biazait.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.31",
            "verseOrgIds": [
              "1CH.7.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heba bụ onye mụrụ Jaflet, Shoma na Hotam. Nwanne ha nwanyị bụ Shua.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.32",
            "verseOrgIds": [
              "1CH.7.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 7:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Jaflet mụrụ bụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:33"
      },
      "items": [
        {
          "text": "Pasak, Bimhal na Ashvat.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.33",
            "verseOrgIds": [
              "1CH.7.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "1CH 7:33"
      },
      "items": [
        {
          "text": "Ndị a bụ ụmụ Jaflet.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1CH 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shoma amụọ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:34"
      },
      "items": [
        {
          "text": "Ahi, Roga, Huba na Aram.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.34",
            "verseOrgIds": [
              "1CH.7.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1CH 7:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanne ya nwoke Helem mụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:35"
      },
      "items": [
        {
          "text": "Zofa, Imana, Shelesh na Amal.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.35",
            "verseOrgIds": [
              "1CH.7.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1CH 7:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zofa amụta ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:36"
      },
      "items": [
        {
          "text": "Sua, Hanefa, Shual, Beri, Imra,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.36",
            "verseOrgIds": [
              "1CH.7.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1CH 7:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beza, Hod, Shama, Shilsha, Itran na Beera.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.37",
            "verseOrgIds": [
              "1CH.7.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1CH 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeta mụtara",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:38"
      },
      "items": [
        {
          "text": "Jefune, Pispa na Ara.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.38",
            "verseOrgIds": [
              "1CH.7.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CH 7:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụla amụta",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 7:39"
      },
      "items": [
        {
          "text": "Ara, Haniel na Rizia.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.39",
            "verseOrgIds": [
              "1CH.7.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CH 7:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ụmụ Asha ndị a niile bụ ndịisi ezi, ndị a sara anya na mmiri họpụta, ndị bụ dimkpa nʼagha, ndị ndu a ma ama. Ọnụọgụgụ ndị ha tozuru ije agha dị puku iri abụọ na isii (26,000), ndị e depụtara aha ha nʼakwụkwọ usoro ọmụmụ.",
