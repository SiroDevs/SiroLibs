      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:15"
      },
      "items": [
        {
          "text": "ndị nwere ụkwụ ọsọ agaghị enwekwa ike ịgba ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:15"
      },
      "items": [
        {
          "text": "Ọ bụladị onye ịgba ịnyịnya doro anya agakwaghị enwe ike ịgbanarị ihe mberede nke ga-abịakwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        }
      ]
    },
    {
