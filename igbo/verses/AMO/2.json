      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:11"
      },
      "items": [
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.11",
                "verseOrgIds": [
                  "AMO.2.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        }
