          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị obi siri ike nʼetiti ndị dike unu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.16",
            "verseOrgIds": [
              "AMO.2.16"
            ]
          }
        }
      ]
    },
