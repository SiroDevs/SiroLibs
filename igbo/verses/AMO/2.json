      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:10"
      },
      "items": [
        {
          "text": "ime ka unu nweta ala ndị Amọrait.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        }
      ]
    },
