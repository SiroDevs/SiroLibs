      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:10"
      },
      "items": [
        {
          "text": "duru unu gafee nʼọzara iri afọ anọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        }
      ]
    },
