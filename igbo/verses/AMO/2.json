      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:16"
      },
      "items": [
        {
          "text": "ga-agbara ọtọ gbapụ ọsọ nʼụbọchị ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.16",
            "verseOrgIds": [
              "AMO.2.16"
            ]
          }
        }
