      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.1",
                "verseOrgIds": [
                  "AMO.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "\"Nʼihi njehie atọ nke Moab,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "e, nʼihi nke anọ, agaghị m ahapụ inye ya ntaramahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "Nʼihi na ha surere ọkpụkpụ eze ndị Edọm ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:1"
      },
      "items": [
        {
          "text": "mee ha ka ha ghọọ ntụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, aga m ezite ọkụ na Moab,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "nke ga-erepịa ebe niile e wusiri ike nke Keriọt.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "Moab ga-anwụ nʼime ọgbaaghara,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:2"
      },
      "items": [
        {
          "text": "nʼetiti mkpu agha, na ụda opi ike.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ala onyeisi ọchịchị ya nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:3"
      },
      "items": [
        {
          "text": "gbukwaa ndị ozi niile nọ nʼokpuru ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:3"
      },
      "items": [
        {
          "text": "Ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.3",
                "verseOrgIds": [
                  "AMO.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.4",
                "verseOrgIds": [
                  "AMO.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "\"Nʼihi njehie atọ nke Juda,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "e, nʼihi nke anọ, agaghị m ahapụ inye ya ntaramahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "Nʼihi na ha ajụla iwu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.4",
                "verseOrgIds": [
                  "AMO.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "Ha ajụkwala irube isi ha nʼụkpụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "Ha abụrụla ndị e ji okwu ụgha duhie,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:4"
      },
      "items": [
        {
          "text": "bụ okwu ụgha ndị ahụ nna nna ha gbasoro.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, aga m esunye ọkụ na Juda,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:5"
      },
      "items": [
        {
          "text": "ọ ga-erepịa ebe niile e wusiri ike nke Jerusalem.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ọmụma dịrị Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.2.6",
                "verseOrgIds": [
                  "AMO.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "\"Nʼihi njehie atọ nke Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "e, nʼihi nke anọ, agaghị m ahapụ inye ya ntaramahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "Ha na-ere ndị ezi omume nʼihi ọlaọcha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:6"
      },
      "items": [
        {
          "text": "reekwa ụmụ ogbenye nʼọnụ ahịa e ji azụ akpụkpọụkwụ abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-azọpịa isi ndị ike na-adịghị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "na-echi ha ọnụ nʼaja,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "na-ewezuga ndị dị umeala nʼụzọ ezi ihe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "Nwoke na nna ya na-edinakwuru otu nwaagbọghọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:7"
      },
      "items": [
        {
          "text": "si otu a merụọ aha nsọ m.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-edina nʼakụkụ ebe ịchụ aja ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "nʼelu uwe ndị anatara na mbe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "Nʼime ụlọnsọ chi ha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:8"
      },
      "items": [
        {
          "text": "ha na-aṅụ mmanya ha natara dịka ihe nra.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma a lara m ndị Amọrait nʼiyi nʼihu ha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:9"
      },
      "items": [
        {
          "text": "ndị ahụ dị ogologo dịka osisi sida,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:9"
      },
      "items": [
        {
          "text": "ndị sikwara ike dịka osisi ook.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:9"
      },
      "items": [
        {
          "text": "Alara m mkpụrụ ha dị nʼelu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:9"
      },
      "items": [
        {
          "text": "na mgbọrọgwụ ha niile dị nʼokpuru nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esitere m nʼala Ijipt kpọpụta unu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        }
