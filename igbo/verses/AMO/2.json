            "number": "12",
            "style": "v",
            "sid": "AMO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma unu mere",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        },
        {
          "text": "ka ndị Nazirait ahụ ṅụọ mmanya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:12"
      },
      "items": [
        {
          "text": "Unu nyekwara ndị amụma iwu ka ha kwụsị ibu amụma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        }
      ]
    },
