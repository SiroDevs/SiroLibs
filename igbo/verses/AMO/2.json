      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:14"
      },
      "items": [
        {
          "text": "ndị bụ dike nʼagha agaghị azọpụta onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        }
