          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịgba ọsọ agaghị azọpụta ọ bụladị ndị dị nwe ụkwụ ọsọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        }
      ]
    },
