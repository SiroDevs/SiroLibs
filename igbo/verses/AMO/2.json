              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-agba ụta agaghị agbata ihe ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        }
