      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:14"
      },
      "items": [
        {
          "text": "ndị dị ike agaghị agba onwe ha ume,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        }
