          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, aga m abịada unu nʼala nʼọnọdụ unu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:13"
      },
      "items": [
        {
          "text": "dịka ụgbọala nke e bujuru ukwu ọka si abịada.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
