          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ahọpụtara m ụmụ unu ụfọdụ ka ha bụrụ ndị amụma,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 2:11"
      },
      "items": [
        {
          "text": "họpụtakwa ụfọdụ ndị okorobịa unu ka ha bụrụ Nazirait.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 2:11"
      },
      "items": [
        {
          "text": "Unu ndị Izrel, unu ga-agọ na nke a abụghị eziokwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        }
      ]
    },
