  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "1KI 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ben-Hadad ebuso Sameria agha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, Ben-Hadad, bụ eze ndị Aram, chịkọtara ndị agha ya niile. Iri ndị eze atọ na abụọ sonyere ya, ha na ịnyịnya ha na ụgbọ agha ha. Ọ rịgooro nọchibido obodo Sameria buso ya agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.1",
            "verseOrgIds": [
              "1KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze ndị Siria zigaara Ehab, eze Izrel ozi nʼime obodo sị ya, \"otu a ka Ben-Hadad sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.2",
            "verseOrgIds": [
              "1KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ọlaọcha na ọlaedo gị, nkem ka ha bụ, ndị nwunye gị na ụmụ gị, bụ ndị dị mma karịsịa nke m ka ha bụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.3",
            "verseOrgIds": [
              "1KI.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehab eze Izrel, zighachiri ozi sị, \"Ọ dị mma, onyenwe m, mụ onwe m, na ihe niile m nwere bụ nke gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.4",
            "verseOrgIds": [
              "1KI.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa ndị ozi Ben-Hadad bịaghachiri zie Ehab ozi ọzọ sị ya, \"Otu a ka Ben-Hadad sịrị, 'Ọ bụ ezie na m ziteere gị ozi, sị, ọlaọcha gị na ọlaedo gị na ndị nwunye gị na ụmụ gị ka ị ga-enye m.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.5",
            "verseOrgIds": [
              "1KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, nʼoge dị ka nke a, echi, aga m ezite ndị ozi m ka ha bịa nyochaa ụlọ gị niile na ụlọ ndị ozi gị niile. Ihe ọbụla dị oke ọnụahịa nʼanya gị ka ha ga-ewere.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Izrel kpọrọ ndị okenye niile nke ala ahụ, sị ha, \"Leenụ ugbu a, hụkwanụ otu nwoke a si achọ nsogbu. Mgbe o zitere m ozi inye ya ndị nwunye m, na ụmụ, na ọlaọcha m na ọlaedo m, ekwenyere m ya inye ya ihe ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.7",
            "verseOrgIds": [
              "1KI.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị okenye na ndị Izrel zara sị ya, \"Aṅala ya ntị! Enyela ya ihe ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.8",
            "verseOrgIds": [
              "1KI.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị ndị ozi Ben-Hadad, \"Gwanụ onyenwe m, bụ eze, 'M bụ odibo gị jikeere ime ihe niile ị buru ụzọ kwuo na m ga-enye gị. Ma ekwenyeghị m nʼozi nke ugboro abụọ a.' \" Ndị ozi ahụ laghachiri kọọrọ Ben-Hadad ihe niile Ehab kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.9",
            "verseOrgIds": [
              "1KI.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ben-Hadad zigakwaara Ehab ozi ọzọ sị, \"Ka chi ndị a mesoo m mmeso,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.10",
            "verseOrgIds": [
              "1KI.20.10"
            ]
          }
        },
        {
          "text": "otu ọbụla mmeso ahụ si dị njọ, ma ọ bụrụ na aja Sameria ga-afọdụ inye onye ọbụla nʼetiti ndị ikom m otu njuaka.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.10",
            "verseOrgIds": [
              "1KI.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze Izrel zaghachiri, \"Gwa ya, 'Onye na-ebu agha na-anya isi naanị mgbe a lụchara agha, ọ bụghị tupu a lụọ agha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.11",
            "verseOrgIds": [
              "1KI.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ben-Hadad nụrụ ozi Ehab ziri mgbe ya na ndị eze ndị ọzọ ahụ nọ na-aṅụ mmanya nʼụlọ ikwu ha manyere nʼọgbọ agha ahụ. Ben-Hadad nyere ndị agha ya iwu sị ha, \"Jikerenụ, buso ndị Izrel agha.\" Ya mere, ha kwadoro ibuso obodo ahụ agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.12",
            "verseOrgIds": [
              "1KI.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehab emerie Ben-Hadad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, otu onye amụma bịakwutere Ehab, bụ eze Izrel sị, \"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.13",
            "verseOrgIds": [
              "1KI.20.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.13",
                "verseOrgIds": [
                  "1KI.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, 'Ị hụrụ oke igwe ndị agha a? Aga m enyefe ha nʼaka gị taa, mgbe ahụ ị ga-amatakwa na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.13",
            "verseOrgIds": [
              "1KI.20.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.13",
                "verseOrgIds": [
                  "1KI.20.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.13",
            "verseOrgIds": [
              "1KI.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ehab jụrụ sị, \"Onye ga-eme nke a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:14"
      },
      "items": [
        {
          "text": "Onye amụma zara, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.14",
                "verseOrgIds": [
                  "1KI.20.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ọ bụ ụmụ okorobịa bụ ndịisi agha nọ nʼokpuru ndị ọchịagha na-achị akụkụ ala Izrel.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:14"
      },
      "items": [
        {
          "text": "Ehab jụkwara ọzọ, \"Onye ga-amalite agha a?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:14"
      },
      "items": [
        {
          "text": "Onye amụma ahụ zara, \"Gị onwe gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.14",
            "verseOrgIds": [
              "1KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ehab kpọkọtara ụmụ okorobịa bụ ndịisi agha si nʼakụkụ obodo ya. Ọnụọgụgụ ha dị narị abụọ na iri atọ na mmadụ abụọ. Ọnụọgụgụ ndị agha Izrel ndị ọzọ dị puku asaa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.15",
            "verseOrgIds": [
              "1KI.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti ehihie, mgbe Ben-Hadad na iri ndị eze atọ na abụọ ahụ, bụ ndị ahụ bịara inyere ya aka nọ na-aṅụ mmanya, na-aṅụbiga ya oke,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.16",
            "verseOrgIds": [
              "1KI.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ụmụ okorobịa, bụ ndị agha, ndị nọ nʼokpuru ndị ọchịagha na-achị akụkụ ala Izrel buru ụzọ pụọ ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.17",
            "verseOrgIds": [
              "1KI.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:17"
      },
      "items": [
        {
          "text": "Ma Ben-Hadad, nʼonwe ya ezipụlarị ndị nledo, ndị lọghachiri bịa gwa ya sị, \"Ndị agha si Sameria na-abịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.17",
            "verseOrgIds": [
              "1KI.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Ọ bụrụ na ha abịa nʼihi udo, jidenụ ha na ndụ; ọ bụrụ na ha bịara maka ibu agha, jidenụ ha na ndụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.18",
            "verseOrgIds": [
              "1KI.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụmụ okorobịa ndị ọchịchị a bụ ndị nọ nʼokpuru ndịisi, na-achị akụkụ ala ahụ sitere nʼobodo zọlie ije ebe ndị agha so ha nʼazụ, pụọ ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.19",
            "verseOrgIds": [
              "1KI.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nʼime ha gburu onye agha Siria ọbụla lụsoro ya ọgụ. Nke a mere ka ndị agha Siria gbapụ ọsọ, ndị agha Izrel chụsokwara ha. Ma Ben-Hadad, eze Aram, na ndị agha na-agba ịnyịnya, sitekwara nʼihu ọgbọ agha ahụ gbapụkwa ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.20",
            "verseOrgIds": [
              "1KI.20.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze ndị Izrel pụkwuru ya, nwude ọtụtụ ịnyịnya na ụgbọ agha, butere ndị Aram ọghọm dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.21",
            "verseOrgIds": [
              "1KI.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, onye amụma ahụ bịakwutere eze Izrel sị ya, \"Mee onwe gị ka ị dị ike nke ọma, mara ihe e kwesiri ka e mee, nʼihi nʼetiti ọkọchị na udu mmiri nke afọ nʼabịa, eze Aram ga-abịa ibuso gị agha ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.22",
            "verseOrgIds": [
              "1KI.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ndịisi agha eze ndị Aram dụrụ ya ọdụ sị, \"Chi ha bụ chi ugwu. Nʼihi ya ka ha ji dị ike karịa anyị. Ma ọ bụrụ na anyị ebuso ha agha nʼobosara ala dị larịị, anyị aghaghị ịdị ike karịa ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.23",
            "verseOrgIds": [
              "1KI.20.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mee ihe a, wepụ ndị eze a niile site nʼebe ha nọ, jiri ndị na-achị ala gbanwee ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.24",
            "verseOrgIds": [
              "1KI.20.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kpọkọtaakwa ndị agha ọzọ, ndị dị ukwuu nʼọnụọgụgụ, dịka ndị agha i du gaa agha na mbụ. Nyekwa anyị ịnyịnya na ụgbọ agha ga-ezuru anyị. Anyị ga-apụkwa buso ndị Izrel agha nʼobosara ala dị larịị. Ọ dịkwaghị ihe ga-egbochi anyị imeri ha nʼoge a.\" Ben-Hadad, eze Aram, kwenyere, meere ha dịka ha rịọrọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.25",
            "verseOrgIds": [
              "1KI.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe otu afọ gasịrị, Ben-Hadad chịkọtakwara ndị Aram niile duru ha gaa Afek ibuso Izrel agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.26",
            "verseOrgIds": [
              "1KI.20.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a kpọkọtara ndị agha niile nọ nʼIzrel nye ha ngwa agha, ha pụrụ izute ha. Ndị agha Izrel mara ụlọ ikwu ha na ncherita ihu ndị agha Siria, dịka igwe ewu nta abụọ, ebe ndị Aram jupụtara ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.27",
            "verseOrgIds": [
              "1KI.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nke Chineke bịara gwa eze ndị Izrel, \"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.28",
                "verseOrgIds": [
                  "1KI.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, 'Nʼihi na ndị Aram na-eche na",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.28",
                "verseOrgIds": [
                  "1KI.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ chi nke ugwu, na ọ bụghị chi ala ndagwurugwu, aga m arara igwe ndị agha a nyefee gị nʼaka, ka gị na ndị gị mata nʼeziokwu na m bụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.28",
                "verseOrgIds": [
                  "1KI.20.28"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.28",
            "verseOrgIds": [
              "1KI.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ụbọchị asaa ka ha mara ụlọ ikwu ha na ncherita ihu ibe ha. Ma nʼụbọchị nke asaa ahụ, ndị agha malitere ibu agha. Ndị Izrel merụrụ narị puku ndị agha Aram ahụ nʼotu ụbọchị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.29",
            "verseOrgIds": [
              "1KI.20.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 20:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị fọdụrụ nʼetiti ndị agha Aram gbapụrụ ọsọ gbalaga nʼobodo Afek. Ebe ahụ ka mgbidi obodo Afek nọ dagbuo iri puku ndị agha abụọ na asaa nʼime ha. Ma Ben-Hadad nʼonwe ya gbalagara, gbaba nʼime obodo ahụ, gaa zoo onwe ya nʼime ime otu ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.30",
            "verseOrgIds": [
              "1KI.20.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndịisi agha ya bịakwutere ya sị ya, \"Lee, anyị nụrụ na ndị eze Izrel bụ ndị obi ebere. Ka anyị yiri akwa mkpe nʼukwu anyị, kee ụdọ nʼolu anyị, gaa rịọọ eze Izrel. Ma eleghị anya ọ ga-edebe gị ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.31",
            "verseOrgIds": [
              "1KI.20.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha yikwasịrị onwe ha akwa mkpe, nyarakwa ụdọ nʼolu ha, jekwuru eze Izrel sị ya, \"Ohu gị bụ Ben-Hadad na-asị, 'Biko, kwee ka m dịrị ndụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:32"
      },
      "items": [
        {
          "text": "Eze jụrụ ha sị, \"Ọ bụ ezie na ọ ka dị ndụ ugbu a? Nwanne m ka ọ bụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.32",
            "verseOrgIds": [
              "1KI.20.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu a mere ka ndị ozi eze Aram nwee olileanya. Ha mere ngwangwa kwugharịakwa ihe ahụ o kwuru. Ha sịrị, \"E, Nwanne gị bụ Ben-Hadad.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:33"
      },
      "items": [
        {
          "text": "Mgbe ahụ, eze Ehab nyere ha iwu sị, \"Gaanụ kpọpụta ya, dutekwanụ ya nʼebe a.\" Mgbe Ben-Hadad bịara, Ehab mere ka ọ rigota nʼụgbọ agha nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.33",
            "verseOrgIds": [
              "1KI.20.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ben-Hadad gwara Ehab sị, \"Obodo niile nke nna m naara nna gị, ka m ga-enyeghachi gị. I nwere ike iwuru onwe gị ọdụ ahịa nʼama obodo Damaskọs dịka nna m wuru nʼime Sameria.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:34"
      },
      "items": [
        {
          "text": "Ehab kwuru, \"Ọ bụrụ na anyị agbaa ndụ, aga m eme ka i nwere onwe gị.\" Ya mere, ha abụọ gbara ndụ. Ehab hapụkwara ya ka ọ laa nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.34",
            "verseOrgIds": [
              "1KI.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onye amụma amaa Ehab ikpe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 20:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.35",
                "verseOrgIds": [
                  "1KI.20.35"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere otu onye nʼetiti ụmụ ndị amụma. Ọ gwara otu nwoke nʼime ụmụ ndị amụma ahụ nọ ya nso sị ya, \"Jiri ngwa agha dị gị nʼaka tie m ihe.\" Ma nwoke ahụ jụrụ ime ihe onye amụma ahụ kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.35",
            "verseOrgIds": [
              "1KI.20.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 20:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, onye amụma gwara nwoke ahụ okwu sị, \"Ebe ọ bụ na ị jụrụ ime ihe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.36",
                "verseOrgIds": [
                  "1KI.20.36"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere nʼiwu, lee ihe ga-adakwasị gị. Mgbe i si nʼebe a na-ala nʼụlọ gị, ọdụm ga-ezute gị nʼụzọ dọgbuo gị.\" Amụma a mezukwara, nʼihi na mgbe nwoke ahụ tụgharịrị si nʼebe ahụ na-ala, ọdụm lụsoro ya ọgụ nʼụzọ gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.36",
            "verseOrgIds": [
              "1KI.20.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 20:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye amụma ahụ pụkwara chọta onye ọzọ sị ya, \"Biko, tie m ihe.\" Nwoke ahụ tiri ya ihe tihịa ya ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.37",
            "verseOrgIds": [
              "1KI.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 20:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye amụma ahụ e tiri ihe jiri akwa kechie ihu ya, ka mmadụ ọbụla ghara ịmata onye ọ bụ. Ọ pụrụ gaa guzo nʼakụkụ ụzọ ebe eze Izrel ga-esi gafee.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.38",
            "verseOrgIds": [
              "1KI.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1KI 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze na-agafe, onye amụma ahụ tiri mkpu sị, \"Onyenwe m, biko gee m ntị. Lee, otu onye agha bịakwutere m mgbe m nọ nʼihu agha sị m, 'Lee nwoke a a dọtara nʼagha; chee ya nche. Ekwekwala ka ọ gbanarị gị. Nʼihi na ọ bụrụ na o site nʼaka gị gbapụ,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "text": "ị ga-anwụ, maọbụ i jiri otu talenti ọlaọcha gbara isi gị.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.39",
            "verseOrgIds": [
              "1KI.20.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1KI 20:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe m nọ na-arụ ọrụ ọzọ, nwoke ahụ a dọtara nʼagha gbapụrụ. Ahụkwaghị m ya anya ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 20:40"
      },
      "items": [
        {
          "text": "Mgbe ahụ, eze Izrel zara sị ya, \"I jirila ọnụ gị maa onwe gị ikpe. Ị ghaghị ịnata ahụhụ dịrị gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.40",
            "verseOrgIds": [
              "1KI.20.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1KI 20:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye amụma ahụ mere ngwangwa wepụ akwa ahụ o ji kechie anya ya abụọ. Eze Izrel matakwara na ọ bụ otu onye nʼime ndị amụma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.41",
            "verseOrgIds": [
              "1KI.20.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1KI 20:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye amụma ahụ gwara eze okwu sị ya, \"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.20.42",
                "verseOrgIds": [
                  "1KI.20.42"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ebe i mere ka nwoke a laa, bụ onye m nyere gị nʼaka ime ka ọ nwụọ, ugbu a, ị ghaghị ịnwụ nʼọnọdụ ya. A ga-alakwa ndị gị nʼiyi, nʼọnọdụ ndị nke ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.42",
            "verseOrgIds": [
              "1KI.20.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1KI 20:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi okwu a, eze Izrel ji iwe na ihu mgbarụ laa nʼụlọ ya dị na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.43",
            "verseOrgIds": [
              "1KI.20.43"
            ]
          }
        }
      ]
