  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1KI 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwado maka iwu Ụlọnsọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hiram eze Taịa",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "text": "nụrụ na eteela Solomọn mmanụ ịbụ eze nʼọnọdụ nna ya Devid, o zipụrụ ndị ozi ya ijekwuru Solomọn, nʼihi na ya na Devid bụ enyi, dịrịkwa na mma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn zigara Hiram ozi, sị ya:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị maara na Devid nna m enweghị ike iwu ụlọnsọ ukwuu nye Aha",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya, nʼihi agha niile ọ lụrụ mgbe ọ dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "text": "Ọ nọkwa na-eche ka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.3",
                "verseOrgIds": [
                  "1KI.5.17"
                ]
              }
            }
          ]
        },
        {
          "text": "nye ya udo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.4",
                "verseOrgIds": [
                  "1KI.5.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m enyela m udo nʼakụkụ ọbụla. Enwekwaghị m ndị iro, ma ọ bụkwanụ ihe ndakwasị ọjọọ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, ana m achọ iwu ụlọnsọ ukwu nye Aha",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m, dịka",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.5",
                "verseOrgIds": [
                  "1KI.5.19"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara nna m Devid mgbe ọ sịrị ya, 'Nwa gị nwoke, onye m ga-eme ka ọ nọdụ nʼocheeze gị, ga-ewu ụlọnsọ ukwu nye Aha m.'",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, nye iwu ka e gbutuoro m osisi sida nke Lebanọn. Ndị ọrụ m ga-esoro ndị nke gị nʼọrụ a. Aga m akwụ gị ihe ọbụla i kpebiri bụ ụgwọ ọrụ ha. Ị maara na anyị enweghị ndị ọka igbutu osisi dịka ndị Saịdọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hiram nụrụ ozi Solomọn ziri, obi tọrọ ya ụtọ nke ukwuu. O kwuru sị, \"Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.7",
                "verseOrgIds": [
                  "1KI.5.21"
                ]
              }
            }
          ]
        },
        {
          "text": "taa, nʼihi na o nyela Devid nwa nwoke nwere amamihe ịchị mba ukwuu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Hiram zigaara Solomọn ozi sị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "1KI 5:8"
      },
      "items": [
        {
          "text": "\"Anụla m ozi i ziteere m. Aga m emekwa ihe niile dịka i kwuru banyere i budatara gị osisi sida na osisi junipa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ohu m ga-esi nʼugwu Lebanọn budaruo ha nʼosimiri Mediterenịa. A ga-ekekọta ha ọnụ, zitere gị ha nʼebe ị chọrọ ịnọ buru ha. Mgbe ha sere nʼelu mmiri rute ebe ị chọrọ, anyị ga-atọsakwara gị ha, ka i buru ha. Ma gị onwe gị ga-eme ihe bụ ọchịchọ m, site na-inye ndị ụlọ m ihe oriri.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, Hiram nọgidere na-ezitere Solomọn osisi sida na junipa niile ọ chọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn nyere Hiram na ezinaụlọ ya narị puku bushel, na iri puku bushel ọka wiiti abụọ, ka ọ bụrụ ihe oriri nye ezinaụlọ ya, tinyekwara narị puku galọọnụ, na iri puku galọọnụ abụọ nke mmanụ oliv asụrụ asụ. Solomọn nọgidere na-enye Hiram ihe ndị a kwa afọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.5.12",
                "verseOrgIds": [
                  "1KI.5.26"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Solomọn amamihe dị ukwuu dịka o kwere ya na nkwa. Hiram na Solomọn nwere mmekọ udo, ha abụọ gbakwara ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn, sitere nʼakụkụ Izrel niile kpọbata ndị ọrụ mmanye ọnụọgụgụ ha dị iri puku atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu ọnwa, ọ na-eziga puku mmadụ iri nʼime ndị a ka ha gaa Lebanọn ịrụ ọrụ. Nʼọnwa ọzọ, ọ na-ezigakwa puku mmadụ iri ka ha gaa gbanwee ndị buuru ụzọ gaa. Nʼụzọ dị otu a, otu ụzọ nʼime iri puku mmadụ atọ ndị a na-anọ na Lebanọn otu ọnwa maka ịrụ ọrụ, ma ha na-alọta zuo ike ọnwa abụọ. Adoniram",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "text": "bụ onyeisi ndị ọrụ mmanye a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn nwere ndị ọrụ ọzọ ọnụọgụgụ ha dị iri puku asaa na-ebu ibu, nweekwa ndị na-awa nkume nʼugwu ọnụọgụgụ ha dị iri puku asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagụnyeghị ndị a, o nwekwara ndịisi, ndị na-elekọta ndị ọrụ ndị a, ọnụọgụgụ ha dị puku atọ na narị atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka iwu eze si dị, ha na-esite nʼebe a na-awa nkume ebupụta nkume dị mma buru ibu nke e ji ewu ntọala ụlọnsọ ukwu ahụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ikom si Gebal, nyere ndị ọrụ Solomọn na ndị ọrụ Hiram aka, igbutu osisi na ịwa ha. Ha nyekwara aka ịkwado nkume e ji ewu ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.32"
            ]
          }
        }
      ]
    }
  ],
