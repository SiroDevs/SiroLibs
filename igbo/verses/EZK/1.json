  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EZK 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọhụ mbụ Izikiel hụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo nʼafọ nke iri atọ, nʼọnwa nke anọ, nʼụbọchị nke ise ya, mgbe mụ onwe m na ndị ahụ e mere ka ha gaa biri na mba ọzọ nọ nʼakụkụ iyi ukwu Keba, na e meghere eluigwe mee ka m hụ ọhụ dị iche iche site nʼaka Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.1",
            "verseOrgIds": [
              "EZK.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke ise nʼọnwa ahụ, ọ bụ nʼafọ nke ise mgbe a dọkpụụrụ eze Jehoiakin jee mba ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.2",
            "verseOrgIds": [
              "EZK.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.1.3",
                "verseOrgIds": [
                  "EZK.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Izikiel onye nchụaja nwa Buzi ntị, mgbe ọ nọ nʼakụkụ iyi ukwu Keba, nke dị nʼala ndị Kaldịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "text": "Nʼebe ahụ kwa ka aka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.1.3",
                "verseOrgIds": [
                  "EZK.1.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ dịkwasị ya nʼahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.3",
            "verseOrgIds": [
              "EZK.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elere m anya hụ oke ifufe nke si nʼugwu na-abịa, ahụkwara m oke igwe ojii na amụma nke na-egbuke egbuke; ìhè nke na-enwu nnọọ vaa gbara ya gburugburu. Etiti ọkụ ahụ nwere ihe dịka ọlaọkụ na-amụke amụke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.4",
            "verseOrgIds": [
              "EZK.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe e kere eke anọ dị ndụ, nke yiri mmadụ nʼụdịdị ha, nọkwa nʼetiti oke ihe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.5",
            "verseOrgIds": [
              "EZK.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ọbụla nʼime ha nwere ihu anọ, na nku anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.6",
            "verseOrgIds": [
              "EZK.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ha guzoro kwem; ọbụ ụkwụ ha dịka nke nwa ehi, na-amụkekwa dịka bronz e hichara nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.7",
            "verseOrgIds": [
              "EZK.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru nku ha, ha nwere aka yiri aka mmadụ nʼakụkụ anọ ha niile. Otu a ka ihu ha na nku anọ dị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.8",
            "verseOrgIds": [
              "EZK.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nku ha na-emetụ na nke ibe ha. Mgbe ha na-efe, ha na-eche ihu ha nʼotu ụzọ, ha adịghị agha anya ha nʼazụ mgbe ha na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.9",
            "verseOrgIds": [
              "EZK.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maka oyiyi ihu ha: Ha anọ nwere ihu mmadụ, nʼakụkụ aka nri ha nwere ihu ọdụm, nʼakụkụ aka ekpe ha bụ ihu ehi, onye ọbụla nwekwara ihu ugo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.10",
            "verseOrgIds": [
              "EZK.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ahụ ka ihu ha niile dị. Ha gbasara nku ha nʼelu, nke ọbụla nwere nku abụọ, otu nʼime nku ndị a na-emetụ nku nke ibe ya, ebe abụọ kpuchiri ahụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.11",
            "verseOrgIds": [
              "EZK.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile gawara nʼihu. Ebe ọbụla mmụọ ahụ gara ka ha na-aga, na-eleghị anya nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.12",
            "verseOrgIds": [
              "EZK.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti ihe ndị a dị ndụ, e nwere ihe dịka icheku ọkụ na-enwu enwu, dịkwa ka ọwa na-enwu ọkụ. Ọkụ na-esi nʼetiti ihe ndị ahụ dị ndụ na-aga ihu na azụ, ọkụ ahụ nwupụrụ enwupụ, amụma eluigwe sikwa na ya egbupụta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.13",
            "verseOrgIds": [
              "EZK.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị ahụ dị ndụ na-efegharị nʼebe a, na-efegharịkwa nʼebe nke ọzọ, dịka mgbe amụma na-egbu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.14",
            "verseOrgIds": [
              "EZK.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m na-ele ihe e kere eke dị ndụ ndị a anya, ahụrụ m ụkwụ ụgbọ agha anọ nke dị nʼala nʼokpuru ha. Onye ọbụla nwere nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.15",
            "verseOrgIds": [
              "EZK.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ụgbọala ahụ niile dị ka ihe e ji nkume na-egbu maramara a na-akpọ beril",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "text": "kpụọ. Nke ọbụla nʼime ha anọ yikwara ibe ya. Ha niile dịkwa ka wịịlu a kpụrụ tinye nʼetiti ụkwụ ụgbọala buru ibu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.16",
            "verseOrgIds": [
              "EZK.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha pụrụ, ha na-aga nʼakụkụ anọ nke ha chere ihu ha, ma ụkwụ ụgbọ agha ahụ adịghị echigharị echigharị mgbe ha na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.17",
            "verseOrgIds": [
              "EZK.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azụ ụkwụ ụgbọ agha ha dị elu, dịkwa egwu. Anya jupụtakwara nʼazụ ụkwụ ụgbọ agha ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.18",
            "verseOrgIds": [
              "EZK.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a dị ndụ fepụrụ gaa nʼihu, ụkwụ ụgbọala ndị ahụ dị nʼakụkụ ha na-eso ha. Mgbe ha feliri elu, ụkwụ ndị ahụ na-esokwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.19",
            "verseOrgIds": [
              "EZK.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọbụla mmụọ ha jere, ebe ahụ ka ha na-aga, ụkwụ ụgbọ agha ahụ na-esokwa ha, nʼihi na mmụọ nke anụ ndị ahụ dị ndụ dị nʼụkwụ ụgbọ agha ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.20",
            "verseOrgIds": [
              "EZK.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha biliri, ndị ọzọ na-ebilikwa. Mgbe ha guzoro otu ebe, ndị ọzọ na-eguzokwa. Mgbe ha feliri elu, ụkwụ ụgbọala ahụ na-eso ha. Nʼihi na mmụọ anụ ndị ahụ dị ndụ dị nʼime ụkwụ ụgbọ agha ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.21",
            "verseOrgIds": [
              "EZK.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A tụsara ihe sara mbara dịka mbara eluigwe nʼelu isi ihe ndị ahụ dị ndụ. Ọ na-eyi egwu, ma na-egbukwa nweghenweghe dịka kristal.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.22",
            "verseOrgIds": [
              "EZK.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru ihe ahụ ka ha gbasapụrụ nku ha, ka ọ na-emetụ nke ibe ya. Ha niile nʼotu nʼotu nwere nku abụọ nke na-ekpuchi ahụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-aga, nku ha na-eme mkpọtụ dị ka mkpọtụ ebili mmiri na-amagharị amagharị. Mkpọtụ ahụ dịkwa ka ịda ụda nke olu Onye pụrụ ime ihe niile, ka olu iti mkpu nke usuu ndị agha. Mgbe ọbụla ha guzoro, ha na-achịtu nku ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ha kwụsịrị mechie nku ha olu sitere nʼime ihe ahụ dịka mbara eluigwe nke dị nʼelu isi ha na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.25",
            "verseOrgIds": [
              "EZK.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼelu mbara eluigwe ahụ, o nwere ihe dịka ocheeze e ji nkume dị oke ọnụahịa a na-akpọ safaia wuo. Otu onye, nke ụdịdị ya dị ka nwoke, nọkwasịkwara nʼelu oche ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.26",
            "verseOrgIds": [
              "EZK.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụkwụ ya ruo nʼisi ya, ahụ onye ahụ na-egbu maramara dịka ọkụ. Site nʼụkwụ ya ruo nʼukwu ya, ọ dị ka ọkụ na-enwu enwu, ìhè nke na-enwukwa ka ọkụ gbara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.27",
            "verseOrgIds": [
              "EZK.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìhè ahụ gbara ya gburugburu, nke a na-ahụ anya, dịkwa ka ìhè eke na egwurugwu, nke a na-ahụ anya nʼoge mmiri na-ezo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 1:28"
      },
      "items": [
        {
          "text": "Otu a ka ebube",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.28",
            "verseOrgIds": [
              "EZK.1.28"
            ]
          }
