                "verseId": "EZK.1.28",
                "verseOrgIds": [
                  "EZK.1.28"
                ]
              }
            }
          ]
        },
        {
          "text": "si gosi m onwe ya. Mgbe m hụrụ ya, adara m nʼala kpuo ihu m nʼala. Mgbe ahụ, anụrụ m olu onye na-ekwu okwu.",
