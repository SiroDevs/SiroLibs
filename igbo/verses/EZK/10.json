  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "EZK 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebube Chineke apụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, elere m anya hụ ocheeze ọma e ji nkume safaia wuo ka ọ pụtara ihe na mbara eluigwe, nʼelu ebe ahụ isi cherubim ndị ahụ dị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.1",
            "verseOrgIds": [
              "EZK.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.2",
                "verseOrgIds": [
                  "EZK.10.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị nwoke ahụ yi uwe akwa ọcha, \"Baa nʼetiti ụkwụ ụgbọala ahụ dị nʼokpuru cherubim ndị ahụ. Site nʼetiti cherubim ndị ahụ kpojuo icheku ọkụ nke na-ere ere nʼaka gị, fesachaa ha nʼime obodo ahụ niile.\" Ọ bara nʼime ka m nʼele ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.2",
            "verseOrgIds": [
              "EZK.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherubim ndị ahụ na-eguzo nʼakụkụ ndịda nke ụlọnsọ ahụ mgbe nwoke ahụ banyere. Igwe ojii jupụtakwara nʼogige ime ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.3",
            "verseOrgIds": [
              "EZK.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ebube",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.4",
                "verseOrgIds": [
                  "EZK.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼelu cherubim bilie, bịa guzo nʼọnụ ụzọ ụlọnsọ ahụ. Ụlọnsọ ahụ jupụtakwara nʼigwe ojii, ihe nke ebube",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.4",
                "verseOrgIds": [
                  "EZK.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "jupụtakwara nʼogige ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.4",
            "verseOrgIds": [
              "EZK.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzụ nke nku cherubim ndị ahụ na-eme dịkwa ka olu Chineke Onye pụrụ ime ihe niile. A na-anụkwa ụzụ nku ndị ahụ nʼogige ụlọnsọ ahụ dị nʼezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.5",
            "verseOrgIds": [
              "EZK.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.6",
                "verseOrgIds": [
                  "EZK.10.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere nwoke ahụ yi uwe ezi akwa ọcha iwu, sị, \"Gaa nʼetiti cherubim ahụ gụta ụfọdụ icheku ọkụ dị nʼetiti wịịlu ụgbọala ahụ,\" nwoke ahụ banyere guzo nʼakụkụ otu wịịlu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.6",
            "verseOrgIds": [
              "EZK.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, otu nʼime ndị cherubim ahụ setịpụrụ aka ya nʼebe ọkụ ahụ dị nʼetiti ha. Ọ gụtara ụfọdụ icheku ọkụ tinye nʼaka nwoke ahụ yi uwe akwa ọcha onye weere ya pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.7",
            "verseOrgIds": [
              "EZK.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru nku ndị cherubim ahụ ka a na-ahụta ihe yiri aka mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.8",
            "verseOrgIds": [
              "EZK.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elere m anya hụ wịịlu anọ, nke dị nʼakụkụ cherubim ndị ahụ. Cherubim ọbụla nwere otu wịịlu nʼakụkụ ya. Wịịlu ndị a niile na-egbu maramara dịka nkume beril.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.9",
            "verseOrgIds": [
              "EZK.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wịịlu anọ ndị ahụ yiri onwe ha. Nke ọbụla nʼime ha dịka wịịlu a rụnyere nʼetiti wịịlu ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.10",
            "verseOrgIds": [
              "EZK.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-aga, ha niile na-eche ihu nʼakụkụ ọbụla nke cherubim ndị ahụ chere ihu. Wịịlu ndị a adịghị echigharị echigharị mgbe cherubim ndị a na-agagharị. Kama ebe isi cherubim ndị ahụ chere ihu ka wịịlu ndị ahụ na-aga. Ha adịghị elekwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "text": "anya nʼazụ dịka ha na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.11",
            "verseOrgIds": [
              "EZK.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gburugburu ha, nʼanụ ahụ ha niile, ma nʼazụ ha, ma nʼaka ha, ma na nku ha, ma na wịịlu ndị ahụ, ihe jupụtara ha bụ anya. Anya dị nʼakụkụ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.12",
            "verseOrgIds": [
              "EZK.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha m nụrụ a na-akpọ wịịlu ndị ahụ bụ, Ọgba gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.13",
            "verseOrgIds": [
              "EZK.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ọbụla nʼime cherubim ndị a nwere ihu anọ. Ihu nke mbụ dịka ihu cherub. Nke abụọ dịka ihu mmadụ; nke atọ dịka ihu ọdụm, ma nke anọ dịka ihu ugo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.14",
            "verseOrgIds": [
              "EZK.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Cherubim ndị ahụ buliri onwe ha elu. Ndị a bụ ihe ndị ahụ dị ndụ nke m hụrụ na mbụ nʼakụkụ osimiri Keba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.15",
            "verseOrgIds": [
              "EZK.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe cherubim ndị ahụ na-aga, wịịlu ndị ahụ dị nʼakụkụ ha na-eso ha na-aga. Mgbe ha na-achili nku ha i si nʼala bulie onwe ha elu, wịịlu ha na-anọgidekwa nʼakụkụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.16",
            "verseOrgIds": [
              "EZK.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe cherubim ndị ahụ guzoro nʼotu ebe, wịịlu ahụ na-eguzokwa. Mgbe ha na-ebuli onwe ha elu, wịịlu ndị ahụ na-ebulikwa onwe ha elu, nʼihi na mmụọ nke ihe ahụ dị ndụ dị nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.17",
            "verseOrgIds": [
              "EZK.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ebube nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.18",
                "verseOrgIds": [
                  "EZK.10.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere na mbata ọnụ ụzọ ụlọnsọ ahụ pụọ, gaa guzo nʼelu cherubim ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.18",
            "verseOrgIds": [
              "EZK.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m nọ na-ele anya, cherubim ahụ gbasapụrụ nku ha felie, wịịlu ha niile dịkwa nʼakụkụ ha. Ha guzoro na mbata ọnụ ụzọ nke dị nʼakụkụ ọwụwa anyanwụ nke ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.10.19",
                "verseOrgIds": [
                  "EZK.10.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", na ebube nke Chineke nke Izrel dịkwa nʼelu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.19",
            "verseOrgIds": [
              "EZK.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ ihe ndị ahụ dị ndụ, nke m hụrụ nʼokpuru Chineke Izrel nʼakụkụ osimiri Keba, amatara m na ha bụ cherubim.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.20",
            "verseOrgIds": [
              "EZK.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke ọbụla nʼime ha nwere ihu anọ na nku anọ, na ihe yiri aka mmadụ nʼokpuru nku ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.21",
            "verseOrgIds": [
              "EZK.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihu ha yikwara ihu ihe ndị ahụ m hụrụ nʼakụkụ osimiri Keba. Nke ọbụla na-agakwa ije nʼihu ihu na-eleghị anya nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.10.22",
            "verseOrgIds": [
              "EZK.10.22"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EZK.11",
    "number": "11",
    "bookId": "EZK"
  },
