  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "EZK 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndagwurugwu ọkpụkpụ kpọrọ nkụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dịkwasịrị m, o sitekwara nʼike Mmụọ nke Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.1",
                "verseOrgIds": [
                  "EZK.37.1"
                ]
              }
            }
          ]
        },
        {
          "text": "bulie m, debe m nʼetiti ndagwurugwu nke jupụtara nʼọkpụkpụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.1",
            "verseOrgIds": [
              "EZK.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m jegharịa nʼetiti ha. Ahụrụ m ọkpụkpụ kpọrọ nkụ, nke dị ukwuu nʼọnụọgụgụ, ka ha ghasa na ndagwurugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.2",
            "verseOrgIds": [
              "EZK.37.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, ọkpụkpụ ndị a ha pụrụ ịdị ndị ọzọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 37:3"
      },
      "items": [
        {
          "text": "Asịrị m, \"Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.3",
                "verseOrgIds": [
                  "EZK.37.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ọ bụ naanị gị onwe gị maara.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.3",
            "verseOrgIds": [
              "EZK.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị m, \"Buo amụma nye ọkpụkpụ ndị ahụ, gwa ha, 'Unu ọkpụkpụ niile kpọrọ nkụ, geenụ ntị nʼokwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.4",
                "verseOrgIds": [
                  "EZK.37.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.4",
            "verseOrgIds": [
              "EZK.37.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.5",
                "verseOrgIds": [
                  "EZK.37.5"
                ]
              }
            }
          ]
        },
        {
          "text": "na-agwa ọkpụkpụ ndị a. Lee, aga m eme ka ume baa nʼime unu, unu ga-adịkwa ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.5",
            "verseOrgIds": [
              "EZK.37.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m etinyekwasị unu akwara, na anụ ahụ, werekwa akpụkpọ ahụ kpuchie unu. Aga m etinye ume nʼime unu, unu ga-adịkwa ndụ. Mgbe ahụ, unu ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.6",
                "verseOrgIds": [
                  "EZK.37.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.6",
            "verseOrgIds": [
              "EZK.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eburu m amụma dịka e sị nye m nʼiwu. Mgbe m nọ na-ebu amụma ahụ, anụrụ m ụzụ, ụzụ mkpọtụ. Ma lee, ọkpụkpụ ndị ahụ niile bịara ibe ha nso; ọkpụkpụ malitekwara ijikọta onwe ha ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.7",
            "verseOrgIds": [
              "EZK.37.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m nọkwa na-ele anya, lee, ahụrụ m ka akwara na anụ ahụ malitere ịbịakwasị nʼelu ọkpụkpụ ndị ahụ, akpụkpọ ahụ kpuchikwara elu ha. Ma nʼoge a ume ọbụla adịghị nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.8",
            "verseOrgIds": [
              "EZK.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị m, \"Buo amụma nye ifufe; buo amụma, nwa nke mmadụ, sị ifufe, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.9",
                "verseOrgIds": [
                  "EZK.37.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: site nʼakụkụ anọ nke ụwa bịa, gị ume na-enye ndụ, kukwasị ndị a e gburu egbu ka ha dịkwa ndụ ọzọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.9",
            "verseOrgIds": [
              "EZK.37.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eburu m amụma dịka o si nye m nʼiwu. Ume ndụ banyekwara nʼime ha. Ha niile dịịrị ndụ, bilie ọtọ, guzo nʼụkwụ ha, ghọọ usuu ndị agha dị ukwuu nʼọnụọgụgụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.10",
            "verseOrgIds": [
              "EZK.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwara m, \"Nwa nke mmadụ, ọkpụkpụ ndị a nọchiri anya ụlọ Izrel niile. Ha na-asị, 'Anyị aghọọla ọkpụkpụ kpọrọ nkụ, olileanya niile agwụkwala, anyị abụrụla ndị e bipụrụ.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.11",
            "verseOrgIds": [
              "EZK.37.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, buo amụma gwa ha, 'otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.12",
                "verseOrgIds": [
                  "EZK.37.12"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Ndị m, aga m emeghe ili unu, si nʼebe ahụ wepụta unu. Aga m eme ka unu lọghachitakwa nʼala Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, mgbe m meghere ili unu mee ka unu si nʼime ya pụta, unu bụ ndị m ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.13",
                "verseOrgIds": [
                  "EZK.37.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m etinye Mmụọ m nʼime unu, unu ga-adị ndụ, lọghachikwa nʼala unu ọzọ. Unu ga-amatakwa na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ekwuola ya, meekwa ya, otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.14",
                "verseOrgIds": [
                  "EZK.37.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
              "EZK.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otu mba, otu eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.15",
                "verseOrgIds": [
                  "EZK.37.15"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.15",
            "verseOrgIds": [
              "EZK.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, were osisi dee ihe ndị a nʼelu ya, 'Osisi a nọchiri anya Juda na ndị Izrel e kekọtara ya na ha ọnụ.' Werekwa osisi ọzọ deekwa okwu ndị a nʼelu ya. 'Osisi a nọchiri anya Ifrem, na Josef, na ndị Izrel niile e jikọtara ha na ndị a ọnụ.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.16",
            "verseOrgIds": [
              "EZK.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jidekọtaa osisi abụọ ndị a ọnụ, mee ka ha bụrụ otu osisi nʼaka gị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.17",
            "verseOrgIds": [
              "EZK.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ndị gị jụrụ gị, 'Ị gaghị egosi anyị ihe nke a pụtara?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.18",
            "verseOrgIds": [
              "EZK.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "gwa ha, sị, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.19",
                "verseOrgIds": [
                  "EZK.37.19"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu: Lee, agaje m iwere osisi Josef, nke dị Ifrem nʼaka, nke bụkwa ihe nọchiri anya ebo ụfọdụ ndị Izrel, jidekọtaa ya na osisi nọchiri anya Juda, mee ha ka ha ghọọ otu osisi, bụrụkwa otu nʼaka m.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.19",
            "verseOrgIds": [
              "EZK.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were mkpirisi osisi ndị ahụ i dere ihe nke dị nʼaka gị, gosi ha,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.20",
            "verseOrgIds": [
              "EZK.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma gwakwa ha, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.21",
                "verseOrgIds": [
                  "EZK.37.21"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu: Aga m esite na mba niile ndị Izrel jere biri kpọpụta ha. Aga m achịkọtakwa ha site nʼakụkụ niile, kpọbata ha nʼala nke aka ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ha ka ha bụrụ otu mba nʼala ahụ, nʼugwu niile nke Izrel. Ha ga-enwe naanị otu eze nke ga-achị ha niile. Ha agaghị abụkwa mba abụọ maọbụ alaeze abụọ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.22",
            "verseOrgIds": [
              "EZK.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha agaghị ejikwa arụsị ha niile, maọbụ ihe a pịrị apị rụrụ arụ, maọbụ jiri ihe ọjọọ ndị ọzọ dị iche iche merụọ onwe ha ọzọ. Nʼihi na aga m azọpụta ha site na ịlaghachi azụ nʼụzọ mmehie ha niile, meekwa ka ha dị ọcha. Ha ga-abụ ndị m, mụ onwe m ga-abụkwa Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.23",
            "verseOrgIds": [
              "EZK.37.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ohu m, Devid, ga-abụ eze ga-achị ha, ha ga-enwekwa otu onye ọzụzụ atụrụ. Ha ga-edebezu iwu m niile, na ụkpụrụ m niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.24",
            "verseOrgIds": [
              "EZK.37.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-ebi nʼala ahụ m nyere ohu m Jekọb, ala ebe nna nna ha biri. Ha na ụmụ ha ga-ebi nʼime ya. Ụmụ ụmụ ha ruo ọgbọ niile ga-ebikwa nʼime ya. Ohu m Devid ga-abụ eze ha ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.25",
            "verseOrgIds": [
              "EZK.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ na ha ga-agba ndụ udo, ọgbụgba ndụ nke ga-adị ruo mgbe ebighị ebi. Aga m agọzi ha, mee ka ha baa ụba. Nʼetiti ha kwa ka ụlọnsọ m ga-adị ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.26",
            "verseOrgIds": [
              "EZK.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe obibi m ga-abụkwa nʼetiti ha. E, aga m abụ Chineke ha, ha ga-abụkwa ndị m.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.27",
            "verseOrgIds": [
              "EZK.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụlọnsọ m ga-adị nʼetiti ha ruo ebighị ebi, mba niile ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.37.28",
                "verseOrgIds": [
                  "EZK.37.28"
                ]
              }
            }
          ]
        },
        {
          "text": "na-edo Izrel nsọ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        }
      ]
    }
  ],
