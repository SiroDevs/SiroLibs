                "verseOrgIds": [
                  "EZK.12.26"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere m,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.26",
            "verseOrgIds": [
              "EZK.12.26"
            ]
          }
