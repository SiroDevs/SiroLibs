  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "EZK 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe ngosi maka ndọta nʼagha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.1",
                "verseOrgIds": [
                  "EZK.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, i bi nʼetiti ndị na-enupu isi, ndị nwere anya ịhụ ụzọ ma ha adịghị ahụ; ndị nwere ntị ịnụ ihe ma ha adịghị anụ ihe, nʼihi na ha bụ ndị nnupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, nwa nke mmadụ, kwakọtaa ngwongwo ụlọ gị maka ị ga biri nʼala ọzọ, mee nke a nʼehihie dịka ha na-ele gị anya, hapụ ụlọ gị gaa nʼebe ọzọ. Ma eleghị anya ha ga-aghọta, ọ bụ ezie na ha bụ ndị nnupu isi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.3",
            "verseOrgIds": [
              "EZK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwapụta ngwongwo gị nʼezi nʼehihie ka ha hụ ya. Ma hapụ ụlọ gị nʼabalị dịka ndị na-agba ọsọ ndụ si eme, mgbe ha na-amalite ije ha, nke ịga ibi nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.4",
            "verseOrgIds": [
              "EZK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-ele gị anya, gwupuo mgbidi, site na ya kwara ngwongwo gị pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.5",
            "verseOrgIds": [
              "EZK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nọ na-ele gị anya, bulie ibu gị, tụkwasị ya nʼubu gị, pụọ gawa nʼime ọchịchịrị, kpuchie ihu gị, ka ị ghara ihu ala ahụ anya. Nʼihi na emela m gị ihe ịrịbama nye ụlọ Izrel niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emere m ihe e nyere m nʼiwu. Ebupụtara m ngwongwo m nʼehihie, jikọta ha maka ịgba ọsọ ndụ. Nʼanyasị, eji m aka m gwuo ọnụ na mgbidi ahụ. Ebukwasịrị m ngwongwo m nʼubu, bulie ije nʼime ọchịchịrị mgbe ha nọ na-ele m anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụtụtụ echi ya, okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.8",
                "verseOrgIds": [
                  "EZK.12.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere m,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.8",
            "verseOrgIds": [
              "EZK.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, ọ bụ na ụlọ Izrel ndị nnupu isi ahụ ajụbeghị gị, 'o lee ihe ị na-eme?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.9",
            "verseOrgIds": [
              "EZK.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ha, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.10",
                "verseOrgIds": [
                  "EZK.12.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Amụma a bụ maka onyeisi nọ na Jerusalem, nʼụlọ Izrel niile nọkwa ebe ahụ.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.10",
            "verseOrgIds": [
              "EZK.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sị ha, 'Mụ onwe m bụ ihe ama nye unu.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EZK 12:11"
      },
      "items": [
        {
          "text": "\"Dịka m mere, otu a kwa ka a ga-eme nye ha. Ha ga-aga na mba ọzọ biri ka ndị a dọtara nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.11",
            "verseOrgIds": [
              "EZK.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa eze nke nọ nʼetiti ha ga-amaburu ibu ya nʼubu pụọ nʼọchịchịrị, ọ ga-egwupụ mgbidi aja nke obodo site nʼebe ahụ pụọ. Ọ ga-ekpuchikwa ihu ya ka ọ ghara iji anya ya hụ obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.12",
            "verseOrgIds": [
              "EZK.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aga m eji ụgbụ m jide ya, meekwa ka ọ bịaruo Babilọn bụ ala ndị Kaldịa. Ebe ahụ ka ọ ga-anọ nwụọ, ma ọ gaghị ahụ ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.13",
            "verseOrgIds": [
              "EZK.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile gbara ya gburugburu na ndị agha ya niile ka m ga-achụsa nʼala niile, ọ bụkwa mma agha ka m ga-amịpụta jiri chụọ ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ha ga-amata na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.15",
                "verseOrgIds": [
                  "EZK.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", mgbe m chụsachara ha nʼetiti mba niile dị iche iche, fesaakwa ha nʼala niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ mmadụ ole na ole nʼime ha ka m ga-edebe ndụ site na mma agha, na ụnwụ na ọrịa na-efe efe. Ka ha nwee ike kọọ akụkọ ihe arụ niile ha nʼetiti mba dị iche iche ebe ha gbagara ọsọ. Ha ga-amatakwa na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.16",
                "verseOrgIds": [
                  "EZK.12.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.17",
                "verseOrgIds": [
                  "EZK.12.17"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, tụọ egwu mgbe ị na-eri nri gị. Jirikwa ihe ọtụtụ tụpụta mmiri ọṅụṅụ gị, dịka a ga-asị na ọ bụ ihe ikpeazụ i nwere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-asịkwa ndị bi nʼala ahụ, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.19",
                "verseOrgIds": [
                  "EZK.12.19"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu banyere ndị bi na Jerusalem, nʼala nke Izrel, sị, Ha ga-eji ụjọ rie achịcha ha, jirikwa obi ịlọ mmiri ṅụọ mmiri ha, nʼihi na a ga-ekpochapụ ihe niile dị nʼala ha, nʼihi ihe ike nke ndị bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo niile nke ndị mmadụ bi nʼime ya ga-ala nʼiyi, otu aka ahụ, ala unu niile ga-abụ ebe tọgbọrọ na nkịtị. Mgbe ahụ, unu ga-amata na mụ onwe bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.12.20",
                "verseOrgIds": [
                  "EZK.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": ".' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọ gaghị adị anya mmezu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
