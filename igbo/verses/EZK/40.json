  "verseCount": 49,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
        "style": "c",
        "sid": "EZK 40"
      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụlọnsọ ukwu ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri abụọ na ise nke e mere ka anyị biri na mba ọzọ, na mbido afọ ahụ, nʼụbọchị nke iri, nke ọnwa ahụ nʼafọ nke iri na anọ site na mgbe obodo ahụ dara, nʼotu ụbọchị ahụ ka aka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.1",
            "verseOrgIds": [
              "EZK.40.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.40.1",
                "verseOrgIds": [
                  "EZK.40.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dịkwasịrị m nʼahụ. O mere ka m bịa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.1",
            "verseOrgIds": [
              "EZK.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọhụ dị iche iche Chineke mere ka m hụ, o buuru m gaa nʼala Izrel, debe m nʼelu ugwu dị elu nke ukwu, ebe m nọ hụ ihe dịka obodo a na-ewu ọhụrụ, nke dị nʼakụkụ ndịda ugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.2",
            "verseOrgIds": [
              "EZK.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m bịaruo nʼebe ahụ, ma lee, ahụrụ m otu nwoke nke ụdịdị ya na-enwu dịka bronz ka o guzo nʼakụkụ ọnụ ụzọ ama. Ọ na-ejide eriri akwa ọcha, na osisi e ji atụ ihe nʼaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.3",
            "verseOrgIds": [
              "EZK.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ sịrị m, \"Nwa nke mmadụ, lezie anya nke ọma, gekwaa ntị tinyekwa ihe niile m gaje igosi gị nʼobi, nʼihi na-akpọtara m gị nʼebe a nʼihi ka ịhụ ihe ndị a. Gwakwa ụmụ Izrel ihe niile ị hụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.4",
            "verseOrgIds": [
              "EZK.40.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ọnụ ụzọ ama nke ọwụwa anyanwụ na ogige dị na mpụta",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m mgbidi gbara ụlọnsọ ahụ gburugburu. Ịdị ogologo nke osisi ihe ọtụtụ nke dị nʼaka nwoke ahụ, ruru mita atọ na ụma abụọ, nke ọbụla nʼime ha ruru iri sentimita ise na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.5",
            "verseOrgIds": [
              "EZK.40.5"
            ]
          }
        },
        {
          "text": "Ọ tụrụ mgbidi ahụ, chọpụta na ịla elu ya dị mita atọ na ọkara. Ịsa mbara ya dịkwa mita atọ na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.5",
            "verseOrgIds": [
              "EZK.40.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ọ gara nʼọnụ ụzọ ahụ chere ihu nʼọwụwa anyanwụ, rigoro nʼihe nrigo elu, tụọ ala ala ụzọ mbata nke ọnụ ụzọ ahụ. Obosara ya dị mita atọ na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.6",
            "verseOrgIds": [
              "EZK.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghere dị nʼụlọ ahụ nke bụ ebe ndị nche na-anọ dị mita atọ nʼọkara nʼobosara. Mgbidi dị nʼetiti ha dị mita abụọ na ụma asaa nʼigbidi. Ebe e si abata na mpụta ọnụ ụzọ ama nke chere ụlọnsọ ukwu ahụ ihu, dị mita atọ nʼọkara nʼomimi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.7",
            "verseOrgIds": [
              "EZK.40.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jikwa ihe ọtụtụ tụọ ebe mpụta ọnụ ụlọ nke ọnụ ụzọ ama,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.8",
            "verseOrgIds": [
              "EZK.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ dị mita anọ na ụma abụọ nʼomimi. Ogidi dị nʼakụkụ ya dị otu mita nʼigbidi. Ebe mpụta ọnụ ụlọ nke ụzọ ama ya chere ihu nʼụlọnsọ ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.9",
            "verseOrgIds": [
              "EZK.40.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ọnụ ụzọ ama nke ọwụwa anyanwụ, e nwere oghere atọ dị nʼakụkụ ọbụla, oghere atọ ndị ahụ ha nʼotu. Ihu akụkụ aja ya niile nke chere ha ihu bụkwa otu nʼọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.10",
            "verseOrgIds": [
              "EZK.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụrụ obosara nke mbata ọnụ ụzọ ama ahụ, ọ dị mita ise na ụma atọ nʼobosara, na mita isii na ụma itoolu nʼogologo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.11",
            "verseOrgIds": [
              "EZK.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu oghere niile nke ụlọ ahụ e nwere mgbidi dị otu ọkara mita nʼịdị elu ya. Akụkụ anọ nke oghere ndị a ha otu. Ha ruru mita atọ mita atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.12",
            "verseOrgIds": [
              "EZK.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụrụ obosara ọnụ ụzọ ama ahụ, site nʼelu ụlọ nke otu ime ụlọ ruo nʼelu ụlọ nke ime ụlọ chere ya ihu; obosara ya dị mita iri na atọ, site nʼotu oghere ruo nʼoghere nke chere ya ihu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.13",
            "verseOrgIds": [
              "EZK.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụrụ ogologo ogidi niile dị nʼakụkụ nʼime mgbidi ọnụ ụzọ ama ụlọ ahụ, chọpụta na ọ dị iri mita atọ na abụọ, ọ bụladị ruo nʼakụkụ mgbidi nke chere ihu nʼọnụ ụzọ ama ogige ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.14",
            "verseOrgIds": [
              "EZK.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼihu ọnụ ụzọ ama mbata ahụ, ruo nʼebe ngwụcha nke ọnụ ụzọ dị na mpụta ọnụ ụlọ ya dị iri mita abụọ na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.15",
            "verseOrgIds": [
              "EZK.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụlọ ndị ahụ niile nwere oghereikuku dị warawara nʼakụkụ aja ụlọ ha, dịka mpụta ọnụ ụlọ ahụ nwekwara; oghereikuku ndị a dị gburugburu dị nʼime, nʼetiti ọnụ ụlọ ndị a. Nʼaja ụlọ ndị a niile, e nwere oyiyi nkwụ dị iche iche e sere nʼelu ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.16",
            "verseOrgIds": [
              "EZK.40.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ogige dị nʼezi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọbatara m nʼogige dị nʼezi. Nʼebe ahụ, ahụrụ m ụfọdụ ọnụụlọ dị na pevumentị e wunyere gburugburu ogige ahụ niile. Ha dị iri ọnụụlọ atọ dị nʼogologo pevumentị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.17",
            "verseOrgIds": [
              "EZK.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe nzọkwasị ụkwụ a gara ogologo ruo nʼakụkụ ọnụ ụzọ ama, ogologo ya na ọnụ ụzọ ama ahụ ha, nke a bụ pevumentị nke dịkarịrị ala.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.18",
            "verseOrgIds": [
              "EZK.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụrụ ịdị ogologo ya, site nʼime ọnụ ụzọ ama nke dịkarịrị ala ruo nʼọnụ ụzọ nke ime ogige, o ruru iri mita ise na atọ nʼakụkụ ihu anyanwụ nakwa nʼakụkụ ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.19",
            "verseOrgIds": [
              "EZK.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ọnụ ụzọ mbata dị nʼugwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụrụ ogologo na obosara ọnụ ụzọ nke dị nʼugwu, nke e si abanye nʼogige dị nʼezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.20",
            "verseOrgIds": [
              "EZK.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ime ụlọ ya dị ọnụ ụlọ atọ nʼakụkụ ya ọbụla. Akụkụ aja na mpụta ọnụ ụlọ ya, bụ otu ọtụtụ dịka ọtụtụ nke ọnụ ụzọ ama mbụ. Ịdị ogologo ya dị iri mita abụọ na asaa, ebe obosara ya dị mita iri na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.21",
            "verseOrgIds": [
              "EZK.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oghereikuku ya, mpụta ọnụ ụzọ ya na osisi nkwụ e sere nʼahụ aja ụlọ ahụ niile, dịka e mere nʼakụkụ ọnụ ụzọ ama nke na-eche ihu nʼọwụwa anyanwụ, bụ otu ọtụtụ. Ihe nrigo nwere nzọ ụkwụ asaa dị nke e si aga na mpụta ọnụ ụlọ ahụ na ncherita ihu ogige ezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.22",
            "verseOrgIds": [
              "EZK.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọnụ ụzọ dị nke gara nʼogige dị nʼime, nke chere ihu ọnụ ụzọ mbata dị nʼugwu, dịka ọ dịkwa nʼakụkụ nke ọwụwa anyanwụ. Ọ tụrụ site nʼotu ọnụ ụzọ ama ruo na nke chere ya ihu, ọ dị iri mita ise na anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.23",
            "verseOrgIds": [
              "EZK.40.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ọnụ ụzọ mbata dị na ndịda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, o duuru m gaa nʼakụkụ ndịda, a hụrụ m ọnụ ụzọ mbata ndịda. Ọ tụrụ tụọ akụkụ ogidi ọnụ ụzọ ahụ na mpụta ọnụ ụlọ ya, chọpụta na ya na ndị ọzọ bụ otu ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.24",
            "verseOrgIds": [
              "EZK.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụzọ ama ya na mpụta ọnụ ụlọ ya nwere oghereikuku dị warawara gbaa gburugburu, dịka e nwere na ndị ọzọ niile. Ịdị ogologo ya dị iri mita abụọ na asaa, ebe obosara ya dị mita iri na atọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.25",
            "verseOrgIds": [
              "EZK.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nrigo nwere nzọ ụkwụ asaa dịkwa iji rigoo ya, mpụta ọnụ ụlọ ya dịkwa na ncherita ihu ha, o nwekwara ihe ịchọ mma osisi nkwụ e sere nʼahụ akụkụ aja ahụ, otu nʼotu akụkụ, nke ọzọ nʼakụkụ nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.26",
            "verseOrgIds": [
              "EZK.40.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 40:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogige nke dị nʼime, nwekwara ọnụ ụzọ ama nke na-echere ihu na ndịda. Ọ tụrụ site nʼotu ọnụ ụzọ ama ruo na nke chere ya ihu, ọ dị iri mita ise na anọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.27",
            "verseOrgIds": [
              "EZK.40.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ụzọ ndị na-eduba nʼogige ime",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 40:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O duuru m site nʼọnụ ụzọ dị na ndịda banye nʼogige dị nʼime. Ọ tụrụ ọnụ ụzọ mbata a hụ na ya na ọnụ ụzọ nke dị ọzọ bụ otu ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.28",
            "verseOrgIds": [
              "EZK.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnụ ụlọ ya niile, nʼakụkụ aja ya niile, na mpụta ọnụ ụlọ ya bụkwa otu ọtụtụ dịka ndị ọzọ niile. Ọnụ ụzọ ama ya na mpụta ọnụ ụlọ ya nwere oghere gbaa gburugburu. Ịdị ogologo ya dị iri mita abụọ na asaa, ebe obosara ya dị mita iri na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.29",
            "verseOrgIds": [
              "EZK.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpụta ọnụ ụlọ nke ndị dị gburugburu ogige nke ime, dị iri mita na atọ nʼobosara, na mita abụọ na ụma atọ nʼịdị omimi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.30",
            "verseOrgIds": [
              "EZK.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpụta ọnụ ụlọ ya chere ihu nʼogige dị nʼezi, oyiyi osisi nkwụ ka eji chọọ ogidi ọnụ ụlọ ahụ mma, ihe nrigo nwere nzọ ụkwụ asatọ ka eji arịgo ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.31",
            "verseOrgIds": [
              "EZK.40.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ogige ime na ọnụ ụzọ mbata ọwụwa anyanwụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 40:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọbatakwara m nʼogige dị nʼime site nʼọnụ ụzọ mbata nke ọwụwa anyanwụ. Ọ tụkwara ọnụ ụzọ ama ahụ, chọpụta na ya na ndị ọzọ bụkwa otu ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.32",
            "verseOrgIds": [
              "EZK.40.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 40:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnụ ụlọ ya niile, nʼakụkụ aja ya niile, na mpụta ọnụ ụlọ ya niile bụkwa otu ọtụtụ dịka ndị ọzọ niile. Ọnụ ụzọ ama ya na mpụta ọnụ ụlọ ya nwere oghere gbaa gburugburu. Ịdị ogologo ya dị iri mita abụọ na asaa, ebe obosara ya dị mita iri na atọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.33",
            "verseOrgIds": [
              "EZK.40.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 40:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpụta ọnụ ụlọ ya chere ihu nʼogige dị nʼezi. Oyiyi nkwụ e sere ese ka eji chọọ akụkụ ogidi ọnụ ụzọ ya mma, nʼakụkụ nke a, nakwa nʼakụkụ nke ọzọ. Ihe nrigo nwere nzọ ụkwụ asatọ ka eji arịgo ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.34",
            "verseOrgIds": [
              "EZK.40.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EZK 40:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m bịaruo nʼọnụ ụzọ ama mbata nke ugwu. Ọ tụrụ ya, chọpụta na ọtụtụ ya dịkwa ka nke ndị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.35",
            "verseOrgIds": [
              "EZK.40.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EZK 40:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka ọnụ ụlọ ya niile, nʼakụkụ aja ya niile, na mpụta ọnụ ụlọ ya, ha niile nwere oghere gbaa gburugburu. Ịdị ogologo ya dị iri mita abụọ na asaa, ebe obosara ya dị mita iri na atọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.36",
            "verseOrgIds": [
              "EZK.40.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EZK 40:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpụta ọnụ ụlọ ya chere ihu nʼogige dị nʼezi. Oyiyi nkwụ e sere ese ka eji chọọ akụkụ ogidi ọnụ ụzọ ya mma, nʼakụkụ nke a, nakwa nʼakụkụ nke ọzọ. Ihe nrigo nwere nzọ ụkwụ asatọ ka eji arịgo ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.37",
            "verseOrgIds": [
              "EZK.40.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ọnụụlọ dị iche iche ebe ikwado aja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EZK 40:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọnụụlọ nke nwere ọnụ ụzọ dịkwa nʼakụkụ mpụta ọnụ ụlọ nke ime ime ọnụ ụzọ ama ọbụla, ebe a na anọ asacha anụ aja nsure ọkụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.38",
            "verseOrgIds": [
              "EZK.40.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EZK 40:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime mpụta ọnụ ụlọ nke ọnụ ụzọ ama, ka tebul abụọ dị nʼotu akụkụ, abụọ nke ọzọ dịkwa nʼakụkụ nke ọzọ nke ọnụ ụlọ ahụ. Nʼelu ha ka a na-egbu anụ e ji achụ aja nsure ọkụ, maọbụ aja mmehie, maọbụ onyinye nʼihi aja ikpe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.39",
            "verseOrgIds": [
              "EZK.40.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EZK 40:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ mgbidi ezi nke mpụta ọnụ ụlọ nke ọnụ ụzọ ama, nʼakụkụ ihe nrigo nke dị na mbata ọnụ ụzọ ugwu, e nwere tebul abụọ, nʼakụkụ nke ọzọkwa nke ihe nrigo ahụ, e nwekwara tebul abụọ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.40",
            "verseOrgIds": [
              "EZK.40.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EZK 40:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e nwere tebul anọ nʼotu akụkụ ihe nrigo ahụ, nwekwa anọ nʼakụkụ nke ọzọ ya, ya bụ, tebul asatọ ma agụkọta ya ọnụ, ebe a na-anọ egbu anụ e ji achụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.41",
            "verseOrgIds": [
              "EZK.40.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EZK 40:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwekwara tebul anọ ndị ọzọ nʼime ọnụ ụlọ ahụ e ji nkume a wara awa wuo. Nʼelu ya ka a na-anọ akwado anụ a ga-eji chụọ aja nsure ọkụ. Ịdị elu tebul ndị a bụ iri sentimita asatọ. Obosara elu ha nʼakụkụ niile dị iri sentimita ise na atọ. Ngwongwo niile e ji egbu anụ e ji achụ aja na-adị nʼelu tebul ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.42",
            "verseOrgIds": [
              "EZK.40.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EZK 40:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji nko nke ịdị ogologo ya dị sentimita itoolu ejigidesi tebul ndị ahụ ike nʼahụ aja ụlọ. Nko ndị a dị gburugburu tebul ndị ahụ. Ọ bụkwa nʼelu tebul ndị a ka a na-edebe anụ niile e ji enye onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.43",
            "verseOrgIds": [
              "EZK.40.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s2"
      },
      "items": [
        {
          "text": "Ọnụ ụlọ ndị nchụaja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "EZK 40:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ogige dị nʼime, e nwere ọnụụlọ abụọ nke nwere ụzọ e si abanye nʼogige dị nʼime. Otu dị nʼakụkụ ọnụ ụzọ ama dị nʼugwu, chee ihu nʼọdịda anyanwụ, nke ọzọ dị nʼakụkụ ọnụ ụzọ ama dị nʼọdịda anyanwụ, chee ihu nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.44",
            "verseOrgIds": [
              "EZK.40.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "EZK 40:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gwara m, \"Ọnụụlọ ahụ dị nʼakụkụ ọnụ ụzọ ama dị nʼugwu bụ nke ndị nchụaja, ndị na-eje ozi nʼụlọnsọ ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.45",
            "verseOrgIds": [
              "EZK.40.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "EZK 40:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụụlọ nke dị nʼakụkụ ọnụ ụzọ ama chere ihu nʼugwu, bụ nke ndị nchụaja ndị na-eche ebe ịchụ aja nche. Ndị a bụ ụmụ ụmụ Zadọk. Ọ bụ naanị ha ka e kwere ka ha nwee ike ịbịaru",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.46",
            "verseOrgIds": [
              "EZK.40.46"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.40.46",
                "verseOrgIds": [
                  "EZK.40.46"
                ]
              }
            }
          ]
        },
        {
          "text": "nso, ijere ya ozi site nʼetiti ebo Livayị niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.46",
            "verseOrgIds": [
              "EZK.40.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "EZK 40:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụrụ ogige ime ahụ, chọpụta na ogologo ya dị iri mita ise na asatọ. Obosara ya bụkwa otu ihe ahụ. Ebe ịchụ aja dịkwa nʼihu ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.47",
            "verseOrgIds": [
              "EZK.40.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụlọnsọ ukwu ọhụrụ ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "EZK 40:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m bịaruo na mpụta ọnụ ụlọ nke ụlọnsọ ukwu ahụ, ọ tụrụ akụkụ ogidi ọnụ ụzọ nke mpụta ọnụ ụlọ ahụ, o ruru mita abụọ na ụma atọ nʼobosara, nʼakụkụ ya abụọ. Ebe mbata ya ruru mita asaa na ụma anọ nʼobosara, ebe akụkụ aja ụlọ ahụ ruru otu mita na ụma isii nʼobosara, nʼotu akụkụ nakwa nʼakụkụ nke ọzọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.48",
            "verseOrgIds": [
              "EZK.40.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "EZK 40:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe mpụta ọnụ ụlọ ahụ dị ihe ruru mita iri na otu nʼobosara, sitekwa nʼazụ ruo nʼihu ya ruru mita isii na ụma anọ. Ọ bụ ihe nrigo iri ka eji arịgo ya. Ogidi dịkwa nʼakụkụ ọnụ ụzọ abụọ ahụ otu nʼakụkụ nke a ọzọ nʼakụkụ nke ọzọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.40.49",
            "verseOrgIds": [
              "EZK.40.49"
            ]
          }
        }
      ]
