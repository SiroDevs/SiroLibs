  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "EZK 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnụụlọ ndị nchụaja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwoke ahụ duuru m gaa nʼakụkụ ugwu, banye nʼime ogige ahụ dị nʼezi, kpọbata m nʼime ọnụụlọ ndị ahụ dị na ncherita ihu nʼakụkụ ugwu nke ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.1",
            "verseOrgIds": [
              "EZK.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ ahụ nke ọnụ ụzọ ya chere ihu nʼebe ugwu dị iri mita ise na atọ nʼogologo, ebe obosara ya dị iri mita abụọ na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.2",
            "verseOrgIds": [
              "EZK.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼakụkụ nke dị iri mita na otu, site nʼime ogige nakwa nʼakụkụ nke dị na ncherita ihu pevumentị nke ogige dị nʼezi, ebe njegharị chere ebe njegharị ọzọ ihu, nʼokpukpu atọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.3",
            "verseOrgIds": [
              "EZK.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu ọnụụlọ ndị a, e nwere ka ụzọ njegharị nke dị mita ise na ụma atọ nʼobosara, dịkwa iri mita ise na atọ nʼogologo. Ọnụ ụzọ ha niile chere ihu nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.4",
            "verseOrgIds": [
              "EZK.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okpukpu ụlọ nke dị nʼelu asaghị mbara dịka nke dị nʼala, nʼihi na ebe njegharị ndị ahụ weere ọtụtụ oghere karịa ka ọ dị nʼọnụụlọ ndị dị okpukpu nke dị nʼala na nke etiti ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.5",
            "verseOrgIds": [
              "EZK.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe a na-ejighị ogidi wuo ụlọ a, dịka e si wuo ndị dị nʼogige, nke a mere ka ụlọ ndị dị nʼelu na-akpa nkpa karịa ndị nke dị nʼala, na ndị dị nʼetiti.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.6",
            "verseOrgIds": [
              "EZK.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nwere mgbidi aja nke dị nʼezi nʼakụkụ ọnụụlọ niile, nʼụzọ ogige nke dị nʼezi. Ọ mapụtara nʼihu ọnụụlọ ndị ahụ, ogologo ihe dị iri mita abụọ na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.7",
            "verseOrgIds": [
              "EZK.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọtụtụ ogologo ọnụụlọ ndị a, ndị dị nso nʼogige mpụta, ruru mita iri abụọ na itoolu, ebe ogologo ndị nke dịkarịsịrị nso ebe nsọ ahụ, ruru mita iri ise na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.8",
            "verseOrgIds": [
              "EZK.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼokpuru ọnụụlọ ndị a, e nwere ụzọ mbata nʼakụkụ ọwụwa anyanwụ, dịka mmadụ na-abata ha site nʼogige dị na mpụta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.9",
            "verseOrgIds": [
              "EZK.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ndịda, nʼogologo aja ụlọ dị nʼogige mpụta, nke dị nʼakụkụ ogige ụlọnsọ ukwu, nke chere aja ụlọ mpụta ihu, ọtụtụ ọnụụlọ dị ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.10",
            "verseOrgIds": [
              "EZK.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụzọ njegharị dị nʼetiti akụkụ abụọ ụlọ ahụ, ha dịkwa ka ọnụụlọ ndị ahụ nke dị nʼụzọ ugwu. Ogologo ha na obosara ha bụ otu; ha niile yiri onwe ha. Ọnụ ụzọ ya dịkwa ka ọnụ ụzọ dị nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.11",
            "verseOrgIds": [
              "EZK.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka ọnụ ụzọ e si abanye nʼime ọnụụlọ ndị a dị na ndịda si dị. E nwere ọnụ ụzọ na mpụta, nke dị na mgbidi ahụ chere ihu nʼọwụwa anyanwụ. Ebe a ka e si abanye nʼime ọnụụlọ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.12",
            "verseOrgIds": [
              "EZK.42.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị m, \"Ime ọnụụlọ niile dị nʼugwu, na ime ọnụụlọ ndị dị na ndịda, bụ ndị a chere ogige ụlọnsọ ahụ ihu, bụ ime ụlọ dị nsọ, nke ndị nchụaja. Ebe ndị nchụaja ndị na-abịa nso",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.42.13",
                "verseOrgIds": [
                  "EZK.42.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ịchụ aja ga-anọ rie nri niile nke kachasị nsọ, nʼebe ahụ ka ha ga-edebekwa aja ịnata ihuọma, aja mmehie na aja ikpe ọmụma, nʼihi na ụlọ ndị a dị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.13",
            "verseOrgIds": [
              "EZK.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị nchụaja bara nʼime ebe nsọ ahụ nke e kewapụrụ iche, ha aghaghị esikwa nʼebe ahụ pụta nʼogige mpụta ezi, tupu ruo mgbe ha yisara uwe ha yii jee ozi, nʼihi na uwe ndị a dị nsọ. Ha ga-eyiri uwe ọzọ, tupu ha abanye nʼakụkụ ụlọ ndị ahụ dịịrị ndị ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.14",
            "verseOrgIds": [
              "EZK.42.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ tụchara ihe ndị dị nʼime ebe ụlọnsọ ahụ, o duuru m site nʼọnụ ụzọ dị nʼọwụwa anyanwụ pụta, tụkwaa nʼakụkụ niile gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.15",
            "verseOrgIds": [
              "EZK.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji ihe ọtụtụ dị ogologo tụọ akụkụ ọwụwa anyanwụ, ọ dị ihe ruru narị mita abụọ na iri mita isii na ise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.16",
            "verseOrgIds": [
              "EZK.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji mkpirisi osisi ahụ e ji atụ ihe tụọ akụkụ nke ugwu ma chọpụta na ọ dị ihe ruru narị mita abụọ na iri mita isii na ise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.17",
            "verseOrgIds": [
              "EZK.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụkwara akụkụ nke ndịda, chọpụtakwa na ọ dị ihe ruru narị mita abụọ na iri mita isii na ise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.18",
            "verseOrgIds": [
              "EZK.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ tụgharịrị jirikwa ihe ọtụtụ ahụ tụọkwa akụkụ nke ọdịda anyanwụ. Ọ dị ihe ruru narị mita abụọ na iri mita isii na ise.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.19",
            "verseOrgIds": [
              "EZK.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ọ tụrụ akụkụ anọ niile nke ebe ahụ. Mgbidi gbara ya gburugburu. Ọtụtụ ha dị ihe ruru narị mita abụọ na iri mita isii na ise, nʼogologo, obosara ya dịkwa ihe ruru narị mita abụọ na iri mita isii na ise, iji kewapụta ebe dị nsọ site nʼebe ndị ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.42.20",
            "verseOrgIds": [
              "EZK.42.20"
            ]
          }
        }
      ]
    }
  ],
