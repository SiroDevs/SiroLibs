  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "TIT 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "TIT 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwụkwọ ozi a si nʼaka m, Pọl, odibo Chineke, na onyeozi Jisọs Kraịst, onye ahọpụtara ime ka okwukwe ndị Chineke, na nghọta banyere ịmara eziokwu ahụ na-eduba na ndụ ịsọpụrụ Chineke gaa nʼihu,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.1",
            "verseOrgIds": [
              "TIT.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke a dabere nʼolileanya maka ndụ ebighị ebi, nke Chineke onye na-adịghị agha ụgha kwerelarị na nkwa tupu mmalite nke oge.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.2",
            "verseOrgIds": [
              "TIT.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "TIT 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oge imezu nkwa ahụ ruru, o mere ka okwu ya pụta ìhè site na nkwusa oziọma, nke e nyefere m nʼaka idebe, dị ka Chineke Onye nzọpụta anyị si nye ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ gị Taịtọs, ezi nwa m nwoke nʼime okwukwe nke anyị nwekọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "TIT 1:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "TIT 1:4"
      },
      "items": [
        {
          "text": "Ka amara na udo nke sitere na Chineke bụ Nna, na Kraịst Jisọs Onye nzọpụta anyị dịrị gị.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ dịrị Taịtọs",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "TIT 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahapụrụ m gị na Kriit ka i dozie ihe ụfọdụ a na-edozibeghị, ka ị họpụtakwa ndị okenye nʼobodo niile, dị ka m siri nye gị nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.5",
            "verseOrgIds": [
              "TIT.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ onye a na-enweghị ihe ịta ụta, ọ ga-abụ onye na-alụ otu nwanyị. Ụmụ ya bụ ndị kwere ekwe, ndị ama na ha anaghị ebi ndụ ọjọọ, maọbụ na-eme isiike.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.6",
            "verseOrgIds": [
              "TIT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọ bụ na onye nlekọta nʼahụ ihe banyere chọọchị Chineke, ọ ga-abụ onye na-enweghị ihe ịta ụta. Ọ gaghị abụ onye nganga, onye na-ewe iwe ọkụ, onye na-aṅụbiga mmanya oke, onye na-alụ ọgụ mgbe niile, onye hụrụ ego nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ onye na-anabata ndị ọbịa, na onye na-ahụ ezi ihe nʼanya. Ọ ga-abụ onye na-akwanyere onwe ya ugwu, ezi mmadụ ụzọ ya kwụ ọtọ, onye dị nsọ, na onyeisi zuruoke.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụkwa onye jidesiri oziọma ahụ nke kwesiri ntụkwasị obi aka ike dịka eziri ya. Nke ga-eme ka o nwe ike gbaa ndị ọzọ ume site na ozizi ahụ nke zuruoke, nakwa ịtụ ndị ahụ na-eguzogide ya mmehie ha nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Igbochi ndị ozizi ụgha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e nwere ọtụtụ mmadụ ndị na-ekweghị, ndị na-ekwu okwu efu, na ndị aghụghọ, nke ka nke, ndị si nʼotu ndị obibi ugwu pụta.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.10",
            "verseOrgIds": [
              "TIT.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "TIT 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aghaghị ịkwụsị ha maka na ha na-akụzi ihe ha ekwesighị ikuzi nʼihi ego, si otu ahụ na-eme ka ọtụtụ ezinaụlọ gbasaa.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.11",
            "verseOrgIds": [
              "TIT.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "TIT 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ otu onye nʼime ha, onye bụkwa onye amụma ha kwuru okwu banyere ha sị, \"Ndị Kriit niile bụ ndị ụgha. Ha kwara obi nʼazụ dị ka anụ ọhịa jọrọ njọ. Ha bụ ndị umengwụ nwere akpịrị ogologo.\"",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.12",
            "verseOrgIds": [
              "TIT.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "TIT 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, okwu a bụ eziokwu. Nʼihi nke a, baara ha mba nʼolu ike banyere mmehie ha ka ha nwee ike zuo oke nʼokwukwe,",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.13",
            "verseOrgIds": [
              "TIT.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "TIT 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ha kwụsị ige ntị nʼakụkọ ifo ndị Juu na-akọ, maọbụ iwu nke ndị jụrụ ịnabata eziokwu nyere.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.14",
            "verseOrgIds": [
              "TIT.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile dị ọcha nʼebe ndị dị ọcha nọ, o nweghị ihe ọbụla dị ọcha nʼebe ndị rụrụ arụ na ndị na-ekweghị ekwe nọ. Nʼihi na uche ha na akọnuche ha rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.15",
            "verseOrgIds": [
              "TIT.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "TIT 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-ekwupụta na ha maara Chineke, ma ha ji omume ha na-agọnarị ya. Ha bụkwa ndị na-akpọ mmadụ ibe ha asị, ndị isiike, na ndị na-adịghị ike nʼezi ọrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.16",
            "verseOrgIds": [
              "TIT.1.16"
            ]
          }
        }
      ]
    }
  ],
