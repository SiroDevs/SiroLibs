  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "2KI 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịlaịja alaa eluigwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo mgbe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.1",
                "verseOrgIds": [
                  "2KI.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "chọrọ ị kpọrọ Ịlaịja laa nʼeluigwe site nʼoke ifufe, Ịlaịja na Ịlaisha nọ nʼụzọ sitere Gilgal.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.1",
            "verseOrgIds": [
              "2KI.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja sịrị Ịlaisha, \"Nọdụ nʼebe a, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "ziri m ozi ka m gaa Betel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:2"
      },
      "items": [
        {
          "text": "Ma Ịlaisha zara sị ya, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.2",
                "verseOrgIds": [
                  "2KI.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, na dịka gị onwe gị nọkwa na-adị ndụ, agaghị m ahapụ gị.\" Ya mere, ha abụọ sooro gaa Betel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.2",
            "verseOrgIds": [
              "2KI.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ, ụmụ okorobịa ndị amụma nọ na Betel pụtara zute ha abụọ. Ndị amụma ahụ bịakwutere Ịlaisha sị ya, \"Ị maara na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.3",
                "verseOrgIds": [
                  "2KI.2.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-esi nʼebe ị nọ wepụ onyenwe gị Ịlaịja taa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:3"
      },
      "items": [
        {
          "text": "Ịlaisha sịrị, \"Mụ onwe m maara, ma unu nọrọ nwayọọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.3",
            "verseOrgIds": [
              "2KI.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ịlaịja sịrị ya, \"Ịlaisha, nọdụ nʼebe a, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ziri m ozi ka m gaa Jeriko.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:4"
      },
      "items": [
        {
          "text": "Ma ọ zara, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.4",
                "verseOrgIds": [
                  "2KI.2.4"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, na dịka gị onwe gị nọkwa na-adị ndụ, agaghị m ahapụ gị.\" Ya mere ha abụọ sokwaara ruo Jeriko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.4",
            "verseOrgIds": [
              "2KI.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị otu ndị amụma nọ na Jeriko bịakwutere Ịlaisha nso jụọ ya, \"Ị maara na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.5",
                "verseOrgIds": [
                  "2KI.2.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ewepụ onyenwe gị taa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:5"
      },
      "items": [
        {
          "text": "Ọ zara, \"E, amaara m, ya mere nọọnụ nwayọọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.5",
            "verseOrgIds": [
              "2KI.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ịlaịja sịrị ya, \"Nọdụ nʼebe a, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ziri m ka m jee Jọdan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:6"
      },
      "items": [
        {
          "text": "Ma ọ zara, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.6",
                "verseOrgIds": [
                  "2KI.2.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na-adị ndụ, na dịka gị onwe gị nọkwa na-adị ndụ, agaghị m ahapụ gị.\" Ya mere, ha abụọ sooro na-eje.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.6",
            "verseOrgIds": [
              "2KI.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ndị amụma ise sitere nʼetiti ndị amụma sooro ha guzoro nʼebe dị anya na ncherita ihu ebe Ịlaịja na Ịlaisha kwụsịrị nʼakụkụ Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ịlaịja chịịrị uwe mwụda ya, pịakọtaa ya, tie ya nʼelu osimiri ahụ. Mmiri ahụ kewara ụzọ abụọ, ala akọrọ pụtakwara. Nʼebe ahụ ka Ịlaịja na Ịlaisha si gafee nʼofe ọzọ nke osimiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha abụọ gafesịrị, Ịlaịja jụrụ Ịlaisha ajụjụ sị ya, \"Gịnị ka ị chọrọ ka m meere gị tupu e site nʼebe ị nọ wepụ m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:9"
      },
      "items": [
        {
          "text": "Ịlaisha rịọrọ sị ya, \"Biko, mee ka m nweta ụdị mmụọ i nwere okpukpu abụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaịja zara sị ya, \"Ihe ị rịọrọ bụ ihe sịrị ike omume. Ọ bụrụ na ị hụ m mgbe a na-ewepụ m site nʼebe ị nọ, ị ga-enweta ihe ị rịọrọ. Ma ọ bụrụ na ị hụghị m, ị gaghị enweta ihe ị rịọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-aga nʼihu nʼije ha na-akparịta ụka, na mberede, ụgbọ ọkụ nke ịnyịnya ọkụ na-adọkpụ pụtara ihe kewaa ha abụọ. Mgbe ahụ kwa oke ifufe buuru Ịlaịja rigoro nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.11",
            "verseOrgIds": [
              "2KI.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha hụrụ ya, lelie anya elu tie mkpu akwa sị, \"Nna m! Nna m! Usuu ụgbọ agha na usuu ndị na-agba ịnyịnya Izrel!\" Ọ hụkwaghị Ịlaịja anya ọzọ. O jidere uwe o yi nʼahụ dọwaa ya ibe abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.12",
            "verseOrgIds": [
              "2KI.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ọ chịlịri uwe mwụda Ịlaịja nke dapụrụ mgbe e weliri ya elu, laghachi bịa guzo nʼakụkụ osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.13",
            "verseOrgIds": [
              "2KI.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tiri akwa ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "text": "nʼelu mmiri ahụ jụọ sị, \"Olee ebe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.14",
                "verseOrgIds": [
                  "2KI.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Ịlaịja nọ?\" Mgbe o tiri mmiri ahụ ihe, o kewakwara otu ụzọ nʼaka nri nke ọzọ nʼaka ekpe, Ịlaisha gafere nʼofe nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.14",
            "verseOrgIds": [
              "2KI.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị amụma ahụ si Jeriko nʼele anya, hụrụ ihe mere, ha sịrị, \"Mmụọ Ịlaịja adakwasịla Ịlaisha.\" Ha gara zute ya, kpọọ isiala nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.15",
            "verseOrgIds": [
              "2KI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha sịrị ya \"Lee, anyị bụ ndị ohu gị nwere iri ndị ikom ise ahụ siri ike. Kwere ka ha ga chọgharịa nna gị ukwu. Ma eleghị anya mmụọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.16",
                "verseOrgIds": [
                  "2KI.2.16"
                ]
              }
            }
          ]
        },
        {
          "text": "eburula ya tụdakwa ya nʼotu ugwu, maọbụ nʼotu ndagwurugwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 2:16"
      },
      "items": [
        {
          "text": "Ịlaisha zaghachiri, \"Unu ezigala ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.16",
            "verseOrgIds": [
              "2KI.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ha nọgidere rịọsie ya arịrịọ ike, ruo mgbe o nwekwaghị ike igbochi ha. Ọ gwara ha sị, \"Ọ dị mma, ziganụ mmadụ ka ha gaa chọọ ya.\" Ha zigara iri ndị ikom ise, ndị gara chọgharịa Ịlaịja ụbọchị atọ, ma ha achọtaghị ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.17",
            "verseOrgIds": [
              "2KI.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha nọ na Jeriko mgbe ndị a lọghachiri bịa kọọrọ ya otu ha si gaa. Mgbe ahụ, ọ gwara ha sị, \"Ọ bụ na m agwaghị unu sị unu ejela?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.18",
            "verseOrgIds": [
              "2KI.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ezi mmiri ọṅụṅụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị obodo ahụ sịrị Ịlaisha, \"Lee, onyenwe anyị, obodo anyị dị nʼebe dị mma, dịka gị onwe gị na-ahụ, ma mmiri dị nʼime ya jọrọ njọ, ala ya adịghị amịpụta mkpụrụ dịka o kwesiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.19",
            "verseOrgIds": [
              "2KI.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha zara sị ha, \"Ọ dị mma, gaanụ tinye nnu nʼime efere ọhụrụ wetara m ya.\" Ha gara weta efere ọhụrụ nke nnu juru nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.20",
            "verseOrgIds": [
              "2KI.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha buuru nnu ahụ gaa nʼebe mmiri ahụ si asọpụta, wụnye nnu ahụ nʼime ya. Mgbe ọ na-eme nke a, o kwuru okwu sị, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.21",
                "verseOrgIds": [
                  "2KI.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Agwọọla m mmiri a. Ọnwụ maọbụ amịghị mkpụrụ nke ala agaghị adịkwa.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.21",
            "verseOrgIds": [
              "2KI.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụbọchị ahụ gaa nʼihu, mmiri ahụ dịịrị ọcha ruo taa, dịka Ịlaisha kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.22",
            "verseOrgIds": [
              "2KI.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkọcha a kọchara Ịlaisha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Ịlaisha sitere na Jeriko pụọ ịlaghachi Betel. Mgbe ọ na-aga nʼụzọ, ụfọdụ ụmụ okorobịa nta sitere nʼime obodo pụta, bidoro jiri ya na-eme ihe ọchị, sị ya, \"Onyeisi nkwọcha, site nʼebe a pụọ! Onyeisi nkwọcha, site nʼebe a pụọ!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.23",
            "verseOrgIds": [
              "2KI.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha tụgharịrị lee ha anya, bụọ ha ọnụ nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.2.24",
                "verseOrgIds": [
                  "2KI.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": ". Otu mgbe ahụ, nne anụ ọhịa abụọ, a na-akpọ bịa, sitere nʼọhịa pụta, dọgbuo iri ụmụ okorobịa anọ na abụọ nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.24",
            "verseOrgIds": [
              "2KI.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Ịlaisha sitere nʼebe ahụ pụọ jeruo nʼugwu Kamel. Emesịakwa, o sitere nʼebe ahụ laghachi na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.25",
            "verseOrgIds": [
              "2KI.2.25"
            ]
          }
        }
      ]
    }
  ],
