  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2KI 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nlọghachi nwanyị Shunem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha gwara nwanyị ahụ o mere ka nwa ya si nʼọnwụ bilie okwu sị ya, \"Bilie, gị na ezinaụlọ gị, gaa nʼobodo ọzọ ebe unu ga-anọ dịka ọbịa nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.1",
                "verseOrgIds": [
                  "2KI.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola na oke ụnwụ ga-adakwasị ala Izrel afọ asaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị ahụ mere dịka onye nke Chineke gwara ya, o biliri, ya na ezinaụlọ ya gaa biri nʼala ndị Filistia",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        },
        {
          "text": "afọ asaa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụnwụ ahụ gwụsịrị nʼafọ nke asaa, o si nʼala ndị Filistia lọta nʼIzrel. Mgbe ọ lọtara, o jekwuuru eze ka o nyere ya aka inwetaghachi ụlọ ya na ala ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwanyị ahụ bịakwutere eze, eze nọ na-agwa Gehazi bụ onye na-ejere onye nke Chineke ozi okwu sị ya, \"Biko, kọọrọ m akụkọ ihe ukwu niile Ịlaisha mere.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Gehazi na-akọrọ eze otu Ịlaisha si mee ka nwantakịrị nwụrụ anwụ dị ndụ ọzọ, nwanyị ahụ, onye bụ nne nwantakịrị ahụ, batara nʼime ụlọeze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:5"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Gehazi kwuru sị, \"Onyenwe m eze, onye a bụ nwanyị ahụ, leekwa nwa ya nwoke, onye Ịlaisha mere ka ọ dị ndụ ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ nwanyị ahụ ajụjụ sị ya, \"Ọ bụ eziokwu?\" Nwanyị ahụ kọọrọ eze akụkọ ihe niile mere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:6"
      },
      "items": [
        {
          "text": "Mgbe ahụ, eze dunyere ya otu onyeisi nʼime ndị ozi ya ka o nyere ya aka inwetaghachi ihe ya niile, ya na ụgwọ ruru ya nʼihi mkpụrụ ubi ya niile ha ghọrọ mgbe ahụ o bi nʼala ndị Filistia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hazael egbuo Ben-Hadad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị Ịlaisha gara Damaskọs, isi obodo ndị Siria. Nʼoge a, Ben-Hadad eze Aram, na-arịa ọrịa. \"A gara gwa eze na onye nke Chineke abịala nʼebe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nụrụ ya, ọ kpọrọ Hazael sị ya, \"Were onyinye ịnata ihuọma nʼaka gị wegara onye nke Chineke, site nʼaka ya jụta",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.8",
                "verseOrgIds": [
                  "2KI.8.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ase. Jụọ ya, 'M ga-esi nʼọrịa a bilie?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael weere iri ịnyịnya kamel anọ buru ezi ihe niile si nʼala Damaskọs,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        },
        {
          "text": "wetara Ịlaisha onyinye ndị a sị ya, \"Nwa gị Ben-Hadad, eze Aram, zitere ka m jụọ gị sị, 'M ga-esi nʼọrịa a bilie?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha zara sị ya, \"Laa, gaa gwa ya sị ya, 'Ị ga-esi nʼọrịa bilie.' Ma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.10",
                "verseOrgIds": [
                  "2KI.8.10"
                ]
              }
            }
          ]
        },
        {
          "text": "egosila m na, nʼezie, ọ ga-anwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ịlaisha nọ na-ekwu okwu a, o legidere Hazael anya nʼihu tutu ruo mgbe ihere mere ya. Mgbe ahụ, onye nke Chineke kwara akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Hazael jụrụ Ịlaisha ajụjụ sị, \"Ọ bụ gịnị mere onyenwe m ji akwa akwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:12"
      },
      "items": [
        {
          "text": "Ịlaisha zara sị ya, \"Nʼihi na amaara m ihe ọjọọ ị ga-eme ụmụ Izrel nʼoge dị nʼihu. Ị ga-akpọ obodo niile ha e wusiri ike ọkụ, jiri mma agha gbuo ụmụ okorobịa ha. Ị ga-atụpịa ụmụntakịrị na-aṅụ ara, bọwakwaa afọ ndị inyom dị ime.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael sịrị, \"Olee otu ọrụ gị, bụ nkịta efu, ga-esi nwee ike imezu ihe ukwuu a?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:13"
      },
      "items": [
        {
          "text": "Ịlaisha zara, \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.13",
                "verseOrgIds": [
                  "2KI.8.13"
                ]
              }
            }
          ]
        },
        {
          "text": "egosila m na ị ga-abụ eze Aram.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hazael, si nʼebe Ịlaisha nọ laa, ọ bịakwutere nna ya ukwu. Mgbe Ben-Hadad jụrụ ya sị, \"Gịnị ka Ịlaisha gwara gị?\" Hazael zara sị, \"Ọ gwara m na ị ga-esi nʼọrịa bilie.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼechi ya, Hazael chịịrị akwa na-egbo oyi, banye ya na mmiri jiri ya baa nʼebe eze dina, gbasaa ya nʼihu eze, tutu ruo mgbe ọ nwụrụ. Emesịa, Hazael ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoram eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke ise nke ọchịchị Joram nwa Ehab eze Izrel, mgbe Jehoshafat bụ eze Juda, ka Jehoram nwa Jehoshafat malitere ọchịchị ya dịka eze Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.16",
            "verseOrgIds": [
              "2KI.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị iri afọ atọ na abụọ mgbe ọ malitere ịbụ eze, ọ chịrị afọ asatọ na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.17",
            "verseOrgIds": [
              "2KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "O soro ụzọ ndị eze Izrel dịka ụlọ Ehab mere, nʼihi na ọ lụrụ ada Ehab. O mere ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.18",
                "verseOrgIds": [
                  "2KI.8.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼagbanyeghị nke a, nʼihi ohu ya bụ Devid",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.19",
                "verseOrgIds": [
                  "2KI.8.19"
                ]
              }
            }
          ]
        },
        {
          "text": "achọghị ibibi Juda. Nʼihi na o kwere nkwa ime ka oriọna dịịrị Devid na ụmụ ụmụ ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge Jehoram bụ eze, ka Edọm si nʼokpuru Juda nupu isi, họpụtara onwe ha eze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
            "verseOrgIds": [
              "2KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Jehoram",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "text": "duuru ụgbọ agha ya niile gaa nʼobodo Zaịa. O biliri nʼabalị tigbuo ndị Edọm ahụ gbara ya na ndị ọchịagha ụgbọ agha ya gburugburu; ma ndị agha ya gbaghachiri azụ, laa nʼụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Edọm ka na-enupu isi megide Juda, ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:22"
      },
      "items": [
        {
          "text": "Obodo Libna nupukwara isi nʼotu oge ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ ihe niile Jehoram mere, e deghị ha nʼakwụkwọ akụkọ ihe ndị eze Juda mere nʼụbọchị ndụ ha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joram sooro ndị nna nna ya ha dina nʼọnwụ, e lie ya nʼebe e liri nna ya ha nʼobodo Devid. Ahazaya nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahazaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na abụọ nke ọchịchị Joram nwa Ehab, bụ eze Izrel, ka Ahazaya nwa Jehoram, bụ eze Juda malitere ịchị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazaya gbara iri afọ abụọ na abụọ mgbe ọ malitere ịbụ eze, ọ chịrị otu afọ na Jerusalem. Aha nne ya bụ Atalaya,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "text": "nwa nwa Omri, eze Izrel",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O soro ụzọ niile nke ndị ezinaụlọ Ehab, mee ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.8.27",
                "verseOrgIds": [
                  "2KI.8.27"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka ezinaụlọ Ehab mere, nʼihi na ọ lụrụ nwanyị si nʼezinaụlọ Ehab.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazaya sooro Joram nwa Ehab, gaa ibuso Hazael eze Aram",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "text": "agha na Ramọt Gilead. Ndị Aram merụrụ Joram ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze Joram lọghachitere na Jezril, ka a gwọọ ya mmerụ ahụ ndị Aram merụrụ ya na Ramọt, nʼagha nke ya na Hazael eze Aram lụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:29"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Ahazaya nwa Jehoram eze Juda, gara Jezril ileta Joram nwa Ehab, nʼihi na e merụrụ ya ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
    }
  ],
