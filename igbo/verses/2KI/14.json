  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "2KI 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amazaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke abụọ nke ịbụ eze Jehoash nwa Jehoahaz nʼIzrel, ka Amazaya nwa Joash eze Juda malitere ọchịchị ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.1",
            "verseOrgIds": [
              "2KI.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya gbara iri afọ abụọ na ise mgbe ọ malitere ịbụ eze. Ọ bụ eze na Jerusalem iri afọ abụọ na itoolu. Aha nne ya bụ Jehoadin, onye Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.2",
            "verseOrgIds": [
              "2KI.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.3",
                "verseOrgIds": [
                  "2KI.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ma o meghị dịka nna nna ya bụ Devid mere. Nʼihe niile, ọ gbasoro nzọ ụkwụ nna ya Joash.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.3",
            "verseOrgIds": [
              "2KI.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ wezugaghị ebe ịchụ aja niile dị nʼugwu. Ndị Juda gara nʼihu na-achụ aja na-esurekwa ihe nsure ọkụ na-esi isi ụtọ nʼelu ugwu ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.4",
            "verseOrgIds": [
              "2KI.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe alaeze ahụ siri ike nʼọchịchị ya, o gburu ndị ozi ahụ gburu eze, bụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.5",
            "verseOrgIds": [
              "2KI.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o meghị ka ụmụ ndị ogbu mmadụ ahụ nwụọ, nʼusoro ihe e dere nʼakwụkwọ iwu Mosis, ebe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.6",
                "verseOrgIds": [
                  "2KI.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere iwu sị: \"Agaghị eme ka ndị mụrụ ụmụ nwụọ nʼihi ihe ụmụ ha metara, maọbụ mee ka ụmụ nwụọ nʼihi ihe ndị mụrụ ha metara, onye ọbụla ga-anwụ nʼihi mmehie nke aka ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.6",
            "verseOrgIds": [
              "2KI.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya bụ onye gburu puku ndị agha Edọm iri na Ndagwurugwu Nnu, dọtakwa obodo Sela",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "text": "nʼagha, gụgharịa ya Jekteel,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        },
        {
          "text": "nke bụ aha a na-akpọ ya ruo ụbọchị taa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.7",
            "verseOrgIds": [
              "2KI.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Amazaya zigara ndị ozi ka ha jekwuru Jehoash nwa Jehoahaz nwa Jehu, eze Izrel, zie ya ozi ịma aka, sị, \"Bịa, ka dimkpa na ibe ya zute ihu na ihu nʼagha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jehoash eze Izrel zighachiri ozi nye Amazaya eze Juda sị ya, \"Uke dị na Lebanọn zigaara osisi sida nke dị na Lebanọn ozi, sị ya, 'Nye nwa m nwoke nwa gị nwanyị ka ọ bụrụ nwunye ya.' Mgbe ahụ, anụ ọhịa nke dị na Lebanọn gafetere ebe ahụ, zọpịa uke ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I meriela Edọm, nʼezie. Ugbu a, mpako abatala. Ṅụrịa ọṅụ nʼihi mmeri nke i nwetara, ma nọdụ nʼụlọ gị. Nʼihi gịnị ka ị ga-eji kpaliere onwe gị nsogbu, si otu a wetara onwe gị na Juda ọdịda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, Amazaya egeghị ntị. Ya mere, Jehoash bụ eze Izrel buliri agha, ya na Amazaya eze Juda zutere ihu na ihu nʼagha na Bet-Shemesh, dị nʼala Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel meriri ndị Juda, mee ka ha gbalaga, nwoke ọbụla nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash bụ eze Izrel nwudere Amazaya bụ eze Juda, nwa Joash, nwa Ahazaya na Bet-Shemesh. Mgbe ahụ, Jehoash gara Jerusalem kwada mgbidi Jerusalem, site nʼỌnụ ụzọ ama Ifrem",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "text": "ruo nʼọnụ ụzọ ama Nkuku, nke ogologo ya ruru narị nzọ ụkwụ isii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịkọrọ ọlaedo na ọlaọcha niile na ngwongwo niile ahụtara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.14",
                "verseOrgIds": [
                  "2KI.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nke dị nʼụlọakụ nke ụlọeze. Ọ dọtara ọtụtụ ndị mmadụ nʼagha, kpọrọ laghachi na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe banyere akụkọ ndị ọzọ gbasara ọchịchị Jehoash, na ihe o mere, na ihe ọ rụpụtara, tinyere agha ọ lụrụ megide Amazaya eze Juda, ọ bụ na-edeghị ha nʼakwụkwọ akụkọ ihe ndị eze Izrel mere nʼoge ha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash sooro nna nna ya ha dinaa nʼọnwụ, e lie ya na Sameria, ebe e liri eze ndị Izrel ndị ọzọ. Jeroboam nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazaya nwa Joash, eze Juda nọrọ ndụ afọ iri na ise, mgbe Jehoash nwa Jehoahaz, eze Izrel nwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.17",
            "verseOrgIds": [
              "2KI.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Amazaya, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.18",
            "verseOrgIds": [
              "2KI.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gbara izuzu imegide ya nʼime Jerusalem, ọ gbapụrụ gbalaga Lakish. Ma ha zipụrụ ndị ikom chụụrụ ya gaa Lakish, gbuo ya nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.19",
            "verseOrgIds": [
              "2KI.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bulatara ozu ya nʼelu ịnyịnya, e lie ya na Jerusalem nʼebe e liri ndị nna nna ya ha, nʼobodo Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.20",
            "verseOrgIds": [
              "2KI.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị Juda niile duuru Azaraya onye aha ya bụkwa Uzaya, onye gbara afọ iri na isii, mee ya eze nʼọnọdụ nna ya Amazaya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.21",
            "verseOrgIds": [
              "2KI.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya wugharịrị obodo Elat, nyeghachi ya Juda, mgbe Amazaya eze sooro ndị nna nna ya ha dina nʼọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeroboam nke abụọ eze Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na ise nke Amazaya nwa Joash, eze Juda, Jeroboam nwa Jehoash eze Izrel ghọrọ eze na Sameria. Ọ chịrị iri afọ anọ na otu dịka eze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma o mere ihe ọjọọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.24",
                "verseOrgIds": [
                  "2KI.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihi na o wezugaghị onwe ya site na mmehie Jeroboam nwa Nebat, onye ahụ dubara ndị Izrel na mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya weghachitara oke ala Izrel site na Lebo Hamat ruo nʼosimiri Araba, dịka okwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.25",
                "verseOrgIds": [
                  "2KI.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nke Izrel si dị, nke o kwuru site nʼọnụ Jona nwa Amitai, onye amụma si Gat Hefa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.26",
                "verseOrgIds": [
                  "2KI.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ ọnọdụ ọjọọ nke ndị Izrel nọ nʼime ya; onye ọbụla nʼime ha, ohu na onye nwe onwe ya, nọ nʼoke ahụhụ. Ọ dịkwaghị onye inyeaka ọbụla ha nwere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụghị uche",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.14.27",
                "verseOrgIds": [
                  "2KI.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": "ịla Izrel nʼiyi kpamkpam nʼokpuru eluigwe, nʼihi ya ka o mere ka Jeroboam nwa Jehoash napụta ha site nʼaka ndị iro ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ niile gbasara ihe niile Jeroboam mere, na ike ya niile, na agha niile o buru, na otu o si nwetaghachiri ndị Izrel obodo Damaskọs na Hamat, bụ obodo ndị Juda, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe ndị eze Izrel mere nʼụbọchị ndụ ha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.28",
            "verseOrgIds": [
              "2KI.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeroboam sooro ndị nna nna ya ha dina nʼọnwụ, e lie ya nʼebe e liri ndị eze Izrel nwụrụ anwụ. Ma Zekaraya nwa ya ghọrọ eze Izrel nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.29",
            "verseOrgIds": [
              "2KI.14.29"
            ]
          }
        }
      ]
    }
