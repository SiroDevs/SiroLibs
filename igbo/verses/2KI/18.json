{
  "id": "2KI.18",
  "number": "18",
  "bookId": "2KI",
  "reference": "2 Ndị Eze 18",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekaya eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke atọ nke ọchịchị Hoshea nwa Elaa eze Izrel ka Hezekaya nwa Ehaz eze Juda malitere ọchịchị nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbara iri afọ abụọ na ise mgbe ọ malitere ị bụ eze. Ọ chịrị iri afọ abụọ na itoolu na Jerusalem. Aha nne ya bụ Abija,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "text": "ada Zekaraya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.3",
                "verseOrgIds": [
                  "2KI.18.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịka nna nna ya Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wepụrụ ebe niile dị elu, kurisie ogidi nsọ niile, gbutukwa ogidi Ashera niile. O tipịakwara agwọ bronz ahụ Mosis mere, nʼihi na ruo nʼoge ahụ, ụmụ Izrel na-esure aja nsure ọkụ na-esi isi ụtọ nye ya. (A kpọrọ ya Nehushtan.)",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya tụkwasịrị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.5",
                "verseOrgIds": [
                  "2KI.18.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel obi ya. Nʼezie, o nwekwaghị onye ọzọ dị ka ya nʼetiti ndị eze Juda niile, ndị bu ya ụzọ chịa, na ndị so ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbasoro",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.6",
                "verseOrgIds": [
                  "2KI.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼụzọ niile. O sitekwaghị nʼụzọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.6",
                "verseOrgIds": [
                  "2KI.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "wezuga onwe ya. O debere ihe niile",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.6",
                "verseOrgIds": [
                  "2KI.18.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.7",
                "verseOrgIds": [
                  "2KI.18.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyeere ya nʼebe ọbụla ọ gara, ihe niile o mere gaara ya nke ọma. O nupuru isi jụ ịnọkwa nʼokpuru eze ndị Asịrịa, o fekwaghị ya ofufe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tigburu ndị Filistia nʼala ha niile ruo na Gaza, na obodo dị ya gburugburu. Ọ lara obodo ahụ niile nʼiyi, obodo ukwu niile e wusiri ike na obodo nta niile a na-ewusighị ike.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke anọ nke ọchịchị Hezekaya, nke bụkwa afọ nke asaa nke ọchịchị Hoshea nwa Elaa, bụ eze Izrel, Shalmanesa, eze Asịrịa gbagoro imegide Sameria, nọchibido ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe afọ atọ gasịrị, nʼafọ nke isii nke ọchịchị Hezekaya, na afọ nke itoolu nke ọchịchị Hoshea, bụ eze Izrel, ndị agha Asịrịa dọtara Sameria nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼoge ahụ ka eze Asịrịa bupụrụ ndị Izrel niile bulaa ha Asịrịa nʼime obodo Hala, na Gozan nʼakụkụ iyi ukwu Hoboa, na nʼobodo ndị Midia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere nʼihi na ha jụrụ ige ntị nʼolu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.12",
                "verseOrgIds": [
                  "2KI.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ha, jụkwa ime ihe ọ chọrọ ka ha mee. Ha edebeghị ọgbụgba ndụ ya na iwu niile Mosis onyeozi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.12",
                "verseOrgIds": [
                  "2KI.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ha. Ha jụrụ ige ntị nʼiwu ndị a, maọbụ debe ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na anọ nke ọchịchị eze Hezekaya, Senakerib bụ eze Asịrịa, busoro obodo Juda niile e wusiri ike agha, merikwaa ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Hezekaya chọrọ ụzọ ọ ga-esi mee udo, zie ozi zigara eze Asịrịa nʼobodo Lakish sị ya, \"Emehiela m, biko, site nʼala m pụọ. Aga m akwụ gị ihe ọbụla ị chọrọ nʼaka m.\" Eze Asịrịa sitere nʼaka Hezekaya eze Juda nara narị talenti ọlaọcha atọ, na iri talenti ọlaedo atọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya chịịrị ọlaọcha niile ọ chọtara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.15",
                "verseOrgIds": [
                  "2KI.18.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", na akụ niile dị nʼụlọeze, nye ya eze Asịrịa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Hezekaya bụ eze Juda, nyakapụtachara ọlaedo niile o ji techie ibo na ibo ọnụ ụzọ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.16",
                "verseOrgIds": [
                  "2KI.18.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", chịrị ihe ndị a niile nye eze Asịrịa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Senakerib ebuo agha megide Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Asịrịa sitere na Lakish zipụ ọchịagha",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "text": "onye ọkwa ya kasị ukwuu, onyeisi ndị na-eje ozi na ọchịagha ya na usuu ndị agha ka ha jekwuru Hezekaya na Jerusalem. Ndị agha a bịaruru Jerusalem kwụsị nʼakụkụ olulu warawara",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "text": "e gwuru ebe Ọdọ mmiri dị elu si nʼasọfe, nʼụzọ e si aga obosara ala ndị na-asụ akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha kpọrọ eze oku ka ọ bịa, Eliakịm nwa Hilkaya, onye nlekọta ụlọeze, na Shebna, ode akwụkwọ eze, na Joa nwa Asaf, onye ndekọ akụkọ ihe mere, pụrụ jekwuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịagha ahụ sịrị ha, \"Gwanụ Hezekaya:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2KI 18:19"
      },
      "items": [
        {
          "text": "\" 'Otu a ka eze ukwu ahụ, bụ eze Asịrịa na-ekwu, Ọ bụ na gịnị ka ntụkwasị obi gị dabere?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị na-ekwu na i nwere ndụmọdụ na ike ibu agha, maọbụ naanị egbe ọnụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "text": "ka ị na-agba. Ọ bụ onye ka ị na-atụkwasị obi mere i ji enupu isi nʼokpuru m?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, amatara m na ị na-atụkwasị obi nʼIjipt, mkpanaka achara ahụ gbajiri agbaji, nke na-adụwa aka onye ọbụla na-adabere na ya. Otu a ka Fero, eze Ijipt dị nye ndị niile na-atụkwasị ya obi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na unu asị m, \"Anyị na-atụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.22",
                "verseOrgIds": [
                  "2KI.18.22"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke anyị obi.\" Ọ bụghị ya ka Hezekaya wezugara ebe ya niile dị elu na ebe ịchụ aja ya niile, na-asị Juda na Jerusalem, \"Unu aghaghị ịkpọ isiala nʼebe ịchụ aja dị nʼime Jerusalem?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma ugbu a, bịa kwee nna m ukwu, bụ eze Asịrịa nkwa. Aga m enye gị puku ịnyịnya abụọ ma ọ bụrụ na i nwere ike ịchọta ndị ga-agba ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-esi aṅaa jụ otu onyeisi nke dịkarịsịrị nta nʼime ndịisi ọrụ onyenwe m, na-agbanyeghịkwa na i na-atụkwasị obi nʼIjipt maka inweta ụgbọ agha na ndị na-agba ịnyịnya?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinyere nke a, abịara m ibuso ala a agha na ibibi ya ma enweghị okwu sitere na Chineke bịa? Ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.25",
                "verseOrgIds": [
                  "2KI.18.25"
                ]
              }
            }
          ]
        },
        {
          "text": "ya onwe ya gwara m ka m bilie megide obodo a, lakwaa ya nʼiyi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Eliakịm nwa Hilkaya, Shebna na Joa sịrị ọchịagha ahụ, \"Biko, gwa ndị ohu gị okwu nʼasụsụ Aramaik,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        },
        {
          "text": "ebe ọ bụ na anyị na-aghọta ya. Agwala anyị okwu nʼasụsụ Hibru, ebe ndị nọ nʼelu mgbidi ga-anụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọchịagha ahụ zaghachiri, \"Ọ bụ nʼihi naanị nna unu ukwu na nye unu onwe unu ka nna m ukwu ji zite m, ka m kwuo ihe ndị a? Ọ bụghị nʼihi ndị mmadụ ahụ na-anọdụ nʼelu mgbidi, ndị, dịka unu, ha ga-eso rie nsị ha nyụrụ, ṅụọkwa mamịrị ha nyụrụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọchịagha ahụ guzoro were oke olu kwuo nʼasụsụ Hibru, sị, \"Nụrụnụ okwu eze ukwu ahụ, bụ eze Asịrịa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe eze sịrị, unu ekwela ka Hezekaya duhie unu. Ọ pụghị ịzọpụta unu site nʼaka m.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ekwela ka Hezekaya mee ka unu tụkwasị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.30",
                "verseOrgIds": [
                  "2KI.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "obi. Mgbe ọ na-asị, 'Nʼezie,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.30",
                "verseOrgIds": [
                  "2KI.18.30"
                ]
              }
            }
          ]
        },
        {
          "text": "aghaghị ịnapụta anyị, a gaghị enyefe obodo a nʼaka eze Asịrịa.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu aṅakwala Hezekaya ntị. Ihe a ka eze Asịrịa kwuru: Pụkwutenụ m, bịanụ ka mụ na unu mee udo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "text": "Mgbe ahụ, onye ọbụla nʼime unu ga-eri mkpụrụ si nʼubi vaịnị ya na nke si nʼosisi fiig ya, ṅụọkwa mmiri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "text": "nke si nʼihe icheta mmiri ya:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruo mgbe m ga-abịa duru unu gaa nʼala dịka nke unu, bụ ala mkpụrụ ọka na nke mmanya ọhụrụ, ala achịcha na ubi vaịnị, ala mmanụ aṅụ na osisi oliv jupụtara nʼime ya. Họrọnụ ndụ ka unu ghara ịnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 18:32"
      },
      "items": [
        {
          "text": "\"Unu egela Hezekaya ntị, nʼihi na ọ bụ nrafu ka ọ na-arafu unu mgbe ọ na-asị, '",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.32",
                "verseOrgIds": [
                  "2KI.18.32"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-anapụta anyị.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwere chi mba ọbụla nke napụtara ha site nʼaka eze Asịrịa?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ebe ka chi ndị Hamat na Apad nọ? Olee ebe ka chi ndị Sefavaim, Hena na Iva nọkwa? Ha anapụtala Sameria site nʼaka m?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee chi nʼime chi mba ndị a niile bụ nke zọpụtarala ala ya site nʼaka m? Unu si aṅaa chee na",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.18.35",
                "verseOrgIds": [
                  "2KI.18.35"
                ]
              }
            }
          ]
        },
        {
          "text": "pụrụ ịzọpụta Jerusalem site nʼaka m?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ahụ niile gbara nkịtị, ha ekwughị ihe ọbụla, nʼihi na eze nyere ha iwu sị, \"Unu azaghachila ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Eliakịm nwa Hilkaya, onye na-elekọta ụlọeze, na Shebna ode akwụkwọ eze, na Joa nwa Asaf ode akwụkwọ, ha yi uwe ha dọwara adọwa, bịakwute Hezekaya gwa ya ihe niile onyeisi agha ahụ kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
  ],
