  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "1SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekworo Sọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid gwasịrị Sọl okwu, ịhụnanya dị ukwuu malitere nʼetiti Jonatan na Devid. Jonatan hụrụ Devid nʼanya dịka o si hụ onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.1",
            "verseOrgIds": [
              "1SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl mere ka Devid nọgide nʼụlọeze. O kwekwaghị ka ọ laghachi nʼụlọ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.2",
            "verseOrgIds": [
              "1SA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatan na Devid gbara ndụ nʼihi na Jonatan hụrụ Devid nʼanya dịka o si hụ onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.3",
            "verseOrgIds": [
              "1SA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jonatan yipụtara uwe o yi nʼahụ nye ya Devid, nyekwa ya uwe ime ahụ ya, na ọ bụladị mma agha ya, ma ụta ya na eriri ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        },
        {
          "text": "ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.4",
            "verseOrgIds": [
              "1SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jeziri ozi niile Sọl ziri ya, o mere ihe niile nke ọma nke a mere na Sọl nyere ya ọkwa dị elu nʼetiti ndị agha ya. Ọnọdụ a dị mma nʼanya ndị Izrel nakwa nʼanya ndị agha Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.5",
            "verseOrgIds": [
              "1SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị agha ahụ na-alọghachite, mgbe Devid gbusịrị onye Filistia",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "text": "ahụ, ndị inyom",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "text": "sitere nʼobodo niile nke Izrel pụta izute eze Sọl. Ha na-abụ abụ na-ete egwu ọṅụ, nke ha ji ụbọ akwara na ihe egwu ndị ọzọ na-eti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.6",
            "verseOrgIds": [
              "1SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ha na-ete egwu, ha bụrụ abụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "\"Sọl egbuola ọtụtụ puku ndị agha",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "1SA 18:7"
      },
      "items": [
        {
          "text": "ma Devid egbuola iri puku kwụrụ puku ndị agha.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.7",
            "verseOrgIds": [
              "1SA.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a were Sọl iwe nke ukwuu. O kwuru nʼime onwe ya sị, \"Gịnị bụ nke a? Ha enyela Devid ugwu dịka onye gburu iri puku kwụrụ puku ndị agha, ma mụ onwe m ka ha nyere naanị ugwu dịka onye gburu ọtụtụ puku ndị agha. Gịnị ọzọ fọdụrụ ya ugbu a, ma ọ bụghị naanị inweta alaeze?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.8",
            "verseOrgIds": [
              "1SA.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼụbọchị ahụ gawa, Sọl malitere ile Devid anya ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.9",
            "verseOrgIds": [
              "1SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, mmụọ ọjọọ Chineke zitere bịara dakwasị Sọl, ọ malitekwara ibu amụma nʼụlọ ya. Ma Devid kpọrọ ụbọ akwara dịka ọ na-eme mgbe ọbụla. Ma nʼoge a, o nwere ùbe dị Sọl nʼaka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.10",
            "verseOrgIds": [
              "1SA.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụrụ ùbe ahụ, kwuo nʼobi ya sị, \"Aga m atụgide Devid nʼaja ụlọ ahụ.\" Ma Devid wezugara onwe ya, ugboro abụọ ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.11",
            "verseOrgIds": [
              "1SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl na-atụ Devid egwu, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.12",
                "verseOrgIds": [
                  "1SA.18.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ahapụla Sọl, ma nọnyere Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.12",
            "verseOrgIds": [
              "1SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Sọl mere ihe ga-eme ka ọ ghara ịhụkwa Devid anya ọzọ. O mere Devid ka ọ bụrụ onye na-elekọta puku ndị agha, ndị ọ na-edu na-aga ibu agha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.13",
            "verseOrgIds": [
              "1SA.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe niile ọ na-eme na-agara ya nke ọma, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.14",
                "verseOrgIds": [
                  "1SA.18.14"
                ]
              }
            }
          ]
        },
        {
          "text": "na-anọnyere ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.14",
            "verseOrgIds": [
              "1SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Sọl hụrụ na ọ bụ onye nwere uche nke ọma, ọ tụrụ ya ụjọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.15",
            "verseOrgIds": [
              "1SA.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Izrel na Juda niile hụrụ Devid nʼanya, nʼihi na ọ na-edu ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.16",
            "verseOrgIds": [
              "1SA.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl gwara Devid okwu sị ya, \"Lee ada m nwanyị Merab. Aga m akpọnye gị ya, ka ị lụọ ya. Naanị jeere m ozi, lụọkwa agha",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.17",
                "verseOrgIds": [
                  "1SA.18.17"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" Nʼihi na Sọl kwuru nʼime obi ya sị, \"Agaghị m ewelite aka m megide ya. Ka ndị Filistia mee nke ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.17",
            "verseOrgIds": [
              "1SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid sịrị Sọl, \"Onyekwanụ ka m bụ, gịnịkwa bụ ezinaụlọ m maọbụ agbụrụ m nʼIzrel, nke m ga-eji bụrụ ọgọ nwoke eze?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.18",
            "verseOrgIds": [
              "1SA.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo, na mgbe a ga-eduru Merab, ada Sọl dunye Devid, akpọrọ ya nye Adriel, onye Mehola ka ọ lụọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.19",
            "verseOrgIds": [
              "1SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, a chọpụtara na Mikal, ada Sọl hụrụ Devid nʼanya, mgbe e mere ka Sọl mata nke a, obi tọrọ ya ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.20",
            "verseOrgIds": [
              "1SA.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O kwuru nʼobi ya sị, \"Aga m akpọnye ya nwa m nwanyị, ka ọ bụrụ ihe ịma nʼọnya nye ya, ka aka ndị Filistia si otu a megide ya.\" Ya mere, Sọl gwara Devid sị ya, \"Ugbu a i nwekwara ohere ọzọ ịghọ ọgọ m nwoke.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.21",
            "verseOrgIds": [
              "1SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl nyere ndị ohu ya iwu sị, \"Gwanụ Devid okwu na nzuzo sị ya, 'Lee, ihe banyere gị masịrị eze, ndị niile na-ejere ya ozi hụkwara gị nʼanya. Ugbu a, kwerenụ ịbụ ọgọ ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.22",
            "verseOrgIds": [
              "1SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha gwara Devid okwu ndị a niile. Ma Devid zara sị, \"Ọ bụ ihe nta ịbụ ọgọ eze? Mụ onwe m bụ onye ogbenye, onye a na-amaghị ama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.23",
            "verseOrgIds": [
              "1SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ohu Sọl gwara Sọl ihe Devid kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ gwara ha sị, \"Gwanụ Devid, 'Eze achọghị ihe ọzọ dịka ụgwọ isi akụ ọbụla karịa naanị narị apị ndị Filistia. Ka ọ bụrụ ọbọ ọ ga-abọrọ m nʼisi ndị iro m.' \" Ma ihe Sọl bu nʼobi bụ na a ga-egbu Devid nʼọgụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ohu eze gwara Devid ihe eze kwuru, ọ tọrọ ya ụtọ, nʼihi ya, o kwenyere ịbụ ọgọ eze. Tupu oge ahụ a kara aka eruo,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid na ndị agha ya pụrụ gbuo narị ndị Filistia abụọ, werekwa apị ha gosi eze. Sọl kpọnyere Devid Mikal, nwa ya nwanyị, ka ọ bụrụ nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Sọl hụrụ na",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.18.28",
                "verseOrgIds": [
                  "1SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "na-anọnyere Devid, hụkwa na Mikal nwa ya nwanyị hụrụ Devid nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ tụrụ Devid ụjọ karịa na mbụ. Sọl kpọkwara Devid asị, gụọ ya dịka onye iro ụbọchị ndụ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
            "verseOrgIds": [
              "1SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi agha Filistia na-apụta ibu agha dịka ha na-eme mgbe ọbụla, ma Devid na-eme nke ọma karịa ndị ọchịagha Sọl ndị ọzọ niile. Nke a mere ka Devid ghọọ onye a mara aha ya nʼala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.30",
            "verseOrgIds": [
              "1SA.18.30"
            ]
          }
        }
      ]
    }
  ],
