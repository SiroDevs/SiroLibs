  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "1SA 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Samuel etee Devid mmanụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.1",
                "verseOrgIds": [
                  "1SA.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Samuel, \"Ruo ole mgbe ka ị ga-anọgide na-eru ụjụ nʼihi Sọl, ebe ọ bụ na m ajụla ya dịka eze ndị Izrel? Ugbu a, gbajuo mmanụ na mpi gị, bilie ije. Ana m eziga gị ka ijekwuru Jesi onye Betlehem, ahọrọla m otu onye ga-abụ eze site nʼetiti ụmụ ya ndị ikom.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.1",
            "verseOrgIds": [
              "1SA.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Samuel zara sị, \"Oleekwanụ otu m ga-esi gaa nʼebe ahụ? Ọ bụrụ na Sọl anụ ya, ọ ga-egbu m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:2"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.2",
                "verseOrgIds": [
                  "1SA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Were nwaagbọghọ ehi, jiri ya nʼaka, sị, 'Abịara m ịchụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.2",
                "verseOrgIds": [
                  "1SA.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "aja.'",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.2",
            "verseOrgIds": [
              "1SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-akpọ Jesi ka ọ bịa soro nʼọchụchụ aja ahụ. Mgbe ahụ, aga m egosi gị ihe ị ga-eme. Ị ga-etekwara m ya mmanụ, bụ onye m nke ga-egosi gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.3",
            "verseOrgIds": [
              "1SA.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuel mere ihe",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.4",
                "verseOrgIds": [
                  "1SA.16.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru. Mgbe o rutere na Betlehem, ndị okenye obodo ahụ ji ịma jijiji pụta izute ya. Ha jụrụ ya sị \"Ọ dịkwa mma? Udo ọ dịkwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.4",
            "verseOrgIds": [
              "1SA.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Samuel zara ha sị \"E, udo dị, Abịara m ịchụrụ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.5",
                "verseOrgIds": [
                  "1SA.16.5"
                ]
              }
            }
          ]
        },
        {
          "text": "aja. Doonụ onwe unu nsọ bịa soro m gaa ịchụ aja ahụ.\" O dokwara Jesi na ụmụ ya ndị ikom nsọ, gwakwa ha ka ha soro gaa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha ruru, Samuel hụrụ Eliab kwuo nʼobi ya sị, \"Nʼezie, onye nke",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.6",
                "verseOrgIds": [
                  "1SA.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": "tere mmanụ na-eguzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.6",
                "verseOrgIds": [
                  "1SA.16.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "zara Samuel sị ya, \"Ejila ihu mmadụ maọbụ ito ogologo ya ekpebi, nʼihi na onye a abụghị ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "adịghị ahụ ihe dịka mmadụ si ahụ. Mmadụ na-ele anya nʼelu ahụ, ma",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.7",
                "verseOrgIds": [
                  "1SA.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ele anya nʼobi.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesi kpọrọ Abinadab ka ọ gafee nʼihu Samuel. Ma Samuel sịrị, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.8",
                "verseOrgIds": [
                  "1SA.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọrọghị onye a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.8",
            "verseOrgIds": [
              "1SA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jesi mere ka Shama bịa gafee, ma Samuel sịrị, \"Mba",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.9",
                "verseOrgIds": [
                  "1SA.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọrọghị onye a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.9",
            "verseOrgIds": [
              "1SA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ndị ikom Jesi asaa si otu a gafee nʼihu Samuel, ma Samuel sịrị ya, \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.10",
                "verseOrgIds": [
                  "1SA.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọrọghị ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.10",
            "verseOrgIds": [
              "1SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ jụrụ Jesi sị, \"Ndị a ọ gwụchaala ụmụ ndị ikom ị mụtara?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Jesi zara sị \"O fọdụrụ ọdụdụ nwa m, ma ọ nọ nʼọhịa na-azụ atụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:11"
      },
      "items": [
        {
          "text": "Samuel sịrị, \"Ziga ozi kpọlata ya, anyị agaghị anọdụ ala tutu ruo mgbe ọ bịara.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.11",
            "verseOrgIds": [
              "1SA.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zigara ozi ka akpọọ ya, mee ka ọ bịa. O nwere ụcha ahụ pụrụ iche, nwee anya mara mma, dịkwa mma ile anya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 16:12"
      },
      "items": [
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.12",
                "verseOrgIds": [
                  "1SA.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Samuel okwu sị ya, \"Ọ bụ onye a, bilie tee ya mmanụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Samuel weere mpi ahụ mmanụ dị tee ya nʼihu ụmụnne ya. Site nʼụbọchị ahụ Mmụọ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.13",
                "verseOrgIds": [
                  "1SA.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwasịrị Devid nʼebe ọ dị ukwuu. Emesịa, Samuel laghachiri na Rema.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid aghọọ onye na-ejere Sọl ozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, Mmụọ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.14",
                "verseOrgIds": [
                  "1SA.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "esitela nʼime Sọl pụọ,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.14",
                "verseOrgIds": [
                  "1SA.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": "zitekwara mmụọ ọjọọ nke bịara na-esogbu Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-ejere Sọl ozi gwara ya okwu sị, \"Lee, mmụọ ọjọọ si nʼebe Chineke nọ bịa na-enye gị nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, ka onyenwe anyị nye ndị ohu ya nọ nʼebe a ike, ka ha gaa chọta onye maara akpọ ụbọ akwara nke ọma. Ọ ga-akpọ ụbọ akwara mgbe ọbụla mmụọ ọjọọ si nʼebe Chineke nọ bịa bịakwasịrị gị, ime ka ahụ dị gị mma.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl kwenyere sị ha, \"Ọ dị mma, gaanụ chọta ma kpọtara m nwoke na-akpọ ụbọ akwara nke ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu onye nʼime ndị na-eje ozi kwuru sị, \"Lee, ahụla m otu nʼime ụmụ ndị ikom Jesi, onye Betlehem, onye maara akpọ ụbọ akwara nke ọma. Ọ bụ dike na ọka nʼagha. Ọ bụ onye na-ekwu okwu nke ọma, na nwoke mara mma ile anya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1SA.16.18",
                "verseOrgIds": [
                  "1SA.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyekwara ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọl zipụrụ ndị ozi ka ha jekwuru Jesi sị ya, \"Zitere m nwa gị nwoke Devid, onye na-azụrụ gị atụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Jesi zipụrụ Devid ka o jekwuru Sọl. O mekwara ka Devid duru otu ịnyịnya ibu nke o bukwasịrị achịcha, na otu karama akpụkpọ mmanya, na otu nwa ewu, onyinye a na-enye Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid bịakwutere Sọl, banye nʼọrụ ijere ya ozi. Sọl hụrụ ya nʼanya nke ukwuu, nʼihi ya, Devid ghọrọ otu nʼime ndị na-ebu ihe agha Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Sọl ziri Jesi ozi sị ya, \"Biko, kwere ka Devid bụrụ otu nʼime ndị agha m, nʼihi na ihe ya na-atọ m ụtọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla mmụọ ọjọọ ahụ si nʼebe Chineke nọ bịa malitere inye Sọl nsogbu, Devid na-akpọ ụbọ akwara ya. Ahụ Sọl na-adajụkwa, mmụọ ọjọọ ahụ na-esitekwa nʼebe ọ nọ wezuga onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
            "verseOrgIds": [
              "1SA.16.23"
            ]
          }
        }
      ]
    }
  ],
