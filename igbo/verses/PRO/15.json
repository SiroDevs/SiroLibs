  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "PRO 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọsịsa okwu dị nro na-eme ka iwe na ọnụma laa azụ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:1"
      },
      "items": [
        {
          "text": "ma okwu ike na-akpali iwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.1",
            "verseOrgIds": [
              "PRO.15.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ire onye maara ihe na-eme ka ihe ọmụma mụbaa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:2"
      },
      "items": [
        {
          "text": "ma ọnụ onye nzuzu na-ekwupụta okwu enweghị uche.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.2",
            "verseOrgIds": [
              "PRO.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.3",
                "verseOrgIds": [
                  "PRO.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ahụzu ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:3"
      },
      "items": [
        {
          "text": "anya ya dịkwa nʼahụ ndị ọma na ndị ọjọọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.3",
            "verseOrgIds": [
              "PRO.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu dị nwayọọ na-eweta ndụ na ume;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:4"
      },
      "items": [
        {
          "text": "ma nkwutọ na-eweta ịda mba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.4",
            "verseOrgIds": [
              "PRO.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị onye nzuzu na-akpọ ndụmọdụ ndị mụrụ ya ihe efu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:5"
      },
      "items": [
        {
          "text": "ma onye ọbụla na-ege ntị nye mgbanwe na-ezipụta ezi uche.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.5",
            "verseOrgIds": [
              "PRO.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ ndị ezi omume na-ejupụta nʼọtụtụ akụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:6"
      },
      "items": [
        {
          "text": "ma akụ ndị na-emebi iwu na-ewetara ha nsogbu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.6",
            "verseOrgIds": [
              "PRO.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egbugbere ọnụ onye maara ihe na-agbasa ihe ọmụma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:7"
      },
      "items": [
        {
          "text": "ma obi ndị nzuzu ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.7",
            "verseOrgIds": [
              "PRO.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.8",
                "verseOrgIds": [
                  "PRO.15.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na-akpọ aja ndị ajọ omume asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:8"
      },
      "items": [
        {
          "text": "ma ekpere ndị ndụ ha ziri ezi na-atọ ya ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.8",
            "verseOrgIds": [
              "PRO.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.9",
                "verseOrgIds": [
                  "PRO.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kpọrọ ụzọ ndị na-emebi iwu asị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:9"
      },
      "items": [
        {
          "text": "ma ndị na-achụso ezi omume ka ọ na-ahụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.9",
            "verseOrgIds": [
              "PRO.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ịdọ aka na ntị na-echere ndị na-ahapụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:10"
      },
      "items": [
        {
          "text": "Onye kpọrọ ịba mba asị ga-anwụ ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.10",
            "verseOrgIds": [
              "PRO.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PRO.15.11",
                "verseOrgIds": [
                  "PRO.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "mazuru ihe omimi niile nke ọnwụ na ọkụ ala mmụọ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:11"
      },
      "items": [
        {
          "text": "ọ ga-esikwa aṅaa ghara ịma obi ụmụ mmadụ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.11",
            "verseOrgIds": [
              "PRO.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị atọ onye na-akwa emo ụtọ ma a baara ya mba,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:12"
      },
      "items": [
        {
          "text": "ya mere ọ dịghị ejekwuru onye maara ihe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.12",
            "verseOrgIds": [
              "PRO.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi nke na-aṅụrị ọṅụ na-eme ka ihu dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:13"
      },
      "items": [
        {
          "text": "Ihu gbarụrụ agbarụ na-egosi obi nwere ihe mwute.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.13",
            "verseOrgIds": [
              "PRO.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi nwere nghọta na-achọ ịmata ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:14"
      },
      "items": [
        {
          "text": "ma ọnụ onye nzuzu na-azụ onwe ya nʼokwu na-abaghị uru.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndụ onye ogbenye jupụtara nnọọ na mgbalị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 15:15"
      },
      "items": [
        {
          "text": "ma ndị nwere udo nʼobi na-eri oriri mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
