              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na agụụ na-agụ onye iro gị, nye ya nri ka o rie,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.21",
            "verseOrgIds": [
              "PRO.25.21"
            ]
          }
        }
