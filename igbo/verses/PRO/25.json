          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịtụkwasị onye aghụghọ obi nʼoge nsogbu dị ka iji eze na-eme ndakapụ ata ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.19",
            "verseOrgIds": [
              "PRO.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:19"
      },
      "items": [
        {
          "text": "maọbụ iji ụkwụ jiri eji agba ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.19",
            "verseOrgIds": [
              "PRO.25.19"
            ]
          }
        }
      ]
    },
    {
