      "attrs": {
        "style": "q2",
        "vid": "PRO 25:21"
      },
      "items": [
        {
          "text": "ọ bụrụkwa na akpịrị na-akpọ ya nkụ, nye ya mmiri ka ọ ṅụọ.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.21",
            "verseOrgIds": [
              "PRO.25.21"
