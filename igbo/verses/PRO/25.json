      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:20"
      },
      "items": [
        {
          "text": "maọbụ iwere nnu tee nʼelu ọnya,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.20",
            "verseOrgIds": [
              "PRO.25.20"
            ]
          }
        }
      ]
