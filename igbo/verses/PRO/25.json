          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka onye e yipụrụ uwe nʼụbọchị oyi ụgụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.20",
            "verseOrgIds": [
              "PRO.25.20"
            ]
