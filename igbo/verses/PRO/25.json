          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-agbagịde onye agbataobi ya ama ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.18",
            "verseOrgIds": [
              "PRO.25.18"
            ]
          }
        }
      ]
    },
