      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 25:18"
      },
      "items": [
        {
          "text": "dịka mkpọrọ osisi maọbụ mma agha, maọbụ àkụ a pịziri apịzi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.25.18",
            "verseOrgIds": [
              "PRO.25.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
