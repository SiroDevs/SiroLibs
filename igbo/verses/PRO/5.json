      "attrs": {
        "style": "q2",
        "vid": "PRO 5:19"
      },
      "items": [
        {
          "text": "ka ịhụnanya ya na-enye gị obi ụtọ mgbe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
