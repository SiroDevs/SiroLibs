              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị ka ị na-achọ nʼahụ nwanyị na-akwa iko?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.20",
            "verseOrgIds": [
