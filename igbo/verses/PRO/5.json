              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nne anụ nke na-ahụ nʼanya, dịka ele mara mma,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
