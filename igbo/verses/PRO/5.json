      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 5:19"
      },
      "items": [
        {
          "text": "ka ara dị ya nʼobi zuore gị,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.19",
            "verseOrgIds": [
              "PRO.5.19"
            ]
          }
