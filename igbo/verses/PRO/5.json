      "attrs": {
        "style": "q2",
        "vid": "PRO 5:20"
      },
      "items": [
        {
          "text": "Gịnị mere i ji na-amaku nwunye onye ọzọ obi?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.5.20",
            "verseOrgIds": [
              "PRO.5.20"
            ]
          }
