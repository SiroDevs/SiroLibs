      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ZEP 1:12"
      },
      "items": [
        {
          "text": "ndị na-eche nʼobi ha sị, 'O nweghị ihe",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        },
