      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:10"
      },
      "items": [
        {
          "text": "mkpu nke ịkwasi akwa ike ga-ada site nʼebe obibi ọhụrụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        }
      ]
