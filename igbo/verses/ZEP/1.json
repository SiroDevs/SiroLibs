          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwasienụ akwa ike unu ndị niile bi nʼakụkụ ebe ahịa dị;",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
