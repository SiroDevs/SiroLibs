      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:9"
      },
      "items": [
        {
          "text": "bụ ndị niile na-adịghị azọ ụkwụ nʼọnụ ụzọ mbata,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
