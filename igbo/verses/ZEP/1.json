      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "nʼihi na a ga-egbuchapụ ndị ahịa unu niile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:11"
      },
      "items": [
        {
          "text": "Ndị niile na-eji ọlaọcha azụ ahịa ka a ga-ebibi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.11",
            "verseOrgIds": [
              "ZEP.1.11"
            ]
