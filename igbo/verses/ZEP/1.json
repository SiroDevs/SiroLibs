                "verseOrgIds": [
                  "ZEP.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-eme anyị,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
