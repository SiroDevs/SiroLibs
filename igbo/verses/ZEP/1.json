            "sid": "ZEP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, aga m eji oriọna nyobanyechaa anya nʼakụkụ niile nke Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:12"
      },
      "items": [
        {
          "text": "Aga m ata ndị ahụ niile na-anọ nʼahụ dị jụụ ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ZEP 1:12"
      },
      "items": [
        {
          "text": "bụ ndị ahụ dọọrọ dịka ike mmanya a ṅụfọdụrụ aṅụfọ,",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.12",
            "verseOrgIds": [
              "ZEP.1.12"
            ]
          }
        }
      ]
    },
