              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, aga m ata ha ahụhụ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
