      "attrs": {
        "style": "q2",
        "vid": "ECC 10:16"
      },
      "items": [
        {
          "text": "nke ndị na-achị achị bụ ndị na-akpọ oriri nʼụtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
              "ECC.10.16"
            ]
