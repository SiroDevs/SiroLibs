              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ ga-adịrị ala nke eze ya bụ nwantakịrị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.16",
            "verseOrgIds": [
