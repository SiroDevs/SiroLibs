      "attrs": {
        "style": "q2",
        "vid": "ECC 10:17"
      },
      "items": [
        {
          "text": "nke ụmụ eze ya na-eri ihe mgbe o kwesiri nʼihi inweta ike,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.10.17",
            "verseOrgIds": [
