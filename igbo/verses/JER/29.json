  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "29",
        "style": "c",
        "sid": "JER 29"
      },
      "items": [
        {
          "text": "29",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwụkwọ ozi nye ndị a dọtara nʼagha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a bụ ihe dị nʼakwụkwọ ozi Jeremaya onye amụma si Jerusalem degaara ndị fọdụrụ ndụ nʼetiti ndị okenye, na ndị nchụaja, na ndị amụma, na ndị Izrel Nebukadneza dọtara nʼagha si na Jerusalem bulaa ha Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.1",
            "verseOrgIds": [
              "JER.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ mgbe eze Jehoiakin, nne eze, ndị ozi nʼụlọeze, ndị ndu Juda na Jerusalem, ndị ọka, na ndị ụzụ sitere na Jerusalem dọta ha nʼagha buru ha gaa mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.2",
            "verseOrgIds": [
              "JER.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye Jeremaya nyere akwụkwọ ozi a ka o nyeruo ndị e deere ya bụ Eleasa nwa Shefan, na Gemaraya nwa Hilkaya, ndị Zedekaya eze Juda zigara Babilọn izi Nebukadneza bụ eze ozi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.3",
            "verseOrgIds": [
              "JER.29.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.4",
                "verseOrgIds": [
                  "JER.29.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel na-agwa ndị niile m mere ka e si na Jerusalem dọta nʼagha buru laa Babilọn,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.4",
            "verseOrgIds": [
              "JER.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Wuoronụ onwe unu ụlọ, birikwanụ nʼime ya; kụọnụ ihe nʼubi a gbara ogige, riekwa mkpụrụ si na ya;",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.5",
            "verseOrgIds": [
              "JER.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "lụọnụ nwunye, mụọkwanụ ụmụ ndị ikom na ụmụ ndị inyom; lụọkwaranụ ụmụ unu ndị ikom nwunye, kwenyekwanụ ka ụmụ unu ndị inyom lụọ di, ka ha mụọkwa ụmụ ndị ikom na ụmụ ndị inyom. Mụbaanụ nʼebe ahụ, unu ebilatakwala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.6",
            "verseOrgIds": [
              "JER.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chọọnụ udo nke obodo ahụ m mere ka unu gaa biri nʼime ya. Kpeekwanụ ekpere nye",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.7",
                "verseOrgIds": [
                  "JER.29.7"
                ]
              }
            }
          ]
        },
        {
          "text": "banyere ya. Nʼihi na ọ bụrụ na ihe agaara obodo ahụ nke ọma, ọ ga-agakwara unu nke ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.7",
            "verseOrgIds": [
              "JER.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.8",
                "verseOrgIds": [
                  "JER.29.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile bụ Chineke Izrel kwuru, \"Unu ekwela ka ndị amụma ahụ nọ nʼetiti unu, na ndị na-ajụ arụsị ase rafuo unu; unu egela ntị nʼakụkọ ha na-akọ banyere nrọ ndị ahụ unu na-akwagide ha ka ha rọọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.8",
            "verseOrgIds": [
              "JER.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na amụma ha na-ebu nʼaha m bụ amụma ụgha. Ọ bụkwaghị m zitere ha.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.9",
                "verseOrgIds": [
                  "JER.29.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.9",
            "verseOrgIds": [
              "JER.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.10",
                "verseOrgIds": [
                  "JER.29.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, \"Mgbe iri afọ asaa m kwadoro maka Babilọn zuru, aga m abịa mezuo nkwa ahụ m kwere. Aga m eme ka unu lọtakwa nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.10",
            "verseOrgIds": [
              "JER.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mụ onwe m maara echiche niile m na-eche banyere unu,\" ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.11",
                "verseOrgIds": [
                  "JER.29.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri, \"echiche ime ka ihe gaara unu nke ọma, ọ bụkwaghị echiche ime unu ihe ọjọọ, echiche ime ka unu nwee ezi ọdịnihu, na olileanya kwesiri ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.11",
            "verseOrgIds": [
              "JER.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, unu ga-abịakwute m, unu ga-abịa kpọkuokwa m nʼekpere, aga m egekwa unu ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.12",
            "verseOrgIds": [
              "JER.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-achọsikwa m ike, chọta m ma ọ bụrụ na unu ejiri obi unu niile chọọ m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.13",
            "verseOrgIds": [
              "JER.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m emekwa ka unu chọta m,\" otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.14",
                "verseOrgIds": [
                  "JER.29.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri, \"meekwa ka unu bụ ndị a dọtara nʼagha lọta. Aga m esitekwa na mba ahụ niile m chụgara unu chịkọtaa unu, kpọghachitekwa unu nʼebe ahụ m si chụpụ unu.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.14",
                "verseOrgIds": [
                  "JER.29.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.14",
            "verseOrgIds": [
              "JER.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu pụrụ ị sị, \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.15",
                "verseOrgIds": [
                  "JER.29.15"
                ]
              }
            }
          ]
        },
        {
          "text": "akpọlite ndị amụma nye anyị na Babilọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.15",
            "verseOrgIds": [
              "JER.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ndị a ka Onyenwe anyị na-ekwu banyere eze ahụ na-anọkwasị nʼocheeze Devid, na banyere ndị mmadụ niile fọdụrụ nʼobodo a, bụ ụmụnne unu ndị ahụ na-esoghị unu gaa ebe e mere ka ha ga biri na mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.16",
            "verseOrgIds": [
              "JER.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.17",
                "verseOrgIds": [
                  "JER.29.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru, \"Aga m eziga mma agha nʼetiti ha, zigakwa ụnwụ na ọrịa na-efe efe. Aga m eme ha ka ha dị ka mkpụrụ fiig jọgburu onwe ya, nke mmadụ na-agaghị ata ata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.17",
            "verseOrgIds": [
              "JER.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eji mma agha, na ụnwụ, na ọrịa na-efe efe, chụọ ha ọsọ. Aga m eme ha ka ha bụrụ ihe alaeze niile nke ụwa ga na-asọ oyi. Ha ga-abụ ihe ịbụ ọnụ, na ihe iju anya, na ihe nkọcha, na ihe ịta ụta nʼetiti mba niile ebe m ga-achụla ha ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.18",
            "verseOrgIds": [
              "JER.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha egeghị ntị nʼokwu m, bụ okwu si nʼọnụ ndị ohu m bụ ndị amụma, ndị m zigaara ha mgbe mgbe. Ma unu onwe unu, ndị bi na mba ọzọ egekwaghị ntị nʼokwu m.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.19",
                "verseOrgIds": [
                  "JER.29.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.19",
            "verseOrgIds": [
              "JER.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nụrụnụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.20",
                "verseOrgIds": [
                  "JER.29.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", unu niile bụ ndị m mere ka e si na Jerusalem dọta nʼagha gaa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.20",
            "verseOrgIds": [
              "JER.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.21",
                "verseOrgIds": [
                  "JER.29.21"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel na-ekwu banyere Ehab nwa Kolaya, na Zedekaya nwa Maaseia, ndị na-ebu amụma ụgha nʼaha m, \"Aga m ewere ha nyefee nʼaka Nebukadneza bụ eze Babilọn. Ọ ga-etigbukwa ha nʼihu unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.21",
            "verseOrgIds": [
              "JER.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ha, ndị niile e si Juda dọta nʼagha buru gaa Babilọn ga na-ekwu okwu nkọcha sị, 'Ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.22",
                "verseOrgIds": [
                  "JER.29.22"
                ]
              }
            }
          ]
        },
        {
          "text": "mesokwa gị ụdị mmeso o mesoro Zedekaya na Ehab, ndị eze Babilọn tụnyere nʼọkụ nke regburu ha.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.22",
            "verseOrgIds": [
              "JER.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha emeela ihe ndị jọgburu onwe ya na njọ nʼIzrel; ha na nwunye ndị agbataobi ha akwaala iko; ha esitekwala nʼaha m buo amụma ụgha, amụma nke m na-enyeghị ha iwu ibu. Amaara m na ihe ndị a bụ eziokwu, nʼihi na ahụrụ m ya.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.23",
                "verseOrgIds": [
                  "JER.29.23"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.23",
            "verseOrgIds": [
              "JER.29.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ozi e ziri Shemaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa Shemaya onye Nehelam okwu sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.24",
            "verseOrgIds": [
              "JER.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.25",
                "verseOrgIds": [
                  "JER.29.25"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, \"I dere akwụkwọ zigara ndị niile bi na Jerusalem, ha na Zefanaya nwa Maaseia onye nchụaja, na ndị nchụaja ndị ọzọ. Ị gwara Zefanaya okwu nʼakwụkwọ ahụ sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.25",
            "verseOrgIds": [
              "JER.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "'",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.26",
                "verseOrgIds": [
                  "JER.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": "ahọpụtala gị mee gị onye nchụaja ga-anọchi anya Jehoiada. Nʼihi ya, ị bụrụla onyeisi ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.26",
                "verseOrgIds": [
                  "JER.29.26"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ya mere, o kwesiri ka i jide onye ara ọbụla na-akpọ onwe ya onye amụma, manye ya agbụ igwe nʼụkwụ, na nʼolu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.26",
            "verseOrgIds": [
              "JER.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji hapụ ịbasiri Jeremaya, onye Anatot mba ike, onye na-eme onwe ya onye amụma nʼetiti unu?",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.27",
            "verseOrgIds": [
              "JER.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ziterela anyị ozi dị otu a na Babilọn sị anyị, Unu ga-anọ nʼebe ahụ tee anya. Ya mere, wuoronụ onwe unu ụlọ, birikwanụ nʼime ya. Kụọnụ ihe nʼubi, riekwanụ ihe si nʼubi unu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.28",
            "verseOrgIds": [
              "JER.29.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zefanaya bụ onye nchụaja, gụrụ akwụkwọ ozi ahụ nʼihu Jeremaya, bụ onye amụma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.29",
            "verseOrgIds": [
              "JER.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.30",
                "verseOrgIds": [
                  "JER.29.30"
                ]
              }
            }
          ]
        },
        {
          "text": "bịakwutere Jeremaya, sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.30",
            "verseOrgIds": [
              "JER.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Zigara ndị ahụ niile e mere ka ha gaa biri na mba ọzọ ozi sị ha, 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.31",
                "verseOrgIds": [
                  "JER.29.31"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru banyere Shemaya onye Nehelam, Ebe ọ bụ na Shemaya ebuorola unu amụma mee ka unu tụkwasị obi unu nʼokwu ụgha ya, ma ọ bụghị m ziri ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.31",
            "verseOrgIds": [
              "JER.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.32",
                "verseOrgIds": [
                  "JER.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Mụ onwe m aghaghị ịta Shemaya onye Nehelam na mkpụrụ ya ahụhụ nʼihi mmehie ya. Ọ gaghị enwe nwoke ọbụla ga-afọdụ ndụ nʼetiti ndị ya niile. Ọ gaghị esokwa unu lekwasị anya nʼihe ọma ahụ niile m na-akwado imere ndị m, nʼihi na o kwusara nnupu isi megide",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.32",
                "verseOrgIds": [
                  "JER.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": ". Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.29.32",
                "verseOrgIds": [
                  "JER.29.32"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.29.32",
            "verseOrgIds": [
              "JER.29.32"
            ]
          }
        }
      ]
    }
