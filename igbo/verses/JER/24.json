      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkata fiig abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.1",
                "verseOrgIds": [
                  "JER.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gosiri m nkata fiig abụọ, nke a dọbara nʼihu ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.1",
                "verseOrgIds": [
                  "JER.24.1"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nʼoge a, Nebukadneza eze Babilọn esitelarị na Jerusalem dọkpụrụ Jehoiakin nwa Jehoiakim, eze Juda, na ndịisi Juda, na ndị ọka, na ndị ụzụ, mee ka ha gaa biri na Babilọn, nke dị na mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.1",
            "verseOrgIds": [
              "JER.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nkata nwere mkpụrụ fiig mara mma, dịka ndị ahụ na-ebu ụzọ acha, nkata nke ọzọ nwere mkpụrụ fiig nke jọrọ njọ, ha jọrọ njọ na mmadụ enweghị ike ịracha ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.2",
            "verseOrgIds": [
              "JER.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.3",
                "verseOrgIds": [
                  "JER.24.3"
                ]
              }
            }
          ]
        },
        {
          "text": "jụrụ m ajụjụ sị m, \"Jeremaya, gịnị ka ị hụrụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 24:3"
      },
      "items": [
        {
          "text": "Azara m sị ya, \"Ahụrụ m mkpụrụ fiig. Ụfọdụ dị nnọọ ezi mma, ma ndị ọzọ jọrọ njọ. Ha adịghịkwa mma nracha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.3",
            "verseOrgIds": [
              "JER.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.4",
                "verseOrgIds": [
                  "JER.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.4",
            "verseOrgIds": [
              "JER.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.5",
                "verseOrgIds": [
                  "JER.24.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke Izrel kwuru: Ndị ahụ m mere ka e si na Juda dọta nʼagha, ndị e buuru gaa nʼala Kaldịa dị m dịka mkpụrụ osisi fiig ndị a mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.5",
            "verseOrgIds": [
              "JER.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya m ga-adịkwasị ha nʼahụ ịhụ na ihe gaara ha nke ọma. Aga m akpọghachitekwa ha nʼala a. Aga m ewulikwa ha elu ghara ikwada ha; Aga m akụ ha dịka osisi ghara ihopu ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m enye ha ụdị obi ha ga-eji mata m, na m bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.7",
                "verseOrgIds": [
                  "JER.24.7"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha ga-abụ ndị m, mụ onwe m ga-abụkwa Chineke ha. Nʼihi na obi ha niile ka ha ga-eji lọghachikwute m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma dịka fiig ọjọọ ndị a, bụ ndị dị njọ nke ukwuu na-enweghị ike iri ha eri,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.24.8",
                "verseOrgIds": [
                  "JER.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, 'otu a ka m gaa emeso Zedekaya, eze Juda, na ndịisi ọchịchị ya, na ndị ahụ niile fọdụrụ ndụ na Jerusalem, ma ha bi nʼime ya, maọbụ biri nʼIjipt.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.8",
            "verseOrgIds": [
              "JER.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ha ghọọrọ alaeze niile nke ụwa ihe ịsọ oyi, na ihe na-eweta obi ọjọọ. Ha ga-aghọ ihe ịta ụta, na ihe e ji akọ akụkọ, na ihe nkọcha na ihe ịbụ ọnụ nʼebe ọbụla m mere ka ha gaa biri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ezigakwa mma agha na ụnwụ na ọrịa na-efe efe nʼetiti ha, tutu ruo mgbe e mere ka ha gwụsịa nʼelu ala ahụ nke m nyere ha, nyekwa ndị bụ nna nna ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.10",
            "verseOrgIds": [
              "JER.24.10"
            ]
          }
        }
      ]
    }
  ],
