  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JER 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jeremaya nʼime olulu mmiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shefataya nwa Matan, na Gedaliya nwa Pashua, na Jehukal",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.1",
            "verseOrgIds": [
              "JER.38.1"
            ]
          }
        },
        {
          "text": "nwa Shelemaya, na Pashua, nwa Malkija, nụrụ mgbe Jeremaya nọ na-agwa ndị mmadụ okwu ndị a sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.1",
            "verseOrgIds": [
              "JER.38.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.2",
            "verseOrgIds": [
              "JER.38.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.2",
                "verseOrgIds": [
                  "JER.38.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Onye ọbụla nọgidere nʼime obodo a ga-anwụ site na mma agha, maọbụ site nʼụnwụ, maọbụ site nʼọrịa na-efe efe. Ma onye ọbụla pụkwuru ndị Babilọn ga-adị ndụ. Ọ ga-adị ndụ, nʼihi na ọ ga-echebe ndụ ya.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.2",
            "verseOrgIds": [
              "JER.38.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a kwa ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.3",
            "verseOrgIds": [
              "JER.38.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.3",
                "verseOrgIds": [
                  "JER.38.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'A ga-arara obodo a nyefee ya nʼaka ndị agha eze Babilọn, onye ga-adọta ya nʼagha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.3",
            "verseOrgIds": [
              "JER.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndịisi ọchịchị sịrị eze, \"O kwesiri ka e gbuo nwoke a, nʼihi na ọ na-eme ka obi ndị agha na obi ndị mmadụ fọdụrụ nʼime obodo a na-ada mba site nʼụdị okwu ọ na-agwa ha. Ọ bụghị ọdịmma ndị a ka ọ na-eche echiche ya, kama ọ bụ otu ha ga-esi laa nʼiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.4",
            "verseOrgIds": [
              "JER.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekaya bụ eze zara sị ha, \"Ọ dị unu nʼaka. Unu maara na o nweghị ihe ọbụla eze nwere ike ime igbochi unu ime ihe unu chọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.5",
            "verseOrgIds": [
              "JER.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ha jidere Jeremaya, tinye ya nʼime olulu mmiri Malkija, nwa eze. Olulu mmiri a dị nʼogige ụlọ ndị nche. Ọ bụ ụdọ ka ha ji wetuo Jeremaya nʼime olulu mmiri ahụ. Ma mmiri adịghị nʼime ya, naanị apịtị. Ya mere, Jeremaya danyere nʼime apịtị ahụ, mibanye nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.6",
            "verseOrgIds": [
              "JER.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ebed-Melek, onye Kush, otu nʼime ndịisi ozi nʼụlọeze nụrụ na etinyela Jeremaya nʼime olulu mmiri. Mgbe eze nọdụrụ nʼọnụ ụzọ ama Benjamin,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.7",
            "verseOrgIds": [
              "JER.38.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebed-Melek si nʼụlọeze pụọ jekwuuru ya nʼebe ahụ sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.8",
            "verseOrgIds": [
              "JER.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onyenwe m eze, lee na mmeso ndị a mesoro Jeremaya onye amụma jọgburu onwe ya. Ha atụbala ya nʼime olulu mmiri hapụ ya ka ọ nọdụ nʼebe ahụ nwụọ nʼihi agụụ mgbe achịcha kọrọ nʼobodo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.9",
            "verseOrgIds": [
              "JER.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze nyere Ebed-Melek onye Kush iwu sị ya, \"Sị nʼebe a kpọrọ iri mmadụ atọ ka gị na ha soro gaa dọpụta Jeremaya onye amụma site nʼolulu ahụ tupu ọ nwụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.10",
            "verseOrgIds": [
              "JER.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ebed-Melek duuru ndị ahụ pụọ. O buru ụzọ jee nʼọnụụlọ dị nʼokpuru ụlọakụ nke ụlọeze. Nʼebe ahụ, ọ chịpụtara ụfọdụ nkịrịnka akwa, na ụfọdụ uwe kara nka. O kenyere ha nʼụdọ, wetuore ya Jeremaya nʼime olulu mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.11",
            "verseOrgIds": [
              "JER.38.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebed-Melek onye Kush ahụ gwara Jeremaya okwu sị ya, \"Were nkịrịnka akwa ndị a, na uwe ndị a kara aka fanye ha na mkpa abụ gị, ime ka ụdọ a ghara imerụ gị ahụ.\" Jeremaya mere dị ka a gwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.12",
            "verseOrgIds": [
              "JER.38.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ha dọlịtere ya elu, dọpụta ya site nʼolulu mmiri ahụ. Site nʼoge ahụ, Jeremaya nọgidere nʼogige ụlọ ndị nche.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.13",
            "verseOrgIds": [
              "JER.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zedekaya ajụọ Jeremaya ajụjụ ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Zedekaya bụ eze, ziri ozi ka a kpọta Jeremaya onye amụma, ka ọ bịakwute ya nʼọnụ ụzọ nke atọ, nke ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.14",
                "verseOrgIds": [
                  "JER.38.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". Mgbe ọ bịara, eze gwara ya okwu sị ya, \"Achọrọ m ịjụ gị ajụjụ. Ezonarịla m ihe ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jeremaya zara Zedekaya sị ya, \"Ọ bụrụ na m enye gị ọsịsa, ị gaghị egbu m? A sịkwa na m adụọ gị ọdụ, ị gaghị ege m ntị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.15",
            "verseOrgIds": [
              "JER.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Zedekaya bụ eze ṅụrụ iyi na nzuzo nye Jeremaya sị ya, \"Dịka",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.16",
                "verseOrgIds": [
                  "JER.38.16"
                ]
              }
            }
          ]
        },
        {
          "text": "onye nyere anyị ume anyị na-eku si adị ndụ, agaghị m egbu gị, maọbụ nyefee gị nʼaka ndị na-achọsi ndụ gị ike.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeremaya zara Zedekaya sị ya, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.17",
                "verseOrgIds": [
                  "JER.38.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, 'Ọ bụrụ na ị pụkwuru ndịisi eze Babilọn nyefee onwe gị nʼaka ha, ha ga-echebe gị ndụ, ha agakwaghị akpọ obodo a ọkụ. Gị na ezinaụlọ gị ga-adịkwa ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị jụ iwere onwe gị nyefee nʼaka ndịisi eze Babilọn, a ga-enyefe obodo a nʼaka ndị Babilọn. Ha ga-akpọkwa ya ọkụ, ma gị onwe gị agakwaghị agbapụ site nʼaka ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Zedekaya sịrị Jeremaya, \"Mụ onwe m na-atụ egwu ndị Juu ahụ bụ ndị gbakwuru ndị Babilọn, nʼihi na ndị Babilọn nwere ike nyefee m nʼaka ha, ha ga-emesikwa m ike.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ha agaghị enyefe gị nʼaka ha,\" ka Jeremaya zara ya. \"Rubere",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.20",
                "verseOrgIds": [
                  "JER.38.20"
                ]
              }
            }
          ]
        },
        {
          "text": "isi, site nʼime ihe m gwara gị. Mgbe ahụ, ihe niile ga-agara gị nke ọma. A ga-echebekwa ndụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị jụ iwere onwe gị nye, lee ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.38.21",
                "verseOrgIds": [
                  "JER.38.21"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka m hụ:",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-akpụta ndị inyom niile fọdụrụ nʼụlọeze Juda mee ka ha pukwuru ndịisi eze Babilọn. Ndị inyom ndị a ga-asị gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "\" 'Ndị enyi gị ahụ niile ị na-atụkwasị obi arafuola gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "mee ka ị bụrụ onye e meriri emeri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "Ụkwụ gị abụọ emikpuola nʼime apịtị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 38:22"
      },
      "items": [
        {
          "text": "ugbu a, ndị enyi gị niile ahụ agbanarịla gị.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A ga-akpụpụtara ndị Babilọn ndị nwunye gị niile na ụmụ gị niile. Gị onwe gị agaghị agbanarị ha, ma eze Babilọn ga-ejidekwa gị, a ga-esurekwa obodo a ọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Zedekaya gwara Jeremaya, \"Ekwela ka ntị ọzọ nụ ihe ndị a niile mụ na gị kwuru, ma ọ bụghị ya, ị ga-anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
            "verseOrgIds": [
              "JER.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ndịisi ọchịchị anụ na mụ na gị kparịtara ụka, ha bịakwute gị, sị gị, 'Gwa anyị ihe ị gwara eze na ihe eze gwara gị, ezola ihe ọbụla nʼebe anyị nọ, ma ọ bụghị ya anyị ga-egbu gị,'",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ ị ga-agwa ha, 'Anọ m na-arịọ eze arịrịọ ka ọ hapụ izighachi m nʼụlọ Jonatan, ka m nwụọ nʼebe ahụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi ọchịchị ahụ niile bịakwutere Jeremaya jụọ ya ajụjụ. Ọ gwakwara ha ihe ahụ niile eze nyere ya nʼiwu. Ha hapụrụ ịjụ ya ihe ọzọ, nʼihi o nwekwaghị onye ọzọ nụrụ okwu niile ya na eze kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeremaya nọgidekwara nʼogige ndị nche tutu ruo ụbọchị ahụ a dọtara Jerusalem nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "JER 38:28"
      },
      "items": [
        {
          "text": "Ọdịda Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 38:28"
      },
      "items": [
        {
          "text": "Otu a ka esi were Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
      ]
    }
  ],
