{
  "id": "JER.15",
  "number": "15",
  "bookId": "JER",
  "reference": "Jeremaya 15",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JER 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.1",
                "verseOrgIds": [
                  "JER.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m okwu sị m, \"Ọ bụrụ na Mosis na Samuel apụta bịa guzo nʼihu m, ụdịdị obi m agaghị agbanwe nʼebe ndị a nọ. Chụpụ ha nʼihu m. Mee ka ha si nʼebe a pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ha ajụọ gị si, 'Ebee ka anyị ga-aga?' Gwa ha na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.2",
                "verseOrgIds": [
                  "JER.15.2"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "\" 'Ndị e debere nʼihi ọnwụ ga-anwụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "ndị e debere nʼihi mma agha ka mma agha ga-egbu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "ndị e debere nʼihi ụnwụ ka ụnwụ ga-egbu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:2"
      },
      "items": [
        {
          "text": "otu a kwa, ndị e debere nʼihi ịdọta nʼagha, ka a ga-adọta nʼagha buru ha gaa mba ọzọ.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m ezite ụdị mbibi anọ megide ha: mma agha nke ga-egbu ha, nkịta ga-adọkpụrụ ozu ha pụọ, ụmụ anụ ufe na ụmụ anụ ọhịa dị iche iche ga-eripịa ha, ma bibiekwa ha.\" Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.3",
                "verseOrgIds": [
                  "JER.15.3"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.3",
            "verseOrgIds": [
              "JER.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ha ghọọ ihe a na-asọ oyi nʼalaeze niile nke ụwa, nʼihi ihe Manase nwa eze Hezekaya nke Juda mere na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.4",
            "verseOrgIds": [
              "JER.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ga-enwe ebere nʼahụ gị, gị Jerusalem?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Onye ga-eru ụjụ nʼihi ihe ga-adakwasị gị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:5"
      },
      "items": [
        {
          "text": "Onye ga-apụta guzo ịjụ ajụjụ banyere otu ihe si agara gị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.5",
            "verseOrgIds": [
              "JER.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onwe gị ajụla m,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.6",
                "verseOrgIds": [
                  "JER.15.6"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "\"Ị nọgidela na-adaghachi azụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Ya mere, aga m ebikwasị gị aka, bibie gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:6"
      },
      "items": [
        {
          "text": "Ike m ji akwụsị gị ka ị ghara ịdaghachi azụ agwụla m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.6",
            "verseOrgIds": [
              "JER.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eji ihe e ji afụcha ọka fụchaa ha",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "nʼọnụ ụzọ ama nke ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "Aga m eme ka mbibi bịakwasị ndị m, nke ga-eme ka ha gbara aka ụmụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:7"
      },
      "items": [
        {
          "text": "nʼihi na ha esitebeghị nʼụzọ ọjọọ ha chigharịa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ọnụọgụgụ ụmụ nwanyị di ha nwụrụ baa ụba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "Ha ga-ehi nne karịa aja dị nʼọnụ oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "Nʼetiti ehihie ka m ga-eme ka onye mbibi",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "bịakwasị ndị bụ nne ụmụ okorobịa ha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "na mberede ka m ga-eme ka nhụju anya",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:8"
      },
      "items": [
        {
          "text": "na ihe oke egwu bịakwasị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị mụrụ ụmụ asaa ga-ada mba,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "kubie ume.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Ọ ga-anwụ mgbe oge ya na-erubeghị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "ihere ga-eme ya; ọ ga-abụkwa onye e wedara nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Ma ndị fọdụrụ ndụ ka m ga-eme ka ha nwụọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "site na mma agha ndị iro ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:9"
      },
      "items": [
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.9",
                "verseOrgIds": [
                  "JER.15.9"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịịrị m, nne m, na ị mụrụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "onye ya na ndị niile bi nʼala a na-alụ ọgụ, ma na-ese okwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "O nwebeghị onye m binyere ego, ọ dịkwaghị onye binyere m ego,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:10"
      },
      "items": [
        {
          "text": "ma mmadụ niile na-akọcha m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.11",
                "verseOrgIds": [
                  "JER.15.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "\"Nʼezie, aga m anapụta gị nʼihi ezi ihe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "aga m eme ka onye iro gị rịọ gị arịrịọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:11"
      },
      "items": [
        {
          "text": "nʼoge ihe ọjọọ na nʼoge mkpagbu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mmadụ o nwere ike ịgbaji igwe,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:12"
      },
      "items": [
        {
          "text": "ya bụ igwe e si nʼakụkụ ugwu bubata, maọbụ bronz?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.12",
            "verseOrgIds": [
              "JER.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m ewere ihe niile i nwere, ya na akụnụba gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:13"
      },
      "items": [
        {
          "text": "nye ya onye ga-akwata ha nʼagha. Ọ gaghị akwụ gị ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:13"
      },
      "items": [
        {
          "text": "Nʼihi na mmehie gị niile",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:13"
      },
      "items": [
        {
          "text": "ejupụtala nʼala a niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.13",
            "verseOrgIds": [
              "JER.15.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ewere gị nye ka ị bụrụ ohu ndị iro gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:14"
      },
      "items": [
        {
          "text": "Ị ga-ebi nʼala ị na-amaghị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:14"
      },
      "items": [
        {
          "text": "Nʼihi na a ga-esite nʼiwe m mụnye ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:14"
      },
      "items": [
        {
          "text": "nke ga-eregbu gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.14",
            "verseOrgIds": [
              "JER.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị maara O",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.15",
                "verseOrgIds": [
                  "JER.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "ya mere cheta m, lekọtaakwa m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "Bọọrọ m ọbọ megide ndị na-akpagbu m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "Ewezugala m, biko, nʼihi na ị bụ onye ogologo ntachiobi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:15"
      },
      "items": [
        {
          "text": "Lee ka m si na-anata nkọcha nʼihi na m na-asọpụrụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.15",
            "verseOrgIds": [
              "JER.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m chọpụtara okwu gị, eweere m ya rie dịka nri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:16"
      },
      "items": [
        {
          "text": "Ha tọrọ obi m ụtọ, bụrụkwa ihe na-enye m ọṅụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:16"
      },
      "items": [
        {
          "text": "nʼihi na-akpọkwasịrị m aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:16"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.16",
                "verseOrgIds": [
                  "JER.15.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.16",
            "verseOrgIds": [
              "JER.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwebeghị oge mụ na ndị na-achị ọchị nke ukwuu ji nọkọọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "Esokwaghị m ha ṅụrịkọọ ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "A nọdụụrụ m onwe m nʼihi na aka gị dịkwasịrị m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:17"
      },
      "items": [
        {
          "text": "I mekwara ka iwe jupụta m nʼobi nʼihi ajọ omume ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.17",
            "verseOrgIds": [
              "JER.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere ihe mgbu m adịghị akwụsị akwụsị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "Gịnị mekwara ọnya m ji dị njọ na-apụghị ịgwọta ya?",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "Ị dịrị m dịka mmiri iyi na-arafu mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:18"
      },
      "items": [
        {
          "text": "dịka isi iyi nke na-ekwesighị ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.18",
            "verseOrgIds": [
              "JER.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.15.19",
                "verseOrgIds": [
                  "JER.15.19"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:19"
      },
      "items": [
        {
          "text": "\"Ọ bụrụ na i chegharịa, aga m etinyeghachi gị nʼọnọdụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 15:19"
      },
      "items": [
        {
          "text": "ime ka i guzokwa nʼihu m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.19",
            "verseOrgIds": [
              "JER.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 15:19"
      },
      "items": [
        {
          "text": "Ọ bụrụ na okwu si gị nʼọnụ abụrụ okwu kwesiri ntụkwasị obi, okwu na-abụghị okwu nzuzu",
          "type": "text",
