{
  "id": "JER.14",
  "number": "14",
  "bookId": "JER",
  "reference": "Jeremaya 14",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JER 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụkọ mmiri, ụnwụ na mma agha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.1",
                "verseOrgIds": [
                  "JER.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke rutere Jeremaya banyere ụkọ mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Juda na-eru ụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "ndị bi nʼobodo ya niile na-ahụjukwa anya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "Ha na-akwa akwa nʼihi ala ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:2"
      },
      "items": [
        {
          "text": "ụda ịkwa akwa ha eruokwala Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.2",
            "verseOrgIds": [
              "JER.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a na-asọpụrụ na-ezipụ ndị ohu ha ịga chọta mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Ha na-aga nʼolulu mmiri",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "ma o nweghị mmiri ha na-achọta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Ha bu ite nke mmiri ọbụla na-adịghị nʼime ya na-alọta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "Ha ji aka ha kpuchie isi ha",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:3"
      },
      "items": [
        {
          "text": "nʼihi ịda mba nke obi na nʼihi ọnọdụ obi ọjọọ nke ha nọ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.3",
            "verseOrgIds": [
              "JER.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala na-agbawa",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "nʼihi enweghị mmiri ozuzo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "Ndị ọrụ ubi na-ekpuchikwa isi ha",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:4"
      },
      "items": [
        {
          "text": "nʼihi obi ọjọọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.4",
            "verseOrgIds": [
              "JER.14.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụladị nne ele, nke nọ nʼọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "na-ahapụ nwa ọhụrụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:5"
      },
      "items": [
        {
          "text": "nʼihi na ahịhịa ndụ adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.5",
            "verseOrgIds": [
              "JER.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịnyịnya ibu ọhịa na-eguzokwa nʼelu ebe dị elu nke ahịhịa na-adịghị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "Ha na-eku ume na-ekupụ ngwangwa, ngwangwa, dịka nkịta ọhịa;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "anya ha adabamiela ha nʼisi",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:6"
      },
      "items": [
        {
          "text": "nʼihi ahụghị ahịhịa ndụ ha ga-ata.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.6",
            "verseOrgIds": [
              "JER.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na mmehie anyị na-agbagide anyị ama,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.7",
                "verseOrgIds": [
                  "JER.14.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", biko rụọ ọrụ gị nʼihi aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "Anyị emehiela megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:7"
      },
      "items": [
        {
          "text": "Ndaghachi azụ anyị site nʼebe ị nọ dịkwa ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị, onye bụ olileanya Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "Onye Nzọpụta ya nʼoge ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "gịnị mere i ji nọdụ dịka onye ọbịa nʼala a,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:8"
      },
      "items": [
        {
          "text": "dịka onye ije nke na-anọ naanị ọnọdụ otu abalị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji nọdụ dịka onye ihe mere na mberede,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "dịka dike nke na-enweghị ike ịzọpụta?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.9",
                "verseOrgIds": [
                  "JER.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ị nọ nʼetiti anyị;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "ọ bụkwa aha gị ka a kpọkwasịrị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:9"
      },
      "items": [
        {
          "text": "Ahapụkwala anyị!",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a bụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.10",
                "verseOrgIds": [
                  "JER.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru banyere ndị a,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "\"Ha hụrụ mwagharị nʼanya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "Ụkwụ ha adịghị anọkwa nʼotu ebe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "Nʼihi nke a, ihe banyere ha adịghị atọkwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.10",
                "verseOrgIds": [
                  "JER.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "Ugbu a kwa ka ọ na-echeta ajọ omume ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:10"
      },
      "items": [
        {
          "text": "ọ ga-atakwa ha ahụhụ nʼihi mmehie ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.11",
                "verseOrgIds": [
                  "JER.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Ekpela ekpere nʼihi ọdịmma ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ha na-ebu ọnụ, agaghị m ege ntị nʼakwa ha; ọ bụrụkwa na ha achụọrọ m aja nsure ọkụ, maọbụ aja mkpụrụ onyinye, agaghị m anabata ha. Kama, aga m eji mma agha na ụnwụ, na ọrịa dị iche iche bibie ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma asịrị m, \"Ewoo, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.13",
                "verseOrgIds": [
                  "JER.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "! Lee na ndị amụma na-asị ha, 'Unu agaghị ahụ mma agha anya, maọbụ hụ ahụhụ nke ụnwụ na-eweta, nʼeziokwu, aga m enye unu udo nke na-adịgide adịgide nʼebe a.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.14",
                "verseOrgIds": [
                  "JER.14.14"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m okwu sị, \"Ndị amụma ahụ na-ebu amụma ụgha nʼaha m. Ọ bụghị m họpụtara ha, ọ bụghị m gwara ha okwu, ọ bụkwaghị m ziri ha. Ọ bụ amụma ụgha ka ha na-eburu unu, amụma ụgha nke ọhụ ụgha, na nke ịgba afa, na nke na-enweghị isi, na nke si nʼobi ha nke aghụghọ jupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.15",
                "verseOrgIds": [
                  "JER.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru banyere ndị amụma ahụ na-ebu amụma nʼaha m. Ọ bụghị m ziteere ha, ma ha nọgidere na-asị, 'Mma agha na ụnwụ enweghị ike ịbịaru ala a nso.' Ndị amụma a niile ka a ga-ebibi site na mma agha na ụnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esitekwa nʼụlọ tụpụ ndị ahụ niile ha na-eburu amụma nʼokporoụzọ Jerusalem nʼihi ụnwụ na mma agha. O nweghị onye ga-eli ha, maọbụ ndị nwunye ha, maọbụ ụmụ ha ndị ikom na ndị inyom. Nʼihi na aga m awụkwasị ha ihe ọjọọ ahụ niile ruuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.16",
            "verseOrgIds": [
              "JER.14.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ha okwu ndị a,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "\" 'Ka anya mmiri si nʼanya m na-eruda",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "ehihie na abalị, na-akwụsịghị akwụsị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "nʼihi ndị m, nʼihi ada ndị m, nke na-amaghị nwoke,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "ndị hụrụla ahụhụ dị ukwuu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:17"
      },
      "items": [
        {
          "text": "ndị e tipụtara ọnya jọrọ njọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m apụọ jee nʼime ime obodo",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ana m ahụ ndị e ji mma agha gbuo;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Ọ bụrụ na m abata nʼobodo ukwu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "ana m ahụ mbibi nke ụnwụ wetara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "Ma onye amụma ma onye nchụaja",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:18"
      },
      "items": [
        {
          "text": "agaala nʼala nke ha amaghị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.18",
            "verseOrgIds": [
              "JER.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị jụla Juda kpamkpam?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Ọ pụtara na ihe banyere Zayọn adịghị atọkwa gị ụtọ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Gịnị mere i ji tigbuo anyị",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "ruo na ọgwụgwọ adịghịkwa nye anyị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "Anyị lere anya udo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "ma ọ dịghị ezi ihe bịara;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "anyị lere anya ọgwụgwọ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:19"
      },
      "items": [
        {
          "text": "ma lee, ihe anyị hụrụ bụ oke egwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.19",
            "verseOrgIds": [
              "JER.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.20",
                "verseOrgIds": [
                  "JER.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", anyị nabatara ajọ omume anyị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "na ikpe mara nna nna anyị ha;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:20"
      },
      "items": [
        {
          "text": "nʼezie, anyị onwe anyị emehiekwala megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.20",
            "verseOrgIds": [
              "JER.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elelịla anyị anya, nʼihi aha gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "Ekwela ka ocheeze gị dị ebube bụrụ ihe a na-adịghị asọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "Cheta ọgbụgba ndụ nke anyị na gị gbara;",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:21"
      },
      "items": [
        {
          "text": "emebikwala ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.21",
            "verseOrgIds": [
              "JER.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dị chi ihe efu nke ndị mba ọzọ nwere ike ime ka mmiri zoo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Mbara eluigwe ọ pụrụ ime ka mmiri zoo site nʼike aka ya naanị?",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Mba! Ọ bụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.14.22",
                "verseOrgIds": [
                  "JER.14.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị pụrụ ime ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "Nʼihi nke a, olileanya anyị dị nʼime gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 14:22"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ gị na-eme ihe ndị a niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.22",
            "verseOrgIds": [
              "JER.14.22"
            ]
          }
        }
