          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi gịnị ka m ji site nʼafọ nne m pụta",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.18",
            "verseOrgIds": [
              "JER.20.18"
            ]
