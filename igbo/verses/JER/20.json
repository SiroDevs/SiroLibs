          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.12",
                "verseOrgIds": [
                  "JER.20.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, gị, onye na-enyocha onye ezi omume,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:12"
      },
      "items": [
        {
          "text": "onye anya ya na-eru nʼihe dị mmadụ nʼobi na nʼime echiche uche ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:12"
      },
      "items": [
        {
          "text": "biko, kwere ka m dị ndụ hụ mgbe ị ga-abọrọ onwe gị ọbọ megide ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:12"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ nʼaka gị ka m tinyere ihe niile gbasara m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.12",
            "verseOrgIds": [
              "JER.20.12"
            ]
          }
        }
      ]
    },
