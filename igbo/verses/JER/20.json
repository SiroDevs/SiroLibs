            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:15"
      },
      "items": [
        {
          "text": "nke mere ka ọ ṅụrịa ọṅụ, na-asị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
              "JER.20.15"
            ]
          }
        }
      ]
    },
