          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka e meekwa nwoke ahụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
