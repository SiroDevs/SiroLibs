      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 20:16"
      },
      "items": [
        {
          "text": "Ka nwoke ahụ nọgidekwa na-anụ iti mkpu akwa nʼụtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
