          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.20.16",
                "verseOrgIds": [
                  "JER.20.16"
                ]
              }
            }
          ]
        },
        {
          "text": "mere obodo ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
        }
      ]
    },
