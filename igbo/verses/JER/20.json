      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:14"
      },
      "items": [
        {
          "text": "Ka ụbọchị nne m mụrụ m ghara inwe ngọzị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.14",
            "verseOrgIds": [
              "JER.20.14"
            ]
          }
        }
      ]
    },
    {
