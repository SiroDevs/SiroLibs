              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe a bụrụ ọnụ ka ụbọchị ahụ a mụrụ m bụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.14",
