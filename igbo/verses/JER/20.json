      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:17"
      },
      "items": [
        {
          "text": "hapụ ime ka afọ nne m bụrụ ili m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.17",
            "verseOrgIds": [
              "JER.20.17"
            ]
          }
        }
