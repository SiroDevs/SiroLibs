          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye a na-abụ ọnụ ka nwoke ahụ bụ nke wetara nna m akụkọ ọmụmụ m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
