      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:15"
      },
      "items": [
        {
          "text": "\"A mụọlara gị nwa, ọ bụ nwa nwoke!\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.15",
            "verseOrgIds": [
              "JER.20.15"
            ]
          }
        }
      ]
    },
    {
