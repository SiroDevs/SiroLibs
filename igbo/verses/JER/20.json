      "attrs": {
        "style": "q2",
        "vid": "JER 20:16"
      },
      "items": [
        {
          "text": "na akwa ibu agha nʼehihie.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
