        "vid": "JER 20:17"
      },
      "items": [
        {
          "text": "ka afọ ya bụrụkwa ihe buru ibu ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.17",
            "verseOrgIds": [
              "JER.20.17"
            ]
          }
        }
      ]
    },
