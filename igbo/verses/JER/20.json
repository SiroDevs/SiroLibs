      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 20:16"
      },
      "items": [
        {
          "text": "o bibiri na-enweghị ọmịiko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.16",
            "verseOrgIds": [
              "JER.20.16"
            ]
          }
        }
      ]
    },
