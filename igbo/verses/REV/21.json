  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "REV 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eluigwe ọhụrụ na ụwa ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m eluigwe ọhụrụ na ụwa ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "text": "Eluigwe nke mbụ na ụwa nke mbụ agabigala, osimiri adịghịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụkwara obodo nsọ ahụ bụ Jerusalem ọhụrụ ka o si nʼeluigwe ebe Chineke nọ na-arịdata. Ọ mara mma dịka nwaagbọghọ ejikwara nke ọma maka ịgakwuru di ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
              "REV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụkwara m oke olu si nʼocheeze ahụ kwuo okwu sị, \"Leenụ! Ebe obibi Chineke adịla ugbu a nʼetiti ụmụ mmadụ. Ọ ga-ebinyere ha. Ha ga-abụkwa ndị ya, nʼezie, Chineke nʼonwe ya ga-anọkwa nʼetiti ha bụrụkwa Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.3",
            "verseOrgIds": [
              "REV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ehichapụ anya mmiri niile dị nʼanya ha. Ọnwụ agaghị adịkwa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        },
        {
          "text": "Ọ bụladị iru ụjụ na ịkwa akwa na ahụhụ agaghị adịkwa. Ihe ndị ochie niile agabigala.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.4",
            "verseOrgIds": [
              "REV.21.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ nọ nʼocheeze ahụ kwuru sị, \"Lee, ana m eme ka ihe niile dị ọhụrụ.\" Mgbe ahụ, ọ sịkwara, \"Detuo ihe ndị a, nʼihi na okwu ndị a bụ ihe e kwesiri ịtụkwasị obi, bụrụkwa eziokwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.5",
            "verseOrgIds": [
              "REV.21.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"E mezuola ihe niile. Abụ m Alfa na Omega, Mmalite na Ọgwụgwụ. Aga m enye onye akpịrị na-akpọ nkụ mmiri nke si nʼisi iyi mmiri nke ndụ dịka ihe onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
            "verseOrgIds": [
              "REV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbụla na-emeri emeri ga-enweta ihe nketa ndị a. Aga m abụkwa Chineke ha, ha onwe ha ga-abụ ụmụ m.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.7",
            "verseOrgIds": [
              "REV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị na-atụ ụjọ, ndị na-ekweghị ekwe, na ndị na-emetọ onwe ha, na ndị ogbu mmadụ, na ndị na-akwa iko, na ndị ha na mmụọ ọjọọ na-akparịta ụka, na ndị na-ekpere arụsị, na ndị ụgha niile, ihe ha ga-eketa bụ ikpe ọmụma nke ịbanye nʼime olulu ahụ e ji nkume na-enwu ọkụ kwanye ọkụ. Nke bụ ọnwụ nke ugboro abụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.8",
            "verseOrgIds": [
              "REV.21.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jerusalem ọhụrụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime ndị mmụọ ozi asaa ahụ, nke ji efere asaa ahụ nke ihe ntaramahụhụ dị nʼime ya bịakwutere m sị m, \"Soro m, ka m gosi gị nwaagbọghọ ahụ bụ nwunye Nwa Atụrụ ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.9",
            "verseOrgIds": [
              "REV.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O buuru m nʼime Mmụọ buga m nʼotu ugwu buru ibu nke ịdị elu ya dịkwa ukwuu. O gosiri m obodo nsọ ahụ bụ Jerusalem ka o si na mbara eluigwe ebe Chineke nọ na-arịdata.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.10",
            "verseOrgIds": [
              "REV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jupụtara nʼebube Chineke, na-enwu ma na-achakwa dịka nkume dịkarịsịrị oke ọnụahịa, dịka nkume jaspa, na-enwu dịka kristal.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbidi ya niile dị obosara dịkwa elu. O nwekwara ọnụ ụzọ iri na abụọ. Ọ bụkwa ndị mmụọ ozi iri na abụọ na-eche ọnụ ụzọ ndị a nche. E dekwara aha ebo iri na abụọ nke ụmụ Izrel nʼọnụ ụzọ ama ndị a nʼotu nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụzọ ama atọ dị nʼakụkụ ọwụwa anyanwụ, atọ dị nʼakụkụ ugwu, atọ dị nʼakụkụ ndịda, ebe atọ dị nʼakụkụ ọdịda anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbidi ahụ nwere nkume iri na abụọ e ji tọọ ntọala ya. Nʼelu nkume ndị a nʼotu nʼotu ka e dere aha ndị ozi iri na abụọ nke Nwa Atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ na-agwa m okwu ji osisi e ji atụ ihe, nke e ji ọlaedo mee, nʼaka ya. O ji ya tụọ obodo ahụ na ọnụ ụzọ ama ya, na mgbidi ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼobodo ahụ, enweghị otu akụkụ nʼime akụkụ anọ nke mgbidi ya karịrị ibe ya. Ogologo ya na obodobo ya ha otu. O ji ihe ọtụtụ tụọ ya, ogologo ya na obodobo nakwa ịdị elu ya ha, ọtụtụ ya dị puku kilomita abụọ na narị kilomita abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ tụkwara ịdị igbidi nke mgbidi ahụ chọpụta na ọ dị narị nzọ ụkwụ atọ, dịka ihe ọtụtụ nke mmụọ ozi ahụ si gụpụta.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịma mma nke obodo ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe e ji rụọ mgbidi ya bụ nkume dị oke ọnụahịa a na-akpọ jaspa, jiri ezi ọlaedo a nụchara anụcha, nke na-enwu dịka enyo dị ọcha rụọ obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji nkume niile dị oke ọnụahịa chọọ ntọala mgbidi obodo ahụ mma. Ntọala nke mbụ, bụ nkume a na-akpọ jaspa, ntọala nke abụọ, nkume a na-akpọ safaia, ntọala nke atọ, nkume a na-akpọ kaldoni, nke anọ, nkume a na-akpọ emeralụdụ,",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.19",
            "verseOrgIds": [
              "REV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ise, nkume a na-akpọ ọniks, nke isii, nkume a na-akpọ kanelian, nke asaa, nkume a na-akpọ krisolaịt, nke asatọ, nkume a na-akpọ beril, nke itoolu, nkume a na-akpọ topaazi, nke iri, nkume a na-akpọ krisoprez, nke iri na otu, nkume a na-akpọ jasint, nke iri na abụọ, nkume a na-akpọ ametisiti.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.20",
            "verseOrgIds": [
              "REV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụzọ ama iri na abụọ ahụ bụ pieal iri na abụọ, ọnụ ụzọ ama ọbụla ka e ji otu nkume pieal rụọ nʼotu nʼotu. Ihe e ji rụọ okporoụzọ dị nʼobodo ahụ bụ naanị ọlaedo a nụchara anụcha ọbụla, nke dị ọcha dịka enyo e hichaziri nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.21",
            "verseOrgIds": [
              "REV.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "REV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ụlọnsọ ukwu ọbụla m hụrụ nʼime obodo ahụ nʼihi na Onyenwe anyị Chineke, Onye pụrụ ime ihe niile na Nwa Atụrụ ahụ bụ ụlọnsọ ukwu obodo ahụ nwere.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.22",
            "verseOrgIds": [
              "REV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "REV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịkwaghị mkpa ọ dịrị obodo ahụ ka anwụ maọbụ ọnwa mụkwasị ya, nʼihi na ebube nke Chineke bụ ìhè ya, oriọna ya bụkwa Nwa atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
            "verseOrgIds": [
              "REV.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "REV 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile ga-eji ìhè ya jegharịa. Ndị eze ụwa niile ga-abịakwa webata ebube ha nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "REV 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A naghị emechi ọnụ ụzọ ama obodo ahụ emechi. Ha na-eghe oghe ụbọchị niile nʼihi abalị ọbụla adịghịkwa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebube na nsọpụrụ nke mba niile ka a ga-ewebata nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "REV 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịkwaghị ihe ọbụla rụrụ arụ ga-abata nʼime ya. Otu a kwa, ọ dịkwaghị onye na-eme ihe arụ, maọbụ onye ụgha ga-abata nʼime ya, kama ọ bụ naanị ndị ahụ e dere aha ha nʼakwụkwọ nke ndụ Nwa Atụrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.27",
            "verseOrgIds": [
              "REV.21.27"
            ]
          }
        }
