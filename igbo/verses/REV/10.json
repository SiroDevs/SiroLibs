  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "REV 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmụọ ozi ji akwụkwọ ntakịrị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m mmụọ ozi ọzọ dị oke egwu ka o si nʼeluigwe na-arịdata. Igwe ojii gbara ya gburugburu. Eke na egwurugwu dịkwa ya nʼisi. Ihu ya na-egbukwa maramara dịka anyanwụ. Ụkwụ ya na-acha dịka ogidi na-enwu ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.1",
            "verseOrgIds": [
              "REV.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji akwụkwọ ntakịrị a fụkọtara afụkọta nʼaka ya. Otu ụkwụ ya, nke aka nri ya, ka ọ zọnyere nʼime osimiri, ma ụkwụ nke aka ekpe ya ka ọ zọkwasịrị nʼelu ala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.2",
            "verseOrgIds": [
              "REV.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji oke olu, nke dara ụda dịka ịgbọ ụja ọdụm, tie mkpu, egbe eluigwe asaa gbara otu mgbe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.3",
            "verseOrgIds": [
              "REV.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m chọrọ idetu ihe egbe eluigwe ndị a kwuru, anụrụ m otu olu si nʼeluigwe na-ekwu, \"Edela ihe ahụ nʼakwụkwọ, nʼihi na-achọghị ka ndị ọzọ mata okwu ahụ egbe eluigwe ndị ahụ kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.4",
            "verseOrgIds": [
              "REV.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, mmụọ ozi ahụ nke m hụrụ zọkwasịrị ụkwụ ya nʼelu osimiri, na nʼala akọrọ ahụ, chịlịri aka ya abụọ elu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.5",
            "verseOrgIds": [
              "REV.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "were onye ahụ na-adị ndụ mgbe niile ebighị ebi ṅụọ iyi. Ya bụ onye ahụ kere eluigwe na ụwa, na ihe niile dị nʼime ha, na oke osimiri, na ndị niile bi nʼime ha, sị na oge ezuola. Na o kwesikwaghị ka a tufuo oge ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.6",
            "verseOrgIds": [
              "REV.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, mgbe ndị mmụọ ozi asaa ahụ ga-afụ opi ike ha, ihe omimi niile nke Chineke ga-emezu, dịka ọ gwara ndị ohu ya bụ ndị amụma.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.7",
            "verseOrgIds": [
              "REV.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olu nke ahụ m nụrụ mbụ sitere nʼeluigwe gwa m okwu ọzọ, na-asị, \"Gaa nara mmụọ ozi ahụ guzo nʼelu oke osimiri na ala akọrọ, akwụkwọ ahụ aseghere aseghe nke o ji nʼaka ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.8",
            "verseOrgIds": [
              "REV.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ejekwuru m mmụọ ozi ahụ gwa ya ka o nye m akwụkwọ nta ahụ. Ọ sịrị m, \"Nara ya, taa ya. Ọ ga-eme ka afọ gị luo ilu, ma 'nʼọnụ gị, ọ ga-atọ gị ụtọ dịka mmanụ aṅụ.'",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.9",
            "verseOrgIds": [
              "REV.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anaara m ya akwụkwọ nta ahụ site nʼaka mmụọ ozi ahụ taa ya. Ọ tọrọ ụtọ dịka mmanụ aṅụ nʼọnụ m, ma mgbe m lodara ya, afọ m bidoro ilu ilu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.10",
            "verseOrgIds": [
              "REV.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ha sịrị m, \"Ị ghaghị ibu amụma ọzọ banyere ọtụtụ mmadụ, na ọtụtụ mba, na ọtụtụ asụsụ na ọtụtụ ndị eze.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.10.11",
            "verseOrgIds": [
              "REV.10.11"
            ]
          }
        }
      ]
    }
  ],
