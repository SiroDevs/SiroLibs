          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pashihuri alakwa eshilaka munwa khulwa okhumuboha Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Pashihuri waImeri omukuhani, owali omukali omukhulundu munzu yOMWAMI, yahulila Yeremia narumbulanga amakhuwa ako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.1",
            "verseOrgIds": [
              "JER.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Pashihuri namunywekha Yeremia omunabii, niyeenjisia ebilenjebie mumakokolo akali mushilibwa shiemukulu shiaBenyamini, eshili enanzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.2",
            "verseOrgIds": [
              "JER.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mukamba, olwa Pashihuri yarusia Yeremia mumakokolo, Yeremia yamusunjila mbu OMWAMI shiakhulanganga eliira mbu Pashihuri ta, habula Oburisii-tsimbekatsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.3",
            "verseOrgIds": [
              "JER.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI aboola; mbu Lola, ndalakhukhola obe eshiriisio khwiwe omwene, nokhubeetsabo bosi; balakwa khulwa olukanga lwabasuku babwe, nawe olarakhwo butswa tsimoni. Khandi ndalahaana Yuda yosi mumukhono kwomuruchi waBabeli, naye alabaara nabayila eBabeli, nokhubeera nolukanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.4",
            "verseOrgIds": [
              "JER.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalahaana obuyinda bwosi bwelitookho lino, biosi ebia lieenyoolela, ebiolukoosi bialio biosi, kata nende amabiikho kosi kabaruchi baYuda, ndalabihaana mumukhono kwabasuku babwe, abalabayaaya, nibabahamba, nibabayila eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.5",
            "verseOrgIds": [
              "JER.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, Pashihuri, halala nende bosi abamenya munzuyo, mulatsia mubuhambe; oloola eBabeli, ne ebweneyo olafwilayo, ne ebweneyo olayabilwayo, iwe omwene nabeetsabo bosi, aba warumbulila akobubeeyi muliira lianje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.20.6",
            "verseOrgIds": [
              "JER.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwikhuulu lwaYeremia",
          "type": "text"
        }
      ]
    }
  ],
