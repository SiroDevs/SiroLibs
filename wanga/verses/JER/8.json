              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Mundaalo etsio balayinia amakumba kabaruchi baYuda, namakumba kabakhulundu bayo, namakumba kabakuhani, namakumba kabanabii, namakumba kabamenyanga muYerusalemu, mubilindwa biabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.1",
            "verseOrgIds": [
              "JER.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne balakabakala imbeli weliuba nomwesi, nelihe liosi eliomwikulu, ebia baheela nebia bakhalabanila, ebia balondakhwo, nebia beenya, nebia beenamilashikalakhung'aasibwa kata okhuyabilwa ta; ne kalaba shinga imbolela khwiloba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.2",
            "verseOrgIds": [
              "JER.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhufwa khulachamwa okhushila obulamu nabomusikalo okulasikala khubeinzu yino imbii, abalasikala habundu hosi ewa emba nimbeelusiliye; nilwo olwa OMWAMI omwene mahe aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.8.3",
            "verseOrgIds": [
              "JER.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwonooni, nende obuyaasii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Olwikhuulu khuYuda nende Yerusalemu",
          "type": "text"
        }
      ]
    }
