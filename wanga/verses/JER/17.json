    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwonooni bwaYuda bwasaarwa khumioyo chiabwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obwonooni bwaYuda bwahandiikwa nolukalamu Iweshibia; bwasaarwa khukhabaho khomwoyo kwabwe nobutsunzu bwa alumasi, khandi khutsinzika tsiebimalilo biabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.1",
            "verseOrgIds": [
              "JER.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa abaana babwe beetsulilanga ebimalilo biabwe nemiAshera chiabwe hamisaala emitendeemu nokhubikulu ebirambi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.2",
            "verseOrgIds": [
              "JER.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomushialo shietsingulu. Emianduchio ebiolukoosibio ndalahaana okhuyaaywa, bibe omurungo khulwa obwonoonibwo, mumbalitsio tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.3",
            "verseOrgIds": [
              "JER.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olatendeyia omukhonokwo khubulaamebwo obwa ndakhuheelesia; ne ndalachila nokhalabanila abasukubo mushialo eshia oramanyile ta; okhuba oburima bwanje nomulilo omululumu okulaakhanga inziayo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.4",
            "verseOrgIds": [
              "JER.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isabato yilindwe, yibe indakatifu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.18",
            "verseOrgIds": [
              "JER.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI yamboolela; mbu Tsia osinjile mushilibwa shiaBenyamini, eshia abaruchi baYuda beenjililangamwo, neshia barulilangamwo; khandi mubilibwa biosi bieYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.19",
            "verseOrgIds": [
              "JER.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nobasunjile mbu Hulile likhuwa liOMWAMI, inywe abaruchi baYuda, nabaYuda bosi, nabamenyanga muYerusalemu bosi, abeenjililanga mubilibwa bino. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.20",
            "verseOrgIds": [
              "JER.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI aboola; mbu Mwirecheshe khulwa obulamu bweenywe, muleshe okhuchinga omusiiko kwosi khunyanga yasabato, kata okhukwinjisilia mubilibwa bieYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.21",
            "verseOrgIds": [
              "JER.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata murarusia omusiiko munzu tsieenywe khunyanga yasabato, kata okhukhola omulimo kwosi ta; nebutswa mwahule inyanga yasabato, shinga olwa ndalaka abakuuka beenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.22",
            "verseOrgIds": [
              "JER.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo shibahulila kata okhureka amarwi ta; habula boomia amakosi, mbu baleshe okhuhulila kata okhuchesiyibwa ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.23",
            "verseOrgIds": [
              "JER.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI asunga mbu Nimuba nimurakhwo omwoyo okhumbulila, oburabisilia omusiiko kwosi mubilibwa bielitookho lino khunyanga yasabato ta, habula okhwahula inyanga yasabato, oburakholelakhwo omulimo kwosi ta, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.24",
            "verseOrgIds": [
              "JER.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho abaruchi abeekhala khushifumbi shiaDaudi baleenjilila mubilibwa bielitookho lino, nibachenda mumakaari nokhufarasi, bo abeene nabakhulundu babwe, nabaYuda, nabamenyanga muYerusalemu; abandu balamenyanga mwitookho lino inziayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.25",
            "verseOrgIds": [
              "JER.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baleetsa nibarula mumataala kaYuda, nomumbali etsibotokhana Yerusalemu, nomushialo shiaBenyamini, nomuShefela, nomubikulu, nomuNegebu, nibaleera emisango chiokhusambwa, nemisango chindi, nemisango chieimele, nobubaane, nibaleera emisango chiokhuupa orio, munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.26",
            "verseOrgIds": [
              "JER.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa nimuba nimukhaya okhumbulila, okhwahulanga inyanga yasabato, oburachinga omusiiko kwosi niwinjila mubilibwa bieYerusalemu khunyanga yasabato ta; kho ndalahambia omulilo mubilibwa bialio, nakwo kulamala tsinzu tsikhulundu; kata shikuIasima ta. Eliechesio liomulonji nende litoyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.17.27",
            "verseOrgIds": [
              "JER.17.27"
            ]
          }
        }
      ]
    }
  ],
