            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI asunga khukabamenyani banje ababii bosi, abatiilakhwo khubulaame tsana obwa ndaliisia abandu banje Isiraeli; mbu Lola, ndalabasiula okhurula mwiloba liabwe, nisiula inzu yaYuda hakari wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa ndalaba nimalile okhubasiula, ndalakalukha nimbabeela eshisa; nimbakalusia buli mundu khubulaamebwe, nabuli mundu khushialoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kalaba mbu nibaba nibafuchiilila okhweka obutinyu tsinjila tsiabandu banje, okhwitsuba khuliira lianje, mbu Shinga OMWAMI olwa ali mwoyo; shinga olwa beechesia abandu banje okhwitsuba khuBaali; kho baloombakhwa hakari wabandu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibaba nibakhaya okhuhulila, kho okhusiula ndalasiula lihanga elo nilimululila elala; nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
