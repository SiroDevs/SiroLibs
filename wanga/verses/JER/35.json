    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obuhulili bwabaRekhabu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia okhurula khuMWAMI mundaalo tsiaYehoyakimu waYosia, omuruchi waYuda, ndielino; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.1",
            "verseOrgIds": [
              "JER.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Tsia enanzu yabaRekhabu, osungane ninabo, nobaleera mushisika shindi eshiomunzu yOMWAMI nobaheelesia idivni banywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.2",
            "verseOrgIds": [
              "JER.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimbukula Yaazania waYeremil waHabazinia, nabaana babwe, nabaanabe abasiani bosi, nende inzu yosi yabaRekhabu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.3",
            "verseOrgIds": [
              "JER.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimbeenjisia munzu yOMWAMI mushisika shiabaana baHanani waIgidalia, omundu waNyasaye, eshiarondokhana neshisika shiabakhulundu, eshiali hekulu weshisika shiaMaaseya waShalumu, omulindi womuliango. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.4",
            "verseOrgIds": [
              "JER.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirenjekha tsingaye etsieetsulamwo idivai imbeli wabaana bomunzu ynbaRekhabu, nende ebkombe, nimbasunjila mbu Munywe idivai. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.5",
            "verseOrgIds": [
              "JER.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakalusin mbu Shikhulanywakhwo idivai yosi ta; okhuba Yonadabu waRekhabu, seefwe, yakhulaka ari Muranywakhwo idivai yosi, inywe abeene kata abaana beenywe inziayo, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.6",
            "verseOrgIds": [
              "JER.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muroombakhakhwo inzu yosi, kata okhuraaka imwo, kata okhuraaka omukunda kwemitsabibu, kata okhubakhwo ninakwo ta; nebutswa tsindaalo tsieenywe tsiosi mumenyenje mumaheema, mbu mana mumenye tsindaalo tsinyinji mushialo eshia mulimwo shinga abncheni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.7",
            "verseOrgIds": [
              "JER.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu khuhulilanga omwoyo kwaYonadabu waRekhabu seefwe mukosi aka yakhulachilisia, mbu oburanywa idivai yosi tsindaalo tsieefwe tsiosi ta, ifwe abeene, kata abakhasi beefwe, kata abaana beefwe abasiani kaba abnkhaana; kata okhuumbakha tsinzu etsia khumenyamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.8",
            "verseOrgIds": [
              "JER.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shikhulikhwo nomukunda kwemitsabibu, kata omukunda kundi kwosi, kata imwo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.9",
            "verseOrgIds": [
              "JER.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa khumenyanga mumaheema, nikhuhulilanga nikhukhola kosi aka Yonadabu seefwe yakhulaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.10",
            "verseOrgIds": [
              "JER.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa Nebukhadineza omuruchi waBabeli yatikulukha niyeenjila mushialo, khwasunga mbu Chende khutsie eYerusalemu, khulwa okhuria lihe liabaKalidayo, nokhurin lihe liabaSiria; kho niko nknchila nikhumenya eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.11",
            "verseOrgIds": [
              "JER.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana likhuwa liOMWAMI nilimwitsila Yeremia, liri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.12",
            "verseOrgIds": [
              "JER.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Tsia khubandu bnYuda, nende abamenyanga muYerusalemu, obasunjile mbu Kho mulobile okhuchesiha, okhuhulila amakhuwn kanje? OMWAMI nreeba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.13",
            "verseOrgIds": [
              "JER.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwn knYonadabu waRekhabu, aka yalaka abaanabe, oburanywakhwo idivai ta kakholungwakata okhuula olwn leelo shibanyweetsnngakhwo ta; okhuba bahulilangn lilako liakuuka wabwe. Nasi ndamusunjilanga inywe, nisunga khale nilumilila okhumusunjila; ne shimumbulilanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.14",
            "verseOrgIds": [
              "JER.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndamurumila abasumba banje abanabii bosi, nimbaruma khale nilumilila okhubaruma, okhuboola mbu Kalushe bulaano, buli mundu okhurula khunjilaye imbii, nimukasia obukholi bweenywe, kata muralonda khubanyasaye bandi okhubakhalabanila ta; mana mulamenya mushialo eshia ndamuheelesia inywe nabakuuka beenywe; nebutswa shimwarekakhwo amarwi kata okhuhulila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.15",
            "verseOrgIds": [
              "JER.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baYonadabu waRekhabu bakholanga akelilako liakuukn wabwe, elia yabalaka; ne abandu bano shibambuliilekhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.16",
            "verseOrgIds": [
              "JER.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka OMWAMI, Nyasaye omwene mahe, Nyasaye waIsiraeli, aboola; mbu Lole, ndalaleera khuYuda nende khubamenyangn muYerusalemu amabii ako kosi aka ndabarumbulila; okhuba ndabasunjila, nibarahulila ta; ndabalanga nibarafuchila ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.17",
            "verseOrgIds": [
              "JER.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeremia nasuniila abeinzu yabaRekhabu ari Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Okhuba mwnhulilanga lilako linYonndabu kuuka weenywe, nimulinda ameebaaloke kosi, nimukhola kosi aka yamulaka, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.18",
            "verseOrgIds": [
              "JER.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "niko akachila OMWAMI omwene mahe, Nyasaye waIsiraeli, nboola mbu Yonadabu waRekhabu shialatamba omundu okhusinjila imbeli wanje inziayo ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.35.19",
            "verseOrgIds": [
              "JER.35.19"
            ]
          }
        }
      ]
    }
  ],
