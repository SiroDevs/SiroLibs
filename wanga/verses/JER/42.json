    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amakhuwa kaNyasaye khuYohanani mumunzua kwa Yeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaseesia bamahe bosi, naYohanani waKarea, naAzaria waHoshaya, nabandu bosi, okhurula khumutuutu okhuula khumukhongo, nibeetsela Yeremia omunabii, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.1",
            "verseOrgIds": [
              "JER.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibamusunjila bari Chama mbu okhusaaya khweefwe khufuchiililwe imbeliwo, okhusaayile ewOMWAMI Nyasayewo, mbu ifwe fwesi abomusikalo kuno; okhuba khutong'ile abatuutu butswa abomubanji, shinga olwa okhulola netsimonitsio; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.2",
            "verseOrgIds": [
              "JER.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu OMWAMI Nyasayewo akhumanyie injila eya khukhoyile okhuchendakhwo, nende aka khukhoyile okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.3",
            "verseOrgIds": [
              "JER.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yeremia omunabii nabakalusia mbu Emuhuliile; lole, ndalamusaayila ewOMWAMI Nyasaye weenywe, shinga olwa musunjile; ne liosi liosi elia OMWAMI alangalusiamwo ndalamuboolela; shindalamubisakhwo likhuwa liosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.4",
            "verseOrgIds": [
              "JER.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamusunjila Yeremia bari OMWAMI abe omuloli weefwe owatoto omwisiikwa, nikhuba nikhurakhola ako kosi aka OMWAMI Nyasayewo alakhuruma ninako khwifwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.5",
            "verseOrgIds": [
              "JER.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nikali amalayi, kata nikali amabii, khulahulila amakhuwa kOMWAMI Nyasaye weefwe, owa khukhurumakhwo; mbu mana khukaase, olwa khulahulilanga amakhuwa kOMWAMI Nyasaye weefwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.6",
            "verseOrgIds": [
              "JER.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyuma lwetsindaalo ekhumi likhuwa liOMWAMI nilimwitsila Yeremia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.7",
            "verseOrgIds": [
              "JER.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yalanga Yohanani waKarea nabaseesia bamahe bosi aba yali ninabo, nende abandu bosi okhurula khumutuutu okhuula khumukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.8",
            "verseOrgIds": [
              "JER.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila mbu Kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola, owa mwarumakhwo okhura amasaayo keenywe imbeliwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.9",
            "verseOrgIds": [
              "JER.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Nimuba nimulatong'a nimushimenya mushialo shino, kho ndalamuumbakha nindamulikulula ta; ndalamuraaka nindamusiula ta; okhuba ndikalukhasiye khububii obwa ndamukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.10",
            "verseOrgIds": [
              "JER.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muramuria omuruchi waBabeli, oyo owa muriitsanga, ta; OMWAMI aboola mbu Muramuria ta; okhuba endi nineenywe okhumuhonia nokhumureesia mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.11",
            "verseOrgIds": [
              "JER.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalamubeela tsimbabasi, mbu ye amubeele tsimbabasi, namukalusia mushialo shieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.12",
            "verseOrgIds": [
              "JER.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa nimuba nimusunga mbu Shikhulamenya mushialo shino ta; nimurahulila amakhuwa kOMWAMI Nyasaye weenywe tawe, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.13",
            "verseOrgIds": [
              "JER.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "muri Tawe; ne khulatsia eMisiri; ebweneyo shikhulalolakhwo obusoolo kata okhuhulila amayoosi kolwika, kata okhulumwa inzala yebiokhulia ta; ebweneyo newa khulamenya; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.14",
            "verseOrgIds": [
              "JER.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho mana muhulile likhuwa liOMWAMI, inywe omusikali kwaYuda; mbu Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Nimuba nimuchoomilia elala tsimoni tsieenywe okhwiniila muMisiri, nimutsia okhumenyamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.15",
            "verseOrgIds": [
              "JER.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho olukanga olwa muriitsanga lulamunyoolelesia ebweneyo mushialo shiaMisiri, nayo inzala eyimuriisinjia yilamurakhwo olutsobi ebweneyo muMisiri; khandi ebweneyo newa mulafwila. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.16",
            "verseOrgIds": [
              "JER.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa kalaba khubandu bosi abachoomia tsimoni tsiabwe okhutsia eMisiri okhumenyayo; balafwa khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe; alabulaho oundi yesi khubo oulatong'a kata okhwihonokokha mushibii eshia ndalabakhupiakhwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.17",
            "verseOrgIds": [
              "JER.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Shinga oburima bwanje nobululu bwanje olwa bwasundulwa khubamenyanga eYerusalemu, nindio obululu bwanje bulasundulwa khwinywe burio, olwa muleenjila muMisiri; ne mulaba eshilaka munwa, abokhung'ang'aalilwa, nokhunyekwa, nokhuseywa; kata shimulalolakhwo eshialo shino khandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.18",
            "verseOrgIds": [
              "JER.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI waboolile khukeenywe, inywe omusikalo kwaYuda, mbu Muratsia eMisiri ta. Mumanye tieeli mbu emusiomeele inyanga yino. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba mwashiama nimukosia obulamu bweenywe, shichila mwaruma ewOMWAMI Nyasaye weenywe, nimusunga mbu Mukhusaayile ewOMWAMI Nyasaye weefwe; mana kosi aka OMWAMI Nyasaye weefwe alaboola, okhuboolele, neefu khulakakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi inyanga yino emurumbuliile kosi; nebutswa shimwahuliile amakhuwa kOMWAMI Nyasaye weenywe mwikbuwa liosi liosi elia yaruma okhumuboolela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano mumanye tieeli mbu mulafwa khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe, habundu tsana aha mwenya okhutsia okhumenya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
    }
  ],
