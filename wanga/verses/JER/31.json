      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.22",
            "verseOrgIds": [
              "JER.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI omwene mahe, Nyasaye walsiraeli, aboola; mbu Shikoono baliikhoonyela tsimboosi tsino mushialo shiaYuda nomumataala kalio, olwa ndilikalukhasia tsikhabi tsiabwe; mbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.23",
            "verseOrgIds": [
              "JER.31.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.25",
            "verseOrgIds": [
              "JER.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho nisisimukha, nihenga; tsi ndoolo tsianje nitsimbeela etsiolukoosi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Indakano imbia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Lola, tsindaalo tsiitsanga olwa ndalaraaka inzu yaIsiraeli neinzu yaYuda, imwo yabandu neimwo yemiruko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.27",
            "verseOrgIds": [
              "JER.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana kalaba kario, mbu shinga olwa ndabahenga bulayi okhusiula nokhulikulula, okhukwisia nokhusisia, nokhusandia; nolwa ndalabahenga bulayi okhuumbakha nende okhuraaka; nilwo olwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.28",
            "verseOrgIds": [
              "JER.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsilia shibalasunganga khandi mbu",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.29",
            "verseOrgIds": [
              "JER.31.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 31:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.30",
            "verseOrgIds": [
              "JER.31.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 31:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola mbu Lola, tsindaalo tsiitsanga olwa ndalalakana nende inzu yaIsiraeli neinzu yaYuda indakano imbia. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.31",
            "verseOrgIds": [
              "JER.31.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 31:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shiyilaba shinga indakano yilia eya ndalakana nabakuuka babwe khunyanga eya ndabatiila omukhono okhubarusia mushialo shiaMisiri tane indakano yanje yeneyo bachionoonia, kata olwa ndali shinga omwami wabwe owabateeshia; nilwo olwa OMWAMI aboola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.32",
            "verseOrgIds": [
              "JER.31.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yini niyo indakano eya ndalalakana nende inzu yaIsiraeli olunyuma lwetsindaalo etsio, OMWAMI aboola; mbu ndalara amalako kanje mukari mubo, kata mumioyo chiabwe ndalakaihandiikamwo; ndalaba Nyasaye wabwe, nabo balaba abandu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.33",
            "verseOrgIds": [
              "JER.31.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 31:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shibaleechesinjia buli mundu owashie, kata buli mundu omwana wabwe, ari Omumanye OMWAMI, ta, shichila bosi balaba nibamanyile, okhurula khumutuutu okhuula khumukhongo, OMWAMI aboola; okhuba ndalabaleshela obumayaanu bwabwe, kata obwonooni bwabwe shindalabwitsulilakhwo khandi ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.34",
            "verseOrgIds": [
              "JER.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 31:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.37",
            "verseOrgIds": [
              "JER.31.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 31:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Lola, tsindaalo tsiitsanga olwa litookho liloombashilwa OMWAMI okhurula khumunaara kwaHananeli okhuula khushilibwa eshili khukoona. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.38",
            "verseOrgIds": [
              "JER.31.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 31:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukoye okwokhuchela kulatsiililila imbeli, okhuula khushikulu shiaGarebu, mana nikukotola kutsie eGoa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.39",
            "verseOrgIds": [
              "JER.31.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 31:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libanda liosi liemilambo, nelielikoshe, nemikunda chiosi okhuula khumwalo kwaKidironi, okhuula khukoona yeshilibwa shietsifarasi enabukwe, lilaahulilwa OMWAMI; shililasiulwa kata okhukwisibwa khandi inziayo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.40",
            "verseOrgIds": [
              "JER.31.40"
            ]
          }
        }
      ]
    }
  ],
