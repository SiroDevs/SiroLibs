              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Mundaalo tsienetsio ndalaba Nyasaye webilibwa biosi biaIsiraeli, nabio biliba abandu banje.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.1",
            "verseOrgIds": [
              "JER.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
