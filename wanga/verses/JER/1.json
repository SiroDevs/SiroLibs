        "style": "s1"
      },
      "items": [
        {
          "text": "Yeremiah yalangwa, narumwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa kaYeremia waHilikia, owokhubakuhani abali nibali muAnatsotsi mushialo shiaBenyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "owa likhuwa liOMWAMI lieetsela mundaalo tsiaYosia waAmoni, omuruchi waYuda, mumuyika kwekhumi nakhataru okwomuburuchibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi liamwitsila mundaalo tsiaYehoyakimu waYosia, omuruchi waYuda, okhuula olwa omuyika kwekhumi nalulala kwaZedekia waYosia, omuruchi waYuda, olwa kwali nikuhweele, okhuula khukhwarwa khwabeYerusalemu nibayilwa mubuhambe, mumwesi kwakharaano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.5",
            "verseOrgIds": [
              "JER.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nimboola mbu E, Omwami NYASAYE! Lola, engorwa okhuboola; eshili butswa omuyia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.6",
            "verseOrgIds": [
              "JER.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi, liri Yeremia, eshia oluutsi nishiina? Ningalusia mbu Enduutsi olusaala Iwomulusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Oteechile, okhuba ehenganga likhuwa lianje, okhuliusia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.12",
            "verseOrgIds": [
              "JER.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa liOMWAMI nilinzitsila khandi olwakhabili, liri Eshia oluutsi nishiina? Ningalusia, mbu Enduutsi inyungu yamatsi akapapachila, niyifutaarila enotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Amabii kalarula elubeka Iwenotsi, nikabakwila abomushialo bosi pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola mbu Okhuba lola, enanga ebilibwa biosi bioburuchi bwosi bwenotsi; nabio bileetsa, nibira buli shilala eshifumbi shiashio shiobwami habwinjililo bwebilibwa bieYerusalemu, nende halukoba lwalio tsimbeka tsiosi, nende hamataala kosi kaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi ndalarumbula obukhalachi bwanje khubo khulwa obubii bwabwe bwosi; shinga olwa bandekha, nibasambila abanyasaye bandi amaleesi kelibuuliesi, nibeenamila emilimo chiamakhono kabwe abeene. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.16",
            "verseOrgIds": [
              "JER.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho khulwako, wibohe tsingubotsio mushishienje, orule, nobaboolela kosi aka ekhulakaorafwa omwoyo khukabwe ta, endeshe okhukhwira omwoyo imbeli wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.17",
            "verseOrgIds": [
              "JER.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lola, leelo luno ekhukhola obe litaala liolukoba, isiilo yeshibia, lisiisi liomukasa okhuyinga eshialo shiosi, okhuyinga abaruchi baYuda, nokhuyinga abakhulundu bashio, nokhuyinga abakuhani bashio, nokhuyinga abandu beshialo tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.18",
            "verseOrgIds": [
              "JER.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo balaseerana ninawe; nebutswa shibalakhuhula ta; okhuba isie endi ninawe okhukhuhonia; nilwo olwa OMWAMI aboola.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.19",
            "verseOrgIds": [
              "JER.1.19"
            ]
          }
        }
      ]
    }
  ],
