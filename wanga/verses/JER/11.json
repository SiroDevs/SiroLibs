            "sid": "JER 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia okhurula khuMWAMI ndielinoj mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hulila amakhuwa keindakano yino, mana osungane nabandu baYuda, nabamenyanga muYerusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "obaboolele mbu Kano niko aka OMWAMl, Nyasaye waIsiraeli, aboola, mbu Ali mushilaamo shiobubii omundu ourahulila amakhuwa keindakano yino ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "eya ndalaka abakuuka beenywe, khunyanga olwa ndabarusia mushialo shiaMisiri, okhurula mumulilo omululumu shinga okurulanga eshibia, mbu Hulilenje omwoyo kwanje, nimukhola kosi aka emulaka; kho mulabeetsanga abandu banje, nasi ndalabeetsanga Nyasaye weenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu endinyisie eshiitsubo eshia ndeetsubila abakuuka beenywe, okhubaheelesia eshialo eshiyembangamwo amabeele nende obuushi shinga olwa kali leelo. Mana ningalusia nisunga mbu Amina, OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Rumbula amakhuwa kano kosi mumataala kaYuda nomumihanda chieYerusalemu; ori Hulile amakhuwa keindakano yino, nimukakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndabalachilisia obutinyu abakuuka beenywe khunyanga olwa ndabatikulusia nimbarusia mushialo shiaMisiri, okhuula olwa leelo, nimbalachilisia khale, nilumilila okhubalachilisia, mbu Hulilenje omwoyo kwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shibahulila ta kata okhureka amarwi; ne nibachenda buli mundu mubutinyu bwomwoyokwe omubiiniko akachila nimbaleerela amakhuwa kosi keindakano yino, eya ndabalaka okhukhola, ne shibakhola ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyasunjila mbu Obusanjilili bunyooleeshe mubandu baYuda nomubamenyanga muYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakalushiile obumayaanu bwabakuuka babwe, abakhaya okhuhulila amakhuwa kanje; ne balondile khubanyasaye bandi nibachikhalabanila; abeinzu yaIsiraeli nabeinzu yaYuda boonooniye indakano yanje eya ndalakana nabakuuka babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka OMWAMI aboola; mbu Lola, ndalabakhupia khushibii eshia baranyala okhwihonokokha khushio ta; balahaabila, ne shindalabahulila tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abomumataala kaYuda nabamenyanga muYerusalemu balatsia nibahaabila abanyasaye abo aba basambilanga amalesi kelibuuliesi; ne shibalabahonia khunyanga yamasila kabwe, nahatuutu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abanyasayebo nabanji, shinga obunji bwamataalako, iwe Yuda; ne obunji bwemihanda chieYerusalemu shinga olwa buli, nolwa mwasinjisiliye eshietsisoni tsana ebimalilo biemisango, nibio ebimalilo ebiokhusambilakhwo Baali amalesi kelibuuliesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, orasabila abandu bano, kata okhuchinga omwoyo kata lisaayo khulwabo ta; okhuba shindalabahulila olwa bahaabila khunyanga yamasila kabwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelwa wanje ali arie munzu yanje, olwa yakholanga akobwilaasi? Ebiitsubo neinyama yemisango binyala okhukeng'a amatinyu akakhulindiilila noho? Ne onyala okhwikhoya noho? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khale OMWAMI yakhukulikha mbu Omutseituni omutendeemu, omukaasu, okuli nebiamo ebilayi; ne alakuhambia omulilo, nobuyoka bweimbumbuyeka ingali, ne amasaka kakwo kalayia pe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI omwene mahe owakhuraaka akhurumbuliile amabii, khulwa obubii bweinzu yaIsiraeli nobweinzu yaYuda obwa bakhola nibasinyisia muno khulwa okhusambila Baali amalesi kelibuuliesi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusanjilili okhukwisia Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, e OMWAMI omwene mahe, ouyaasinjia habwene, iwe outeemanga amayililisio nende omwoyo, fuchiilila endole eshikwolishio khubo; okhuba ereele eshifune shianje mumukhonokwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, kano niko aka OMWAMI aboola khumakhuwa kabaAnatsotsi abayiima obulamubwo, nibasunga bari Orarumbulila muliira liOMWAMI ta, oleshe okhufwila mumukhono kweefwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khulwako, kano niko aka OMWAMI aboola; mbu Lola, ndalabakuumaabasooliili balafwa khulwa olukanga, abaana babwe abasiani nabakhaana balafwa khulwa inzala; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "shibalatong'a kata mulala khubo taokhuba ndalakhupia abaAnatsotsi khushibii, mbu omuyika kwokhukuumwa khwabwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.23",
            "verseOrgIds": [
              "JER.11.23"
            ]
          }
        }
      ]
    }
