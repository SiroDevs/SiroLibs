          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne baboola mbu Nibutswa! Khulalonda tsiyemi tsieefwe, nikhukhola buli mundu akarula mubutinyu bwomwoyokwe omubii.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukhobani bwabandu nende lisaayo liaYeremia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
