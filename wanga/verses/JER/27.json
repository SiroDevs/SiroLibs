    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eliechesio liebisekeyi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhuchaaka khwokhuruka khwaZedekia waYosia, omuruchi waYuda, likhuwa lino liamwitsila Yeremia okhurula khuMWAMI; mbu ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI yamboolela; mbu Wikholele ebitorofu nebisekeyi, nobira khwikosilio. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obakbupile omulome omuruchi waEdomu, nomuruchi waMoabu, nomuruchi wabaana baAmoni, nomuruchi waTiro, nomuruchi waSidoni, mumunwa kwabarume abeetsile eYerusalemu ewaZedekia omuruchi waYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obalachilisie amakhuwa kano, okhuboolela abaami babwe, mbu Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Mulaboolela abaami beenywe muri ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nisie owalonga eshialo nobunyali bwanje obukhongo nomukhono kwanje okunyiililwe; ndalonga eshialo, nende abandu netsisolo etsili khushio; ne eshihaanila oyo owa endola nakhoyeele. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano ndamuheelesiye omusumba wanje Nebukhadineza, omuruchi waBabeli, ebialo bino biosi mumukhonokwe, kata nende ebili mwoyo ebiomushitsiimi ndamuheelesiye mbu bimukhalabanile. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga nako kosi kalamukhalabanila ye, nomwanawe, nomwitsukhuluwe, okhuula olwa induukho yeshialo shishie yilaba niyulile; mana amahanga amanji nabaruchi abakhongo balamukhola omusumba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lihanga liosi kata aboburuchi bwosi abakhaya okhukholela Nebukhadineza tsana, omuruchi waBabeli, abakhaya okhwinjisia amakosi kabwe mwikokolo liomuruchi waBabeli, kho OMWAMI aboola ari Ndalakuuma lihanga elo nolukanga nende inzala nende oluumbe, okhuula olwa ndalaba nimbasishiye nomukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa inywe, murahulilanga abanabii beenywe tawe, kata abafumu beenywe, kata abamalooro beenywe, kata abebitsoyelo beenywe, kata abalookooli beenywe, abamuboolelanga bari Murakholela omuruchi waBabeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba bamurumbulila akobubeeyi, okhumurusia mushialo shieenywe ehale muno; nasi ndalamwilusia, mana mulasikha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa lihanga elifuchiilila okhwinjisia amakosi kabwe mwikokolo liomuruchi waBabeli, nibamukholela, elienelo ndalalekha lisikale mushialo shiabwe, OMWAMI aboola; balashilima, nibamenyamwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ndasunjila Zedekia omuruchi waYuda amakhuwa kano kosi; mbu Mwinjisie amakosi keenywe mwikokolo liomuruchi waBabeli, nimumukholela ye nende abandube, mube mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishiina eshichila nimwenya okhufwa, iwe nabandubo, khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe, shinga OMWAMI olwa yaboolile khukelihanga elikhaya okhukholela omuruchi waBabeli? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murahulilanga amakhuwa kabanabii abasungananga nineenywe, bari Murakholela omuruchi waBabeli ta; okhuba bamurumbulilanga akobubeeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba isie shindabaruma ta, OMWAMI aboola; ne barumbulilanga akobubeeyi muliira lianje; mbu emwilusie, neenyu nimusikha, inywe nabanabii abo abamularumbulilanga amakhuwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndasunjila abakuhani nende abandu bano bosi, mbu Kano niko aka OMWAMI aboola; mbu Murahulilanga amakhuwa kabanabii beenywe abamurumbulilanga amakhuwa nibasunga bari Lole, ebimanulwa bieinzu yOMWAMI bili okhukalusibwa okhurula eBabeli, ta; okhuba bamurumbulila akobubeeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murabahulila tawe; kholelenje omuruchi waBabeli, mube mwoyo; nishiina eshiakhachila litookho lino likwe likunda? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nibaba nibali abanabii, khandi nibaba nibali nende likhuwa liOMWAMI, kho basaaye OMWAMI omwene mahe mbu ebimanulwa ebio ebishitong'a munzu yOMWAMI, nomunzu yomuruchi waYuda, nende eYerusalemu, bileshe okhuyilwa eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kano niko aka OMWAMI omwene mahe aboola khuketsisiilo, nende inyanza tsana yomukasa nende obwala, nende khubindi biosi ebiokhubimanulwa ebishitong'a mwitookho lino, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebia Nebukhadineza arabukula ta olwa yaara Yekonia waYehoyakimu omuruchi waYuda muYerusalemu namuyila eBabeli, halala nende abamakuru beYuda neYerusalemu bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.20",
            "verseOrgIds": [
              "JER.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola khukebimanulwa ebishitong'a munzu yOMWAMI, kata munzu yomuruchi waYuda, kata eYerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.21",
            "verseOrgIds": [
              "JER.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu bilayilwa eBabeli nibibayo ebweneyo okhuula khunyanga olwa ndalabakoonya, nilwo olwa OMWAMI aboola; mana ndalabatikulusia nimbakalusia habundu hano.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.22",
            "verseOrgIds": [
              "JER.27.22"
            ]
          }
        }
      ]
    }
