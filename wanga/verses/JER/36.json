            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeremia nabukula eshitabu shindi eshikanye, naheelesia Barukhu omuhandiichi, omwana waNeria; naye nahandiikamwo akarula mumunwa kwaYeremia, mbu amakhuwa kosi keshitabu eshia Yehoyakimu yali nasambile mumulilo; khandi amakhuwa kandi amanji akafwana kario kameetwakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.32",
            "verseOrgIds": [
              "JER.36.32"
            ]
          }
        }
