            "number": "3",
            "style": "v",
            "sid": "JER 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lola, OMWAMI aboola mbu Tsindaalo tsiitsanga olwa ndalakalusia tsikhabi tsiabandu banje Isiraeli nende Yuda, OMWAMI aboola; ne ndalabakalusia mushialo eshia ndaheelesia abakuuka babwe; ne balashilia.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.3",
            "verseOrgIds": [
              "JER.30.3"
            ]
          }
        }
