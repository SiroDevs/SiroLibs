          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko aka OMWAMI, Nyasaye waIsiraeli, asunga; mbu Handiika amakhuwa kosi aka ndakhusunjila mushitabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.2",
            "verseOrgIds": [
              "JER.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
