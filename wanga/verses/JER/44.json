          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia nameeta nasunjila abandu abo bosi, halala nabakhasi bosi, ari Hulile likhuwa liOMWAMI, inywe abaYuda mwesi abali mushialo shiaMisiri; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.24",
            "verseOrgIds": [
              "JER.44.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 44:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Kano niko aka OMWAMI omwene mahe, Nyasaye waIsiraeli, aboola; mbu Inywe nabakhasi beenywe mwaboolile neminwa chieenywe, nimukoosia namakhono keenywe, muri Okhukhola khulakhola akebiitsubo bieefwe ebia khweetsuba, mbu okhusambila omuruchi weshikhasi owelikulu amalesi kelibuuliesi nokhumutsushiilila emisango echiokhutsushila; kho ralisie ebiitsubo bieenywe, nimukhola akebiitsubo bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.25",
            "verseOrgIds": [
              "JER.44.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 44:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwako, hulile likhuwa liOMWAMI, inywe abaYuda mwesi abamenya mushialo shiaMisiri; mbu Lole, ndeetsuba khuliira lianje likhongo, OMWAMI aboola, mbu eliira lianje shililarumbulwa khandi nomunwa kwomundu yesi waYuda mushialo shiosi shiaMisiri, mbu Shinga Omwami NYASAYE olwa abeetsanga mwoyo, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.26",
            "verseOrgIds": [
              "JER.44.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
