    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Basiomelwa mbu obumululwi nende obwarwi bunyala okhubeetsela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
