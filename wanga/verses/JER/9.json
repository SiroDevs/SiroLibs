          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI aboola mbu Lola, tsindaalo tsili okhwitsa olwa ndalabakuuma abashebe bosi abali butswa mubusinde; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.25",
            "verseOrgIds": [
              "JER.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Misiri, naYuda, naEdomu, nabaana baAmoni, naMoabu, nabosi abeebekanga lituma, abamenya mushitsiimi; okhuba amahanga ako kosi nabasinde, ne bosi abeinzu yaIsiraeli nabasinde mumwoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.26",
            "verseOrgIds": [
              "JER.9.26"
            ]
          }
        }
