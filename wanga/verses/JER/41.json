      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho mumwesi kwomusaafu Ishimaeli waNetsania waElishama, owali oweinzu yomuruchi, nali owokhubakali bomuruchi, yeetsa nende abandu ekhumi ewaGedalia waAhikamu eMizipa, nibaliayo ebiliibwa halala eMizipa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ishimaeli waNetsania nabandu abo ekhumi aba yali ninabo nibabuukha, nibarema Gedalia waAhikamu waShafani nolukanga nibamwira, oyo owa omuruchi waBabeli yali niyayeemeeshe abe kafuna weshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimaeli niyeera nende abaYahudi bosi aba yali ninabo, mbu aba Gedalia yali ninabo, eMizipa, khandi nende abaKalidayo abanyoolekhayo, nibo abaseeri tsana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yakhabili, eyalonda khunyanga olwa yali niyeerile Gedalia, abandu nibarashiamanyakhwo ta, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "abandu bandi barula eShekhemu, nende eShiilo, nende eSamaria, abandu amakhumi munaane, nibeebechile ebileefu, nibaranduule tsingubo tsiabwe, nibeesalaache tsisalache; ne bali nebihaanwa bieimele nobubaane mumakhono, okhubiyila munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ishimaeli waNetsania narula eMizipa okhubaakaanila, nalila amasika nachenda; ne olwa yaakaana ninabo yabasunjila mbu Chende khutsie ewaGedalia waAhikamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa boola mwitookho hakari Ishimaeli waNetsania nabandu aba yali ninabo nibabeera, nibabasukuna mubwina bundi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandi ekhumi abali khubo nibasunjila Ishimaeli bari Orakhwira ta; okhuba khuli nemibiikho chieingaano neishayiri namafura nende obuushi, echia khubisile mumikunda. Kho nabalekha ario, narabeera halala nabashiabwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obwina obwa Ishimaeli yasukunamwo emilambo chiosi chiabandu abo aba yali niyeerile bwali obwina obukhongo tsana obwa omuruchi Asa yakhola khulwa okhuria Baasha omuruchi waIsiraeli. Ishimaeli waNetsania nabwitsusia abeerwa abo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Ishimaeli yabahamba imbambe omusikalo kwosi kwabandu abali nibali muMizipa nabayila; mbu abakhaana beinzu yomuruchi nabandu bosi abali nibasikaale muMizipa, aba Nebuzaradani omwimilisi wabasikari abalindi yali nahaanile mumukhono kwaGedalia waAhikamu; Ishimaeli waNetsania yabahamba nabayila, niyeenyokha niyaambukha okhutsia khubaana baAmoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa Yohanani waKarea nabaseesia bosi bamahe abo aba yali ninabo bahulila akobubii obwo bwosi obwa Ishimaeli waNetsania yali nakholile, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "babukula abandu babwe bosi, nibatsia okhuseera Ishimaeli waNetsania, nibamunyoolelesia heetiba likhongo elili muGibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa abandu bosi aba Ishimaeli yali ninabo balola Yohanani waKarea nende abaseesia bamahe abo bosi aba yali ninabo, nibatsatsahala ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abandu abo bosi aba Ishimaeli yali nahambile imbambe nabarusia eMizipa, nibashiukhana nibakalukha nibatsia ewaYohanani waKarea. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Ishimaeli waNetsania yeehonokokha khuYohanani, nabandu munaane halala ninaye, nibatsia khubaana baAmoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yohanani waKarea nabaseesia bamahe abo bosi aba yali ninabo, babukula omusikalo kwosi kwabandu aba yali nahoniye mumukhono kwaIshimaeli waNetsania, owabarusia eMizipa namalile okhwira Gedalia waAhikamu, nibo abaseeri, nabakhasi, nabaana, nabasumba abalate, aba Yohanani yakalusia okhurula eGibeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatsia nibamenya eGerutsi Khimuhamu, eyili ahambi nende Betselehemu, nibeenya okhutsia eMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khulwa amakhuwa kabaKalidayo; okhuba babariitsanga, shichila Ishimaeli waNetsania yali niyeerile Gedalia waAhikamu, owa omuruchi waBabeli yali niyayeemeeshe abe kafuna weshialo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
