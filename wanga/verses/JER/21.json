          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elieetsela Yeremia okhurula khuMWAMI, olwa omuruchi Zedekia yamurumila Pashihuri waMalikhiya, naZefania waMaaseya omukuhani, ndielino; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.1",
            "verseOrgIds": [
              "JER.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Nochama, okhureebele ewOMWAMI; okhuba Nebukhadineza omuruchi waBabeli akhuseerile; haundi OMWAMI alakhukholela shinga ebikholebie biamakana biosi olwa bili, namurusia khwifwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yeremia nabasunjila mbu Mulaboolela Zedekia muri nanwa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola; mbu Lole, ndalashiukhasia ebimanulwa bielihe ebili mumakhono keenywe, ebia museerelanga omuruchi waBabeli nende abaKalidayo abamwikaliile nibali elwanyi wolukoba; ne ndalabakhung'aasia halala mwitookho elo mukari. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi omwene ndalamuseera nomukhono okunyiililwe, omukhono kwamaani, mubusinyishi nomubululu nomuburima obunji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ndalarootsa abamenyanga mwitookho lino, ari abandu ari emiruko; balafwa khulwa oluumbe olukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.6",
            "verseOrgIds": [
              "JER.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo, OMWAMI aboola, ndalahaana Zedekia omuruchi waYuda, nabasumbabe, nende abandu abakhaba nibatong'ile mwitookho lino inyuma woluumbe nolukanga neinzala, mumukhono kwaNebukhadineza omuruchi waBabeli, nomumukhono kwabasuku babwe, nomumukhono kwa abo abayiima obulamu bwabwe; naye alabakhupa nolukanga; shialabasaalilila, kata okhubatiililwa eshisa, kata okhubabeela tsimbabasi ta.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.7",
            "verseOrgIds": [
              "JER.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubandu bano, olabasunjila mbu Kano niko aka OMWAMI aboola; mbu Lole, era imbeli weenywe injila yobulamu nende injila yokhufwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.8",
            "verseOrgIds": [
              "JER.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Outong'a mwitaala lino alafwa khulwa olukanga, nokhulwa inzala, nokhulwa oluumbe; habula ourulamwo, niyeelushila ewabaKalidayo abamwikalila, ye alaba mwoyo, ne obulamubwe bulaba eshiyaayoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.9",
            "verseOrgIds": [
              "JER.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba enyumiliye litookho lino tsimoni nindifukula, khulwa amabii, amalayi ta; nilwo olwa OMWAMI aboola. Lilahaanwa mumukhono kwomuruchi waBabeli, naye alalisamha nomulilo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.10",
            "verseOrgIds": [
              "JER.21.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obulakusi bwokhufukula abaruchi baYuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
