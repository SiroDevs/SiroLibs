      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omuyika kwobulekhuulwi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa emiyika chiba nichihweele musaafu, okhole obulekhuuli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.1",
            "verseOrgIds": [
              "DEU.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne obulekhuuli obwo bube buri nanwa; mbu buli muhosii owahosia, alekhuule ako aka yahosia owashie; aramubanza owashie ouli omwana wabwe ta; okhuba obulekhuuli bwOMWAMI burumbuulwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.2",
            "verseOrgIds": [
              "DEU.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu omusuku, omubanze; ne eshindushio shiosi eshia omwana weenywe ali ninashio, omukhonokwo kushilekhuule. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.3",
            "verseOrgIds": [
              "DEU.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shibeetsa okhubamwo abamanani mwinywe ta, noba noreka amarwi butinyu khumwoyo kwOMWAMI Nyasayewo, okhwitsulilanga okhukhola lilako lino liosi elia ekhulaka leelo; okhuba OMWAMI shialachweya okhukhuheelesia ikhabi mushialo eshia OMWAMI Nyasayewo akhuheelesia shibe obulaame, mbu shibe eshishio omwene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.5",
            "verseOrgIds": [
              "DEU.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI Nyasayewo alakhuheelesia ikhabi, shinga olwa yakhusuubisia; nawe olahosinjia abamahanga amanji; habula nawe omwene shioleehola ta; khandi olarukanga amahanga amanji, nebutswa nako shikalakhuruka iwe ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.6",
            "verseOrgIds": [
              "DEU.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba noli nende omundu omumanani, owokhubaana beenywe, nali mwitaalalio liosi eliomushialo eshia OMWAMI Nyasayewo akhuheelesia, oroomia omwoyokwo, kata okhufumba omukhonokwo khumwana weenywe omumanani oyo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.7",
            "verseOrgIds": [
              "DEU.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa omufumbulile bufumbula omukhonokwo, nomukhoonya ebihela obutambibwe, mu ebio ebia yeenya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.8",
            "verseOrgIds": [
              "DEU.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wirecheshe oleshe okhuba nelipaaro mumwoyo elirakhoyeele ta, mbu Omuyika kwomusaafu, omuyika kwobulekhuuli, kuli ahambi; mana ohenga omwana weenywe nende okhumookoola, noramuheelesiakhwo eshindu ta; naye nahaabila OMWAMI khukoko, nishiba khwiwe eshionoono. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.9",
            "verseOrgIds": [
              "DEU.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuheelesia omuheelesinjie ebindu; ne omwoyokwo kuleshe okhusinyikha olwa omuheelesinjiakhwo, shichila khulwa likhuwa liene lino OMWAMI Nyasayewo alakhuheelesia ikhabi mumilimochio chiosi, nomukosi aka oreetsangakhwo o nukhono okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.10",
            "verseOrgIds": [
              "DEU.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abamanani shibalihwaho mushialo nahatuutu ta; niko akachila nikhulaka ndi Olamufumbulilanga bufumbula omwana weenywe omukhonokwo, nende khubatakha, nende khubamanani, abali mushialoshio.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka omundu akhoyile okhukholelanga abakholibe abakule",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.11",
            "verseOrgIds": [
              "DEU.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwana weenywe, omuHeburania omusaatsa kata omukhasi, naba nakusibwa khwiwe, nakhukhalabanila emiyika chisasaba, mana mumuyika kwomusaafu omulekhuule akhurulekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.12",
            "verseOrgIds": [
              "DEU.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omulekhuula akhurulekhwo, oramulekha atsie amakhono amakhaya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.13",
            "verseOrgIds": [
              "DEU.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omumanusie nomukhono omusiro okhurula khubiayobio, nokhurula mulwanyi ewa ohuulilanga imele, nokhurula khushitiinyilo shieidivai; shinga OMWAMI Nyasayewo olwa yakhuheelesia ikhabi, omukabilekhwo orio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.14",
            "verseOrgIds": [
              "DEU.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witsulilenje shinga olwa walinji omusumba mushibala shiaMisiri, OMWAMI Nyasayewo nakhununula; niko akachila nikhulaka likhuwa lino leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.15",
            "verseOrgIds": [
              "DEU.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa naba nakhusunjila mbu Shinzenya okhukhurulakhwo ta, shichila akhuheela iwe nabomunzuyo, ekhuba akeke kakaasanga nali ninawe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.16",
            "verseOrgIds": [
              "DEU.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho obukule oluchela, nofutulila eshirvishie khulwichi, mana alaba omusumbawo tsindaalo tsiosi Kata nende omukholiwo weshikhasi yesi omukholele orio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.17",
            "verseOrgIds": [
              "DEU.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raleshe okhukhubeela amatinyu olwa omulekhuula akhurulekhwo; okhuba eshia akhukholeele emiyika chisasaba chihela omurungo kwowomushaara eshikhabili; ne OMWAMI Nyasayewo alakhuheelesia ikhabi mukosi aka okhola.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obwahulwi bwebiikulanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.18",
            "verseOrgIds": [
              "DEU.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiibulwa biambeli ebili bieshisaatsa mung'ombetsio nomubiayobio, obiahulile OMWAMI Nyasayewo; orashira khumilimo, eshiibulwa shiambeli shieing'ombeyo, kata orashiteta obwoya eshiibulwa shiambeli shieshiayoshio ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.19",
            "verseOrgIds": [
              "DEU.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oshiliile, iwe nende abomunzuyo, imbeli wOMWAMI Nyasayewo omuyika buli muyika, habundu tsana aha OMWAMI alalobola. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.20",
            "verseOrgIds": [
              "DEU.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nishiba nishilikhwo nobulema bwosi, nishitiechela, kata nishibofuule imoni, mbu obulema bwosi bwosi obubii, orashimala omusango kwOMWAMI Nyasayewo ta ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.21",
            "verseOrgIds": [
              "DEU.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oshiliile mwitaalalio; omusiiyikhu nouli nobukaali bombi baliekhwo, shinga eshitsusu kata shinga imbongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.22",
            "verseOrgIds": [
              "DEU.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula mbu oraliitsanga amalasile kashio ta; okatsushe khwiloba shinga amatsi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.15.23",
            "verseOrgIds": [
              "DEU.15.23"
            ]
          }
        }
      ]
    }
  ],
