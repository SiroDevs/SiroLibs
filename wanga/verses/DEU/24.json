    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako khukobukabukhani bwomusaatsa nomukhasiwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omundu aba naleera omukhasi, namuteeshia, naye naramuchamisia ta, shichila anyoolile muye likhuwa elirakhoyeele ta, kho amuhandiichile ibarwa yobukabukhani, nachimuheelesia mumukhono, namurusia munzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.1",
            "verseOrgIds": [
              "DEU.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa aba niyeenyooshe narulile munzuye, anyala okhutsia okhuteeshela omusaatsa undi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.2",
            "verseOrgIds": [
              "DEU.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omusaatsa oyo wakhabili naba namukiya, namuhandiichila ibarwa yobukabukhani, namurusia munzuye; kata omusaatsa owamuleera wakhabili oyo naba nafwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.3",
            "verseOrgIds": [
              "DEU.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omusaatsa owambeli, oyo owamuseebula, aramuleera abe omukhasiwe khandi ta, olwa aba namalile okhwonoonibwa; okhuba likhuwa elo neshisinyo imbeli wOMWAMI; orachila eshialo nishionoona, eshia OMWAMI Nyasayewo yakhuheelesia mbu shibe obulaame.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.4",
            "verseOrgIds": [
              "DEU.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omundu aba naleerile omukhasi omweha, aleshe okhurula atsie mwihe, kata okhulachilisibwa emilimo chindi ta; abe hango nali omulekhuule omuyika mulala, amusangaasie omukhasiwe owa aleerile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amalako kandi nakandi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.5",
            "verseOrgIds": [
              "DEU.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi aleshe okhubukula oluchina kata isio shibe omusingo ta; okhuba yakhaba nabukuule obulamu bwomundu bube omusingo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.6",
            "verseOrgIds": [
              "DEU.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu yesi naba nanyoolelesibwa niyeeba oundi owomubaana babwe, owomubaana baIsiraeli, namukholela shinga omukula, kata okhumukusia, kho omwibi oyo afwe; nilwo olwa olarusia obubii obuli hakari weenywe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.7",
            "verseOrgIds": [
              "DEU.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiyile kahala muluumbe lwobuchele, mbu witsulilenje bulayi nokhola kosi aka abakuhani abaLawi balamwibaalila; shinga olwa ndabalaka, neenyu mwitsulilenje okhukhola murio. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.8",
            "verseOrgIds": [
              "DEU.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witsulilenje aka OMWAMI Nyasayewo yakholela Miriamu khunjila olwa mwali nimurula eMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.9",
            "verseOrgIds": [
              "DEU.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oba nomuhosia owashio eshindu shiosi shiosi, oreenjila munzuye okhwenda omusingo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.10",
            "verseOrgIds": [
              "DEU.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osinjile butswa elwanyi, naye omundu owa ohosiye akhurusilie omusingo ewa oli elwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.11",
            "verseOrgIds": [
              "DEU.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba nali omumanani, orakona noli nomusingokwe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.12",
            "verseOrgIds": [
              "DEU.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhukalusia omukalusilie omusingo tsana olwa eliuba liyeela, mbu akone neinguboye, nakhusabila ikhabi; mana kalakhubeela obulunjishi imbeli wOMWAMI Nyasayewo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.13",
            "verseOrgIds": [
              "DEU.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oramumiina omukholi owahandiikwa omushaara, nali omumanani omutakha, kata olwa yakhaba owokhubaana beenywe, kata owokhubarende abomushialoshio, mwitaalalio, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.14",
            "verseOrgIds": [
              "DEU.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuheelesinjie omushaarakwe buli nyanga, kata oralekha eliuba liyeele nikushili ta; okhuba nomumanani, khandi akureelekhwo omwoyo; aleshe okhuhaabila OMWAMI khukoko, nako nikaba mwiwe eshionoono.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.15",
            "verseOrgIds": [
              "DEU.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Basamwana baleshe okhwirwa khulwa akabaana babwe, kata abaana okhwirwa khulwa akabasamwana; buli mundu yeerwe khulwa eshio-noono shishie omwene.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.16",
            "verseOrgIds": [
              "DEU.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orashiamia eshiina shiomurende kata omubisandu kata okhubukula eshiifwalo shiomukhasi omulekhwa shibe omusingo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.17",
            "verseOrgIds": [
              "DEU.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne mbu witsulilenje shinga olwa walinji omusumba muMisiri, naye OMWAMI Nyasayewo yakhununula nakhurusiayo; niko akachila nikhulaka mbu okhole likhuwa lino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.18",
            "verseOrgIds": [
              "DEU.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oba nochesa lichesa eliomukundakwo, ne niwibiliile eshinywa eshiba mumukunda, orakalukhayo okhushienda ta; shibe eshiomurende, neshiomubisandu, neshiomukhasi omulekhwa; mbu OMWAMI Nyasayewo akhuheelesie ikhabi mumilimo chiosi chiamakhonoko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.19",
            "verseOrgIds": [
              "DEU.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oba nobungulusia omutseitunikwo, oreeluula mutsisaka ta; tsibe etsiomurende, netsiomubisandu, netsiomukhasi omulekhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.20",
            "verseOrgIds": [
              "DEU.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa oba nonoka tsinzabibu etsiomumukundakwo, orarulumanga inyuma ta; tsibe etsiomurende, netsiomubisandu, netsiomukhasi omulekhwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.21",
            "verseOrgIds": [
              "DEU.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witsulilenje shinga olwa walinji omusumba mushibala shiaMisiri; niko akachila nikhulaka mbu okhole likhuwa lino.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.24.22",
            "verseOrgIds": [
              "DEU.24.22"
            ]
          }
        }
      ]
    }
  ],
