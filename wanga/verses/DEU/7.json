    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oluyia olutakatifu lwOMWAMI",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa OMWAMI Nyasayewo alakhwinjisia mushialo eshia otsia okhubukula, niyeeya amahanga amanji imbeliwo, mbu abaHiti, nabaGirigashi, nabaAmori, nabaKanaani, nabaPerizi, nabaHiwi, nabaYebusi, amahanga ako musaafu akakhushila obukhongo netsingufu; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi olwa OMWAMI Nyasayewo alabahaana imbeliwo, nawe nobarootsa; kho olabatibilia elala; oralia ninabo omuuma kwosi, kata okhubabeela tsimbabasi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata orakhweelelana ninabo, mbu orabakha omukhaanawo khumusianiwe, kata okhubukula omukhaanawe nomukhweesia omusianiwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
              "DEU.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ye yakhashiukhasia omusianiwo aleshe okhunondakhwo, mbu bakhalabanile abanyasaye bandi; ne nolwa oburima bwOMWAMI bwakhakhwashila, naye nakhusishia bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mubakholele muri nanwa; mbu mulikulule ebimalilo biabwe biemisango, nimusasaka tsisiilo tsiabwe tsisongoknu, nimurema emiAshera chiabwe, nimusamba ebifwanani biabwe ebibaatse nomulilo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.5",
            "verseOrgIds": [
              "DEU.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila oli oluyia olutakatifu lw Nyasayewo; OMWAMI Nyasayewo yakhulobola obe oluyia olukoosi olwakhaba olulwe omwene, okhushila tsimbia tsiosi etsili khushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.6",
            "verseOrgIds": [
              "DEU.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI shiyamuhamba obwitsa, kata shiyamulobola inywe, shichila mwashila abandi obunji, tawe; okhuba mwali abatuutu abaleema khubandu bosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.7",
            "verseOrgIds": [
              "DEU.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa okhuba OMWAMI amuheelanga, khandi okhuba yeenya okhuusia eshiitsubo eshia yeetsubila abakuuka beenywe, niko akachila OMWAMI yamurusiamwo nomukhono kwamaani, namununula namurusia munzu yobunyakhani, okhurula mumukhono kwaFarao omuruchi waMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.8",
            "verseOrgIds": [
              "DEU.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mumanye mbu OMWAMI Nyasayewo niye Nyasaye; mbu Nyasaye omwisiikwa, owusinjia indakanoye nobuheeli oburalilu khubeenabo abamuheelanga nibahulila amalakoke okhuula khunzibulo eshikhumila, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.9",
            "verseOrgIds": [
              "DEU.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abarunganga habulafu abo abamukiya, nabatibia khumwenoyo oumukiya, shiashindanga ta; alamurunga habulafu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.10",
            "verseOrgIds": [
              "DEU.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olindenje lilako, nende akalachilisibwa, nobukhalachi bwosi, ebia ekhulachilisia inyanga yino, mbu obikholenje.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsikhabi etsiitsa khulwa obuhulili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.11",
            "verseOrgIds": [
              "DEU.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuba muhulilanga obukhalachi buno bwosi, nobulinda nobukhola, OMWAMI Nyasayewo alakhuusilinjia indakano nobuheeli oburalilu ebia yeetsubila abakuukabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.12",
            "verseOrgIds": [
              "DEU.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "alakhuheelanga, nakhuheelesia ikhabi, nakhwinjiyia; alabiheelesinjia ikhabi ebiamo biomubilikwo nende ebiamo bielilobalio, imeleyo neidivaiyo namafurako, amameeto ketsing'ombetsio nebiimeeme biebiayobio, mushialo eshia yeetsubila abakuukabo mbu yakhakhuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.13",
            "verseOrgIds": [
              "DEU.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olaheebwa ikhabi okhushila tsimbia tsiosi tsiabandu; shialabamwo omundu weshisaatsa kata oweshikhasi mwinywe oulakumbahala, kata mumiruko chieenywe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.14",
            "verseOrgIds": [
              "DEU.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI alarusia khwinywe obulwale bwosi; shialarakhwo khwiwe oluumbe lwosi olwokhunyumbe tsimbii etsiaMisiri, etsia wamanya, ta; ne alatsira khubeenabo bosi abamukiyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.15",
            "verseOrgIds": [
              "DEU.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe omalilane tsimbia tsiosi tsiabandu etsia OMWAMI Nyasayewo alakhuhaanila; imoniyo yileshe okhubatiililwa eshisa; kata olakhalabanila abanyasaye babwe ta; okhuba liakhaba omubero khwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.16",
            "verseOrgIds": [
              "DEU.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba noliyililisia mumwoyokwo mbu Amahanga kano kashila; nenyale endie okhubukula eshialo shiabwe? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.17",
            "verseOrgIds": [
              "DEU.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho orabaria ta, yitsulila bulayi aka OMWAMI Nyasayewo yakholela Farao nende Misiri yosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
            "verseOrgIds": [
              "DEU.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu obuteemwi obukhongo obwa tsimonitsio tsialola, nebilolelo, nakamangaliimwa, nomukhono kwamaani, nomukhono okunyiirilwe okhuhonia, ebia OMWAMI Nyasayewo yakhurusia ninabio; ne nilwo olwa OMWAMI Nyasayewo alakholela tsimbia etsio tsiosi etsia oriitsanga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.19",
            "verseOrgIds": [
              "DEU.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI Nyasayewo alaruma lihalamba elo hakari mubo, okhuula olwa abo ababa nibasikaale nibeebisa imbeliwo balaba nibatibile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.20",
            "verseOrgIds": [
              "DEU.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Orabariitsanga taokhuba OMWAMI Nyasayewo ali hakariwo, Nyasaye omukhongo owamariisia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.21",
            "verseOrgIds": [
              "DEU.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI Nyasayewo alarusinjia amahanga ako imbeliwo, hatiiti hatiiti; shionyala okhubamalilana khulala ta; tsisolo etsiomubulimo tsiakhakhwinjiyila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.22",
            "verseOrgIds": [
              "DEU.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI Nyasayewo alabahaana imbeliwo, nabakoyaasia muno, okhuula olwa balaba nibamalilaanwe pe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.23",
            "verseOrgIds": [
              "DEU.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi alahaana abaruchi babwe mumukhonokwo, nawe olasishia ameera kabwe, nikaranyoolekha hasi welikulu liosi ta; shialabaho omundu yesi oulanyala okhusinjila imbeliwo ta, okhuula olwa olaba nobamalilaane. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.24",
            "verseOrgIds": [
              "DEU.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebifwanani ebibaatse biabanyasaye babwe, mubisambe nomulilo; orakhaayilwa ifeetsa kata itsahaabu eyakhaba niyili khubio, kata okhuchibukula, tawe; oleshe okhutiilwa mumubero; okhuba neshisinyo khuMWAMI Nyasayewo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.25",
            "verseOrgIds": [
              "DEU.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata oraleera eshisinyo munzuyo, omwene nokwa owomusilo, shinga shio olwa shili, ta; shikhubiiyile elala, nishikhusinya; shichila neshiomusilo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.26",
            "verseOrgIds": [
              "DEU.7.26"
            ]
          }
        }
      ]
    }
  ],
