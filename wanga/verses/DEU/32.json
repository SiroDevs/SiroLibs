          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa niyeetsa naboola amakhuwa kosi kolwimbo luno, abandu nibahulila, ye naYoswa waNuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 32:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Musa yali namalilisiye okhuboolela Isiraeli yosi amakhuwa kano kosi ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "yabasunjila ari Rekhwo omwoyo khumakhuwa kosi aka emurumbulila leelo; ne niko aka mulalachilisia aoaana beenywe, mbu beetsulilenje okhukhola amakhuwa kosi kamalako kano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinelikhuwa likhaya khwinywe ta; shichila nobulamu bweenywe, ne khulwa likhuwa lino tsindaalo tsieenywe tsilameetekha mushialo eshia mutsia okhwambukha Yorodani okhushibukula.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa yafuchiililwa okhuhengakhwo eshialo shiaKanaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
