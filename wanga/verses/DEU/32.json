          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI yasungana naMusa khunyanga yeneyo, naboola mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "DEU 32:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikulukha otsie mushikulu shino shiaAbarimu, okhuula khushikulu shiaNebo eshili mushialo shiaMoabu, ahahengana naYeriko; olole eshialo shiaKanaani, eshia eheelesia abaana baIsiraeli shibe eshiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.49",
            "verseOrgIds": [
              "DEU.32.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "DEU 32:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ofwileyo mushikulu eshia olatikulukhayo, olonde khubandu beenywe; shinga Haruni omwana weeny ve olwa yafwila mushikulu shiaHori, nalonda khubandu babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.50",
            "verseOrgIds": [
              "DEU.32.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "DEU 32:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila mwakholela obukhobani hakari wabaana baIsiraeli, hamatsi kaMeriba eKadeshi mushitsiimi shiaZini; shichila shimwalolosia obutakatifu bwanje hakari wabaana baIsiraeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.51",
            "verseOrgIds": [
              "DEU.32.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "DEU 32:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba olalola eshialo nishili imbeliwo; nebutswa shiolatsiakhwoyo okhwinjila mushialo eshia eheelesia abaana baIsiraeli ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.52",
            "verseOrgIds": [
              "DEU.32.52"
            ]
          }
        }
