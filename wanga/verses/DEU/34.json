    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaMusa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa natikulukha okhurula mumuhololookhwe kwaMoabu, okhuula khushikulu shiaNebo, khubutenje bwaPisiga, ahahe-ngana nende Yeriko. OMWAMI namumanyia eshialo shiosi; mbu Gileadi, okhuula eDani; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Nafutali shiosi, neshialo shiaEfuraimu, naManase, neshialo shiosi shiaYuda, okhuula khunyanza yaMumbo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende Negebu, nomuhololookhwe kwelibanda liaYeriko, litookho liemisaala chiamashindu, okhuula eZoari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
              "DEU.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela ari Shino nishio eshialo eshia ndeetsubila Aburahamu naIsaka naYakobo, ndi Ndalaheelesia olwibulolwo. Eshikhulolosiye mumonitsio; ne shiolaambukha okhutsiayo ta ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa omusumba wOMWAMI yafwilayo mushialo shiaMoabu, shinga OMWAMI olwa yaboola; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.5",
            "verseOrgIds": [
              "DEU.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye namuyabilayo mwibanda eliomushialo shiaMoabu, ahahengana naBetsi-peori; ne abulaho oumanyile eshilindwashie kata okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.6",
            "verseOrgIds": [
              "DEU.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa yali owemiyika eshikhumi namakhumi kabili olwa yafwa; tsimonitsie shi-tsiali nitsimaliihe, kata shiyali niyanialakhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibamwikhuula Musa mumuhololookhwe kwaMoabu tsindaalo amakhumi kataru; mana tsindaalo tsiamasika etsiokhumwikhuula Musa nikeeya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
              "DEU.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yoswa waNuni yali niyeetsulamwo roho yobuchesi, okhuba Musa yali niyamurakhwo amakhonoabaana baIsiraeli nibamuhulila, nibakhola shinga OMWAMI olwa yamulaka Musa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.9",
            "verseOrgIds": [
              "DEU.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata omunabii oufwanana nende Musa shiyabuukhakhwo muIsiraeli khandi ta, owamanyana nOMWAMI, mumoni khumoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata oufwanana ninaye mubilolelo namangaliimwa ebia OMWAMI yamuruma okhukholela mushialo shiaMisiri, okhukholela Farao nabasumbabe bosi neshialoshie shiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata mumukhono kwobunyali nomumariisia amakhongo aka Musa ya-khola imbeli waIsiraeli yosi, ta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.12",
            "verseOrgIds": [
              "DEU.34.12"
            ]
          }
        }
      ]
    }
  ],
