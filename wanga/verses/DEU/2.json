    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Emiyika echia bamala mushitsiimi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khwashiukhana nikhubuusia oluchendo khunjila eyomushitsiimi eyitsia khuNyanza Inzakhanyu, shinga OMWAMI olwa yamboolela; nikhubotokhananga eshikulu shiaSeiri tsindaalo tsinyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI niyamboolela ari ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwabotokhaneenje eshikulu shino eshise eshihelile. Shiukhane mutsie enanotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olache abandu ori Mwitsa okhubira mumbali tsiabaana beenywe abaana baEsau, abamenyanga eSeiri; nabo balamuria; kho mwiyile kahala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murayinganakhwo ninabo ta; okhuba shindalamuheelesiakhwo khushialo shiabwe, kata eshihela lilaaro lieshilenje okhuseena tawe; shichila ndaheelesia Esau Seiri libe elilie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukulenje ebiliibwa biabwe amapeesa, kho mulie; khandi mukulenje amatsi kosi amapeesa, kho munywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba OMWAMI Nyasayewo yakhuheelesia ikhabi mumilimo chiamakhonoko. Ye yamanya okhuchendakhwo khwosi mushitsiimi shino eshikali; emiyika chino amakhumi kane OMWAMI Nyasayewo yalinji ninawe halala; shiwatamba eshindu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nikhubira bubira nikhurula ewabaana beefwe abaana baEsau abamenyanga eSeiri, okhurula khunjila yaAraba tsana, okhurula eElatsi, nokhurula eEzioni-geberi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhushiukhana, nikhubirila khunjila yeshitsiimi shiaMoabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyamboolela mbu Oranyasia Moabu, kata okhuseerana lihe ninabo ta; okhuba shindalakhuheelesiakhwo khushialoshie shibe eshieenywe ta; shichila ndaheelesia abaana baLoti Ari, libe eliabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khane abaEmi nibo abali nibamenyangayo; nabandu abali abakhongo, khandi abanji, khandi nabarambi, shinTa abaAnaki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.10",
            "verseOrgIds": [
              "DEU.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nabo babasibwa mbu nabaRefai, shinga abaAnaki; ne abaMoabu babalanganga mbu abaEmi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abaHori nabo bali nibamenyanga eSeiri khale; nebutswa abaana baEsau babukula eshialo shiabwe; nibabamulula imbeli wabwe, nibamenya mubwikhalo bwabwe; shinga Isiraeli olwa yakholela eshialo eshili eshishie, eshia OMWAMI yabaheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano rule, mwambushe omuchela kwaZeredi. Kho nikhwambukha omuchela kwaZeredi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo etsio, olwa khwarula eKadeshi-barinea okhuula olwa khwambukha omuchela kwaZeredi, tsiahela emiyika amakhumi kataru namunaane; okhuula olwa okvibulo lwabandu abo abakhabeele belihe olwa bali nibasishile nibahweele hakari weikambi, shinga OMWAMI olwa yabeetsubila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omukhono kwOMWAMI kwali khubo okhubamalilana bahweho hakari weikambi, okhuula olwa basikha pe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa abandu belihe bali nibasiEhile nibafwile bosi, nibahweele mubandu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI yamboolela ari ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyanga yino witsa okhubira khulwakho lwaMoabu, eAri; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa witsa okhuula ahambi ahahengana nabaana baAmoni, orabanyasia kata okhuseerana ninabo ta; okhuba shindalakhuheelesiakhwo khushialo shiabaana baAmoni shibe eshieenywe ta; shichila ndashibaheelesia abaana baLoti, shibe eshiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Nashio shiosi shibasibungwa mbu neshialo shiabaRefai; abaRefai bali nibamenyangamwo khale; ne abaAmoni babalanganga mbu abaZamuzumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.20",
            "verseOrgIds": [
              "DEU.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandu abal abakhongo khandi abanji, khandi nabarambi, shinga abaAnaki; nebutswa OMWAMI yabamulula imbeli wabwe; nibabukula eshialo shiabwe, nibamenya mubwikhalo bwabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga olwa yali niyakholela abaana baEsau, abamenyanga eSeiri, olwa yamulula abaHori barule imbeli wabwe; nibabukula eshialo shiabwe, nibamenya mubwikhalo bwabwe kata okhuula olwa leelo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.22",
            "verseOrgIds": [
              "DEU.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo abaAwi abali nibamenyanga mumataala okhuula eGaza, abaKafitori abarula muKafitori babamulula nibamenya mubwikhalo bwabwe.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rule, mubuusie oluchendo, mwambushe libanda liaArinoni; lole, ehaanile Sihoni omuAmori, omuruchi waHeshiboni, neshialoshie mumukhonokwo; chaache okhushibukula, nimuseerana ninaye lihe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leelo luno nenjaache okhuchila tsimbia tsiabandu abali hasi welikulu liosi bakhutechelele iwe nibakhuria, olwa balahulilanga akeifumayo, nibarenga, nibasaalila muno khululwo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalsiraeli bahula Sihoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ndaruma abarume okhurula mushitsiimi shieKademotsi, khuSihoni omuruchi waHeshiboni, nibali namakhuwa komulembe, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ofuchiilile embire mushialoshio; ndalabirila khumuhanda, nindeebera khumukhono musaatsa kata omukhasi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olangusinjia ebiliibwa amapeesa mbu endie, niungusia amatsi amapeesa mbu enywe; ofuchiilile butswa mbu embirilemwo nebilenje; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "shinga abaana baEsau abamenyanga muSeiri olwa bakholela, khandi nende abaMoabu abamenyanga muAri; okhuula olwa emba ninyambuushe Yorodani ninzinjila mushialo eshia OMWAMI Nyasaye weefwe akhuhee-lesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Sihoni omuruchi waHeshiboni shiyakhufuchiilila okhubirila khuye ta; okhuba OMWAMI Nyasayewo yatinyia rohoye niyoomia omwoyokwe, mbu amuhaane mumukhonokwo, shinga olwa kali leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI niyamboolela mbu Lola, ndakhachaaka okhuhaana Sihoni neshialoshie mumukhonokwo; ochaache okhushibukula, mbu olie eshialoshie. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sihoni narula okhukhuyinga, ye nabandube bosi, nibakhuseerela lihe eYahaza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI Nyasaye weefwe yamuhaana mumakhono keefwe; nikhumurootsa, nabaanabe, nabandube bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikhubukula amataalake kosi mundaalo etsio, nikhumululila elala buli litaala nabalimwo bosi, mbu abasaatsa, nabakhasi, nabaana abatiiti bosi; shikhwalekha omundu yesi wasikala ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula emiruko khwachibukula chibe ebioluyiitsi bieefwe, halala nebiyaayilwe mumataala aka khwali nikhubukuule. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula eAroeri, elili khundulo welibanda liaArinoni, nokhurula khwitaala elili mwibanda okhuula eGileadi, shilianyoolekha litaala liosi elieechinga mbu likhukhaye ta; OMWAMI Nyasaye weefwe yakahaana kosi mumukhono keefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khushialo shiabaana baAmoni, shiwasitakhwo ahambi ta; khulukuku lwosi Iwomwalo kwaYaboki, namataala akomushialo shiebikulu, kata hosi hosi ewa OMWAMI Nyasaye weefwe yakhukaania.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    }
