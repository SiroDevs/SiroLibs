    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OMWAMI alatnalilaila amahanga kaKanaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Isiraeli, hulila; leelo luno witsa okhwambukha Yorodani, mbu winjile obukule ebiamahanga akakhushila obukhongo namaani, amataala amakhongo aka tsingoba tsiako tsiulanga khwikulu bwene, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.1",
            "verseOrgIds": [
              "DEU.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "abandu abali abakhongo khandi abarambi abaana babaAnaki, aba wamanya, naba wahulila nikaboolwa khubo mbu Niwina ounyala okhusinjila imbeli wabaana baAnaki? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.2",
            "verseOrgIds": [
              "DEU.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omanye leelo mbu OMWAMI Nyasayewo niye ouranjilila okhwambukha imbeliwo shinga omulilo okusambanga; alabamalilana nabakwisia imbeliwo, kho olabeelusia nobasishia bwangu, shinga OMWAMI olwa yakhuboolela. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.3",
            "verseOrgIds": [
              "DEU.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa OMWAMI Nyasayewo alaba nabaluumile nabarusia imbeliwo, olunyumakhwo ora-paara mumwoyokwo ori Obulunjishi bwanje nibwo owachilile OMWAMI yanzinjisiye okhubukula eshialo shino, ta; habula obubii bwamahanga ako nibwo obwachilile OMWAMI nabeelusia imbeliwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.4",
            "verseOrgIds": [
              "DEU.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibuli obulunjishibwo, kata obukololofu bwomwoyokwo, obuchila niwinjila okhulia eshialo shiabwe ta; nebutswa obubii bwamahanga ako buchilanga OMWAMI Nyasayewo nabeelusia imbeliwo; khandi mbu atinyisie likhuwa elia OMWAMI yeetsubila abakuukabo, mbu Aburahamu naIsaka naYakobo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.5",
            "verseOrgIds": [
              "DEU.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "InduliyaIsiraeli nibali eHorebu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.5",
            "verseOrgIds": [
              "DEU.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omanye mbu OMWAMI Nyasayewo shiakhuheelesia eshialo shino eshilayi shibe eshishio khulwa obulunjishibwo tawe; okhuba oli oluyia lwabandu abelikosi litinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.6",
            "verseOrgIds": [
              "DEU.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yitsulila, noreebilila ta, shinga olwa wasinyisia OMWAMI Nyasayewo mushitsiimi; okhurula khunyanga eya warulilakhwo mushialo shiaMisiri, okhuula olwa mwoola hano, mukhayanga OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.7",
            "verseOrgIds": [
              "DEU.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi kata muHorebu mwasinyisia OMWAMI, OMWAMI namutiililwa oburima shia oumutibia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.8",
            "verseOrgIds": [
              "DEU.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi olwa ndaniina mushikulu okhuheebwa orubaho orwo rwamachina, nirwo orubaho rweindakano eya OMWAMI yalakana nineenywe, ndamenya mushilulu tsindaalo amakhumi kane, eshiteere nende eshilo; shindaliakhwo omukaate kata okhunywa amatsi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.9",
            "verseOrgIds": [
              "DEU.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyambeelesia orubaho rubili orwo rwamachina orwahandiichilwa olwala lwaNyasaye; ne khurwo rwalikhwo amakhuwa kosi aka OMWAMI yasungana nineenywe mushikulu, okhurula mumulilo hakari, khunyanga yelibukaana. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.10",
            "verseOrgIds": [
              "DEU.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo olwa tsiali nitsihweele amakhumi kane nende ebilo amakhumi kane, OMWAMI yambeelesia orubaho rubili orwo rwamachina, nirwo orubaho rweindakano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.11",
            "verseOrgIds": [
              "DEU.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyamboolela ari Buukha yikha bwangu okhurula hano; okhuba abandubo aba warusia muMisiri beeyoonooniye; bakotoole bwangu nibarula khunjila eya ndabalaka; beekholeele eshifwanani eshisalule.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.12",
            "verseOrgIds": [
              "DEU.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.12",
            "verseOrgIds": [
              "DEU.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI niyamboolela ari Ndaluutsi oluyia luno, ne lola, noluyia lwabandu belikosi litinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.13",
            "verseOrgIds": [
              "DEU.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndekha embe, embatibie, esiliisie eliira liabwe hasi welikulu; ne ndalakhukhola iwe obe lihanga elibashila amaani nobukhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.14",
            "verseOrgIds": [
              "DEU.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nishiukhana ninzikha okhurula mushikulu, eshikulu nashio nishiakha omulilo; ne ndali norubaho orwo rweindakano mumakhono kanje kombi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.15",
            "verseOrgIds": [
              "DEU.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihenga, ne lole, mwali nimwonooneele OMWAMI Nyasaye weenywe; mwali nimukholile eshimoosi eshisalule; mwali nimukotoole bwangu okhurula khunjila eya OMWAMI yali namulachile. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.16",
            "verseOrgIds": [
              "DEU.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjinga orubaho rubili orwo, nirusukuna namakhono kombi, nirwarila imbeli weenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.17",
            "verseOrgIds": [
              "DEU.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ndeekhupa hasi imbeli wOMWAMI, shinga olwa ndakhola olwambeli, tsindaalo amakhumi kane, eshiteere neshilo; shindaliakhwo omukaate kata okhunywa amatsi ta; khulwa eshionoono shieenywe eshia mwoonoona, nimukhola akali amabii imbeli wOMWAMI, nimumusinyisia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.18",
            "verseOrgIds": [
              "DEU.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba ndali niriile oburima nobusinyishi obululu obwa OMWAMI yamutiililwa, niyeenya okhumutibia. Nebutswa kata khunyanga eyo OMWAMI yambulila. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.19",
            "verseOrgIds": [
              "DEU.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI yamutiililwa Haruni oburima muno, niyeenya okhumumalilana; nasi nimusayila Haruni yesi khunyanga eyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.20",
            "verseOrgIds": [
              "DEU.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimbukula eshionoono shieenywe eshio, mbu eshimoosi eshia mwali nimukholile, nishisamba nomulilo, nishisasaka, nishisia ninyukha, nishiba eshinyushe shinga olufu; nisukuna olufu lwashio mumuchela okukholomokha okhurula mushikulu tsana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.21",
            "verseOrgIds": [
              "DEU.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.21",
            "verseOrgIds": [
              "DEU.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi eTabera, nende eMasa, nende eKibirotsi-hataawa, mwasinyisia OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
            "verseOrgIds": [
              "DEU.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa OMWAMI yamuruma okhurula eKadeshi-barinea, namuboolela mbu Tikulushe, mubukule eshialo eshia ndamuheelesia, inywe mwakhaya lilako liOMWAMI Nyasaye weenywe, nimuramusuubila kata okhuhulila omwoyokwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukhayanga OMWAMI, okhurula khunyanga olwa ndamumanya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nindikhupa hasi imbeli wOMWAMI tsindaalo tsana amakhumi kane, eshiteere neshilo; okhuba OMWAMI yali nasunjile mbu yakhamutibia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimusaaya OMWAMI, nisunga mbu E Omwami NYASAYE, oratibia abandubo, nibo obulaamebwo, aba wanunula mubukhongobwo, aba warusia muMisiri nomukhono kwamaani, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Witsulile abasumbabo Aburahamu nalsaka naYakobo; orahenga obukhayi bwabandu bano, kata obubii bwabwe, kata obwonooni bwabwe ta; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
