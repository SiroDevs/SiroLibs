{
  "id": "DEU.30",
  "number": "30",
  "bookId": "DEU",
  "reference": "Okhukalushila 30",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "DEU 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akabakhoyeele, mbu bakalusibwe habwene nibaheebwa ikhabi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kano kosi olwa kalaba nikakhwitsiile, akeikhabi nakeshilaka munwa aka ereele imbeliwo; khandi olwa olakeetsulila mumahanga kosi omwa OMWAMI Nyasayewo alaba nakhwilusiliye; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.1",
            "verseOrgIds": [
              "DEU.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nomukalushila OMWAMI Nyasayewo, nohulila amakhuwake mukosi aka ekhulaka inyanga yino, iwe nabaanabo, nomwoyokwo kwosi neshiimoshio shiosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "habwenaho OMWAMI Nyasayewo alakalukhasia obubohwibwo, nakhubeela eshisa, nakhukhung'aasia khandi okhurula mumbia tsiosi tsiabandu omwa OMWAMI Nyasayewo alaba nakhusalaasiliyemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.3",
            "verseOrgIds": [
              "DEU.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu abaarwabo bandi baba nibali khushihesi shielikulu, kata okhurula yaho OMWAMI Nyasayewo alakhukhung'aasia, khandi okhurula yaho alakhwenda; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.4",
            "verseOrgIds": [
              "DEU.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana OMWAMI Nyasayewo alakhwinjisia mushialo eshia abakuukabo balia, nawe olashilia; alakhukholela amalayi, nakhwinjiyia okhushila abakuukabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.5",
            "verseOrgIds": [
              "DEU.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasayewo alakhusheba omwoyo, nemioyo chiahaanabo, okhuheela OMWAMI Nyasayewo nomwoyokwo kwosi neshiimoshio shiosi, mbu obeetsenje mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.6",
            "verseOrgIds": [
              "DEU.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi OMWAMI Nyasayewo alara ebilaka munwa bino biosi khubasukubo nende khubakhukiyanga, abali nibakhusandinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.7",
            "verseOrgIds": [
              "DEU.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe olakalukha nohulila omwoyo KwOMWAMI, nokhola akamalakoke kosi aka ekhulaka leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.8",
            "verseOrgIds": [
              "DEU.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasayewo alakhumeetela amameeto mumilimo chiosi chiomukhonokwo, nomubiamo biomubilikwo, nemubiamo biemirukochio, nomubiamo bielilobalio, okaase; okhuba OMWAMI alakhwikhoyela khandi mukhukaasakhwo, shinga olwa yeekhoyela abakuukabo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "noba nolahulilanga omwoyo kwOMWAMI Nyasayewo, nolinda amalakoke naka alachilisia kosi akahandiikwa mushitabu shino shiamalako, khandi noba noshiukhanila OMWAMI Nyasayewo nomwoyokwo kwosi neshiimoshio shiosi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lilako lino elia ekhulzka leelo shilili litinyu elikhukhaya, kata shilili ehale ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
            "verseOrgIds": [
              "DEU.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shilili mwikulu, elichila noreeba mbu Niwina oulakhutikulushila atsie mwikulu akhuleerele, akhuhulilisie, mbu khulikhole? Ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shilili injelekha weinyanza, elichila noreeba mbu Niwina oulakhwambushila inyanza akhuleerele, akhuhulilisie, mbu khulikhole? Ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa likhuwa lili ahambi muno ninawe, mumunwakwo Ichandi mumwoyokwo, mbu olikhole.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lola, inyanga yino ereele imbeliwo obulamu nobulayi, khandi okhufwa nobubii. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba nolahulilanga amalako kOMWAMI Nyasayewo aka ekhulaka inyanga yino, nomuheela OMWAMI Nyasayewo, nokhuchenda khunjilatsie, nokhulinda amalakoke naka alachilisia nobukhalachibwe, kho olabeetsanga mwoyo niwinjiha, khandi OMWAMI Nyasayewo alakhuheelesia ikhabi mushialo eshia winjilamwo okhushibukula. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omwoyokwo nikuba nikushiukhana okhurulaho, nawe noloba okhuhulila, ne nokhweswa okhwinamila abanyasaye bandi nokhubakhalabanila; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho emurumbulila leelo luno mbu mulatiba butiba; tsindaalo tsieenywe shitsilameetekha mushialo eshia wambukha Yorodani niwinjilamwo okhushibukula ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.18",
            "verseOrgIds": [
              "DEU.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enanga likulu nende eshialo okhukhuyinga nobuloli inyanga yino, mbu ndareele imbeliwo obulamu nokhufwa, ikhabi neshilaka munwa; kho lobola obulamu, obe mwoyo, iwe nolwibulolwo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.19",
            "verseOrgIds": [
              "DEU.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "noheela OMWAMI Nyasayewo nohulila omwoyokwe, nomuhandakhwo; okhuba niko akali khwiwe obulamu nobuyindifu; mbu omenyenje mushialo eshia OMWAMI eetsubila abakuukabo, Aburahamu naIsaka naYakobo, okhubaheelesia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.20",
            "verseOrgIds": [
              "DEU.30.20"
            ]
          }
        }
      ]
    }
  ],
