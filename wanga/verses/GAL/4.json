{
  "id": "GAL.4",
  "number": "4",
  "bookId": "GAL",
  "reference": "Abagalatia 4",
  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "GAL 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GAL 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa emuboolela mbu owobulaame olwa aba nashili omwana, shiyahukhanakhwo nomusumba ta, kata nali omwene biosi; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.1",
            "verseOrgIds": [
              "GAL.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GAL 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne arukwa nende abamwola nabasinjilili okhuula khunduukho eya samwana yalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.2",
            "verseOrgIds": [
              "GAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu fwesi khurio, olwa khwali nikhushili abaana, khwali mubusumba khumakhuwa koburanjilili komushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.3",
            "verseOrgIds": [
              "GAL.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GAL 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa induukho yali niyusiibwe Nyasaye yaruma Omwanawe, niyeebulwa nomukhasi, niyeebulilwa mubusmuba bwamalako, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.4",
            "verseOrgIds": [
              "GAL.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abanunule abali mubusumba bwamalako, ifwe khunyoole okhukholwa abaana.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.5",
            "verseOrgIds": [
              "GAL.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GAL 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi olwa muli abaanabe, Nyasaye yaruma Roho wOmwanawe mumioyo chieefwe, nalanjisia ari Aba, Papa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.6",
            "verseOrgIds": [
              "GAL.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano shioshili omusumba ta, habula omwana; ne noba noli omwana, kho oli owobulaame khulwa Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburii obwa Paulo yali ninabwo khulwa abasuubili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GAL 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.7",
            "verseOrgIds": [
              "GAL.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GAL 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa mundaalo tsilia, nimuramumanyile Nyasaye ta, mwali abasumba babeenabo abaralikhwo abanyasaye mumela yabwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.8",
            "verseOrgIds": [
              "GAL.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GAL 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano, olwa mumalile okhumumanya Nyasaye, kata khusunje mbu okhumumanyishila Nyasaye, munyala murie okhushiukhana nimukalushila akeenako akoburanjilili, amaleemu akabula amaani, nimwikomba okhuba abasumba bako khandi? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.9",
            "verseOrgIds": [
              "GAL.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GAL 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulindanga aketsindaalo, nemiesi, netsinduukho, nemiyika. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.10",
            "verseOrgIds": [
              "GAL.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Endi noburii khulweenywe, mbu haundi ndakhaba ninyakhananga butswa.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GAL 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.11",
            "verseOrgIds": [
              "GAL.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GAL 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emusaaya, baana beefwe, mube shingana isie, okhuba siesi endi shingana inywe. Shimwayakholela obubii bwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumanyile mbu obuteshele bwomubili kwanje nibwo obwachila nimwilwatsila injiili olwambeli; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne kata akomubili kwanje, akakhamuteemile, shimwaleka kata okhusinyishila ta; ne mwanzinjisia shinga malaika waNyasaye, kata shinga Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, okhwiyitsiala khweenywe khuli heena? Shichila endi omuloli weenywe mbu nikaba nikakhanyaliishe, mwakhatsomoole tsimoni tsieenywe nimumbeelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khane bulaano engwile omusuku weenywe, shichila emuboolela akatoto?",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamukhaabanga neshinani, ne shikhuli munjila indayi ta; mbaa, beekomba okhumwikalila elwanyi, mbu mubakhaabe bo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo tsiosi nobulayi okhukhaabwa neshinani mwikhuwa lilayi, ne khubisie ebia endi nineenywe bionyene ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rwana rwanje, enumwa inzibula khandi khulweenywe, okhuula olwa Kristo alaba nalonjeeshe mwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.19",
            "verseOrgIds": [
              "GAL.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, ndakhanyala okhwikomba okhubaho nineenywe bulaano, engalukhasiekhwo omwoyo okwa emboola ninakwo; shichila erambilwe khulweenywe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AkaHagari naSara kakwa oluchelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.20",
            "verseOrgIds": [
              "GAL.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumboolele, inywe abeekomba okhuba abasumba bamalako, mbu shimuhulilanga amalako ta? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.21",
            "verseOrgIds": [
              "GAL.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kahandiikwa mbu Aburahamu yali nende abaana babili, mulala owomukhasi omukholiomukule, oundi owomukhasi omulekhuule. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.22",
            "verseOrgIds": [
              "GAL.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oweebulwa nomukule oyo, yeebulwa khulwa omubili; ne owomukhasi omulekhuule, yeebulwa khulwa obusuubisie. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.23",
            "verseOrgIds": [
              "GAL.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako kalimwo oluchelo; mbu abakhasi abo nibo tsindakano tsibili; ndala yirula mushikulu shiaSinai, niyiibula abaana mubusumba, ne niye Hagari. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.24",
            "verseOrgIds": [
              "GAL.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Hagari uno neshikulu shiaSinai, ebuArabu, ne neshifwanani shiaYerusalemu eliliho leelo; okhuba nomusumba, halala nabaanabe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.25",
            "verseOrgIds": [
              "GAL.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yerusalemu elo elili hekulu nelilekhuule; ne nilio nyineefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.26",
            "verseOrgIds": [
              "GAL.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila kahandiikwa kari",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
              "GAL.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, baana beefwe, ifwe khuli abaana bobusuubisie, shinga Isaka olwa yali. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
              "GAL.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shinga oyo oweebulwa khulwa omubili olwa yamusandia oyo oweebulwa khulwa Roho mundaalo tsilia, nindio kali kata bulaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GAL 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
