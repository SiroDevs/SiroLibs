{
  "id": "JHN.2",
  "number": "2",
  "bookId": "JHN",
  "reference": "Yohana 2",
  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "JHN 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eshiselelo eKana",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khunyanga yakhataru shialiho eshiselelo eKana muGalilaya; ne nyina Yesu yali naliho; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.1",
            "verseOrgIds": [
              "JHN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye Yesu yalangwa, nende abeechibe, mushiselelo tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.2",
            "verseOrgIds": [
              "JHN.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa idivai yabahweela, nyina Yesu namusunjila mbu Shibalikhwo nende idivai ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.3",
            "verseOrgIds": [
              "JHN.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namusunjila ari Mama, obeele orie ninasi? Eshise shianje shishili okhuula. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.4",
            "verseOrgIds": [
              "JHN.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina nasunjila abakhalabani ari Elia amuboolela liosi, mulikhole. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.5",
            "verseOrgIds": [
              "JHN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsialiho tsinzikha tsisasaba etsiabaatswa tsiamachina, nitsirenjekhwaho khulwa eshiima shiabaYahudi eshiokhwiyosia, buli ndala niyihela tsisiongo tsibili tsitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.6",
            "verseOrgIds": [
              "JHN.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nababoolela ari Mwitsusie amatsi mutsinzikha. Nibatsiitsusia okhuula khululika. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.7",
            "verseOrgIds": [
              "JHN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababoolela ari Tahekhwo bulaano, mumuyilile omwinjisii wabandu. Nibayila bario. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.8",
            "verseOrgIds": [
              "JHN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omwinjisii wabandu yatsanzama khumatsi aka bulaano keekholile idivai, naramanya ewa karula ta, habula abakhalabani abali nibakatayile amatsi ako bamanya, omwinjisii wabandu nalanga omwene shiselelo, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.9",
            "verseOrgIds": [
              "JHN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namusunjila ari Abandu bosi baranjililanga nibarenjekha idivai indayi; mana olwa abandu baba nibanyweele muno, baleeranga eyirali indayi muno ta; ne iwe obiishile idivai indayi okhuula bulaano. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.10",
            "verseOrgIds": [
              "JHN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obuchaachilo buno bwebilolelobie Yesu yabukhola eKana muGalilaya, nalolosia oluyalilwe; abeechibe nibamusuubilila.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.11",
            "verseOrgIds": [
              "JHN.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyumakhwo yakholomokha natsia eKaperinaumu, ye omwene, nende nyina, nende abaana babwe, nende abeechibe; nibamenyayo tsindaalokhwo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yeenjila muhehalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.12",
            "verseOrgIds": [
              "JHN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Pasaka yabaYahudi yali ahambi okhuula, naye Yesu natikulukha natsia eYersualemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.13",
            "verseOrgIds": [
              "JHN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne muhekalu yanyoola abakusii betsing'ombe namakondi namahuusi nende abakalukhasii bamapeesa, nibeekhaale; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.14",
            "verseOrgIds": [
              "JHN.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana nakhola omusharata kwetsinzaha, nabarusia bosi muhekalu, halala nende amakondi netsing'ombe, nasundula amapeesa kabakalukhasii, nafumamia tsimeesa tsiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.15",
            "verseOrgIds": [
              "JHN.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboolela abakusii bamahuusi ari Yinie ebindu bino; murakhola inzu yaPapa yibe inzu yeinganga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.16",
            "verseOrgIds": [
              "JHN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibeetsulila shinga olwa kahandiikwa, mbu Obulumilifu bweinzuyo bulandia bulia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaYahudi bakalusia, nibamureeba bari Neshilolelo shiina eshia okhulolosia, olwa okholanga amakhuwa kano? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.18",
            "verseOrgIds": [
              "JHN.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia nasunga mbu Sambulule ihekalu yino, mana mundaalo tsitaru ndalachisinjisia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
            "verseOrgIds": [
              "JHN.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaYahudi nibasunga bari Ihekalu yino yamala emiyika amakhumi kane nachisasaba niyumbakhungwa, nawe nochisinjisie mundaalo tsitaru? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
              "JHN.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yali naboolile khukeihekalu yomubilikwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana olwa yali nalamuushe okhurula mukhufwa, abeechibe nibeetsulila shinga olwa yaboola amakhuwa ako; nibasuubila amahandiiko, nende likhuwa liene elia Yesu yali naboolile.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yamanya abandu bosi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
            "verseOrgIds": [
              "JHN.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali eYerusalemu khuPasaka, mundaalo tsielisabo, abanji basuubilila eliiralie, nibaluutsi ebilolelo ebia yakhola. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
              "JHN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu omwene shiyabasuubilila bo ta, shichila yamanya abandu bosi, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.24",
            "verseOrgIds": [
              "JHN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shiyatamba mbu oundi amurumbulile akobuloli khukabandu ta; okhuba omwene yamanya akali mubandu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.25",
            "verseOrgIds": [
              "JHN.2.25"
            ]
          }
        }
      ]
    }
  ],
