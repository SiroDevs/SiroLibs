  "bookId": "JHN",
  "reference": "Yohana 5",
  "verseCount": 47,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JHN 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omundu yahonilibwa heetiba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwamakhuwa ako lisabolindi liabaYahudi lialiho; Yesu natikulukha natsia eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.1",
            "verseOrgIds": [
              "JHN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebweneyo eYerusalemu, ahambi neshilibwa shiamakondi, liliho litiba elilangwa muluHeburania mbu Betsezatsa, eliali nende eshitsafu shiebirookoola biraano. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.2",
            "verseOrgIds": [
              "JHN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubwenomwo omukanda kwabandu kwakonangamwo, abalwale, ababofu, abalema, nabamakara, [nibalindiililanga okhwirunda khwamatsi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.3",
            "verseOrgIds": [
              "JHN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila malaika wOmwami yali niyeekhanga mwitiba khunduukho tsindi, natubuula amatsi; mana ouba naranjilila okhwinjilamwo inyuma wokhutubuukha khwamatsi, yahonanga obulwale bwosi obwali nibumutiilile.] ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.4",
            "verseOrgIds": [
              "JHN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yaliho omundu undi owalinji nobuteshele emiyika amakhumi kataru namunaane. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.5",
            "verseOrgIds": [
              "JHN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Yesu yamulola nakonile, namanya shinga olwa yalinjiho ario oluhoono, yamureeba ari Wenya okhukholwa omulamba? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.6",
            "verseOrgIds": [
              "JHN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulwale namukalusia mbu Omwami, shindikhwo nende omundu ounzinjisia mwitiba olwa amatsi kaba nikakhatubuukha ta; ne olwa emba ninziitsanga oundi yaranjililanga okhwikhamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.7",
            "verseOrgIds": [
              "JHN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namusunjila ari Buukha wituushe licheelalio, ochende. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.8",
            "verseOrgIds": [
              "JHN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho omusaatsa oyo nahonibwa, niyeetuukha licheelalie, nachenda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga eyo yali eyaSabato. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.9",
            "verseOrgIds": [
              "JHN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaYahudi nibamusunjila oyo owali nahoniibwe bari Yino niSabato, ne nomusilo iwe okhwituukha licheelalio. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.10",
            "verseOrgIds": [
              "JHN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nabakalusia ari Omwenoyo oumboniye, neniye oumbooleele mbu Wituushe licheelalio, ochende. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.11",
            "verseOrgIds": [
              "JHN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamureeba bari Omusaatsa tsana oukhubooleele mbu Wituushe, ochende, niwina? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.12",
            "verseOrgIds": [
              "JHN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa owahonibwa oyo shiyamumanya mbu niwina ta; okhuba Yesu yali narulileyo, khulwa omukanda omukhongo okwali habwenaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.13",
            "verseOrgIds": [
              "JHN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyumakhwo Yesu yamunyoola nali muhekalu, namusunjila ari Lola, omalile okhuhonibwa; oroonoona khandi ta, likhuwa libii okhushila liakhakhukwila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.14",
            "verseOrgIds": [
              "JHN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaatsa oyo natsia, naboolela abaYahudi mbu niye Yesu oumuhoniye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.15",
            "verseOrgIds": [
              "JHN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilio eliachila abaYahudi nibachaaka okhumusandia Yesu, shichila yakholanga amakhuwa ako khuSabato. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.16",
            "verseOrgIds": [
              "JHN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yesu nabakalusia ari Papa akholanga emilimo kata okhuula bulaano, nasi siesi ekholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.17",
            "verseOrgIds": [
              "JHN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abaYahudi nibakhaaba okhushila okhumwira; shikhuli okhuba yoonoonia Sabato butswa ta, habula shichila yalanga Nyasaye mbu niSamwana, niyeehelania ario nende Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obunyali bwaYesu, Omwana waNyasaye",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.18",
            "verseOrgIds": [
              "JHN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yesu nakalusia, nabasunjila ari Toto mwene, emusunjila mbu Omwana shianyala okhukhola likhuwa liosi khululwe ta, habula akeenako aka alola Samwana nakhola; okhuba amakhuwa kosi aka Samwana akhola, niko aka Omwana yesi akholanga ario. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.19",
            "verseOrgIds": [
              "JHN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Samwana aheelanga Omwana, namumanyia kosi aka omwene akholanga; ne alamumanyia emilimo echishila chino, mbu mana muchenye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.20",
            "verseOrgIds": [
              "JHN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga Samwana olwa abuusinjia abafu nabalamusia, nindio Omwana yesi alamusinjia aba achama okhulamusia. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.21",
            "verseOrgIds": [
              "JHN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba kata Samwana shiayaasinjia omundu yesi eshiina ta, ne amuheele Omwana jobuyaasii bwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.22",
            "verseOrgIds": [
              "JHN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana bosi baheelesie Omwana oluyali, shinga olwa bamuheelesinjia Samwana oluyali. Ouraheelesinjia Omwana oluyali ta, shiamuheelesinjia Samwana owamuruma oluyali tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.23",
            "verseOrgIds": [
              "JHN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, emusunjila mbu ouhulila likhuwa lianje, nasuubilila omwenoyo owaruma, ali nobulamu bwobumeli, ne shiyeenjila mubuyaasibwi ta, nebutswa amalile okhubira okhurula mukhufwa okhwinjila mubulamu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.24",
            "verseOrgIds": [
              "JHN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto mwene, emusunjila mbu eshise shiitsa, kata bulaano shiulile, olwa abafu balahulila omwoyo kwOmwana waNyasaye; nabo abakuhulila balaba nobulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.25",
            "verseOrgIds": [
              "JHN.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shinga Samwana olwa ali nobulamu mumwene, nindio yamunyalila Omwana naye okhuba nobulamu mumwene; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.26",
            "verseOrgIds": [
              "JHN.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi yamuheelesia obunyali okhukhalaka ebiina, shichila niye Omwana wOmundu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.27",
            "verseOrgIds": [
              "JHN.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murachenyela kano ta; okhuba eshise shiitsanga olwa bosi abali mubilindwa balahulila omwoyokwe, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibarulamwo; abo abakholanga obulayi balarulila obulamushi bwobulamu; nabo abakholanga obubii balarulila obulamushi bwobukhalakwi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abarumbula akobuloli khukaYesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie khubwanje shinyala okhukhola likhuwa liosi ta; shinga olwa embulilanga nilwo olwa ekhalakanga endio; obukhalachi bwanje nabwo nobulunji; shichila shikhaabanga akokhwenya khwanje omwene ta, habula akokhwenya khwa oyo owaruma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.30",
            "verseOrgIds": [
              "JHN.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba nindirumbulila omwene akobuloli, oburumbusi bwanje shibuli obwatoto ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oundi niye ourumbulila akobuloli; nasi emanyile mbu oburumbusi obwa arumbula khwisie nobwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.32",
            "verseOrgIds": [
              "JHN.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwarumile abandu ewaYohana, naye warumbuule akobuloli khubwatoto. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne oburumbusi obwa efuchiilila isie shiburula khubandu ta; nebutswa emboola amakhuwa kano mbu muhonibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yali itaha eyo eyakhanga niyilangaala; neenyu mwafuchiilila okhwikhoyela obulafubwe tsindaalokhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.35",
            "verseOrgIds": [
              "JHN.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa oburumbusi obwa endi ninabwo bushila obwaYohana; okhuba emilimo echia Papa yambeele mbu emalilisie, emilimo chiene echia ekholanga, echienechio chirumbulilanga, mbu Pape yaruma. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Papa owaruma, ye yarumbuule akobuloli khwisie. Inywe shimwahulilakhwo omwoyokwe tsindaalo tsiosi, kata okhulola likondolie ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata likhuwalie shimuli ninalio nilimenya mwinywe, okhuba shimumusuubililanga omwenoyo owa yaruma tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murunilisinjia mumahandiiko, shichila mukaalanga mbu muli nobulamu bwobumeli muko; mbula, niko akarumbulilanga akobuloli; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa mulobanga okhunzitsila mbu mube nobulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.40",
            "verseOrgIds": [
              "JHN.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie shifuchiililanga oluyali olurula khubandu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne emumanyile, shinga olwa mubula nobuheeli bwaNyasaye mwinywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeetsa muliira liaPapa, neenyu nimuranzinjisia ta; oundi naba niyeetsa muliira lilie omwene, omwenoyo mwakhamufuchiilila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyala murie okhusuubila, inywe abafuchiilila oluyali olurula khubashieenywe, ne nimurakhaaba oluyali olurula khuNyasaye ouli mulala yenyene ta? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.44",
            "verseOrgIds": [
              "JHN.5.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murakaala mbu ndalamwinjilila itookho ewaPapa ta; aliho oumwinjilila, niye Musa, owa mwachoomiakhwo obunaayi bweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nimuba nimwakhasuubiile Musa, mwakhasuubiile isie; shichila yahandiika khukanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nimuba nimurasuubila amahandiiko keke ta, mulasuubila murie amakhuwa kanje?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.47",
            "verseOrgIds": [
              "JHN.5.47"
            ]
          }
        }
      ]
    }
  ],
