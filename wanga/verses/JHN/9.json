{
  "id": "JHN.9",
  "number": "9",
  "bookId": "JHN",
  "reference": "Yohana 9",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JHN 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu yahonia otnundu oweebulwa nali omubofu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nabiranga, yalola omundu owalinji omubofu okhurula niyeebulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.1",
            "verseOrgIds": [
              "JHN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeechibe nibamureeba bari Rabi, owoonoona niwina, omundu uno noho abeebulibe, mbu yeebulwa ario omubofu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.2",
            "verseOrgIds": [
              "JHN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu nakalusia mbu Omundu uno shiyayoonoona, kata abeebulibe tawe; ne mbu emilimo chiaNyasaye chilolosilibwe muye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.3",
            "verseOrgIds": [
              "JHN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhoyile okhukhola emilimo chia oyo owaruma olwa shishili eshiteere; eshilo shiitsanga olwa omundu yesi aranyala okhukhola omulimo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.4",
            "verseOrgIds": [
              "JHN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa endi mushialo, isie nisie obulafu bweshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.5",
            "verseOrgIds": [
              "JHN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali naboolile ario, yafutsa hasi, nakhola amare ako litoyi, namubakha litoyi elo khumoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.6",
            "verseOrgIds": [
              "JHN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "namubiila mbu Tsia wiyosie mwitiba liaSiloamu; obukalulwi bwalio, mbu Okhurumwa. Kho yatsia ario, niyeeyosia, nakalukha nalolanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.7",
            "verseOrgIds": [
              "JHN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abashie, nende abo abamulola khale, mbu nomumanani ousabanga ebindu, basunga bari Uno shiali ye oweekhalanga nasaba ebindu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.8",
            "verseOrgIds": [
              "JHN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bari Niye; nabandi bari, Tawe, habula afwanana butswa shinga ye. Omwene nasunga mbu Isie nisie. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.9",
            "verseOrgIds": [
              "JHN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba bari Kho tsimonitsio tsikhatimbuushe tsirie? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.10",
            "verseOrgIds": [
              "JHN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Omundu oyo oulangwa mbu Yesu akholile litoyi, niyambakha tsimoni, niyambiila ari Otsie eSiloamu, wiyosie; mana ninzia, nindiyosia, ninyalilwa okhulola. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.11",
            "verseOrgIds": [
              "JHN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamureeba bari Ali heena? Naye ari, Shimanyile ta.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaFarisayo bareebelesia akokhuhonia okhwo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.12",
            "verseOrgIds": [
              "JHN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyila oyo owalinji omubofu imbeli wabaFarisayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.13",
            "verseOrgIds": [
              "JHN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga eyo yali eyaSabato, olwa Yesu yakhola litoyi namutimbusia tsimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.14",
            "verseOrgIds": [
              "JHN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abaFarisayo bosi nibamureeba khandi shinga olwa anyaliilwe okhulola. Naye nabasunjila ari Yara litoyi khumoni tsianje, nasi nindiyosia, ne bulaano endolanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.15",
            "verseOrgIds": [
              "JHN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abandi abokhubaFarisayo abo nibaboola mbu Omundu uno shiyarula ewaNyasaye, shichila shialindanga Sabato tawe. Ne abandi baboola mbu Omundu omwonooni anyala arie okhukhola ebilolelo ebifwana biri nanwa? Mana obwahukhani nibwikhola mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.16",
            "verseOrgIds": [
              "JHN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba omubofu khandi, bari Nawe oboola orie khuye, olwa akhutimbusiye tsimoni? Naye nasunga Nomunabii. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.17",
            "verseOrgIds": [
              "JHN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaYahudi abo shibasuubila amakhuwake, mbu yalinji omubofu, kata mbu yanyalilwa okhulola, tawe; okhuula olwa balanga abeebuli ba oyo owanyalilwa okhulola, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.18",
            "verseOrgIds": [
              "JHN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibabareeba bari Uno niye omwana weenywe, owa muboolanga mbu yeebulwa nali omubofu? Kho bulaano anyaliilwe arie okhulola? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.19",
            "verseOrgIds": [
              "JHN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeebulibe nibakalusia, nibasunga mbu Khumanyile mbu uno nomwana weefwe, khandi mbu yeebulwa nali omubofu; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.20",
            "verseOrgIds": [
              "JHN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne shinga olwa alolanga bulaano, shikhumanyilekhwo ta; kata oumutimbusiye tsimoni, shikhumanyilekhwo ta; mumureebe; nomundu oukhulile; omwene aboole khululwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.21",
            "verseOrgIds": [
              "JHN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abeebulibe baboola amakhuwa ako shichila bali nibariile abaYahudi; shichila abaYahudi bali nibamalile okhufuchilisania mbu omundu yesi naba niyeeyama shinga olwa ali Kristo, arusibwe musinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.22",
            "verseOrgIds": [
              "JHN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abeebulibe nibasunga mbu Nomundu oukhulile; mumureebe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.23",
            "verseOrgIds": [
              "JHN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamulanga olwakhabili, omundu oyo owalinji omubofu, nibamusunjila bari Heelesia Nyasaye oluyali; khumanyile mbu omundu oyo nomwonooni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.24",
            "verseOrgIds": [
              "JHN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Naba nali omwonooni, isie shimanyile ta; emanyile likhuwa elala, mbu ndalinji omubofu, ne bulaano endolanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.25",
            "verseOrgIds": [
              "JHN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba bari Akhukholeele shiina? Atimbusiye tsimonitsio arie? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.26",
            "verseOrgIds": [
              "JHN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabakalusia mbu Ndakhamuboolela bulaano, nimurahulila ta; mbushiina nimwenya okhukahulila khandi? Mwesi mwenya okhwikhola abeechibe noho? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.27",
            "verseOrgIds": [
              "JHN.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibamunyeka, nibasunga bari Iwe niwe omwechiwe; ifwe khuli abeechi baMusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.28",
            "verseOrgIds": [
              "JHN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumanyile mbu Nyasaye yasungana nende Musa; ne omundu oyo, shikhumanyile ewa yarula ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.29",
            "verseOrgIds": [
              "JHN.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaatsa oyo nakalusia, nabasunjila mbu Mbula, ako nakamakana; mbu shimumanyilekhwo ewa yarula ta, ne khane yandimbusiye tsimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.30",
            "verseOrgIds": [
              "JHN.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khumanyile mbu Nyasaye shiahulilanga aboonooni ta; ne omundu naba namwinamilanga Nyasaye, nende okhukhola aka yeenya, amuhulilanga oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.31",
            "verseOrgIds": [
              "JHN.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula khumusuule shikahuliilikha mbu omundu yesi yatimbusia tsimoni tsiomundu oweebulwa nali omubofu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.32",
            "verseOrgIds": [
              "JHN.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu uno naba nararula ewaNyasaye ta, khane shiyakhanyalile okhukhola likhuwa liosi tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.33",
            "verseOrgIds": [
              "JHN.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibakalusia, nibamusunjila bari Atse, iwe weebulilwa mubionoono butswa; khane okhwechesia ifwe? Nibamusukuna elwanyi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obubofu obwomumwoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu yahulila shinga olwa bali nibamusukuune elwanyi; mana namunyoola, nareeba mbu Osuubililanga Omwana waNyasaye? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.35",
            "verseOrgIds": [
              "JHN.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia, nasunga mbu Ne niye wina, Omwami, mbu emusuubilile? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu namuboolela mbu Omuluutsi, khandi niye ousungananga ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.37",
            "verseOrgIds": [
              "JHN.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga ari Omwami, esuubiile. Namwinamila. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.38",
            "verseOrgIds": [
              "JHN.9.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu naboola mbu Obuyaasii nibwo obwachila ninzitsa mushialo shino, mbu abaralolanga ta balole, khandi mbu abalolanga babofuhale. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.39",
            "verseOrgIds": [
              "JHN.9.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbokhubaFarisayo abaliho ninaye bahulila amakhuwa ako, nibamureeba bari Nineefwe khuli ababofu noho? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.40",
            "verseOrgIds": [
              "JHN.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yesu nabasunjila mbu Nimuba nimwakhabeele ababofu, khane shimwakhwabeele nende obwonooni ta; nebutswa bulaano olwa muboolanga muri Khulola, obwonooni bweenywe bumenyaho.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.41",
            "verseOrgIds": [
              "JHN.9.41"
            ]
          }
        }
      ]
    }
  ],
