    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Danieli yasaayila abandube",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwambeli kwaDario waAhasuwero, owolwibulo lwabaMedi, oweemekhwa abe omuruchi woburuchi bwabaKalidayo, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.1",
            "verseOrgIds": [
              "DAN.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mumuyika kwambeli kwoburuchibwe, isie Danieli ndeeka mubitabu obunji bwemiyika echiaboolwa mwikhuwa liOMWAMI elieetsela Yeremia omuna bii khulwa okhuusibwa khwobwonooneshi bwa Yerusalemu, mbu emiyika amakhumi musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.2",
            "verseOrgIds": [
              "DAN.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninjoomia tsimoni tsianje khuMwami Nyasaye, nimureebakhwo, munjila yokhusaba nokhusaaya, halala nokhuhonga inzala nokhwifwala tsingubo tsiamakunia nelikoshe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.3",
            "verseOrgIds": [
              "DAN.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimusaaya OMWAMI Nyasaye wanje, nimwiyamila, nisunga mbu E Omwami, iwe Nyasaye omukhongo owamariisia, owusinjia indakanoyo nobuheeli oburalilu khubeenabo abakhuheelanga nibahulila amalakoko; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.4",
            "verseOrgIds": [
              "DAN.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "khwayoonoonile, nikhukhola akobukhayikhanu, nikhukhola obubii, nikhukhola induli, nikhushiama okhurula khumeebaaloko nokhubukhalachibwo; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.5",
            "verseOrgIds": [
              "DAN.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shikhwahulilanga abasumbabo abanabii, ababoolelanga abaruchi beefwe nabakhulundu beefwe nabakuuka nabandu bosi beshialo, amakhuwa muliiralio, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.6",
            "verseOrgIds": [
              "DAN.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Omwami, obulunjishi nobubwo; ne okhuli khwifwe, nokhufwimbwa omurwe, shinga olwa khuli leelo; khuli khubaYuda, nokhubamenyanga muYerusalemu, nokhubaIsiraeli bosi, abali ahambi nabali ehale, mubialo biosi ewa wabeelusilia, khulwa obukhayi bwabwe obwa bakhukhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.7",
            "verseOrgIds": [
              "DAN.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Omwami, okhuli khwifwe nokhufwimbwa omurwe; nokhubaruchi beefwe, nokhubakhulundu beefwe, nokhubakuuka beefwe, shinga olwa khwakhwonoonela. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.8",
            "verseOrgIds": [
              "DAN.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami Nyasaye weefwe nomwene tsimbabasi nobulesheli; okhuba khwamukholela induli; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.9",
            "verseOrgIds": [
              "DAN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shikhwahulila amakhuwa kOMWAMI Nyasaye weefwe, okhuchenda mumalakoke aka yara imbeli weefwe mubasumbabe abanabii ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.10",
            "verseOrgIds": [
              "DAN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toto, abaIsiraeli bosi bakhaya amalakoko, nibashiama, mbu baleshe okhuhulila amakhuwako; ne niko akachila eshiIaka munwa nishikhusundulwakhwo, nende eshiitsubo eshiahandiikwa mumalako kaMusa omusumba waNyasaye; okhuba khwamwonoonela. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.11",
            "verseOrgIds": [
              "DAN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yakhutinyisiliye amakhuwake aka yasunga nakhufukula, nafukula nende abayaasii beefwe abakhuyaasia, nakhuupia khushibii eshikhongo; okhuba hasi welikulu liosi shiliakholwakhwo likhuwa shinga elo eliakholelwa Yerusalemu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.12",
            "verseOrgIds": [
              "DAN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shinga olwa kahandiikwa mumalako kaMusa, amabii kano kosi kakhukwiliile; nebutswa shikhusaayile OMWAMI Nyasaye weefwe mbu akhukoosie obukoosia, khushiukhane nikhulekha obumayaanu bweefwe nikhurechelesia obwatotobwo, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.13",
            "verseOrgIds": [
              "DAN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila ahenjilenje, ne bulaano ukhukhupiye khushibii; okhuba OMWAMI Nyasaye weefwe nomulunjishi, mubikholebie biosi ebia akholanga, ne ifwe shikhwahuliile amakhuwake ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.14",
            "verseOrgIds": [
              "DAN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, Omwami Nyasaye weefwe, owarusia abandubo mushialo shiaMisiri nomukhono kwamaani, niwinyoolela ifuma shinga olwa yili leelo; khwayoonoonile, nikhukhola obubii. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.15",
            "verseOrgIds": [
              "DAN.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Omwami, khulwa ebikholebio biobuIunjishi ekhusaaya mbu oburimabwo nobululubwo bushiukhane burule khwitookholio Yerusalemu, eshikulushio eshitakatifu; shichila khulwa ebionoono bieefwe, nobumayaanu bwabakuuka beefwe, Yerusalemu nende abandubo bakwile linyeko khubosi abakhufumbila. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.16",
            "verseOrgIds": [
              "DAN.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, e Nyasaye weefwe, hulila okhusaba khwanje, isie omusumbawo, nokhusaaya khwanje; khululwo omwene, Omwami, khosilia habunduwo ahatakatifu obulafu bwomumonimwo, olwa hali butswa likunda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.17",
            "verseOrgIds": [
              "DAN.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Nyasaye wanje, reka amarwi ohuliletimbula tsimoni olole obusasishi bweefwe, nelitookho elikulikhwa khuliiralio; okhuba shikhuleera amasaayo keefwe imbeliwo khulwa obulunjishi bweefwe ta, habula khulwa tsimbabasitsio tsinyinji. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.18",
            "verseOrgIds": [
              "DAN.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "E Omwami, okhuhulile; eOmwami, okhuleshele; eOmwami, oreche amarwi, nokhola; orashinda ta; khululwo omwene, e Nyasaye wanje, shichila litookholio nende abandu bakulikhwa khuliiralio.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburumbusi bwobunabii khukamahonga amakhumi musaafu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.19",
            "verseOrgIds": [
              "DAN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa ndali nishisunga, nisaaya, nindiyama obwonooni bwanje nobwonooni bwabandu banje abaIsiraeli, nileeranga amasaayo kanje imbeli wOMWAMI Nyasaye wanje khulwa eshikulu eshitakatifu shiaNyasaye wanje; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.20",
            "verseOrgIds": [
              "DAN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa ndali nishiboolanga nisaaya, omundu oyo Gaburieli, owa ndali ninduutsi mwibisulo khukhuchaaka khwene, yapulukha bwangu niyanzitsila khushise shiomusango kwomungoloobe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.21",
            "verseOrgIds": [
              "DAN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyanzibaalila, nasungana ninasi, ari Iwe Danieli, bulaano erulile ninzitsa okhukhukhola omuchesi mubumanyilisii. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.22",
            "verseOrgIds": [
              "DAN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khukhuchaaka khwokhusaayakhwo likhuwa lilachilwe, nasi enzitsile okhukhuupila omunwa; okhuba oheelwa muno; kho oyililisie khwikhuwa lino, nomanya eshisina shielibigulo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.23",
            "verseOrgIds": [
              "DAN.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahonga amakhumi musaafu kalachilisibwa khubandubo nokhwitookholio litakatifu, okhumalilisia obukhayi, nokhwakamia ebionoono, nokhutisa obumayaanu, nokhuleera obulunjishi oburahwaho ta, nokhuboha amabisulo nende omunabii, nokhutsushiilila habundu ahashila obutakatifu amafura. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.24",
            "verseOrgIds": [
              "DAN.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omanye, notiila khushisina, mbu okhurula olwa lilako liarumbulwa okhukalusia Yerusalemu habwene nokhuliumbakha, okhuula khukhwitsa khwamasihi undi, omukhulundu, shilaba eshise shiamahonga musaafu. Mana mumahonga amakhumi kasasaba nakabiri liliumbakhwa khandi, netsinjila tsialio nolwashi, mundaalo tsiamatinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.25",
            "verseOrgIds": [
              "DAN.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyuma lwamahonga ako amakhumi kasasaba nakabiri, Masihi tsana alakhalakwa, narabakhwo neshindu ta; abo abandu bomukhulundu tsana ouli okhwitsa baloonoonia litookho nende habundu ahatakatifu; ne obumaliilishi buleetsa nomuyembo; ne okhuula khubumaliilishi obusolo bulabaho; obusasishi bulachilisibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.9.26",
            "verseOrgIds": [
              "DAN.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
