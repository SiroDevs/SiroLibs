              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshisina shiamakhuwa shieshino; MENE, mbu Nyasaye wabasia tsindaalo tsioburuchibwo, nabwakamia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
