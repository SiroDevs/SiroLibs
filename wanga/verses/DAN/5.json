    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akamahandiiko khwisiisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi Beleshazari yakasilia abaamibe eshikhumila lisabo, nanywa idivai imbeli wa abo eshikhumila.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.1",
            "verseOrgIds": [
              "DAN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yali nashitsanzama idivai, Beleshazari yalaka mbu ebimanulwa bieitsahaabu neifeetsa ebia Nebukadineza samwana yali niyarusia muhekalu eyili eYerusalemu, bileerwe; mbu omuruchi nabaamibe, nabakhasibe nabasuria, banyweele mubio. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.2",
            "verseOrgIds": [
              "DAN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibaleera ebimanulwa tsana bieitsahaabu ebiarusibwa muhekalu munzu yaNyasaye eyili eYerusalemu; naye omuruchi halala nabaamibe nabakhasibe nabasuria, nibanyweela mubio. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.3",
            "verseOrgIds": [
              "DAN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banywa idivai nibapaaka abanyasaye beitsahaabu nabeifeetsa, nabomukasa, nabeshibia, nabemisaala, nabamachina.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.4",
            "verseOrgIds": [
              "DAN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwenaho tsinzala tsiomukhono kwomundu nitsilolekha, nitsihandiika khwisiisi lieinzu yomuruchi, ahahengana neshichibi shieitaha; omuruchi nalola eshitonye shiomukhono eshio eshiahandiika. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.5",
            "verseOrgIds": [
              "DAN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumoni mwomuruchi nimukalukhana, amapaaroke nikamuriisia; obuunjila bwamakhukunyu niburabukha, amasikamoke nikeekhong'asia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.6",
            "verseOrgIds": [
              "DAN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nalanjisia, nalaka mbu abobulookooli baleerwe, nabaKalidayo, nabakhwenyi. Omuruchi naboolela abachesi baBabeli ari Omundu yesi oulasooma lihandiiko lino niyambuulila eshisina shialio, alafwalwa tsingubo tsieisambarau, nareebwakhwo omunyolo kweitsahaabu mwikosi, naba owakhataru muburuchi bweshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.7",
            "verseOrgIds": [
              "DAN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abachesi bosi bomuruchi nibeenjila; ne bakhaywa okhusooma lihandiiko kata okhubuulila omuruchi eshisina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.8",
            "verseOrgIds": [
              "DAN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana indenga niyimuhamba omuruchi Beleshazari, mumonimwe nimukalukhana; kata abaamibe nibarambwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.9",
            "verseOrgIds": [
              "DAN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhaye nyina omuruchi niyeenjila munzu yelisabo, khulwa amakhuwa komuruchi nabaamibe; omukhaye tsana naboola mbu Omwami omuruchi, oyindile obushia nobushia! Amapaaroko kaleshe okhukhuhendia, kata mumonimwo okhukalukhana ta. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.10",
            "verseOrgIds": [
              "DAN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliho omundu mubwamibwo owa roho yabanyasaye abatakatifu yili muye; mundaalo tsiaso omubasu kwanyooleshelanga muye, nobumanyilisii, nobuchesi, shinga obuchesi bwabanyasaye. Omuruchi Nebukadineza, so, yamukhola omwami wabafumu, nabobulookooli, nabaKalidayo, nabakhwenyi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.11",
            "verseOrgIds": [
              "DAN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila muDanieli tsana, owa omuruchi yakulikha mbu Beleteshazari, mwanyoolekhamwo iroho indayi, nobumanyi, nobumanyilisii okhubuula ebisina biamalooro, nokhukalusia akeminehe, nokhurimbulula amatinyu. Kho Danieli alangwe; ye alabuula eshisina.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.12",
            "verseOrgIds": [
              "DAN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Danieli niyeenjisibwa imbeli womuruchi. Omuruchi nareeba Danieli ari Niwe Danieli, owokhubaare baYuda, aba papa omuruchi yarusia eYuda, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.13",
            "verseOrgIds": [
              "DAN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Embuliile khwiwe, mbu roho wabanyasaye yili mwiwe, khandi mbu omubasu kunyooleshelanga mwiwe, nobumanyilisii nobuchesi obulayi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.14",
            "verseOrgIds": [
              "DAN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano abachesi, mbu abobulookooli, beenjisiibwe imbeli wanje mbu basoome lihandiiko lino, nibambuulila eshisina shialio; ne bakhayilwe okhubuula eshisina shiamakhuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.15",
            "verseOrgIds": [
              "DAN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa embuliile khwiwe, shinga olwa onyala okhurusia ebisina nokhurimbulula amakhuwa amatinyu; kho bulaano, noba nonyala okhusooma lihandiiko lino, nokhumbuulila eshisina shialio, olafwalwa tsingubo tsieisambarau, noreebwakhwo omunyolo kweitsahaabu mwikosi, noba owakhataru muburuchi bweshialo.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.16",
            "verseOrgIds": [
              "DAN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Danieli nakalusia, nali imbeli womuruchi, ari Otong'e nebihaanwabio, noheelesia oundi amataniko; nebutswa nesoomele omuruchi lihandiiko, nimubuulila eshisina. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe omwami omuruchi, Nyasaye Ouli Ikulu Muno yaheelesia so, Nebukadineza, oburuchi nobukhongo, noluyali, nobukhulundu; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
            "verseOrgIds": [
              "DAN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khulwa obukhongo obwa yamuheelesia, abetsimbia tsiosi namahanga netsinimi batechela nibaria imbeliwe; aba yeenya okhwira, yeera; naba yeenya babe mwoyo, yabalekha babe mwoyo; aba yeenya okhubuusia, yabuusia; naba yeenya okhwisia, yeesia. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.19",
            "verseOrgIds": [
              "DAN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omwoyokwe kwali nikwichinjimisiye, rohoye niyumile, nakholanga akeinjinia, yarusibwa khushifumbishie shioburuchi, niba-muyiniakhwo oluyalilwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.20",
            "verseOrgIds": [
              "DAN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeelusibwa okhurula khubandu, omwoyokwe nikukholwa shinga okweisolo, eshimenyoshie nishiba netsisishili tsinabulimo; yaayanga obunyasi shinga ing'ombe, omubilikwe nikunyira khulwa eliime lielikulu; okhuula olwa yamanya mbu Nyasaye Ouli Ikulu Muno arukanga muburuchi bwabandu, khandi mbu yeemekhanga khubwo owa omwene achama. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.21",
            "verseOrgIds": [
              "DAN.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, omwanawe Beleshazari, shiwitiitiyiye mumwoyokwo ta, kata olwa wamanya ako kosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
              "DAN.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "nebutswa wichinjimisiye okhufukula Omwami welikulu. Baleerile ebimanulwa bieinzuye imbeliwo, ne munyweelemwo idivai, iwe omwene, nabaamibo, nabakhasibo, nabasuriabo; khandi opaachile abanyasaye beifeetsa neitsahaabu, abomukasa neshibia nemisaala namachina, abaraloIanga kata okhuhulila kata okhumanya ta; nebutswa Nyasaye, omwenoyo owa omuuyakwo kuli mumukhonokwe, nowa tsinjilatsio tsiosi tsili etsitsie, shiomuheelesiye oluyali ta.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.23",
            "verseOrgIds": [
              "DAN.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho eshitonye shiomukhono tsana shirumilwe okhurula ewa ali, lihandiiko lino nilisaarwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
            "verseOrgIds": [
              "DAN.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nalio lihandiiko elisaarilwe ndielino; mbu MENE, MENE, TEKELI, PARESINI. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.25",
            "verseOrgIds": [
              "DAN.5.25"
            ]
          }
        },
        {
