    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhwechesibwa khwaDanieli nabashie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwakhataru kwoburuchi bwaYehoyakimu omuruchi waYuda, Nebukhadineza omuruchi waBabeli yoola eYerusalemu, niyeekalilamwo abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Omwami nahaana Yehoyakimu omuruchi waYuda mumukhonokwe, halala nebindi ebiokhubimanulwa bieinzu yaNyasaye; naye nabiyila mushialo shiaShinari, enanzu yanyasayewe; nabiikha ebimanulwa tsana mwibiishilo lianyasayewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nabiila Ashipenazi, omusinjilili wabasumbabe abalate, mbu aleere abandi abokhubaana baIsiraeli, abeinzu yomuruchi, nabamakuru; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.3",
            "verseOrgIds": [
              "DAN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "abasooliili ababula obulema bwosi, abelikondo, abasitsa mubuchesi bwosi, abali nobumanyi obunji, nobwechi obunji, abakhanyala okhukhalabana munzu yomuruchi; mbu abeechesie amachesi kosi kabaKalidayo nende olulimi lwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.4",
            "verseOrgIds": [
              "DAN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nabakabila omukabo buli nyanga okwokhubiokhulia ebinulu biomuruchi nokweidivai eya anyweetsanga. Yalaka mbu beechesibwe emiyika chitaru, mbu mana olunyuma lwa echio bakhalabanile omuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.5",
            "verseOrgIds": [
              "DAN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubo balimwo Danieli, Hanania, Mishaeli, naAzaria, abokhubaana baYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.6",
            "verseOrgIds": [
              "DAN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omukhulundu wabasumba abalate yabakulikha ameera kandi; yamukulikha Danieli mbu Beleteshazari; Hanania, mbu Shadaraka; Mishaeli, mbu Meshaki; naAzaria, mbu Abedinego.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.7",
            "verseOrgIds": [
              "DAN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Danieli yarakhwo omwoyo mbu aleshe okhwiyonoonia khulwa ebiliibwa ebinulu biomuruchi kata idivai eya yanyweetsanga; kho yasaba omukhulundu wabasumba abalate mbu aleshe okhwiyonoonia khulwabio. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.8",
            "verseOrgIds": [
              "DAN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye nachila Danieli nakoosibwa nomukhulundu wabasumba abalate tsana, namutiililwa eshisa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.9",
            "verseOrgIds": [
              "DAN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhulundu wabasumba abalate namusunjila Danieli mbu Eriitsanga omwami wanje omuruchi; neniye owalachilisia akebiokhulia nende ebiokhunywa bieenywe; naba namulola nimubiiyile mumoni okhushila abolubaka Iweenywe, ndakhaba mumatinyu kata akokhuremwa omurwe nomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.10",
            "verseOrgIds": [
              "DAN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Danieli namusunjila omusinjilili owa omukhulundu wabasumba abalate yali nareeleho khuDanieli, Hanania, Mishaeli, naAzaria, ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.11",
            "verseOrgIds": [
              "DAN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari Chama okhuteeme ifwe abasumbabo tsindaalo ekhumi; khuheebungwe ebiliibwa ebiraache bionyene okhulia, namatsi okhunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.12",
            "verseOrgIds": [
              "DAN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana okhuhenje, olole shinga olwa khuli, nende abasooliili balia abaliitsanga khubiokhulia ebinulu biomuruchi; ne shinga olwa olalola, nindio olakhukholela ifwe abasumbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.13",
            "verseOrgIds": [
              "DAN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabahulila khumakhuwa ako, nabateema tsindaalo ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.14",
            "verseOrgIds": [
              "DAN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyuma lwetsindaalo ekhumi bali nibakaasile mumoni, emibili chiabwe nachio nichikhomeele, okhushila abasooliili abo bosi abali nibaliitsanga khubiokhulia ebinulu biomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.15",
            "verseOrgIds": [
              "DAN.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omusinjilili tsana nabayiniakhwo ebiliibwa biabwe ebinulu neidivai eya bali nibakhoyile okhunywa, nabaheelesinjia ebiliibwa ebiraache.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.16",
            "verseOrgIds": [
              "DAN.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abasiani abo bane, Nyasaye yabaheelesia obumanyi nobusitsal mukhweka khwosi, nobuchesi; naye Danieli yali nobumanyilisii bwamabisulo kosi nende amalooro. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.17",
            "verseOrgIds": [
              "DAN.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo olwa tsiali nitsihweele, olwa omuruchi yali nalachile mbu baleerwe, omukhulundu wabasumba abalate yabeenjisia imbeli waNebukadineza; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.18",
            "verseOrgIds": [
              "DAN.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye omuruchi nasungana ninabo; ne mubo bosi shiyanyoolekha oundi yesi owahelana nende Danieli, Hanania, Mishaeli, naAzaria ta; kho nibakhalabanila omuruchi ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.19",
            "verseOrgIds": [
              "DAN.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mubuli likhuwa liosi liobuchesi kata obumanyilisii elia omuruchi yabareebakhwo, yanyoola nibashila abafuma nabobulookooli bosi abali muburuchibwe, akhandi ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.20",
            "verseOrgIds": [
              "DAN.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Danieli natsiililila ario okhuula khumuyika kwambeli kwomuruchi Koreshi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.21",
            "verseOrgIds": [
              "DAN.1.21"
            ]
          }
        }
      ]
    }
  ],
