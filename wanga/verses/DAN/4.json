          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsindaalo etsio olwa tsiali nitsihweele, isie Nebukadineza ndachinguula tsimoni nihenga khwikulu, obuchesi bwanje nibukalukha, nimwitsoomia Oyo Ouli Ikulu Muno, nimupaaka nimuheelesia oluyali oumenyangaho obushia nobushia;",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
