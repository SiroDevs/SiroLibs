    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rutsi yaruluma mumukunda kwaBoazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Naomi yali nende omwikhowe, omundu omukhongo omuyinda, oweshilibwa shiabwe Elimeleki; neliiralie liali Boazi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Rutsi, omukhaana oyo omuMoabu, nasunjila Naomi ari Chama enzie mumukunda, mbu erulume imele inyuma womundu yesi owakhangoosia. Naye ari Khatsie, mukhaana wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho natsia, niyoolayo naruluma mumukunda inyuma wabachesi. Ne yeetsukhana nali mushitonye shiomukunda eshiali shiaBoazi, owali oweshilibwa shiabwe Elimeleki. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Boazi niyeetsa okhurula eBetelehemu, nashiesia abachesi, ari OMWAMI abe halala nineenywe. Nibakalusia mbu OMWAMI akhuheelesie ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.4",
            "verseOrgIds": [
              "RUT.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Boazi nareeba omusumbawe, owali nasinjilila abachesi, ari Omukhaana uno nowawina? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.5",
            "verseOrgIds": [
              "RUT.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusumba oyo owali nasinjililanga abachesi nakalusia mbu Nomukhaana tsana omuMoabu, owa Naomi yachelela ninaye, okhurula mushibala shiaMoabu; ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.6",
            "verseOrgIds": [
              "RUT.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "yasabile mbu Ochame erulume inyuma wabachesi nikhung'aasia ebili hasi webinywa; kho niyeetsa, ne ashiliho okhurula mutsuli okhuula bulaano, narahuluukhakhwo kata hatiiti ta.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.7",
            "verseOrgIds": [
              "RUT.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Boazi nasunjila Rutsi ari Mukhaana wanje, hulila; oratsia okhuruluma mumukunda kundi kwosi, kata okhurula hano ta; ne otong'e hano, ewa abakhaana banje bali. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.8",
            "verseOrgIds": [
              "RUT.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimonitsio tsihenjenje omukunda okwa bachesa, nobalondakhwo; shindachile abasooliili mbu baleshe okhukhutiilakhwo? Kata olwa oba noli nobuloho, otsie khutsisiongo tsilia, onywe khumatsi aka abasooliili batayile. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.9",
            "verseOrgIds": [
              "RUT.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasikama, nabunamia obwenibwe hasi, namusunjila ari Nasi engoosibwa endie imbeliwo, iwe okhunzitsulilakhwo, olwa endi omusuku? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.10",
            "verseOrgIds": [
              "RUT.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boazi nakalusia namusunjila mbu Embooleelwe bulayi amakhuwa kosi aka wakholeele nyakhufialawo, okhurula khukhufwa khwomusaatsawo, khandi shinga olwa walekha so nende mawo nende eshialo eshia weebulilwamwo, niwitsa ewabandu aba oramanyilekhwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.11",
            "verseOrgIds": [
              "RUT.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI akhurunje khulwa ebikholebio, khandi oheebwe amatani amalamba nOMWAMI, Nyasaye waIsiraeli, owa witsile okhwibisa mumbahatsie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.12",
            "verseOrgIds": [
              "RUT.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga mbu Engoosibwe imbeliwo, omwami; okhuba unemiye omwoyo, khandi umbooleele isie omukholiwo akeshisa, kata nindali shinga mulala wabakhaana abakholibo ta.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.13",
            "verseOrgIds": [
              "RUT.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khusaa yokhulia Boazi namulanga, ari Yitsa, olie khumukaate kuno, notonga mudivai eyiraanyile yino. Kho niyeekhala nabachesi; Boazi namukaamila imele inziyile, nalia, niyeekura, ebindi nibitong'a. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.14",
            "verseOrgIds": [
              "RUT.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yali nabuushile natsiile okhuruluma, Boazi nalaka abasooliilibe ari Leshe arulume kata hakari mubinywa, ni nuramuloshela ta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.15",
            "verseOrgIds": [
              "RUT.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mutsomolekhwo eyindi mubinywa, muchileshe, arulume; muramuhalabila ta.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.16",
            "verseOrgIds": [
              "RUT.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yaruluma mumukunda okhuula olwa bweela, nahuula eyo eya yali naruluume, niyiba shinga efa ndala yeishayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.17",
            "verseOrgIds": [
              "RUT.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachiyila natsia mwitaala, namanyia nyakhufialanyene eya yali naruluume; khandi yarusia ebio ebia yatong'a ninabio olwa yali niyeekuure, namuheelesia. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.18",
            "verseOrgIds": [
              "RUT.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "RUT 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakhufialanyene namureeba mbu Oruluume heena leelo? Okholilenje heena? Aheebue ikhabi oyo oukhwitsuliile. Mana yamuboolela nyakhufialanyene akomundu owa akholileyo emilimo, ari Eliira liomundu owa ekholileyo emilimo leelo niye Boazi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "RUT 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi nasunjila nyakhufialanyene ari Aheebwe ikhabi yOMWAMI, ouraleshile okhubakholela akeshisa abalamu nende abafu bosi ta! Naomi namuboolela mbu Omundu oyo nomwikho weefwe, omuluyia ouli ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "RUT 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rutsi omukhaana omuMoabu nakalusia mbu Khandi yambooleele mbu Otong'e ahambi nabakholi banje, okhuula olwa balaba nibamalile lichesa lianje liosi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.21",
            "verseOrgIds": [
              "RUT.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "RUT 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naomi nasunjila Rutsi nyakhufialanyene ari Mukhaana wanje, nobulayi mbu otsiitsenje nabakhaanabe, abandu baleshe okhukhukwakhwo mumukunda kundi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.22",
            "verseOrgIds": [
              "RUT.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "RUT 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yatong'a ahambi nabakhaana baBoazi okhuruluma, okhuula khubumaliilishi bwelichesa lieishayiri nende elieingano; ne namenyanga nanyakhufialanyene.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.23",
            "verseOrgIds": [
              "RUT.2.23"
            ]
          }
        }
      ]
    }
  ],
