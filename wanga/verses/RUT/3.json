        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Rutsi naBoazi halutse",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "RUT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Naomi nyakhufialanyene namusunjila mbu Omukhaana wanie, shikhoyile okhukhu-khaabila obuhuluushilo, mbu obe bulayi? ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.1",
            "verseOrgIds": [
              "RUT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano Boazi oyo owa obeelenje nabakhaanabe, shialiye mulamuwo? Lola, eshilo shino ali okhuseesa ishayiri halutse. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.2",
            "verseOrgIds": [
              "RUT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho wiyosie, wibashe amafura, niwifwala bulayi, otsie halutse tsana; ne oreemanyishila omusaatsa oyo ta, okhuula olwa alaba namalile okhulia nende okhunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.3",
            "verseOrgIds": [
              "RUT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa atsia okhukona, ohenje bulayi ewa akona, mana winjile, ofuunule ebilenjebie, niwiyalisia; naye alakhuboolela eshia okhola. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.4",
            "verseOrgIds": [
              "RUT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namukalusia mbu Ndalakhola kosi aka oboola.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.5",
            "verseOrgIds": [
              "RUT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nakholomokha natsia halutse tsana, nakhola kosi aka nyakhufialanyene yali namubooleele. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.6",
            "verseOrgIds": [
              "RUT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "RUT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Boazi yali naliile nanyweele, omwoyokwe nikutsatsahaale, yatsia okhukona khundulo weshituuli shieimele; naye niyeetsa kahala, nafuunula ebilenjebie, niyeeyalisia. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.7",
            "verseOrgIds": [
              "RUT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mushilo hakari omusaatsa oyo yeesundukha, niyeeshiukhasia, ne omukhasi ngwoyo, nakonile habilenjebie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.8",
            "verseOrgIds": [
              "RUT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "RUT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nareeba ari Niwe wina? Naye nakalusia mbu Nisie omukholiwo Rutsi; chama wale inguboyo khumukholiwo; okhuba oli mulamwa. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.9",
            "verseOrgIds": [
              "RUT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "RUT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naboola mbu OMWAMI akhuheelesie ikhabi, omukhaana wanje. Eshisashjo shino shiolunyumakhwo shishila eshiambeli, shichila shiwalondakhwo abasooliili, kata abamanani kata abayinda ta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.10",
            "verseOrgIds": [
              "RUT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "RUT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, omukhaana wanje, oraria ta; ndalakhukholela kosi aka oboola; okhuba abomwitaala lieefwe bosi bamanyile shinga olwa oli omukhasi ouli omukhaye toto. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.11",
            "verseOrgIds": [
              "RUT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "RUT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tieri, endi mulamuwo; habula aliho mulamuwo undi ouli ahambi okhushila isie. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.12",
            "verseOrgIds": [
              "RUT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olinde butswa eshilo shino; mana mukamba, naba nafuchiilila okhukhukholela akakhoyeele mulamwa, nobulayi; akhukalusie; ne naba narachama okhukhukalusia ta, kho isie ndalakhukalusia, shinga OMWAMI olwa abeetsangaho mwoyo. Okone okhuula mukamba.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.13",
            "verseOrgIds": [
              "RUT.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "RUT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.13",
            "verseOrgIds": [
              "RUT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "RUT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yakona habilenjebie okhuula mutsuli; mana nabuukha khushise eshia oranyala okhumanyilisia omundu ta. Okhuba Boazi yaboola mbu Omundu yesi aleshe okhumanya mbu omukhasi uno yeetsile halutse ta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.14",
            "verseOrgIds": [
              "RUT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "RUT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nasunga mbu Leera ingubo eyo eya wifuubiile, ochibambule; naye nachibambula; Boazi nachela ebichelo bisasaba bieishayili, namutuukha; mana natsia mwitaala. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.15",
            "verseOrgIds": [
              "RUT.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "RUT 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yeetsa ewanyakhufialanyene, yamureeba ari Rho kabeele karie, mukhaana wanje? Naye namuboolela kosi aka omusaatsa oyo amukholeele. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.16",
            "verseOrgIds": [
              "RUT.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "RUT 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Ishayiri yino eyebichelo bisasaba, niye oumbeelesiye; okhuba aboolile mbu Orakalushila nyakhufialawo amakhono amakhaya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.17",
            "verseOrgIds": [
              "RUT.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "RUT 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namuboolela mbu Olinde butswa, mukhaana wanje, okhuula olwa olamanya amakhuwa kano shinga olwa keetsa okhuba; okhuba omusaatsa oyo shialahliluukha ta, okhuula olwa alaba nakamalilisiye inyanga yino.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.3.18",
            "verseOrgIds": [
              "RUT.3.18"
            ]
          }
        }
      ]
    }
  ],
