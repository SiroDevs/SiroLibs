  "bookId": "GEN",
  "reference": "Obuchachilo 35",
  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "35",
        "style": "c",
        "sid": "GEN 35"
      },
      "items": [
        {
          "text": "35",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyasaye yamuheelesilia Yakobo ikhabi eBeteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye naboolela Yakobo mbu Rula, otikulushe otsie eBeteli, omenyeyo; omukholeleyo Nyasaye eshimalilo shiemisango, owatsana owakhuloleshela olwa weelukhanga Esau omwana weenywe ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.1",
            "verseOrgIds": [
              "GEN.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nasunjila abomwitaalalie, nende bosi aba yali ninabo, ari Murusie abanyasaye abacheni abaliho mwinywe, nimwilafia abeene, nimwikalukhasia mubiifwalo bieenywe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.2",
            "verseOrgIds": [
              "GEN.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana chende khutikulushe khutsie eBeteli; nasi ndalakholelayo Nyasaye eshimalilo shiemisango, owatsana owambabina khunyanga yamasila kanje, naba ninasi khunjila eya ndatsiilakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.3",
            "verseOrgIds": [
              "GEN.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaheelesia Yakobo abanyasaye abacheni bosi abali mumikhono chiabwe, nende tsingaka etsiali mubirwi biabwe; naye Yakobo nabibisa hasi womuruba okuli eShekhemu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabuusia oluchendo; oburii obukhongol nibutiila amataala akali nikababotokhana, abalimwo nibaralonda abaana baYakobo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yakobo niyoola eLuzu, elili mushialo shiaKanaani, nilio Beteli, ye nende abandu bosi aba yali ninabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoombakhayo eshlmalilo shiemisango, nakulikha habundu yaho mbu Eli-Beteli, okhuba habwenaho Nyasaye yamwibisushila, olwa yali niyeelukhanga omwana wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Debora omulesi waRebeka nafwa, nayabilwa mundalila weBeteli hasi womuruba okwo; nakwo nikukulikhwa eliira mbu Aloni-bakhutsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nyasaye yamuloleshela Yakobo khandi olwa yali narulanga ePadanaramu, namuheelesia ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye namuboolela mbu Eliiralio niYakobo; eliiralio shililalangungwa mbu Yakobo khandi ta, habula Isiraeli lilaba eliiralio; namulanga eliira mbu Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.10",
            "verseOrgIds": [
              "GEN.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye namusuniila mbu Nisie Nyasaye Ounyala Biosi; wibulenje niwinjiha; lihanga khandi omukhung'aano kwamahanga kalarula mwiwe, abaruchi nabo balarula mundayo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshialo eshia ndaheelesia Aburahamu nende Isaka, ekhuheelesia iwe, nende olwibulolwo munyumawo enduheelesia eshialo eshio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Nyasaye nakulukha okhurula aha yali, habundu yaho ewa yali nasungaane ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo naye nasinjisiayo isiilo, habundu yaho aha yasunganila ninaye, isiilo yelichina lisongokhu; mana natsukhakhwo omusango kwokhutsushilwa, natsukhakhwo amafura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.14",
            "verseOrgIds": [
              "GEN.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nalanga habundu yaho aha Nyasaye yasunganila ninaye eliira mbu Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaRaheli.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.15",
            "verseOrgIds": [
              "GEN.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibachaaka oluchendo okhurula eBeteli; ne nilushisikala oluchendokhwo okhuula eEferatsi, mana Raheli nachaaka okhulumwa okhwibula, okhwibulakhwe nikhuba okhutinyu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.16",
            "verseOrgIds": [
              "GEN.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nalumwa butinyu, omwibusiawe yamusunjila ari Oraria ta; okhuba bulaano witsa okhuba nende omwana undi omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.17",
            "verseOrgIds": [
              "GEN.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa omwoyokwe kwali nikwenya okhukhalikha, okhuba yamala nafwa, yamukulikha eliira mbu Benoni: habula samwana yamukulikha mbu Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.18",
            "verseOrgIds": [
              "GEN.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raheli nafwa, nayabilwa khunjila eyitsia eEferatsi, nilio Betselehemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.19",
            "verseOrgIds": [
              "GEN.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nasinjisia lichina lisongokhu khushilindwashie; nilio Isiilo yEshilindwa shiaRaheli okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.20",
            "verseOrgIds": [
              "GEN.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli natsiililila nakhoma liheemalie imbeli womunaara kwaEderi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaana baYakobo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.21",
            "verseOrgIds": [
              "GEN.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa Isiraeli yali nashimenya mushialo eshio, Reubeni natsia nakona nende Biliha, omusuria wasamwana; Isiraeli naye nahulilakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baYakobo bali ekhumi nababili; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana baLea mbabano; Reubeni, omwana wambeli waYakobo, nende Simeoni, nende Lawi, naYuda, naIsakhari, naZabuloni; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.23",
            "verseOrgIds": [
              "GEN.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaana baRaheli, Yusufu nende Benyamini; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.24",
            "verseOrgIds": [
              "GEN.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaana baBiliha, omukholi waRaheli, Dani nende Nafutali; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.25",
            "verseOrgIds": [
              "GEN.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaana baZilipa, omukholi waLea, Gadi nende Asheri; bano nibo abaana baYakobo, aba yeebula muPadanaramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwalsaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.26",
            "verseOrgIds": [
              "GEN.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yakobo niyoola ewaIsaka samwana eMamure, eKiriatsiaraba, nilio Heberoni, ewa Aburahamu nende Isaka bali nibamenyakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.27",
            "verseOrgIds": [
