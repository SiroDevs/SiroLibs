{
  "id": "GEN.40",
  "number": "40",
  "bookId": "GEN",
  "reference": "Genesis 40",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "40",
