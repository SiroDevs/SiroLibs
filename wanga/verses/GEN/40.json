      },
      "items": [
        {
          "text": "40",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufu yabuula ebisina biamalooro kababohe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 40:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo omukaami weshiokhunywa womuruchi waMisiri nende omuteeshi wemikaatechie bamwonoonela omwami wabwe omuruchi waMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.1",
            "verseOrgIds": [
              "GEN.40.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 40:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Farao yabatiililwa oburima abakali abo babili, mbu omukhulundu wabanyweesii nende omukhulundu wabateeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.2",
            "verseOrgIds": [
              "GEN.40.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 40:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabara mundindi munzu yomwimilisi wabasikari, mumbohe habundu tsana ewa Yusufu yabohwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.3",
            "verseOrgIds": [
              "GEN.40.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 40:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwimilisi wabasikari namuheelesia Yusufu obulindi khubo, naye nabakhalabanila; nabo nibeekhalayo eshise mundindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.4",
            "verseOrgIds": [
              "GEN.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana bombi nibaloora amalooro, shia omundu liloorolie, mushilo shilala shieneshio, shia omundu nende eshisina shieliloorolie, omunyweesii oyo nende omuteeshi wemikaate womuruchi waMisiri, abali nibabohwa mumbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.5",
            "verseOrgIds": [
              "GEN.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 40:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mutsuli Yusufu niyeenjila ewa bali, nabalola nibahendanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.6",
            "verseOrgIds": [
              "GEN.40.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 40:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabareeba abakali baFarao aba yali ninabo mundindi munzu yomwamiwe, nasunga ari Mukhabeele murie leelo, abakhuuniye mumoni? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.7",
            "verseOrgIds": [
              "GEN.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 40:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila mbu Khuloorile amalooro, ne shialiho ounyala okhukhubuulila eshisina ta. Yusufu nabasunjila ari Ne okhubuula khwosi shikhuli khwaNyasaye? Nimuchama, mumboolele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.8",
            "verseOrgIds": [
              "GEN.40.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 40:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omunyweesii omukhulundu namutoonyela Yusufu akeliloorolie, namusunjila mbu Mwilooro lianje, lola, omutsabibu kubeele imbeli wanje; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.9",
            "verseOrgIds": [
              "GEN.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khumutsabibu okwo kubeele nende amasaka kataru; nikukhola shinga okukanikha, ebimuli nibimulikha; mana nikwama ebiamo ebiengu, ebibumbaane khumasaka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.10",
            "verseOrgIds": [
              "GEN.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne eshikombe shiaFarao shibeele nishili mumukhono kwanje; nimbukula tsinzabibu, nindiinyila mushileombe shiaFarao, nimukaamila Farao eshikombe mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.11",
            "verseOrgIds": [
              "GEN.40.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 40:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu namusunjila ari Shino nishio eshisina shialio; mbu amasaka ako kataru netsindaalo tsitaru; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.12",
            "verseOrgIds": [
              "GEN.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyuma wetsindaalo tsitaru, Farao yakhakhuchinguule omurwekwo, nakhukalusia mumilimochio; neshikombe shiaFarao nomuheelesie mumukhonokwe shinga olwa wakholanga olwambeli olwa walinji omunyweesiiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.13",
            "verseOrgIds": [
              "GEN.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne unzitsulile isie olwa nobe nonyoolile amalayi, niukholela akeshisa, ekhusaaya; urumbule ewaFarao urusie munzu muno; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.14",
            "verseOrgIds": [
              "GEN.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba toto mwene, ndeebwa okhurula mushialo shiabaHeburania; kata nende hano shindakholakhwo likhuwa liosi eliakhachila nibara mumbohe yobwina tawe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.15",
            "verseOrgIds": [
              "GEN.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa omuteeshi wemikaate omukhulundu yalola mbu obubuuli obwo bwali obulayi, namusunjila Yusufu mbu Nasi mwilooro lianje, lola, embeele nebitelu bitaru biemikaate emilafu khumurwe kwanje; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.16",
            "verseOrgIds": [
              "GEN.40.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 40:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khushitelu shiahekulu bibeelekhwo ebiliibwa biaFarao bietsimbia tsiosi, emilimo chiomuteeshi wemikaate; ne amanyonyi nikabilia khushitelu khumurwe kwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.17",
            "verseOrgIds": [
              "GEN.40.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 40:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu namukalusia naboola mbu Shino nishio eshisina shialio; mbu ebitelu ebio bitaru netsindaalo tsitaru; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.18",
            "verseOrgIds": [
              "GEN.40.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "inyuma wetsindaalo tsitaru Farao yakhachinguule omurwekwo nakurusia khwiwe, ne yakhakhuhanishe khumusaala; amanyonyi nako kakhalie inyamayo khumubilikwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 40:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.19",
            "verseOrgIds": [
              "GEN.40.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 40:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu khunyanga yakhataru, niyo inyanga yaFarao yokhwitsulila okhwibulwakhwe, yateeshela abakholibe bosi lisabo; nachinguula omurwe kwomunyweesii omukhulundu khandi nende omurwe kwomukhulundu wabateeshi bemikaate hakari wabakholibe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.20",
            "verseOrgIds": [
              "GEN.40.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 40:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namukalusia omunyweesii omukhulundu mumilimochie chiobunyweesii khandi; naye namukaamila Farao eshikombe mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.21",
            "verseOrgIds": [
              "GEN.40.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuteeshi wemikaate omukhulundu namuhanikha, shinga Yusufu olwa yali nababuuliile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omunyweesii oyo omukhulundu shiyamwitsulila Yusufu ta; yamwibilila butswa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.23",
            "verseOrgIds": [
              "GEN.40.23"
            ]
          }
        }
      ]
    }
  ],
