        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Yakobo yali namalilisiye okhulaamila abaanabe amukhuwa, yafumba ebilenjebie khushitali, nakhalikha omwoyo, nakhung'aasibwa halala nende abandube.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
