        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo niyeerechekha okhubukaana nende Esau",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo naye natsiililila muluchendolwe, abamalaika baNyasaye nibamubukaanila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yakobo olwa yabalola, naboola mbu Lino nelihe liaNyasaye; nakulikha habundu tsana eliira mbu Mahanaimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo naruma abarume bamuranjilile, mbu batsie ewaEsau omwana wabwe, mushibala shiaSeiri, mumbali tsiaEdomu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.3",
            "verseOrgIds": [
              "GEN.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabalaka nasunga ari Nilwo olwa namuboolele omwami wanje Esau; mbu Omukholiwo Yakobo aboola mbu Ndamenyangayo ewaLabani, nishindayo okhuula bulaano; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.4",
            "verseOrgIds": [
              "GEN.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne endi nende tsing'ombe, nende tsisishili, nende ebiayo, nende abakholi abeshisaatsn nende abeshikhasi; ne erumile abandu okhumumanyia omwami wanje, mbu mana engoosibwe imbeliwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.5",
            "verseOrgIds": [
              "GEN.32.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abarume abo nibamukalushila Yakobo nibasunga mbu Khuulile ewomwana weenywe Esau, naye yeetsa okhukhubukaanila; ne ali nende abandu ebikhumi bine. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo naria, nabeeyabeeya muno; kho nakabula abandu aba yali ninnbo, nende ebiayo, nende tsing'ombe, nende tsingamia, emikanda chibili; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "naboola ari Esau naba niyoola khumukanda kwambeli nakukhupa, omukanda okusikala nakwihonokoshe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo naboola mbu Ee Nyasaye wakuuka Aburahamu, Nyasaye wapapa Isaka, OMWAMI ovasunjila mbu Kalukha mushibalashio, nende mubaluyiabo, nasi ndilikhukholela obulayi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "isie shingwaniile obuheelibwo oburalilu kata hatuutu ta, kata obwatotobwo bwosi, ebia wakholela isie omusumbawo; okhuba ndaambukha Yorodani kuno nindi nende indabushi yanje yonyene; ne bulaano engwile emikanda chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbabine mumukhono kwomwana weefwe, mbu mumukhono kwaEsau; okhuba emuriile, mbu fwana yakheetsa wa'khupa, nende nyina halala nende abaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe waboola mbu Okhukhola ndilikhukholela obulayi, nikhola olwibulolwo lube shinga omuyeshe kweinyanza, okurabalikhakhwo tawe khulwa obunji bwakwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakonaho eshilo shieneshio; kho nabukula khubia yali ninabio, bibe eshihaanwa shiaEsau omwana wabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.13",
            "verseOrgIds": [
              "GEN.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbiebino, mbu tsimbusi tsinyafusi ebikhumi bibili nende tsikhole amakhumi kabili, amakondi amanyafusi ebikhumi bibili nende amamiiku amakhumi kabili, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.14",
            "verseOrgIds": [
              "GEN.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsingamia etsiali nitsinuunia halala nende abaana batsio amakhumi kataru, tsing'ombe tsitwasi amakhumi kane nende tsisurusi ekhumi, tsisishili tsikhasi amakhumi kabili nende ebimoosi biatsio ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.15",
            "verseOrgIds": [
              "GEN.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabihaana mumikhono chiabasumbabe, shia lituuli khubwalio; nasunjila abasumbabe ari Muranjilile okhwambukha, ne muleshenje olwanga hakari welituuli nende lituuli lindi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.16",
            "verseOrgIds": [
              "GEN.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalaka owaranjilila ari Olwa namubukaane nende Esau omwana weefwe, nakhureeba mbu Oli owawina? Ne otsia heena? Khandi nebiawina ebia wimisiye bino? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.17",
            "verseOrgIds": [
              "GEN.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho osunje mbu Nebiomusumbawo Yakobo; neshihaanwa eshirumiilwe omwami wanje Esau; naye ngwoyo, ali munyuma weefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.18",
            "verseOrgIds": [
              "GEN.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi nalaka ario owokhubili nende owokhutaru, bosi abalondanga amatuuli, ari Nolwa namumuboolele Esau, nimumunyoola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.19",
            "verseOrgIds": [
              "GEN.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi mulamusunjila muri Omusumbawo Yakobo ngwoyo, ali munyuma weefwe. Okhuba yasunga mbu Ndalamukwisia omwoyo khulwa eshihaanwa eshiranjiliile imbeli wanje, mana olunyumakhwo ndalamulola mumoni; haundi nayafuchiilile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.20",
            "verseOrgIds": [
              "GEN.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho eshihaanwa eshio nishiranjilila okhwambukha; naye omwene nakona eshilo shieneshio mumukanda okwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo yalwanilwa ePenieli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.21",
            "verseOrgIds": [
              "GEN.32.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nabuukha eshilo shieneshio, nabukula abakhasibe babili, nende abakholibe abakhasi babili, nende abaanabe ekhumi namulala, niyaambukha mwifubukho lieYaboku. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.22",
            "verseOrgIds": [
              "GEN.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nababukula nabaambusia injelekha womuchela, niyaambusia nende biosi ebia yali ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.23",
            "verseOrgIds": [
              "GEN.32.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo natong'a yenyene; ne yaliho omusaatsa undi owamulwania okhuula olwa bwashia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.24",
            "verseOrgIds": [
              "GEN.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yalola shinga olwa aramunyala ta, namutiilakhwo lifwonelo lieikhukunyu; mana lifwonelo lieikhukunyu yaYakobo niliibalalila, olwa yali nalwananga ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.25",
            "verseOrgIds": [
              "GEN.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Ndekhuula enzie, okhuba eshibala bwakhachaaka okhushia. Yakobo nasunga mbu Shikhulekhuula ta, habula niumbeele ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.26",
            "verseOrgIds": [
              "GEN.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namureeba ari Eliiralio niwe wina? Naye ari Nisie Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naboola mbu Eliiralio shiolalangungwa mbu Yakobo khandi ta, habula Isiraeli; shichila olwanile nende Nyasaye khandi nende abandu, nohula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.28",
            "verseOrgIds": [
              "GEN.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo namureeba ari Chama umboolele eliiralio. Naye nasunga mbu Ne nishiina eshichila niureeba eliira lianje? Namuheelesia ikhabi habwenaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nakulikha habundu tsana eliira mbu Penieli; okhuba yaboola mbu Emuluutsi Nyasaye mumoni nomumoni, khandi ndihonokooshe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliuba nilifwinda nilibala khuye niyaambukhanga ePenueli, natiechela ikhukunyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila abaana baIsiraeli shibaliitsanga omusi kweibaatswa okuli khwifwonelo lieikhukunyu kata okhuula bulaano ta; okhuba yatiila khwifwonelo lieikhukunyu yaYakobo khumusi kweibaatswa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
        }
