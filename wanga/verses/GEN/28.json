{
  "id": "GEN.28",
  "number": "28",
  "bookId": "GEN",
  "reference": "Genesis 28",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "GEN 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Isaka namulanga Yakobo, namusabila ikhabi, namulaka, namuboolela mbu Oraleera omukhasi owomubakhaana baKanaani tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rula, otsie ePadanaramu, munzu waBetsueli, samwana mawo; winyoolelemwo omukhasi mubwenomwo, khubakhaana baLabani khootsawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye Ounyalabiosi akhuheelesie ikhabi, akhunyalile okhwibulana muno, nakhwinjiyia, mbu obe omukanda kwetsimbia tsiabandu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nakhuheelesia ikhabi yaAburahamu, iwe nende olwibulolwo lwosi; mbu mana olie eshibala eshia wamenyamwo noli omucheni, eshia Nyasaye yamuheelesia Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Isaka yaseebula Yakobo; naye natsia ePadanaramu ewaLabani, omwana waBetsueli omuSiria, omusiani wabwe Rebeka, nyinabwe Yakobo nende Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Esau yaleera omukhasi undi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Esau yalola mbu Isaka usabiile Yakobo ikabi nende okhumuruma ePadanaramu mbu yeenyoolele omukhasi ebweneyo khandi mbu olwa amusabiile ibaraka amulachile ari Oraleera omukhasi owokhubakhaana baKanaani tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi mbu Yakobo ahuliile samwana nende nyina, ne utsiile ePadanaramu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau nalola mbu abakhaana baKanaani shibachamisia Isaka samwana tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho Esau natsia ewaIshimaeli, nameeta khubakhasi aba yali ninabo, Mahalatsi omukhaana waIshimaeli omwana waAburahamu, mbootsonyene Nebayotsi, mbu abe omukhasiwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lilooro lia Yakobo nali eBeteli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yakobo narula eBeeri-sheba, nachoomile olchutsia eHarani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yeetsukhana niyoola habundu undi nakonaho, okhuba eliuba liali nilimalile okhuyeela; nabukula lichina elala khukeenako akaliho, niyeeyichikhakhwo omurwe, niyeeyalisia habundu tsana okhukona. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naloora lilooro, mbu obuniinilo nibusinjisiibwe khushibala, ne omurwe kwabwo kuulile mwikulu; khandi lola, abamalaika baNyasaye mbabo, nibaniinanga nende okhwishilakhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lola, OMWAMI yali nasinjiile hekulu khubwo, naboola mbu Isie nisie OMWAMI, Nyasaye wakuukawo Aburahamu, khandi Nyasaye waIsaka; eshialo eshia okonilekhwo, ekhuheelesia, iwe nende olwibulolwo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.13",
            "verseOrgIds": [
              "GEN.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nolwibulolwo luliba shinga olufu olwokhushibala, nawe olilandaala khulubeka lwamumbo, nende ebukwe nende enotsi, nende esautsi; ne mwiwe, khandi mulwibulolwo, nimwo omwa abebilibwa biosi bieshibala balinyoolelamwo ikhabi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.14",
            "verseOrgIds": [
              "GEN.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi lola, endiho halala ninawe, khandi ndalakhulindanga aha otsia hosi, nikhukalusia mushialo shino; okhuba shindilikhulekha butswa tawe okhuula olwa ndiliba nimalile okhukhukholela ako kosi aka ndakhakhuboolela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.15",
            "verseOrgIds": [
              "GEN.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nasisimukha mundoolo, naboola mbu Khane OMWAMI ali habundu hano, nasi shimanyilenje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.16",
            "verseOrgIds": [
              "GEN.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naria, naboola ari Habundu hano nahoburiisii muno. Hano shihachweya okhuba inzu yaNyasaye tawe, khandi shino neshilibwa shiomwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.17",
            "verseOrgIds": [
              "GEN.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nahuuna mumabwibwi nabukula lichina lienelo elia yali niyeeyichishenjekhwo omurwe, nalisinjisia libe isiilo isongookhu, natsukhakhwo amafura khumurwe kwalio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.18",
            "verseOrgIds": [
              "GEN.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakulikha habundu tsana eliira mbu Beteli; ne eliira lielitaala elo khale lialinji Luzu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.19",
            "verseOrgIds": [
              "GEN.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo yeetsuba eshiitsubo, naboola mbu Nyasaye naba nali halala ninasi, niyaninda khunjila yino eya enziilakhwo, nende okhumbeelesia ebiliibwa ebia endia, nende ebiifwalo ebia ndifwala, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.20",
            "verseOrgIds": [
              "GEN.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu mana engalushe eweefwe mumulembe, kho OMWAMI alabeetsanga Nyasaye wanje, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.21",
            "verseOrgIds": [
              "GEN.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "nelichina lino elia esinjisiye mbu libe isiilo, liliba inzu yaNyasaye; ne khubiosi ebia olimbeelesinjia, nasi toto mwene ndilikhuheelesinjia eshitonye shielikhumi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.22",
            "verseOrgIds": [
              "GEN.28.22"
            ]
          }
        }
      ]
    }
  ],
