  "bookId": "GEN",
  "reference": "Genesis 46",
  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "46",
        "style": "c",
        "sid": "GEN 46"
      },
      "items": [
        {
