          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo nabelitaalalie batsia eMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 46:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Isiraeli nabuusia oluchendo halala nende biosi ebia yali ninabio, niyoola eBeeri-sheba, namalila Nyasaye waIsaka samwana emisango. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.1",
            "verseOrgIds": [
              "GEN.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye nasungana nende Isiraeli mumabisulo akomushilo, naboola mbu Yakobo, Yakobo. Naye nafuchila mbu Endiho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.2",
            "verseOrgIds": [
              "GEN.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboola mbu Isie msie Nyasaye, mbu Nyasaye waso; oraria okhukholomokha okhuula eMisiri ta; okhuba ebweneyo ndalakhukhola obe lihanga likhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.3",
            "verseOrgIds": [
              "GEN.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie ndalakholomokha halala ninawe okhuula eMisiri; ne toto, ndilikhutikulusia khandi okhurulayo; naye Yusufu alira omukhonokwe khumonitsio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.4",
            "verseOrgIds": [
              "GEN.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo narula eBeerisheba; abaana baIsiraeli nabo nibabukula Yakobo saabwe, nende abaana babwe abatiiti, nende abakhasi babwe, mumakaari aka Farao yali nayilileyo okhumuchinga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.5",
            "verseOrgIds": [
              "GEN.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabukula nende emiruko chiabwe, nemiandu chiabwe chiosi echia oali nibanyoolile mushialo shiaKanaani, niboola eMisiri, Yakobo nende olwibulolwe lwosi halala ninaye; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.6",
            "verseOrgIds": [
              "GEN.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu abaanabe abasiani, nende abasiani babaanabe bosi, nabakhaanabe, nende abakhaana babaanabe, nende olwibulolwe lwosi, yeenjila ninalwo eMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.7",
            "verseOrgIds": [
              "GEN.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ameera kabaana baIsiraeli abeenjila eMisiri, Yakobo nende abaanabe abasiani, ngakano; mbu Reubeni, omwana wambeli waYakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.8",
            "verseOrgIds": [
              "GEN.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baReubeni; mbu Hanokhu, nende Palu, nende Yezeroni, nende Karami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.9",
            "verseOrgIds": [
              "GEN.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baSimeoni; mbu Yemuel, Yamini, Ohadi, Yakhini, Zohari, nende Shauli omwana womukhasi omuKananayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.10",
            "verseOrgIds": [
              "GEN.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baLawi; mbu Gerishoni, Kohatsi, nende Merari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.11",
            "verseOrgIds": [
              "GEN.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baYuda; mbu Eri, Onani, Shela, Faresi, nende Zera; habula Eri nende Onani bafwila mushialo shiaKanaani. Nabaana baFaresi nibo Hezeroni nende Hamuli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.12",
            "verseOrgIds": [
              "GEN.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baIsakhari; mbu Tola, Puwa, Iyobu, nende Shimironi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.13",
            "verseOrgIds": [
              "GEN.46.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 46:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baZabuloni; mbu Seredi, Eloni, nende Yaleeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.14",
            "verseOrgIds": [
              "GEN.46.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 46:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abaana baLea mukha Yakobo, aba yeebulila ePadanaramu, halala nende omwanawe omukhaana Dina; abandu bosi, abaanabe abasiani nende abakhaana, bali amakhumi kataru nabataru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.15",
            "verseOrgIds": [
              "GEN.46.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 46:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baGadi; mbu Zifioni, Habi, Shuni, Ezeboni, Eri, Arodi, nende Areli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.16",
            "verseOrgIds": [
              "GEN.46.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 46:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baAsheri; mbu Imina, Ishiwa, Ishiwi nende Beria, nende Sera omukhaana wabwe; nabaana baBeria, mbu Heberi nende Malakhieli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.17",
            "verseOrgIds": [
              "GEN.46.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 46:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abaana baZilipa, owa Labani yamuheelesia Lea omukhaanawe, ne bano nibo aba yamwibulila Yakobo, abandu ekhumi nabasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.18",
            "verseOrgIds": [
              "GEN.46.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 46:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baRaheli, omukhasi waYakobo; mbu Yusufu nende Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.19",
            "verseOrgIds": [
              "GEN.46.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 46:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu niyeebula Manase nende Efuraimu mushialo shiaMisiri, aba Asenati omukhaana waPotifera omwisaaliisi waOni yeebula. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.20",
            "verseOrgIds": [
              "GEN.46.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 46:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baBenyamini; mbu Bela, Bekheri, Ashabeli, Gera, Naamani, Ehi, Roshi, Mupimu, Hupimu, nende Aradi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.21",
            "verseOrgIds": [
              "GEN.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abaana baRaheli, aba Yakobo yeebula; abandu bosi bali ekhumi nabane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.22",
            "verseOrgIds": [
              "GEN.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baDani; mbu Hushimu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.23",
            "verseOrgIds": [
              "GEN.46.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 46:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nende abaana baNafutali; mbu Yazeeli, Guni, Yezeri, nende Shilemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.24",
            "verseOrgIds": [
              "GEN.46.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 46:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bano nibo abaana baBiliha owa Labani yaheelesia Raheli omukhaanawe, ne bano nibo aba yamwibulila Yakobo; abandu bosi bali musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.25",
            "verseOrgIds": [
              "GEN.46.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 46:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu bosi abeeniila halala nende Yakobo, abarula mundaye, aharali abakhasi babaana baYakobo, abandu bosi bali amakhumi kasasaba nabasasaba; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.26",
            "verseOrgIds": [
              "GEN.46.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabaana baYusufu, aba yeebulila eMisiri, bah abandu babili; abandu bosi abeinzu yaYakobo abeenjila eMisiri bah amakhumi musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakobo nabelitaalalie muMisiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 46:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.27",
            "verseOrgIds": [
              "GEN.46.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 46:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namuruma Yuda imbeliwe ewaYusufu, mbu amwibaalile injila imbeliwe, eyitsia mushibala shiaGosheni. Kho nibeenjila mushibala shiaGosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.28",
            "verseOrgIds": [
              "GEN.46.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 46:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu nakasia likaarilie ietsifarasi, natihulukha okhutsia okhubukaanila Isiraeli samwana okhuula eGosheni; niyeelolosia imbeliwe, namukwakhwo mwikosi, nalilila mwikosilie eshise eshikali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.29",
            "verseOrgIds": [
              "GEN.46.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 46:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Isiraeli nasunjila Yusufu mbu Bulaano efwe, shichila emalile okhulola mumonimwo, noshiliho mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.30",
            "verseOrgIds": [
              "GEN.46.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 46:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yusufu naboolela abaana babwe nende abomunzu yasanwana ari Ndalatikulukha enzie emuboolele Farao, nimusuniila mbu Abaana beefwe, nende abomunzu yapara, ababeelenje mushialo shiaKanaani, banzitsiile; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.46.31",
            "verseOrgIds": [
              "GEN.46.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 46:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne abasaatsa abo nabaayi, okhuba babeetsanga abaruchi bemiruko; nabo beetsile nende ebiayo biabwe, nende tsing'ombe tsiabwe, nende biosi ebia bali ninabio. ",
          "type": "text",
          "attrs": {
