    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukwa khwabandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inzokha yali injesichesi okhuyomba shia eshilamu eshiomushitsiimi eshia OMWAMI Nyasaye yali nalonjile. Niyireeba omukhasi yiri Nitoto, mbu Nyasaye yamubooleele mbu shimulaliitsangakhwo khushia omusaala kwosi okwomumukunda, ta? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhasi nakalusia inzokha ari Khubiamo biemisaala chiomumukunda, khuliitsenjekhwo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne khubiamo biomusaala okuli hakari womukunda, Nyasaye yasunjile ari Murabilia kata okhutiilakhwo tawe; mwakhafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzokha niyiboolela omukhasi yiri Okhufwa shimulafwa tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba Nyasaye yamanya mbu khunyanga eya mulaliakhwo, tsimoni tsieenywe tsilalaba, nimuba shinga Nyasaye, nimumanya amalayi nende amabii. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa omukhasi yalola omusaala nikuli omulayi khulwa ebiliibwa, khandi nikunyonya tsimoni, khandi mbu nomusaala okwenyekha khulwa okhuchesihasia, yabukulakhwo khubiamo biakwo, nalia; naheelesiakhwo omusaatsawe, yesi nalia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsimoni tsiabwe bombi tsialaba, nibamanya shinga olwa bali eshihechenye; nibanaba amasaafu kemikhuyu nibeeboha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibahulila omwoyo kwOMWAMI Nyasaye nachendanga mumukunda isi niyakhanyirakhwo; Adamu nende omukhasiwe nibeebisila OMWAMI Nyasaye mumisaala echiomumukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.8",
            "verseOrgIds": [
              "GEN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nalanga Adamu, namureeba ari Oli heena? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.9",
            "verseOrgIds": [
              "GEN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia ari Embuliile omwoyokwo mumukunda, niria, okhuba embeele eshihechenye; mananindibisa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.10",
            "verseOrgIds": [
              "GEN.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayenareeba ari Niwina oukhubooleele shinga olwa oli eshihechenye? Oliilekhwo khumusaala okwa ndakhukaania mbu oraliakhwo ta, noho? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.11",
            "verseOrgIds": [
              "GEN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu naye ari Omukhasi owa wambeelesia mbu khumenye ninaye, niye oumbeelesiye khumusaala, mana nindia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.12",
            "verseOrgIds": [
              "GEN.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nareeba omukhasi mbu Nelikhuwa shiina lino elia okholile? Omukhasi naboola ari Inzokha yingaatiye, nindia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.13",
            "verseOrgIds": [
              "GEN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye narumbulila inzokha mbu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.19",
            "verseOrgIds": [
              "GEN.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu namukulikha omukhasiwe eliira mbu Hawa, shichila niye nyinabwe bosi abali mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nabakasilia Adamu nende omukhasiwe ebiifwalo biamaseelo nabafwalakhwo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.21",
            "verseOrgIds": [
              "GEN.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI Nyasaye nasunga ari Lole, omundu uno yeekholile shinga mulala khwifwe, okhumanya obulayi nende obubii; ne bulaano, mbu aleshe okhunyiila omukhonokwe abukulekhwo nende khumusaala kwobulamu, nalia nayindila obushia nobushia; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.22",
            "verseOrgIds": [
              "GEN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho OMWAMI Nyasaye yamurusia mumukunda kwaEdeni, mbu alime liloba elia yarusibwamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.23",
            "verseOrgIds": [
              "GEN.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yeelusia omundu oyo; naraho abakerubi khulubeka Iwebukwe Iwomukunda kwaEdeni, khandi olumemu Iwomulilo shinga olukanga olushiukhananga tsimbeka tsiosi, okhulinda injila eyitsia hamusaala kwobulamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.24",
            "verseOrgIds": [
              "GEN.3.24"
            ]
          }
        }
      ]
    }
  ],
