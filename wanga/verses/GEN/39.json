        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufu nende mukha Potifa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yusufu yali niyayilwa eMisiri; mana Potifa, omukali waFarao, omwimilisi wabasikari, nomuMisiri, yali niyamukula mumukhono kwabo abaIshimaeli abali nibamuleerayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI yali nende Yusufu halala, amakhuwake kosi nikakaasa; mana naba munzu yomwamiwe omuMisiri oyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.2",
            "verseOrgIds": [
              "GEN.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwamiwe naye nalola mbu OMWAMI ali halala ninaye, khandi shinga OMWAMI olwa atsitsachisia kosi aka yakholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.3",
            "verseOrgIds": [
              "GEN.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nakoosibwa mumonimwe, namukhalabanila; naye namukhola okhuba omusinjilili wemilimo munzuye; ne buli shiosi eshia yali ninashio, nashira mumukhonokwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.4",
            "verseOrgIds": [
              "GEN.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu okhurula olwa yamukhola okhuba omusinjilili weinzuye, nende khubiosi ebia yali ninabio, OMWAMI nachiheelesia inzu yomuMisiri oyo ikhabi khulwa Yusufu; ikhabi yOMWAMI niyiba khubiosi ebia yali ninabio, munzu nende mumikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.5",
            "verseOrgIds": [
              "GEN.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabilekha biosi ebia yali ninabio mumukhono kwaYusufu; ne khulwako, shiyateebakhwo likhuwa khubia yali ninabio ta, habula ebiliibwa ebia yaliitsanga bionyene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu yali owelikondo lilayi, niyakaasa muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.6",
            "verseOrgIds": [
              "GEN.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyuma wamakhuwa ako, omukhasi womwamiwe yamurakhwo Yusufu imoni, namuboolela mbu Khukone ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.7",
            "verseOrgIds": [
              "GEN.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naloba, nasunjila omukhasi womwamiwe mbu Lola, omwami wanje shiamanyanga eshia endi ninashio munzu ta, khandi wara mumukhono kwanje biosi ebia ali ninabio; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.8",
            "verseOrgIds": [
              "GEN.39.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata ye omwene shiyashila obukhulundu munzu muno; shiyanzikaliile eshindu shiosi shiosi ta, habula iwe wenyene, shichila oli omukhasiwe; nasi ndakhanyala endie okhukhola obumayaanu buno, nimwonoonela Nyasaye? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.9",
            "verseOrgIds": [
              "GEN.39.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata olwa yasunjilanga Yusufu buli nyanga buli nyanga, ye shiyamufuchiilila mbu akone ninaye kata okhubuutsa ninaye tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.10",
            "verseOrgIds": [
              "GEN.39.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula inyanga yindi niyeenjila munzu okhukhola emilimochie, ne shiyalimwo omusaatsa undi yesi khubandu abomunzu omwo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.11",
            "verseOrgIds": [
              "GEN.39.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye natiila inguboye, nasunga mbu Khukone ninawe; naye nalekha inguboye mumukhonokwe, niyeelukha narula elwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.12",
            "verseOrgIds": [
              "GEN.39.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa omukhasi yalola shinga olwa amulesheele inguboye mumukhonokwe niyeeluushe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.13",
            "verseOrgIds": [
              "GEN.39.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 39:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho nalanga abandu abomunzuye, nababoolela mbu Lole, yakhuleereele omuHeburania okhukhufwola; yanzitsiile bulaano mbu akone ninasi, nasi nikhupa tsimbungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.14",
            "verseOrgIds": [
              "GEN.39.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 39:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa ahuliile ninjinga olukhu nikhupa tsimbungu, kho aleshile inguboye aha embeele, niyeelukha narula elwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.15",
            "verseOrgIds": [
              "GEN.39.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 39:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nabiikha inguboye aha yali okhuula olwa omwamiwe yachelela hango. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.16",
            "verseOrgIds": [
              "GEN.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namusunjila amakhuwa ako mbu Omukholi oyo omuHeburania owa wakhuleereele yanzitsiile okhu'fwola; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.17",
            "verseOrgIds": [
              "GEN.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa enjinjile olukhu nikhupa tsimbungu, kho nalekha inguboye aha embeele, niyeelukha narula elwanyi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 39:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.18",
            "verseOrgIds": [
              "GEN.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa omwamiwe yahulila amakhuwa aka omukhasiwe yamuboolela, ari Nolwa omukholiwo yakholeele; kho yatiilwa oburima. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
            "verseOrgIds": [
              "GEN.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omwamiwe yamubukula Yusufu namura mumbohe, habundu ewa ababohe bomuruchi babohungwa; nabayo mumbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.20",
            "verseOrgIds": [
              "GEN.39.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 39:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI naba halala nende Yusufu, namukholela akobuheeli oburalilu, nachila nakoosibwa mumoni tsiomulindi weimbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.21",
            "verseOrgIds": [
              "GEN.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulindi weimbohe naye nara ababohe bosi abali mumbohe mumukhono kwaYusufu; kata kosi akeekholangamwo, niye owakakholanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.22",
            "verseOrgIds": [
              "GEN.39.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 39:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omulindi weimbohe narahenga eshindu shiosi eshiali mumukhono kwaYusufu ta, shichila OMWAMI yali ninaye; ne aka yakhola, OMWAMI yakatsitsachisia bulayi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.23",
            "verseOrgIds": [
              "GEN.39.23"
            ]
          }
        }
      ]
    }
  ],
