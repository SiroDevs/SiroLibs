        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufuyeebuulila abaa na babwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 45:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habwene yaho Yusufu yakhaywa okhwisimilisia imbeli wa abo bosi abali nibasinjiile ahambi ninaye; nachinga omwoyo nasunga mbu Murusie shia omundu imbeli wanje. Ne shiyasinjilaho omundu yesi ahambi ninaye ta, olwa yeebuulila abaana babwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.1",
            "verseOrgIds": [
              "GEN.45.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 45:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nachinga olukhu nalila; abaMisiri nabo nibahulila, abomunzu yaFarao nabo bosi nibahulila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.2",
            "verseOrgIds": [
              "GEN.45.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu naboolela abaana babwe mbu Nisie Yusufu; papa ashili mwoyo noho? Ne kata abaana babwe nibaranyala okhumukalusiamwo ta; okhuba beeria muno imbeliwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 45:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.3",
            "verseOrgIds": [
              "GEN.45.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 45:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nasunjila abaana babwe mbu Sitekhwo ahambi. Nibasita ahambi. Naboola mbu Nisie Yusufu omwana weenywe, owa mwakusia eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.4",
            "verseOrgIds": [
              "GEN.45.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 45:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne murabeelela kata okhwisinyishila abeene khulwa okhungusia yino tawe; okhuba Nyasaye yanyimisia imbeli weenywe okhuhonia obulamu bwabandu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.5",
            "verseOrgIds": [
              "GEN.45.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 45:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba bulaano nemiyika chibili inzala niyiliho khushialo; khandi chihiliyo emiyika chiraano eehiranyala okhulimwa kata okhucheswa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.6",
            "verseOrgIds": [
              "GEN.45.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 45:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye yanyimisia imbeli weenywe okhumuhonia mube omusikalo mushialo, nende okhumuhonia mube mwoyo nende obuhonia obukali. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.7",
            "verseOrgIds": [
              "GEN.45.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 45:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiho bulaano shimuli inywe abanyimisia yino tawe, habula niNyasaye; ne niye owakhola okhuba shinga samwana Farao, khandi omwami owemekhwa munzuye, khandi omuruchi owemekhwa mushialo shiosi shiaMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.8",
            "verseOrgIds": [
              "GEN.45.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 45:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yanguhe, mutikulushe mutsie ewapapa, mumusunjile mbu Omwanawo Yusufu aboola mbu Nyasaye yakholile okhuba omwami waMisiri yosi; kho bulaano okholomoshe witse ewa endi, norashinda ta; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.9",
            "verseOrgIds": [
              "GEN.45.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omenye mushialo shiaGosheni, obeetsenje ahambi ninasi, iwe, nende abaanabo, nende abeetsukhulubo, nende ebiayobio, nende tsing'ombetsio, nende biosi ebia oli ninabio; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.10",
            "verseOrgIds": [
              "GEN.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne ndalakhuliisilinjia habwenaho; okhuba chishili emiyika chiraano chieinzala; mbu oleshe okhuhweelwa emiandu, iwe, nende litaalalio liosi, nende biosi ebia oli ninabio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.11",
            "verseOrgIds": [
              "GEN.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lole, tsimoni tsieenywe tsiluutsi, halala nende tsimoni tsiomwana weefwe Benyamini, mbu nomunwa kwanje isie okusungananga nineenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.12",
            "verseOrgIds": [
              "GEN.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mulatoonyela papa akoluyali lwanje lwosi eMisiri, nende kosi aka muluutsi; mwanguhe, muleere papa hano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.13",
            "verseOrgIds": [
              "GEN.45.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 45:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nakwa mwikosi liaBenyamini omusiani wabwe, nalila; naye Benyamini yesi nalilila mwikosi lilie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.14",
            "verseOrgIds": [
              "GEN.45.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 45:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsunzuuna abaana babwe bosi, nabalililakhwo; mana olunyumakhwo abaana babwe nibakhupa ninaye imbakha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.15",
            "verseOrgIds": [
              "GEN.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhuwa ako nikatswana nikahuliilikha munzu yaFarao, mbu Abaana babwe Yusufu beetsile. Nikaba amalayi imbeli waFarao nende imbeli wabakholibe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.16",
            "verseOrgIds": [
              "GEN.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao naye namuboolela Yusufu mbu Obasunjile abaana beenywe mbu Mukhole muri; mutuushe emiruko chieenywe emisiiko, murule mutsie mushibala shiaKanaani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.17",
            "verseOrgIds": [
              "GEN.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana mubukule seenywe, nende abomwitaala lieenywe, mwitse ewa endi yino; nasi ndalamuheelesia ebilayi ebiomushibala shiaMisiri, neenyu mulalia khubunulu bweshibala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.18",
            "verseOrgIds": [
              "GEN.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiho bulaano, okhulakwa olakwa; mukhole muri nanwa, mbu mubukule emakaari ketsing'ombe okhurula mushialo shiaMisiri khulwa abaana beenywe abatiiti nende abakhasi beenywe, muleere seenywe, mwitse ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.19",
            "verseOrgIds": [
              "GEN.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi murahendela emiandu chieenywe ta; okhuba ebilayi bieshialo shiosi shiaMisiri nebieenywe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.20",
            "verseOrgIds": [
              "GEN.45.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 45:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli nibakhola bario; Yusufu naye nabaheelesia amakaari, shinga Farao olwa yali nalachile, nabaheelesia nende ebiliibwa biokh unjila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.21",
            "verseOrgIds": [
              "GEN.45.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 45:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bosi yabaheelesia buli mundu ebiifwalo bindi ebiyiakha; ne Benyamini, yamuheelesia tsifeetsa ebikhumi bitaru nende tsingubo tsimbiakha shikharaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.22",
            "verseOrgIds": [
              "GEN.45.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 45:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khusamwana yamukoobela ebindu bino, mbu tsisishili ekhumi etsiachinga ebindu ebilayi biaMisiri, khandi nende tsisishili tsikhasi ekhumi etsiachinga imelel nemikaate nende ebiliibwa, ebia samwana aliila khunjila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.23",
            "verseOrgIds": [
              "GEN.45.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 45:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho naseebula abaana babwe, nabo nibatsia; nababoolela mbu Muleshe okhusoolanila khunjila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.24",
            "verseOrgIds": [
              "GEN.45.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 45:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatikulukha okhurula eMisiri, niboola mushibala shiaKanaani, ewaYakobo saabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.25",
            "verseOrgIds": [
              "GEN.45.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 45:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuboolela bari Yusufu ashili mwoyo okhuula bulaano, ne niye omwami owemekhwa mushibala shiosi shiaMisiri. Naye nafwa omwoyo, shichila shiyasuubila aka baboola ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.26",
            "verseOrgIds": [
              "GEN.45.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 45:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamutoonyela amakhuwa kosi akaYusufu, aka yali nasungaane ninabo; mana olwa yalola amakaari aka Yusufu yali nakoobileyo mbu kamubukule, omwoyo kwaYakobo saabwe nikukalukha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.27",
            "verseOrgIds": [
              "GEN.45.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 45:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isiraeli naboola mbu Kambelile; Yusufu omwana wanje ashili mwoyo; nenzie endolane ninaye nishili okhufwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.45.28",
            "verseOrgIds": [
              "GEN.45.28"
            ]
          }
        }
      ]
    }
  ],
