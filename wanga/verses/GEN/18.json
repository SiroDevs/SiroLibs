      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obusuubisie bwaNyasaye, mbu Isaka yakheebulwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuloleshela ahambi nende emiruba chieMamure, olwa yali niyeekhaale mumuliango weliheema mushise shiomubasu omunji kweshiteere; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.1",
            "verseOrgIds": [
              "GEN.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nachinguula tsimonitsie nahenga, ne lola, abasaatsa bataru mbabo, nibasinjiile imbeliwe; nolwa yabalola yarula mumuliango kweliheema natsia tsimbilo okhubaakaanila, niyeenama hasi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasunga mbu Omwami, nimba ninyoolile obukoosia mumonitsio, chama orambirakhwo isie omusumbawo tawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.3",
            "verseOrgIds": [
              "GEN.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "chama amatsi kaleerwe, mwiyosie ebilenje, nimuhuluukha mumusaala kuno; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.4",
            "verseOrgIds": [
              "GEN.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nasi ndalaleerakhwo eshiliibwa eshitiiti, munyoole amaani; kho mana mutsie; okhuba mwitsile ewomusumba weenywe. Nabo nibasumga bari Khola orio, shinga olwa osunjile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.5",
            "verseOrgIds": [
              "GEN.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu niyeenjila bwangu mwiheema ewa Sara yali, namusunjila ari Kasia bwangu emichelo chitaru chiobusie obunyushe, onyoobe, oteeshe emikaate. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.6",
            "verseOrgIds": [
              "GEN.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu natsia tsimbilo mubiayo niyeendamwo eshimoosi shieinyama indoro indayi namuheelesia omukhalabani; naye niyaanguyilisia okhushikasia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.7",
            "verseOrgIds": [
              "GEN.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabukula amabeele ketsikubuli khandi nende amabeele amayiu, nende inyama yeshimoosi eshia yali niyakhakasia, narenjekha imbeli wabwe; naye omwene nasinjila ahambi ninabo mumusaala, nabo nibalia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.8",
            "verseOrgIds": [
              "GEN.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamureeba mbu Omukhasiwo Sara ali heena? Naye nasunga ari Ngwowulia, mwiheema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
              "GEN.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naboola mbu Toto isie ndilikhukalushila olwa eshise shiliula; ne lola, Sara omukhasiwo aliba nende omwana omusiani. Ne Sara yahulila, nali inyumawe mumuliango weliheema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Aburahamu nende Sara bali nibakofuule, khandi nibayindiile emiyika eminji; khandi kali nikaleshile okhwikhola khuSara shinga eshiima shiabakhasi olwa shili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Sara natsekha omwene yenyene, ari Nasi olwa emalile okhukofula, kho ndakhanyoole obusangaali, omwami wanje naye nali omusaakhulu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Aburahamu mbu Nishiina eshichila Sara natsekha, ari Nasi ndakheebule omwana toto, nindi omushiele? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liliho likhuwa liosi litinyu eliakhamukhaya OMWAMI? Khunduukho eyo ndilikhukalushila, eshise nishiulile; naye Sara aliba nende omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sara niyeeyambakhana, ari Shinzeshilekhwo tawe; shichila yaria. Naye nasunga mbu Tawe; otseshile.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aburahamu yasabila Sodomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abasaatsa abo nibabuukha aha bali, nibahenjia tsimoni tsiabwe eSodomu; Aburahamu naye nachenda ninabo nabakooba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
            "verseOrgIds": [
              "GEN.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunga ari Mana emubise Aburahamu aka enzitsa okhukhola, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "olwa Aburahamu aliba lihanga likhongo liamaani, khandi mbu amahanga kosi keshibala kalinyoola ikhabi muye, nohomba? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.18",
            "verseOrgIds": [
              "GEN.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba emumanyile, mbu mana aruchenje abaanabe nende abomwitaalalie inyumawe, mbu balinde injila yOMWAMI, okhukhola akobulunji nende akobuyaasii, mbu mana OMWAMI amuleerela Aburahamu ako aka yasunga khuye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunga mbu Okhuba tsimbungu tsiaSodomu nende Gomora netsikhongo muno, khandi okhuba obwonooni bwabwe nobubii muno; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ndalakholomokhayo bulaano, endole nibaba nibakholile toto shinga amalilo kabwe olwa kali akanzitsiile; ne nikarali kario ta, khandi emanye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasaatsa abo nibashiukhana okhurula yaho nibachooma khulubeka IweSodomu; ne Aburahamu yali nashisinjiile imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu nasita ahambi, nasunga mbu Wakhasisia abalunji halala nende abamayaanu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haundi bakhabamwo abalunji amakhumi karaano mwitookho; wakhasisia oburahonia litaala elo tawe khulwabo abalunji amakhumi karaano abalimwo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako shikanyalikha khwiwe ta, mbu okhwira abalunji halala nende abamayaanu, mbu mana abalunji babe abalala nende abamayaanu, ako shikanyalikha khwiwe ta; mbula, Omuyaasii weshialo shiosi shialakhola akali habwene? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola mbu Nimba ninyoola muSodomu abandu abalunji amakhumi karaano mwitaala, kho ndalalekha habundu yaho hosi khulwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu namukalusia, nasunga ari Kho bulaano enjaachile okhusungana nende Omwami, olwa endi olufu butswa nende likoshe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "haundi bakhalemakhwo baraano khumakhumi karaano abalunji; wakhamulula litaala liosi khulwa okhulema baraano? Naye nasunga mbu Shindalalimulula tawe, nimba ninyoolayo amakhumi kane nabaraano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi namuboolela ari Haundi bakhanyoolekhamwo amakhumi kane. Naye nasunga ari Shindalakholakhwo khulwabo amakhumi kane tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi naboola mbu Omwami arasinyishila ta, ndalasungakhwo; haundi bakhanyoolekhamwo amakhumi kataru. Naye nasunga ari Shindalakholakhwo nimba ninyoolayo amakhumi kataru ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.30",
            "verseOrgIds": [
              "GEN.18.30"
            ]
          }
        },
        {
          "name": "verse",
