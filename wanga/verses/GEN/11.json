          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelegi nayindila emiyika ebikhumi bibili nende shienda niyeebuule Reu, niyeebula abaana abasiani nende abakhaana.",
          "type": "text",
          "attrs": {
