          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Eberi yayindila emiyiKa amaKnuml kataru nende chine, niyeebula Pelegi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.16",
            "verseOrgIds": [
              "GEN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eberi nayindila emiyika ebikhumi bine nende amakhumi kataru niyeebuule Pelegi, niyeebula abaana abasiani nende abakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.17",
