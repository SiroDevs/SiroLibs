          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsiaTera tsiahela emiyika ebikhumi bibili nende chiraano; mana Tera yafwila eHarani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.32",
