              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Tera yabukula Aburamu omwanawe, nende Loti omwana waHarani, omwitsukhuluwe, nende Sarai nyakhufialanyene, omukhasi waAburamu omwanawenarula ninabo muUru yabaKalidayo, okhutsia mushibala shiaKanaani; niboola eHarani, nibamenyaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.31",
            "verseOrgIds": [
              "GEN.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
