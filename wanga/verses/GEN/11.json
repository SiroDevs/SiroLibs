          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shela nayindila emiyika ebikhumi bine nende chitaru niyeebuule Eberi, niyeebula abaana abasiani nende abakhaana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.15",
            "verseOrgIds": [
              "GEN.11.15"
            ]
