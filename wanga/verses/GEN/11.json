    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omunaara kwaBabeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eshibala shiosi shialinji shiolulimi lulala khandi okhuboola khulala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.1",
            "verseOrgIds": [
              "GEN.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibachendanga nibatsia ebukwe banyoola omuhololookhwe mushialo shiaShinari; nibamenyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.2",
            "verseOrgIds": [
              "GEN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasungana abeene bari Chende khulonje amatofali nende okhukasamba bulayi. Kho bali nende amatofali mushilenje shiamachina, khandi ilami niyo eyali litoyi liabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.3",
            "verseOrgIds": [
              "GEN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaboola bari Chende khuumbashe olukala, nende omunaara okwa obutenje bwakwo buule mwikulu, mana khwinyoolele abeene eliira; mbu khuleshe okhusalaasibwa hosi hosi khushibala shiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.4",
            "verseOrgIds": [
              "GEN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI niyeekha mbu alole olukala nende omunaara ebia abaana babandu bali niboombakhanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.5",
            "verseOrgIds": [
              "GEN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboola ari Lola, nabandu balala, bosi bali nende olulimi lulala; kho nolwa bachaaka okhukhola; shibaliba nende likhuwa elia beenya okhukhola mana bakaywe tawe, khukosi aka bareelekhwo omwoyo okhukhola. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.6",
            "verseOrgIds": [
              "GEN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chende khwishe khukoyaasie olulimi lwabwe, mbu baleshenje okhuhulilisania okhuboolana khwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.7",
            "verseOrgIds": [
              "GEN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI nabasalaasia okhutula yaho mushialo shiosi; nibalekha okhuumbakha olukala tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.8",
            "verseOrgIds": [
              "GEN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niko akachila nilukulikhwa eliira mbu Babeli; okhuba yaho niho aha OMWAMI yakoyaasilia olulimi Iweshialo shiosi; nokhurula yaho OMWAMI yabasalaasia mushialo shiosi pe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsinzibulo tsiaShemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.9",
            "verseOrgIds": [
              "GEN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsino nitsio tsinzibulo tsiaShemu; Shemu yali owemiyika eshikhumi, niyeebula Arapakhashadi emiyika chibili inyuma womuyembo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Shemu yayindila emiyika ebikhumi biraano niyeebuule Arapakhashadi, niyeebula abaana abasiani nende abakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Arapakhashadi yayindila emiyika amakhumi kataru nachiraano, niyeebula Shela; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arapakhashadi nayindila emiyika ebikhumi bine nende chitaru niyeebuule Shela, niyeebula abaana abasiani nende abakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
            "verseOrgIds": [
              "GEN.11.13"
            ]
          }
        }
      ]
    },
    {
