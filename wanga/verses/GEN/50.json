      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 50:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu namukwakhwo samwana mubweni, namulililakhwo, namutsunzuuna. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabalaka abasumbabe abasilishi mbu bamubashe samwana emisaaia, omulambo kuleshe okhubola; abasilishi nabo nibamubakha Isiraeli emisaala bario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana tsindaalo amakhumi kane tsiahwa khululwe; shichila nolwa tsindaalo tsiokhubakha emisaala echio tsiamalungwa; abaMisiri nabo nibamulilila tsindaalo amakhumi musaafu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 50:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsiamasika olwa keeya, Yusufu yasungana nende abomunzu yaFarao, mbu Nimba ninyoolile obukoosia imbeli weenywe, nimuchama musunjile Farao muri nanwa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Papa yanditsubia, mbu Lola, isie efwa; mung'ani yanje eya ndeeyabila mushialo shiaKanaani, nimwo omwa olanzabila muyo. Kho bulaano ekhusaaya mbu umbeelesie obwiyango endikulushe enzie emuyabile papa, ne khandi nenjelele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao naboola mbu Otsie, omuyabile so, shinga olwa yakhwitsubia.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 50:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yusufu yatikulukha natsia okhumuyabila samwana, abasumba bosi baFarao nibatikulukha halala ninaye, nabakofu bomunzuye, nende abakofu bosi abomushibala shiaMisiri, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.7",
            "verseOrgIds": [
              "GEN.50.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 50:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende abomunzu yaYusufu bosi, nende abaana babwe, nende abomunzu yasamwana; habula abaana abatiiti nende ebiayo nende tsing'ombe, babilekha mushialo shiaGosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.8",
            "verseOrgIds": [
              "GEN.50.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 50:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatikulukha ninaye abachendela khutsifarasi, nende amakaari; nikuba omukanda omukhongo muno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.9",
            "verseOrgIds": [
              "GEN.50.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 50:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niboola khulutse lwaAtadi injelekha weYorodani, nibeekhuulilayo nibakhupa tsimbungu tsinyinji muno; naye nakholayo amasika kasamwana tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.10",
            "verseOrgIds": [
              "GEN.50.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 50:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa abeene shialo, nibo abaKanaani, balola amasika mulutse lwaAtadi, baboola mbu Amasika kano kabaMisiri namakali muno; nibakulikha eliira liahabwenaho mbu Abeli-misiraimu, injelekha weYorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.11",
            "verseOrgIds": [
              "GEN.50.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 50:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaanabe nibamukholela kosi shinga olwa yabalaka; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.12",
            "verseOrgIds": [
              "GEN.50.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 50:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba abaanabe bamuchinga nibamukalusia mushibala shiaKanaani nibamuyabila mumbinga yomukunda kwaMakhapela, okuli imbeli waMamure, eya Aburahamu yakula halala nende omukunda khuEferoni omuHiti, kube okukwe khulwa ebilindwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.13",
            "verseOrgIds": [
              "GEN.50.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu nakalukha eMisiri, ye omwene, nende abaana babwe, nende bosi aba yatikulukha ninabo okhumuyabila samwana, olwa yali namalile okhumuyabila samwana.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yusufu yabalemia abaana babwe omwoyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 50:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.14",
            "verseOrgIds": [
              "GEN.50.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 50:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana babwe Yusufu olwa balola mbu saabwe wafwile, baboola mbu Haundi Yusufu alakhukiya, nakhurunjila elala amabii kosi aka khwamukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.15",
            "verseOrgIds": [
              "GEN.50.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 50:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuupila Yusufu omunwa okhusunga mbu So olwa yali nashili okhufwa yalaka mbu ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.16",
            "verseOrgIds": [
              "GEN.50.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 50:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musunjile Yusufu muri Ekhusaaya mbu bulaano obaleshele abaana beenywe okhuyiira khwabwe, nende obwonooni bwabwe, shinga olwa bakhukholela obubii; kho bulaano khukhusaaya mbu okhuleshele ifwe abasumba baNyasaye waso obuyiiri bweefwe. Naye Yusufu nalila amasika olwa basungana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.17",
            "verseOrgIds": [
              "GEN.50.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 50:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana babwe nabo nibatsia nibeekhupa hasi imbeliwe; nibaboola mbu Lola, nifwe abasumbabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.18",
            "verseOrgIds": [
              "GEN.50.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 50:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabasunjila mbu Muraria tawe; isie endi mushilenje shiaNyasaye noho? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.19",
            "verseOrgIds": [
              "GEN.50.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 50:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inywe, mwachooma okhukholela obubii; ne Nyasaye yakachoomia khubulayi, okhuusia akaliho leelo, okhuhonia abandu abanji babe mwoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.20",
            "verseOrgIds": [
              "GEN.50.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano muraria ta; ndalamuliisinjia halala nende abaana beenywe abatiiti. Nabalemia emioyo, nasungana ninabo neshisa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaYusufu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 50:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.21",
            "verseOrgIds": [
              "GEN.50.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 50:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yusufu yamenya eMisiri, ye omwene nende abeinzu yasamwana. Yusufu nayindila emiyika eshikhumi nende ekhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.22",
            "verseOrgIds": [
              "GEN.50.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 50:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nalola abaana baEfuraimu okhuula khulwibulo lwakhataru; abaana baMakiri omwana waManase nabo nibeebulwa mumakulu kaYusufu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.23",
            "verseOrgIds": [
              "GEN.50.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 50:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabasunjila abaana babwe mbu Isie efwa; ne Nyasaye shialichweya okhumukoonya ta, namutikulusia namurusia mushialo shino okhuula mushialo eshia yabasuubisia Aburahamu, nende Isaka, nende Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.24",
            "verseOrgIds": [
              "GEN.50.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 50:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabeetsubia abaana baIsiraeli, naboola mbu Nyasaye shialichweya okhumukoonya tawe, neenyu mulitikulukha nende amakumba kanje okhukarusia yino. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.25",
            "verseOrgIds": [
              "GEN.50.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 50:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yusufu nafwa, nali owemiyika eshikhumi nende ekhumi; nibamubakhakhwo emisaala, omulambo kuleshe okhubola, mana nareebwa mwisanduku eMisiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.26",
            "verseOrgIds": [
              "GEN.50.26"
            ]
          }
        }
      ]
    }
  ],
