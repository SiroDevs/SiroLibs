          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukhaana omukhulundu namusunjila omushe mbu Seefwe bulaano nomukofu, ne kata abulaho omusaatsa yesi mushibala ounyala okhuba nineefwe shinga eshiima shieshibala shiosi olwa shili; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "chenda khumuheelesie seefwe idivai anywe, mana khulakona ninaye, mbu mana khwisinjisilie olwibulo okhurula khuseefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibamuheelesia saabwe idivai eshilo shieneshio; oyo omukhulundu niyeenjila, nakona nende samwana; naye samwana naramanya olwa omukhaanawe yakona kata olwa yabuukha ta ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mukamba omukhulundu namusunjila omushe ari Isie ndakonile nende seefwe eshilo eshiabeele; khumuheelesie idivai khandi eshilo shialeelo shino; nawe winjile okone ninaye, mbu mana khwisinjisilie olwibulo okhurula khuseefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuheelesia saabwe idivai eshilo shieneshio khandi; omushe oyo natsia nakona ninaye; naye samwana naramanya olwa omukhaanawe yakona kata olwa yabuukha tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abakhaana baLoti bombi babili nibabelekha khulwa saabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhulundu niyeebula omwana omusiani namukulikha eliira mbu Moabu; omwenoyo niye omwibuli wabaMoabu abaliho okhuula bulaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omushe yesi niyeebula omwana omusiani namukulikha eliiralie mbu Benami; ne niye omwibuli wabaana baAmoni abaliho okhuula bulaano.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
