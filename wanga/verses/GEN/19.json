          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Loti natikulukha narula eZoari, natsia namenya mushikulu, nende abaanabe abakhaana babili halala ninaye; okhuba yariitsanga okhumenya eZoari; ne yamenya mumbinga, ye nende abaanabe abakhaana babili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
