    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaana babwe Yusufu beetsa eMisiei okhurunda imele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yakobo yalola mbu imele yiliyo eMisiri; mana Yakobo nasunjila abaanabe ari Mukhahengananga murie? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.1",
            "verseOrgIds": [
              "GEN.42.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboola mbu Lole, embuliile shinga imele olwa yiliyo eMisiri; kholomosheyo, mukhurundile; mbu khube abalamu, nikhurafwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.2",
            "verseOrgIds": [
              "GEN.42.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaana babwe Yusufu ekhumi nibakholomokha eMisiri okhurunda imele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.3",
            "verseOrgIds": [
              "GEN.42.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Benyamini, owomwabo Yusufu, Yakobo shiyamuruma halala nende abaana babwe ta; okhuba yaboola mbu Haundi yakhanyoola amabii. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.4",
            "verseOrgIds": [
              "GEN.42.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaana baIsiraeli nibeetsa okhurunda mubeenabo abeetsangayo; okhuba yaliho inzala mushibala shiaKanaani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.5",
            "verseOrgIds": [
              "GEN.42.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yusufu yali omwami weshibala; neniye owabakusinjia bosi abeshibala eshio ebiokhulia; mana abaana babwe Yusufu nibeetsa nibeenama hasi imbeiiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.6",
            "verseOrgIds": [
              "GEN.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yusufu nalola abaana babwe, nabamanya, naye niyeefwayafwayia shinga ourabamanyile ta, nasungana ninabo obutinyu; nabareeba mbu Murulile heena? Nabo nibaboola bari Khurulile mushialo shiaKanaani; khwitsile okhurunda ebiliibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.7",
            "verseOrgIds": [
              "GEN.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabamanya abaana babwe, nabo nibaramumanya ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.8",
            "verseOrgIds": [
              "GEN.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu niyeetsulila amalooro aka yaloora khubo, nabasunjila mbu Muli abaluuri; okhukoonya eshialo shinga olwa shili eshikhaya nikhwo okhuchila nimwitsile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.9",
            "verseOrgIds": [
              "GEN.42.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusunjila mbu Tawe, omwami, ne okhurunda ebiliibwa nikhwo okhuchilile abasumbabo nibeetsa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.10",
            "verseOrgIds": [
              "GEN.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifwe fwesi khuli abaana bomundu mulala; khuli abandu batoto; abasumbabo shibali abaluuri ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.11",
            "verseOrgIds": [
              "GEN.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nababoolela ari Tawe; ne okhulola eshialo shinga olwa shili eshikhaya nikhwo okhuchilile nimwitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.12",
            "verseOrgIds": [
              "GEN.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasunga mbu Ifwe abasumbabo khuli abaana ekhumi nababili bomundu mulala mushialo shiaKanaani; ne lola, omushe weefwe ali nende seefwe leelo; ne mulala shialiyo tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.13",
            "verseOrgIds": [
              "GEN.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yusufu nabasunjila ari Kali butswa shinga olwa emusunjiile; mbu muli abaluuri inywe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.14",
            "verseOrgIds": [
              "GEN.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nolwa mulamanyikha; mbula, Farao nafwile! Nebutswa shimularula hano omwana weenywe omushe nashili okhwitsa tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.15",
            "verseOrgIds": [
              "GEN.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rume mulala khwinywe atsie, amwende omusiani weenywe, ne abandi mulabohwe, okhuula amakhuwa keenywe olwa kalamanyikha, nimuli abatoto nohomba; nebutswa, nikarali kario ta, shinga Farao olwa ali mwoyo shimuchweyakhwo okhuba abaluuri ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.16",
            "verseOrgIds": [
              "GEN.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabara bosi mundindi tsindaalo tsitaru.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.17",
            "verseOrgIds": [
              "GEN.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yakhataru Yusufu yabasunjila mbu Khole muri nanwa, kho mulahona; okhuba isie emuriitsanga Nyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.18",
            "verseOrgIds": [
              "GEN.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuba nimuli abandu batoto, omusiani weenywe mulala abohwe munzu yeindindi eya mwaboyilwemwo; neenyu mutsie, muyile imele khulwa obutakha bwomunzu tsieenywe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.19",
            "verseOrgIds": [
              "GEN.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundeerele omwana weenywe omushe; kho obwatieri bwamakhuwa keenywe bulamanyikha, muleshe okhufwa. Nibakhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.20",
            "verseOrgIds": [
              "GEN.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasungana abeene bonyene bari Toto mwene, khuli nende eshiina khumakhuwa komwana weefwe; mbu khwalola amasila akomumwoyokwe olwa yakhusaayanga, nikhukhaya okhumuhulila; niko akachila amasila kano nikakhukwila. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.21",
            "verseOrgIds": [
              "GEN.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni nabakalusia ari Shindamusunjila ndi Muramwonoonela omwana; nimukhaya okhuhulila, ta? Niko akachila lole, aunabangake nako kabanzwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.22",
            "verseOrgIds": [
              "GEN.42.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shibamanya shinga Yusufu olwa yabahulilanga ta; shichila yaliho omutafutal hakari wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.23",
            "verseOrgIds": [
              "GEN.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye niyeekwenya elubeka, nalila amasika; mana nakalukha, nasungana ninabo; mana niyaahula Simeoni mubo, namuboha imbeli wabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.24",
            "verseOrgIds": [
              "GEN.42.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yusufu nalaka mbu beetsusie imele mubichinjilo biabwe, nende okhukalusia amapeesa kabuli mundu mwikunialie, nokhubaheelesia ebiliibwa biokhunjila; nolwa bakholelwa bario.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abaana babwe Yusufu bakalukha ebuKanaani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.25",
            "verseOrgIds": [
              "GEN.42.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 42:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibatuukha tsisishili tsiabwe imele, nibahwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.26",
            "verseOrgIds": [
              "GEN.42.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 42:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mulala khubo olwa yeekula likunialie okhuliisia isishiliye habundu ewa bakona, yeetsukhana nalola amapeesake nikali mumunwa kwelikunia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.27",
            "verseOrgIds": [
              "GEN.42.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila abaana babwe mbu Amapeesa kanje kakalusiibwe; lole, ngakano mwikunia lianje; mana nibafwa omwoyo, nibahengana nibachaaka okhutechela, nibasunga bari Nelikhuwa shiina lino elia Nyasaye akhukholeele?",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 42:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.28",
            "verseOrgIds": [
              "GEN.42.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 42:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho niboola ewaYakobo saabwe mushialo shiaKanaani, nibamuboolela kosi akali nikabeekholeele; nibaboola bari ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.29",
            "verseOrgIds": [
              "GEN.42.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 42:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omusaatsa tsana, omwami weshibala eshio, yasungana nineefwe amakhuwa amatinyu, nakhukulikha mbu abaluuri beshialo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.30",
            "verseOrgIds": [
              "GEN.42.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 42:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Neefu khwamuboolela mbu Khuli abandu abatoto; shikhuli abaluuri ta. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.31",
            "verseOrgIds": [
              "GEN.42.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 42:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khuli abasiani ekhumi nababili bomundu mulala; mulala shialiho ta, ne omushe ali halala nende seefwe leelo mushialo shiaKanaani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.32",
            "verseOrgIds": [
              "GEN.42.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 42:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo, omwami weshibala, nakhusunjila mbu Khwikhuwa lino kho nemumanyilekhwo, nimuba nimuli abandu abatoto; mbu muleshe omwana weenywe mulala ewanje yino, muyile imele khulwa obutakha bwomumataala keenywe, mutsie butsia; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.33",
            "verseOrgIds": [
              "GEN.42.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 42:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "mundeerele omwana weenywe omushe; kho ndalamanya mbu shimuli abaluuri ta, ne mbu muli abandu abatoto; mana ndalamuheelesia omwana weenywe, neenyu mulakholanga obukhala mushialo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        }
      ]
