        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.34",
            "verseOrgIds": [
              "GEN.42.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 42:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa batsukha ebiali mumakunia kabwe, lola, liboho liabuli mundu liamapeesake liali mwikunialie; mana olwa balola, halala nende saabwe, amaboho kamapeesa kabwe, baria. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.35",
            "verseOrgIds": [
              "GEN.42.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 42:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo saabwe nabasunjila ari Khulweenywe efwilwa abaana banje; Yusufu shialiho ta, khandi Simeoni shialiho ta; khandi mwenya okhuyila Benyamini yesi; amakhuwa kano kosi kanziiranga obubii. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.36",
            "verseOrgIds": [
              "GEN.42.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 42:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reubeni namuboolela samwana ari Onyala okhwira abaana banje babili, nimba nindamukalusia khwiwe ta; omuhaane mumukhono kwanje, nasi ndilimukalusia khwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.37",
            "verseOrgIds": [
              "GEN.42.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 42:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye naboola mbu Omwana wanje shialakholomokha nineenywe tawe; okhuba omwana wabwe yafwa, ne niye yenyene owatong'a; naba nanyoola amabii khuiljila eya mutsiilakhwo, kho mwakheesia tsimbutsi tsianje eMakombe namasila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.42.38",
            "verseOrgIds": [
              "GEN.42.38"
            ]
          }
        }
