              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nalikulikha eliira mbu Sheba; khulwa elo eliira lielitaala elo niBeerisheba okhuula leelo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.33",
