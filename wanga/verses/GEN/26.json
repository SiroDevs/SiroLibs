          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibahuuna mumabwibwi, nibeetsubilana; mana Isaka naseebulana ninabo, nibarula ewuwe nomulembe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.31",
