{
  "id": "GEN.30",
  "number": "30",
  "bookId": "GEN",
  "reference": "Genesis 30",
  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "GEN 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho olwa Raheli yalola mbu shiyeebula abaana ba, Raheli yatiililwa omukhaana wabwe imbalikha; naboolela Yakobo ari Mbeelesia abaana; nebutswa ndakhafwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.1",
            "verseOrgIds": [
              "GEN.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo nasinyishila Raheli; naboola mbu Nasi endi mushilenje shiaNyasaye, owakhwima olwibulo noho? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.2",
            "verseOrgIds": [
              "GEN.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raheli namuboolela ari Lola, omukholi wanje Biliha ngwowuno; omuteeshie mbu mana yeebulile khumakulu kanje, nasi enyumbashilwe khululwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.3",
            "verseOrgIds": [
              "GEN.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namuha Biliha omukholiwe mbu abe omukhasiwe; mana Yakobo namuteeshia. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.4",
            "verseOrgIds": [
              "GEN.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Biliha nahela inda, niyeebula omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.5",
            "verseOrgIds": [
              "GEN.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raheli naboola mbu Nyasaye yayaasiye habwene; yahuliile omwoyo kwanje; yambeele omwana omusiani; khulwako namukulikha eliira mbu Danj ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.6",
            "verseOrgIds": [
              "GEN.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biliha omukholi waRaheli nahela inda khandi, niyeebula omwana omusiani wakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.7",
            "verseOrgIds": [
              "GEN.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raheli naboola mbu Enwanile nende omukhaana weefwe libwi likhongo, nimukoka; kho namukulikha eliira mbu Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.8",
            "verseOrgIds": [
              "GEN.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea olwa yalola mbu wasinjila okhwibula, nabukula Zilipa omukholiwe, namuheelesia Yakobo mbu abe omukhasiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.9",
            "verseOrgIds": [
              "GEN.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Zilipa omukholi waLea niyeebula omwana omusiani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.10",
            "verseOrgIds": [
              "GEN.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea naboola mbu Ikhabi indayi! Namukulikha eliira mbu Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.11",
            "verseOrgIds": [
              "GEN.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zilipa omukholi waLea niyeebula omwana omusiani owakhabili. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.12",
            "verseOrgIds": [
              "GEN.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea naboola mbu Esangaalile! Okhuba abakhasi balananga mbu omusangaafu; namukulikha eliira mbu Asheri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.13",
            "verseOrgIds": [
              "GEN.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mundaalo tsielichesa lieingano Reubeni yatsia nanyoola tsinduli mubulimo, naleerela Lea nyina. Kho Raheli nasaba Lea ari Umbekhwo khunduli tsiomwanawo etsio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.14",
            "verseOrgIds": [
              "GEN.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye namukalusia ari Kho oluutsi mbu nelikhuwa lituutu okhunuula omusaatsa wanje? Kho khandi unuule nende tsinduli tsiomwana wanje? Raheli nasunga ari Kho alakona ninawe eshilo shiolwa leelo khulwa tsinduli tsiomwanawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.15",
            "verseOrgIds": [
              "GEN.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo narula mumukunda nibwilile; Lea natsia okhumubukaanila, naboola mbu Okhoyile okhwinjila ewanje, okhuba ekhukulile tsinduli tsiomwana wanje; kho nakona ninaye eshilo shieneshio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.16",
            "verseOrgIds": [
              "GEN.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye narechela Lea amarwi, naye nahela inda niyeebula omwana omusiani wakharaano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.17",
            "verseOrgIds": [
              "GEN.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea naboola mbu Nyasaye yambeelesiye omurungo kwanje, shichila ndamuheelesia omusaatsa wanje omukholi wanje; namukulikha eliira mbu Isakhari. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.18",
            "verseOrgIds": [
              "GEN.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea nahela inda khandi, niyeebula omwana omusiani wakhasasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.19",
            "verseOrgIds": [
              "GEN.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lea naboola ari Nyasaye yayamanusiye ebimanusio ebilayi; bulaano omusaatsa wanje alamenyanga ninasi, okhuba ndamwibuliile abaana basasaba; namukulikha eliira mbu Zabuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.20",
            "verseOrgIds": [
              "GEN.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolunyumakhwo niyeebula omwana omukhaana, namukulikha eliira mbu Dina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.21",
            "verseOrgIds": [
              "GEN.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Nyasaye yali niyeetsulilanga Raheli namurechela eshirwi, namwikula olubeleshelo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.22",
            "verseOrgIds": [
              "GEN.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "naye nahela inda, niyeebula omwana omusiani; nasunga mbu Nyasaye yandusiyekhwo tsisoni; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.23",
            "verseOrgIds": [
              "GEN.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "namukulikha eliira mbu Yusufu; ari OMWAMI yameetekhwo omusiani undi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aka Yakobo yalakana nende Labani khukomurungokwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.24",
            "verseOrgIds": [
              "GEN.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Raheli yali niyeebuule Yusufu, Yakobo yaboolela Labani ari Useebule, enzie eweefwe, mushibala shieefwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.25",
            "verseOrgIds": [
              "GEN.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbeelesie abakhasi banje nende abaana banje aba ndakhukholela khulwabo, mbu enzie; okhuba Gmanyile obukholi bwanje shinga olwa ndakhukholela. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.26",
            "verseOrgIds": [
              "GEN.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani namuboolela mbu Shinyoolile obukoosia mumonitsio? Okhuba endolanga shinga OMWAMI olwa yambeelesiye ikhabi khululwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.27",
            "verseOrgIds": [
              "GEN.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naboola mbu Mboolela omurungokwo okwa wenya, nasi nekhuheelesie. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.28",
            "verseOrgIds": [
              "GEN.30.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 30:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nakalusia mbu Iwe omwene omanyile shinga olwa ndakhukholeele, khandi shinga emirukochio olwa chiakaasile nindi ninachio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.29",
            "verseOrgIds": [
              "GEN.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila echia wali ninachio chiali emitiiti isie nishili okhwitsa, ne chieemeetile nichiba eminji; ne OMWAMI yakhuheelesiye ikhabi hosi hosi ewa ndabeelenje; kho bulaano nasi ndakheekasilie liina amakhuwa keinzu yanje? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.30",
            "verseOrgIds": [
              "GEN.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nareeba mbu Ekhuheelesie shiina? Yakobo nakalusia mbu Kho orambeelesiakhwo eshindu ta; noba niukholela likhuwa lino kho ndalaayanga ebiayobio khandi, nibilinda. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.31",
            "verseOrgIds": [
              "GEN.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 30:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nembire mubiayobio leelo, ninzahulamwo buli shiayo shiamakondokondo kata eshiamapalapala, khandi buli limali mumakondi, khandi nende etsiamapalapala nende etsiamakondokondo mumbusi; ne omurungo kwanje kwakhabe khubifwana birio. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.32",
            "verseOrgIds": [
              "GEN.30.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 30:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mana obwatoto bwanje bulalolekhanga okhurula olwa leelo, buli olwa oleetsanga khumakhuwa komurungo kwanje okuli ewuwo; ne buli ndala eyirali yamapalapala kata yamakondokondo mumbusi, kata elirali limali mumakondi tawe, nishinyoolekha nindi ninashio, shilabasibwa mbu shieebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.33",
            "verseOrgIds": [
              "GEN.30.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 30:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labani naboola mbu Lola, ndakhachama kabe shinga olwa oboolile. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.34",
            "verseOrgIds": [
              "GEN.30.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 30:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga eyo Labani niyaahulamwo tsikhole etsianyakasanga netsiamapalapala, nende tsinyafusi tsiosi etsiali etsiamapalapala nende etsiamakondokondo, nende buli ndala eyali nende eshipala eshilafu, nende amamali kosi akokhumakondi natsihaana mumikhono chiabaanabe abasiani; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.35",
            "verseOrgIds": [
              "GEN.30.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeeyahula ehalekhwo nende Yakobo shinga oluchendo lwetsindaalo tsitaru; ne Yakobo niyaaya ebiayo biaLabani ebiali nibisikaale.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 30:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.36",
            "verseOrgIds": [
              "GEN.30.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 30:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yakobo nabukula tsisaala tsiomulibina, nende etsiomulusi, nende etsiomwaramoni, natsikhobolakhwo emikhosi emilafu, mbu obulafu bwetsisaala buloleshe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.37",
            "verseOrgIds": [
              "GEN.30.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 30:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasinjisia tsisaala etsia yali nakhoboole imbeli webiayo mutsikhwakhwa etsiokhubinyweesiliamwo, omwa ebiayo bieetselanga okhunyweela; nabio biahambinjia olwa bieetsa okhunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.38",
            "verseOrgIds": [
              "GEN.30.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 30:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ebiayo biaruumanga nibihambia imbeli wetsisaala, ebiayo nibiibula abaana banyakasanga nabamapalapala nabamakondokondo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.39",
            "verseOrgIds": [
              "GEN.30.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "GEN 30:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yakobo yaahukhasia amakondi, nakachoomia khukali akanyakasanga kata akali amamali mubiayo biaLabani; niyaahula amatuli keke konyene, narakatsokasia nende ebiayo biaLabani tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.40",
            "verseOrgIds": [
              "GEN.30.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "GEN 30:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana ebiali ebiamaani mubiayo olwa bieelukhanga, Yakobo yarekanga tsisaala tsana imbeli webiayo mutsikhwakhwa, mbu mana bihambie hakari wetsisaala etsio; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.41",
            "verseOrgIds": [
              "GEN.30.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 30:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne ebiayo olwa biali nibing'aha, kho shiyabirechelanga tsisaala ta; kho etsialemanga amaani nitsiba etsiaLabani, netsiamaani nitsiba etsiaYakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.42",
            "verseOrgIds": [
              "GEN.30.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 30:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu oyo niyeemeeta muno, naba nende ebiayo ebinji, nende abakholi beshikhasi nende abeshisaatsa, nende tsingamia nende tsisishili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.30.43",
            "verseOrgIds": [
              "GEN.30.43"
            ]
          }
        }
      ]
    }
