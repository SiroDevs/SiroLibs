          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yatsushiililwa amafura abe omuruchi walsiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Elisha omunabii yalanga mulala khubaana babanabii, namubiila mbu Wibohele tsingubotsio mushishienje, obukule akhachupa khano khamafura mumukhono, otsie eRamotsigileadi ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.1",
            "verseOrgIds": [
              "2KI.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa oba niwulileyo, okhaabeyo Yehu waYehoshafati waNimishi; mana winjile, omurusie mubaana babwe, omuyile mushisika shiomukari. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.2",
            "verseOrgIds": [
              "2KI.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana obukule akhachupa khamafura tsana, omutsushiilile khumurwe, nosunga mbu Kano niko aka OMWAMI aboola; mbu Ekhutsushiiliile amafura obe omuruchi waIsiraeli. Mana wikule omuliango, wilushe, oburashinda ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.3",
            "verseOrgIds": [
              "2KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omusooliili oyo, niye omunabii tsana, natsia eRamotsi-gileadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.4",
            "verseOrgIds": [
              "2KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yoolayo, yanyoola abaseesia belihe nibeekhaale mumuse; naboola mbu Omuseesia, ekhurumiilwe khwikhuwa lilebe. Yehu namureeba mbu Khuwina mwifwe? Naye ari Khwiwe, omuseesia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.5",
            "verseOrgIds": [
              "2KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho yabuukha, niyeenjila munzu; naye namutsushiilila amafura khumurwe, namusunjila mbu Kano niko aka OMWAMI, Nyasaye waIsiraeli, aboola; mbu Ekhutsushiiliile amafura obe omuruchi wabandu bOMWAMI, nibo Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.6",
            "verseOrgIds": [
              "2KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olarootsa inzu yaAhabu omwamiwo, mbu emale eshikwoli khuYezebeli khulwa amabanga kabasumba banje abanabii, namabanga kabasumba bosi bOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.7",
            "verseOrgIds": [
              "2KI.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba inzu yosi yaAhabu yilasikha; khandi ndalakhalaka khuAhabu buli mundu oweshisaatsa, kata omubohe kata omulekhuule muIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.8",
            "verseOrgIds": [
              "2KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi ndalakhola inzu yaAhabu yibe shinga inzu yaYeroboamu waNebati, khandi shinga inzu yaBaasha waAhiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.9",
            "verseOrgIds": [
              "2KI.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsimbwa natsio tsilaliila Yezebeli mushianyi shiaYezereeli; kata shialabaho oumuyabila ta. Mana niyeekula omuliango niyeelukha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.10",
            "verseOrgIds": [
              "2KI.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.10",
            "verseOrgIds": [
              "2KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa Yehu yarula niyeetsa ewa abasumba bomwamiwe bali, oundi namureeba mbu Kakhali karie? Owamalalu uno akhwitsiile mbushiina? Naye nabasunjila mbu Mumumanyile omundu oyo, namakhuwake shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.11",
            "verseOrgIds": [
              "2KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bari Nobubeeyi; okhuboolele bulaano. Kho naoaooolela mbu Yambooleele kari, handi kari; mbu Kano niko aka OMWAMI aboola; mbu Ekhutsushiiliile amafura obe omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.12",
            "verseOrgIds": [
              "2KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibaanguha, nibabukula buli mundu inguboye, nibatsiala hasiwe khumaniinilo akali butswa amakhaya; nibakhupa olwika, nibasunga bari Yehu niye omuruchi!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.13",
            "verseOrgIds": [
              "2KI.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yeera Yoramu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.13",
            "verseOrgIds": [
              "2KI.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nilwo olwa Yehu waYehoshafati waNimishi yamusanjilila Yoramu. Ne Yoramu yali nalindanga Ramotsi-gileadi, halala nende Isiraeli yosi, khulwa Hazaeli omuruchi waSiria; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.14",
            "verseOrgIds": [
              "2KI.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula omuruchi Yoramu yali nacheleele okhusilishilwa eYezereeli amafumire aka abaSiria bali nibamufumiire, olwa yalasana nende Hazaeli omuruchi waSiria. Mana Yehu nasunga mbu Emioyo chieenywe nichiba nichienya chirio, kho murafuchiilila omundu yesi asweshe arule mwitaala, atsie okhukabuula muYezereeli ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.15",
            "verseOrgIds": [
              "2KI.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yehu yachendela mwikaari, natsia eYezereeli; okhuba niho aha Yoramu yali nakonanga. Ne Ahazia omuruchi waYuda yali nakholomooshe niyeetsa okhumukoonya Yoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.16",
            "verseOrgIds": [
              "2KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omulindi yali nasinjiile khumunaara okwali muYezereeli; nalola omukanda kwaYehu nikwitsanga; nasunga mbu Omukanda kundi ngwokwo! Yoramu nasunga mbu Langa omundu ouchendela khufarasi, omurume okhubaakaanila, areebe mbu Nomulembe noho? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.17",
            "verseOrgIds": [
              "2KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omundu narula okhumwakaanila naniinile khufarasi, nasunga mbu Kano niko aka omuruchi aboola; mbu Nomulembe noho? Yehu namukalusia mbu Nawe oli nashi khumakhuwa komulembe? Shiukhana unondekhwo. Kho omulindi naboola ari Omurume yoolile ewa bali, ne shiakalukha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.18",
            "verseOrgIds": [
              "2KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yaruma omundu wakhabili naniinile khufarasi, naye niyoola ewa bali, nasunga mbu Kano niko aka omuruchi aboolambu Nomulembe noho? Yehu namukalusia mbu Nawe oli nashi khumakhuwa komulembe? Shiukhana unondekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omulindi naboola ari Yoolile ewa bali, ne shiakalukha ta; nokhwilusia khwingana okhwilusia khwaYehu waNimishi; okhuba yeelusia butinyu okhushila.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yoramu nasunga mbu Kasie. Nibakasia likaarilie. Nabo Yoramu omuruchi waIsiraeli nende Ahazia omuruchi waYuda nibarula, buli mundu mwikaarilie, nibatsia okhwakaanila Yehu, nibamunyoola mushianyi shiaNabotsi omuYezereeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.21",
            "verseOrgIds": [
              "2KI.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Yoramu yamulola Yehu, yareeba mbu Nomulembe, Yehu? Naye nakalusia mbu Nomulembe shiina, olwa obuheyi bwaYezebeli mawo nobulosibwe buli obunji burio? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.22",
            "verseOrgIds": [
              "2KI.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoramu nashiukhasia likaari niyeelukha, nasunjila Ahazia ari Ahazia, bakhukhobaane! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.23",
            "verseOrgIds": [
              "2KI.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehu nakhwesa obuyingobwe namaani kosi, nakhupila Yoramu mushibilikano, eshisele nishirulila mumwoyokwe, nakwa mwikaarilie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.24",
            "verseOrgIds": [
              "2KI.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehu nasunjila Bidikari omuseesiawe ari Omuchinje, omusukune mumukunda tsana kwaNabotsi omuYezereeli; ne yitsulila mbu olwa khwachendelanga khufarasi ninawe halala nikhulonda khuAhabu samwana, OMWAMI yarumbula oburumbusi buno khuye; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.25",
            "verseOrgIds": [
              "2KI.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu Toto mwene, shinga olwa ndaluutsi amabanga kaNabotsi namabanga kabaanabe eshiabeele, OMWAMI aboola, nolwa ndalakhurunga iwe mumukunda kuno; nilwo olwa OMWAMI aboola. Kho bulaano omubukule, omusukune mumukunda tsana, aka OMWAMI yabeola shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehu yeera Ahazia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.26",
            "verseOrgIds": [
              "2KI.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa olwa Ahazia omuruchi waYuda yalola ario, yeelukha nalonda khunjila yeBetsihagani. Naye Yehu namulondachilila, nasunga mbu Mumulase yesi! Nibamulasila mwikaarilie hashisia shiaGuri, eshili ahambi nende Ibileamu. Naye niyeelukha, natsia eMegido, nafwilayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.27",
            "verseOrgIds": [
              "2KI.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumbabe nibamuchinjila mwikaari, nibamuyila eYerusalemu, nibamuyabila mung'aniye halala nabakuukanyene, mwitookho liaDaudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.28",
            "verseOrgIds": [
              "2KI.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mumuyika kwekhumi nalulala kwaYoramu waAhabu, Ahazia yachaaka okhuruka Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaYezebeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.29",
            "verseOrgIds": [
              "2KI.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yehu yali niyoolile eYezereeli, Yezebeli yahulilakhwo; niyeebakha iranji khumoni, niyeesiaha omurwe, nahenjela mwitirisha elwanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.30",
            "verseOrgIds": [
              "2KI.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olwa Yehu yeenjila mushilibwa, yamureeba mbu Nomulembe, iwe Zimiri, omwiri womwamiwo? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.31",
            "verseOrgIds": [
              "2KI.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nachinguula tsimoni, nahenga khwitirisha, nasunga mbu Niwina ouli halubeka lwanje? Niwina? Mana abasumba abalate babili bataru nibamuhenga elwanyi ewa yali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.32",
            "verseOrgIds": [
              "2KI.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabasunjila mbu Mumufuube hasi. Nibamufuuba hasi; amabangake kandi nikamiitsushila khwisiisi, khandi khutsifarasi; Yehu namuseenela hasi webilenje bieifarasiye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.33",
            "verseOrgIds": [
              "2KI.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyeenjiile, yalia nende okhunywa; nasunga mbu Tsie bulaano mulole akomukhasi uno ouli mushilaamo shiobubii, mumuyabile; okhuba nomukhaana womuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.34",
            "verseOrgIds": [
              "2KI.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatsia okhumuyabila; nebutswa shibanyoola eshindu khuye ta, habula eshihanganga, nebilenje, nebikalo biamakhono bionyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.35",
            "verseOrgIds": [
              "2KI.9.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako bakalukha nibamuboolela. Naye nasunga mbu Kano niko amakhuwa kOMWAMI, aka yaboolela mumunwa kwomusumbawe Eliya omuTishibe, ari Mushianyi shiaYezereeli tsimbwa tsilaliilamwo omubili kwaYezebeli; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.36",
            "verseOrgIds": [
              "2KI.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata omulambo kwaYezebeli kulaba shinga imbolela khumukunda mushianyi shiaYezereelii baleshe okhuboola mbu Uno niye Yezebeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.37",
            "verseOrgIds": [
              "2KI.9.37"
            ]
          }
        }
      ]
    }
