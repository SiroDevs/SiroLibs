  "bookId": "2KI",
  "reference": "2 Abaruchi 17",
  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhukwisibwa khwaSamaria, abaIsiraeli nibaatisibwa okhuyilwa mubuhambe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwekhumi nakhabili kwaAhazi, omuruchi waYuda, Hoshea waEla yachaaka okhuruchila Isiraeli muSamaria, naruka emiyika shienda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, habulashinga abaruchi baIsiraeli abamuranjilila ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Shalimaneseri omuruchi waAshuru natikulukha okhumuseera; Hoshea nakwa omusumbawe; namuleerela ebiayaroosibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi waAshuru yanyoola akobukhobani muHoshea; okhuba yali narumile abarume ewaSo, omuruchi waMisiri; kata shiyaleerela omuruchi waAshuru ebia yaroosibwa, shinga olwa yakholanga omuyika buli muyika ta; khulwako omuruchi waAshuru yamwikalila, namuboha mumbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi waAshuru natikulukha nabira mushialo shiosi, natsia eSamaria naliikalila emiyika chitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mumuyika kwashienda kwaHoshea, omuruchi waAshuru yabukula Samaria, niyaara abaIsiraeli mushialo shiabwe, nabayila eAshuru nabara muHala, nende khuHabori, Gmwalo kwaGozani, khandi mumataala kabaMedi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne keekhola kario shichila abaana baIsiraeli bali nibamwonoonela OMWAMI Nyasaye wabwe, owabatikulusia nnbarusia mushialo shiaMisiri, okhurula ewa bali hasi womukhono kwaFarao, omuruchi waMisiri; nibaheelesia abanyasaye bandi oluyali, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibachenda mubiima ebia abamahanga tsana aka OMWAMI yarusia imbeli wabaana baIsiraeli nende mubiima ebia abaruchi baIsiraeli baraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abaana balsiraeli bakholanga mabiswi amakhuwa akarali habwene ta, akafukula OMWAMI Nyasaye wabwe; nibeeyumbashila habundu aheechingu mumataala kabwe, okhurula khumunaara kwomulindi okhuula khwitaala liolukoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeesinjisilia amachina amasongokhu nende emiAshera khubuli shikulu eshirambi, khandi mubuli musaala omutendeemu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne niho aha basambilanga amalesi kelibuuliesi habundu aheechingu hosi, shinga amahanga ako olwa kakhola, aka OMWAMI yarusia imbeli wabwe; nibakholanga amakhuwa amabii akasinyisia OMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibakhalabanila emindu echiinamilungwa, echia OMWAMI yali niyabasunjilakhwo mbu Murakhola likhuwa elo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI yali niyachesiyia Isiraeli nende Yuda mumunwa kwabuli munabii nokwabuli mulakusi, ari Shiukhane murule munjila tsieenywe tsimbii, mulindenje amalako kanje naka ndalachilisia, kosi aka ndalaka abakuuka beenywe shinga olwa kali, aka ndamuleerela muminwa chiabasumba banje abanabii. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa baloba okhuhulila, niboomia amakosi, shinga amakosi kabakuuka babwe, abaramusuubilila OMWAMI Nyasaye wabwe ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhaya aka yalachilisia, neindakanoye eya yalakana nabakuuka babwe, nobuchesiyiibwe obwa yabachesiyia; nibalondachila amakhaya, nibakwa abakhaya, nibalonda akamahanga akababotokhana, aba OMWAMI yali niyabalakakhwo mbu baleshe okhukhola shinga bo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalekha amalako kosi kOMWAMI Nyasaye wabwe, nibakhola ebifwanani ebisalule, ebiebimoosi bibili; nibakhola omuAshera, nibeenamila amahe kosi akomwikulu, nibakhalabanila Baali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi babisia abaana babwe abasiani nabakhaana mumulilo, nibeekhoonyela olubu nobulookooli, nibeekusia abeene okhukholanga akali amabii mumoni tsiOMWAMI, okhumusinyisia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila OMWAMI natiililwa Isiraeli oburima muno, nabarusia imbeli wetsimonitsie; kata shibatong'aho ta, habula oluyia lwaYuda lwonyene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata abaYuda nabo shibalinda amalako kOMWAMI Nyasaye wabwe ta, habula bachenda mubiima biaIsiraeli, ebia abeene bali nibaraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho OMWAMI naloba bosi abolwibulo lwaIsiraeli, nabasandia, nabahaana mumakhono ka abo ababayaaya, okhuula olwa yabasukuna barule mumonitsie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa yeetsumba Isiraeli yirule khunzu yaDaudi, bamwemekha Yeroboamu waNebati abe omuruchi; naye Yeroboamu yakhwesa Isiraeli, baleshe okhulondakhwo OMWAMI, nachila niboonoona eshionoono eshikhongo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli nibachenda mubionoono biosi biaYeroboamu ebia yakholanga, kata shibabirulamwo ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuula olwa OMWAMI yarusia Isiraeli mumomtsie, shinga olwa yasunga muminwa chiabanabii bosi abasumbabe. Nilwo olwa abaIsiraeli baarwa mushialo shiabwe nibayilwa eAshuru, okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu okhumenyibwa muSamaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omuruchi waAshuru yaleera abandu okhurula eBabeli, nokhurula eKutsa, naAwa, naHamatsi, naSefariwaimu, nabara mumataala kaSamaria, mushilenje shiabaana baIsiraeli; nibalia Samaria, nibamenya mumataala kayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khukhuchaaka khwokhumenya khwabwe ebweneyo, shibali nibamuriitsanga OMWAMI ta; niko akachila OMWAMI naruma tsitalanyi hakari mubo natsio nitsiira abandi khubo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako basunjila omuruchi waAshuru bari Amahanga ako aka wayila nora mumataala kaSamaria shikamanya ebiima biaNyasaye weshialo eshio ta; khulwako arumile tsitalanyi hakari mubo, ne lola, tsibeeranga shichila shibamanya ebiima biaNyasaye weshialo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi waAshuru nalaka mbu Muyileyo mulala khubakuhani aba mwarusiayo; atsie amenyeyo, mbu abeechesinjie akebiima biaNyasaye weshialo eshio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho mulala owokhubakuhani abali nibaarwa muSamaria yeetsa namenya eBeteli, nabeechesia shinga olwa bakhoyile okhuriitsanga OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa ababuli lihanga beekholela abeene abanyasaye, nibabara munzu tsiahabundu aheechingu aha abaSamaria bali nibakasia, buli lihanga mumataala kabwe omwa bamenyanga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "AbaBabeli bakhola Sukotsi-benotsi; abaKutsi bakhola Nerigali; abaHamatsi bakhola Ashima ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "abaAwi bakhola Nibihazi nende Taritaki nabo abaSefariwaimu basambila Adiramelekhi naAnamelekhi, abanyasaye baSefariwaimu, abaana babwe mumulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bariitsanga OMWAMI yesi, nibeekholela abakuhani bahabundu aheechingu abarula mbu abeene, ababamalilanga emisango, munzu tsana tsiahabundu aheechingu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bariitsanga OMWAMI, khandi nibakhalabanila abanyasaye babwe abeene, nibalonda ebiima biamahanga ako aka baarwamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne okhuula olwa leelo bashikholanga akebiima ebio biakhale.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shibariitsanga OMWAMI ta, kata shibakholanga akobulachilisii kata obukhalachi kata akameebaalo kata akelilako, ebia OMWAMI yalaka abaana baYakobo, owa yakulikha mbu Isiraeli, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI yali niyalakana ninabo indakano, nabalachilisia mbu Murariitsanga abanyasaye bandi, kata okhubeenamila, kata okhubakhalabanila, kata okhubamalilanga emisango ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula OMWAMI, owamutikulusia namurusia mushialo shiaMisiri nende obunyali obunji, nomukhono okunyiililwe okhumuhabina, mumuriitsenje ye, nimumwinamila ye, nimumumalila ye emisango; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "nako akalachilisibwa nakobukhalachi, nameebaalo nende lilako, aka yamuhandiichila, mwitsulilenje okhukakhola tsindaalo tsiosi; ne murariitsanga abanyasaye bandi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata indakano eya ndalakana nineenywe, murachiibilila, kata murariitsanga abanyasaye bandi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula OMWAMI Nyasaye weenywe, mumuriitsenje; naye alamuhonia mumukhono kwabasuku beenywe bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa shibahulila ta; habula bakholanga butswa ebiima biabwe biakhale.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abamahanga ako bariitsanga OMWAMI, nende okhukhalabanila ebifwanani biabwe ebibaatse; nabaana babwe nabo bario, nende abeetsukhulu babwe; shinga abakuuka babwe olwa bakhola, nolwa bakholanga okhuula olwa leelo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
    }
