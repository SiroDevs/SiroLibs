          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yehoyakimu yali owemiyika amakhumi kabili nachiraano olwa yachaaka okhuruka; naruchila eYerusalemu emiyika ekhumi namulala; ne eliira lianyina liali Zebida waPedaya oweRuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
