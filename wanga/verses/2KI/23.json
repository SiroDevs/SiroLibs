    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia yakalusia ehima okhuba habwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi narumana, nibamukhung'aasilia abakofu bosi baYuda nabeYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi natikulukha, natsia munzu yOMWAMI, halala nabaYuda bosi nabeYerusalemu bosi, nende abakuhani nabanabii, nabandu bosi, ari abatiiti ari abakhongo; nabasoomela amakhuwa kosi akeshitabu shieindakano eshianyoolwa munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nasinjila hasiilo, nakhola indakano imbeli w, mbu okhulondanga khuMWAMI, nokhulinda amalakoke, noburumbusibwe, naka alachilisia, nomwoyokwe kwosi neshiimoshie shiosi, okhuusia amakhuwa keindakano tsana akahandiikwa mushitabu eshio; abandu bosi nibasangamwo mundakano eyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nalaka Hilikia omukuhani omukhulundu, nende abakuhani beitaraja yakhabili, nabalindi bomuliango, okhurusia muhekalu yOMWAMI ebimanulwa biosi ebiakholwa khulwa Baali, nokhulwa Ashera, nokhulwa amahe kosi akomwikulu; nabisambila elwanyi weYerusalemu, mumikunda chieKidironi; nachinga likoshe liabio, nayila eBeteli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi narusiaho abakuhani bemindu echio echiinamilungwa, aba abaruchi baYuda bali nibaraho okhusambila amalesi kelibuuliesi habundu aheechingu mumataala kaYuda, khandi ahabotokhana Yerusalemu; halala nende abasambilanga amalesi kelibuuliesi khuBaali, nokhuliuba, nokhumwesi, nokhutsinyininyini, nokhumahe kosi akomwikulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yarusia omuAshera munzu yOMWAMI, nomuYerusalemu, nakuyila hamuchela kwaKidironi, nakusambila hamuchela kwaKidironi, nakusasaachila elala kukwe olufu, nasukuna olufu tsana khubilindwa biabandu abamanani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yalikulula tsinzu tsiabatanyani etsialinji munzu yOMWAMI, ewa abakhasi bali nibalushilanga tsingubo tsiomuAshera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narusia abakuhani bosi mumataala kaYuda, niyoonoonia habundu aheechingu ewa abakuhani tsana bali nibasambianga amalesi kelibuuliesi, okhurula eGeba okhuula eBeerisheba; nalikulula nende habundu heechingu haluyia, ahali habwinjililo bwoluyia lwaYoswa omukafuna welitookho, ahali khumukhono mukhasi hashilibwa shielitookho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abakuhani bahabundu aheechingu tsana shibali nibaniinanga hashimalilo shiOMWAMI eYerusalemu ta; habula baliitsanga omukaate okubulamwo amamela mubashiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yoonoonia Tofetsi, ahali mwibanda liabaana baHinomu, mbu omundu yesi aleshe okhubisia omwanawe omusiani kata omukhaana mumulilo khuMolekhi ta ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yayiniaho tsifarasi etsia abaruchi baYuda bali nibaheelesiye eliuba, habwinjililo bweinzu yOMWAMI, hashisika shiaNatsani meleki omwalisia, eshiali nishili khumukuru; nasamba amakaari keliuba nomulilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabio ebimalilo ebiali nibili khushilama shieshisika shiahekulu shiaAhazi, ebia abaruchi baYuda bali nibakhola, nende ebimalilo ebia Manase yali niyakhola, munyanyi tsibili tsieinzu yOMWAMI, omuruchi yabilikulula nabikhupa hasi, nabisasaka ebitonye ebitonye, nasukuna olufu lwabio mumuchela kwaKidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahabundu aheechingu ahali imbeli waYerusalemu naho, ahali khumukhono musaatsa weshikulu shiobusasishi, eshia Sulemani omuruchi waIsiraeli yoombashila Ashitoretsi, eshisinyo shiebuSidoni, nende Khemoshi, eshisinyo shiebuMoabu, nende Milikomi, eshisinyo shiebuAmoni, omuruchi yoonoonia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasasaka ebitonye ebitonye amachina amasongookhu, narema emiAshera, nakalusiaho amakumba kabafwa habundu wabio.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende eshimalilo eshiali eBeteli, nahabundu aheechingu aha Yeroboamu waNebati yakhola, oyo owachila Isiraeli niyonoona, yalikulula eshimalilo eshio nahabundu aheechingu hashio; nasasaka amachina keene, nakatubulila elala kakwe olufu, nasamba omuAshera. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Yosia yashiukhana, yalola ebilindwa ebiali nibiliho khushikulu; naruma abandu narusia amakumba mubilindwa, nakasambila khushimalilo nashionoonia, likhuwa liOMWAMI elia omundu waNyasaye yarumbula shinga olwa liali, oyo owaIakula amakhuwa ako khale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nareeba mbu Neshiitsulilo shiina eshia enduutsi shilia? Abelitookho nibamuboolela mbu Neshilindwa shiomundu waNyasaye tsana, owarula eYuda, nalakula amakhuwa ako aka okholeele eshimalilo shieBeteli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye ari Lekha abe; omundu yesi arasitia amakumbake ta. Kho nibalekha amakumbake, halala namakumba komunabii oyo owarula eSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsinzu natsio tsiosi tsiahabundu aheechingu ahali mumataala kaSamaria, etsia abaruchi baIsiraeli bali nibakhola nibamusinyisia OMWAMI, Yosia yatsirusiaho tsiosi, natsikhola shinga ebikholebie biosi ebia yakhola eBeteli olwa biali, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeerela abakuhani bosi bahabundu aheechingu abaliho, khubimalilo, nasambilakhwo amakumba kabandu; mana nakalukha eYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhuliibwa khweipasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi nalaka abandu bosi ari Lie ipasaka yOMWAMI Nyasaye weenywe, shinga olwa kahandiikwa mushitabu shino shieindakano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ipasaka eyifwana yirio shiyakholwakhwo ta, okhurula khundaalo tsiabayaasii abayaasia Isiraeli, kata mundaalo tsiabaruchi baIsiraeli, kata etsiabaruchi baYuda ta; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula mumuyika kwekhumi namunaane kwomuruchi Yosia nilwo oiwa ipasaka eyo yakholelwa OMWAMI muYerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "OMWAMI yashisinyishila Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi abo abali abebitsoyeelo, kata abamayengo, nende emiterafi, nemiindu echio echiinamilungwa, nebisinyo biosi ebialolekha mushialo shiaYuda nomuYerusalemu, Yosia yabirusiaho, mbu yoosilie elala amakhuwa kamalako akahandiikwa mushitabu eshia Hilikia omukuhani yanyoola munzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shiyaliho omuruchi yesi owafwanana ninaye mubamuranjilila, owashiukhanila OMWAMI nomwoyo kwosi neshiimo shiosi namaani kosi, shinga amalako kaMusa olwa kali, ta; kata inyumawe shiyabuukha owafwanana ninaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa OMWAMI shiyakalukhana okhurula khubululu bwobusinyishibwe obunji, obwachila oburimabwe nibwashila Yuda, khulwa amakhuwa kosi aka Manase yamusinyisia ninako ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunga mbu Khandi ndalarusia Yuda mumoni tsianje, shinga olwa ndarusia Isiraeli, nisukuna litookho lino elia ndalobola, mbu Yerusalemu, nende inzu eya ndasungakhwo mbu Eliira lianje lilabeetsangamwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaYosia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYosia, nende kosi aka yakhola, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baYuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalotsie Farao Neko omuruchi waMisiri yatikulukha okhuseera omuruchi waAshuru hamwalo kwaEufurate; naye omuruchi Yosia natsia okhumuseera; Farao Neko namwirila eMegido olwa yamulola. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abasumbabe nibamuchinjila mwikaari nafwile nibamurusia eMegido nibamuleera eYerusalemu; nibamuyabila mung'ani yiye emwene. Mana abandu beshialo nibabukula Yehoahazi waYosia, nibamutsushiilila amafura nibamwemekha abe omuruchi mushilenje shiasamwana.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi buaYehoakazi, khandi shinga olua yarusibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoahazi yali owemiyika amakhumi kabili nachitaru olwa yachaaka okhuruka; naruchila eYerusalemu emiesi chitaru; ne eliira lianyina liali Hamutali waYeremia oweLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, kosi aka abakuukanyene bakholanga shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Farao Neko namuboha nebibohelo eRebila mushibala shiaHamatsi, mbu aleshe okhuruchila eYerusalemu, naroosia eshialo tsitalanda eshikhumi tsieifeetsa nende italanda ndala yeitsahaabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Farao Neko yamwemekha Eliakimu omwana waYosia abe omuruchi mushilenje shiaYosia samwana, nakalukhasia eliiralie libe Yehoyakimu. Ne yabukula Yehoahazi, namuyila eMisiri, nafwilayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoyakimu yaheelesia Farao ifeetsa tsana neitsahaabu, ne yaroosia abeene-loba mbu arunje amapeesa shinga Farao olwa yalaka; yabukula ifeetsa neitsahaabu khubeene-loba, buli mundu shinga olwa yaroosibwa, okhuheelesia Farao Neko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
