{
  "id": "2KI.24",
  "number": "24",
  "bookId": "2KI",
  "reference": "2 Abaruchi 24",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2KI 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalotsie Nebukadineza omuruchi waBabeli yatikulukha niyeetsa, Yehoyakimu nakwa omusumbawe emiyika chitaru; mana nashiukhana namukholela induli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naruma tsing'anda tsiabaKalidayo okhumuseera, netsing'anda tsiabaSiria, netsing'anda tsiabaMoabu, netsing'anda tsiabaana baAmoni, nabaruma okhuseera Yuda okhubamulula, likhuwa liOMWAMI shinga olwa liali elia yasunjila muminwa chiabanabii abasumbabe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.2",
            "verseOrgIds": [
              "2KI.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne nitoto, kano kakwila Yuda khulwa lilako liOMWAMI, okhubarusia mumonitsie khulwa ebionoono biaManase, kosi aka yakhola shinga olwa kali, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.3",
            "verseOrgIds": [
              "2KI.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi khulwa amabanga kababula eshikha aka yeebeenia; okhuba yeetsusia Yerusalemu amabanga kababula eshikha; OMWAMI nakhaya okhumuleshela. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.4",
            "verseOrgIds": [
              "2KI.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYehoyakimu, nende kosi aka yakhola, shikahandiikwa muShitabu shiaAmakhuwa keTsindaalo akabaruchi baYuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoyakimu nakona nalonda khubakuukanyene; naye Yehoyakhini omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.6",
            "verseOrgIds": [
              "2KI.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omuruchi waMisiri shiyarulakhwo mushibalashie khandi ta; okhuba ormuruchi waBabeli yali nabukuule biosi ebialinji biomuruchi waMisiri, okhurula khumuchela kwaMisiri, okhuula khumwalo kwaEufurate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakhini nabakalibe bahambwa nibayilwa eBabeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakhini yali owemiyika ekhumi namunaane olwa yachaaka okhuruka; naruchila eYerusalemu emiesi chitaru; ne eliira lianyina liali Nehushita waElinatsani, oweYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.8",
            "verseOrgIds": [
              "2KI.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, kosi aka samwana yakhola shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.9",
            "verseOrgIds": [
              "2KI.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo etsio abasumba baNebukadineza omuruchi waBabeli batikulukha nibatsia eYerusalemu, litookho nihikalilwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.10",
            "verseOrgIds": [
              "2KI.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Nebukadineza omuruchi waBabeli niyoola khwitookho, olwa abasumbabe bali nibaliikaliile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.11",
            "verseOrgIds": [
              "2KI.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Yehoyakhini omuruchi waYuda yeelusia natsia khumuruchi waBabeli, halala nende nyina, nabasumbabe, nabakhulundube, nabakalibe; omuruchi waBabeli namuhamba mumuyika kwomunaane kwoburuchibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.12",
            "verseOrgIds": [
              "2KI.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yayaaya biosi ebiabiikhwa munzu yOMWAMI, nebiabiikhwa munzu yomuruchi nakhalaka ebimanulwa bieitsahaabu ebia Suiemani omuruchi waIsiraeli yali niyakhola muhekalu yOMWAMI, ebitonye ebitonye, shinga OMWAMI olwa yali niyasunga khale. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.13",
            "verseOrgIds": [
              "2KI.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayila abeYerusalemu bosi, nende abakhulundu bosi, nabalulu bamaani bosi, abahambe ebikhumila ekhumi, halala nabasitsa bosi nende abeeraanyi; shibatong'akhwo ta, habula abali abamanani muno mushialo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.14",
            "verseOrgIds": [
              "2KI.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yayila Yehoyakhini eBabeli; nende nyina omuruchi, nabakhasi bomuruchi, nabakalibe, nende abandu abakhulundu beshialo, yabayila bosi mubuhambe, nabarusia eYerusalemu naboosia eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.15",
            "verseOrgIds": [
              "2KI.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abalulu bosi, abandu ebikhumila musaafu, halala nabasitsa nende abeeraanyi, abandu eshikhumila, bosi nibali abandu bamaani abakhanyala okhuseera mwihe, abo bosi omuruchi waBabeli yayila mubuhambe eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.16",
            "verseOrgIds": [
              "2KI.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omuruchi waBabeli niyeemekha Matania, omwana wabwe samwana Yehoyakhini, abe omuruchi mushilenjeshie, nakalukhasia eliiralie libe Zedekia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaZedekia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.17",
            "verseOrgIds": [
              "2KI.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Zedekia yali owemiyika amakhumi kabili namulala olwa yachaaka okhuruka; naruchila eYerusalemu emiyika ekhumi namulala; ne eliira lianyina liali Hamutali waYeremia, oweLibina. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.18",
            "verseOrgIds": [
              "2KI.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI kosi aka Yehoyakimu yakhola shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.19",
            "verseOrgIds": [
              "2KI.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba khulwa oburima bwOMWAMI kamala keekhole muYerusalemu nende Yuda mbu yabusukuna barule imbeliwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.20",
            "verseOrgIds": [
              "2KI.24.20"
            ]
          }
        }
      ]
    }
  ],
