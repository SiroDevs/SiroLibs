    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaYehoahazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kabili nachitaru kwaYoashi waAhazia, omuruchi waYuda, Yehoahazi waYehu yachaaka okhuruchila Isiraeli eSamaria, naruka emiyika ekhumi namusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, nalonda mubionoono biaYeroboamu waNebati, ebiachila Isiraeli niyonoona; shlyabirulamwo ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noburima bwOMWAMI bwaashila Isiraeli, naye nabahaana mumukhono kwaHazaeli omuruchi waSiria, khandi mumukhono kwaBenihadadi omwana waHazaeli, tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yehoahazi yasaaya OMWAMI, OMWAMI namuhulila; okhuba yalola okhusandibwa khwaIsiraeli, shinga omuruchi waSiria olwa yali nabasandinjia. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba shiyaleshela Yehoahazi abandu, habula abachendela khufarasi amakhumi karaano, namakaari ekhumi, nabachendela ebilenje ebikhumila ekhumi; okhuba omuruchi waSiria yabamalilana, nabakhola babe shinga olufu olwokhulwanyi nohuula imele. Ne OMWAMI yaheelesia Isiraeli omuhonia, owachila nibeehonokokha mumukhono kwabaSiria; nabo abaana baIsiraeli nibamenya mungo tsiabwe, shinga olwa bali khale. Nebutswa shibarula mubionoono bieinzu yaYeroboamu, ebiachila Isiraeli niyonoona, ta, habula okhuchenda mubio; khandi omuAshera kwatong'a muSamaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5+2KI.13.6+2KI.13.7",
            "verseOrgIds": [
              "2KI.13.5",
              "2KI.13.6",
              "2KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYehoahazi, nende kosi aka yakhola, nakobululubwe, shikahandiikwa muShitabu shiAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yehoahazi nakona nalonda khubakuukanyene; nibamuyabila eSamaria; naye Yoashi omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaYehoashi walsiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi kataru namusaafu kwaYoashi, omuruchi waYuda, Yehoashi waYehoahazi yachaaka okhuruchila Isiraeli muSamaria, naruka emiyika ekhumi nachisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI; shiyarula mubionoono biosi biaYeroboamu waNebati, ebiachila Isiraeli niyonoona, ta; habula yachenda mubio. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYoashi, nende kosi aka yakhola, nende akobululubwe mukhuseera Amazia omuruchi waYuda, shikahandiikwa muShitabu shiaAmakhuwa keTsindaalo akabaruchi baIsiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yoashi nakona nalonda khubakuukanyene; naye Yeroboamu niyeekhala khushifumbishie shioburuchi; Yoashi nayabilwa eSamaria halala nabaruchi baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburumbusi bwaElisha obwokhubulaame, nende okhufwakhwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Elisha, obulwale bwamutiila; obwenobwo nibwo obwamwira. Naye Yoashi omuruchi waIsiraeli nakholomokha namwitsila, namulilila, nasunga mbu Papa, papa, amakaari kaIsiraeli, nabachendela khufarasi! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisha namuboolela mbu Bukula obuyingo nebisele; naye nabukula obuyingo nebisele. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana naboolela omuruchi waIsiraeli mbu Ra omukhono khubuyingo; naburakhwo omukhono. Naye Elisha nara amakhonoke khumakhono komuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Khalase; naye nalasa. Nasunga mbu Eshisele shiOMWAMI shiokhuhula, eshisele shiokhuhula Siria! Okhuba olarootsela abaSiria eAfeki okhuula olwa olaba nobasishiye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasunga mbu Bukula ebisele; nabibukula. Mana nasunjila omuruchi waIsiraeli mbu Bikhupe hasi khwiloba; naye nakhupa khataru, nalekha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omundu waNyasaye namusinyishila, nasunga mbu Obeele nokhoyile okhukhupa okhuula kharaano kata khasasaba; mana wakhakhupile Siria okhuula olwa wakhabeele nobasishiye; nebutswa bulaano olakhupa Siria okhuula khataru khonyene.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Elisha nafwa, nibamuyabila. Ne tsing'anda tsiabaMoabu tsiali nitsiinjilanga mushialo eshio khukhuchaaka khwomuyika. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyanga yindi, olwa bali nibamuyabila omundu, njieyo, balola ing'anda; nibamusukuna omundu tsana mushilindwa shiaElisha; ne omundu oyo niyakheetuya khumakumba kaElisha, yalamukha nasinjila.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Hazaeli omuruchi waSiria yasandia Isiraeli tsindaalo tsiosi tsiaYehoahazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne OMWAMI yabakoosia obukoosia, nababeela eshisa, nabeetsulila, khulwa indakano eya yalakana nende Aburahamu, naIsaka, naYakobo, narachama okhubasishia ta; kata okhuula bulaano shiyabasukuna hamurulekhwo ta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hazaeli omuruchi waSiria yafwa; naye Benihadadi omwanawe naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
              "2KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yehoashi waYehoahazi yarusia mumukhono kwaBeni-hadadi waHazaeli amataala ako aka yali niyabukula mumukhono kwaYehoahazi samwana mwihe. Yoashi yamuhula okhuula khataru, nakalusia amataala tsana kaIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.25",
            "verseOrgIds": [
              "2KI.13.25"
            ]
          }
        }
      ]
    }
  ],
