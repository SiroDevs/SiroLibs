              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Elisha yeekhala munzuye, abakofu nabo nibeekhaale ninaye; ne omuruchi yali narumile omundu owokhubakhalabanibe. Ne omurume oyo narashioolayo ta, Elisha yasunjila abakofu tsana ari Muluutsi shinga omwiri uno olwa arumanile okhubukula omurwe kwanje? Lole, olwa omurume tsana aba niyoolile, mwikale omuliango, nimumutiilila olwichi tatat'ta; emiyindili chiomwamiwe shichili emukongowe? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nashisungananga ninabo, lola, omurume tsana nakholomokha namwitsila, nasunga mbu Libii lino lirula khuMWAMI; nasi eshi mulindiilila OMWAMI mbushi?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    }
