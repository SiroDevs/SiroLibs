          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwamakhumi karaano kwaAzaria, omuruchi waYuda, Pekahia waMenahemu yachaaka okhuruchila Isiraeli muSamaria, naruka emiyika chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI; shiyalekha ebionoono biaYeroboamu waNebati, ebiachila Isiraeli niyonoona, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Peka waRemalia, omuseesiawe, yasanjilana nabashie, namuupila eSamaria, munzu ikhulundu eyili yomuruchi, halala nende Aragobu naArie; khandi yali nende abandu amakhumi karaano abokhubaGileadi; namwira, naruka mushilenjeshie. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaPekahia, nende kosi aka yakhola, lola, kahandiikwa muShitabu shiAmakhuwa keTsindaalo akaharuchi baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
