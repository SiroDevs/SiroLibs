        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2TI 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omwami abe nende rohoyo. Obukoosia bube nineenywe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.22",
            "verseOrgIds": [
              "2TI.4.22"
            ]
          }
        }
