              "2TI.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushiesilie Pirisika nende Akula, nende abelitaala liOnesiforo.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2TI 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.19",
            "verseOrgIds": [
              "2TI.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2TI 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erasito yatong'a eKorinzo; ne Turofimo ndamulekha eMileto, nali omulwale. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.20",
            "verseOrgIds": [
              "2TI.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rakhwo omwoyo okhuula tsindaalo tsiomunyiri nitsirashioola ta.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2TI 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eubulo akhushiesiye, nende Pude, naLino, naKilaudia, nende abaana beefwe bosi.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.21",
            "verseOrgIds": [
              "2TI.4.21"
            ]
          }
        }
      ]
    },
