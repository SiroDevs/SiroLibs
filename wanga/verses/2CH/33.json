    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaManese",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Manase yali owemiyika ekhumi nachibili olwa yachaaka okhuruka; naruchila muYerusalemu emiyika amakhumi karaano nachiraano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, nalonda khubisinyo biabamahanga, aba OMWAMI yali niyarusia imbeli wabaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba yoombakha khandi habundu aheechingu hosi aha Hezekia samwana yalikulula; khandi yasinjisilia emiBaali ebimalilo biemisango, nakasia emiAshera, niyeenamila amahe kosi akomwikulu nakakhalabanila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yoombakha ebimalilo munzu yOMWAMI, eyeneyo eya OMWAMI yali niyasungakhwo mbu MuYerusalemu nimwo omwa eliira lianje lilabeetsanga, obushia nobushia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yoombashila amahe kosi akomwikulu ebimalilo munyanyi etsio tsibili tsieinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yabisia abaanabe mumulilo mwibanda liomwana waHinomu; nakholanga obulakulusi, niyeekhoonyela obulookooli, nakhola akobufila, niyeeyinjisia mukabebitsoyeelo, nabamayengo. Yakhola obubii obunji mumoni tsiOMWAMI, namusinyisia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi eshifwanani eshibaatse shieshindu shiabutswa eshia yali nakholile, yashisinjisia munzu yaNyasaye, eyeneyo eya OMWAMI yasunjila Daudi naSulemani omwanawe ari Munzu muno, khandi muYerusalemu elia ndalobola mumbia tsiosi tsiaIsiraeli, nimwo omwa ndalara eliira lianje obushia nobushia; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata shindalarusia eshilenje shiaIsiraeli khandi khushialo eshia ndaahulila abakuuka beenywe ta; nibaba nibaleetsulilanga butswa okhukhola kosi aka ndabalaka, niko akameebaalo kosi nakalachilisibwa nakobukhalachi, akeetsa mumukhono kwaMusa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Manase nashiamia Yuda nabeYerusalemu, okhuula olwa bakhola obubii okhushila amahanga ako aka OMWAMI yatibia imbeli wabaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Manase nende abandube amakhuwa; nabo nibarateeba likhuwa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako OMWAMI yaleera khubo abaseesia belihe liomuruchi waAshuru, abamuhamba Manase, nibamutiila neisakol nibamuboha nebitiili, nibamuyila eBabeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali nali mumatinyu, yasaaya OMWAMI Nyasayewe muno, niyeetiitiyia muno imbeli waNyasaye wabakuukanyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamusaaya, naye nafuchiilila okhuhaabakhwe, nahulila okhusaayakhwe, namukalusia eYerusalemu muburuchibwe. Mana Manase namanya mbu OMWAMI niye Nyasaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwa ako, yaswalila litookho liaDaudi olukoba lundi Iwelwanyi, elubeka lwaGihoni mumbo, mwibanda, okhuula khubwinjililo bweshilibwa shietsinyeeni; nalubotokhasia Ofeli, nalukhola lube olurambi muno; naramwo abaseesia belihe mumataala kosi ketsingoba kaYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayiniamwo abanyasaye abacheni, neshifwanani shiabutswa tsana eshiali munzu yOMWAMI, nebimalilo biosi ebia yali niyoombashila mushikulu shieinzu yOMWAMI, kata muYerusalemu, nabirusia mwitookho pe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakasia khandi eshimalilo shiOMWAMI, namalilakhwo emisango chiokhwishia nechiokhuupa orio, nalaka Yuda okhukhalabanila OMWAMI, Nyasaye waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandu bali nibashimalilanga emisango habundu aheechingu, habula khuMWAMI Nyasaye wabwe yenyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaManase, neisaalaye eya yasaaya Nyasayewe, namakhuwa kabalakusi abamuboolela muliira liOMWAMI, Nyasaye waIsiraeli, lole, kahandiikwa mumakhuwa kabaruchi baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayo isaalaye, khandi shinga olwa Nyasaye yafuchiilila okhuhaabakhwe, nakobwonoonibwe bwosi nobukhayibwe, naka habundu hosi aha yoombakha habundu aheechingu, naha yasinjisia emiAshera nebifwanani ebibaatse, narashiayeetiitiyia omwene ta; lola, kahandiikwa muMakhuwa kAbanabii. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Manase nakona nalonda khubakuukanyene, nibamuyabila munzuye; naye Amoni omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaAmoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni yali owemiyika amakhumi kabili nachibili olwa yachaaka okhuruka; naruchila eYerusalemu emiyika chibili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
            "verseOrgIds": [
              "2CH.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amabii mumoni tsiOMWAMI, shinga Manase samwana olwa yakhola; Amoni nabimalila emisango ebifwanani ebibaatse ebio biosi ebia Manase samwana yakhola, nabikhalabanila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shiyayeetiitiyia omwene imbeli wOMWAMI, shinga Manase samwana olwa yeetiitiyia ta; habula Amoni oyo yali nameetanga butswa okhukhaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abasumbabe nibamusanjilila, nibamwirila munzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.24",
            "verseOrgIds": [
              "2CH.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abandu beshialo beera abo bosi abali nibamusanjiliile emuruchi Amoni; abandu beshialo nibamwemekha Yosia omwanawe, abe omuruchi mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.25",
            "verseOrgIds": [
              "2CH.33.25"
            ]
          }
        }
      ]
    }
