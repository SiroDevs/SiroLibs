        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaYoashi waYuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Yoashi yali owemiyika musaafu olwa yachaaka okhuruka; naruchila eYerusalemu emiyika amakhumi kane; ne eliira lianyina liali Zibia oweBeeri-sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yoashi nakhola akali amalayi mumoni tsiOMWAMI tsindaalo tsiosi tsiaYehoyada omukuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyada namukhweesia abakhasi babili; niyeebula abaana abasinni nabakhaana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo Yoashi yarakhwo omwoyo okhukasia inzu yOMWAMI aha yabiiha. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakhung'aasia abakuhani nabaLawi, nababiila mbu Tsie mumataala kaYuda, musolole muIsiraeli yosi amapeesa akokhukasilinjia inzu yaNyasaye weenywe omuyika buli muyika; ne mbu mwanguyilisie. Nebutswa abaLawi shibayaanguha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi nalanga Yehoyada omukhulundu, namureeba ari Mbushiina norayeenyilenje mbu abaLawi baroosie muYuda naYerusalemu amapeesa koburoosii bwaMusa omusumba w, nobwomukhung'aano kwaIsiraeli, khulwa liheema lioburumbusi, ta? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abaana baAtsalia, omukhasi oyo omumayaanu, bali nibafunaache inzu yaNyasaye; nebindu biosi ebiahule ebiomunzu yOMWAMI babiheelesia emiBaali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omuruchi yalaka, nibakhola lisanduku, nibalirenjekha elwznyi, hashilibwa shieinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhupa omulome muYuda naYerusalemu mwosi, okhuleerela OMWAMI akoburoosii obwa Musa omusumba waNyasaye yatuushila Isiraeli mushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhulundu nabandu bosi nibeekhoya, nibakaleera nibakafuuba mwisanduku okhuula olwa bali nibamalile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa lisanduku lialeerelungwa abakali bomuruchi mumakhono kabaLawi, nibakhalola mbu kalimwo amapeesa amanji, omuhandiichi womuruchi nomukali womukuhani omukhulundu beetsanga nibatsukha akali mwisanduku, nibalibukula nibalikalusia habundu walio. Nolwa bakholanga inyanga buli nyanga, nibakhung'aasia amapeesa amanji. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuruchi naYehoyada bakakaama mumakhono ka abo abakhola emilimo chiobukhalabani bweinzu yOMWAMI; nibahandiika aboombashilanga amachina nende ababaatsi okhukalusia inzu yOMWAMI habwene, khandi nende abakholelanga eshibia nomukasa, okhukalusia inzu yOMWAMI habwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abakholi nibakhola, emilimo chiabwe nichitsiililila bulayi, nibasinjisia inzu yaNyasaye habwene, nibachimeetela amaani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibamalilisiye, baleera amapeesa akali nikatong'ile imbeli womuruchi nende Yehoyada; nako kakholwa ebimanulwa bieinzu yOMWAMI, khulwa obukhalabani, khandi khulwa emisango emisambe, netsingaye tsiamalesi kelibuuliesi, nebimanulwa bieitsahaabu nebieifeetsa. Bali nibamalilanga emisango emisambe munzu yOMWAMI khatsotselo, tsindaalo tsiosi tsiaYehoyada.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Yehoyada yakofula muno, naba omuyindifu wemiyika eminji, nafwa; yali owemiyika eshikhumi namakhumi kataru olwa yafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamuyabila mwitookho liaDaudi, hakari wabaruchi, shichila yali nakholanga amalayi muIsiraeli, nokhuNyasaye, nende khunzuye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olunyuma Iwokhufwa khwaYehoyada abakhulundu baYuda nibeetsa, nibamwinamila omuruchi. Mana omuruchi nabahulila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibalekha inzu yOMWAMI, Nyasaye wabakuuka babwe, nibakhalabanila emiAshera nende ebifwananioburima nibukwila Yuda naYerusalemu khukva eshikha shiabwe eshio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa yabarumila abanabii, okhubakalusia khuMWAMI; abo nibabarumbulila akobuloli; ne shibareka amarwi khuko ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Roho waNyasaye niyeenjila muZakaria waYehoyada, omukuhaninasinjila hekulu wabandu, nabasunjila mbu Kano niko aka Nyasaye aboola; mbu Mbushiina nimukhayanga amalako kOMWAMI, oburanyala okhukaasa ta? Okhuba mumuleshile OMWAMI, naye yesi amuleshile inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamusanjilila, nibamulasa namachina, khwilako liomuruchi, mulwanyi Iweinzu YOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho ario Yoashi shiyeetsulila eshisa eshia Yehoyada samwana Zekaria yamukholela ta; ne yeera omwanawe bwira. Nolwa yali nafwitsanga yaboola mbu OMWAMI alole, nalibanza!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubumaliilishi bwomuyika okwo, lihe liabaSiria liatikulukha okhumuseera Yoashi; niliula eYuda naYerusalemu, nilimalilana abakhulundu bosi babandu abarula mubo, niliyila ebiyaayo biabwe biosi ewomuruchi waDamasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata olwa lihe liabaSiria lieetsa, nilili nomukanda omutuutu kwabandu, OMWAMI yahaana lihe likhongo muno mumukhono kwalio shichila bali nibalekha OMWAMI, Nyasaye wabakuuka babwe. Nilwo olwa bamukuuma Yoashi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibamurulilekhwo, nibamulekha nasaalilanga muno, abasumbabe bamusanjilila khulwa amabanga komwana waYehoyada omukuhani, nibamwirila khushitalishie, nafwa; nibamuyabila mwitookho liaDaudi, nebutswa shibamuyabila mushihembekho shiabaruchi ta. ",
          "type": "text",
          "attrs": {
