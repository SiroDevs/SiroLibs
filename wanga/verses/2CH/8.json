    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebikhole bindi biaSulemani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma wemiyika amakhumi kabili, echia Sulemani yali niyoombashiilemwo inzu yOMWAMI nende inzu yiye omwene, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.1",
            "verseOrgIds": [
              "2CH.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani yoombakha khandi amataala aka Huramu yali niyamuheelesia, namenyiamwo abaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.2",
            "verseOrgIds": [
              "2CH.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani natsia eHamatsi-zoba, nalihula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.3",
            "verseOrgIds": [
              "2CH.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoombakha Tadimori mushitsiimi, namataala kamabiishilo, aka yoombashila muHamatsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.4",
            "verseOrgIds": [
              "2CH.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyoombakha nende Betsi-horoni liemukulu, nende Betsi-horoni liemwalo, amataala ketsingoba, akali netsingoba nebilibwa nemiyinjiilo; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.5",
            "verseOrgIds": [
              "2CH.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "naBaalatsi, namataala kosi kamabiikho aka Sulemani yali ninako, namataala kosi kamakaarike namataala kabandube abachendela khufarasi, nakosi aka Sulemani yali niyeenya okhuumbakha eYerusalemu, nomuLebanoni, nomushialo shiosi shioburuchibwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.6",
            "verseOrgIds": [
              "2CH.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu bosi abali nibatong'ile khubaHiti, nabaAmori, nabaPerizi, nabaHiwi, nabaYebusi, abo abarali abokhubaIsiraeli ta, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.7",
            "verseOrgIds": [
              "2CH.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "abokhubaana babwe abatong'a inyuma wabwe mushialo, aba abaana baIsiraeli baramalilana ta, mubeenabo Sulemani yakhung'aasia omukanda kwabakholi abalunyibwa, kata okhuula olwa leelo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.8",
            "verseOrgIds": [
              "2CH.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula khubaana baIsiraeli, Sulemani shiyabakhola babe abakholi abalunyibwa ta; nebutswa nibo abali abelihebe, nabakhulundu babaseesiabe, nabasinjilili bamakaarike, nabachendela khufarasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.9",
            "verseOrgIds": [
              "2CH.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibo abali abakali bomuruchi Sulemani, ebikhumi bibili namakhumi karaano, abasinjilili babandu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.10",
            "verseOrgIds": [
              "2CH.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sulemani natikulusia omukhaana waFarao okhurula mwitookho liaDaudi, namwinjisia munzu eya yali niyamuumbashila; okhuba yasunga mbu Omukhasi wanje shialamenyanga munzu yaDaudi omuruchi waIsiraeli ta, shichila habundu aha lisanduku liOMWAMI liitsile nahatakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.11",
            "verseOrgIds": [
              "2CH.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sulemani namalila OMWAMI emisango emisambe khushimalilo shiOMWAMI, eshia yali niyoombakha imbeli weshirookoola, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.12",
            "verseOrgIds": [
              "2CH.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "akakhoyela buli nyanga shinga olwa kali, nachimalanga nalonda lilako liaMusa, khutsisabato, nokhukhuchaaka khwemiesi, nokhunduukho tsiamasabo, khataru buli muyika, mbu khwisabo liemikaate echibulamwo amamela, nokhwisabo liamahonga, nokhwisabo liamatili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.13",
            "verseOrgIds": [
              "2CH.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi, obulachilisii bwaDaudi shinga olwa bwali, yaraho emikanda chiabakuhani khubukhalabani bwabwe, nabaLawi khukabaleshelwa akobwitsoomii nobukhalabani imbeli wabakuhani, akakhoyela buli nyanga shinga olwa kali; nabalindi beshilibwa bosi, mumikanda chiabwe khubuli shilibwa; okhuba nolwa Daudi omundu waNyasaye yali niyalaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.14",
            "verseOrgIds": [
              "2CH.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata shibeebera okhurula khwilako elia omuruchi yalaka abakuhani nabaLawi mwikhuwa liosi, kata mukamabiikho ta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.15",
            "verseOrgIds": [
              "2CH.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho emilimo chiosi chiaSulemani chiakholwa chirio, okhurula khunyanga yokhuupa omuse kweinzu yOMWAMI okhuula olwa chiali nieluhweele. Inzu yOMWAMI niyimalilisibwa yirio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.16",
            "verseOrgIds": [
              "2CH.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Sulemani natsia eEzioni-geberi, nende eElotsi, khulukuku Iweinyanza mushibala shiaEdomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.17",
            "verseOrgIds": [
              "2CH.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Huramu namuleerela amaaro mumakhono kabasumbabe, nende abasumba abamanya akeinyanza; nibatsia eOfiri halala nabasumba baSulemani, nibeendayo tsitalanda ebikhumi bine namakhumi karaano tsieitsahaabu, nibachileerela omuruchi Sulemani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.8.18",
            "verseOrgIds": [
              "2CH.8.18"
            ]
          }
        }
      ]
    }
