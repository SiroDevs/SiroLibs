  "bookId": "2CH",
  "reference": "2 Aketsindaalo 31",
  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "2CH 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ako kosi olwa kahwa, abaIsiraeli bosi abali nibaliho barula nibatsia mumataala kaYuda, nibasasaka tsisiilo tsisongookhu, nibaremaka emiAshera, nibalikulula habundu aheechingu hosi nebimalilo muYuda yosi, naBenyamini, nomuEfuraimu naManase, okhuula olwa bali nibabimuluule biosi. Mana abaana baIsiraeli nibakalukha buli mundu mundalotsie, mumataala kabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia yakasilia abakuhani nabaLawi kosi akeenyekha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.1",
            "verseOrgIds": [
              "2CH.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia naraho tsing'anda tsiabakuhani nabaLawi, okhulonda khung'anda tsiabwe, buli mundu obukhalabanibwe shinga olwa bwali, abakuhani nabaLawi bombi, khulwa emisango emisambe nemisango chiokhwishia, okhukhalabana nokhuupa orio, nokhwitsoomia mubilibwa bieikambi yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukabo kwomuruchi okwokhumianduchie kwali khulwa emisango emisambe, mbu emisango emisambe chiomutsuli nomungoloobe, nemisango emisambe chietsisabato, nechiokhuchaaka khwemiesi, nechietsinduukho tsiamasabo, shinga olwa kahandiikwa mumalako kOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi yalaka abandu abamenyanga eYerusalemu okhuhaananga omukabo kwabakuhani nabaLawi, mbu beehaanile amalako kOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa lilako elo liatswana ebulafu, abaana baIsiraeli bahaana ebindu ebinji, mbu ebirongole bieimele, neidivai, namafura, nobuushi, nebiamameeto kosi kemikunda; kata eshitonye shielikhumi shia ebio biosi, bali nibaleeranga muno muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli naYuda abamenya mumataala kaYuda, bosi baleeranga eshitonye shielikhumi shietsing'ombe namakondi, neshitonye shielikhumi shiebindu ebiahule, ebiaahulilwa OMWAMI Nyasaye wabwe, nibabiraho ebituuli ebituuli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwesi kwakhataru bachaaka okhubunjikha ebituuli tsana, nibabimalilisia mumwesi kwomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa Hezekia nabakhulundu beetsa, nibalola ebituuli ebio, bamwitsoomia OMWAMI, nende abandube Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hezekia nareebelesia abakuhani nabaLawi khumakhuwa kebituuli tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Azaria omukuhani omukhulundu, owali weinzu yaZadoki, yakalusia namusunjila mbu Okhurula olwa abandu bachaaka okhuleeranga ebihaanwa munzu yOMWAMI, khuliitsanga nikhwikura, nibitong'a ebinji; okhuba OMWAMI yaheelesiye abandube ikhabi; nabio ebisikaale nibio ebili mwibiishilo lino likhongo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hezekia nalaka mbu ebisika bikasibwe munzu yOMWAMI; nibabikasia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleeramwo nobwisiikwa ebihaanwa nebitonye bielikhumi nebindu ebiahuulwe; naye Konania naba omusinjilili wabio, Shimei omwana wabwe naba owakhabili khuye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Yehieli, Azazia, Nahatsi, Asaheli, Yerimotsi, Yozabadi, Elieli, Isimakhiya, Mahatsi, naBenaya bali abanyapara, okhukhoonya Konania naShimei omwana wabwe, nibareebwaho nende Hezekia omuruchi nende Azaria omusinjilili weinzu yaNyasaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Kore waImina, omuLawi, omulindi weshilibwa shiebukwe, yasinjilila ebio ebiahaanilwa Nyasaye khulwa okhuchama, okhukabanga tsisadaka tsiOMWAMI, nebindu ebiashila obutakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abamukhoonyanga mumataala kabakuhani bali Edeni, Miniamini, Yeshua, Shemaya, Amaria, naShekania, abeesichilwa okhukabiranga abaana babwe mung'anda tsiabwe, ari abakhongo ari abatuutu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula abo ababalilwa khubulondokhani bwetsinzibulo, abeshisaatsa okhurula khubemiyika chitaru nokhushilaho, buli mundu owali niyeenjilanga munzu yOMWAMI, obuha bwemilimo chiabuli nyanga shinga olwa bwali, khulwa obukhalabani obwa baleshelwa mung'anda tsiabwe; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuhani babalilwa mubilibwa biabwe; nabaLawi okhurula khubemiyika amakhumi kabili nende abashilaho, khulwa echio echiabaleshelwa mung'anda tsiabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.17",
            "verseOrgIds": [
              "2CH.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babalilwa nende abayia babwe, abakhasi babwe, abaana babwe abasiani, nabaana babwe abakhaana, omukhung'aano kwosi; okhuba bali abeesiikwa okhwilinda mubutakatifu bwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.18",
            "verseOrgIds": [
              "2CH.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa abaana baHaruni abakuhani, abali nibali mumikunda chiobwayilo bwamataala kabwe, mubuli taala elala elala balimwo abandu aba ameera kabwe karumbulwa okhubakabilanga emikabo abeshisaatsa bosi abali mubakuhani, nende bosi abali khubulondokhani bwetsinzibulo mubaLawi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nilwo olwa Hezekia yakhola muYuda yosi; ne yali nakholanga akali amalayi, akahabwene, akobwisiikwa imbeli w Nyasayewe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
              "2CH.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata mubuli mulimo okwa yasimikha mubukhalabani bweinzu yaNyasaye, nomumeebaalo nomumalako, okhukhaaba Nyasayewe, yakukhola nomwoyo kwosi, nakaasa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.21",
            "verseOrgIds": [
              "2CH.31.21"
            ]
          }
        }
      ]
    }
  ],
