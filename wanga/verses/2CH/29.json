    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwaHezekia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia yachaaka okhuruka olwa yali owemiyika amakhumi kabili nachjraano; naruchila eYerusalemu emiyika amakhumi kabili nashienda; ne eliira lianyina liali Abiya waZekaria. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amalayi mumoni tsiOMWAMI, kosi aka Daudi kuukanyene yakholanga shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekia yakalusia obukhalabani obwomuhekalu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwambeli okwoburuchibwe, mumwesi kwambeli, yeekula emiliango chieinzu yOMWAMI, nachikasia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyeenjisiamwo abakuhani nabalawi, nabakhung'aasilia hashikuuri eshibambalifu eshiali ebukwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nababoolela mbu Mumbulile, iny ve abaLawi! Bulaano mwiyahule, nimwahula inzu yOMWAMI, Nyasaye wabakuuka beenywe, nimuchinga eshifwabwi shino shiosi shirule habundu ahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abakuuka beefwe bakhola obukhayi, nibakhola akali amabii mumoni tsiOMWAMI Nyasaye weefwe, nibamulekha, nibafutarila eshimenyo shiOMWAMI, nibashikhupa omukongo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bayeekala emiliango chieshirookoola, nibasimia tsitaha, nibarasambila Nyasaye waIsiraeli amalesi kelibuuliesi kata okhumumalila emisango emisambe habundu ahatakatifu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila oburima bwOMWAMI nibuba khuYuda naYerusalemu, naye nabahaanile okhwikhola eshiriisio, eshiokhuhuchisia mubandu, eshiokhunyokhoosibwa, shinga olwa mulola netsimoni tsieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba lole, abapapa bakwisiibwe nolukanga, abaana beefwe abasiani nabakhaana nende abakhasi beefwe nibali mubuhambe khulwa kano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne bulaano omwoyo kwanje kwenya okhukhola indakano nende OMWAMI, Nyasaye waIsiraeli, mbu oburimabwe obululu bushiukhane bukhurulekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baana banje bulaano muraleka ta; okhuba OMWAMI yamulobola inywe okhusinjilanga imbeliwe, okhumukhalabanila, mbu mubeetsenje abakhalabanibe nimumusambila amalesi kelibuuliesi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaLawi nibabuukha, mbu Mahatsi waAmatsi, naYoeli waAzaria, khubaana babaKohatsi; nokhubaana baMerari, Kishi waAbudi naAzaria waYehaleleli; nokhubaGerishoni, Yoa waZima naEdeni waYoa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12",
            "verseOrgIds": [
              "2CH.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhubaana baElizafani, Shimiri naYeueli; nokhubaana baAsafu, Zakaria naMatania; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.13",
            "verseOrgIds": [
              "2CH.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nokhubaana baHemani Yehueli naShimei; nokhubaana baYedutsuni, Shemaya naUzieli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.14",
            "verseOrgIds": [
              "2CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakhung'aasia abaana babwe, nibeeyahula, nibeenjila, lilako liomuruchi khulwa amakhuwa kOMWAMI shinga olwa liali, okhusiiya inzu yOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abakuhani nibeenjila mubitonye bieinzu yOMWAMI ebiomukari, okhubisiiya, nibarusiamwo ebiobukaali biosi ebia banyoola muhekalu yOMWAMI, nibabileera mulwanyi Iweinzu yOMWAMI. Nabo abaLawi nibabibukula, nibabichinga okhuyila ebulafu khumuchela kwaKederoni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bachaaka okhwahula khunyanga yambeli eyomwesi kwambeli, ne khunyanga yomunaane boola khushirookoola ShiOMWAMI; nibaahula inzu yOMWAMI tsindaalo munaane; mana khunyanga yekhumi nakhasasaba eyomumwesi kwambeli bamalilisia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibeenjila ewaHezekia omuruchi, munzu, nibaboola mbu Khumalile okhusiiya inzu yOMWAMI yosi, nende eshimalilo shiemisango emisambe, nebimanulwa biashio biosi, neimeesa yemikaate chiokhubaho, nebimanulwa biayo biosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata nende ebimanulwa ebio biosi ebia omuruchi Ahazi yasukuna mundaalo tsioburuchibwe olwa yoonoona, khubikasiye nikhubiahula; lola, biliho imbeli weshimalilo shiOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hezekia omuruchi nahuuna mumabwibwi, nakhung'aasia abakhulundu belitookho, nibatikulukha nibatsia enanzu wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batsia nibali nende tsisurusi musaafu, namamiiku musaafu, namakondi kebimwamwane musaafu, netsikhole musaafu, bibe omusango kwobwonooni khulwa oburuchi, khandi khulwa habundu ahatakatifu khandi khulwa Yuda. Nalaka abakuhani abaana baHaruni okhubimalila khushimalilo ShiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibeera tsisurusi, abakuhani nibabukula amalasile, nibakooha khushimalilo; nibeera amamiiku, nibooha amalasile khushimalilo; nibeera nende amakondi kebimwamwane, nibooha amalasile khushimalilo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaleera tsikhole tsiomusango kwobwonooni imbeli womuruchi nomukhung'aano; nibatsirakhwo amakhono; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "abakuhani nibatsiira, nibakhola amalasile katsio omusango kwobwonooni, khushimalilo, okhutisa Isiraeli yosi; okhuba omuruchi yalaka mbu omusango omusambe nomusango kwobwonooni chibe echia Isiraeli yosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naraho abaLawi munzu yOMWAMI, nibali nende ebisili namatungu nobukhana, lilako liaDaudi shinga olwa liali, nende eliaGadi omulakusi womuruchi, nende Natsani omunabii; okhuba lilako elo liali eliOMWAMI, muminwa chiabanabiibe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaLawi nibasinjila, nibali nende ebimanulwa biobukhana biaDaudi, nabakuhani nibali nende tsitarumbeta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nalaka mbu omusango omusambe kumalilwe khushimalilo. Nolwa omusango omusambe kwachaaka okhumalwa, olwimbo lWOMWAMI nalwo lwachaaka okhwimbwa, netsitarumbeta, halala nebimanulwa tsana biaDaudi omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukhung'aano kwosi nibamwinamila OMWAMI, abeembi nibeemba, abetsitarumbeta nibakhupa; ako kosi nikatsiililila kario okhuula olwa omusango omusambe kwali nikuhweele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa bali nibamalile okhukumala, omuruchi nende bosi abali nibaliho halala ninaye nibasikama nibamwinamila OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Hezekia omuruchi nende abakhulundu nibalaka abaLawi okhwimbila OMWAMI nibamwitsoomia mumakhuwa kaDaudi, nakaAsafu omulakusi. Nibeemba akobwitsoomii nobusangafu, nibabunamia emirwe nibamwinamila OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hezekia nasunga mbu Olwa bulaano mwiyahuliile OMWAMI, site ahambi nimuleera emisango nebihaanwa biokhuupa orio munzu yOMWAMI. Abomukhung'aano nibaleeramwo emisango nebihaanwa biokhuupa orio; nabo abali nende omwoyo kwobwihaani nibaleera emisango chiekhusambwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nobunji bwemisango emisambe echia abomukhung'aano baleera bwali tsisurusi amakhumi musaafu, namamiiku eshikhumi, namakondi kebimwamwane ebikhumi bibili; ebio biosi biali biemisango emisambe chiOMWAMI ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebihaanwa ebiahule biosi biali tsing'ombe ebikhumi bisasaba namakondi ebikhumila bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abakuhani bali abatuutu, abarahela okhubaaka emisango emisambe echio chiosi ta; kho okhuula olwa abaliuhani bali nibeeyahuule, abaana babwe abaLawi babakhoonya, okhuula olwa emilimo chiali nichihweele; okhuba abaLawi bali abakololofu mumwoyo okhwiyahula okhushila abakuhani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emisango emisambe chiali eminji muno, Khandi kaliho amasinya kemisango chiokhwishia, nemisango chiokhutsushila echia buli musnngo omusnmbe. Nindio obukhalabani bweinzu yOMWAMI bwakalusibwa habwene burio. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hezekia niyeekhoya, nabandu bosi, khulwa ako aka OMWAMI yali nakasiliye zbandu; okhuba likhuwa elo lieekhola meetsukhana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
