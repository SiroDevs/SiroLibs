    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bwa Uzia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaYuda bosi babukula Uzia, owali nali owemiyika ekhumi nachisasaba, nibamwemekha abe omuruchi mushilenje shiaAmazia samwana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.1",
            "verseOrgIds": [
              "2CH.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ye yoombakha Elotsi, nalikalusilia Yuda, olwa omuruchi yali nakonile, nalonda khubakuukanyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.2",
            "verseOrgIds": [
              "2CH.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia yali owemiyika ekhumi a nachisasaba olwa yachaaka okhuruka, naruchila emiyika amakhumi karaano nachibili muYerusalemu; ne eliira lianyina liali Yekolia oweYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.3",
            "verseOrgIds": [
              "2CH.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yakhola akali amalayi mumoni tsiOMWAMI, kosi aka Amazia samwana yali nakholanga shinga olwa kali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.4",
            "verseOrgIds": [
              "2CH.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yarakhwo omwoyo okhukhaaba Nyasaye mundaalo tsiaZakaria, owamwibaalilanga okhuria Nyasaye; ne olwa yali nashikhaabanga OMWAMI, Nyasaye yamunyalila okhukaasa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.5",
            "verseOrgIds": [
              "2CH.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yarula natsia okhuseera abaFilisiti, nalikulula olukoba lwaGatsi, nolukoba lwaYabune, nolukoba lwaAshidodi; niyoombakha amataala mushialo shiaAshidodi, nende mubaFilisiti. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.6",
            "verseOrgIds": [
              "2CH.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyasaye namunyalila okhuseera abaFilisiti, khandi okhuseera abaArabu abamenya eGuribaali, nende abeMeuni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.7",
            "verseOrgIds": [
              "2CH.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaAmoni baleerela Uzia emiruulu; eliiralie liafumanga kata okhuula khulwakho lwaMisiri; okhuba amaanike kameetekha muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.8",
            "verseOrgIds": [
              "2CH.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Uzia yoombakha eminaara eYerusalemu, hashilibwa eshili khukoona, nende hashilibwa shielibanda, naha olukoba lukotolela, nachikholela tsingoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi niyoombakha eminaara mushitsiimi, nayaba amayabo amanji kamatsi, okhuba yali nemiruko eminji muShefela nomumuhololokhwe. Khandi yali nende abalimi nabalindi bemitsabibu mubikulu, nomumikunda eminulu; okhuba y aheelanga akobulimi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Uzia yali nelihe liabaseeri, abatsiitsanga okhuseera ing'anda ing'anda, obunji shinga olwa bwali obwa babalwa nende Yeieli omuhandiichi naMaaseya omukali, nibalakwa nende Hanania, mulala owokhubaseesia bomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunji bwosi bwabeemilisi bebilibwa obwabandu abalulu beitswoni, bwali ebikhumila bibili nebikhumi bisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo bali abasinjilili belihe liabandu ebikhumila ebikhumi bitaru namusaafu nebikhumi biraano, abaseeranga namaani amanji, okhukhoonya omuruchi okhuseera abasuku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Uzia nabarecheshela abelihe elo liosi ebikhumba, namafumo, netsikuutwa, nebitsengwa, nobuyingo, namachina keimburusi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "MuYerusalemu yakhola emikooro chindi echiakoorwa nabandu abasitsa, chibe khuminaara nokhulukoba hekulu, echiokhulasila ebisele namachina amakhongo. Eliiralie liafumanga ehale; okhuba yanyalilwa muno, okhuula olwa yaba owamaani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yali niyakhaba owamaani, omwoyokwe kweechinjimisia, niyoonoonekha, nakhaya OMWAMI Nyasayewe; okhuba yeenjila muhekalu yOMWAMI okhusambila amalesi kelibuuliesi khushimalilo shiamalesi tsana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Azaria omukuhani yamulondakhwo niyeenjila, halala nabakuhani bOMWAMI amakhumi munaane abali abeitswoni; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibamukaya Uzia omuruchi, nibamusunjila mbu Uzia, shikali khwiwe okhusambila OMWAMI amalesi kelibuuliesi ta, habula khubakuhani abaana baHaruni, abaahulwa okhusambanga amalesi kelibuuliesi. Rula habundu ahatakatifu; okhuba oyiirile; kata lino shililakhuleerela oluyali okhurula khuMWAMI Nyasaye ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.18",
            "verseOrgIds": [
              "2CH.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Uzia natiilwa oburima; ne yali neshikaye mumukhono eshiokhusambilakhwo amalesi kelibuuliesi; ne olwa yatiililwa abakuhani oburima, obuchele bwarombokha khubwenibwe imbeli wabakuhani munzu yOMWAMI, hashimalilo shiamalesi kelibuuliesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.19",
            "verseOrgIds": [
              "2CH.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azaria omukuhani omukhulundu nabakuhani bosi nibamuhenga, ne lola, mbwobwo, obuchele khubweni! Nibamurusiamwo bwangu; kata ye omwene yaanguha okhurula, shichila OMWAMI yali namuupile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.20",
            "verseOrgIds": [
              "2CH.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzia omuruchi naba owobuchele okhuula khunyanga yokhufwakhwe, namenyanga munzu yindi yenyene, nali owobuchele; okhuba yeekalilwa obureenjila munzu yOMWAMI ta. Naye Yotsamu omwanawe yali nasinjililanga itookho, nayaasia abeshialo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.21",
            "verseOrgIds": [
              "2CH.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaUzia, okhurula khukambeli okhuula khukahelelesia, Isaya omunabii, omwana waAmozi, yakahandiika. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.22",
            "verseOrgIds": [
              "2CH.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Uzia nakona, nalonda khubakuukanyene; nibamuyabila halala nabakuukanyene, mumukunda kweshihembekho eshiali shiabaruchi; okhuba basunga mbu Nowobuchele. Naye Yotsamu omwanawe naruka mushilenjeshie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.23",
            "verseOrgIds": [
              "2CH.26.23"
            ]
          }
        }
      ]
    }
  ],
