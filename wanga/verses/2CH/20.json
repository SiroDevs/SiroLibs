            "number": "31",
            "style": "v",
            "sid": "2CH 20:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nindio Yehoshafati yaruka Yuda; yali owemiyika amakhumi kataru nachiraano olwa yachaaka okhuruka; naruchila eYerusalemu emiyika amakhumi kabili nachiraano; ne eliira lianyina liali Azuba waShilihi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.31",
            "verseOrgIds": [
              "2CH.20.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 20:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yachendanga khunjila yaAsa samwana, nareebera okhuchirulakhwo ta, nakhola akali habwene mumoni tsiOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.32",
            "verseOrgIds": [
              "2CH.20.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 20:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa habundu aheechingu shiharusibwaho ta; kata abandu bali nibarashiarakhwo omwoyo khuNyasaye wabakuuka babwe tawe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.33",
            "verseOrgIds": [
              "2CH.20.33"
            ]
          }
        }
      ]
    },
    {
