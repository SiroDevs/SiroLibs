            "number": "34",
            "style": "v",
            "sid": "2CH 20:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYehoshafati, okhurula khukambeli okhuula khukahelelesia, kahandiikwa mumakhuwa kaYehu waHanani, akali mushitabu shiaharuchi baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.34",
            "verseOrgIds": [
              "2CH.20.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
