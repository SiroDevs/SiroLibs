    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oburuchi bzuaYehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
