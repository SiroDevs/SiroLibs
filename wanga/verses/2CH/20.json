          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho eshialo shioburuchi bwaYehoshafati shialeenjeela; okhuba Nyasayewe yamuheelesia obuhuluushi tsimbeka tsiosi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.20.30",
            "verseOrgIds": [
              "2CH.20.30"
            ]
          }
        }
