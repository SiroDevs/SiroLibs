              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibaba nibakhwonoonela okhuba abulaho ouroonoonakhwo tanawe nobatiililwa oburima nobahaana khubasuku, nabo nibabahamba imbambe nibabayila mushialo kata eshiehale kata eshiahambi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
