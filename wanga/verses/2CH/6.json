          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandubo nibaba nibarula okhuseera abasuku babwe, khunjila yosi yosi eya olabarumilakhwo, nibakhusaaya nibahenjile khwitookho lino elia waloboole, khandi khunzu eya enyumbashiile eliiralio; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
