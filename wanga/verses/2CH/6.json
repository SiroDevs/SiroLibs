          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ewa oli mwikulu ohulile isaala yabwe nokhusaaya khwabwe, notorela, eshifune shiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
