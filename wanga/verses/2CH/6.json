          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ewa oli mwikulu, mushimenyoshio, ohulile isaala yabwe namasaayo kabwe, noterela eshifune shiabwe; noleshela abandubo abakhwonooneele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        },
