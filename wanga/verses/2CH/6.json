          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaba nibakhukalushila nomwoyo kwosi neshiimo shiosi mushialo tsana shiobuhambe bwabwe ewa babayila mumbambe, nibasaaya nibahenjile eshialo shiabwe, eshia waheelesia abakuuka babwe, nelitookho elia walobola, neinzu eya enyumbashiile eliiralio; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
