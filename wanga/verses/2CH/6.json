          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi khumakhuwa komucheni, ourali owokhubandubo Isiraeli ta, olwa alaba narulile mushialo shiehale khulwa eliiralio likhongo nomukhonokwo kwamaani, nomukhonokwo okunyiililwe okhuhonia; olwa baleetsa nibasaaya nibahenjile khunzu yino; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho ewa oli mwikulu mushimenyoshio, ohulile, nokhola kosi aka omucheni tsana aba nakhuhaabilila; mbu abetsimbia tsiosi etsiomushialo bamanye eliiralio nibakhuria, shinga abandubo Isiraeli; khandi mbu bamanye shinga inzu yino eya enyumbaashe olwa yikulikhwa khuliiralio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
