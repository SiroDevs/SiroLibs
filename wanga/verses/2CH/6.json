              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzala niyiba niyakhaba mushialo, oluumbe nilwakhabamwo, kata emimela okhukwa amatere, kata ebikhwalo, kata tsisiche, kata tsikhungu; abasuku nibaba nibakhabeekalila mumataala kabwe; amanyasio kosi kosi, kata obulwale bwosi bwosi obubaho; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "isaala yosi yosi nokhusaaya khwosi khwosi okhusaaywa nomundu yesi, kata nabandubo bosi Isiraeli, nibamanyile buli mundu amanyasioke namatinyuke omwene, buli mundu nakalishila inzu yino amakhono; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana ewa oli mwikulu, mushimenyoshio, ohulile, nobaleshela, nobakalusia buli mundu ebiimabie shinga olwa bili, olwa omanyanga akomwoyokwe; okhuba iwe niwe wenyene oumanyanga emioyo chiabaana babandu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbu bakhuriitsenje nibachenda khunjilatsio tsindaalo tsiosi olwa bamenya mushialo eshia waheelesia abakuuka.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
