          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne nibaba nibeetsulila, nibali mushialo tsana ewa bayilwa mumbambe, nibeekalukhasia nibakhusaayila ebweneyo mushialo shiobuhambe bwabwe, nibasunga mbu Khwayoonoonile, nikhukhola akobukhayikhaonu; khwakholile obubii; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
