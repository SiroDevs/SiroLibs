        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaHezekia, nakebikholebie ebilayi, lole, kahandiikwa mwibisulo liaIsaya omunabii, omwzna waAmozi, mushitabu shiabaruchi baYuda naIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekia nakona, nalonda khubakuukanyene; nibamuyabila hashitikulukho shieshihembekho shiabaana baDaudi; nabo abaYuda bosi nabeYerusalemu nibamuheelesia oluvali khukhufwakhwe. Naye Manase omwanawe naruka mushilenieshie.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
      ]
    }
