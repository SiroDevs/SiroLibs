    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosia yachila Ipasaka niyiliibwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 35:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosia yakholela ipasaka yOMWAMI eYerusalemu; nibeera amakondi keipasaka khunyanga yekhumi nakhane eyomumwesi kwambeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naraho abakuhani mumilimo chiabwe, nabatinyisia mubukhalabani bweinzu yOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 35:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaboolela abaLawi abeechesinjia Isiraeli yosi, abali abatakatifu bOMWAMI, ari Mure lisanduku litakatifu munzu tsana eya Sulemani waDaudi omuruchi waIsiraeli yoombakha; kuleshe okhuba omusiiko khumabeka keenywe khandi ta; bulaano mukhalabanilenje OMWAMI Nyasaye weenywe nende abandube Isiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.3",
            "verseOrgIds": [
              "2CH.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana mwikasie, okhulonda khubilibwa bieenywe mumikanda chieenywe, lihandiiko liaDaudi omuruchi waIsiraeli shinga olwa lili, nelihandiiko liaSulemani omwanawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.4",
            "verseOrgIds": [
              "2CH.35.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 35:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musinjile habundu ahatakatifu, obwahukhani bwebilibwa biabaana beenywe, abarali abaLawi ta, shinga olwa buli; shibeho eshitonye shieshilibwa shiabaLawi khulwa buli shilibwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.5",
            "verseOrgIds": [
              "2CH.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana namwire amakondi keipasaka, nimwiyahula abeene, nimukasilia abaana beenywe, okhukhola kosi akelikhuwa liOMWAMI mumunwa kwaMusa shinga olwa kali.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 35:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 35:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Yosia naheelesia abandu abarali abaLawi ta ebiomubiayo, ebiamakondi nebietsimbusi, biosi ebiemisango chieipasaka khulwa bosi abali nibaliho, obunji bwabio nibuba ebikhumila amakhumi kataru, nende tsisurusi ebikhumila bitaru; ebio biali biemiandu chiomuruchi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.7",
            "verseOrgIds": [
              "2CH.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 35:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhulundube nabo nibahaana ebihaanwa ebia bachama okhuhaana, khubandu, nokhubakuhani, nokhubaLawi. Hilikia naZakaria naYehieli, abasinjilili beinzu yaNyasaye, baheelesia abakuhani ebindu biemisango chieipasaka, mbu ebiayo ebikhumila bibili nebikhumi bisasaba, netsing'ombe ebikhumi bitaru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.8",
            "verseOrgIds": [
              "2CH.35.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Konania yesi, naShemaya naNetsaneli, abaana babwe, naHeshabia naYeieli naYozabadi, abakhulundu babaLawi, nibaheelesia abaLawi ebindu biemisango chieipasaka, mbu ebiayo ebikhumila biraano netsing'ombe ebikhumi biraano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 35:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.9",
            "verseOrgIds": [
              "2CH.35.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 35:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho obukhalabani bwarechekhwa, abakuhani nibasinjila habundu wabwe, nabaLawi mumikanda chiabwe, lilako liomuruchi shinga olwa liali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibeera amakondi keipasaka, abakuhani nibooha amalasile aka babukula khumakhono kabwe, abaLawi nibabibaaka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.11",
            "verseOrgIds": [
              "2CH.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibara ebiemisango emisambe elubeka, mbu bachikabe ebituche biebilibwa biabandu abarali abaLawi ta shinga olwa biali, okhuhaanila OMWAMI, shinga olwa kahandiikwa mushitabo shiaMusa. Kata nende tsisurusi batsikhola bario. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.12",
            "verseOrgIds": [
              "2CH.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 35:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasamba amakondi keipasaka nomulilo, akobukhalachi shinga olwa kali; nabio ebihaanwa ebitakatifu babiteekha munyungu, nomutsikhafuka, nomutsiyamuunyu, nibabayilila abandu tsana bwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olunyumakhwo nibeekasilia ebiabwe abeene, nende ebiabakuhani; okhuba abakuhani abaana baHaruni banyakhananga okhumala emisango emisambe namasinya okhuula mushilo; khulwako abaLawi nibakasia ebiabwe nebiabakuhani abaana baHaruni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abeembi abaana baAsafu, bali habundu wabwe, lilako liaDaudi shinga olwa liali, nelia Asafu, naHemani, naYedutsuni omulakusi womuruchi; nabo abalindi baliho habuli shilibwa; shibali nende eshiachila nibarula mubukhalabani bwabwe ta, okhuba abaLawi abaana babwe babakasilia ebiabwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 35:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.15",
            "verseOrgIds": [
              "2CH.35.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho obukhalabani bwOMWAMI bwosi bwakasilibwa khunyanga ndala yeneyo, okhulia ipasaka, nokhumala emisango emisambe khushimalilo shiOMWAMI, lilako liomuruchi Yosia shinga olwa liali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.16",
            "verseOrgIds": [
              "2CH.35.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 35:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli abali nibaliyo nibalia ipasaka khushise eshio, nelisabo liemikaate echibulamwo amamela eliamala tsindaalo musaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.17",
            "verseOrgIds": [
              "2CH.35.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 35:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kata ipasaka eyafwana yirio shiyaliihwakhwo muIsiraeli khurula khundaalo tsiaSamweli omunabii ta; kata yabulaho khubaruchi baIsiraeli owakhola ipasaka shinga eyo eya Yosia yakhola, nabakuhani nabaLawi, nabaYuda naIsiraeli bosi abaliyo, nabeYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.18",
            "verseOrgIds": [
              "2CH.35.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumuyika kwekhumi namunaane okwomuburuchi bwaYosia nilwo olwa ipasaka eyo yaliibwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufwa khwaYosia",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 35:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.19",
            "verseOrgIds": [
              "2CH.35.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 35:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olunyuma lwa ako kosi, olwa Yosia yali namalile okhukasia ihekalu, Neko omuruchi waMisiri yatikulukha, natsia okhuseerela eKarikhemishi haEufurate; naye Yosia narula natsia okhuseerana ninaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.20",
            "verseOrgIds": [
              "2CH.35.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 35:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa yamurumila abarume, bari Nasi embeele endie ninawe, iwe omuruchi waYuda? Shinzitsile okhuseera iwe leelo ta, habula okhuseera inzu yeneyo eya esoolananga ninayo; ne Nyasaye yandachile okhwanguha. Lekha okhumuyinjila Nyasaye ouli ninasi, aleshe okhukhusishia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.21",
            "verseOrgIds": [
              "2CH.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa Yosia yaloba okhushiukhana okhumurulakhwo, habula yeekalula okhufwana lukano mbu alasane ninaye, narahulilakhwo amakhuwa kaNeko, akarula mumunwa kwaNyasaye, ta; ne yeetsa okhulasanila mwibanda liaMegido. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abobuyingo nibamulasa omuruchi Yosia; omuruchi naboolela abasumbabe ari Murusieho; okhuba efumiirwe butinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.23",
            "verseOrgIds": [
              "2CH.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abasumbabe nibamurusia mwikaari elo, nibamura mwikaari lindi eliakhabili elia yali ninalio, nibamuusia eYerusalemu; nafwa, nayabilwa mushiyembekho shiabakuukanyene. AbaYuda bosi naYerusalemu nibamwikhuula Yosia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.24",
            "verseOrgIds": [
              "2CH.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremia narecheshela Yosia olwikhuulu; abeembi bosi, abasaatsa nabakhasi, nibarumbula Yosia munzikhuulu tsiabwe, okhuula olwa leelo; nibatsikhola eshiima eshilachilisibwa muIsiraeli; kata lole, tsiahandiikwa muTsinzikhuulu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne amakhuwa kandi kaYosia, nakebikholebie ebilayi, ebialonda khukahandiikwa mumalako kOMWAMI, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
              "2CH.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 35:27"
          },
          "items": [
            {
              "text": "27",
