    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhuliibzoa khweIpasaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Hezekia nakhupila Isiraeli naYuda yosi omunwa, khandi nahandiichila Efuraimu naManase tsibarwa, mbu boole enanzu wOMWAMI eYerusalemu okhulia ipasaka yOMWAMI, Nyasaye waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.1",
            "verseOrgIds": [
              "2CH.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omuruchi nabakhulundube, nabomukhung'aano abali muYerusalemu, bali nibafuchilisaniye okhulia ipasaka mumwesi kwakhabili; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.2",
            "verseOrgIds": [
              "2CH.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba shibali nibanyala okhuchilia munduukho yachio ta, shichila abakuhani shibali nibeeyahuule obunji obuhela, kata abandu shibali nibakhung'aanile eYerusalemu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.3",
            "verseOrgIds": [
              "2CH.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likhuwa elo niliba habwene mumoni tsiomuruchi nabomukhung'aano bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.4",
            "verseOrgIds": [
              "2CH.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bakasia likhuwa, okhuupa omulome muIsiraeli yosi, okhurula eBeeri-sheba okhuula eDani, mbu beetse okhuliila ipasaka yOMWAMI Nyasaye waIsiraeli eYerusalemu; okhuba shibali nibachiliitsanga abandu abanji muno, shinga olwa kahandiikwa, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.5",
            "verseOrgIds": [
              "2CH.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abarume nibatsia netsibarwa tsiomuruchi nabakhulundube, muIsiraeli yosi naYuda, lilako liomuruchi shinga olwa lialimbu Inywe abaana baIsiraeli, kalushile OMWAMI, Nyasaye waAburahamu, Isaka, naIsiraeli, mbu ye akalushile omusikalo kweenywe okweehonokokha okhurula mumukhono kwabaruchi baAshuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.6",
            "verseOrgIds": [
              "2CH.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muraba shinga abakuuka beenywe, kata shinga abaana beenywe, abakhaya OMWAMI, Nyasaye wabakuuka babwe, ta, naye nabeebala babe eshiokhuhuchisia mubandu, shinga olwa mulola. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.7",
            "verseOrgIds": [
              "2CH.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano muraba abelikosi litinyu, shinga abakuuka beenywe olwa bali, ta; ne mbu mwihaanile OMWAMI, nimwinjila habunduwe ahatakatifu, aha ynahula obushia nobushia, nimukhalabanila OMWAMI Nyasaye weenywe, mbu oburimabwe obululu bushiukhane bumurulekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.8",
            "verseOrgIds": [
              "2CH.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba nimuba nimukalushila OMWAMI, abaana beenywe nabaana aba mweebula balabeelwa eshisa nabeenabo ababayila mubuhambe, nibakalukha mushialo shino; okhuba OMWAMI Nyasaye weenywe nowobukoosia netsimbabasi; shialashiukhasia tsimonitsie okhumurulakhwo ta, nimuba nimumukalushila.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho abarume abo babira mubuli taala mubialo biaEfuraimu naManase, kata okhuula eZabuloni; nebutswa babatseshelela nibabanyokhoosia. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abandi abomuAsheri naManase, nabaZabuloni, nibeetuutuyia nibeetsa eYerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi omukhono kwaNyasaye kwali khuYuda, okhubaheelesia omwoyo mulala okhukhola akalakwa nomuruchi nabakhulundu khulwa likhuwa liOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandu abanji nibakhung'aanila eYerusalemu okhulia lisabo liemikaate echibulamwo amamela mumwesi kwakhabili, omukhung'aano omukhongo muno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.13",
            "verseOrgIds": [
              "2CH.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibabuukha, nibayiniayo ebimalilo biosi ebiali muYerusalemu, kata nende ebimalilo biamalesi kelibuuliesi babiyiniayo, nibabisukuna mumuchela kwaKidironi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.14",
            "verseOrgIds": [
              "2CH.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana nibeera amakondi keipasaka khunyanga yekhumi nakhane eyomumwesi kwakhabili; nabo abakuhani nabaLawi nibafwimbwa omurwe, nibeeyahula nibeenjila munzu yOMWAMI nemisango emisambe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.15",
            "verseOrgIds": [
              "2CH.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasinjila mumasinji kabwe shinga olwa kaanzwa, amalako kaMusa omundu waNyasaye shinga olwa kali; abakuhani nibooha amalasile aka bakaamilwa nabaLawi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.16",
            "verseOrgIds": [
              "2CH.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba baliho abanji mumukhung'aano abali nibareeyahuule ta; khulwako abaLawi baheebwa emilimo chiokhwira amakondi keipasaka khulwa buli mundu ourali omusiiye ta, okhubaahulila OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba omukanda omukhongo kwabandu, mbu abanji baEfuraimu naManase Isakhari naZabuloni, shibali nibeesiiyile ta; nebutswa balia ipasaka khunjila yindi, eyirali eyo eyahandiikwa ta. Okhuba Hezekia yali nabasaayiile, mbu OMWAMI omulayi aleshele buli mundu ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ourakhwo omwoyo okhukhaaba Nyasaye OMWAMI, Nyasaye wabakuukanyene, kata narasiiywa obusiiyi bwahabundu ahatakatifu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nahulila Hezekia, nahonia abandu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abaana baIsiraeli abali nibaliyo eYerusalemu, balia lisabo liemikaate echibulamwo amamela tsindaalo musaafu nobusangaafu obunji; abaLawi nabakuhani nibamwitsoominjia OMWAMI khatsotselo, nibeembela OMWAMI namaani kabwe kosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Hezekia naboolela abaLawi bosi amakhuwa akobutinyisii, abali abasitsa mubukhalabani bwOMWAMI. Kho nibalia ebiliibwa bielisabo tsindaalo etsio musaafu, nibamalanga emisango chiokhwishia, nibamuupila OMWAMI, Nyasaye wabakuuka babwe, mbu orio.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 30:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abomukhung'aano kwosi nibafuchilisania okhulinda tsindaalo tsindi musaafu; nibalinda khandi tsindaalo tsindi musaafu nobusangaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
              "2CH.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba Hezekia omuruchi waYuda yaheelesia omukhung'aano tsing'ombe eshikhumila, namakondi ebikhumila musaafu, bibe ebihaanwa; abakhulundu nabo nibaheelesia omukhung'aano tsing'ombe eshikhumila, namakondi ebikhumila ekhumi; abakuhani abanji muno nibeeyahula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abomukhung'aano kwosi kwaYuda, halala nabakuhani nabaLawi, nomukhung'aano kwosi kwabarula muIsiraeli, nabarende abarula mushialo shiaIsiraeli, nabamenya muYuda, nibeekhoya bosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho kwaliho omwikhoyo omukhongo muYerusalemu, okhuba okhurula mundaalo tsiaSulemani waDaudi, omuruchi waIsiraeli, shikalikhwoho akafwana kario muYerusalemu ta. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakuhani abaLawi nibabuukha nibasaayila abandu mbu baheebwe ikhabi; omwoyo kwabwe nikuhulilwa, amasaayo kabwe nikoola ikulu, hashimenyoshie eshitakatifu, mwikulu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.27",
            "verseOrgIds": [
              "2CH.30.27"
            ]
          }
        }
      ]
    }
  ],
