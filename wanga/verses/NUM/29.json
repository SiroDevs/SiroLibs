            "sid": "NUM 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumwesi kwomusaafu, khunyanga yambeli, mube nomukhung'aano omutakatifu; murakholakhwo omulimo kwosi okwobukhalabani ta; neinyanga yeenywe yokhupa tsitarumbeta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.1",
            "verseOrgIds": [
              "NUM.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumale omusango omusambe kube eshiuya eshilayi khuMWAMI; mbu ihuunwa ndala, nelimiiku elala, namakondi keshimwamwane musaafu, akabula obulema; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.2",
            "verseOrgIds": [
              "NUM.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nomusango kwabio kweimele, mbu obusie obunyushe obutsokasiibwemwo amafura, ebitonye bitaru bielikhumi khulwa ihuunwa, nebitonye bibili bielikhumi khulwa limiiku, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.3",
            "verseOrgIds": [
              "NUM.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshitonye shilala shielikhumi khulwa buli likondi khumakondi keshimwamwane ako musaafu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.4",
            "verseOrgIds": [
              "NUM.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende ikhole ndala khulwa omusango kwobwonooni, eyeshitiso; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.5",
            "verseOrgIds": [
              "NUM.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nomusango omusambe kwokhulaba khwomwesi, nomusango kwakwo kweimele, nomusango omusambe kwakhatsotso nomusango kwakwo kweimele, nemisango chiachio chiokhutsushilwa, akalachilisibwa khuchio shinga olwa kali, khulwa eshiuya eshilayi, bibe eshihaanwa eshikholelwa omulilo khuMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.6",
            "verseOrgIds": [
              "NUM.29.6"
            ]
          }
        }
      ]
    },
    {
