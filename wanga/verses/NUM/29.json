          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumale omusango omusambe, eshihaanwa eshikholelwa omulilo, eshieshiuya eshilayi khuMWAMI; mbu tsihuunwa ekhumi natsitaru, namamiiku kabili, namakondi keshimwamwane ekhumi nakane; bileshe okhuba nobulema bwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.13",
            "verseOrgIds": [
              "NUM.29.13"
            ]
          }
        },
        {
