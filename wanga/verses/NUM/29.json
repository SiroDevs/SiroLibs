          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nomusango kwabio kweimele, mbu obusie obunyushe obutsokasiibwemwo amafura, ebitonye bitaru bielikhumi bia efa khulwa buli huunwa khutsihuunwa etsio ekhumi natsitaru, nebitonye bibili bielikhumi khulwa buli limiiku khumamiiku ako kabili, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.14",
            "verseOrgIds": [
              "NUM.29.14"
            ]
          }
        },
        {
