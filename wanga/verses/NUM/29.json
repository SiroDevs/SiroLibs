              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshitonye shindi shielikhumi khulwa buli likondi khumakondi ako ekhumi nakane; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.15",
