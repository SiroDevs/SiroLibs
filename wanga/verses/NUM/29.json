          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khunyanga yekhumi eyomumwesi okwo kwomusaafu, mube nomukhung'aano omutakatifu, nimwisandia abeene; murakholakhwo omulimo kwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.7",
            "verseOrgIds": [
              "NUM.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne mumalile OMWAMI omusango omusambe kube eshiuya eshilayi; mbu ihuunwa ndala, nelimiiku elala, namakondi keshimwamwane musaafu; mukoonye bileshe okhuba nobulema bwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.8",
            "verseOrgIds": [
              "NUM.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "halala nomusango kwabio kweimele, mbu obusie obunyushe obutsokasiibwemwo amafura, ebitonye bitaru bielikhumi khulwa ihuunwa, nebitonye bibili bielikhumi khulwa limiiku elo elala, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.9",
            "verseOrgIds": [
              "NUM.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "neshitonye shindi shielikhumi khulwa buli likondi khumakondi keshimwamwane ako musaafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.29.10",
            "verseOrgIds": [
              "NUM.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "neikhole ndala khulwa omusango kwobwonooni, halala nende omusango kwobwonooni kweshitiso, nomusango omusambe kwakhatsotso, nomusango kwachio kweimele, nomusango kwachio kwokhutsushilwa.",
          "type": "text",
          "attrs": {
