          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne eliira liomusaatsa waIsiraeli oweerwa, niyeerwa halala nomukhasi omuMidiani, liali Zimiri, omwana waSalu, omukhulundu weshilibwa shindi mubaSimeoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.14",
            "verseOrgIds": [
              "NUM.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nalio eliira liomukhasi omuMidiani oweerwa liali Kozibi omukhaana waZuri; ye yali omwimilisi wabandu beshilibwa shindi mubaMidiani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.15",
            "verseOrgIds": [
              "NUM.25.15"
            ]
          }
        }
      ]
