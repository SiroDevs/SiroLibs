          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyasie abaMidiani, nobarootsa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.17",
            "verseOrgIds": [
              "NUM.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
