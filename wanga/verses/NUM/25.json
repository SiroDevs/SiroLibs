            "verseId": "NUM.25.9",
            "verseOrgIds": [
              "NUM.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.10",
            "verseOrgIds": [
              "NUM.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finehasi waEleazari waHaruni omukuhani ashiukhasiye oburima bwanje okhurula khuIsiraeli, olwa yali oweimbalikha mubo, khulwa imbalikha yanje, nachila nindabeera abaana baIsiraeli mumbalikha yanje ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.11",
            "verseOrgIds": [
              "NUM.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khulwako, oboole mbu Lola, emuheelesia indakano yanje yomulembe; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.12",
            "verseOrgIds": [
              "NUM.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yilabeetsanga khuye, khandi khubeetsukhulube inyumawe, mbu indakano yobukuhani oburahwaho ta; shichila yali oweimbalikha khulwa Nyasayewe, natisa abaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.13",
            "verseOrgIds": [
              "NUM.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
