{
  "id": "NUM.27",
  "number": "27",
  "bookId": "NUM",
  "reference": "Obubali 27",
  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "NUM 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhusaba khwabakhaana baZelofehadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abakhaana baZelofehadi waHeferi, waGileadi, waMakhiri, waManase, owokhutsinzu tsiaManase waYusufu, nibasita ahambi. Ameera kabakhaanabe ngakano, mbu Mala, naNoa, naHogila, naMilika, naTirisa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.1",
            "verseOrgIds": [
              "NUM.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasinjila imbeli waMusa, khandi imbeli waEleazari omukuhani, khandi imbeli wabakhulundu nomuKhung'aano kwosi, hamuliango weliheema liokhwakaana, nibasunga bari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.2",
            "verseOrgIds": [
              "NUM.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Seefwe yafwila mushitsiimi, ne shiyali nali mumukanda kwa abo abakhung'aana OkhufukuIa OMWAMI mumukanda kwabanga Kora ta; ne yafwa mubwonooni bubwe omwene; ne shiyalikhwo nabaana abasiani ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.3",
            "verseOrgIds": [
              "NUM.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho eliira liaseefwe liyinibwe mubeinzu yabwe mbushiina, shichila shiyali nomwana omusiani ta? Mukhuheelesie ebiakhaba ebieefwe mubaana babwe seefwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.4",
            "verseOrgIds": [
              "NUM.27.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.4",
            "verseOrgIds": [
              "NUM.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa naleera amakhuwa kabwe imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.5",
            "verseOrgIds": [
              "NUM.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.6",
            "verseOrgIds": [
              "NUM.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakhaana baZelofehadi bateechile; okhuha obaheelesie ebiba ebiabwe biobulaame mubasiani babwe saabwe; obaheelesie obulaame bwasaabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.7",
            "verseOrgIds": [
              "NUM.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oboolele abaana baIsiraeli ori Omundu naba nafwa, ne naralikhwo nomwana emusiani ta, kho muheelesie omwanawe omukhaana obulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.8",
            "verseOrgIds": [
              "NUM.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba naralikhwo nomwana omukhaana ta, kho muheelesie abaana babwe obulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.9",
            "verseOrgIds": [
              "NUM.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne naba naralikhwo nabaana babwe ta, kho muheelesie abaana babwe samwana obulaamebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.10",
            "verseOrgIds": [
              "NUM.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne kata samwana naba naralikhwo nabaana babwe ta, kho muheelesie omuluyiawe ouli ahambi naye munzu yabwe obulaamebwe, bube obubwe; ne kalababeela abaana barsiraeli obukhalachi obulachilisibwa, shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Musa Okhwela Yosua akalushe mushilenjeshie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.11",
            "verseOrgIds": [
              "NUM.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Musa mbu Niina otsie khushikulu shino shiaAbarimu, ohenje eshialo eshia ndabaheelesia abaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.12",
            "verseOrgIds": [
              "NUM.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa olaba noshiluutsi, iwe wesi olalonda abandubo, shinga Haruni omwana weenywe olwa yabalonda; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.13",
            "verseOrgIds": [
              "NUM.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "shichila mwakhaya likhuwa lianje mushitsiimi shieZini, mubuyingani bwomukhung'aano, okhunzahula kamatsi ako imbeli wabwe. Niko amatsi kaMeriba eKadeshi mushitsiimi shieZini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa nasunjila OMWAMI ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI, Nyasaye wetsiroho tsiabandu bosi, areho omundu aruche emukhung'aano kuno; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "oulasamulanga nibalola, noulachelelanga nibalola; oulabasamusinjia nabachelesia; mbu omukhung'aano kwOMWAMI kuleshe okhuba shinga amakondi abakula omwayi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari Bukula Yoswa waNuni, omundu owa roho ali muye, omurekhwo omukhono; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omure imbeli waEleazari omukuhani, khandi imbeli womukhung'zano kwosi; nawe omulachilisie, bo nibalola. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olamukabilakhwo khuluyalilwo, mbu bosi abomukhung'aano kwabaana baIsiraeli bamuhulilenje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asinjile imbeli waEleazari omukuhani, naye amureebele munjila yobukhalachi bwaUrimu imbeli wOMWAMI. Khwikhuwa lilie balasamulanga, khandi khwikhuwalie balachelelanga, ye omwene nende abaana baIsiraeli bosi, nibo omukhung'aano kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nakhola shinga OMWAMI olwa yamulaka; yabukula Yoswa, namura imbeli waEleazari omukuhani, khandi imbeli womukhung'aano kwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "namurakhwo amakhono, namulachilisia, shinga OMWAMI olwa yaboela mumunwa kwaMusa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
      ]
    }
  ],
