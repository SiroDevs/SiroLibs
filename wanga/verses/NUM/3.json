          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukula abaLawi mushilenje shiabeekulanda bosi abomubaana baIsiraeli, khandi emiruko chiabaLawi mushilenje shiemiruko chiabwe; nabo abaLawi balaba abanje; nisie OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.45",
            "verseOrgIds": [
              "NUM.3.45"
            ]
          }
