          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa nabala abeekulanda bosi mubaana baIsiraeli, shinga OMWAMI olwa yamulaka. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.42",
            "verseOrgIds": [
              "NUM.3.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 3:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abeekulanda abeshisaatsa, obunji bwameera shinga olwa bwali, okhurula khubomwesi mulala nende abashilaho, ababalwa bali ebikhumila amakhumi kabili nabibili, ebikhumi bibili amakhumi musaafu nabataru.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.43",
