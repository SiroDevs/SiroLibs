          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oheelesie Haruni nabaanabe amapeesa aka abasikala abo banunulwa ninako. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 3:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa yabaroosia amapeesa kobununuli abo abasikala okhushila abo abanunulwa nabaLawi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.49",
            "verseOrgIds": [
              "NUM.3.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 3:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaroosia abeekulanda abomubaana baIsiraeli amapeesa ako, mbu tsishekeli eshikhumila ebikhumi bitaru amakhumi kasasaba natsiraano, nochela khushekeli yahabundu ahatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.50",
            "verseOrgIds": [
              "NUM.3.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "NUM 3:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa naheelesia Haruni nabaanabe amapeesa ako kobununuli, likhuwa liOMWAMI shinga olwa liali, shinga OMWAMI olwa yalaka Musa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.51",
