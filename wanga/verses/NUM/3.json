          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "oroosie tsishekeli tsiraano khubuli mundu mulala mulala; nochela khushekeli yahabundu ahatakatifu olwa otsibukula; ishekeli netsigera amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.47",
            "verseOrgIds": [
              "NUM.3.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
