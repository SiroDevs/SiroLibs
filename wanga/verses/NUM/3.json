          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khulwa obununuli bwa abo ebikhumi bibili amakhumi musaafu nabataru abokhubeekulanda babaana baIsiraeli, abasikala okhushila obunji bwabaLawi, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
