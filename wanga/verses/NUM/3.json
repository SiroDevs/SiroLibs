          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa mbu Bala abaana abeekulanda beshisaatsa abomubaana baIsiraeli, okhurula khubomwesi mulala nende abashilaho okhaabe obunji bwameera kabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olambukulila abaLawi mushilenje shiabeekulanda bosi mubaana baIsiraeli; nisie OMWAMI; khandi emiruko chiabalawi mushilenje shiebiambeli mumiruko chiabaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
