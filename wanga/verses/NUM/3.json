          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bosi ababalwa khubaLawi, aba Musa naHaruni babala khulwa lilako liOMWAMI, munzu tsiabwe, abeshisaatsa bosi okhurula khubomwesi mulala nende abashilaho, bali ebikhumila amakhumi kabili nabibili.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "AbaLawi nende obununulwi bwabeekulanda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
