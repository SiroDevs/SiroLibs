          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "MubaMerari, baliho abeinzu yabaMahali, nabeinzu yabaMushi; tsinzu tsiaMerari nzietsio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo ababalwa khubo, obunji bwabeshisaatsa shinga olwa bwali, okhurula khubomwesi mulala nende abashilaho, bali ebikhumila bisasaba nebikhumi bibili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhulundu weshilibwa shiabetsinzu tsiaMerari yali Zurieli waAbihaili; bo balakwa okhukhoma ikambi yabwe khulubeka Iweshimenyo enotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebialakwa okhuleshelwa abaana baMerari biali ebitiisi bieshimenyo netsisheti tsiabio, netsisiiro tsiabio, nebichibi biabio, nebimanulwa biabio biosi; nobukhalabani bwabio bwosi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "netsisiiro tsiolwanyi olubotokhanaho, nebichibi biatsio, nebibambo biatsio, nemikoye chiatsio.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
