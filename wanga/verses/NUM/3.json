          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebia baleshelwa biali lisanduku, neimeesa, nebichibi bietsitaha, nebimalilo biemisango, nebimanulwa biahabundu ahatakatifu ebia beekhoonyelanga mubukhalabani, nende olwichi, nooukhalabani bwabio bwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Eleazari waHaruni omukuhani yali omukhulundu wabakhulundu babaLawi, nomusinjilili wa abo abaleshelwa obulindi bwahabundu ahatakatifu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
