              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
          "name": "verse",
