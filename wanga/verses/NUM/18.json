              "type": "text"
            }
          ]
        },
        {
          "text": "Okhurula mubihaanwa bieenywe biosi muhaanenje buli sadaka yOMWAMI khubishila obulayi khubio, nishio eshitonye eshitakatifu eshirulamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "verse",
