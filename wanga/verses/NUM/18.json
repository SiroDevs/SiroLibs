          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muliilenjekhwo buli handu hosi, inywe nabomunzu tsieenywe; okhuba nibio amatani keenywe aka mukalusilibwa khulwa obukhalabani bweenywe mwiheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
