          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niko akachila obaboolele ori Olwa nuba nimuhaanile ebishila obulayi khushitonye tsana, kho mana bibasilibwe abaLawi shinga amameeto kolutse, kata shinga amameeto ketsingulu tsieidivai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
