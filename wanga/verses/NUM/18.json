            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne shimuleetuukha obwonooni bwosi khulwabio ta, olwa muba nimuhaanile ebishila obulayi khubio, kata shimuloonoonia ebitakatifu biabaana baIsiraeli ta, mbu muleshe okhufwa.",
          "type": "text",
