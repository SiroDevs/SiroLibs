        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akakasilibwa abakuhani nabaLawi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana OMWAMI naboolela Haruni mbu Iwe nabaanabo nabashilibwa shieenywe mwesi muleetuukha eshiuku eshiakhanyooleshela mukahabundu ahatakatifu; khandi iwe nabaanabo mwesi muleetuukha eshiuku eshiakhanyooleshela mukobukuhani bweenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.1",
            "verseOrgIds": [
              "NUM.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi witse nabaana beenywe bosi, aboluyia lwaLawi, nilwo oluyia lwaso, bahambane ninawe nibakhukhalabanila; ne iwe nabaanabo mwesi mubeetsenjeho imbeli weliheema liOburumbusi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.2",
            "verseOrgIds": [
              "NUM.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balindenje aka obaleshela, nende aka baleshelwa khukeliheema liosi; habula mbu baleshenje okhusita ahambi khubimanulwa biahabundu ahatakatifu, kata khushimalilo, baleshe okhufwa, kata bo kata inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.3",
            "verseOrgIds": [
              "NUM.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahambane ninawe, nibalinda aka baleshelungwa khukeliheema liokhwakaana, khulwa obukhalabani bwosi bweliheema; ne oundi yesi aleshe okhumusitakhwo ahambi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.4",
            "verseOrgIds": [
              "NUM.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulindenje aka muleshelwa khukahabundu ahatakatifu, naka muleshelwa khukeshimalilo shiemisango; mbu oburima buleshenje okhubaho khandi khubaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.5",
            "verseOrgIds": [
              "NUM.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasi, lola, embukuule abaana beenywe abaLawi okhurula mubaana baIsiraeli; babe eshihaanwa khwinywe, eshihaanilwa OMWAMI, okhukholanga obukhalabani bweliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.6",
            "verseOrgIds": [
              "NUM.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa iwe nabaanabo mwesi, mukholenje akobukuhani bweenywe khukosi akali akeshimalilo, nende akali inyuma weinyubo ishinga. Mulakhalabananga. Emuheelesia obukuhani bube eshihaanwa shiobukhalabani; ne oundi yesi ousita ahambi, yeerwe bwirwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.7",
            "verseOrgIds": [
              "NUM.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.7",
            "verseOrgIds": [
              "NUM.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunjila Haruni ari Nasi, lola, ndakhuheele ebitong'anga khutsisadaka tsianje nibio ebindu ebitakatifu biosi ebiabaana baIsiraeli; ndakhuheelesiye bibe omukabokwo, nokwabaanabo, bibe ebimukhoyeele tsindaalo tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.8",
            "verseOrgIds": [
              "NUM.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bino bibe ebibio khubindu ebili ebitakatifu muno, ebibiikhwa nibirasambwa ta; mbu buli sadaka yabwe, niyo buli musango kwabwe kweimele, nabuli musango kwabwe kwobwonooni, nabuli musango kwabwe kweshiuku, echia balandeerelanga bibe ebitakatifu muno khululwo khandi khuiwa abaanabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.9",
            "verseOrgIds": [
              "NUM.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obiliile habundu undi ahali ahatakatifu muno; buli mundu weshisaatsa aliekhwo; bikhubeele ebitakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.10",
            "verseOrgIds": [
              "NUM.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi bino nebibio, mbu ebihaanwa bietsisadaka tsiabwe, nibio emisango chiosi chiokhuchelwa chiabaana baIsiraeli, ekhuheelesiye iwe khandi khubaanabo abasiani nabakhaana bosi halala ninawe, bibe ebimukhoyeele tsindaalo tsiosi; buli mundu ouba omusiiyikhu munzuyo abiliitsenjekhwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.11",
            "verseOrgIds": [
              "NUM.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebilayi biamafura, nebilayi bieidivai, nebieimele, ebiambeli biebirongole biabo abamuhaanilanga OMWAMI, ekhuheelesiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.12",
            "verseOrgIds": [
              "NUM.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebiamo biosi ebiranjililanga okhwenga khubiosi ebili mushibala shiabwe, ebia baleerelanga OMWAMI, bibe ebibiobuli mundu ouba omusiiyikhu munzuyo aliitsenjelchwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.13",
            "verseOrgIds": [
              "NUM.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shindu eshia engwisia okhuba eshiomusilo muIsiraeli shibe eshishio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.14",
            "verseOrgIds": [
              "NUM.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buli shindu eshiikula inda, khubiemibili biosi ebia bamuleerelanga OMWAMI khubiabandu nebiemiruko biombi, shibe eshishio, nebutswa abeekulanda babandu obanunule; khandi eshiibulwa shiambeli shiomuruko okwakhaba okwomusilo, oshinunule. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.15",
            "verseOrgIds": [
              "NUM.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khumurungo kwobununuli bwabio obinunule nibiakhahela omwesi mulala, nocheia amapeesa kabe tsishekeli tsiraano; nochela khushekeli yahabundu ahatakatifu; ishekeli netsigera amakhumi kabili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.16",
            "verseOrgIds": [
              "NUM.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa eshiibulwa shiambeli shieing'ombe, kata eshiibulwa shiambeli shielikondi, kata eshiibulwa shiambeli shieimbusi orashinunula ta; ebio nebitakatifu; wohe amaiasile kabio khushimalilo, nosamba amasinya kabio kabe eshihaanwa eshikholelwa omulilo khulwa eshiuya eshilayi khUMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.17",
            "verseOrgIds": [
              "NUM.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne inyama yabio yibe eyiyo; shinga itakata eyichelwa khandi shinga eshiatakho eshisaatsa, yibe eyiyo yirio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.18",
            "verseOrgIds": [
              "NUM.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsisadaka tsiebindu ebitakatifu ebia abaana baIsiraeli bahaanila OMWAMI, ekhuheelesiye, nende abaanabo abasiar i nabakhaana bosi halala ninawe, bibe ebimukhoyeele tsindaalo tsiosi; neindakano yomuunyu tsindaalo tsiosi imbeli WOMWAMI khwiwe khandi khubeetsukhulubo mwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.19",
            "verseOrgIds": [
              "NUM.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namusunjila Haruni ari Iwe shiolabeetsanga nobulaame bwosi mushibala shiabwe, kata shiolaba nomukabo kwosi mubo ta. Nisie omukabokwo khandi obulaamebwo mubaana baIsiraeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.20",
            "verseOrgIds": [
              "NUM.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne khubaana baLawi, lola, embaheelesiye buli shitonye shielikhumi shiosi muIsiraeli shibe shiobulaame; nishio eshia bakalusilibwa khulwa obukhalabani obwa bakhalabananga, mbu obukhalabani bweliheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nokhurula olwa leelo abaana baIsiraeli baleshenje okhusitila liheema liokhwakaana ahambi, baleshe okhwituukha obwonooni nibafwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne abaLawi bakholenje obukhalabani bweliheema liokhwakaana, nibeetuukha eshikha shiabwe; nelikhuwa elilachilisibwa tsindaalo tsiosi munzibulo tsieenywe; khandi mubaana baIsiraeli shibalabeetsanga nobulaame bwosi ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba eshitonye shielikhumi eshio shiabaana baIsiraeli, eshia bahaana shibe isadaka yOMWAMI, embaheelesiye abaLawi shibe obulaame; niko akachila nimbaboolela mbu Mubaana baIsiraeli, shibalabeetsanga nobulaame bwosi ta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iihandi osungane nabaLawi, nobaboolela mbu Buli olwa muroosinjia abaana baIsiraeli eshitonye shielikhumi tsana eshia ndamuheelesiye okhurula khubo shibe obulaame bweenywe, kho muhaanenje isdaka eyirula khushio khulwa OMWAMI, mbu eshitonye shielikhumi eshieshitonye shielikhumi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne isadaka yeenywe yilamubasilibwa shinga olwa yili imele eyokhulutse, kata shinga omwitsulu kweingulu yeidivai. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iiho murio muhaanilenje OMWAMI isadaka eyirula mubitonye bielikhumi bieenywe biosi ebia munyoolanga khubaana baIsiraeli; khandi mubieenebio muhaanile Haruni omulkuhani isadaka YOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
