          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okhuba abasaatsa belihe bali nibayaayile ebiyaayo, buli mundu khululwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.53",
            "verseOrgIds": [
              "NUM.31.53"
            ]
          }
        },
