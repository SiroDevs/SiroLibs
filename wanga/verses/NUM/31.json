          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho omurungo okwo kwosi, nikwo isadaka yOMWAMI, Musa yamuheelesia Eleazari omukuhani, shinga OMWAMI olwa yamulaka Musa.",
          "type": "text",
