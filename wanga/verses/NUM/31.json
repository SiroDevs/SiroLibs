          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsing'ombe tsiali ebikhumila amakhumi kataru nabisasaba; ne khutsio omurungo kwOMWAMI kwali amakhumi musaafu natsibili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.38",
            "verseOrgIds": [
