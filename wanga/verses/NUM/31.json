          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abandu bali ebikhumila ekhumi nabisasaba; ne khubo omurungo kwOMWAMI kwali abandu amakhumi kataru nababili. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.40",
            "verseOrgIds": [
