          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omurungo kwOMWAMI khumakondi ako kwali ebikhumi bisasaba amakhumi musaafu nakaraano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.37",
