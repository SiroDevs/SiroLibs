          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Musa naEleazari omukuhani nibabukula tsitsahaabu etsia baleera, tsiosi nitsili ebimili ebiiraanye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.51",
            "verseOrgIds": [
              "NUM.31.51"
            ]
          }
        },
