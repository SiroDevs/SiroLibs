          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natsio tsisishili tsiali ebikhumila amakhumi kataru nebikhumi biraano; ne khutsio omurungo kwOMWAMI kwali amakhumi kasasaba nandala. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.39",
