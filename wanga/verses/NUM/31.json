          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne tsitsahaabu tsiosi tsieisadaka eya bahaanila OMWAMI, eya abaseesia bebikhumila nabaseesia bebikhumi baleera, tsiali tsishekeli ebikhumila ekhumi nabisasaba nebikhumi musaafu namakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.52",
            "verseOrgIds": [
              "NUM.31.52"
            ]
          }
        },
        {
