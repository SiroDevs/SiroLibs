          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boolela Haruni nabaanabe mbu Luno nilwo olwa mulabasabilanga abaana baIsiraeli ikhabi, mubasunjile muri;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.23",
