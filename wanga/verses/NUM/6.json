        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amalako khukomuNaziri owitsuba eshiitsubo, nakeshihaanwa eshia ahaanila OMWAMI khulwa obwiyahulibwe, halala nebindi biosi ebia yakhanyala okhunyoola; eshiitsubo eshia yeetsuba shinga olwa shili, nolwa akhoyile okhukhola ario khulwa amalako khukobwiyahulibwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.21",
            "verseOrgIds": [
              "NUM.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isaala yabakuhani eyokhusaba ikhabi",
          "type": "text"
        }
      ]
    },
    {
