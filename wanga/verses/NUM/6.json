          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI namuboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.22",
            "verseOrgIds": [
              "NUM.6.22"
            ]
          }
        },
        {
