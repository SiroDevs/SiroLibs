          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.1",
            "verseOrgIds": [
              "NUM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungana nabaana baIsiraeli, nobaboolela mbu Olwa omundu, kata omusaatsa kata omukhasi, yeetsuba eshiitsubo nabulebe, mbu eshiitsubo shiomuNaziri, khulwa okhwiyahulila OMWAMI, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho yeeyahule khudivai namalwa kosi; aranywa idivai eyiraanyile kata amalwa akaraanyile, kata okhunywa khumatsi ketsinzabibu, kata okhuliakhwo khutsinzabibu tsimbisi kata tsinzabibu tsinyumu, ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsindaalo tsiosi tsiobwiyahulibwe aleshenje okhuliakhwo khushindu shiosi eshirula khumutsabibu, kata tsimwo kata likhoba butswa ta.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiosi tsieshiitsuboshie shiobwiyahuli, olumwo lwosi luleshenje okhubisibwa khumurwekwe ta; okhuula olwa tsindaalo tsilaba nitsiusiibwe etsia yeeyahulila OMWAMI, abe omutakatifu; aleshe liswi eliokhumurwekwe likhule, libe lirambi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiosi etsia yeeyahulila OMWAMI aleshenje okhusita ahambi kata khumulambo kwosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Areera mwibilu khulwa samwana, kata khulwa nyina, kata khulwa omusiani wabwe, kata khulwa omukhaana wabwe, olwa bakhaba nibafwa, tawe; okhuba obwiyahulibwe obwa yeeyahulila Nyasaye buli khumurwekwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.7",
            "verseOrgIds": [
              "NUM.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundaalo tsiosi tsiobwiyahulibwe nomutakatifu wOMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.8",
            "verseOrgIds": [
              "NUM.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne omundu naba nafwa meetsukhana ahambi ninaye, niyoonoonia ario omurwekwe okwahulwa, kho yeebeche omurwe khunyanga yokhusiiywakhwe; kubekwe khunyanga yomusaafu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana khunyanga yomunaane yeetse nende amahuusi kabili kata emisosole chibili chiamakuuku ewomukuhani, hamuliango weliheema liokhwakaana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukuhani amale shilala shibe omusango kwobwonooni, neshindi nashio shibe omusango omusambe, namutisa ario; okhuba yoonoonile khulwa omufu. Kho yaahule omurwekwe inyanga yeneyo ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "niyeeyahulila OMWAMI tsindaalo tsiobwiyahulibwe, niyeetsa nelikondi lieshimwamwane, kube omusango kweshiuku; ne tsindaalo etsiaranjilila tsilia tsibe butswa, shichila obwiyahulibwe bwoonoonekha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kano niko amalako khukomuNaziri olwa tsindaalo tsiobwiyahulibwe tsiba nitsiusiibwe; mbu aleerwe khumuliango weliheema liokhwakaana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana aleere eshihaanwashie khuMWAMI, mbu likondi lieshimwamwane elala elibula obulema, libe omusango kwokhusambwa, nende lisibini liomuyika mulala elibula obulema libe omusango kwobwonooni, nende limiiku elala elibula obulema libe omusango kwokhwishia, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "nende eshimwelo shiemikaate echibulamwo amamela, namaandasi kobusie obunyushe akatsokasiibwe amafura, nebisikuti ebibulamwo amamela ebibashilwekhwo amafura, nemisango chiabio chieimele, nemisango chiabio chiokhutsushila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye omukuhani abileere imbeli wOMWAMI, namala omusangokwe kwobwonooni nomusangokwe omusambe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amale limiiku libe omusango kwebihaanwa biokhwishia khuMWAMI, halala neshimwelo shiemikaate echibulamwo amamela; khandi omukuhani amale nende omusango kweimele kwalio, nomusango kwokhutsushila kwalio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omuNaziri yeebeche omurwekwe okwahulwa hamuliango weliheema liokhwakaana, nabukula liswi elo liomurwekwe okwahulwa, nalira mumulilo okuli hasi womusango kwebihaanwa biokhwishia. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukuhani naye abukule eshiambeli shielimiiku nishiteeshilwe, neliandasi elala elibulamwo amamela eliomushimwelo, neshisikuti shilala eshibulamwo amamela, nabira khubikalo biomuNaziri, olwa aba namalile okhwibeka omurwekwe okwahulwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.19",
            "verseOrgIds": [
              "NUM.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana omukuhani abichele bibe omusango kwokhuchelwa imbeli wOMWAMI; kuno nomukabo omutakatifu kwomukuhani, halala neitakata eyichelwa neshiatakho shieisadaka; mana olunyuma lwa oko, omuNaziri oyo afuchiililwe okhunywa idivai.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.20",
            "verseOrgIds": [
              "NUM.6.20"
            ]
          }
        }
      ]
    },
    {
