      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abandu bakholela OMWAMI induli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abomukhung'aano kwosi nibakhupa tsimbungu; abandu nibalila eshilo shieneshio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.1",
            "verseOrgIds": [
              "NUM.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli bosi nibabuutsuluulila Musa nende Haruni; abomukhung'aano kwosi nibabasunjila bari Shilakhuha khulafwila mushibala shiaMisiri! Kata shiakhuha khwafwila mushitsiimi shino! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.2",
            "verseOrgIds": [
              "NUM.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nishiina eshichila OMWAMI nakhuusia khushibala shino, khukwisibwe nolukanga? Abakhasi beefwe nabaana beefwe abatiiti balakwa shinga ebiyaayo; shibwakhaba bulayi nikhukalukha eMisiri?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.3",
            "verseOrgIds": [
              "NUM.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.3",
            "verseOrgIds": [
              "NUM.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibasungana abeene khubeene, bari Chende khulobole omwimilisi weefwe, khukalushe eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.4",
            "verseOrgIds": [
              "NUM.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Musa naHaruni basikama nibabunamia obweni bwabwe imbeli welibukana liosi liomukhung'aano kwabaana baIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.5",
            "verseOrgIds": [
              "NUM.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo Yoswa waNuni nende Kalebu waYefune, abali khubeenabo abali abaluuri mushialo eshio, nibarandula tsingubo tsiabwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.6",
            "verseOrgIds": [
              "NUM.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nibaboolela omukhung'aano kwosi kwabaana baIsiraeli bari Eshialo eshia khwalambuula nikhuluura, neshialo eshilayi okhushila. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.7",
            "verseOrgIds": [
              "NUM.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naba nakhusangaalila, alakhuusia nakhwinjisia mushialo eshio, nashikhuheelesia; neshialo eshiitsuulemwo amabeele nobuushi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.8",
            "verseOrgIds": [
              "NUM.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula muramukholela OMWAMI induli, kata okhuria abandu beshialo shilia ta; okhuba bo nebiliibwa bieefwe; eshia beeshinga shibarusiibweho, ne OMWAMI ali nineefwe; murabaria ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.9",
            "verseOrgIds": [
              "NUM.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abomukhung'aano bosi baboola mbu balaswe namachina.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oluyali Iw lwaloleshela abaaana baIsiraeli bosi mwiheema liokhwakaana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.10",
            "verseOrgIds": [
              "NUM.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nasunjila Musa ari Abandu bano balandeka okhuula liina? Balakhaya okhusuubilila okhuula lina, kata olwa ekholeele ebilolelo ebinji hakari mubo? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.11",
            "verseOrgIds": [
              "NUM.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalabakhuya noluumbe, nimbarusiakhwo obulaame, nikhukhola iwe obe lihanga elibashila obukhongo nende amaani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.12",
            "verseOrgIds": [
              "NUM.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musa nasunjila OMWAMI ari Mana abaMisiri balahulilakhwo; okhuba watikulusia abandu bano okhurula mubo namaaniko. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.13",
            "verseOrgIds": [
              "NUM.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo balaboolela abamenyanga mushialo shino. Bo bahuliile shinga iwe, OMWAMI, olwa oli hakari wabandu bano; okhuba iwe, OMWAMI, ololekhanga mumoni khumoni; lileesilio nalio lisinjilanga ikulu wabwe; obeemililanga mwileesi eliingana isiilo mushiteere, khandi mumulilo okwingana isiilo mushilo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.14",
            "verseOrgIds": [
              "NUM.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho noba niwira abandu bano shiomundu mulala, mana amahanga ako akahulilanga akeifumayo kalaboola kari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.15",
            "verseOrgIds": [
              "NUM.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila OMWAMI yakhayilwe okhuusia abandu bano mushialo eshia yabeetsubila, niyeshichila yabeereele mushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.16",
            "verseOrgIds": [
              "NUM.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano ekhusaaya, obunyali bwOMWAMI bube obunji, shinga olwa waboola, mbu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.17",
            "verseOrgIds": [
              "NUM.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI shiali omwangu okhutiilwa oburima ta; obuheelibwe oburalilu nobunji; aleshelanga obumayaanu nende obukhayi; shianyala okhuchweya okhumurakhwo eshiina omundu ouli neshikha ta; akalusinjia akobumayaanu bwabakuuka yabo khubaana, khulwibulo lwakhataru nende olwakhane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.18",
            "verseOrgIds": [
              "NUM.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekhusaaya mbu oleshele abandu bano obumayaanu bwabwe, obunji bwobuheelibwo oburalilu shinga olwa buli, khandi shinga olwa waleshelanga abandu bano, okhurula eMisiri kata okhuula bulaano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukuumi bwaNyasaye khuIsiraeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.19",
            "verseOrgIds": [
              "NUM.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nakalusia mbu Embalesheele, shinga olwa usaayile. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.20",
            "verseOrgIds": [
              "NUM.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne toto mwene, shinga olwa endi mwoyo, khandi shinga eshialo shiosi olwa shiliitsulamwo oluyali lwOMWAMI; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.21",
            "verseOrgIds": [
              "NUM.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "okhuba abandu abo bosi abalola oluyali lwanje nebilolelo bianje ebia ndakholela muMisiri nomushitsiimi bandeema bario okhuula ekhumi, nibararechelesia omwoyo kwanje ta; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.22",
            "verseOrgIds": [
              "NUM.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho toto mwene, shibalilolakhwo eshialo eshia ndeetsubila abakuuka babwe; kata abeenabo bosi abandekanga shibalishilolakhwo ta ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.23",
            "verseOrgIds": [
              "NUM.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula omusumba wanje Kalebu, shichila yali nende roho yindi lukano muye, ne yanondelakhwo elala; ye ndilimwinjisia mushialo tsana eshia yeenjilamwo; khandi abeetsukhulube baliba abeene shio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.24",
            "verseOrgIds": [
              "NUM.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa bulaano abaAmaleki nabaKanaani bamenyanga mwibanda elo; kho mukamba mushiukhane mutsie mushitsiimi nimulonda khunjila eyitsia khuNyanza Inzakhanyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.25",
            "verseOrgIds": [
              "NUM.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI nababoolela Musa naHaruni, ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.26",
            "verseOrgIds": [
              "NUM.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omukhung'aano kuno omubii balambuutsuluulilanga okhuula liina? Emalile okhuhulila okhubuutsuluula khwabaana baIsiraeli nibambuutsuluulilanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.27",
            "verseOrgIds": [
              "NUM.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubaboolele muri; OMWAMI asunga mbu Isie uno! Aka muboolilenje nimbulila, ndalamukholela mwesi endio. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.28",
            "verseOrgIds": [
              "NUM.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emilambo chieenywe chilikwa mushitsiimi shino; ne bosi ababalwa khwinywe, obunji bweenywe bwosi shinga olwa bwali, okhurula khubemiyika amakhumi kabili nende abashilaho, abo bosi abambuutsuluuliile ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.29",
            "verseOrgIds": [
              "NUM.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "toto mwene shimuliinjila mushialo eshia ndachinguula omukhono ninditsuba mbu ndakhamumenyiamwo, kata mulala tawe; habula Kalebu waYefune naYoswa waNuni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.30",
            "verseOrgIds": [
              "NUM.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa abaana beenywe abatiiti aba mwaboola mbu bakhakwa shinga ebiyaayo, bo nibo aba ndiliinjisiamwo, ne balimanya eshialo tsana eshia mwaloba inywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.31",
            "verseOrgIds": [
              "NUM.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula inywe, emilambo chieeny ve chilikwa mushitsiimi shino. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.32",
            "verseOrgIds": [
              "NUM.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana beenywe nabo balabeetsanga abatiimatiimi mushitsiimi emiyika amakhumi kane, nibeetuukha obureesiikwa bweenywe obuli shinga obuheyi, okhuula olwa emilambo chieenywe chiliba nichimululushiile mushitsiimi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.33",
            "verseOrgIds": [
              "NUM.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obunji bwetsindaalo shinga olwa buli etsia mwaluuranga mushialo eshio, mbu tsindaalo amakhumi kane, nolwa chilaba, omuyika Ichulwa buli nyanga nimwituukha obumayaanu bweenywe, emiyika amakhumi kane; ne mulamanya okhufukula khwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.34",
            "verseOrgIds": [
              "NUM.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isie OMWAMI emboolile; shindalachweya okhubakholela kano, abomukhung'aano kuno omubii kwosi, abakhung'aanile okhuyinga; mushitsiimi shino balamululushilamwo; ne nimwo omwa balafwila.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okhufua khwabaluuri ekhumi abo ababii",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.35",
            "verseOrgIds": [
              "NUM.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabandu abo aba Musa yaruma okhuluura eshialo, abakalukha nibachila abomukhung'aano kwosi nibamubuutsuluulila, nibaleerile amakhuwa amabii khukeshialo tsana, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.36",
            "verseOrgIds": [
              "NUM.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "abandu abo abaleera amakhuwa amabii khukeshialo, bafwa khulwa oluumbe olwo imbeli wOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.37",
            "verseOrgIds": [
              "NUM.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Yoswa waNuni naKalebu waYefune basikala mwoyo, khubandu abo abatsia okhuluura eshialo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abalsiraeli okhuhulwa nibali eHoroma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.38",
            "verseOrgIds": [
              "NUM.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Musa naboolela abaana baIsiraeli bosi amakhuwa ako; nabo abandu nibeekhuula muno. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.39",
            "verseOrgIds": [
              "NUM.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibahuuna mumabwibwi nibatikulukha khubutenje bwetsingulu, nibaboola mbu Lola, nifwe bano; khulatikulukha nikhutsia habundu tsana aha OMWAMI yakhusuubisia; okhuba khwoonoona. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.40",
            "verseOrgIds": [
              "NUM.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Musa naboola mbu Nishiina eshichila nimusiila lilako liOMWAMI bulaano? Ako shikalakaasa ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.41",
            "verseOrgIds": [
              "NUM.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muratikulukha tawe, okhuba OMWAMI shiali hakari weenywe ta; mwakhakhupwa hasi imbeli wabasuku beenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.42",
            "verseOrgIds": [
              "NUM.14.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila habwenaho abaAmaleki nabaKanaani bali imbeli weenywe; ne mulakwisibwa nolukanga; olwa mwakalukha inyuma nimuralondakhwo OMWAMI ta, kho OMWAMI shialaba nineenywe tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.43",
            "verseOrgIds": [
              "NUM.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo nibatsaalikha, nibatikulukha khubutenje bwetsingulu; nebutswa lisanduku lieindakano yOMWAMI shiliarula mukambi, kata Musa yesi ario, tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana abaAmaleki nibakholomokhayo, nabaKanaani abamenyanga mungulu etsio, nibabakhupa nibabarootsa, okhuula khuHworoma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
