        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.21",
            "verseOrgIds": [
              "NUM.35.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa naba namufumira meetsukhana, harali obusuku bwosi ta; kata namulasa neshindu shiosi, ne naramukonesheele ta; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.22",
            "verseOrgIds": [
              "NUM.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kata naba nelichina liosi eliakhanyala okhuchila omundu afwe, nalimufuubila oburamulola ta, mana nafwa, ne naralinji omusukuwe ta, kata narakhaabanga okhumukholela libii ta; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.23",
            "verseOrgIds": [
              "NUM.35.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "kho omukhung'aano kulayaasia hakari womwiri nende omumali weshikwoli shiamabanga, obukhalachi buno bwosi shinga olwa buli. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.24",
            "verseOrgIds": [
              "NUM.35.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 35:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakwo omukhung'aano kulahonia omwiri oyo mumukhono kwomumali weshikwoli shiamabanga; khandi omukhung'aano kulamukalusia mwitaala liobwilushilobwe ewa yali niyeelushiile; naye alamenyangamwo okhuula khukhufwa khwomukuhani omukhulundu, oyo owatsushiililwa amafura amatakatifu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.25",
            "verseOrgIds": [
              "NUM.35.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 35:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebutswa omwiri oyo naba natsia olundi nabira khulwakho Iwelitaala liobwilushilobwe, ewa yeelushila, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.26",
            "verseOrgIds": [
              "NUM.35.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 35:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana omumali weshikwoli shiamabanga namunyoola nali elwanyi wolwakho Iwelitaala liobwilushilobwe, naye omumali weshikwoli shiamabanga namwira omwiri oyo; kho shialaba neshiina shiamabanga ta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.27",
            "verseOrgIds": [
              "NUM.35.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shichila ulia yali nakhoyile okhutong'a mwitaala liobwilushilobwe okhuula khukhufwa khwomukuhani omukhulundu; nebutswa olunyuma wokhufwa khwomukuhani omukhulundu omwiri oyo akalushe mushialo eshili eshishie.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.35.28",
            "verseOrgIds": [
              "NUM.35.28"
            ]
          }
        }
      ]
    },
    {
