          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomukandakwe, abo ababalwa khubo, bali ebikhumila amakhumi kane nabiraano nebikhumi bisasaba namakhumi karaano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.15",
            "verseOrgIds": [
              "NUM.2.15"
