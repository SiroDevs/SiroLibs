              "type": "text"
            }
          ]
        },
        {
          "text": "Khulubeka Iwesautsi, eshilolelo shieikambi yaReubeni shilabaho, mumikanda chiabwe; omukhulundu wabaana baReubeni abe Elizuri waShedeuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.10",
            "verseOrgIds": [
              "NUM.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
