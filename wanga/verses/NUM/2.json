          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa naHaruni ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.1",
            "verseOrgIds": [
              "NUM.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaana baIsiraeli bakhome ikambi yabwe buli mundu hashilolelo shiabwe halala netsipendela tsiebilibwa biabwe; bakhome ahahengana neliheema liokhwakaana, tsimbeka tsiosi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.2",
            "verseOrgIds": [
              "NUM.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abalakhoma khulubeka Iwebukwe, aha eliuba lifwindilanga, balaba abokhushilolelo shieikambi yaYuda, mumikanda chiabwe; omukhulundu wabaana baYuda abe Nashoni waAminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomukandakwe, abo ababalwa khubo, bali ebikhumila amakhumi musaafu nabine nebikhumi bisasaba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabo abalakhoma okhurondokhana ninaye balaba aboluyia lwaIsakhari; nomukhulundu wabaana baIsakhari abe Netsaneli waZuari. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomukandakwe, abo ababalwa khubo, bali ebikhumila amakhumi karaano nabine nebikhumi bine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana oluyia lwaZabuloni; nomukhulundu wabaana baZabuloni abe Eliabu waHeloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nomukandakwe, abo ababalwa khubo, bali ebikhumila amakhumi karaano namusaafu nebikhumi bine. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bosi ababalwa abokhukambi yaYuda bali ebikhumila eshikhumi amakhumi munaane nabisasaba nebikhumi bine, mumikanda chiabwe. Nibo abalaranjiilanga okhurula.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
      ]
    },
