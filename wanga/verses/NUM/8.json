            "sid": "NUM 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI naboolela Musa ari ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.23",
            "verseOrgIds": [
              "NUM.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akali khubaLawi ngakano; mbu buli mundu olwa yoola khumiyika amakhumi kabili nachiraano, yeenjilenje okhukhalabana mubukhalabani bwemilimo chieliheema liokhwakaana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.24",
            "verseOrgIds": [
              "NUM.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne olwa yoola khumiyika amakhumi karaano, aleshenje okhukhalabana mumilimo echio, narakhalabana khandi ta; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.25",
            "verseOrgIds": [
              "NUM.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "habula akholenje halala nabaana babwe mwiheema liokhwakaana, okhulinda ebia baleshelwa; ne arakholanga obukhalabani ta. Obakholelenje abaLawi orio khuka baleshelwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.8.26",
            "verseOrgIds": [
              "NUM.8.26"
            ]
          }
        }
      ]
