{
  "id": "1SA.10",
  "number": "10",
  "bookId": "1SA",
  "reference": "1 Samweli 10",
  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1SA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli nabukula akhachupa khamafura, nakatsukha khumurwekwe, namutsunzuuna, nasunga mbu OMWAMI shiakhutsushiiliilekhwo amafura obe omukhulundu wabandube Isiraeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.1",
            "verseOrgIds": [
              "1SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa nobe niurulilekhwo leelo, witsa okhwakaana nabasaatsa babili ahambi nende eshilindwa shiaRaheli, khulwakho lwaBenyamini eZeleza; nabo nabakhuboolele mbu Tsisishili etsia otsiile okhukhaaba tsimalile okhunyoolekha; ne lola, so aleshile aketsisishili, ne akhuhendelanga iwe; ari Nekhole shiina khulwa omwana wanje? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.2",
            "verseOrgIds": [
              "1SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana olatsiililila imbeli okhurula yaho, niwula khumuruba kwaTabori, nahabwenaho witsa okhubukaana nende abasaatsa bataru, nibatikulukha nibatsiila Nyasaye eBeteli; mulala nabe nachinjile ebimeeme bitaru bietsimbusi, oundi nachinjile emikaate chitaru, oundi nachinjile ichupa yeidivai; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.3",
            "verseOrgIds": [
              "1SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabo nabakhushiesie, nibakhuha emikaate chibili; nochibukule. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.4",
            "verseOrgIds": [
              "1SA.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "NoIunyumakhwo witsa okhuula eGibea waNyasaye, aha abasikaari abalindi abaFilisiti bali; ne olwa nobe niwulileyo khwitaala, nobukaane nende abanabii ing'anda, nibakholomokha okhurula habundu ahachinguukhu yaho, nibali nende litungu, nende isukuti, nende lilele, nende obukhana, nibibeemilila injila; ne nababe nibalakulanga; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.5",
            "verseOrgIds": [
              "1SA.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "mana Roho wOMWAMI nakhwitsile nende amaani, nawe olalakula halala ninabo, nokalukhasibwa noba omundu lukano. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.6",
            "verseOrgIds": [
              "1SA.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne ebilolelo bino nibikhwitsiile, okhole shinga olwa oluutsi mbu kakhoyeele; okhuba Nyasaye ali ninawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.7",
            "verseOrgIds": [
              "1SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olakholomokha niuranjilila eGiligali; ne lola, nasi nekholomoshe nikhwitsila, okhumala emisango emisambe nende emisango chiokhwishia. Olalinda tsindaalo musaafu, okhuula olwa ndalakhwitsila, nikhumanyia aka okhoyile okhukhola.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.8",
            "verseOrgIds": [
              "1SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.8",
            "verseOrgIds": [
              "1SA.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne olwa yashiukhana okhurula ewaSamweli, Nyasaye yamuheelesia omwoyo omuyia; ebilolelo ebio biosi nibimala biikhole khunyanga yeneyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.9",
            "verseOrgIds": [
              "1SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olwa boolayo eGibea, lola, ing'anda yabanabii nibabukaana ninaye; ne Roho waNyasaye yamwitsila nende amaani, naye nalakula hakari mubo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.10",
            "verseOrgIds": [
              "1SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikaba mbu olwa abandu bosi abalinji nibamumanya khale balola mbu ngwoyo, alakulanga halala nende abanabii, kho mana abandu nibasungana abeene nabeene, bari Nimakhuwa shiina kano akakwiliile omwana waKishi? Saulo yesi ali mubanabii noho? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.11",
            "verseOrgIds": [
              "1SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Omundu undi webweneyo nakalusia nasunga mbu Ne saabwe niye wina? Khulwako nilukwa olukano, mbu Khane Saulo yesi ali mubanabii? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.12",
            "verseOrgIds": [
              "1SA.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa yali namalile okhulakula, yoola habundu yaho ahachinguukhu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.13",
            "verseOrgIds": [
              "1SA.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.13",
            "verseOrgIds": [
              "1SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne samwana Saulo undi yamureeba nende omukholiwe ari Mwatsiilenje heena? Naye nakalusia ari Mbula, okhukhaaba tsisishili; nolwa khwaluutsi mbu shitsinyoolekhanga ta, khwatsiile ewaSamweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.14",
            "verseOrgIds": [
              "1SA.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye samwana Saulo mwenoyo namusunjila mbu Chama umboolele aka Samweli yakhusunjiile. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.15",
            "verseOrgIds": [
              "1SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo namusunjila samwana mbu Yakhubooleele habulafu shinga tsisishili olwa tsiabeele nitsiluutsiishi. Ne khumakhuwa koburuchi aka Samweli yali namubooleelekhwo, shiyakarumbulakhwo tawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.16",
            "verseOrgIds": [
              "1SA.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.16",
            "verseOrgIds": [
              "1SA.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne Samweli yalanga abandu bakhung'aanile OMWAMI eMizipa; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.17",
            "verseOrgIds": [
              "1SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabasunjila abaIsiraeli ari OMWAMI, Nyasaye waIsiraeli, aboola ari nanwa, mbu Ndatikulusia Isiraeli okhurula eMisiri, khandi ndamuhonia mumakhono kabaFilisiti, khandi mumakhono kobwami obwo bwosi obwamusandinjia; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.18",
            "verseOrgIds": [
              "1SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ne inywe inyanga yino mumulobile Nyasaye weenywe, omwenoyo oumuhoninjia mumasila keenywe kosi, khandi mumatinyu keenywe; khandi mumusunjiile muri Tawe, habula mbu oreho omuruchi akhuruche. Kho bulaano mwilolosie imbeli w mumbia tsieenywe, khandi mubikhumila bieenywe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.19",
            "verseOrgIds": [
              "1SA.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Samweli nasitia tsimbia tsiosi tsiaIsiraeli ahambi, ikha niyibukula oluyia lwaBenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.20",
            "verseOrgIds": [
              "1SA.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana yasitia oluyia lwaBenyamini ahambi mubilibwa biabwe, ikha niyibukula eshilibwa shiabaMatiri; mana abeshilibwa shiabaMatiri nibasitibwa ahambi, mulala mulala, ikha niyibukula Saulo omwana waKishi; nebutswa olwa bamukhaaba, shiyanyoolekha ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.21",
            "verseOrgIds": [
              "1SA.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nibameeta okhureeba OMWAMI, bari Omundu oyo witsile hano noho? OMWAMI nakalusia mbu Lole, yeebisile mumisiiko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.22",
            "verseOrgIds": [
              "1SA.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibatsia tsimbilo okhumwendamwo; nolwa yasinjila hakari wabandu, bosi nibamuhelela khumabeka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.23",
            "verseOrgIds": [
              "1SA.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli nasunjila abandu bosi ari Mulola uno owa OMWAMI aloboole noho? Abulaho oufwanana ninaye mubandu bosi. Abandu bosi nibachinguula emioyo, nibasunga bari Omuruchi ayindile!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.24",
            "verseOrgIds": [
              "1SA.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli nababoolela abandu amakhuwa koburuchi obwo, nakahandiika mushitabu, nakabiikha imbeli wOMWAMI. Samweli naseebula abandu bosi, batsie buli mundu ingowe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.25",
            "verseOrgIds": [
              "1SA.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Saulo yesi yatsia ingowe eGibea; ne abandu bandi abalulu aba Nyasaye yali natiilile khumioyo chiabwe nibatsia ninaye halala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.26",
            "verseOrgIds": [
              "1SA.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abandi abamayaanu abeshifwabwi nibasunga bari Omundu uno alakhuhonia arie? Nibamuleka, nibaramuleerela eshihaanwa shiosi ta. Naye naholeela butswa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.10.27",
            "verseOrgIds": [
              "1SA.10.27"
            ]
          }
        }
      ]
    }
  ],
