            "number": "32",
            "style": "v",
            "sid": "1SA 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli nasunga mbu Mundeerele hano Agagi, omuruchi wabaAmaleki. Agagi namwitsila, narahendelanga likhuwa ta. Agagi napaara mbu Obululu bwokhufwa shibuchweya okhuba nibubirile ta. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
              "1SA.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli naboola mbu Shinga olwa olukangalwo lwakhola abakhasi okhubula abaana, nolwa mawo alabula abaana mubakhasi. Mana Samweli narema Agagi ebitonye ebitonye imbeli wOMWAMI eGiligali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.33",
            "verseOrgIds": [
              "1SA.15.33"
            ]
          }
        }
      ]
    },
