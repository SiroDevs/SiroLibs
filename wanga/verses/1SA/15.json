{
  "id": "1SA.15",
  "number": "15",
  "bookId": "1SA",
  "reference": "1 Samweli 15",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "1SA 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Obukhayi bwaSaulo, nokhulobwakhwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haho Samweli yasunjila Saulo ari OMWAMI yaruma okhukhutsushiilila amafura obe omuruchi wabandube Isiraeli; kho bulaano hulila amakhuwa kOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.1",
            "verseOrgIds": [
              "1SA.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "OMWAMI wamahe asunga ari nanwa, mbu Ndalola amakhuwa aka Amaleki yakholela Isiraeli, shinga olwa yamwikalila khunjila, olwa yatikulukha okhurula eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.2",
            "verseOrgIds": [
              "1SA.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano tsia orootse Amaleki, nomululila elala biosi ebia bali ninabio, norabahonia ta; habula wire abasaatsa nende abakhasi bosi, abaana abahele nende abashinuuna, tsing'ombe nende amakondi, tsingamia nende tsisishili.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.3",
            "verseOrgIds": [
              "1SA.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Saulo nalanga abandu, nababasilia eTelaimu, mbu abachendanga namakulu ebikhumila ebikhumi bibili, nende abandu ebikhumila likhumi baYuda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.4",
            "verseOrgIds": [
              "1SA.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo niyoola khwitookho liaAmaleki, nakonekha mwibanda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.5",
            "verseOrgIds": [
              "1SA.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi Saulo nababoolela abaKeni ari Tsie, mwinyoshe, mukholomoshe okhurula mubaAmaleki, endeshe okhumusishia halala ninabo; shichila mwakholela abaIsiraeli bosi akeshisa, olwa batikulukha okhurula eMisiri. Kho abaKeni nibarula mubaAmaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.6",
            "verseOrgIds": [
              "1SA.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo narootsa abaAmaleki okhurula eHawila okutsia eShuru, elihenjile eMisiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.7",
            "verseOrgIds": [
              "1SA.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ne yahamba Agagi omuruchi wabaAmaleki, nali mwoyo, nasishilia elala abandu bosi nende tsinganga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.8",
            "verseOrgIds": [
              "1SA.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula Saulo nende abandube bamuhonokosia Agagi, halala nende ebiashila obulayi mumakondi, nende mutsing'ombe, nende mubinulu, nende mumisie, khandi khubiosi ebiali ebilayi, narafuchiilila okhubimalilanila elala tawe; ne ebindu biosi ebibii nibirakaasa ta, ebio babimululila elala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.9",
            "verseOrgIds": [
              "1SA.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana likhuwa liOMWAMI liamwitsila Samweli, liri ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.10",
            "verseOrgIds": [
              "1SA.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enzuunilwe omwoyo khulwa okhumwemekha Saulo abe omuruchi; okhuba akaluushe inyuma oburanondakhwo tawe, kata shiakholile akamalako kanje ta. Oburima nibumutiila Samweli; namulilila OMWAMI eshilo tulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.11",
            "verseOrgIds": [
              "1SA.15.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli nahuuna mumabwibwi okhubukaanila Saulo; Samweli naboolelwa ari Saulo yoolile eKarameli, ne lola, wisinjisiliyeho eshiitsulilo, ne ushiukhaane, nabira, nakholomokha natsia eGiligali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.12",
            "verseOrgIds": [
              "1SA.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli namutsiila Saulo; Saulo namusunjila ari OMWAMI akhuheelesie ikhabi; ekholile akelilako liOMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.13",
            "verseOrgIds": [
              "1SA.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli naboola ari Kho okhwana khuno khwamakondi okhwitsanga mumarwi kanje, nokhukhumula kwetsing'ombe okhwa embulilanga, khubeele khurie? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.14",
            "verseOrgIds": [
              "1SA.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo nasunga mbu Babirusiye mubaAmaleki; okhuba abandu babihonokosiye ebishila obulayi mumakondi nende mutsing'ombe, mbu babimalile OMWAMI Nyasayewo musango; ne ebindi biosi khubimululiile elala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.15",
            "verseOrgIds": [
              "1SA.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Samweli namusuniila Saulo ari Lekha; nasi ekhuboolele aka OMWAMI yambooleele eshilo shino. Naye namusunjila ari Khaboole.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.16",
            "verseOrgIds": [
              "1SA.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli nasunga mbu Kata olwa wali omutuutu mumonitsio omwene, shiwakholwa omurwe kwetsimbia tsiaIsiraeli? Khandi OMWAMI yakhutsushiilila amafura obe omuruchi waIsiraeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.17",
            "verseOrgIds": [
              "1SA.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "khandi OMWAMI yakhuruma oluchendo, naboola mbu Tsia osishilie elala aboonooni abo abaAmaleki, olasane ninabo okhuula olwa nababe nibahweele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.18",
            "verseOrgIds": [
              "1SA.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho nishiina eshiachilile norahulila omwoyo kwOMWAMI ta, habula mbu wilukhaniile okhuyaaya, nokhola akali amabii mumoni tsiOMWAMI? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.19",
            "verseOrgIds": [
              "1SA.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo naye namusunjila Samweli ari Toto mwene, embuliile omwoyo kwOMWAMI, khandi enondile khunjila eya OMWAMIyarumilakhwo, nimuleera Agagi omuruchi waAmaleki, nimbasishilia elala abaAmaleki. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.20",
            "verseOrgIds": [
              "1SA.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habula abandu babukuulekhwo khubiyaayo, amakondi nende tsing'ombe, ebishila obulayi mubienebio ebibeele nibikhoyile okhumalilanwa, mbu babimalile OMWAMI Nyasayewo omusango eGiligali. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.21",
            "verseOrgIds": [
              "1SA.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli nasunga mbu",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.22",
            "verseOrgIds": [
              "1SA.15.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.23",
            "verseOrgIds": [
              "1SA.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mana Saulo namusunjila Samweli ari Ndayoonoonile; okhuba ndasiilile lilako liOMWAMI, nende amakhuwa koko; okhuba ndariitsanga abandu, nimbulila omwoyo kwabwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.24",
            "verseOrgIds": [
              "1SA.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho bulaano, ekhusaaya mbu undeshele eshionoono shianje, ma okalushe ninasi, mbu emwinamile OMWAMI. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.25",
            "verseOrgIds": [
              "1SA.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Samweli namusunjila Saulo ari Shingalukha ninawe ta; shichila walobile likhuwa liOMWAMI, naye OMWAMI wakhulobile iwe, oleshe okhuba omuruchi waIsiraeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.26",
            "verseOrgIds": [
              "1SA.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nolwa Samweli yali nashiukhana mbu atsie, Saulo yatiila khundulo weikanzuye, nayo niyirandukha. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.27",
            "verseOrgIds": [
              "1SA.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli namusunjila mbu OMWAMI akhuranduule oburuchi bwaIsiraeli inyanga yino, bukhurulekhwo, nabuheelesia owashio undi oukhushila. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.28",
            "verseOrgIds": [
              "1SA.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khandi oyo ouli Obukhulundu bwaIsiraeli shialabeeha kata okhwikalukhasia ta; okhuba shiali omundu owikalukhasia tawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.29",
            "verseOrgIds": [
              "1SA.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye nasunga mbu Ndayoonoonile; nebutswa chama umbeelesie oluyali imbeli wabakofu babandu banje, khandi imbeli waIsiraeli, nokalukha ninasi, mbu emwinamile OMWAMI Nyasayewo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kho Samweli yakalukha okhulondana nende Saulo; Saulo naye namwinamila OMWAMI.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.31",
            "verseOrgIds": [
              "1SA.15.31"
            ]
          }
        }
      ]
    },
    {
